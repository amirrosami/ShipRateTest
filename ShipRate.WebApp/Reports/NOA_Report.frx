      <Column Name="StripVATAmount" DataType="System.Decimal"/>
      <Column Name="StripTotalValue" DataType="System.Decimal"/>
    </TableDataSource>
    <Total Name="TotalTipInit" Expression="[PriceLines.TipInitialValue]" Evaluator="DataCharges" PrintOn="ReportSummary1" ResetOnReprint="true"/>
