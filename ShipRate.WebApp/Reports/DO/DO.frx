<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Created="03/30/2026 12:00:00" ReportInfo.Modified="09/22/2026 09:12:10" ReportInfo.CreatorVersion="2026.1.0.0">
	<Dictionary>
		<TableDataSource Name="DOHeader" ReferenceName="DOHeader" DataType="System.Int32" Enabled="true">
			<Column Name="DeliveryOrderId" DataType="System.Guid"/>
			<Column Name="DONo" DataType="System.String"/>
			<Column Name="DoDate" DataType="System.String"/>
			<Column Name="ExpiryDate" DataType="System.String"/>
			<Column Name="ArrivalDate" DataType="System.String"/>
			<Column Name="ClearanceTypeName" DataType="System.String"/>
			<Column Name="BLReleaseTypeName" DataType="System.String"/>
			<Column Name="OriginalBLCount" DataType="System.String"/>
			<Column Name="Status" DataType="System.String"/>
			<Column Name="FinalizedAt" DataType="System.String"/>
			<Column Name="Remarks" DataType="System.String"/>
			<Column Name="BLNo" DataType="System.String"/>
			<Column Name="BLDate" DataType="System.String"/>
			<Column Name="ConsigneeName" DataType="System.String"/>
			<Column Name="ShipperName" DataType="System.String"/>
			<Column Name="VesselVoyage" DataType="System.String"/>
			<Column Name="PortOfDischargeName" DataType="System.String"/>
			<Column Name="PlaceOfDeliveryName" DataType="System.String"/>
			<Column Name="ContainerCount" DataType="System.Int32"/>
			<Column Name="VesselName" DataType="System.String"/>
			<Column Name="VoyageNo" DataType="System.String"/>
			<Column Name="FinalDestination" DataType="System.String"/>
			<Column Name="GoodsDescription" DataType="System.String"/>
		</TableDataSource>
		<TableDataSource Name="Containers" ReferenceName="Containers" DataType="System.Int32" Enabled="true">
			<Column Name="RowIndex" DataType="System.Int32"/>
			<Column Name="ContainerNo" DataType="System.String"/>
			<Column Name="SizeAndType" DataType="System.String"/>
			<Column Name="SealNo" DataType="System.String"/>
			<Column Name="PackageCount" DataType="System.Int32"/>
			<Column Name="GrossWeight" DataType="System.Decimal"/>
			<Column Name="NetWeight" DataType="System.Decimal"/>
			<Column Name="Measurement" DataType="System.String"/>
			<Column Name="CntOwnType" DataType="System.String"/>
			<Column Name="MovementType" DataType="System.String"/>
			<Column Name="PackageType" DataType="System.String"/>
		</TableDataSource>

		<!-- تعریف متغیرهای تجمیعی (Totals) استاندارد FastReport -->
		<Total Name="TotalCntCount" TotalType="Count" Evaluator="DataContainers" ResetOnReprint="true" ResetAfter="GroupFooterContainers"/>
		<Total Name="TotalPackageCount" Expression="[Containers.PackageCount]" Evaluator="DataContainers" ResetOnReprint="true" ResetAfter="GroupFooterContainers"/>
		<Total Name="TotalGrossWeight" Expression="[Containers.GrossWeight]" Evaluator="DataContainers" ResetOnReprint="true" ResetAfter="GroupFooterContainers"/>
		<Total Name="TotalNetWeight" Expression="[Containers.NetWeight]" Evaluator="DataContainers" ResetOnReprint="true" ResetAfter="GroupFooterContainers"/>
	</Dictionary>

