      <TextObject Name="txtBody1" Left="20" Top="266.04" Width="640" Height="74" Text="احتراماً بدینوسیله تایید می‌گردد مبلغ &lt;b&gt;&lt;font color=&quot;#0B3C73&quot;&gt;[FreightLetterData.FreightValue] [FreightLetterData.CurrencyName]&lt;/font&gt;&lt;/b&gt; بابت کرایه حمل دریایی محموله فوق‌الذکر از &lt;b&gt;&lt;font color=&quot;#0B3C73&quot;&gt;[FreightLetterData.FromLocationName]&lt;/font&gt;&lt;/b&gt; تا &lt;b&gt;&lt;font color=&quot;#0B3C73&quot;&gt;[FreightLetterData.ToLocationName]&lt;/font&gt;&lt;/b&gt; (ایران) از صاحب کالا در مبدا دریافت گردیده است." RightToLeft="true" Font="Tahoma, 10pt" LineHeight="28" TextRenderType="HtmlTags"/>
      <TextObject Name="txtBody2" Left="20" Top="350.04" Width="640" Height="52" Text="این گواهی به درخواست گیرنده کالا &lt;b&gt;&lt;font color=&quot;#0B3C73&quot;&gt;[FreightLetterData.CustomerName]&lt;/font&gt;&lt;/b&gt; جهت ارائه به آن گمرک محترم صادر گردیده است و ارزش دیگری ندارد." RightToLeft="true" Font="Tahoma, 10pt" LineHeight="28" TextRenderType="HtmlTags"/>
