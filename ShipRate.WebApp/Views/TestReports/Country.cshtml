@{
    ViewData["Title"] = "Country Reports";
}

<div class="container-fluid">

    <!-- ===== Header ===== -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Country Reports</h3>
            <p class="text-muted mb-0">
                List & analytics of countries
            </p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Back to Reports
        </a>
    </div>

    <!-- ===== Filters ===== -->
    <div class="card mb-3">
        <div class="card-body">
            <form method="get" class="row g-2">
                <div class="col-md-4">
                    <input type="text"
                           name="search"
                           class="form-control"
                           placeholder="Search country..." />
                </div>

                <div class="col-md-3">
                    <select class="form-select">
                        <option>All Zones</option>
                        <option>EU</option>
                        <option>Asia</option>
                        <option>US</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <button class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ===== Report Table ===== -->
    <div class="card">
        <div class="card-header fw-semibold">
            Countries List
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Country</th>
                        <th>Zone</th>
                        <th>Status</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Fake Data (فعلاً) -->
                    <tr>
                        <td>Germany</td>
                        <td>EU</td>
                        <td>
                            <span class="badge bg-success">Active</span>
                        </td>
                        <td>2024-01-10</td>
                    </tr>
                    <tr>
                        <td>France</td>
                        <td>EU</td>
                        <td>
                            <span class="badge bg-success">Active</span>
                        </td>
                        <td>2024-01-12</td>
                    </tr>
                    <tr>
                        <td>Japan</td>
                        <td>Asia</td>
                        <td>
                            <span class="badge bg-warning">Inactive</span>
                        </td>
                        <td>2024-01-15</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>
