@{
    ViewData["Title"] = "Reports";
}

<div class="container-fluid">

    <!-- ===== Header ===== -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Reports</h3>
            <p class="text-muted mb-0">
                Centralized reporting & analytics
            </p>
        </div>
        <div>
            <button class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-funnel"></i> Global Filters
            </button>
        </div>
    </div>

    <!-- ===== Report Categories ===== -->
    <div class="row g-3">

        <!-- Country Reports -->
        <div class="col-xl-4 col-md-6">
            <div class="card report-card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="report-icon bg-primary">
                            <i class="bi bi-geo-alt"></i>
                        </div>
                        <h6 class="fw-bold mb-0 ms-3">Country Reports</h6>
                    </div>

                    <p class="text-muted small">
                        Reports related to countries, zones and coverage.
                    </p>

                    <ul class="small mb-3">
                        <li>Countries by Zone</li>
                        <li>Active Countries</li>
                        <li>Country Growth</li>
                    </ul>


                    <a asp-controller="Reports"
                       asp-action="Country"
                       class="btn btn-sm btn-primary w-100">
                        View Reports
                    </a>


                </div>
            </div>
        </div>

        <!-- Shipment Reports -->
        <div class="col-xl-4 col-md-6">
            <div class="card report-card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="report-icon bg-success">
                            <i class="bi bi-truck"></i>
                        </div>
                        <h6 class="fw-bold mb-0 ms-3">Shipment Reports</h6>
                    </div>

                    <p class="text-muted small">
                        Operational shipment performance and volume.
                    </p>

                    <ul class="small mb-3">
                        <li>Shipments per Month</li>
                        <li>Delayed Shipments</li>
                        <li>Top Routes</li>
                    </ul>

                    <a class="btn btn-sm btn-success w-100">
                        View Reports
                    </a>
                </div>
            </div>
        </div>

        <!-- Finance Reports -->
        <div class="col-xl-4 col-md-6">
            <div class="card report-card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="report-icon bg-warning">
                            <i class="bi bi-currency-dollar"></i>
                        </div>
                        <h6 class="fw-bold mb-0 ms-3">Finance Reports</h6>
                    </div>

                    <p class="text-muted small">
                        Revenue, rates and financial analytics.
                    </p>

                    <ul class="small mb-3">
                        <li>Revenue by Country</li>
                        <li>Monthly Revenue</li>
                        <li>Top Customers</li>
                    </ul>

                    <a class="btn btn-sm btn-warning w-100">
                        View Reports
                    </a>
                </div>
            </div>
        </div>

    </div>

</div>

<style>
    .report-card {
        transition: transform .2s ease, box-shadow .2s ease;
    }

    .report-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(0,0,0,.12);
    }

    .report-icon {
        width: 45px;
        height: 45px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.3rem;
    }
</style>
