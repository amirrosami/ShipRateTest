@using ShipRate.Application.ViewModels
@model List<HSCodeLookupItemVm>
@{
    var targetTextInputId = ViewBag.TargetTextInputId as string ?? "HSCode";
}

@if (Model != null && Model.Any())
{
    <div class="list-group position-absolute w-100 shadow-sm"
         style="z-index: 1050; max-height: 260px; overflow-y: auto;">
        @foreach (var item in Model)
        {
            <button type="button"
                    class="list-group-item list-group-item-action"
                    onclick="
                                document.getElementById('@targetTextInputId').value='@item.HSCode';
                                this.closest('.list-group').remove();
                            ">
                <div>@item.DisplayName</div>
            </button>
        }
    </div>
}
