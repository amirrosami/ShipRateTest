@using ShipRate.WebApp.ViewModels
@using ShipRate.WebApp.ViewModels.Location
@using ShipRate.WebApp.ViewModels.TerritoryVms
@model CountryHSCodeFormViewModel
@{
    string CreateEdit = ViewBag.CreateEdit;
    bool isCreateMode = false;
    if (CreateEdit == "Create") isCreateMode = true;
}

<form hx-post="@Url.Action(isCreateMode?"CreateCountryHSCode":"EditCountryHSCode", "HSCodes")"
      hx-target="#app-modal-content"
      hx-swap="innerHTML">

    <div class="modal-header form-caption-bg  text-white">
        <input type="hidden" asp-for="HSCodeId" />

        @if (isCreateMode)
        {
            <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Add Country HSCode for HSCode Name : @ViewBag.HSCodeName</h5>

        }
        else
        {
            <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Edit Country HSCode</h5>
            <input type="hidden" asp-for="Id" />
        }


        <button type="button"
                class="btn-close"
                onclick="AppModal.close()">
        </button>
    </div>


    <div class="modal-body row">

        @Html.AntiForgeryToken()
        @if (!ViewData.ModelState.IsValid)
        {
            var allErrors = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).ToList();
            if (allErrors.Any())
            {
                <div class="alert alert-danger py-2 mb-1">
                    <ul class="mb-0 small">
                        @foreach (var err in allErrors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }
        }

        <div class="form-grid form-grid-3 mb-3" >
            <div class="form-group">
                <label for="CountryId">Country</label>
                <select id="CountryId" name="CountryId" class="form-control">
                    <option value=0>-- Select Country --</option>
                    @foreach (var country in Model.Countries)
                    {
                        <!option value="@country.Id" @(Model.CountryId == country.Id ? "selected" : "")>
                        @country.Name
                        </!option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label for="CHSCode">Country HS Code</label>
                <input type="text" id="CHSCode" name="CHSCode"
                       value="@Model.CHSCode" class="form-control"
                       placeholder="" maxlength="12" />
            </div>

            <div class="form-group">
                <label for="CHSName">CHS Name</label>
                <input type="text" id="CHSName" name="CHSName"
                       value="@Model.CHSName" class="form-control"
                       placeholder="Country-specific name" maxlength="300" />
            </div>

            <div class="form-group">
                <label for="LocalName">Local Name</label>
                <input type="text" id="LocalName" name="LocalName"
                       value="@Model.LocalName" class="form-control"
                       placeholder="Name in local language" maxlength="300" />
            </div>

            <div class="form-group">
                <label for="CountryHSCodeValidFrom">Valid From</label>
                <input type="date" id="CountryHSCodeValidFrom" name="CountryHSCodeValidFrom"
                       value="@(Model.CountryHSCodeValidFrom?.ToString("yyyy-MM-dd"))"
                       class="form-control" />
            </div>

            <div class="form-group">
                <label for="CountryHSCodeValidTo">Valid To</label>
                <input type="date" id="CountryHSCodeValidTo" name="CountryHSCodeValidTo"
                       value="@Model.CountryHSCodeValidTo.ToString("yyyy-MM-dd")"
                       class="form-control" />
            </div>

            <div class="form-group">
                <label for="DutyRate">Duty Rate (%)</label>
                <input type="number" id="DutyRate" name="DutyRate"
                       value="@Model.DutyRate" class="form-control"
                       placeholder="" step="0.01" min="0" max="100" />
            </div>
            <div class="form-group">
                <label for="Commercial Benefit Rate">Commercial Benefit Rate (%)</label>
                <input type="number" id="CommercialBenefitRate" name="CommercialBenefitRate"
                       value="@Model.CommercialBenefitRate" class="form-control"
                       placeholder="" step="0.01" min="0" max="100" />
            </div>



            <div class="form-group checkbox-group">
                <label class="checkbox-label">
                    <input type="checkbox" name="IsActive" value="true"
                           @(Model.IsActive ? "checked" : "") />
                    <span>Active</span>
                </label>
            </div>
        </div>

    </div>


    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="AppModal.close()">Cancel</button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>

            @if (isCreateMode)
            {
                <span>Save</span>
            }
            else
            {
                <span>Update</span>
            }
        </button>
    </div>
</form>



