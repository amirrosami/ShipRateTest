@using ShipRate.Application.ViewModels.BookingConsoleVms
@model BookingConsoleVm
@{
    ViewData["Title"] = "Booking Console";
}
<div class="container-fluid py-3">
    <!-- Page Header & Main Actions -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h4 class="mb-1 text-dark fw-bold">Unified Booking Console</h4>
            <div class="text-muted small">
                Booking No: <span class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(Model?.Summary?.BookingNo) ? "N/A" : Model.Summary.BookingNo)</span>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="@Url.Action("Index", "Settlements")"
               class="btn btn-sm btn-outline-primary"
               target="_blank"
               rel="noopener noreferrer">
                <i class="bi bi-water me-1"></i>
                Settlements
            </a>
            <button type="button"
                    class="btn btn-outline-primary btn-sm"
                    hx-get="/Settlements/OpenBookingSettlementModal?bookingId=@Model.BookingId"
                    hx-target="#settlementModalContainer"
                    hx-swap="innerHTML"
                    hx-indicator="#settlementLoadingIndicator">
                <i class="bi bi-wallet2 me-1"></i> Settle Booking
            </button>
            <!-- Optional Spinner Indicator -->
            <span id="settlementLoadingIndicator" class="htmx-indicator spinner-border spinner-border-sm text-warning align-middle ms-1" role="status"></span>
            <!-- Issue Delivery Order Button -->
            <button type="button"
                    class="btn btn-outline-primary btn-sm"
                    hx-get="@Url.Action("CreatePartial", "DeliveryOrders", new { blId = Model.BookingId })"
                    hx-target="#noaModalBody"
                    hx-swap="innerHTML"
                    onclick="showNoaModal()">
                <i class="bi bi-plus-circle me-1"></i> Issue Delivery Order
            </button>
            <button type="button" class="btn btn-sm btn-outline-primary"
                    hx-get="/DocumentManager/Index?objectId=@Model.BookingId&objectTypeId=6"
                    hx-target="#document-manager-content"
                    hx-swap="innerHTML"
                    data-bs-toggle="modal"
                    data-bs-target="#documentManagerModal">
                <i class="bi bi-folder2-open me-1"></i>Attachments
            </button>
            <!-- Back to Index -->
            <a asp-action="Index"
               class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back
            </a>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-lg-9">
            @await Html.PartialAsync("~/Views/Booking/BookingManagement/_BookingSummaryCard.cshtml", Model.Summary)
        </div>
    </div>
    <!-- Invoices Container (HTMX) -->
    <div id="booking-invoices-container" class="mt-3 mb-3">
        <div hx-get="@Url.Action("GetBookingInvoices", "Booking", new { bookingId = Model.BookingId, jobId = Model.JobId })"
             hx-trigger="load, refreshInvoicesGrid from:body"
             hx-swap="innerHTML">
            <div class="text-center py-2 text-muted small">
                <span class="spinner-border spinner-border-sm"></span> Loading invoices...
            </div>
        </div>
    </div>
    <div id="booking-detentions-container" class="mt-3 mb-3">
        <div hx-get="@Url.Action("GetDetentionsGrid", "Booking", new { Id = Model.BookingId })"
             hx-trigger="load ,refreshDetentionsGrid from:body"
             hx-swap="innerHTML">
            <div class="text-center py-2 text-muted small">
                <span class="spinner-border spinner-border-sm"></span> Loading detentions...
            </div>
        </div>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-12 col-lg-12">
            <div id="booking-rtsinstruction-container" class="mt-3 mb-3">
                <div hx-get="@Url.Action("RTSInstructionsByBooking", "Jobs", new { bookingId = Model.BookingId ,bookingNo=Model.BookingNo})"
                     hx-trigger="load , refreshRTSGrid from:body,rtsSaved from:body"
                     hx-swap="innerHTML">
                    <div class="text-center py-2 text-muted small">
                        <span class="spinner-border spinner-border-sm"></span> Loading RTS Instructions...
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- ===== Principal Issue NOA Modal ===== -->
    <div class="modal fade" id="noaModal" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">
                <div class="modal-body p-0 pb-3" id="noaModalBody">
                    <!-- Form layout & Price Grid populated dynamically via HTMX -->
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="rtsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" id="rtsModalContainer">
            </div>
        </div>
    </div>

    <div class="modal fade" id="invoiceModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content" id="invoice-modal-content"></div>
        </div>
    </div>

    <div class="modal fade" id="partyLookupModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content" id="party-lookup-modal-content"></div>
        </div>
    </div>

    <div class="modal fade" id="mainModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Telex Release</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="modalBody">
                </div>
            </div>
        </div>
    </div>
    <div id="settlementModalContainer"></div>
    <div id="globalModalContainer"></div>
</div>
<div class="modal fade" id="documentManagerModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content" id="document-manager-content">
        </div>
    </div>
</div>
<div class="modal fade" id="sendModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content shadow">
            <div class="modal-header py-2 px-3 bg-light border-bottom border-secondary-subtle">
                <h5 class="modal-title fs-6 fw-bold font-monospace text-dark mb-0">
                    <i class="bi bi-broadcast me-1 text-primary"></i> Dispatch Hub & History
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0" id="sendModalBody">
                <!-- Sent SMS/Email Logs rendered here -->
            </div>
        </div>
    </div>
</div>

<div id="detention-modal-container"></div>

<div class="modal fade"
     id="paymentDocumentModal"
     tabindex="-1"
     aria-hidden="true"
     data-bs-backdrop="static"
     data-bs-keyboard="false">

    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content" id="paymentDocumentModalContent">
            <!-- _CreateEditModal is loaded here -->
        </div>
    </div>
</div>

<div id="rts-summary-container"></div>
<div id="booking-receipts-container" class="mt-3 mb-3">
    <div class="bg-light py-2 px-3 d-flex justify-content-between align-items-center border-bottom">
        <span class="fw-bold small text-dark text-uppercase">
            <i class="bi bi-clock-history me-1 text-warning"></i>
            Docs Receipts
        </span>
        <div class="d-flex align-items-center gap-2">
            <button type="button"
                    class="btn btn-sm btn-outline-primary py-1 px-2"
                    title="Add New Receipt"
                    hx-get="@Url.Action("Create", "ExportDocsReceipt", new { bookingId = Model.BookingId })"
                    hx-target="#receiptModalBody"
                    hx-swap="innerHTML">
                <i class="bi bi-plus-lg"></i>
                Add
            </button>
        </div>
    </div>
    <div hx-get="@Url.Action("ListByBooking", "ExportDocsReceipt", new { bookingId = Model.BookingId})"
         hx-trigger="load, receiptlistchanged from:body"
         hx-swap="innerHTML">
        <div class="text-center py-2 text-muted small">
            <span class="spinner-border spinner-border-sm"></span> Loading Receipts...
        </div>
    </div>
</div>
<div class="modal fade" id="receiptModal" tabindex="-1" aria-hidden="true" dir="ltr">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Export Docs Receipt</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="receiptModalBody"></div>
        </div>
    </div>
</div>
<div class="modal fade"
     id="rtsIssueModal"
     tabindex="-1"
     aria-labelledby="rtsIssueModalLabel"
     aria-hidden="true"
     dir="ltr">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" id="modal-content-target"></div>
    </div>
</div>



<script>

    document.body.addEventListener('htmx:afterSwap', function (evt) {
        if (evt.detail.target.id === 'settlementModalContainer') {
            const modalEl = document.getElementById('blSettlementModal');
            if (modalEl) {
                const modalInstance = new bootstrap.Modal(modalEl, {
                    backdrop: 'static',
                    keyboard: false
                });
                modalInstance.show();

                // Auto-clean container when modal is dismissed
                modalEl.addEventListener('hidden.bs.modal', function () {
                    document.getElementById('settlementModalContainer').innerHTML = '';
                });
            }
        }
    });
    document.addEventListener('DOMContentLoaded', function () {
        // گوش دادن به رویداد بسته شدن مودال بوت‌استرپ برای بازنشانی وضعیت بدنه‌ی صفحه
        const invoiceModal = document.getElementById('invoice-modal'); // شناسه اصلی تگ مودال شما
        if (invoiceModal) {
            invoiceModal.addEventListener('hidden.bs.modal', function () {
                // حذف دستی کلاس‌های قفل‌کننده از body در صورت وجود باگ
                document.body.classList.remove('modal-open');
                document.body.style.overflow = '';
                document.body.style.paddingRight = '';

                // حذف لایه‌های تیره اضافه که در صفحه جا مانده‌اند
                const backdrops = document.querySelectorAll('.modal-backdrop');
                backdrops.forEach(backdrop => backdrop.remove());
            });
        }
    });


    document.body.addEventListener('htmx:afterSwap', function (evt) {
        if (evt.detail.target.id === 'rtsModalContainer') {
            const modalEl = document.getElementById('rtsModal');
            if (modalEl) {
                const modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
                modalInstance.show();
            }
        }
    });

    document.body.addEventListener('htmx:afterSwap', function (evt) {
        if (evt.detail.target.id === 'receiptModalBody') {
            const modalEl = document.getElementById('receiptModal');
            if (modalEl) {
                const modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
                modalInstance.show();
            }
        }
    });

    // شنود رویداد اختصاصی ثبت موفق
    document.body.addEventListener('rtsSaved', function () {
        const modalEl = document.getElementById('rtsModal');
        if (modalEl) {
            const modalInstance = bootstrap.Modal.getInstance(modalEl);
            if (modalInstance) {
                modalInstance.hide();
            }
        }
    });


        document.body.addEventListener('rtsIssueSaved', function () {
            const modalElement = document.getElementById('rtsIssueModal');
            const modalContent = document.getElementById('modal-content-target');

            if (!modalElement) return;

            const modalInstance = bootstrap.Modal.getInstance(modalElement)
                || new bootstrap.Modal(modalElement);

            modalInstance.hide();

            if (modalContent) {
                modalContent.innerHTML = '';
            }
        });




</script>




<script src="~/js/invoices.js"></script>