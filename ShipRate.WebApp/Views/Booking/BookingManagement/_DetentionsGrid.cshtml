@using ShipRate.Application.ViewModels.BookingConsoleVms
@model BookingConsoleDetentionsVm

<style>
    /* ایجاد اسکرول افقی تمیز و استاندارد */
    .detentions-table-wrapper {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        min-height: 180px;
        width: 100%;
    }

    /* ردیف InActive (قرمز ملایم) */
    tr.detention-inactive > td {
        background-color: rgba(220, 53, 69, 0.08) !important;
    }

    table.table-hover tbody tr.detention-inactive:hover > td {
        background-color: rgba(220, 53, 69, 0.14) !important;
    }

    /* رنگ قرمز برای ستون Status (ستون نهم در بدنه جدول) */
    tr.detention-inactive td:nth-child(9) {
        color: #b02a37;
        font-weight: 600;
    }

    /* ردیف Final و Active (سبز ملایم) */
    tr.detention-final > td {
        background-color: rgba(25, 135, 84, 0.08) !important;
    }

    table.table-hover tbody tr.detention-final:hover > td {
        background-color: rgba(25, 135, 84, 0.15) !important;
    }
</style>

<div id="booking-detentions-container" class="card border shadow-sm mt-1">
    @if (Model.BookingId == null)
    {
        <div class="p-3 text-warning">
            <i class="bi bi-exclamation-triangle me-1"></i>
            
        </div>
    }
    else
    {
        <!-- Header Card با خط جداکننده پایین -->
        <div class="bg-light py-2 px-3 d-flex justify-content-between align-items-center border-bottom">
            <span class="fw-bold small text-dark text-uppercase">
                <i class="bi bi-clock-history me-1 text-warning"></i>
                Detentions
            </span>
            <div class="d-flex align-items-center gap-2">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input"
                           type="checkbox"
                           id="detentions-show-inactive"
                           name="showInactive"
                           value="true"
                           hx-get="@Url.Action("GetDetentionsGrid", "Booking", new { bookingId = Model.BookingId })"
                           hx-trigger="change"
                           hx-target="#booking-detentions-container"
                           hx-swap="outerHTML"
                           @(Model.ShowInActive ? "checked" : "") />
                    <label class="form-check-label small" for="detentions-show-inactive">
                        Show InActive
                    </label>
                </div>

                <span class="badge bg-secondary-subtle text-dark border">
                    @(Model.Items?.Count ?? 0)
                </span>

                <button type="button"
                        class="btn btn-sm btn-outline-primary py-1 px-2"
                        title="Add New Detention"
                        hx-get="@Url.Action("Create", "Detentions", new { bookingId = Model.BookingId })"
                        hx-target="#detention-modal-container"
                        hx-swap="innerHTML">
                    <i class="bi bi-plus-lg"></i>
                    Add
                </button>
            </div>
        </div>

        <!-- جدول با قابلیت اسکرول افقی بهینه‌شده -->
        <div class="table-responsive detentions-table-wrapper">
            <table class="table table-sm table-bordered table-hover align-middle mb-0 text-nowrap small text-start border-secondary-subtle">
                <thead class="table-light text-uppercase font-monospace align-middle border-bottom border-secondary-subtle">
                    <tr>
                        <th style="width: 40px;" class="text-center">#</th>
                        <th>Company</th>
                        <th>No</th>
                        <th>Issue Date</th>
                        <th>To Date</th>
                        <th>Type</th>
                        <th>Party</th>
                        <th>Tariff</th>
                        <th>Free Days</th>
                        <th>Status</th>
                        <th>Fee</th>
                        <th>Final Payable</th>
                        <th>Currency</th>
                        <th>Settled</th>
                        <th>Remain</th>
                        <th>IsFinal</th>
                        <th>Created By</th>
                        <th>Remarks</th>
                        <th class="text-center" style="width: 140px;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Items == null || !Model.Items.Any())
                    {
                        <tr>
                            <td colspan="19" class="text-center py-4 text-muted align-middle" style="height: 140px;">
                                <i class="bi bi-exclamation-circle d-block mb-1 fs-5"></i>
                                No detention records found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int rowNo = 1;

                        @foreach (var item in Model.Items)
                        {
                            var rowClass = item.StatusId == -1
                            ? "detention-inactive"
                            : (item.IsFinal ? "detention-final" : "");

                            <tr class="@rowClass">
                                <td class="text-center text-muted fw-semibold">
                                    @(rowNo++)
                                </td>
                                <td>@item.CompanyName</td>
                                <td>@item.DetentionNo</td>
                                <td>@item.IssueDate.ToString("yyyy-MM-dd")</td>
                                <td>@item.DetentionToDate.ToString("yyyy-MM-dd")</td>
                                <td>@item.DirectionName</td>
                                <td>@(item.PartyName ?? "-")</td>
                                <td>@(item.TariffTitle ?? "-")</td>
                                <td>@item.FreeDays</td>
                                <td>@(item.StatusTitle ?? "-")</td>
                                <td>@item.Amount.ToString("N0") @item.MainCurrencyName</td>
                                <td>@item.FinalPayableAmount.ToString("N0")</td>
                                <td>@item.FinalCurrencyName</td>
                                <td>@item.Settled.ToString("N0")</td>
                                <td>@item.Remain.ToString("N0")</td>
                                <td>
                                    @if (item.IsFinal)
                                    {
                                        <span class="badge bg-success">Final</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Part</span>
                                    }
                                </td>
                                <td><span title="@item.IssueDatePersian">@item.CreateUserName</span></td>
                                <td>@(string.IsNullOrWhiteSpace(item.Remarks) ? "-" : item.Remarks)</td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a href="@Url.Action("Print", "Detentions", new { id = item.Id })"
                                           target="_blank"
                                           class="btn btn-outline-secondary py-1 px-2"
                                           title="Print English Statement">
                                            <i class="bi bi-printer"></i>
                                        </a>

                                        <a href="@Url.Action("PrintFarsi", "Detentions", new { id = item.Id })"
                                           target="_blank"
                                           class="btn btn-outline-secondary py-1 px-2"
                                           title="چاپ صورتحساب فارسی">
                                            <i class="bi bi-printer-fill"></i>
                                        </a>

                                        <a href="@Url.Action("PrintStatement", "Detentions", new { id = item.Id })"
                                           target="_blank"
                                           class="btn btn-outline-primary py-1 px-2"
                                           title="Print Details (PDF)">
                                            <i class="bi bi-file-earmark-pdf"></i>
                                        </a>

                                        <button type="button"
                                                class="btn btn-outline-danger py-1 px-2"
                                                title="Delete Detention"
                                                hx-post="@Url.Action("Delete", "Detentions", new { id = item.Id})"
                                                hx-target="#booking-detentions-container"
                                                hx-swap="outerHTML"
                                                hx-confirm="Are you sure you want to delete this detention record?">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>
