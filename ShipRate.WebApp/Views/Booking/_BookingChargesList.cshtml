@using ShipRate.Application.DTOs
@model BookingFormVm

@if (Model.Charges != null && Model.Charges.Any())
{
    for (int i = 0; i < Model.Charges.Count; i++)
    {
        <partial name="~/Views/Booking/_BookingChargeRow.cshtml" model="Model.Charges[i]" view-data='new ViewDataDictionary(ViewData) { ["Index"] = i }' />
    }
}
