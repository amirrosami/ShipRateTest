@using ShipRate.Application.JobsViewModels
@model List<BookingListItemVm>

<style>
    .custom-table-wrapper {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        display: block;
    }

    .booking-actions .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        padding: 0 !important;
        font-size: 0.85rem;
    }
</style>

<div class="custom-table-wrapper shadow-sm rounded border">
    <table class="table table-hover table-bordered table-striped align-middle table-sm mb-0"
           style="min-width: 1260px; width: 100%; font-size: 0.875rem; table-layout: fixed;">
        <thead>
            <tr class="table-light">
                <th style="width: 160px;">Company</th>
                <th style="width: 110px;">Role Type</th>
                <th style="width: 95px;">Booking No</th>
                <th style="width: 100px;">Booking Date</th>
                <th style="width: 110px;">Line Booking No</th>
                <th style="width: 100px;">Transport Type</th>
                <th style="width: 140px;">Carrier</th>
                <th style="width: 140px;">Vendor</th>
                <th style="width: 115px;">Origin</th>
                <th style="width: 115px;">Destination</th>
                <th style="width: 85px;">Status</th>
                <th style="width: 140px;" class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr class="booking-row"
                        data-booking-id="@item.Id"
                        style="cursor:pointer;"
                        hx-get="@Url.Action("RTSInstructionsByBooking", "Jobs", new { bookingId = item.Id, bookingNo = item.BookingNo })"
                        hx-target="#rts-instructions-container"
                        hx-swap="innerHTML"
                        onclick="selectBookingRow(this, '@item.Id')">

                        <td class="text-truncate" style="max-width: 160px;" title="@item.CompanyName">@item.CompanyName</td>
                        <td class="text-truncate" style="max-width: 110px;" title="@item.CompanyRoleTypeName">@item.CompanyRoleTypeName</td>
                        <td><code class="text-dark fw-bold">@item.BookingNo</code></td>
                        <td class="text-nowrap">@item.BookingDate?.ToString("yyyy-MM-dd")</td>
                        <td class="text-truncate" style="max-width: 110px;" title="@item.LineBookingNo">@item.LineBookingNo</td>
                        <td>
                            @switch (item.TransportType?.ToLower())
                            {
                                case "sea":
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="bi bi-water me-1"></i>Sea</span>
                                    break;
                                case "road":
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle"><i class="bi bi-truck me-1"></i>Road</span>
                                    break;
                                case "rail":
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle"><i class="bi bi-train-front me-1"></i>Rail</span>
                                    break;
                                case "air":
                                    <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-airplane me-1"></i>Air</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@item.TransportType</span>
                                    break;
                            }
                        </td>
                        <td class="text-truncate" style="max-width: 140px;" title="@item.CarrierName">@item.CarrierName</td>
                        <td class="text-truncate" style="max-width: 140px;" title="@item.VendorName">@item.VendorName</td>
                        <td class="text-truncate" style="max-width: 115px;" title="@item.Origin">@item.Origin</td>
                        <td class="text-truncate" style="max-width: 115px;" title="@item.Destination">@item.Destination</td>
                        <td>
                            <span class="badge @(item.BookingStatusName == "Draft" ? "bg-secondary" : "bg-success")">
                                @item.BookingStatusName
                            </span>
                        </td>
                        <td class="booking-actions text-center" onclick="event.stopPropagation();">
                            <div class="d-inline-flex flex-nowrap align-items-center justify-content-center gap-1">

                                <a asp-controller="Booking"
                                   asp-action="BookingConsole"
                                   asp-route-id="@item.Id"
                                   asp-route-jobid="@item.JobId"
                                   class="btn btn-sm btn-outline-primary"
                                   title="Open Booking Console">
                                    <i class="bi bi-box-seam"></i>
                                </a>


                                <button type="button"
                                        class="btn btn-sm btn-outline-primary"
                                        hx-get="@Url.Action("Edit", "Booking", new { id = item.Id })"
                                        hx-target="#bookingModal"
                                        hx-swap="innerHTML"
                                        title="Edit Booking">
                                    <i class="bi bi-pencil-square"></i>
                                </button>

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        hx-delete="@Url.Action("Delete", "Booking", new { id = item.Id })"
                                        hx-confirm="Are you sure you want to delete Booking '@item.BookingNo'?"
                                        hx-target="closest tr"
                                        hx-swap="outerHTML swap:1s"
                                        title="Delete Booking">
                                    <i class="bi bi-trash"></i>
                                </button>

                                <button type="button"
                                        class="btn btn-sm btn-outline-warning text-dark"
                                        hx-get="@Url.Action("GetDetentionStartBaseModal", "Detentions", new { bookingId = item.Id, companyId = 1 })"
                                        hx-target="#modal-container"
                                        title="Register Start Dates For Detention">
                                    <i class="bi bi-stopwatch"></i>
                                </button>

                                <button type="button"
                                        class="btn btn-sm btn-outline-info"
                                        hx-get="@Url.Action("IndexModal", "ActivityLog", new { entityTypeId = 2, entityId = item.Id, externalReferenceNo = item.BookingNo })"
                                        hx-target="#activityLogModalContainer"
                                        hx-swap="innerHTML"
                                        title="View Event Logs">
                                    <i class="bi bi-clock-history"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="12" class="text-center py-4 text-muted">
                        <i class="bi bi-inbox fs-3 d-block mb-2"></i> No Bookings found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    function selectBookingRow(rowEl, bookingId) {
        // ۱. ست کردن آیدی در hidden input
        const selectedIdField = document.getElementById("selected-booking-id");
        if (selectedIdField) {
            selectedIdField.value = bookingId;
        }

        // ۲. هایلایت کردن سطر انتخاب‌شده
        document.querySelectorAll(".booking-row").forEach(function (r) {
            r.classList.remove("table-primary");
        });
        rowEl.classList.add("table-primary");
    }
</script>
