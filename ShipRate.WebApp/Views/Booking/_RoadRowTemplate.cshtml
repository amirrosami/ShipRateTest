@using ShipRate.Application.DTOs
@model BookingRoadDetailVm

<tr class="road-row">

    <td>
        <input type="hidden"
               id="port-from-id-@Model.Index"
               name="RoadDetails[@Model.Index].PickupLocationId"
               value="@Model.PickupLocationId" />

        <input type="text"
               id="port-from-text-@Model.Index"
               name="search"
               class="form-control form-control-sm port-search-input"
               value="@Model.PickupLocationName"
               data-index="@Model.Index"
               data-port-type="from"
               hx-get="/Locations/SearchPorts"
               hx-trigger="keyup changed delay:300ms"
               hx-vals='js:{ index: @Model.Index, portType: "from" }'
               hx-target="#global-port-search-popup"
               hx-swap="innerHTML" />
    </td>
    <td>
        <input type="hidden"
               id="port-from-id-@Model.Index"
               name="RoadDetails[@Model.Index].PickupLocationId"
               value="@Model.DeliveryLocationId" />

        <input type="text"
               id="port-to-text-@Model.Index"
               name="search"
               class="form-control form-control-sm port-search-input"
               value="@Model.DeliveryLocationName"
               data-index="@Model.Index"
               data-port-type="to"
               hx-get="/Locations/SearchPorts"
               hx-trigger="keyup changed delay:300ms"
               hx-vals='js:{ index: @Model.Index, portType: "to" }'
               hx-target="#global-port-search-popup"
               hx-swap="innerHTML" />
    </td>
    <td>
        <select name="RoadDetails[@Model.Index].TruckTypeId" asp-items="ViewBag.TruckTypes" class="form-select form-select-sm">
            <option value="">-- Select --</option>
        </select>
    </td>
    <td>
        <input type="number" name="RoadDetails[@Model.Index].TruckCount" value="@Model.TruckCount" class="form-control form-control-sm text-center" />
    </td>
    <td>
        <input type="text" name="RoadDetails[@Model.Index].DriverName" class="form-control form-control-sm mb-1" placeholder="Driver Name" />
        <input type="text" name="RoadDetails[@Model.Index].DriverMobile" class="form-control form-control-sm" placeholder="Mobile" />
    </td>
    <td>
        <input type="text" name="RoadDetails[@Model.Index].TruckPlateNo" class="form-control form-control-sm" placeholder="Plate No" />
    </td>
    <td>
        <button type="button" class="btn btn-outline-danger btn-sm border-0" onclick="removeRoadRow(this)">
            <i class="bi bi-trash-fill"></i>
        </button>
    </td>
</tr>









<script>
    document.body.addEventListener("htmx:afterSwap", function (event) {
        const popup = document.getElementById("global-port-search-popup");

        if (!popup || event.detail.target !== popup) {
            return;
        }

        const input = event.detail.requestConfig?.elt;

        if (!input?.classList.contains("port-search-input")) {
            return;
        }

        const rect = input.getBoundingClientRect();

        popup.style.position = "fixed";
        popup.style.left = `${rect.left}px`;
        popup.style.top = `${rect.bottom + 4}px`;
        popup.style.width = `${Math.max(rect.width, 280)}px`;
        popup.style.zIndex = "99999";
        popup.classList.remove("d-none");
    });

    document.addEventListener("click", function (event) {
        const popup = document.getElementById("global-port-search-popup");

        if (!popup) {
            return;
        }

        const isInput = event.target.closest(".port-search-input");
        const isPopup = popup.contains(event.target);

        if (!isInput && !isPopup) {
            popup.classList.add("d-none");
            popup.innerHTML = "";
        }
    });
</script>
