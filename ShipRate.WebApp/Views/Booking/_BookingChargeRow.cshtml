@using ShipRate.Application.DTOs
@model BookingChargeVm
@{
    var index = ViewData["Index"]?.ToString() ?? "__INDEX__";
}

<!-- هر هزینه در قالب یک کارت زیبا با سایه ملایم -->
<div class="card border border-light-subtle shadow-sm charge-card position-relative mb-2">
    <input type="hidden" name="Charges.Index" value="@index" />
    <!-- دکمه حذف کارت در گوشه بالا سمت راست -->
    <button type="button"
            class="btn btn-sm btn-link text-danger position-absolute top-0 end-0 mt-2 me-2 p-1"
            onclick="this.closest('.charge-card').remove();"
            title="Remove Charge">
        <i class="bi bi-trash-fill fs-6"></i>
    </button>

    <div class="card-body p-3">
        <!-- ردیف اول: اطلاعات پایه هزینه (Charge Code, Side, Party) -->
        <div class="row g-2 mb-2 pe-4">

            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">Charge Code</label>
                <select name="Charges[@index].ChargeCodeId"
                        class="form-select form-select-sm"
                        asp-items="@(new SelectList(ViewBag.ChargeTypes ?? Enumerable.Empty<SelectListItem>(), "Value", "Text", Model?.ChargeCodeId.ToString()))">
                    <option value="">Select Charge Code</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">Cost/Revenue</label>
                <select name="Charges[@index].ChargeSideId"
                        class="form-select form-select-sm" 
                        asp-items="@(new SelectList(ViewBag.ChargeSides ?? Enumerable.Empty<SelectListItem>(), "Value", "Text", Model?.ChargeSideId.ToString()))">
                    <option value="">Select Side</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">Payer/Payee</label>
                <select name="Charges[@index].PartyId" class="form-select form-select-sm"
                        asp-items="@(new SelectList(ViewBag.Parties ?? Enumerable.Empty<SelectListItem>(), "Value", "Text", Model?.PartyId.ToString()))">
                    <option value="">Select Party</option>
                </select>
            </div>
        </div>

        <!-- ردیف دوم: اطلاعات مالی (Currency, Unit, Qty, Price, Amount) -->
        <div class="row g-2 align-items-end pe-4">
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Currency</label>
                <select name="Charges[@index].CurrencyId" class="form-select form-select-sm"
                        asp-items="@(new SelectList(ViewBag.Currencies ?? Enumerable.Empty<SelectListItem>(), "Value", "Text", Model?.CurrencyId.ToString()))">
                    <option value="">Currency</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Qty</label>
                <input name="Charges[@index].Qty" class="form-control form-control-sm text-center" type="number" step="0.001" value="@Model?.Qty" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Unit Price</label>
                <input name="Charges[@index].UnitPrice" class="form-control form-control-sm text-end charge-unit-price" type="number" step="0.01" value="@Model?.UnitPrice" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1 fw-semibold text-primary">Amount</label>
                <input name="Charges[@index].Amount" class="form-control form-control-sm text-end fw-bold bg-light text-dark charge-amount" type="number" step="0.01" value="@Model?.Amount" readonly />
            </div>
        </div>




    </div>
</div>
