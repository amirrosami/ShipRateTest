@using ShipRate.Application.JobsViewModels
@model CreateRTSInstructionVm


@{
    var isNew = Model.Id == Guid.Empty;
}

<form asp-action="CreateRTSInstruction"
      asp-controller="Jobs"
      method="post"
      hx-post="@Url.Action(isNew?"SaveRTSInstruction":"SaveRTSInstruction", "Jobs")"
      hx-target="#rtsModalContainer"
      hx-swap="innerHTML">

    <div class="modal-header">
        <h5 class="modal-title">New RTS Instruction</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        <input type="hidden" asp-for="BookingId" />
        <input type="hidden" asp-for="JobId" />
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="All"
             class="alert alert-danger"
             role="alert"
             style="display:@(ViewData.ModelState.IsValid ? "none" : "block")">
        </div>



        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="RTSInstructionNo" class="form-label"></label>
                <input asp-for="RTSInstructionNo" class="form-control" />
                <span asp-validation-for="RTSInstructionNo" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="RTSInstructionDate" class="form-label"></label>
                <input asp-for="RTSInstructionDate" type="date" class="form-control" />
                <span asp-validation-for="RTSInstructionDate" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="ShipperId" class="form-label">Shipper</label>
                <select asp-for="ShipperId" asp-items="Model.Shippers" class="form-select">
                    <option value="">Select shipper</option>
                </select>
                <span asp-validation-for="ShipperId" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="CarrierId" class="form-label">Carrier</label>
                <select asp-for="CarrierId" asp-items="Model.Carriers" class="form-select">
                    <option value="">Select carrier</option>
                </select>
                <span asp-validation-for="CarrierId" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="DepotId" class="form-label">Depot</label>
                <select asp-for="DepotId" asp-items="Model.Depots" class="form-select">
                    <option value="">Select depot</option>
                </select>
                <span asp-validation-for="DepotId" class="text-danger"></span>
            </div>

@*             <div class="col-md-6">
                <label asp-for="StatusId" class="form-label">Status</label>
                <select asp-for="StatusId" asp-items="Model.Statuses" class="form-select">
                    <option value="">Select status</option>
                </select>
                <span asp-validation-for="StatusId" class="text-danger"></span>
            </div>
 *@
            <div class="col-md-6">
                <label asp-for="ValidDateFrom" class="form-label"></label>
                <input asp-for="ValidDateFrom" type="date" class="form-control" />
                <span asp-validation-for="ValidDateFrom" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="ValidDateTo" class="form-label"></label>
                <input asp-for="ValidDateTo" type="date" class="form-control" />
                <span asp-validation-for="ValidDateTo" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="Remarks" class="form-label"></label>
                <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Remarks" class="text-danger"></span>
            </div>
        </div>
        <div class="table-responsive mt-4">
            <table class="table table-bordered table-sm">
                <thead>
                    <tr>
                        <th>Size Type</th>
                        <th>Available</th>
                        <th>Requested Count</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Containers.Count; i++)
                    {
                        <tr>
                            <td>
                                @Model.Containers[i].ContainerSizeTypeName
                                <input type="hidden" asp-for="Containers[i].ContainerSizeTypeId" />
                            </td>
                            <td>@Model.Containers[i].MaxAvailableCount</td>
                            <td>
                                <input type="number" asp-for="Containers[i].RequestedCount"
                                       class="form-control form-control-sm"
                                       min="0" max="@Model.Containers[i].MaxAvailableCount" />
                            </td>
                            <td>
                                <input type="text" asp-for="Containers[i].Remarks" class="form-control form-control-sm" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>




    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
