@using ShipRate.Application.DTOs
@model BookingFormVm

<style>
    /* تنظیم ارتفاع کل مودال روی ۹۰ درصد ارتفاع صفحه نمایش */
    #booking-modal-container {
        max-height: 90vh;
        margin-top: 0px;
    }

        #booking-modal-container .modal-content {
            height: 80vh;
            display: flex;
            flex-direction: column;
        }

        #booking-modal-container .modal-body {
            flex: 1 1 auto;
            overflow-y: auto;
        }

    /* تامین حداقل ارتفاع برای تب‌ها جهت جلوگیری از تغییر سایز مودال */
    #bookingTabContent {
        min-height: 520px;
    }
</style>

<div class="modal-dialog modal-xl modal-dialog-scrollable" id="booking-modal-container">
    <div class="modal-content">
        <div class="modal-header bg-primary text-white">
            <h5 class="modal-title">
                <i class="bi bi-journal-bookmark-fill me-2"></i>
                @(Model.Id.HasValue ? $"Edit Booking [ {Model.BookingNo} ]" : "Create New Booking")
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <!-- Single Form for Transaction Integrity -->
        <form id="bookingForm"
              hx-post="@Url.Action("Save", "Booking")"
              hx-target="#booking-modal-container"
              hx-swap="outerHTML"
              class="d-flex flex-column h-100">

            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="JobId" />
            <div class="modal-body p-0">
                <!-- Navigation Tabs & Tab Contents (d-flex حذف شد تا المان‌های داخلی stretch شوند) -->
                <div class="w-100">
                    <ul class="nav nav-tabs border-bottom px-3 pt-2 bg-light" id="bookingTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="general-tab" data-bs-toggle="tab" data-bs-target="#general" type="button" role="tab" aria-controls="general" aria-selected="true">General Info</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="cargo-tab" data-bs-toggle="tab" data-bs-target="#cargo" type="button" role="tab" aria-controls="cargo" aria-selected="false">Cargo Details</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="cutoffs-tab" data-bs-toggle="tab" data-bs-target="#cutoffs" type="button" role="tab" aria-controls="cutoffs" aria-selected="false">Milestones & Cut-offs</button>
                        </li>
                    </ul>

                    <div class="tab-content p-4" id="bookingTabContent">

                        <!-- 1. GENERAL TAB -->
                        <div class="tab-pane fade show active" id="general" role="tabpanel" aria-labelledby="general-tab">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label asp-for="CompanyId" class="form-label">Company</label>
                                    <select asp-for="CompanyId" asp-items="ViewBag.Companies" class="form-select"></select>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="CompanyRoleTypeId" class="form-label">Company Role</label>
                                    <select asp-for="CompanyRoleTypeId" asp-items="ViewBag.CompanyRoleTypes" class="form-select"></select>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="BookingNo" class="form-label ">Booking No</label>
                                    <input asp-for="BookingNo" class="form-control" placeholder="Generated automatically if blank" />
                                    <span asp-validation-for="BookingNo" class="text-danger small"></span>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="LineBookingNo" class="form-label">Line Booking No</label>
                                    <input asp-for="LineBookingNo" class="form-control" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="TransportTypeId" class="form-label">Transport Mode</label>
                                    <select asp-for="TransportTypeId" asp-items="ViewBag.TransportTypes"
                                            class="form-select"
                                            hx-get="@Url.Action("GetTransportDetailsForm", "Booking")"
                                            hx-target="#transport-mode-container"
                                            hx-include="[name='Id']"
                                            hx-trigger="change">
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="LoadTypeId" class="form-label">Load Type</label>
                                    <select asp-for="LoadTypeId" asp-items="ViewBag.LoadTypes" class="form-select"></select>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="ServiceTypeId" class="form-label">Service Type</label>
                                    <select asp-for="ServiceTypeId" asp-items="ViewBag.ServiceTypes" class="form-select"></select>
                                </div>
                                <div class="col-12 mt-1">
                                    <label asp-for="Remarks" class="form-label">General Remarks</label>
                                    <textarea asp-for="Remarks" class="form-control" rows="2" placeholder="Enter general booking notes..."></textarea>
                                </div>

                                <div class="col-12 mt-2">
                                    <h6 class="border-bottom pb-2">Booking Parties</h6>
                                    <div id="booking-parties-container">
                                        <partial name="~/Views/Booking/_BookingPartiesList.cshtml" model="Model" />
                                    </div>
                                </div>
                                <div class="row g-3 border-bottom pb-4 mb-4">
                                    <h6 class="border-bottom pb-2 text-danger">Routing</h6>
                                    <div class="col-md-4">
                                        <label asp-for="OriginId" class="form-label">Place Of Receipt(Origin)</label>
                                        <input type="hidden" asp-for="OriginId" id="OriginId" />
