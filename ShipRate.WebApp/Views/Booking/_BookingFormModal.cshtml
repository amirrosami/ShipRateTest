@using ShipRate.Application.DTOs
@model BookingFormVm

<style>
    /* تنظیم ابعاد کلی مودال */
    #booking-modal-container {
        width: 95%;
        max-width: 980px;
        margin: 15px auto;
    }

        #booking-modal-container .modal-content {
            height: 88vh;
            max-height: 88vh;
            display: flex;
            flex-direction: column;
        }

        #booking-modal-container form {
            display: flex;
            flex-direction: column;
            flex: 1 1 auto;
            min-height: 0;
        }

        #booking-modal-container .modal-body {
            flex: 1 1 auto;
            overflow-y: auto;
            min-height: 0;
            font-size: 0.875rem; /* فونت پایه بدنه مودال (14px) */
        }

    /* در نمایشگرهای کوچک */
    @@media (max-width: 991.98px) {
        #booking-modal-container {
            width: 95%;
            max-width: 95%;
        }
    }

    @@media (max-width: 575.98px) {
        #booking-modal-container {
            width: 100%;
            max-width: 100%;
            margin: 0;
        }

            #booking-modal-container .modal-content {
                height: 100vh;
                max-height: 100vh;
                border-radius: 0;
            }
    }

    /* استایل سلول‌های اکسل‌مانند با فونت بزرگتر و خواناتر */
    .excel-label {
        background-color: #e7f1ff !important;
        border: 1px solid #ced4da;
        font-weight: 600;
        color: #233242;
        font-size: 0.875rem; /* بزرگتر شده (14px) */
        display: flex;
        align-items: center;
        padding: 0.4rem 0.6rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .excel-input {
        border: 1px solid #ced4da;
        border-left: none;
        padding: 0;
        display: flex;
        align-items: center;
        background-color: #ffffff;
        min-width: 0;
    }

        .excel-input .form-control-sm,
        .excel-input .form-select-sm {
            border: none !important;
            border-radius: 0 !important;
            box-shadow: none !important;
            height: 100%;
            min-height: 32px;
            padding: 0.35rem 0.6rem;
            font-size: 0.875rem; /* بزرگتر شده (14px) */
        }

    #booking-modal-container .form-control-sm:focus,
    #booking-modal-container .form-select-sm:focus {
        background-color: #fff9c4 !important;
        outline: 1px solid #ffd54f !important;
    }

    #booking-modal-container .section-title {
        font-size: 0.95rem; /* بزرگتر شده */
        font-weight: 700;
        padding-bottom: 0.35rem;
        margin-bottom: 0.6rem;
        border-bottom: 1.5px solid #dee2e6;
    }

    /* تب‌ها */
    #bookingTab .nav-link {
        font-size: 0.875rem;
        padding: 0.45rem 0.9rem;
    }

    /* ==============================================================
           Select2 Full Width & Excel Alignment & Font Fixes
           ============================================================== */
    #booking-modal-container .excel-input .select2-container {
        width: 100% !important;
        flex: 1 1 auto !important;
        min-width: 0 !important;
        display: block !important;
    }

    #booking-modal-container .excel-input .select2-selection--single {
        width: 100% !important;
        height: 100% !important;
        min-height: 32px !important;
        border: none !important;
        border-radius: 0 !important;
        background-color: transparent !important;
        display: flex !important;
        align-items: center !important;
        box-shadow: none !important;
    }

    #booking-modal-container .excel-input .select2-selection__rendered {
        padding-left: 0.6rem !important;
        padding-right: 1.75rem !important;
        font-size: 0.875rem !important; /* یکدست با سایر اینپوت‌ها */
        color: #212529 !important;
        line-height: normal !important;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        width: 100% !important;
    }

    #booking-modal-container .excel-input .select2-selection__arrow {
        height: 100% !important;
        right: 6px !important;
        display: flex !important;
        align-items: center !important;
    }

    /* کلاس فوکوس پویا برای هماهنگی با ظاهر زرد سلول اکسل */
    .excel-input.excel-focus {
        background-color: #fff9c4 !important;
        outline: 1px solid #ffd54f !important;
    }

        .excel-input.excel-focus .select2-selection--single {
            background-color: #fff9c4 !important;
        }
</style>

<div class="modal-dialog modal-lg modal-dialog-scrollable" id="booking-modal-container">
    <div class="modal-content">
        <div class="modal-header bg-primary text-white py-2">
            <h5 class="modal-title m-0 fw-bold fs-6">
                <i class="bi bi-journal-bookmark-fill me-2"></i>
                @(Model.Id.HasValue ? $"Edit Booking [ {Model.BookingNo} ]" : "Create New Booking")
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <!-- Single Form for Transaction Integrity -->
        <form id="bookingForm"
              hx-post="@Url.Action("Save", "Booking")"
              hx-target="#booking-modal-container"
              hx-swap="outerHTML"
              class="d-flex flex-column h-100">

            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="JobId" />

            <div class="modal-body p-0">
                <div class="w-100">
                    <ul class="nav nav-tabs border-bottom px-3 pt-2 bg-light" id="bookingTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active fw-semibold" id="general-tab" data-bs-toggle="tab" data-bs-target="#general" type="button" role="tab" aria-controls="general" aria-selected="true">General Info</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-semibold" id="cargo-tab" data-bs-toggle="tab" data-bs-target="#cargo" type="button" role="tab" aria-controls="cargo" aria-selected="false">Cargo Details</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-semibold" id="cutoffs-tab" data-bs-toggle="tab" data-bs-target="#cutoffs" type="button" role="tab" aria-controls="cutoffs" aria-selected="false">Milestones & Cut-offs</button>
                        </li>
                    </ul>

                    <div class="tab-content p-3" id="bookingTabContent">

                        <!-- 1. GENERAL TAB -->
                        <div class="tab-pane fade show active" id="general" role="tabpanel" aria-labelledby="general-tab">

                            <!-- General Fields (Excel-Like Grid) -->
                            <div class="container-fluid p-0 mb-3">
                                <div class="row g-0 mb-1">
                                    <div class="col-md-2 excel-label" title="Company">Company</div>
                                    <div class="col-md-4 excel-input">
                                        <select asp-for="CompanyId" asp-items="ViewBag.Companies" class="form-select form-select-sm w-100"></select>
                                    </div>

                                    <div class="col-md-2 excel-label" title="Company Role">Role</div>
                                    <div class="col-md-4 excel-input">
                                        <select asp-for="CompanyRoleTypeId" asp-items="ViewBag.CompanyRoleTypes" class="form-select form-select-sm w-100"></select>
                                    </div>

                                    <div class="col-md-2 excel-label" title="Booking No">Booking No</div>
                                    <div class="col-md-4 excel-input">
                                        <input asp-for="BookingNo" class="form-control form-control-sm w-100" placeholder="Auto-generated if blank" />
                                    </div>
                                    <div class="col-md-2 excel-label" title="Line Booking No">Line Bk No</div>
                                    <div class="col-md-4 excel-input">
                                        <input asp-for="LineBookingNo" class="form-control form-control-sm w-100" />
                                    </div>
                                </div>

                                <div class="row g-0 mb-1">
                                    <div class="col-md-2 excel-label" title="Transport Mode">Transport Mode</div>
                                    <div class="col-md-4 excel-input">
                                        <select asp-for="TransportTypeId" asp-items="ViewBag.TransportTypes"
                                                class="form-select form-select-sm w-100"
                                                hx-get="@Url.Action("GetTransportDetailsForm", "Booking")"
                                                hx-target="#transport-mode-container"
                                                hx-include="[name='Id']"
                                                hx-trigger="change">
                                        </select>
                                    </div>

                                    <div class="col-md-2 excel-label" title="Load Type">Load Type</div>
                                    <div class="col-md-4 excel-input">
                                        <select asp-for="LoadTypeId" asp-items="ViewBag.LoadTypes" class="form-select form-select-sm w-100"></select>
                                    </div>
                                </div>

                                <div class="row g-0 mb-1">
                                    <div class="col-md-2 excel-label" title="Service Type">Service</div>
                                    <div class="col-md-4 excel-input">
                                        <select asp-for="ServiceTypeId" asp-items="ViewBag.ServiceTypes" class="form-select form-select-sm w-100"></select>
                                    </div>
                                </div>
                                <div class="row g-0 mb-1">
                                    <div class="col-md-2 excel-label" title="Remarks">Remarks</div>
                                    <div class="col-md-10 excel-input">
                                        <textarea asp-for="Remarks" class="form-control form-control-sm w-100" rows="2" placeholder=""></textarea>
                                    </div>
                                </div>
                            </div>

                            <!-- Dynamic Transport Container -->
                            <div id="transport-mode-container" class="mb-2"></div>

                            <!-- Booking Parties -->
                            <div class="col-12 mt-3 mb-3">
                                <div class="section-title text-primary d-flex justify-content-between align-items-center">
                                    <span>
                                        <i class="bi bi-people me-1"></i>
                                        Booking Parties
                                    </span>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary py-0 px-2"
                                            hx-get="@Url.Action("AddPartyRow", "Booking")"
                                            hx-target="#parties-table-body"
                                            hx-swap="beforeend">
                                        <i class="bi bi-plus-lg me-1"></i>
                                        Add Party
                                    </button>
                                </div>

                                <div id="booking-parties-container">
                                    <partial name="~/Views/Booking/_BookingPartiesList.cshtml"
                                             model="Model" />
                                </div>
                            </div>

                            <!-- Routing Section (Excel-Like Grid) -->
                            <div class="col-12 mb-3">
                                <div class="section-title text-primary">
                                    <i class="bi bi-geo-alt me-1"></i> Routing
                                </div>
                                <div class="container-fluid p-0">
                                    <div class="row g-0 mb-1">
                                        <div class="col-md-2 excel-label" title="Place Of Receipt (Origin)">Origin</div>
                                        <div class="col-md-4 excel-input">
                                            <select id="OriginSelect2" name="OriginId" class="form-select form-select-sm w-100">
                                                @if (Model.OriginId.HasValue && Model.OriginId.Value != Guid.Empty)
                                                {
                                                    <option value="@Model.OriginId" selected="selected">@Model.OriginName</option>
                                                }
                                            </select>
                                        </div>

                                        <div class="col-md-2 excel-label" title="Port Of Loading">POL</div>
                                        <div class="col-md-4 excel-input">
                                            <select id="POLSelect2" name="POLId" class="form-select form-select-sm w-100">
                                                @if (Model.POLId.HasValue && Model.POLId.Value != Guid.Empty)
                                                {
                                                    <option value="@Model.POLId" selected="selected">@Model.POLName</option>
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <div class="row g-0 mb-1">
                                        <div class="col-md-2 excel-label" title="Port Of Discharge">POD</div>
                                        <div class="col-md-4 excel-input">
                                            <select id="PODSelect2" name="PODId" class="form-select form-select-sm w-100">
                                                @if (Model.PODId.HasValue && Model.PODId.Value != Guid.Empty)
                                                {
                                                    <option value="@Model.PODId" selected="selected">@Model.PODName</option>
                                                }
                                            </select>
                                        </div>

                                        <div class="col-md-2 excel-label" title="Final Destination">Dest</div>
                                        <div class="col-md-4 excel-input">
                                            <select id="DestSelect2" name="DestId" class="form-select form-select-sm w-100">
                                                @if (Model.DestId.HasValue && Model.DestId.Value != Guid.Empty)
                                                {
                                                    <option value="@Model.DestId" selected="selected">@Model.DestName</option>
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <div class="row g-0 mb-1">
                                        <div class="col-md-2 excel-label" title="Transhipment Port">Tranship</div>
                                        <div class="col-md-4 excel-input">
                                            <select id="TranshipmentPortSelect2" name="TranshipPortId" class="form-select form-select-sm w-100">
                                                @if (Model.TranshipPortId.HasValue && Model.TranshipPortId.Value != Guid.Empty)
                                                {
                                                    <option value="@Model.TranshipPortId" selected="selected">@Model.TranshipPortName</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-6"></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Sea Voyage & Vessel Specifications -->
                            <div class="card border mb-3 shadow-none">
                                <div class="section-title text-primary">
                                    <i class="bi bi-water me-1"></i> Sea Voyage & Vessel Specifications
                                </div>
                                <div class="card-body p-2">
                                    <input type="hidden" asp-for="SeaDetail.Id" />
                                    <div class="row g-0 mb-1">
                                        <div class="col-md-2 excel-label">Carrier</div>
                                        <div class="col-md-4 excel-input">
                                            <select asp-for="SeaDetail.ShippingLineId" asp-items="ViewBag.Carriers" class="form-select form-select-sm w-100">
                                                <option value="">-- Select Line --</option>
                                            </select>
                                        </div>

                                        <div class="col-md-2 excel-label">Service</div>
                                        <div class="col-md-4 excel-input">
                                            <input asp-for="SeaDetail.ServiceName" class="form-control form-control-sm w-100" placeholder="Service Name" />
                                        </div>

                                        <div class="col-md-2 excel-label">Pickup Depot</div>
                                        <div class="col-md-4 excel-input">
                                            <select asp-for="SeaDetail.EmptyPickupDepotId" asp-items="ViewBag.Depots" class="form-select form-select-sm w-100">
                                                <option value="">-- Select Depot --</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="row g-0 mb-1">
                                        <div class="col-md-2 excel-label">Return Depot</div>
                                        <div class="col-md-4 excel-input">
                                            <select asp-for="SeaDetail.EmptyReturnDepotId" asp-items="ViewBag.Depots" class="form-select form-select-sm w-100">
                                                <option value="">-- Select Depot --</option>
                                            </select>
                                        </div>

                                        <div class="col-md-2 excel-label">Recv Term</div>
                                        <div class="col-md-4 excel-input">
                                            <select asp-for="SeaDetail.ReceivingTerminalId" asp-items="ViewBag.Terminals" class="form-select form-select-sm w-100">
                                                <option value="">-- Select Terminal --</option>
                                            </select>
                                        </div>

                                        <div class="col-md-4"></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Booking Containers Allocation -->
                            <div class="col-12 mt-2">
                                <div class="section-title text-primary d-flex justify-content-between align-items-center">
                                    <div class="section-title text-primary mb-0 border-0">
                                        <i class="bi bi-box-seam me-1"></i> Booking Containers Allocation
                                    </div>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary py-0 px-2"
                                            hx-get="@Url.Action("AddContainerRow", "Booking")"
                                            hx-target="#container-rows-container"
                                            hx-swap="beforeend">
                                        <i class="bi bi-plus-lg me-1"></i> Add Container
                                    </button>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover border align-middle mb-0" style="font-size: 0.875rem;">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width: 30%;">Container Size Type</th>
                                                <th style="width: 25%;">Ownership Type</th>
                                                <th style="width: 10%;">Count</th>
                                                <th style="width: 10%;">Over Length (CM)</th>
                                                <th style="width: 10%;">Over Width (CM)</th>
                                                <th style="width: 10%;">Over Height (CM)</th>
                                                <th style="width: 5%;"></th>
                                            </tr>
                                        </thead>
                                        <tbody id="container-rows-container">
                                            <partial name="~/Views/Booking/_BookingContainersList.cshtml" model="Model" />
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                        </div>

                        <!-- 2. CARGO DETAILS TAB -->
                        <div class="tab-pane fade" id="cargo" role="tabpanel" aria-labelledby="cargo-tab">
                            <partial name="~/Views/CargoDetails/_CargoDetailsPanel.cshtml" model="Model.CargoItems" />
                        </div>

                        <!-- 3. MILESTONES & CUT-OFFS TAB -->
                        <div class="tab-pane fade" id="cutoffs" role="tabpanel" aria-labelledby="cutoffs-tab">
                            <div class="section-title text-danger mb-3">
                                <i class="bi bi-calendar-check me-1"></i> Milestones & Cut-off Dates
                            </div>

                            <div class="container-fluid p-0">
                                <div class="row g-0 mb-1">
                                    <div class="col-md-2 excel-label" title="Cargo Ready Date">Cargo Ready Date</div>
                                    <div class="col-md-4 excel-input">
                                        <input asp-for="CargoReadyDate" class="form-control form-control-sm w-100" type="date" />
                                    </div>

                                    <div class="col-md-2 excel-label" title="Cargo Cut-Off Date">Cargo Cut-Off Date</div>
                                    <div class="col-md-4 excel-input">
                                        <input asp-for="CutOffDate" class="form-control form-control-sm w-100" type="date" />
                                    </div>
                                </div>

                                <div class="row g-0 mb-1">
                                    <div class="col-md-2 excel-label" title="Shipping Instructions (SI) Cut-Off">SI Cut-Off Date</div>
                                    <div class="col-md-4 excel-input">
                                        <input asp-for="SICutOffDate" class="form-control form-control-sm w-100" type="date" />
                                    </div>

                                    <div class="col-md-2 excel-label" title="VGM Cut-Off Date">VGM Cut-Off Date</div>
                                    <div class="col-md-4 excel-input">
                                        <input asp-for="VGMCutOffDate" class="form-control form-control-sm w-100" type="date" />
                                    </div>
                                </div>

                                <div class="row g-0 mb-1">
                                    <div class="col-md-2 excel-label" title="Documentation Cut-Off">Doc Cut-Off Date</div>
                                    <div class="col-md-4 excel-input">
                                        <input asp-for="DocumentCutOffDate" class="form-control form-control-sm w-100" type="date" />
                                    </div>
                                    <div class="col-md-6"></div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="modal-footer bg-light border-top py-2 d-flex justify-content-end align-items-center">
                <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Close</button>
                <button type="submit" class="btn btn-primary px-4 shadow-sm">
                    <i class="bi bi-save me-1"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    // مدیریت داینامیک ایندکس ردیف‌های HTMX
    document.body.addEventListener('htmx:afterSwap', function (evt) {
        const container = evt.detail.target;
        const dynamicContainers = [
            'legs-table-body',
            'container-rows-container',
            'booking-parties-container',
            'charge-rows-container',
            'cargo-rows-container'
        ];
        if (!dynamicContainers.includes(container.id)) return;

        const newRow = container.lastElementChild;
        if (!newRow) return;

        const rowIndex = container.children.length - 1;

        const elements = newRow.querySelectorAll('[name],[id],[for],[data-valmsg-for]');
        elements.forEach(el => {
            if (el.name) el.name = el.name.replace(/__INDEX__/g, rowIndex);
            if (el.id) el.id = el.id.replace(/__INDEX__/g, rowIndex);
            if (el.htmlFor) el.htmlFor = el.htmlFor.replace(/__INDEX__/g, rowIndex);

            const valmsg = el.getAttribute('data-valmsg-for');
            if (valmsg) {
                el.setAttribute('data-valmsg-for', valmsg.replace(/__INDEX__/g, rowIndex));
            }
        });
    });
</script>

<script>
    // مدیریت سطرهای Voyage / Road / Rail / Flight
    document.addEventListener('htmx:afterSwap', function (evt) {
        if (evt.detail.target.id === "voyage-rows") {
            const rows = document.querySelectorAll("#voyage-rows .voyage-row");
            const newRow = rows[rows.length - 1];
            if (newRow && newRow.innerHTML.includes("__INDEX__")) {
                const index = rows.length - 1;
                newRow.innerHTML = newRow.innerHTML
                    .replace(/__INDEX_PLUS_1__/g, index + 1)
                    .replace(/__INDEX__/g, index);
            }
        }
    });

    function removeVoyageRow(button) {
        const row = button.closest('tr');
        if (row) {
            row.remove();
            reIndexVoyages();
        }
    }

    function reIndexVoyages() {
        const rows = document.querySelectorAll("#voyage-rows .voyage-row");
        rows.forEach((row, index) => {
            const seq = row.querySelector('.seq-no');
            if (seq) seq.innerText = index + 1;

            const inputs = row.querySelectorAll('input, select');
            inputs.forEach(input => {
                if (input.name) {
                    input.name = input.name.replace(/SeaDetail\.Voyages\[\d+\]/, `SeaDetail.Voyages[${index}]`);
                }
            });
        });
    }

    document.addEventListener('htmx:afterSwap', function (evt) {
        if (evt.detail.target.id === "road-rows") {
            const rows = document.querySelectorAll("#road-rows .road-row");
            const newRow = rows[rows.length - 1];
            if (newRow && newRow.innerHTML.includes("__INDEX__")) {
                const index = rows.length - 1;
                newRow.innerHTML = newRow.innerHTML.replace(/__INDEX__/g, index);
            }
        }
    });

    function removeRoadRow(button) {
        const row = button.closest('tr');
        if (row) {
            row.remove();
            reIndexRoad();
        }
    }

    function reIndexRoad() {
        const rows = document.querySelectorAll("#road-rows .road-row");
        rows.forEach((row, index) => {
            const inputs = row.querySelectorAll('input, select');
            inputs.forEach(input => {
                if (input.name) {
                    input.name = input.name.replace(/RoadDetails\[\d+\]/, `RoadDetails[${index}]`);
                }
            });
        });
    }

    document.addEventListener('htmx:afterSwap', function (evt) {
        if (evt.detail.target.id === "rail-rows") {
            const rows = document.querySelectorAll("#rail-rows .rail-row");
            const newRow = rows[rows.length - 1];
            if (newRow && newRow.innerHTML.includes("__INDEX__")) {
                const index = rows.length - 1;
                newRow.innerHTML = newRow.innerHTML.replace(/__INDEX__/g, index);
            }
        }
    });

    function removeRailRow(button) {
        const row = button.closest('tr');
        if (row) {
            row.remove();
            reIndexRail();
        }
    }

    function reIndexRail() {
        const rows = document.querySelectorAll("#rail-rows .rail-row");
        rows.forEach((row, index) => {
            const inputs = row.querySelectorAll('input, select, textarea');
            inputs.forEach(input => {
                if (input.name) {
                    input.name = input.name.replace(/RailDetails\[\d+\]/, `RailDetails[${index}]`);
                }
            });
        });
    }

    document.addEventListener('htmx:afterSwap', function (evt) {
        if (evt.detail.target.id === "flight-rows") {
            const rows = document.querySelectorAll("#flight-rows .flight-row");
            const newRow = rows[rows.length - 1];
            if (newRow && newRow.innerHTML.includes("__INDEX__")) {
                const index = rows.length - 1;
                newRow.innerHTML = newRow.innerHTML
                    .replace(/__INDEX_PLUS_1__/g, index + 1)
                    .replace(/__INDEX__/g, index);
            }
        }
    });

    function removeFlightRow(button) {
        const row = button.closest('tr');
        if (row) {
            row.remove();
            reIndexFlights();
        }
    }

    function reIndexFlights() {
        const rows = document.querySelectorAll("#flight-rows .flight-row");
        rows.forEach((row, index) => {
            const seq = row.querySelector('.seq-no');
            if (seq) seq.innerText = index + 1;

            const inputs = row.querySelectorAll('input, select');
            inputs.forEach(input => {
                if (input.name) {
                    input.name = input.name.replace(/AirDetail\.Flights\[\d+\]/, `AirDetail.Flights[${index}]`);
                }
            });
        });
    }
</script>

<script>
    (function () {
        function initAllBookingSelect2() {
            var $modal = $('#bookingModal');

            function setupSelect2(selector, placeholderText, url) {
                var $select = $(selector);
                if (!$select.length) return;

                if ($select.hasClass('select2-hidden-accessible')) {
                    $select.select2('destroy');
                }

                $select.select2({
                    theme: 'bootstrap-5',
                    width: '100%',
                    placeholder: placeholderText,
                    allowClear: true,
                    minimumInputLength: 1,
                    dropdownParent: $modal.length ? $modal : $(document.body),
                    ajax: {
                        url: url,
                        dataType: 'json',
                        delay: 250,
                        data: function (params) {
                            return { q: params.term };
                        },
                        processResults: function (data) {
                            return {
                                results: data.results || $.map(data, function (item) {
                                    return { id: item.id, text: item.text };
                                })
                            };
                        }
                    }
                });

                // افزودن کلاس استایل زرد فوکوس اکسل به کانتینر والد
                $select.on('select2:open', function () {
                    $(this).closest('.excel-input').addClass('excel-focus');
                });

                $select.on('select2:close', function () {
                    $(this).closest('.excel-input').removeClass('excel-focus');
                });
            }

            setupSelect2('#OriginSelect2', 'Search Origin...', '/Locations/GetPortsJson');
            setupSelect2('#POLSelect2', 'Search POL...', '/Locations/GetPortsJson');
            setupSelect2('#PODSelect2', 'Search POD...', '/Locations/GetPortsJson');
            setupSelect2('#DestSelect2', 'Search Destination...', '/Locations/GetPortsJson');
            setupSelect2('#TranshipmentPortSelect2', 'Search Tranship...', '/Locations/GetPortsJson');
        }

        // اجرا در حالت عادی و در صورت لود مجدد فرم توسط HTMX
        $(document).ready(function () {
            initAllBookingSelect2();
        });

        setTimeout(initAllBookingSelect2, 50);
    })();
</script>
