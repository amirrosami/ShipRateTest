@using ShipRate.Application.DTOs
@model BookingFormVm

<div class="table-responsive">
    <table class="table table-sm table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th style="width: 45%;">Party Role Type</th>
                <th style="width: 45%;">Party</th>
                <th style="width: 10%; text-align: center;">Action</th>
            </tr>
        </thead>
        <tbody id="parties-table-body">
            @if (Model.BookingParties != null && Model.BookingParties.Any())
            {
                for (int i = 0; i < Model.BookingParties.Count; i++)
                {
                    var uniqueId = Model.BookingParties[i].Id.ToString();
                    <tr class="party-row">
                        <td>
                            <!-- ثبت ایندکس ردیف برای بایند شدن صحیح -->
                            <input type="hidden" name="BookingParties.Index" value="@uniqueId" />
                            <input type="hidden" name="BookingParties[@uniqueId].Id" value="@Model.BookingParties[i].Id" />

                            <select name="BookingParties[@uniqueId].PartyRoleTypeId" class="form-select form-select-sm" asp-for="@Model.BookingParties[i].PartyRoleTypeId" asp-items="ViewBag.PartyRoleTypes">
                                <option value="">-- Select Role --</option>
                            </select>
                        </td>
                        <td>
                            <select name="BookingParties[@uniqueId].PartyId" class="form-select form-select-sm" asp-for="@Model.BookingParties[i].PartyId" asp-items="ViewBag.Parties">
                                <option value="">-- Select Party --</option>
                            </select>
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove();">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

