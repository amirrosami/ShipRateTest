@using ShipRate.Domain.Entities.BaseInfo.Locations
@using ShipRate.Domain.Entities.BaseInfo.Persons
@using ShipRate.Domain.Entities.BaseInfo.Vehicles
@using ShipRate.Domain.Entities.Lines
@using ShipRate.Domain.Entities.Operations
@using ShipRate.Domain.Entities.Settings
@using ShipRate.WebApp.ViewModels.FlightVms
@using ShipRate.WebApp.ViewModels.TransitViewModels
@model TripViewModel
@{
    var trucks = ViewBag.Trucks as List<Truck>;
    var drivers = ViewBag.Drivers as List<Driver>;
    var locations = ViewBag.Locations as List<Location>;
    var carriers = ViewBag.Carriers as List<Carrier>;
    var companies = ViewBag.Companies as List<Company>;
}

@{
    string CreateEdit = ViewBag.CreateEdit;
    bool isCreateMode = false;
    if (CreateEdit == "Create") isCreateMode = true;
}

<form hx-post="@Url.Action(isCreateMode ? "Create" : "Edit", "Trips")"
      hx-target="#app-modal-content"
      hx-swap="innerHTML">

    <div class="modal-header form-caption-bg text-white">
        @if (isCreateMode)
        {
            <h5 class="modal-title">
                <i class="bi bi-plus-circle me-2"></i>Add Trip
            </h5>
        }
        else
        {
            <h5 class="modal-title">
                <i class="bi bi-pencil-square me-2"></i>Edit Trip
            </h5>
            <input type="hidden" asp-for="Id" />
        }

        <button type="button"
                class="btn-close"
                onclick="AppModal.close()">
        </button>
    </div>

    <div class="modal-body row">
        @Html.AntiForgeryToken()

        @await Html.PartialAsync("_ModelStateError")

        <div class="mb-3 col-md-4">
            <label>Trip Number *</label>
            <input type="text" name="TripNumber" class="form-control"
                   value="@Model.TripNumber" required placeholder="" />
            <span asp-validation-for="TripNumber" class="form-validation"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label>Company *</label>
            <select name="CompanyId" class="form-control" required>
                <option value="">-- Select Company --</option>
                @foreach (var c in companies)
                {
                    <option value="@c.Id" selected="@(Model.CompanyId == c.Id)">@c.Person.PersonName</option>
                }
            </select>
        </div>

        <div class="mb-3 col-md-4">
            <label>Truck *</label>
            <select name="TruckId" class="form-control" required>
                <option value="">-- Select Truck --</option>
                @foreach (var t in trucks)
                {
                    <option value="@t.Id" selected="@(Model.TruckId == t.Id)">
                        @t.TruckPlateNumber — @t.TruckReferenceTitle
                    </option>
                }
            </select>
        </div>
        <div class="mb-3 col-md-4">
            <label>Driver *</label>
            <select name="DriverId" class="form-control" required>
                <option value="">-- Select Driver --</option>
                @foreach (var d in drivers)
                {
                    <option value="@d.Id" selected="@(Model.DriverId == d.Id)">@d.Person.PersonName</option>
                }
            </select>
        </div>
        <div class="mb-3 col-md-4">
            <label>Carrier *</label>
            <select name="CarrierId" class="form-control" required>
                <option value="">-- Select Carrier --</option>
                @foreach (var c in carriers)
                {
                    <option value="@c.Id" selected="@(Model.CarrierId == c.Id)">@c.Person.PersonName</option>
                }
            </select>
        </div>
        
        <div class="mb-3 col-md-4">
            <label>Origin</label>
            <input type="hidden" asp-for="FromLocationId" id="FromLocationId" />
            <input type="text"
                   id="FromLocationSearchText"
                   name="FromLocation"
                   value="@Model.FromLocationName"
                   class="form-control"
                   placeholder="Search Origin..."
                   autocomplete="off"
                   hx-get="@Url.Action("SearchLocations", "Locations")"
                   hx-trigger="keyup changed delay:400ms"
                   hx-target="#originSearchResults"
                   hx-swap="innerHTML"
                   hx-vals='js:{
                            term: document.getElementById("FromLocationSearchText").value,
                            targetHiddenInputId: "FromLocationId",
                            targetTextInputId: "FromLocationSearchText"
                       }' />

            <div id="originSearchResults"
                 class="position-relative">
            </div>
            <span asp-validation-for="FromLocationId" class="text-danger small"></span>
        </div>





        <div class="mb-3 col-md-4">
            <label>Destination</label>
            <input type="hidden" asp-for="ToLocationId" id="ToLocationId" />
            <input type="text"
                   id="ToLocationSearchText"
                   name="ToLocation"
                   value="@Model.ToLocationName"
                   class="form-control"
                   placeholder="Search Destination..."
                   autocomplete="off"
                   hx-get="@Url.Action("SearchLocations", "Locations")"
                   hx-trigger="keyup changed delay:400ms"
                   hx-target="#destinationSearchResults"
                   hx-swap="innerHTML"
                   hx-vals='js:{
                            term: document.getElementById("ToLocationSearchText").value,
                            targetHiddenInputId: "ToLocationId",
                            targetTextInputId: "ToLocationSearchText"
                       }' />

            <div id="destinationSearchResults"
                 class="position-relative">
            </div>
            <span asp-validation-for="ToLocationId" class="text-danger small"></span>
        </div>

        <div class="mb-3 col-md-4">
            <label asp-for="ETD" class="form-label fw-semibold">
                <i class="bi bi-check-circle me-1 text-success"></i>ETD
            </label>
            <input asp-for="ETD" class="form-control" type="date" />
            <span asp-validation-for="ETD" class="text-danger small"></span>
        </div>

        <div class="mb-3 col-md-4">
            <label asp-for="ETA" class="form-label fw-semibold">
                <i class="bi bi-check-circle me-1 text-success"></i>ETA
            </label>
            <input asp-for="ETA" class="form-control" type="date" />
            <span asp-validation-for="ETA" class="text-danger small"></span>
        </div>

        <div class="mb-3 col-md-4">
            <label asp-for="DepartureDate" class="form-label fw-semibold">
                <i class="bi bi-check-circle me-1 text-success"></i>Departure Date
            </label>
            <input asp-for="DepartureDate" class="form-control" type="datetime-local" />
            <span asp-validation-for="DepartureDate" class="text-danger small"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="ArrivalDate" class="form-label fw-semibold">
                <i class="bi bi-check-circle me-1 text-success"></i>Arrival Date
            </label>
            <input asp-for="ArrivalDate" class="form-control" type="datetime-local" />
            <span asp-validation-for="ArrivalDate" class="text-danger small"></span>
        </div>

        <div class="mb-3 col-md-12">
            <label>Remarks</label>
            <textarea name="Remarks" class="form-control" rows="3"
                      placeholder="Additional notes about this trip..." >@Model.Remarks</textarea>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button"
                class="btn btn-secondary"
                onclick="AppModal.close()">
            Cancel
        </button>

        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>

            @if (isCreateMode)
            {
                <span>Save</span>
            }
            else
            {
                <span>Update</span>
            }
        </button>
    </div>
</form>





