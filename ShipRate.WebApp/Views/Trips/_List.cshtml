@using ShipRate.Application.DTOs
@using ShipRate.WebApp.ViewModels
@using ShipRate.WebApp.ViewModels.Location
@using ShipRate.WebApp.ViewModels.TransitViewModels
@model GridViewModel

@* PagedResultDto<LocationListItemViewModel> *@

@if (!Model.Data.Items.Any())
{
    <tr>
        <td colspan="11" class="text-center py-5 text-muted">
            <i class="bi bi-inbox display-4 d-block mb-2"></i>
            No Records found.
        </td>
    </tr>
}
else
{
    int counter = (Model.Data.Page - 1) * Model.Data.PageSize;
    @foreach (var item in Model.Data.Items)
    {
        var vm = (TripItemViewModel)item;
        counter++;
        <tr>
            <td>@counter</td>
            <td><strong>@vm.TripNumber</strong></td>
            <td>@vm.TruckPlateNumber</td>
            <td>@vm.DriverName</td>
            <td>
                @vm.Route    
            </td>
            <td>@vm.ETD?.ToString("yyyy-MM-dd")</td>
            <td>@vm.ETA?.ToString("yyyy-MM-dd")</td>
            <td>@vm.DepartureDate?.ToString("yyyy-MM-dd")</td>
            <td>@vm.ArrivalDate?.ToString("yyyy-MM-dd")</td>
            <td>@vm.CarrierName</td>
            <td>
                <span class="status-badge status-@vm.TripStatusId">
                    @vm.StatusName
                </span>
            </td>
            <td class="text-center">
                <div class="btn-group btn-group-sm">

                    <button type="button"
                            class="btn btn-outline-info"
                            title="Details"
                            hx-get="@Url.Action("TripStops", "Index", new { tripId = vm.Id })"
                            hx-target="#app-modal-content"
                            hx-swap="innerHTML">
                        <i class="bi bi-card-list"></i>
                    </button>

                    <button type="button"
                            class="btn btn-outline-primary"
                            title="Edit"
                            hx-get="@Url.Action("Edit", "Trips", new { id = vm.Id })"
                            hx-target="#app-modal-content"
                            hx-swap="innerHTML">
                        <i class="bi bi-pencil"></i>

                    </button>
                    <button type="button"
                            class="btn btn-outline-danger"
                            title="Delete"
                            hx-get="@Url.Action("Delete", "Trips", new { id = vm.Id })"
                            hx-target="#app-modal-content"
                            hx-swap="innerHTML">
                        <i class="bi bi-trash"></i>
                    </button>

                </div>
            </td>
        </tr>
    }
}





