@model PagedResult<TripItemViewModel>
@using ShipRate.WebApp.ViewModels
@using ShipRate.WebApp.ViewModels.Location
@using ShipRate.WebApp.ViewModels.TransitViewModels

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0"><i class="bi bi-box-seam me-2"></i>Trips</h2>
        <small class="text-muted"></small>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "Driver")"
           class="btn btn-outline-secondary"
           target="_blank"
           rel="noopener noreferrer">
            <i class="bi bi-person-badge me-1"></i> Drivers List
        </a>

        <a href="@Url.Action("Index", "Truck")"
           class="btn btn-outline-secondary"
           target="_blank"
           rel="noopener noreferrer">
            <i class="bi bi-truck me-1"></i> Trucks List
        </a>

        <button type="button"
                class="btn btn-primary"
                hx-get="@Url.Action("Create", "Trips")"
                hx-target="#app-modal-content"
                hx-swap="innerHTML">
            <i class="bi bi-plus-lg me-1"></i> New
        </button>
    </div>
</div>

@await Html.PartialAsync(
"_GridFilters",
    new GridFilterViewModel
    {
        Page = Model.Page,
        PageSize = Model.PageSize,
        SearchTerm = Model.SearchTerm,
        SortColumn = Model.SortColumn,
        SortDirection = Model.SortDirection,
        ListUrl = Url.Action("List", "Trips"),
        CustomFilterPartial = "",
        CustomFilterValues = Model.CustomFilterValues,
    }
)

<div id="table-container"
     hx-post="@Url.Action("List", "Trips")"
     hx-trigger="load, GridChanged from:body"
     hx-swap="innerHTML"
     hx-include="#grid-filters, #table-sort-info">
</div>
