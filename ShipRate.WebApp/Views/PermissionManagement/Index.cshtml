@using ShipRate.Web.ViewModels.PermissionManagement
@model List<UserListItemViewModel>

@{

    ViewData["Title"] = "Users Permissions Management";

}

<div class="container-fluid py-4">

    <div class="row">

        <div class="col-12">

            <div class="card">

                <div class="card-header bg-primary text-white">

                    <h4 class="mb-0">

                        <i class="fas fa-user-shield"></i>

                        @ViewData["Title"]

                    </h4>

                </div>

                <div class="card-body">

                    @if (TempData["Success"] != null)

                    {

                        <div class="alert alert-success alert-dismissible fade show" role="alert">

                            <i class="fas fa-check-circle"></i>

                            @TempData["Success"]

                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>

                        </div>

                    }

                    @if (TempData["Error"] != null)

                    {

                        <div class="alert alert-danger alert-dismissible fade show" role="alert">

                            <i class="fas fa-exclamation-circle"></i>

                            @TempData["Error"]

                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>

                        </div>

                    }

                    @if (Model == null || !Model.Any())

                    {

                        <div class="alert alert-info">

                            <i class="fas fa-info-circle"></i>

                            کاربری یافت نشد

                        </div>

                    }

                    else

                    {

                        <div class="table-responsive">

                            <table class="table table-hover table-striped">

                                <thead class="table-primary">

                                    <tr>

                                        <th>نام کاربری</th>

                                        <th>نام و نام خانوادگی</th>

                                        <th>ایمیل</th>

                                        <th class="text-center">تعداد دسترسی‌ها</th>

                                        <th class="text-center">وضعیت</th>

                                        <th class="text-center">عملیات</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var user in Model)

                                    {

                                        <tr>

                                            <td>

                                                <strong>@user.UserName</strong>

                                            </td>

                                            <td>

                                                @(string.IsNullOrEmpty(user.FullName) ? "-" : user.FullName)

                                            </td>

                                            <td>

                                                @(string.IsNullOrEmpty(user.Email) ? "-" : user.Email)

                                            </td>

                                            <td class="text-center">

                                                @if (user.PermissionsCount > 0)

                                                {

                                                    <span class="badge bg-success">@user.PermissionsCount</span>

                                                }

                                                else

                                                {

                                                    <span class="badge bg-secondary">0</span>

                                                }

                                            </td>

                                            <td class="text-center">

                                                @if (user.IsActive)

                                                {

                                                    <span class="badge bg-success">فعال</span>

                                                }

                                                else

                                                {

                                                    <span class="badge bg-danger">غیرفعال</span>

                                                }

                                            </td>

                                            <td class="text-center">

                                                <a asp-action="ManagePermissions"
                                                   asp-route-id="@user.UserId"
                                                   class="btn btn-sm btn-primary"
                                                   title="مدیریت دسترسی‌ها">

                                                    <i class="fas fa-key"></i>

                                                    مدیریت دسترسی‌ها

                                                </a>

                                            </td>

                                        </tr>

                                    }

                                </tbody>

                            </table>

                        </div>

                        <div class="mt-3">

                            <small class="text-muted">

                                <i class="fas fa-users"></i>

                                تعداد کل: @Model.Count کاربر

                            </small>

                        </div>

                    }

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        // Auto-hide alerts after 5 seconds

        setTimeout(function() {

        $(‘.alert’).fadeOut(‘slow’);

        }, 5000);

    </script>

}