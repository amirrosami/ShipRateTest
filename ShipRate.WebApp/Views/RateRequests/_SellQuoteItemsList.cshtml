@using ShipRate.WebApp.ViewModels
@model List<SellQuoteItemListViewModel>
@Html.AntiForgeryToken()
<div class="card">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0">
            <i class="bi bi-list-ul"></i> Sell Quotation Details
        </h5>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm table-bordered table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Charge Code</th>
                            <th>Charge Name</th>
                            <th>Size Type</th>
                            <th>Quantity</th>
                            <th>Unit Rate</th>
                            <th>Total Amount</th>
                            <th>Currency</th>
                            <th>Remaerks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var q in Model)
                        {
                            <tr>
                                <td>@q.ChargeTypeCode</td>
                                <td>@q.ChargeTypeName</td>
                                <td>@q.SizeTypeShortName</td>
                                <td>@q.Quantity</td>
                                <td>@q.UnitRate</td>
                                <td>@q.TotalAmount</td>
                                <td>@q.CurrencyCode ( @q.CurrencyName )</td>
                                <td>@q.Remarks</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info mb-0">
                <i class="bi bi-info-circle"></i> No details found for this quotation.
            </div>
        }
    </div>
    <div class="card-footer text-end">
        <button class="btn btn-sm btn-secondary" onclick="document.getElementById('sellQuoteItemsListContainer').innerHTML = ''">
            <i class="bi bi-x-circle"></i> Close
        </button>
    </div>
</div>

