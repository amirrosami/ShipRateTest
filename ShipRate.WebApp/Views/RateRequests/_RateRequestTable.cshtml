@using ShipRate.WebApp.ViewModels
@model RateRequestListViewModel

<style>
    /* کوچک‌تر کردن فونت و فشرده‌تر کردن جدول */
    .table-sm {
        font-size: 14px !important;
    }

        .table-sm th, .table-sm td {
            padding: 0.4rem 0.5rem !important;
            vertical-align: middle;
        }

    .btn-xs {
        padding: 0.15rem 0.4rem;
        font-size: 1rem;
        line-height: 1;
    }

    .table-responsive {
        overflow-x: scroll !important;
        -webkit-overflow-scrolling: touch;
    }

        /* نمایش همیشگی scrollbar در مرورگرهای مختلف */
        .table-responsive::-webkit-scrollbar {
            height: 12px;
            -webkit-appearance: none;
        }

        .table-responsive::-webkit-scrollbar-track {
            background-color: #f1f1f1;
            border-radius: 10px;
        }

        .table-responsive::-webkit-scrollbar-thumb {
            background-color: #888;
            border-radius: 10px;
        }

            .table-responsive::-webkit-scrollbar-thumb:hover {
                background-color: #555;
            }

    /* برای Firefox */
    .table-responsive {
        scrollbar-width: thin;
        scrollbar-color: #888 #f1f1f1;
    }

    /* فریز کردن ستون Actions در سمت راست */
    .col-sticky-action {
        position: sticky;
        right: 0;
        z-index: 2;
        background-color: #fff;
        box-shadow: -3px 0 6px rgba(0, 0, 0, 0.08);
    }

    thead .col-sticky-action {
        z-index: 3;
    }
</style>

<input type="hidden"
       name="PageNumber"
       value="@Model.Pagination.PageNumber" />

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover table-striped table-sm mb-0">
            <thead class="table-primary">
                <tr>
                    <th style="width: 50px; text-align: center;">#</th>
                    <th>Request No</th>
                    <th>Request Date</th>
                    <th>Customer</th>
                    <th>Mobile</th>
                    <th>Email</th>
                    <th>Origin</th>
                    <th>Destination</th>
                    <th>Status</th>
                    <th>Sales User</th>
                    <th>Created By</th>
                    <th>Last Edited By</th>
                    <th class="col-sticky-action" style="min-width: 280px; width: 280px;">Actions</th>
                </tr>
            </thead>

            <tbody>
                @{
                    int rowIndex = (Model.Pagination.PageNumber - 1) * Model.Pagination.PageSize;
                }
                @foreach (var r in Model.Items)
                {
                    rowIndex++;
                    <tr>
                        <td class="text-center text-muted fw-bold">@rowIndex</td>
                        <td>@r.RequestNo</td>
                        <td>@r.RequestDate.ToString("yyyy-MM-dd")</td>
                        <td>@r.CustomerName</td>
                        <td>@r.MobileNo</td>
                        <td>@r.EmailAddress</td>
                        <td>@r.OriginName</td>
                        <td>@r.DestinationName</td>
                        <td>@r.StatusName</td>
                        <td>@r.SalesUserName</td>
                        <td>@r.CreatedByUserName</td>
                        <td>@r.LastEditedByUserName</td>
                        <td class="col-sticky-action text-end text-nowrap">
                            <div class="btn-group btn-group-sm" role="group">
                                <button class="btn btn-outline-primary px-2"
                                        hx-swap="innerHTML"
                                        title="Edit"
                                        hx-get="/RateRequests/Edit/@r.Id"
                                        hx-target="#modalContent"
                                        data-bs-toggle="modal"
                                        data-bs-target="#rateRequestModal">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger action-icon-btn"
                                        title="Reject Rate Request"
                                        hx-get="/RateRequests/RejectRateRequest?Id=@r.Id"
                                        hx-confirm="Reject rate request?"
                                        hx-target="#modal-content"
                                        hx-swap="innerHTML">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-info"
                                        hx-get="/RateRequests/AssignSalesUser?id=@r.Id"
                                        hx-target="#modal-content2"
                                        hx-swap="innerHTML"
                                        title="Assign Sales User">
                                    <i class="bi bi-person-plus"></i>
                                </button>
                                <button class="btn btn-success px-2"
                                        title="Inquiries"
                                        hx-get="/RateRequests/GetInquiries/@r.Id"
                                        hx-target="#inquiryListContainer"
                                        hx-swap="innerHTML">
                                    <i class="bi bi-list-ul"></i>
                                </button>
                                <button class="btn btn-outline-danger px-2"
                                        hx-confirm="Delete this lead?"
                                        hx-target="closest tr"
                                        hx-post="/RateRequests/Delete/@r.Id"
                                        hx-swap="outerHTML swap:1s"
                                        title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>

                                <button class="btn btn-outline-info px-2"
                                        hx-get="/DocumentManager/Index?objectId=@r.Id&objectTypeId=11"
                                        hx-target="#document-manager-content"
                                        hx-swap="innerHTML"
                                        title="Documents"
                                        data-bs-toggle="modal"
                                        data-bs-target="#documentManagerModal">
                                    <i class="bi bi-folder2-open "></i>
                                </button>
                                <button class="btn btn-outline-secondary px-2"
                                        hx-get="/RateRequests/GetResponds?rateRequestId=@r.Id"
                                        hx-target="#respondsListContainer"
                                        hx-swap="innerHTML"
                                        title="Responds">
                                    <i class="bi bi-list-ul "></i>
                                </button>

                                <button class="btn btn-outline-primary px-2"
                                        hx-get="/RateRequests/GetSellQuotes?rateRequestId=@r.Id"
                                        hx-target="#SellQuotesListContainer"
                                        hx-swap="innerHTML"
                                        title="view responses sent to Customer ">
                                    <i class="bi bi-send-check text-success"></i>
                                </button>

                                <button class="btn btn-outline-secondary px-2"
                                        hx-get="@Url.Action("IndexModal", "ActivityLog", new { entityTypeId = 8, entityId = r.Id, externalReferenceNo = r.RequestNo })"
                                        hx-target="#activityLogModalContainer"
                                        hx-swap="innerHTML"
                                        title="View Logs">
                                    <i class="bi bi-clock-history"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="card-footer d-flex justify-content-between align-items-center">
        <div>
            Total: @Model.Pagination.TotalCount
        </div>

        <nav>
            <ul class="pagination pagination-sm mb-0">
                @{
                    var currentPage = Model.Pagination.PageNumber;
                    var totalPages = (int)Math.Ceiling((double)Model.Pagination.TotalCount / Model.Pagination.PageSize);
                    var startPage = Math.Max(1, currentPage - 2);
                    var endPage = Math.Min(totalPages, currentPage + 2);
                }

                @if (currentPage > 1)
                {
                    <li class="page-item">
                        <button class="page-link"
                                hx-get="/RateRequests/Index?PageNumber=1"
                                hx-target="#tableContainer"
                                hx-push-url="true">
                            First
                        </button>
                    </li>
                    <li class="page-item">
                        <button class="page-link"
                                hx-get="/RateRequests/Index?PageNumber=@(currentPage - 1)"
                                hx-target="#tableContainer"
                                hx-push-url="true">
                            Previous
                        </button>
                    </li>
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <button class="page-link"
                                hx-get="/RateRequests/Index?PageNumber=@i"
                                hx-target="#tableContainer"
                                hx-push-url="true">
                            @i
                        </button>
                    </li>
                }

                @if (currentPage < totalPages)
                {
                    <li class="page-item">
                        <button class="page-link"
                                hx-get="/RateRequests/Index?PageNumber=@(currentPage + 1)"
                                hx-target="#tableContainer"
                                hx-push-url="true">
                            Next
                        </button>
                    </li>
                    <li class="page-item">
                        <button class="page-link"
                                hx-get="/RateRequests/Index?PageNumber=@totalPages"
                                hx-target="#tableContainer"
                                hx-push-url="true">
                            Last
                        </button>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>

<script>
    function sendAllDraftInquiryEmails(rateRequestId) {
        if (!confirm('آیا از ارسال همه Inquiry های Draft این Rate Request مطمئن هستید؟')) {
            return;
        }

        fetch('/RateRequests/SendAllDraftInquiryEmails', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': getAntiForgeryToken()
            },
            body: `rateRequestId=${rateRequestId}`
        })
        .then(response => response.json())
        .then(result => {
            alert(result.message);
            if (result.success) {
                location.reload();
            }
        })
        .catch(err => {
            alert('Error in sending emails');
            console.error(err);
        });
    }
</script>
