@using ShipRate.Application.ViewModels
@model AcceptSellQuoteVm
<form asp-action="AcceptSellQuoteInApp"
      method="post"
      hx-post="@Url.Action("AcceptSellQuoteInApp")"
      hx-target="#SellQuotesListContainer"
      hx-swap="innerHTML">

    @Html.AntiForgeryToken()
    <input asp-for="SellQuoteId" type="hidden" />

    <div class="modal-header">
        <h5 class="modal-title text-danger">Accept Quotation Response</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-success mb-3"></div>

        <div class="alert alert-success">
            Are you sure you want to Accept this quotation response?
        </div>

        <div class="mb-3">
            <label asp-for="Comments" class="form-label"></label>
            <textarea asp-for="Comments" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Comments" class="text-danger"></span>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-success">
            <i class="bi bi-x-circle"></i> Accept Response
        </button>
    </div>
</form>
