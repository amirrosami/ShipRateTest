@using ShipRate.Application.DTOs.Notif
@model NotificationAdminListViewModel

@{
    ViewData["Title"] = "Notifications Management";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0">Notifications Management</h4>
            <div class="text-muted small">Manage sent notifications and recipient status.</div>
        </div>

        <button type="button"
                class="btn btn-primary"
                hx-get="@Url.Action("Create", "Notifications")"
                hx-target="#modal-content"
                hx-swap="innerHTML">
            <i class="bi bi-plus-lg"></i>
            Create Notification
        </button>
    </div>

    <form id="notificationFilterForm"
          class="card card-body mb-3"
          hx-get="@Url.Action("Index", "Notifications")"
          hx-target="#notificationAdminList"
          hx-swap="innerHTML">

        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Search</label>
                <input type="text"
                       name="Search"
                       value="@Model.Filter.Search"
                       class="form-control"
                       placeholder="Title or message" />
            </div>

            <div class="col-md-2">
                <label class="form-label">From</label>
                <input type="date"
                       name="FromDate"
                       value="@Model.Filter.FromDate?.ToString("yyyy-MM-dd")"
                       class="form-control" />
            </div>

            <div class="col-md-2">
                <label class="form-label">To</label>
                <input type="date"
                       name="ToDate"
                       value="@Model.Filter.ToDate?.ToString("yyyy-MM-dd")"
                       class="form-control" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Archived</label>
                <select name="IsArchived" class="form-select">
                    <option value="">All</option>
                    <option value="false" selected="@(Model.Filter.IsArchived == false)">Active</option>
                    <option value="true" selected="@(Model.Filter.IsArchived == true)">Archived</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">Unread</label>
                <select name="HasUnread" class="form-select">
                    <option value="">All</option>
                    <option value="true" selected="@(Model.Filter.HasUnread == true)">Has unread</option>
                </select>
            </div>

            <div class="col-md-1">
                <button type="submit" class="btn btn-outline-primary w-100">
                    Filter
                </button>
            </div>
        </div>
    </form>

    <div id="notificationAdminList">
        @await Html.PartialAsync("_AdminList", Model)
    </div>
</div>

<div id="modalHost"></div>


<div class="modal fade"
     id="notificationModal"
     tabindex="-1"
     aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" id="notificationModalContent"></div>
    </div>
</div>

