@using ShipRate.Application.DTOs
@model PagedResultDto<GuaranteePlanDto>
@{
    ViewData["Title"] = "Guarantee Plans Management";
}

<div class="container-fluid py-4" dir="ltr" style="text-align: left;">
    <div class="card-header d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 text-dark">Guarantee Plans</h1>
        <button class="btn btn-primary btn-sm"
                hx-get="@Url.Action("GetModal")"
                hx-target="#modal-container"
                hx-trigger="click"
                data-bs-toggle="modal"
                data-bs-target="#guaranteeModal">
            <i class="bi bi-plus-circle me-1"></i> New Guarantee Plan
        </button>
    </div>

    <!-- Search Form -->
    <div class="card mb-3 border-0 shadow-sm">
        <div class="card-body p-3">
            <form hx-get="@Url.Action("Index")" hx-target="#grid-container" hx-trigger="keyup changed delay:500ms from:#searchInput">
                <div class="row">
                    <div class="col-md-4">
                        <input type="text" id="searchInput" name="SearchTerm" class="form-control form-control-sm" placeholder="Search by Letter No or BL No..." />
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Grid Container -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0" id="grid-container" hx-get="@Url.Action("Index")" hx-trigger="refreshList from:body">
            @await Html.PartialAsync("_PlanList", Model)
        </div>
    </div>
</div>

<!-- Modal Container Placeholder -->
<div class="modal fade" id="guaranteeModal" tabindex="-1" aria-hidden="true" dir="ltr">
    <div class="modal-dialog modal-lg modal-dialog-centered" id="modal-container">
        <!-- Content will be injected here via HTMX -->
    </div>
</div>

<div class="modal fade" id="documentManagerModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content" id="document-manager-content">
        </div>
    </div>
</div>












