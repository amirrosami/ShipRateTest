@using ShipRate.Application.DTOs
@model PagedResultDto<GuaranteePlanDto>

<div class="table-responsive">
    <table class="table table-hover table-striped align-middle mb-0">
        <thead>
            <tr>
                <th>BL Number</th>
                <th>Letter No</th>
                <th>Letter Date</th>
                <th>Company</th>
                <th>Direction</th>
                <th>Shipping Line</th>
                <th>Customer</th>
                <th class="text-end" style="width: 120px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Any())
            {
                foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="fw-bold">@item.BLNo</td>
                        <td>@item.LetterNo</td>
                        <td>@item.LetterDate.ToString("yyyy-MM-dd")</td>
                        <td>@item.CompanyName</td>
                        <td>
                            <span class="badge bg-secondary">@item.InOutName</span>
                        </td>
                        <td>@item.ShippingLineName</td>
                        <td>@item.CustomerName</td>
                        <td class="text-end">
                            <button class="btn btn-outline-primary btn-xs"
                                    hx-get="@Url.Action("GetModal", new { id = item.Id })"
                                    hx-target="#modal-container"
                                    data-bs-toggle="modal"
                                    data-bs-target="#guaranteeModal">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-outline-danger btn-xs"
                                    hx-delete="@Url.Action("Delete", new { id = item.Id })"
                                    hx-confirm="Are you sure you want to delete this plan?"
                                    hx-target="closest tr"
                                    hx-swap="outerHTML">
                                <i class="bi bi-trash"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-success"
                                    hx-get="/DocumentManager/Index?objectId=@item.Id&objectTypeId=16"
                                    hx-target="#document-manager-content"
                                    hx-swap="innerHTML"
                                    data-bs-toggle="modal"
                                    data-bs-target="#documentManagerModal"
                                    title="Attachments">
                                <i class="bi bi-folder2-open"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center py-4 text-muted">No guarantee plans found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Simple Paged UI controls here if needed using Model.PageNumber / TotalCount -->
