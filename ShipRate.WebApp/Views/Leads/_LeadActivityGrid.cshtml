@using ShipRate.Application.DTOs
@model List<LeadActivityDto>

@{
    var leadId = (Guid)ViewBag.LeadId;
}

<div class="d-flex mb-2">
    <button class="btn btn-sm btn-outline-primary ms-auto"
            hx-get="@Url.Action("ActivityCreateForm", "Leads", new { leadId = leadId })"
            hx-target="#activity-modal-body"
            hx-swap="innerHTML"
            data-bs-toggle="modal"
            data-bs-target="#activityModal">
        New Activity
    </button>
</div>

<table class="table table-sm table-bordered table-striped align-middle">
    <thead>
        <tr>
            <th>Date</th>
            <th>Type</th>
            <th>Result</th>
            <th>Outcome</th>
            <th>Description</th>
            <th>Duration</th>
            <th>Follow Up</th>
            <th style="width: 150px;"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.ActivityDate.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@a.ActivityTypeName</td>
                <td>@a.ActivityResultName</td>
                <td>@a.ActivityOutcomeName</td>
                <td>@a.Description</td>
                <td>@a.DurationMinutes</td>
                <td>@(a.FollowUpDate?.ToString("yyyy-MM-dd HH:mm"))</td>
                <td class="text-end">
                    <button class="btn btn-sm btn-outline-primary"
                            hx-get="@Url.Action("ActivityEditForm", "Leads", new { id = a.Id })"
                            hx-target="#activity-modal-body"
                            hx-swap="innerHTML"
                            data-bs-toggle="modal"
                            data-bs-target="#activityModal">
                        Edit
                    </button>

                    <button class="btn btn-sm btn-outline-danger"
                            hx-delete="@Url.Action("ActivityDelete", "Leads", new { id = a.Id })"
                            hx-confirm="Delete this activity?"
                            hx-target="closest tr"
                            hx-swap="outerHTML">
                        Delete
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>
