@using ShipRate.Application.DTOs
@model LeadDto

@{
    var statuses = ViewBag.Statuses as List<SelectListItem>;
    var sources = ViewBag.Sources as List<SelectListItem>;
    var industries = ViewBag.Industries as List<SelectListItem>;
    var currencies = ViewBag.Currencies as List<SelectListItem>;
    var tradeTypes = ViewBag.TradeTypes as List<SelectListItem>;
    var users = ViewBag.Users as List<SelectListItem>;
}

<form hx-post="@Url.Action("Save","Leads")"
      hx-target="#lead-modal-body"
      hx-swap="innerHTML"
      autocomplete="off">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="row g-2">
        <div class="col-6">
            <label class="form-label form-label-sm">Company</label>
            <input asp-for="CompanyName" class="form-control form-control-sm" />
        </div>
        <div class="col-6">
            <label class="form-label form-label-sm">Contact</label>
            <input asp-for="ContactName" class="form-control form-control-sm" />
        </div>

        <div class="col-6">
            <label class="form-label form-label-sm">Email</label>
            <input asp-for="EmailAddress" class="form-control form-control-sm" />
        </div>
        <div class="col-6">
            <label class="form-label form-label-sm">Phone</label>
            <input asp-for="Phone" class="form-control form-control-sm" />
        </div>

        <div class="col-4">
            <label class="form-label form-label-sm">Status</label>
            <select asp-for="LeadStatusId" class="form-select form-select-sm"
                    asp-items="statuses">
                <option value="">-- Select --</option>
            </select>
        </div>

        <div class="col-4">
            <label class="form-label form-label-sm">Source</label>
            <select asp-for="LeadSourceId" class="form-select form-select-sm"
                    asp-items="sources">
                <option value="">-- Select --</option>
            </select>
        </div>

        <div class="col-4">
            <label class="form-label form-label-sm">Assigned To</label>
            <select asp-for="AssignedToUserId" class="form-select form-select-sm"
                    asp-items="users">
                <option value="">-- None --</option>
            </select>
        </div>

        <div class="col-4">
            <label class="form-label form-label-sm">Industry</label>
            <select asp-for="IndustryId" class="form-select form-select-sm"
                    asp-items="industries">
                <option value="">-- Select --</option>
            </select>
        </div>

        <div class="col-4">
            <label class="form-label form-label-sm">Trade Type</label>
            <select asp-for="TradeTypeId" class="form-select form-select-sm"
                    asp-items="tradeTypes">
                <option value="">-- Select --</option>
            </select>
        </div>

        <div class="col-4">
            <label class="form-label form-label-sm">Currency</label>
            <select asp-for="CurrencyId" class="form-select form-select-sm"
                    asp-items="currencies">
                <option value="">-- Select --</option>
            </select>
        </div>

        <div class="col-4">
            <label class="form-label form-label-sm">Estimate Revenue</label>
            <input asp-for="EstimatedRevenue" class="form-control form-control-sm" />
        </div>

        <div class="col-4">
            <label class="form-label form-label-sm">Lead Score</label>
            <input asp-for="LeadScore" class="form-control form-control-sm" />
        </div>

        <div class="col-4">
            <label class="form-label form-label-sm">Cargo Type</label>
            <input asp-for="CargoType" class="form-control form-control-sm" />
        </div>
    </div>

    <div class="mt-3 d-flex justify-content-end">
        <button type="button" class="btn btn-sm btn-secondary me-2" data-bs-dismiss="modal">
            Cancel
        </button>
        <button type="submit" class="btn btn-sm btn-primary">
            Save
        </button>
    </div>
</form>
