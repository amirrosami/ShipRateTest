@using ShipRate.Application.DTOs
@model LeadActivityDto

@{
    var types = ViewBag.ActivityTypes as List<SelectListItem>;
    var results = ViewBag.ActivityResults as List<SelectListItem>;
    var outcomes = ViewBag.ActivityOutcomes as List<SelectListItem>;
}

<form hx-post="@Url.Action("ActivitySave","Leads")"
      hx-target="#activity-modal-body"
      hx-swap="innerHTML">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="LeadId" />

    <div class="row g-2">
        <div class="col-4">
            <label class="form-label form-label-sm">Activity Date</label>
            <input asp-for="ActivityDate" type="datetime-local" class="form-control form-control-sm" />
        </div>

        <div class="col-4">
            <label class="form-label form-label-sm">Type</label>
            <select asp-for="ActivityTypeId" class="form-select form-select-sm"
                    asp-items="types">
                <option value="">-- Select --</option>
            </select>
        </div>

        <div class="col-4">
            <label class="form-label form-label-sm">Result</label>
            <select asp-for="ActivityResultId" class="form-select form-select-sm"
                    asp-items="results">
                <option value="">-- Select --</option>
            </select>
        </div>

        <div class="col-4">
            <label class="form-label form-label-sm">Outcome</label>
            <select asp-for="ActivityOutcomeId" class="form-select form-select-sm"
                    asp-items="outcomes">
                <option value="">-- Select --</option>
            </select>
        </div>

        <div class="col-4">
            <label class="form-label form-label-sm">Duration (min)</label>
            <input asp-for="DurationMinutes" class="form-control form-control-sm" />
        </div>

        <div class="col-4">
            <label class="form-label form-label-sm">Follow Up</label>
            <input asp-for="FollowUpDate" type="datetime-local" class="form-control form-control-sm" />
        </div>

        <div class="col-12">
            <label class="form-label form-label-sm">Description</label>
            <textarea asp-for="Description" rows="3"
                      class="form-control form-control-sm"></textarea>
        </div>
    </div>

    <div class="mt-3 d-flex justify-content-end">
        <button type="button" class="btn btn-sm btn-secondary me-2" data-bs-dismiss="modal">
            Cancel
        </button>
        <button type="submit" class="btn btn-sm btn-primary">
            Save
        </button>
    </div>
</form>
