@using ShipRate.Application.ViewModels
@model FinalVoyageVm
@if (Model == null)
{
    <div class="alert alert-secondary d-flex align-items-center mb-0 py-2" role="alert">
        <i class="bi bi-info-circle-fill me-2 fs-5 text-secondary"></i>
        <div>Final voyage information not found.</div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(Model.Message) && !Model.BLVoyageId.HasValue)
{
    @* Error state: no final voyage registered *@
    <div class="alert alert-warning border-start border-warning border-4 shadow-sm mb-0 p-3" role="alert">
        <div class="d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill text-warning fs-4 me-2"></i>
            <div>
                <h6 class="alert-heading mb-1 fw-bold">Final Voyage Status:</h6>
                <p class="mb-0 text-dark small">@Model.Message</p>
            </div>
        </div>
    </div>
}
else
{
    @* Success / registered final voyage state *@
    <div class="card border-0 shadow-sm final-voyage-card">
        <div class="card-header bg-light bg-opacity-75 border-bottom py-2 d-flex justify-content-between align-items-center">
            <span class="fw-bold text-primary small">
                <i class="bi bi-ship me-1"></i> Final Voyage Information
            </span>
            <div class="d-flex gap-2 align-items-center">
                @if (!string.IsNullOrEmpty(Model.VesselName))
                {
                    <span class="badge bg-secondary-subtle text-secondary border">
                        <i class="bi bi-water me-1"></i> @Model.VesselName
                    </span>
                }
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                    Voyage: <strong class="ms-1">@(Model.VoyageNo ?? "-")</strong>
                </span>
            </div>
        </div>

        <div class="card-body p-3">
            @if (!string.IsNullOrWhiteSpace(Model.Message))
            {
                <div class="alert alert-info py-1 px-2 small mb-3 d-flex align-items-center">
                    <i class="bi bi-info-circle me-2"></i>
                    <span>@Model.Message</span>
                </div>
            }

            @* Final Port Notice *@
            @if (!string.IsNullOrWhiteSpace(Model.PortName))
            {
                <div class="d-flex align-items-center gap-2 border rounded-2 p-2 mb-3 bg-primary-subtle bg-opacity-25">
                    <i class="bi bi-geo-alt-fill text-primary"></i>
                    <span class="small fw-bold text-dark">@Model.PortName</span>
                </div>
            }

            @* Milestone Tracker / Status Timeline *@
            <div class="row g-2 text-center final-voyage-timeline">

                @* 1. Arrival *@
                <div class="col-6 col-md-3">
                    <div class="p-2 border rounded-2 h-100 @(Model.ArrivalDate.HasValue ? "border-success bg-success-subtle bg-opacity-10" : "bg-light text-muted")">
                        <div class="d-flex align-items-center justify-content-center gap-1 mb-1">
                            <i class="bi @(Model.ArrivalDate.HasValue ? "bi-check-circle-fill text-success" : "bi-clock text-muted") small"></i>
                            <span class="small fw-bold @(Model.ArrivalDate.HasValue ? "text-dark" : "text-muted")">Arrival (ATA)</span>
                        </div>
                        <div class="fw-semibold font-monospace small">
                            @(Model.ArrivalDate.HasValue? Model.ArrivalDate.Value.ToString("yyyy-MM-dd HH:mm") : "—")
                        </div>
                    </div>
                </div>

                @* 2. Berth *@
                <div class="col-6 col-md-3">
                    <div class="p-2 border rounded-2 h-100 @(Model.BerthDate.HasValue ? "border-primary bg-primary-subtle bg-opacity-10" : "bg-light text-muted")">
                        <div class="d-flex align-items-center justify-content-center gap-1 mb-1">
                            <i class="bi @(Model.BerthDate.HasValue ? "bi-anchor text-primary" : "bi-clock text-muted") small"></i>
                            <span class="small fw-bold @(Model.BerthDate.HasValue ? "text-dark" : "text-muted")">Berth</span>
                        </div>
                        <div class="fw-semibold font-monospace small">
                            @(Model.BerthDate.HasValue? Model.BerthDate.Value.ToString("yyyy-MM-dd HH:mm") : "—")
                        </div>
                    </div>
                </div>

                @* 3. Discharge Start *@
                <div class="col-6 col-md-3">
                    <div class="p-2 border rounded-2 h-100 @(Model.DischargeStartDate.HasValue ? "border-info bg-info-subtle bg-opacity-10" : "bg-light text-muted")">
                        <div class="d-flex align-items-center justify-content-center gap-1 mb-1">
                            <i class="bi @(Model.DischargeStartDate.HasValue ? "bi-box-arrow-up text-info" : "bi-clock text-muted") small"></i>
                            <span class="small fw-bold @(Model.DischargeStartDate.HasValue ? "text-dark" : "text-muted")">Discharge Start</span>
                        </div>
                        <div class="fw-semibold font-monospace small">
                            @(Model.DischargeStartDate.HasValue? Model.DischargeStartDate.Value.ToString("yyyy-MM-dd HH:mm") : "—")
                        </div>
                    </div>
                </div>

                @* 4. Discharge Complete *@
                <div class="col-6 col-md-3">
                    <div class="p-2 border rounded-2 h-100 @(Model.DischargeCompleteDate.HasValue ? "border-success bg-success-subtle bg-opacity-10" : "bg-light text-muted")">
                        <div class="d-flex align-items-center justify-content-center gap-1 mb-1">
                            <i class="bi @(Model.DischargeCompleteDate.HasValue ? "bi-check2-all text-success" : "bi-clock text-muted") small"></i>
                            <span class="small fw-bold @(Model.DischargeCompleteDate.HasValue ? "text-dark" : "text-muted")">Discharge Complete</span>
                        </div>
                        <div class="fw-semibold font-monospace small">
                            @(Model.DischargeCompleteDate.HasValue? Model.DischargeCompleteDate.Value.ToString("yyyy-MM-dd HH:mm") : "—")
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
}
