@model dynamic
<div class="modal-header border-0 pb-0">
    <h5 class="modal-title fw-bold text-dark">Confirm Deletion</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<form hx-post="/BLManagement/ConfirmDeletePost/@ViewBag.BLId"
      hx-target="#bl-grid-container"
      hx-swap="innerHTML"
      class="mb-0">
    @Html.AntiForgeryToken()
    <div class="modal-body py-4">
        <p class="text-secondary mb-0">Are you sure you want to delete this Bill of Lading? This action will flag the document as deleted and is irreversible.</p>
    </div>
    <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
    </div>
</form>
