@using ShipRate.Application.ViewModels
@model DeliveryOrderListWrapperVm

<div class="card border shadow-sm mt-1" id="do-grid">
    <!-- Header Card -->
    <div class="bg-light py-2 px-3 d-flex justify-content-between align-items-center border-bottom">
        <span class="fw-bold small text-dark text-uppercase">
            <i class="bi bi-truck me-1 text-primary"></i>
            Delivery Orders
        </span>
@*         <div class="d-flex align-items-center gap-2">
            <span class="badge bg-secondary-subtle text-dark border">
                @(Model.Items?.Count() ?? 0)
            </span>
            <a class="btn btn-sm btn-outline-primary py-1 px-2"
               href="@Url.Action("Create", "DeliveryOrders")">
                <i class="bi bi-plus-lg"></i> Add
            </a>
        </div> *@
    </div>

    <!-- کانتینر اسکرول افقی استاندارد -->
    <div class="table-responsive w-100" style="overflow-x: auto;">
        <table class="table table-sm table-bordered table-hover align-middle mb-0 text-nowrap small text-start border-secondary-subtle" style="min-width: 1100px;">
            <thead class="table-light text-uppercase font-monospace align-middle border-bottom border-secondary-subtle">
                <tr>
                    <th style="width: 40px;" class="text-center">#</th>
                    <th style="min-width: 70px;">DO No</th>
                    <th style="min-width: 100px;">DO Date</th>
                    <th style="min-width: 100px;">DO Mode</th>
                    <th style="min-width: 110px;">Expiry Date</th>
                    <th style="width: 90px;" class="text-center">Status</th>
                    <th style="width: 90px;" class="text-center">CreatedAt</th>
                    <th style="width: 90px;" class="text-center">UpdatedAt</th>

                    <th class="text-center" style="min-width: 220px; width: 220px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items != null && Model.Items.Any())
                {
                    int rowNo = (Model.Filter.Page - 1) * Model.Filter.PageSize + 1;
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="text-center text-muted fw-semibold">@(rowNo++)</td>
                            <td class="fw-semibold text-primary font-monospace">
                                @(string.IsNullOrWhiteSpace(item.DONo) ? "Draft" : item.DONo)
                            </td>
                            <td>@(item.DoDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td>
                                <span title="@item.DOOperationModeLocalName">@item.DOOperationModeName</span>
                            </td>
@*                             <td>@item.CarrierName</td>
                            <td class="text-truncate" style="max-width: 180px;" title="@item.ConsigneeName">
                                @(item.ConsigneeName ?? "-")
                            </td>
 *@                            <td>
                                @if (item.ExpiryDate.HasValue && item.ExpiryDate.Value < DateTime.Today)
                                {
                                    <span class="text-danger fw-semibold" title="Expired">
                                        @item.ExpiryDate.Value.ToString("yyyy/MM/dd")
                                        <i class="bi bi-exclamation-circle-fill"></i>
                                    </span>
                                }
                                else
                                {
                                    @(item.ExpiryDate?.ToString("yyyy/MM/dd") ?? "-")
                                }
                            </td>
@*                             <td class="text-center">
                                <span class="badge bg-secondary-subtle text-dark border">@item.ContainerCount</span>
                            </td>
 *@                            <td class="text-center">
                                @{
                                    var statusBadgeClass = item.StatusId switch
                                    {
                                        10 => "bg-warning-subtle text-warning-emphasis border border-warning",
                                        30 => "bg-success-subtle text-success-emphasis border border-success",
                                        50 => "bg-success-subtle text-success-emphasis border border-success",
                                        99 => "bg-danger-subtle text-danger-emphasis border border-danger",
                                        _ => "bg-secondary-subtle text-secondary-emphasis border border-secondary"
                                    };
                                }
                                <span class="badge @statusBadgeClass px-2 py-1">
                                    @item.StatusName
                                </span>
                            </td>
                            <td class="text-center">
                                <span title="@item.CreatedAT?.ToString("yyyy-MM-dd HH:mm")/ @item.CreateUserName">
                                    @item.CreatedAT?.ToString("yyyy-MM-dd")
                                </span>
                            </td>
                            <td class="text-center">
                                <span title="@item.UpdateAT?.ToString("yyyy-MM-dd HH:mm")/ @item.UpdateUserName">
                                    @item.UpdateAT?.ToString("yyyy-MM-dd")
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <!-- Print -->
@*                                     <a class="btn btn-outline-secondary py-1 px-2"
                                       target="_blank"
                                       href="@Url.Action("Print", "DeliveryOrders", new { id = item.DeliveryOrderId })"
                                       title="Print">
                                        <i class="bi bi-printer"></i>
                                    </a>
                                    
 *@                                 
                                    @if (item.DOOperationModeId != 2)
                                    {
                                        <a class="btn btn-outline-secondary py-1 px-2"
                                        target="_blank"
                                        href="@Url.Action("PrintPDF", "DeliveryOrders", new { id = item.DeliveryOrderId })"
                                        title="Print PDF">
                                            <i class="bi bi-printer"></i>
                                        </a>
                                        @if (item.StatusId == 10)
                                        {
                                            <button type="button"
                                            class="btn btn-sm btn-outline-success"
                                            title="Approve"
                                            hx-post="@Url.Action("Approve", "DeliveryOrders", new { id = item.DeliveryOrderId })"
                                            hx-confirm="Are you sure you want to approve this Delivery Order?"
                                            hx-target="closest tr"
                                            hx-swap="outerHTML">
                                                <i class="bi bi-check2-circle"></i>
                                            </button>
                                        }
                                    }

                                    @if (item.DOOperationModeId != 2)
                                    {
                                        @if (item.StatusId == 30)
                                        {
                                            <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            title="ثبت تحویل"
                                            hx-post="@Url.Action("Collect", "DeliveryOrders", new { id = item.DeliveryOrderId })"
                                            hx-confirm="Are you sure you want to register Collect of this Delivery Order?"
                                            hx-target="closest tr"
                                            hx-swap="outerHTML">
                                                <i class="bi bi-person-check"></i>
                                            </button>
                                        }
                                    }






                                    <!-- Details / View -->
@*                                     <a class="btn btn-outline-secondary py-1 px-2"
                                       href="@Url.Action("Details", "DeliveryOrders", new { id = item.DeliveryOrderId })"
                                       title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
 *@
                                    <!-- Edit -->
@*                                     <a class="btn btn-outline-primary py-1 px-2"
                                       href="@Url.Action("Edit", "DeliveryOrders", new { id = item.DeliveryOrderId })"
                                       title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a> *@

                                    @if (item.StatusId == 10)
                                    {
                                        <button type="button"
                                            class="btn btn-outline-primary btn-sm"
                                            hx-get="@Url.Action("Edit", "DeliveryOrders", new { id=item.DeliveryOrderId })"
                                            hx-target="#noaModalBody"
                                            hx-swap="innerHTML"
                                            title="Edit"
                                            onclick="showNoaModal()">
                                            <i class="bi bi-pencil me-1"></i> 
                                        </button>
                                    <!-- Delete -->
                                    <button type="button"
                                            class="btn btn-outline-danger py-1 px-2"
                                            title="Delete"
                                            hx-delete="@Url.Action("Delete", "DeliveryOrders", new { id = item.DeliveryOrderId })"
                                            hx-confirm="Are you sure you want to delete this draft DO?"
                                            hx-swap="none">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                    }
@*                                     <!-- Detentions -->
                                    <button type="button"
                                            class="btn btn-outline-info py-1 px-2"
                                            title="Detentions"
                                            hx-get="@Url.Action("GetDetentionsGrid", "DeliveryOrders", new { id = item.BLId })"
                                            hx-target="#detentionGridContainer"
                                            hx-swap="innerHTML">
                                        <i class="bi bi-clock-history"></i>
                                    </button>
 *@
                                    <!-- Cancel Modal -->
@*                                     <button type="button"
                                            class="btn btn-outline-warning py-1 px-2"
                                            title="Cancel DO"
                                            hx-get="@Url.Action("GetCancelModal", "DeliveryOrders", new { id = item.DeliveryOrderId })"
                                            hx-target="#cancelModalBody"
                                            data-bs-toggle="modal"
                                            data-bs-target="#cancelDOModal">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
 *@

                                      @if (item.ClearanceTypeId==1)
                                      {
                                        <a class="btn btn-outline-success py-1 px-2"
                                        target="_blank"
                                        href="@Url.Action("PrintTipLetter", "TIP", new { blId = item.BLId})"
                                        title="Print Tip Letter">
                                            <i class="bi bi-printer"></i>
                                        </a>
                                      }
                                        <button class="btn btn-sm btn-outline-primary"
                                                hx-get="@Url.Action("FreightLetterModal", "DeliveryOrders", new { doId = item.DeliveryOrderId })"
                                                hx-target="#freightLetterModalHost"
                                                hx-swap="innerHTML"
                                                title="Freight Letter">
                                                <i class="bi bi-envelope"></i>
                                        </button>



                                    <!-- Attachments -->
                                    <button type="button" 
                                            class="btn btn-outline-secondary py-1 px-2"
                                            title="Attachments"
                                            hx-get="/DocumentManager/Index?objectId=@item.DeliveryOrderId&objectTypeId=15"
                                            hx-target="#document-manager-content"
                                            hx-swap="innerHTML"
                                            data-bs-toggle="modal"
                                            data-bs-target="#documentManagerModal">
                                        <i class="bi bi-folder2-open"></i>
                                    </button>





                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted align-middle" style="height: 120px;">
                            <i class="bi bi-exclamation-circle d-block mb-1 fs-5"></i>
                            No delivery orders found matching the criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-light border-top py-2">
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm justify-content-center mb-0">
                    <li class="page-item @(Model.Filter.Page == 1 ? "disabled" : "")">
                        <button class="page-link"
                                hx-get="@Url.Action("Index", "DeliveryOrders", new {
                                            SearchTerm = Model.Filter.SearchTerm,
                                            IsFinalized = Model.Filter.IsFinalized,
                                            FromDate = Model.Filter.FromDate?.ToString("yyyy-MM-dd"),
                                            ToDate = Model.Filter.ToDate?.ToString("yyyy-MM-dd"),
                                            Page = Model.Filter.Page - 1,
                                            PageSize = Model.Filter.PageSize
                                        })"
                                hx-target="#gridContainer"
                                hx-swap="innerHTML">
                            Previous
                        </button>
                    </li>

                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(Model.Filter.Page == p ? "active" : "")">
                            <button class="page-link"
                                    hx-get="@Url.Action("Index", "DeliveryOrders", new {
                                                SearchTerm = Model.Filter.SearchTerm,
                                                IsFinalized = Model.Filter.IsFinalized,
                                                FromDate = Model.Filter.FromDate?.ToString("yyyy-MM-dd"),
                                                ToDate = Model.Filter.ToDate?.ToString("yyyy-MM-dd"),
                                                Page = p,
                                                PageSize = Model.Filter.PageSize
                                            })"
                                    hx-target="#gridContainer"
                                    hx-swap="innerHTML">
                                @p
                            </button>
                        </li>
                    }

                    <li class="page-item @(Model.Filter.Page == Model.TotalPages ? "disabled" : "")">
                        <button class="page-link"
                                hx-get="@Url.Action("Index", "DeliveryOrders", new {
                                            SearchTerm = Model.Filter.SearchTerm,
                                            IsFinalized = Model.Filter.IsFinalized,
                                            FromDate = Model.Filter.FromDate?.ToString("yyyy-MM-dd"),
                                            ToDate = Model.Filter.ToDate?.ToString("yyyy-MM-dd"),
                                            Page = Model.Filter.Page + 1,
                                            PageSize = Model.Filter.PageSize
                                        })"
                                hx-target="#gridContainer"
                                hx-swap="innerHTML">
                            Next
                        </button>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
