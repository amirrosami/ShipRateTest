@using ShipRate.Application.ViewModels
@model PaymentDocumentDetailsVm

<div class="modal-header" dir="ltr">
    <h5 class="modal-title">Delete Payment Document</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body" dir="ltr">
    <div class="alert alert-warning mb-3">
        Are you sure you want to delete this payment document?
    </div>

    <dl class="row mb-0">
        <dt class="col-sm-4">Document Number</dt>
        <dd class="col-sm-8">@Model.DocumentNumber</dd>

        <dt class="col-sm-4">Document Date</dt>
        <dd class="col-sm-8">@Model.DocumentDateShamsi</dd>

        <dt class="col-sm-4">Person</dt>
        <dd class="col-sm-8">@Model.PersonName</dd>

        <dt class="col-sm-4">Amount</dt>
        <dd class="col-sm-8">@Model.Amount.ToString("N0")</dd>
    </dl>
</div>

<div class="modal-footer" dir="ltr">
    <form hx-post="@Url.Action("DeleteConfirmed", "PaymentDocuments", new { id = Model.Id })"
          hx-target="#globalModalContent"
          hx-swap="innerHTML">
        @Html.AntiForgeryToken()

        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Delete</button>
    </form>
</div>
