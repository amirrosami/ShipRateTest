@using ShipRate.Application.ViewModels
@model PaymentDocumentCreateEditVm
@{
    var isEdit = Model.Id != Guid.Empty;
    var actionName = isEdit ? "Edit" : "Create";
    var modalTitle = isEdit ? "Edit Payment Document" : "New Payment Document";
    var chequeSectionStyle = Model.PaymentMethodId == 3 ? "" : "display:none;";
}

<style>
    .excel-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0;
        border: 1px solid #d1d9e0;
    }

    .excel-field {
        display: flex;
        border: 0.5px solid #d1d9e0;
        background-color: #fff;
        align-items: stretch;
    }

        .excel-field label {
            background-color: #eef6ff;
            color: #4a5568;
            padding: 6px 10px;
            font-size: 14px;
            font-weight: 600;
            min-width: 140px;
            border-right: 1px solid #d1d9e0;
            display: flex;
            align-items: center;
            white-space: nowrap;
            margin: 0;
        }

        .excel-field input,
        .excel-field select,
        .excel-field textarea {
            flex: 1;
            border: none;
            background-color: #ffffff;
            padding: 5px 8px;
            font-size: 14px;
            outline: none;
            width: 100%;
        }

            .excel-field input:focus,
            .excel-field select:focus,
            .excel-field textarea:focus {
                background-color: #fff9c4 !important;
            }

    .span-3 {
        grid-column: span 3;
    }

    .modal-body {
        padding: 1rem;
    }

    .excel-iban-wrapper {
        display: inline-flex;
        align-items: center;
        direction: ltr;
        height: 100%;
        width: 100%;
        background-color: #fff;
        padding: 0 4px;
        font-family: Consolas, "Courier New", monospace;
        font-size: 0.85rem;
    }

    .iban-prefix {
        font-weight: 700;
        color: #475569;
        padding-right: 4px;
        user-select: none;
    }

    .iban-cell {
        border: 1px solid transparent;
        outline: none;
        background: transparent;
        text-align: center;
        font-size: 0.85rem;
        font-family: inherit;
        color: #0f172a;
        padding: 2px 0;
        height: 28px;
        border-radius: 2px;
    }

        .iban-cell:focus {
            background-color: #f0f7ff;
            border-color: #0b3c73;
        }

        .iban-cell.w-2 {
            width: 24px;
        }

        .iban-cell.w-4 {
            width: 38px;
        }

    .iban-sep {
        color: #94a3b8;
        user-select: none;
        padding: 0 1px;
    }
</style>

<form id="paymentDocumentForm"
      method="post"
      action="@Url.Action(actionName, "PaymentDocuments")"
      hx-post="@Url.Action(actionName, "PaymentDocuments")"
      hx-target="#paymentDocumentModalContent"
      hx-swap="innerHTML"
      novalidate>

    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="modal-header" dir="ltr">
        <h5 class="modal-title">@modalTitle</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body" dir="ltr" id="modalBodyScroll">

        @if (!ViewData.ModelState.IsValid)
        {
            <div id="validationSummaryAlert" class="alert alert-danger py-2 px-3 mb-3 small" role="alert">
                <div class="d-flex align-items-center mb-1 fw-bold text-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <span>Please fix these errors:</span>
                </div>
                <ul class="mb-0 ps-3">
                    @foreach (var modelState in ViewData.ModelState.Values)
                    {
                        @foreach (var error in modelState.Errors)
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    }
                </ul>
            </div>
            <script>
                // اسکرول فوری به بالای مودال برای نمایش کادر قرمز
                setTimeout(function() {
                    var mb = document.getElementById('modalBodyScroll');
                    if (mb) mb.scrollTop = 0;
                }, 50);
            </script>
        }
        <div class="excel-grid">
            <!-- ردیف اول -->
            <div class="excel-field">
                <label asp-for="CompanyId">Company</label>
                <select asp-for="CompanyId" asp-items="Model.Companies"><option value="">Select...</option></select>
            </div>
            <div class="excel-field">
                <label asp-for="BranchId">Branch</label>
                <select asp-for="BranchId" asp-items="Model.Branches"><option value="">Select...</option></select>
            </div>
            <div class="excel-field">
                <label asp-for="DocumentNumber">Doc No</label>
                <input asp-for="DocumentNumber" />
            </div>

            <!-- ردیف دوم -->
            <div class="excel-field">
                <label asp-for="DocumentDateShamsi">Date</label>
                <input asp-for="DocumentDateShamsi" placeholder="yyyy/MM/dd" />
            </div>
            <div class="excel-field">
                <label asp-for="FinanceDirectionId">Direction</label>
                <select asp-for="FinanceDirectionId" asp-items="Model.FinanceDirections"><option value="">Select...</option></select>
            </div>
            <div class="excel-field">
                <label asp-for="Amount">Amount</label>
                <input asp-for="Amount" class="money-input" asp-format="{0:#,##0.##}" autocomplete="off" />
            </div>

            <!-- ردیف سوم -->
            <div class="excel-field">
                <label asp-for="CurrencyId">Currency</label>
                <select asp-for="CurrencyId" asp-items="Model.Currencies"><option value="">Select...</option></select>
            </div>
            <div class="excel-field">
                <label asp-for="PaymentMethodId">Method</label>
                <select asp-for="PaymentMethodId" asp-items="Model.PaymentMethods" id="paymentMethodSelect"><option value="">Select...</option></select>
            </div>
            <div class="excel-field">
                <label asp-for="TrackingNumber">Tracking</label>
                <input asp-for="TrackingNumber" />
            </div>

            <!-- فیلدهای عریض -->
            <div class="excel-field span-3">
                <label asp-for="PersonId">Party</label>
                <select id="PersonSelect2" name="PersonId" class="form-select form-select-sm">
                    @if (Model.PersonId != Guid.Empty)
                    {
                        <option value="@Model.PersonId" selected>@Model.PersonName</option>
                    }
                </select>
            </div>
            <div class="excel-field span-3">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description" rows="1"></textarea>
            </div>
        </div>

        <hr class="my-3" />

        <!-- بخش چک -->
        <div id="cheque-section" style="@chequeSectionStyle">
            <h6 class="mb-2">Cheque Information</h6>
            <div class="excel-grid">
                <div class="excel-field">
                    <label asp-for="Cheque.ChequeNumber">Cheque No</label>
                    <input asp-for="Cheque.ChequeNumber" />
                </div>
                <div class="excel-field">
                    <label asp-for="Cheque.ChequeDateShamsi">Date</label>
                    <input asp-for="Cheque.ChequeDateShamsi" placeholder="yyyy/MM/dd" />
                </div>
                <div class="excel-field">
                    <label asp-for="Cheque.ChequeTypeId">Type</label>
                    <select asp-for="Cheque.ChequeTypeId" asp-items="Model.ChequeTypes"><option value="">Select...</option></select>
                </div>
                <div class="excel-field">
                    <label asp-for="Cheque.ChequePurposeId">Purpose</label>
                    <select asp-for="Cheque.ChequePurposeId" asp-items="Model.ChequePurposes"><option value="">Select...</option></select>
                </div>
                <div class="excel-field">
                    <label asp-for="Cheque.BankId">Bank</label>
                    <select asp-for="Cheque.BankId" asp-items="Model.Banks" id="bankSelect"
                            hx-get="@Url.Action("BankAccounts", "PaymentDocuments")" hx-trigger="change"
                            hx-target="#bankAccountContainer" hx-include="#bankSelect" hx-swap="innerHTML">
                        <option value="">Select...</option>
                    </select>
                </div>
                <div class="excel-field">
                    <label asp-for="Cheque.BankAccountNo">Account No</label>
                    <input asp-for="Cheque.BankAccountNo" />
                </div>
                <div class="excel-field">
                    <label asp-for="Cheque.AccountHolderName">Holder Name</label>
                    <input asp-for="Cheque.AccountHolderName" />
                </div>
                <div class="excel-field">
                    <label asp-for="Cheque.SayadNo" title="شماره صیادی">Sayad No</label>
                    <input asp-for="Cheque.SayadNo" />
                </div>

                <div class="excel-field span-3">
                    <label asp-for="Cheque.IBAN" title="شماره شبا">IBAN</label>
                    <div class="excel-iban-wrapper">
                        <span class="iban-prefix">IR</span>
                        <input type="text" class="iban-cell w-2" maxlength="2" inputmode="numeric" placeholder="--" />
                        <span class="iban-sep">-</span>
                        <input type="text" class="iban-cell w-4" maxlength="4" inputmode="numeric" placeholder="----" />
                        <span class="iban-sep">-</span>
                        <input type="text" class="iban-cell w-4" maxlength="4" inputmode="numeric" placeholder="----" />
                        <span class="iban-sep">-</span>
                        <input type="text" class="iban-cell w-4" maxlength="4" inputmode="numeric" placeholder="----" />
                        <span class="iban-sep">-</span>
                        <input type="text" class="iban-cell w-4" maxlength="4" inputmode="numeric" placeholder="----" />
                        <span class="iban-sep">-</span>
                        <input type="text" class="iban-cell w-4" maxlength="4" inputmode="numeric" placeholder="----" />
                        <span class="iban-sep">-</span>
                        <input type="text" class="iban-cell w-2" maxlength="2" inputmode="numeric" placeholder="--" />
                    </div>
                    <input type="hidden" asp-for="Cheque.IBAN" id="chequeIbanHidden" />
                </div>

                <div class="excel-field span-3" style="padding: 5px;">
                    <button type="button" class="btn btn-outline-danger btn-sm w-100"
                            hx-get="@Url.Action("ChequeInfo", "ApiIr")"
                            hx-target="#apiIrModalBody" hx-swap="innerHTML" onclick="openApiIrModal()">
                        <i class="bi bi-bank me-1"></i> استعلام چک
                    </button>
                </div>            
                </div>
        </div>
    </div>

    <div class="modal-footer" dir="ltr">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary btn-sm">@(isEdit ? "Save" : "Create")</button>
    </div>
</form>

<div class="modal fade" id="apiIrModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" id="apiIrModalBody"></div>
    </div>
</div>

<script>
    (function () {
        const paymentMethodSelect = document.getElementById('paymentMethodSelect');
        const chequeSection = document.getElementById('cheque-section');
        function toggleChequeSection() {
            if (!paymentMethodSelect || !chequeSection) return;
            chequeSection.style.display = (paymentMethodSelect.value === '3') ? '' : 'none';
        }
        if (paymentMethodSelect) {
            paymentMethodSelect.addEventListener('change', toggleChequeSection);
            toggleChequeSection();
        }
    })();

    function openApiIrModal() {
        const modalEl = document.getElementById('apiIrModal');
        if (modalEl) {
            if (modalEl.parentElement !== document.body) document.body.appendChild(modalEl);
            bootstrap.Modal.getOrCreateInstance(modalEl).show();
        }
    }
</script>

<script>
    $(document).ready(function () {
        function initDynamicSelect2(options) {
            var $select = $(options.selectId);
            var $parentModal = $select.closest('.modal');

            $select.select2({
                theme: 'bootstrap-5',
                placeholder: options.placeholder || 'Select...',
                allowClear: true,
                minimumInputLength: options.minInput || 1,
                width: '100%',
                dropdownParent: $parentModal.length ? $parentModal : $(document.body),
                ajax: {
                    url: options.url,
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return { q: params.term };
                    },
                    processResults: function (data) {
                        return {
                            results: data.results || $.map(data, function (item) {
                                return { id: item.id, text: item.text };
                            })
                        };
                    }
                }
            });
        }

        initDynamicSelect2({
            selectId: '#PersonSelect2',
            placeholder: 'Search Party...',
            url: '/Persons/GetPersonsJson'
        });
    });
</script>

<script>
    (function () {
        function initIbanLogic() {
            const form = document.getElementById('paymentDocumentForm');
            const wrapper = document.querySelector('.excel-iban-wrapper');
            const hiddenInput = document.getElementById('chequeIbanHidden');
            if (!wrapper || !hiddenInput) return;

            if (wrapper.dataset.ibanInitialized === "true") return;
            wrapper.dataset.ibanInitialized = "true";

            const cells = Array.from(wrapper.querySelectorAll('.iban-cell'));
            const lengths = [2, 4, 4, 4, 4, 4, 2];

            function syncValue() {
                let digits = '';
                cells.forEach(c => digits += (c.value || '').trim());
                hiddenInput.value = digits.length > 0 ? ('IR' + digits) : '';
            }

            function fillCells(str) {
                if (!str) return;
                const digits = str.replace(/[^0-9]/g, '');
                let cursor = 0;
                cells.forEach((cell, idx) => {
                    const len = lengths[idx];
                    cell.value = digits.substring(cursor, cursor + len);
                    cursor += len;
                });
                syncValue();
            }

            if (hiddenInput.value) {
                fillCells(hiddenInput.value);
            }

            cells.forEach((cell, index) => {
                cell.addEventListener('input', function () {
                    this.value = this.value.replace(/[^0-9]/g, '');
                    if (this.value.length >= this.maxLength) {
                        this.value = this.value.substring(0, this.maxLength);
                        if (index < cells.length - 1) {
                            cells[index + 1].focus();
                            cells[index + 1].select();
                        }
                    }
                    syncValue();
                });

                cell.addEventListener('keydown', function (e) {
                    if (e.key === 'Backspace' && this.value.length === 0 && index > 0) {
                        cells[index - 1].focus();
                    }
                });

                cell.addEventListener('paste', function (e) {
                    e.preventDefault();
                    const pasteData = (e.clipboardData || window.clipboardData).getData('text');
                    fillCells(pasteData);
                    cells[cells.length - 1].focus();
                });
            });

            // حذف کامای مبالغ قبل از ارسال
            function cleanMoneyInputs() {
                if (form) {
                    form.querySelectorAll('.money-input').forEach(inp => {
                        inp.value = (inp.value || '').replace(/,/g, '').trim();
                    });
                }
            }

            if (form) {
                form.addEventListener('submit', function () {
                    syncValue();
                    cleanMoneyInputs();
                });
                form.addEventListener('htmx:configRequest', function () {
                    syncValue();
                    cleanMoneyInputs();
                });
            }
        }

        initIbanLogic();
        document.body.addEventListener('htmx:afterSettle', initIbanLogic);
        document.addEventListener('shown.bs.modal', initIbanLogic);
    })();
</script>
