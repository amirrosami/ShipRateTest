@using ShipRate.Application.ViewModels
@model PaymentDocumentUsagePanelVm

<div class="card border-primary shadow-sm mt-3" dir="ltr">
    <div class="card-header bg-primary bg-opacity-10
                d-flex justify-content-between align-items-center py-2">
        <div>
            <i class="bi bi-diagram-3 me-1 text-primary"></i>

            <strong>Payment Usage(s)</strong>

            <span class="mx-2 text-muted">|</span>

            <span class="text-muted">Payment Document:</span>

            <strong class="text-primary">
                @Model.PaymentDocumentNumber
            </strong>
        </div>

        <button type="button"
                class="btn btn-sm btn-outline-secondary"
                title="Close"
                aria-label="Close payment usage panel"
                hx-on:click="document.getElementById('payment-document-usage-panel').replaceChildren()">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <div class="card-body p-0">

        <!-- Payment summary -->
        <div class="d-flex flex-wrap gap-4 px-3 py-2 border-bottom bg-light small">
            <div>
                <span class="text-muted">Payment Amount:</span>
                <strong>
                    @Model.Amount.ToString("N2")
                </strong>
            </div>

            <div>
                <span class="text-muted">Allocated:</span>
                <strong class="text-success">
                    @Model.AllocatedAmount.ToString("N2")
                </strong>
            </div>

            <div>
                <span class="text-muted">Remaining:</span>
                <strong class="text-danger">
                    @Model.RemainingAmount.ToString("N2")
                </strong>
            </div>

            <div>
                <span class="text-muted">Currency:</span>
                <strong>
                    @Model.CurrencyTitle
                </strong>
            </div>
        </div>

        <!-- Usage list -->
        <div class="table-responsive">
            <table class="table table-bordered table-hover table-sm mb-0 compact-table">
                <thead class="table-light">
                    <tr>
                        <th style="width: 55px;">#</th>
                        <th>Usage Type</th>
                        <th>Reference No.</th>
                        <th>Date</th>
                        <th>Party</th>
                        <th class="text-end">Allocated Amount</th>
                        <th>Currency</th>
                        <th>Description</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.RowNumber</td>

                                <td>
                                    <span class="badge bg-info text-dark">
                                        @item.UsageType
                                    </span>
                                </td>

                                <td>@item.ReferenceNumber</td>
                                <td>@item.ReferenceDate</td>
                                <td>@item.PartyName</td>

                                <td class="text-end">
                                    @item.AllocatedAmount.ToString("N2")
                                </td>

                                <td>@item.CurrencyTitle</td>
                                <td>@item.Description</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8"
                                class="text-center text-muted py-4">
                                This payment document has not been used yet.
                            </td>
                        </tr>
                    }
                </tbody>

                @if (Model.Items != null && Model.Items.Any())
                {
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="5" class="text-end">
                                Total:
                            </th>

                            <th class="text-end">
                                @Model.AllocatedAmount.ToString("N2")
                            </th>

                            <th>@Model.CurrencyTitle</th>
                            <th></th>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>
