@using ShipRate.Application.ViewModels
@model PaymentDocumentDetailsVm

<div class="modal-header" dir="ltr">
    <h5 class="modal-title">Payment Document Details</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body" dir="ltr">
    <div class="row g-3">
        <div class="col-md-4">
            <strong>Document Number:</strong>
            <div>@Model.DocumentNumber</div>
        </div>

        <div class="col-md-4">
            <strong>Document Date:</strong>
            <div>@Model.DocumentDateShamsi</div>
        </div>

        <div class="col-md-4">
            <strong>Amount:</strong>
            <div>@Model.Amount.ToString("N0")</div>
        </div>

        <div class="col-md-4">
            <strong>Company:</strong>
            <div>@Model.CompanyName</div>
        </div>

        <div class="col-md-4">
            <strong>Person:</strong>
            <div>@Model.PersonName</div>
        </div>

        <div class="col-md-4">
            <strong>Currency:</strong>
            <div>@Model.CurrencyTitle</div>
        </div>

        <div class="col-md-4">
            <strong>Finance Direction:</strong>
            <div>@Model.FinanceDirectionTitle</div>
        </div>

        <div class="col-md-4">
            <strong>Payment Method:</strong>
            <div>@Model.PaymentMethodTitle</div>
        </div>

        <div class="col-md-4">
            <strong>Tracking Number:</strong>
            <div>@Model.TrackingNumber</div>
        </div>

        <div class="col-12">
            <strong>Description:</strong>
            <div>@Model.Description</div>
        </div>
    </div>

    @if (Model.Cheque != null)
    {
        <hr class="my-4" />
        <h6 class="mb-3">Cheque Information</h6>

        <div class="row g-3">
            <div class="col-md-4">
                <strong>Cheque Number:</strong>
                <div>@Model.Cheque.ChequeNumber</div>
            </div>

            <div class="col-md-4">
                <strong>Cheque Date:</strong>
                <div>@Model.Cheque.ChequeDateShamsi</div>
            </div>

            <div class="col-md-4">
                <strong>Cheque Type:</strong>
                <div>@Model.Cheque.ChequeTypeTitle</div>
            </div>

            <div class="col-md-4">
                <strong>Bank:</strong>
                <div>@Model.Cheque.BankName</div>
            </div>

            <div class="col-md-4">
                <strong>Bank Account:</strong>
                <div>@Model.Cheque.BankAccountNumber</div>
            </div>

            <div class="col-md-4">
                <strong>Account Holder:</strong>
                <div>@Model.Cheque.AccountHolderName</div>
            </div>

            <div class="col-12">
                <strong>Cheque Description:</strong>
                <div>@Model.Cheque.Description</div>
            </div>
        </div>
    }
</div>

<div class="modal-footer" dir="ltr">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
</div>
