@{
    ViewData["Title"] = "Containers Hub";
}

<div class="container-fluid py-3">
    <div class="hub-page-header d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-1"><i class="bi bi-box text-primary me-2"></i>Container Fleet Management</h5>
            <span class="text-muted small">Container inventory, movements, detention calculations, and cycle tracking</span>
        </div>
    </div>

    <div class="row g-3">
        <auth-policy policy="Containers.Containers.View">
            <div class="col-md-6 col-xl-4">
                <a asp-controller="Container" asp-action="Index" class="hub-card">
                    <div class="hub-icon"><i class="bi bi-box-seam"></i></div>
                    <div>
                        <div class="hub-title">Containers</div>
                        <p class="hub-desc">Master list of box units, owners, dimensions, and current locations.</p>
                    </div>
                    <i class="bi bi-chevron-right hub-arrow"></i>
                </a>
            </div>
        </auth-policy>

        <auth-policy policy="Containers.ContainerActions.View">
            <div class="col-md-6 col-xl-4">
                <a asp-controller="ContainerActions" asp-action="Index" class="hub-card">
                    <div class="hub-icon"><i class="bi bi-arrow-left-right"></i></div>
                    <div>
                        <div class="hub-title">Container Actions</div>
                        <p class="hub-desc">Record gate-in, gate-out, stripping, stuffing, and off-hire actions.</p>
                    </div>
                    <i class="bi bi-chevron-right hub-arrow"></i>
                </a>
            </div>
        </auth-policy>

        <auth-policy policy="Containers.Detentions.View">
            <div class="col-md-6 col-xl-4">
                <a asp-controller="Detentions" asp-action="Index" class="hub-card">
                    <div class="hub-icon"><i class="bi bi-clock-history"></i></div>
                    <div>
                        <div class="hub-title">Detentions & Demurrage</div>
                        <p class="hub-desc">Free time calculation, tariff slabs, and overstay detention invoices.</p>
                    </div>
                    <i class="bi bi-chevron-right hub-arrow"></i>
                </a>
            </div>
        </auth-policy>

        <auth-policy policy="Containers.ContainerTraces.View">
            <div class="col-md-6 col-xl-4">
                <a asp-controller="System" asp-action="UnderConstruction" class="hub-card">
                    <div class="hub-icon"><i class="bi bi-radar"></i></div>
                    <div>
                        <div class="hub-title">Container Traces</div>
                        <p class="hub-desc">Full lifecycle history and audit trail of each container number.</p>
                    </div>
                    <i class="bi bi-chevron-right hub-arrow"></i>
                </a>
            </div>
        </auth-policy>
    </div>
</div>
