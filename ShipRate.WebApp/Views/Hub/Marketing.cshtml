@{
    ViewData["Title"] = "Marketing Hub";
}

<div class="container-fluid py-3">
    <div class="hub-page-header d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-1"><i class="bi bi-person-lines-fill text-primary me-2"></i>Marketing & Sales Pipeline</h5>
            <span class="text-muted small">Track inbound leads, business opportunities, sales campaigns, and lost reasons</span>
        </div>
    </div>

    <div class="row g-3">
        <auth-policy policy="Marketing.Leads.View">
            <div class="col-md-6 col-xl-4">
                <a asp-controller="Leads" asp-action="Index" class="hub-card">
                    <div class="hub-icon"><i class="bi bi-funnel"></i></div>
                    <div>
                        <div class="hub-title">Leads</div>
                        <p class="hub-desc">Inbound inquiries, prospective cargo quotes, and contact conversions.</p>
                    </div>
                    <i class="bi bi-chevron-right hub-arrow"></i>
                </a>
            </div>
        </auth-policy>

        <auth-policy policy="Marketing.Opportunities.View">
            <div class="col-md-6 col-xl-4">
                <a asp-controller="System" asp-action="UnderConstruction" class="hub-card">
                    <div class="hub-icon"><i class="bi bi-lightning-charge"></i></div>
                    <div>
                        <div class="hub-title">Opportunities</div>
                        <p class="hub-desc">High-value contracts, pipeline tracking, and sales probability scoring.</p>
                    </div>
                    <i class="bi bi-chevron-right hub-arrow"></i>
                </a>
            </div>
        </auth-policy>

        <auth-policy policy="Marketing.Campaigns.View">
            <div class="col-md-6 col-xl-4">
                <a asp-controller="System" asp-action="UnderConstruction" class="hub-card">
                    <div class="hub-icon"><i class="bi bi-megaphone"></i></div>
                    <div>
                        <div class="hub-title">Campaigns</div>
                        <p class="hub-desc">Marketing activities, special seasonal freight tariffs, and promotions.</p>
                    </div>
                    <i class="bi bi-chevron-right hub-arrow"></i>
                </a>
            </div>
        </auth-policy>

        <auth-policy policy="Marketing.LostReasons.View">
            <div class="col-md-6 col-xl-4">
                <a asp-controller="LostReasons" asp-action="Index" class="hub-card">
                    <div class="hub-icon"><i class="bi bi-x-circle"></i></div>
                    <div>
                        <div class="hub-title">Lost Reasons</div>
                        <p class="hub-desc">Analysis of unclosed quotes, competitor pricing, and root reasons.</p>
                    </div>
                    <i class="bi bi-chevron-right hub-arrow"></i>
                </a>
            </div>
        </auth-policy>
    </div>
</div>
