@{
    ViewData["Title"] = "Petty Cash Hub";
}

<div class="container-fluid py-3">
    <div class="hub-page-header d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-1"><i class="bi bi-wallet2 text-primary me-2"></i>Petty Cash Management</h5>
            <span class="text-muted small">Manage operational petty cash funds, cost centers, and expense categories</span>
        </div>
    </div>

    <div class="row g-3">
        <auth-policy policy="PettyCash.PettyCashes.View">
            <div class="col-md-6 col-xl-4">
                <a asp-controller="PettyCash" asp-action="Index" class="hub-card">
                    <div class="hub-icon"><i class="bi bi-cash-stack"></i></div>
                    <div>
                        <div class="hub-title">Petty Cash Management</div>
                        <p class="hub-desc">Register cash vouchers, replenish funds, and track staff petty expenses.</p>
                    </div>
                    <i class="bi bi-chevron-right hub-arrow"></i>
                </a>
            </div>
        </auth-policy>

        <auth-policy policy="PettyCash.CostCenters.View">
            <div class="col-md-6 col-xl-4">
                <a asp-controller="CostCenter" asp-action="Index" class="hub-card">
                    <div class="hub-icon"><i class="bi bi-pie-chart"></i></div>
                    <div>
                        <div class="hub-title">Cost Center</div>
                        <p class="hub-desc">Assign expenses to internal projects, branch offices, and departments.</p>
                    </div>
                    <i class="bi bi-chevron-right hub-arrow"></i>
                </a>
            </div>
        </auth-policy>

        <auth-policy policy="PettyCash.ExpenseCategories.View">
            <div class="col-md-6 col-xl-4">
                <a asp-controller="ExpenseCategory" asp-action="Index" class="hub-card">
                    <div class="hub-icon"><i class="bi bi-tags"></i></div>
                    <div>
                        <div class="hub-title">Expense Category</div>
                        <p class="hub-desc">Classification of routine operational and terminal expenditures.</p>
                    </div>
                    <i class="bi bi-chevron-right hub-arrow"></i>
                </a>
            </div>
        </auth-policy>
    </div>
</div>
