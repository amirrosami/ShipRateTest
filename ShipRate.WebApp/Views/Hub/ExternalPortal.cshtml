@{
    ViewData["Title"] = "External Party Services";
}

<div class="container-fluid py-3">
    <div class="hub-page-header d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-1"><i class="bi bi-sliders text-primary me-2"></i>External Customer Portal</h5>
            <span class="text-muted small">Self-service cargo tracking, freight rate inquiries, and account statements</span>
        </div>
    </div>
    <div class="row g-3">
        <div class="col-md-6 col-xl-4">
            <a asp-controller="MyInquiries" asp-action="Index" class="hub-card">
                <div class="hub-icon"><i class="bi bi-search"></i></div>
                <div>
                    <div class="hub-title">My Inquiries</div>
                    <p class="hub-desc">Submit new shipment rate inquiries and view quotation history.</p>
                </div>
                <i class="bi bi-chevron-right hub-arrow"></i>
            </a>
        </div>
        <div class="col-md-6 col-xl-4">
            <a asp-controller="Invoices" asp-action="Index" class="hub-card">
                <div class="hub-icon"><i class="bi bi-receipt"></i></div>
                <div>
                    <div class="hub-title">My Debit/Credit Notes</div>
                    <p class="hub-desc">View outstanding invoices, debit notes and credit notes.</p>
                </div>
                <i class="bi bi-chevron-right hub-arrow"></i>
            </a>
        </div>
    </div>
</div>