@using ShipRate.Application.ViewModels
@model ContainerActionIndexVm

<div class="table-responsive" style="overflow-x: auto;">
    <table class="table table-sm table-bordered table-striped align-middle small mb-0">
        <thead>
            <tr>
                <th class="py-1 px-2">Container No</th>
                <th class="py-1 px-2">Date</th>
                <th class="py-1 px-2">Action</th>
                <th class="py-1 px-2">Location</th>
                <th class="py-1 px-2">Sub Loc</th>
                <th class="py-1 px-2">Voyage</th>
                <th class="py-1 px-2">V.Type</th>
                <th class="py-1 px-2">F/E</th>
                <th class="py-1 px-2">Owner</th>
                <th class="py-1 px-2">Condition</th>
                <th class="py-1 px-2">Source</th>
                <th class="py-1 px-2">Ref</th>
                <th class="py-1 px-2 text-center" style="width: 110px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Result.Items == null || !Model.Result.Items.Any())
            {
                <tr>
                    <td colspan="12" class="text-center text-muted py-2">
                        No container actions found.
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model.Result.Items)
                {
                    <tr>
                        <td class="py-1 px-2">@item.ContainerNumber</td>
                        <td class="py-1 px-2">@item.ContainerActionDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="py-1 px-2">@item.ActionTypeName</td>
                        <td class="py-1 px-2">@item.LocationName</td>
                        <td class="py-1 px-2">@item.SubLocationName</td>
                        <td class="py-1 px-2">@item.VoyageNumber</td>
                        <td class="py-1 px-2">@item.VoyageTypeName</td>
                        <td class="py-1 px-2">@item.FullEmptyName</td>
                        <td class="py-1 px-2">@item.OwnershipTypeName</td>
                        <th class="py-1 px-2">@item.ContainerActionStatusName</th>
                        <td class="py-1 px-2">@item.EventSourceName</td>
                        <td class="py-1 px-2">@item.ContainerActionSourceReference</td>
                        <td class="py-1 px-2 text-center">
                            <div class="d-inline-flex gap-1">
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary py-0 px-1"
                                        title="Details"
                                        hx-get="@Url.Action("Details", "ContainerActions", new { id = item.Id })"
                                        hx-target="#modal-content"
                                        hx-swap="innerHTML"
                                        data-bs-toggle="modal"
                                        data-bs-target="#appModal">
                                    <i class="bi bi-eye"></i>
                                </button>

                                <button type="button"
                                        class="btn btn-sm btn-outline-primary py-0 px-1"
                                        title="Edit"
                                        hx-get="@Url.Action("Edit", "ContainerActions", new { id = item.Id })"
                                        hx-target="#modal-content"
                                        hx-swap="innerHTML"
                                        data-bs-toggle="modal"
                                        data-bs-target="#appModal">
                                    <i class="bi bi-pencil-square"></i>
                                </button>

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger py-0 px-1"
                                        title="Delete"
                                        hx-delete="@Url.Action("Delete", "ContainerActions", new { id = item.Id })"
                                        hx-confirm="Are you sure you want to delete this action?"
                                        hx-target="#container-action-table-container"
                                        hx-swap="innerHTML">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-between align-items-center mt-2 small">
    <div class="text-muted">
        Total: @Model.Result.TotalCount
    </div>

    @if (Model.Result.TotalPages > 1)
    {
        <nav>
            <ul class="pagination pagination-sm mb-0">

                <li class="page-item @(Model.Result.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link py-1"
                       hx-get="@Url.Action("Index", "ContainerActions", new
                       {
                           pageNumber = Model.Result.PageNumber - 1,
                           pageSize = Model.Result.PageSize,
                           ContainerNumber = Model.SearchForm.ContainerNumber,
                           CntActionTypeId = Model.SearchForm.CntActionTypeId,
                           LocationId = Model.SearchForm.LocationId,
                           SubLocationId = Model.SearchForm.SubLocationId,
                           VoyageId = Model.SearchForm.VoyageId,
                           VoyageTypeId = Model.SearchForm.VoyageTypeId,
                           CntOwnTypeId = Model.SearchForm.CntOwnTypeId,
                           FullMTId = Model.SearchForm.FullMTId,
                           EventActionSourceId = Model.SearchForm.EventActionSourceId,
                           FromDate = Model.SearchForm.FromDate,
                           ToDate = Model.SearchForm.ToDate
                       })"
                   hx-target="#container-action-table-container"
                   hx-swap="innerHTML">
                    Prev
                </a>
            </li>

            @for (var i = 1; i <= Model.Result.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Result.PageNumber ? "active" : "")">
                        <a class="page-link py-1"
                           hx-get="@Url.Action("Index", "ContainerActions", new
                           {
                               pageNumber = i,
                               pageSize = Model.Result.PageSize,
                               ContainerNumber = Model.SearchForm.ContainerNumber,
                               CntActionTypeId = Model.SearchForm.CntActionTypeId,
                               LocationId = Model.SearchForm.LocationId,
                               SubLocationId = Model.SearchForm.SubLocationId,
                               VoyageId = Model.SearchForm.VoyageId,
                               VoyageTypeId = Model.SearchForm.VoyageTypeId,
                               CntOwnTypeId = Model.SearchForm.CntOwnTypeId,
                               FullMTId = Model.SearchForm.FullMTId,
                               EventActionSourceId = Model.SearchForm.EventActionSourceId,
                               FromDate = Model.SearchForm.FromDate,
                               ToDate = Model.SearchForm.ToDate
                           })"
                   hx-target="#container-action-table-container"
                   hx-swap="innerHTML">
                    @i
                </a>
            </li>
                        }

                <li class="page-item @(Model.Result.HasNextPage ? "" : "disabled")">
                    <a class="page-link py-1"
                       hx-get="@Url.Action("Index", "ContainerActions", new
                       {
                           pageNumber = Model.Result.PageNumber + 1,
                           pageSize = Model.Result.PageSize,
                           ContainerNumber = Model.SearchForm.ContainerNumber,
                           CntActionTypeId = Model.SearchForm.CntActionTypeId,
                           LocationId = Model.SearchForm.LocationId,
                           SubLocationId = Model.SearchForm.SubLocationId,
                           VoyageId = Model.SearchForm.VoyageId,
                           VoyageTypeId = Model.SearchForm.VoyageTypeId,
                           CntOwnTypeId = Model.SearchForm.CntOwnTypeId,
                           FullMTId = Model.SearchForm.FullMTId,
                           EventActionSourceId = Model.SearchForm.EventActionSourceId,
                           FromDate = Model.SearchForm.FromDate,
                           ToDate = Model.SearchForm.ToDate
                       })"
                   hx-target="#container-action-table-container"
                   hx-swap="innerHTML">
                    Next
                </a>
            </li>

            </ul>
        </nav>
        }
</div>
