@using ShipRate.Application.ViewModels
@model DischargeVm

<form asp-action="Discharge"
      asp-controller="ContainerActions"
      method="post"
      hx-post="@Url.Action("Discharge", "ContainerActions")"
      hx-target="#modal-content"
      hx-swap="innerHTML">
    @Html.AntiForgeryToken()
    <div class="modal-header">
        <h5 class="modal-title">Discharge</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-3">

            <div class="col-md-4">
                <label asp-for="ContainerNumber" class="form-label"></label>
                <input asp-for="ContainerNumber" class="form-control" />
                <span asp-validation-for="ContainerNumber" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="ContainerActionDateTime" class="form-label"></label>
                <input asp-for="ContainerActionDateTime"
                       type="datetime-local"
                       class="form-control"
                       value="@Model.ContainerActionDateTime.ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="ContainerActionDateTime" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="ContainerActionSourceReference" class="form-label"></label>
                <input asp-for="ContainerActionSourceReference" class="form-control" />
                <span asp-validation-for="ContainerActionSourceReference" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label>Location</label>
                <input type="hidden" asp-for="LocationId" id="LocationId" />
                <input type="text"
                       id="LocationSearchText"
                       name="Location"
                       value="@Model.LocationName"
                       class="form-control"
                       placeholder="Search Location..."
                       autocomplete="off"
                       hx-get="@Url.Action("SearchLocations", "Locations")"
                       hx-trigger="keyup changed delay:400ms"
                       hx-target="#locationSearchResults"
                       hx-swap="innerHTML"
                       hx-vals='js:{
                            term: document.getElementById("LocationSearchText").value,
                            targetHiddenInputId: "LocationId",
                            targetTextInputId: "LocationSearchText"
                       }' />

                <div id="locationSearchResults"
                     class="position-relative">
                </div>
                <span asp-validation-for="LocationId" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label>Sub Location</label>
                <input type="hidden" asp-for="SubLocationId" id="SubLocationId" />
                <input type="text"
                       id="SubLocationSearchText"
                       name="SubLocation"
                       value="@Model.SubLocationName"
                       class="form-control"
                       placeholder="Search SubLocation..."
                       autocomplete="off"
                       hx-get="@Url.Action("SearchLocations", "Locations")"
                       hx-trigger="keyup changed delay:400ms"
                       hx-target="#sublocationSearchResults"
                       hx-swap="innerHTML"
                       hx-vals='js:{
                            term: document.getElementById("SubLocationSearchText").value,
                            targetHiddenInputId: "SubLocationId",
                            targetTextInputId: "SubLocationSearchText"
                       }' />

                <div id="sublocationSearchResults"
                     class="position-relative">
                </div>
                <span asp-validation-for="SubLocationId" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="VoyageId" class="form-label"></label>
                <select asp-for="VoyageId" asp-items="Model.Voyages" class="form-select">
                    <option value="">Select voyage</option>
                </select>
                <span asp-validation-for="VoyageId" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="CntOwnTypeId" class="form-label"></label>
                <select asp-for="CntOwnTypeId" asp-items="Model.OwnershipTypes" class="form-select">
                    <option value="">Select ownership type</option>
                </select>
                <span asp-validation-for="CntOwnTypeId" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="FullMTId" class="form-label"></label>
                <select asp-for="FullMTId" asp-items="Model.FullEmptyTypes" class="form-select">
                    <option value="">Select full / empty</option>
                </select>
                <span asp-validation-for="FullMTId" class="text-danger"></span>
            </div>

            <div class="col-md-12">
                <label asp-for="Remarks" class="form-label"></label>
                <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Remarks" class="text-danger"></span>
            </div>

        </div>
    </div>
    <div class="modal-footer">
        <button type="button"
                class="btn btn-outline-secondary"
                data-bs-dismiss="modal">
            Cancel
        </button>
        <button type="submit" class="btn btn-primary">
            Save
        </button>
    </div>
</form>
