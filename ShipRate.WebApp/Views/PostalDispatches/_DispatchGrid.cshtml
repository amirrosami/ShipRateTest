@using ShipRate.WebApp.ViewModels
@model PagedResult<DispatchGridRow>

<div class="table-responsive">
    <table class="table table-sm table-hover table-striped mb-0">
        <thead class="table-light">
            <tr>
                <th style="width:40px">#</th>
                <th>Dispatch Date</th>
                <th>Sender</th>
                <th>Receiver</th>
                <th>Courier</th>
                <th>Tracking #</th>
                <th>Method</th>
                <th>Status</th>
                <th style="width:180px" class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr>
                    <td colspan="9" class="text-center text-muted py-3">No records found</td>
                </tr>
            }
            @{
                var rowNum = (Model.Page - 1) * Model.PageSize;
            }
            @foreach (var d in Model.Items)
            {
                rowNum++;
                <tr style="cursor:pointer"
                    class="dispatch-row"
                    hx-get="@Url.Action("ItemGrid", new { dispatchId = d.Id })"
                    hx-target="#item-grid"
                    hx-swap="innerHTML"
                    onclick="document.querySelectorAll('.dispatch-row').forEach(r=>r.classList.remove('table-active'));this.classList.add('table-active');document.getElementById('selected-dispatch-label').textContent='[ @d.TrackingNumber ]';">
                    <td>@rowNum</td>
                    <td>@d.DispatchDate.ToString("yyyy-MM-dd")</td>
                    <td>@d.SenderName</td>
                    <td>@d.ReceiverName</td>
                    <td>@d.CourierCompanyName</td>
                    <td><span class="badge bg-info text-dark">@d.TrackingNumber</span></td>
                    <td>@d.CourierMethodName</td>
                    <td>
                        @if (d.StatusId == 5)
                        {
                            <span class="badge bg-success">@d.StatusName</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">@d.StatusName</span>
                        }
                    </td>
                    <td class="text-center" onclick="event.stopPropagation();">
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-primary btn-sm"
                                    title="Edit"
                                    hx-get="@Url.Action("Edit", new { id = d.Id })"
                                    hx-target="#modal-container"
                                    hx-swap="innerHTML">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <button class="btn btn-outline-danger btn-sm"
                                    title="Delete"
                                    hx-delete="@Url.Action("Delete", new { id = d.Id })"
                                    hx-confirm="Are you sure you want to delete this dispatch?"
                                    hx-swap="none">
                                <i class="bi bi-trash"></i>
                            </button>
                            @if (d.StatusId != 5)
                            {
                                <button class="btn btn-outline-success btn-sm"
                                        title="Confirm Receipt"
                                        hx-get="@Url.Action("ConfirmModal", new { id = d.Id })"
                                        hx-target="#modal-container"
                                        hx-swap="innerHTML">
                                    <i class="bi bi-check2-circle"></i>
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <nav class="d-flex justify-content-between align-items-center px-3 py-2 border-top">
        <small class="text-muted">
            Showing @((Model.Page - 1) * Model.PageSize + 1)
            - @(Math.Min(Model.Page * Model.PageSize, Model.TotalCount))
            of @Model.TotalCount
        </small>
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" href="#"
                   hx-get="@Url.Action("DispatchGrid")"
                   hx-target="#dispatch-grid"
                   hx-swap="innerHTML"
                   hx-include="#searchForm"
                   hx-vals='{"Page": @(Model.Page - 1)}'>
                    &laquo;
                </a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                var pg = i;
                <li class="page-item @(pg == Model.Page ? "active" : "")">
                    <a class="page-link" href="#"
                       hx-get="@Url.Action("DispatchGrid")"
                       hx-target="#dispatch-grid"
                       hx-swap="innerHTML"
                       hx-include="#searchForm"
                       hx-vals='{"Page": @pg}'>
                        @pg
                    </a>
                </li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="#"
                   hx-get="@Url.Action("DispatchGrid")"
                   hx-target="#dispatch-grid"
                   hx-swap="innerHTML"
                   hx-include="#searchForm"
                   hx-vals='{"Page": @(Model.Page + 1)}'>
                    &raquo;
                </a>
            </li>
        </ul>
    </nav>
}
