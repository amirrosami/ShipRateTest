@using ShipRate.WebApp.ViewModels
@model List<ItemGridRow>

<div class="table-responsive">
    <table class="table table-sm table-bordered table-striped mb-0">
        <thead class="table-light">
            <tr>
                <th style="width:40px">#</th>
                <th>Document Description</th>
                <th>Item Reference</th>
                <th style="width:90px" class="text-center">Original</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-3">No items for this dispatch</td>
                </tr>
            }
            @for (int i = 0; i < Model.Count; i++)
            {
                <tr>
                    <td>@(i + 1)</td>
                    <td>@Model[i].DocumentDescription</td>
                    <td>@Model[i].ItemReference</td>
                    <td class="text-center">
                        @if (Model[i].IsOriginal)
                        {
                            <i class="bi bi-check-circle-fill text-success"></i>
                        }
                        else
                        {
                            <i class="bi bi-x-circle text-muted"></i>
                        }
                    </td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                hx-get="/DocumentManager/Index?objectId=@Model[i].Id&objectTypeId=470"
                                hx-target="#document-manager-content"
                                hx-swap="innerHTML"
                                data-bs-toggle="modal"
                                data-bs-target="#documentManagerModal">
                            <i class="bi bi-folder2-open me-1"></i>Documents
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
