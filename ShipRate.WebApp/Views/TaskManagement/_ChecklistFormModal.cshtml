@using ShipRate.WebApp.ViewModels.TaskVms
@model CheckListCreateEditViewModel

<div class="modal-header">
    <h5 class="modal-title">@(Model.Id==Guid.Empty ? "Add Checklist Item" : "Edit Checklist Item")</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<form hx-post="/TaskManagement/CreateChecklist"
      hx-target="#checklistGridContainer"
      hx-swap="innerHTML">
    <div class="modal-body">
        <input type="hidden" name="TaskId" value="@Model.TaskId" />
        <input type="hidden" name="Id" value="@Model.Id" />

        <div class="mb-3">
            <label class="form-label">Title *</label>
            <input type="text" class="form-control" name="CheckListTitle" value="@Model.CheckListTitle" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea class="form-control" name="Description" rows="3">@Model.Description</textarea>
        </div>

        <div class="form-check mb-3">
            <input type="checkbox" class="form-check-input" name="IsMandatory" value="true" checked="@Model.IsMandatory" />
            <label class="form-check-label">Mandatory</label>
        </div>

    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
