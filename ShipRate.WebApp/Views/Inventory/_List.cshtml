@using ShipRate.Application.DTOs
@using ShipRate.Application.DTOs.Base_Info
@using ShipRate.Domain.Entities.BaseInfo.Cargos
@model PagedResultDto<InventoryDto>
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Row</th>
                    <th>Company</th>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Remarks</th>
                    <th class="text-center" style="width:160px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox display-4 d-block mb-2"></i>
                            No Records found.
                        </td>
                    </tr>
                }
                else
                {
                    int counter = (Model.PageNumber - 1) * Model.PageSize;
                    @foreach (var item in Model.Items)
                    {
                        counter++;
                        <tr>
                            <td>@counter</td>
                            <td class="fw-medium">@item.CompanyName</td>
                            <td class="fw-medium">@item.InventoryCode</td>
                            <td class="fw-medium">@item.InventoryName</td>
                            <td class="fw-medium">@item.Remarks</td>

                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <button type="button"
                                            class="btn btn-outline-primary"
                                            title="Edit"
                                            hx-get="@Url.Action("Edit", "Inventory", new { id = item.Id })"
                                            hx-target="#modal-content"
                                            hx-swap="innerHTML"
                                            onclick="showModal()">
                                        <i class="bi bi-pencil"></i>

                                    </button>
                                    <button type="button"
                                            class="btn btn-outline-danger"
                                            title="Delete"
                                            hx-get="@Url.Action("Delete", "Inventory", new { id = item.Id })"
                                            hx-target="#modal-content"
                                            hx-swap="innerHTML"
                                            onclick="showModal()">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @* ── Pagination Footer ── *@

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer d-flex justify-content-between align-items-center">
            <small class="text-muted">
                Showing @((Model.PageNumber - 1) * Model.PageSize + 1)–@Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount) of @Model.TotalCount
            </small>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link"
                           hx-get="@Url.Action("List", "Inventory")"
                           hx-target="#table-container"
                           hx-swap="innerHTML"
                           hx-vals='{"pagenumber":"@(Model.PageNumber - 1)","pageSize":"@Model.PageSize","searchterm":"@Model.SearchTerm","sortColumn":"@Model.SortColumn","sortDirection":"@Model.SortDirection"}'
                           href="#">&laquo;</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link"
                               hx-get="@Url.Action("List", "Inventory")"
                               hx-target="#table-container"
                               hx-swap="innerHTML"
                               hx-vals='{"pagenumber":"@i","pageSize":"@Model.PageSize","searchterm":"@Model.SearchTerm","sortColumn":"@Model.SortColumn","sortDirection":"@Model.SortDirection"}'
                               href="#">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link"
                           hx-get="@Url.Action("List", "Inventory")"
                           hx-target="#table-container"
                           hx-swap="innerHTML"
                           hx-vals='{"pagenumber":"@(Model.PageNumber + 1)","pageSize":"@Model.PageSize","searchterm":"@Model.SearchTerm","sortColumn":"@Model.SortColumn","sortDirection":"@Model.SortDirection"}'
                           href="#">&raquo;</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>