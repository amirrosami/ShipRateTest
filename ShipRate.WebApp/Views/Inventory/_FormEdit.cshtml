@using ShipRate.Application.DTOs
@using ShipRate.Application.DTOs.Base_Info
@model InventoryUpdateDto



<form hx-post="@Url.Action("Edit", "Inventory")"
      hx-target="#modal-content"
      hx-swap="innerHTML">

    <div class="modal-header bg-primary">
        <h5 class="modal-title text-white"><i class="bi bi-pencil-square me-2"></i>Edit Inventory</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />

        @if (!ViewData.ModelState.IsValid)
        {
            var allErrors = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).ToList();
            if (allErrors.Any())
            {
                <div class="alert alert-danger py-2 mb-3">
                    <ul class="mb-0 small">
                        @foreach (var err in allErrors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }
        }

        <!-- Category -->
        <div class="mb-3">
            <label class="form-label fw-medium">
                Company <span class="text-danger">*</span>
            </label>
            <div class="d-flex align-items-center gap-2">
                <select asp-for="CompanyId"
                        asp-items="@ViewBag.Companies"
                        class="form-select">
                    <option value="">-- Select --</option>
                </select>
                <span asp-validation-for="CompanyId" class="text-danger"></span>
            </div>
        </div>

        <!-- Code -->
        <div class="mb-3">
            <label class="form-label fw-medium">
                Code <span class="text-danger">*</span>
            </label>
            <input type="text"
                   name="InventoryCode"
                   value="@Model.InventoryCode"
                   class="form-control @(ViewData.ModelState.ContainsKey("InventoryCode") && ViewData.ModelState["InventoryCode"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                   maxlength="10" required />
        </div>

        <!-- Name -->
        <div class="mb-3">
            <label class="form-label fw-medium">Name</label>
            <input type="text"
                   name="InventoryName"
                   value="@Model.InventoryName"
                   class="form-control @(ViewData.ModelState.ContainsKey("InventoryName") && ViewData.ModelState["InventoryName"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                   maxlength="50" required />
        </div>


        <!-- Remarls -->
        <div class="mb-3">
            <label class="form-label fw-medium">Remarks</label>
            <textarea name="Remarks"
                      class="form-control @(ViewData.ModelState.ContainsKey("Remarks") && ViewData.ModelState["Remarks"]!.Errors.Any() ? "is-invalid" : "")"
                      placeholder=""
                      rows="2"
                      maxlength="200">@Model.Remarks</textarea>
        </div>



    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-warning">
            <i class="bi bi-check-lg me-1"></i> Update
        </button>
    </div>
</form>
