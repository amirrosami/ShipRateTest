@using ShipRate.Application.ViewModels
@model ReportsIndexViewModel

@{
    ViewData["Title"] = "Reports Center";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Reports Center</h2>
            <p class="text-muted mb-0">
                Company ID: @Model.SelectedCompanyId
            </p>
        </div>
    </div>

@*     <div class="text-center">
        <h1 class="display-4">مدیریت کانتینرها</h1>
        <a href="@Url.Action("ShowContainersReport", "Reports")" class="btn btn-primary" target="_blank">
            مشاهده گزارش کانتینرها (PDF)
        </a>
    </div>
 *@
   
