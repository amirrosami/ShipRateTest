@using ShipRate.Application.DTOs
@using ShipRate.Application.DTOs.Cargo
@using ShipRate.WebApp.ViewModels
@using ShipRate.WebApp.ViewModels.Location
@using ShipRate.WebApp.ViewModels.TransitViewModels
@model GridViewModel

@if (!Model.Data.Items.Any())
{
    <tr>
        <td colspan="7" class="text-center py-5 text-muted">
            <i class="bi bi-inbox display-4 d-block mb-2"></i>
            No Records found.
        </td>
    </tr>
}
else
{
    int counter = (Model.Data.Page - 1) * Model.Data.PageSize;
    @foreach (var item in Model.Data.Items)
    {
        var vm = (GPSDeviceListItem)item;
        counter++;
        <tr>
            <td>@counter</td>
            <td class="fw-medium">@vm.GPSDeviceSerialNumber</td>
            <td class="fw-medium">@vm.ProviderName</td>
            <td class="fw-medium">@vm.StatusName</td>
            <td class="fw-medium">@vm.Remarks</td>
@*             <td class="fw-medium">
                @if (vm.IsActive)
                {
                    <span class="badge text-bg-success">
                        Active
                    </span>
                }
                else
                {
                    <span class="badge text-bg-danger">
                        Inactive
                    </span>
                }
            </td>
 *@            <td class="text-center">
                <div class="btn-group btn-group-sm">

                    <button type="button"
                            class="btn btn-outline-info"
                            title="Details"
                            hx-get="@Url.Action("Details", "CargoCommodity", new { id = vm.Id })"
                            hx-target="#app-modal-content"
                            hx-swap="innerHTML">
                        <i class="bi bi-card-list"></i>
                    </button>

                    <button type="button"
                            class="btn btn-outline-primary"
                            title="Edit"
                            hx-get="@Url.Action("Edit", "CargoCommodity", new { id = vm.Id })"
                            hx-target="#app-modal-content"
                            hx-swap="innerHTML">
                        <i class="bi bi-pencil"></i>

                    </button>
                    <button type="button"
                            class="btn btn-outline-danger"
                            title="Delete"
                            hx-get="@Url.Action("Delete", "CargoCommodity", new { id = vm.Id })"
                            hx-target="#app-modal-content"
                            hx-swap="innerHTML">
                        <i class="bi bi-trash"></i>
                    </button>

                </div>
            </td>
        </tr>
    }
}


@* @using ShipRate.WebApp.ViewModels.TransitViewModels
@model GPSDeviceIndexViewModel

@if (!Model.Devices.Any())
{
    <div class="alert alert-light text-center py-4 mb-0">
        <i class="bi bi-inbox fs-3 d-block mb-2 text-muted"></i>
        No devices found.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover table-bordered align-middle mb-2">
            <thead class="table-light">
                <tr>
                    <th style="width:40px">#</th>
                    <th>Serial Number</th>
                    <th>GPS Provider</th>
                    <th>Status</th>
                    <th>Remarks</th>
                    <th style="width:60px" class="text-center">Active</th>
                    <th style="width:100px" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var rowNum = (Model.CurrentPage - 1) * Model.PageSize;
                }
                @foreach (var item in Model.Devices)
                {
                    rowNum++;
                    // Status badge color
                    var badgeClass = item.GPSDeviceStatusId switch
                    {
                        1 => "bg-info",         // Available
                        2 => "bg-success",       // Installed
                        3 => "bg-danger",        // Faulty
                        4 => "bg-warning text-dark", // InRepair
                        5 => "bg-secondary",     // Uninstalled
                        6 => "bg-dark",          // Retired
                        _ => "bg-secondary"
                    };

                    <tr>
                        <td class="text-muted">@rowNum</td>
                        <td>
                            <i class="bi bi-cpu me-1 text-primary"></i>
                            <strong>@item.GPSDeviceSerialNumber</strong>
                        </td>
                        <td>@item.ProviderName</td>
                        <td>
                            <span class="badge @badgeClass">@item.StatusName</span>
                        </td>
                        <td class="text-muted small">@item.Remarks</td>
                        <td class="text-center">
                            @if (item.IsActive)
                            {
                                <i class="bi bi-check-circle-fill text-success"></i>
                            }
                            else
                            {
                                <i class="bi bi-x-circle text-danger"></i>
                            }
                        </td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-primary"
                                        title="Edit"
                                        hx-get="@Url.Action("Edit", new { id = item.Id })"
                                        hx-target="#modalContainer"
                                        hx-swap="innerHTML">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-outline-danger"
                                        title="Delete"
                                        hx-delete="@Url.Action("Delete", new { id = item.Id })"
                                        hx-confirm="Are you sure you want to delete this device?"
                                        hx-swap="none">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- ══════ Pagination ══════ -->
    @if (Model.TotalPages > 1)
    {
        <nav class="d-flex justify-content-center">
            <ul class="pagination pagination-sm mb-0">

                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="#"
                       hx-get="@Url.Action("List", new { searchSerial = Model.SearchSerial, searchProviderId = Model.SearchProviderId, searchStatusId = Model.SearchStatusId, page = Model.CurrentPage - 1 })"
                       hx-target="#gridArea"
                       hx-swap="innerHTML">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="#"
                           hx-get="@Url.Action("List", new { searchSerial = Model.SearchSerial, searchProviderId = Model.SearchProviderId, searchStatusId = Model.SearchStatusId, page = i })"
                           hx-target="#gridArea"
                           hx-swap="innerHTML">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="#"
                       hx-get="@Url.Action("List", new { searchSerial = Model.SearchSerial, searchProviderId = Model.SearchProviderId, searchStatusId = Model.SearchStatusId, page = Model.CurrentPage + 1 })"
                       hx-target="#gridArea"
                       hx-swap="innerHTML">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>

            </ul>
        </nav>
    }
} *@
