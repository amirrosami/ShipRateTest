@using ShipRate.WebApp.ViewModels
@using ShipRate.WebApp.ViewModels.Location
@using ShipRate.WebApp.ViewModels.TerritoryVms
@using ShipRate.WebApp.ViewModels.TransitViewModels
@model GPSDeviceFormViewModel
@{
    string CreateEdit = ViewBag.CreateEdit;
    bool isCreateMode = false;
    if (CreateEdit == "Create") isCreateMode = true;
}

<form hx-post="@Url.Action(isCreateMode?"Create":"Edit", "GPSDevice")"
      hx-target="#app-modal-content"
      hx-swap="innerHTML">

    <div class="modal-header form-caption-bg  text-white">
        @if (isCreateMode)
        {
            <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Add GPS Device</h5>
        }
        else
        {
            <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Edit GPS Device</h5>
            <input type="hidden" asp-for="Id" />
        }


        <button type="button"
                class="btn-close"
                onclick="AppModal.close()">
        </button>
    </div>


    <div class="modal-body row">

        @await Html.PartialAsync("_ModelStateError")



        <div class="mb-3 col-md-4">
            <label asp-for="GPSDeviceSerialNumber" class="form-label form-label-sm">
                <i class="bi bi-upc-scan me-1"></i>Serial Number <span class="text-danger">*</span>
            </label>
            <input asp-for="GPSDeviceSerialNumber" class="form-control form-control-sm"
                   placeholder="" />
            <span asp-validation-for="GPSDeviceSerialNumber" class="text-danger small"></span>
        </div>

        <!-- GPS Provider -->
        <div class="mb-3 mb-3 col-md-4">
            <label asp-for="GPSProviderId" class="form-label form-label-sm">
                <i class="bi bi-building me-1"></i>GPS Provider <span class="text-danger">*</span>
            </label>
            <select asp-for="GPSProviderId" asp-items="Model.Providers"
                    class="form-select form-select-sm">
                <option value="">-- Select Provider --</option>
            </select>
            <span asp-validation-for="GPSProviderId" class="text-danger small"></span>
        </div>

        <!-- Status -->
        <div class="mb-3 mb-3 col-md-4">
            <label asp-for="GPSDeviceStatusId" class="form-label form-label-sm">
                <i class="bi bi-activity me-1"></i>Status <span class="text-danger">*</span>
            </label>
            <select asp-for="GPSDeviceStatusId" asp-items="Model.Statuses"
                    class="form-select form-select-sm">
                <option value="">-- Select Status --</option>
            </select>
            <span asp-validation-for="GPSDeviceStatusId" class="text-danger small"></span>
        </div>

        <!-- Remarks -->
        <div class="mb-3 col-md-12">
            <label asp-for="Remarks" class="form-label form-label-sm">
                <i class="bi bi-chat-text me-1"></i>Remarks
            </label>
            <textarea asp-for="Remarks" class="form-control form-control-sm"
                      rows="2" placeholder="Optional notes..."></textarea>
        </div>

        <!-- Active -->
        <div class="form-check form-switch">
            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
            <label asp-for="IsActive" class="form-check-label small">Active</label>
        </div>

    </div>


    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="AppModal.close()">Cancel</button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>

            @if (isCreateMode)
            {
                <span>Save</span>
            }
            else
            {
                <span>Update</span>
            }
        </button>
    </div>
</form>





