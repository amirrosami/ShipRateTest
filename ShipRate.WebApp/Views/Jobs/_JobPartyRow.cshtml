@using ShipRate.Application.JobsViewModels
@model JobPartyCreateVm
<div class="card mb-2 party-row">
    <div class="card-body py-2">
        <input type="hidden" name="Parties.Index" value="@Model.Index" />

@*         <div class="d-flex justify-content-between align-items-center mb-3">
            <strong>Container @(Model.Index + 1)</strong>
            <button type="button"
                    class="btn btn-sm btn-outline-danger"
                    onclick="this.closest('.party-row').remove()">
                Remove
            </button>
        </div>
 *@
        <div class="row g-2">
            <div class="col-md-2">
                <select name="Parties[@Model.Index].RoleTypeId" class="form-select form-select-sm">
                    <option value="">Role Type</option>
                    @foreach (var item in Model.RoleTypes)
                    {
                        <option value="@item.Value" selected="@(item.Value == Model.RoleTypeId.ToString() ? "selected" : null)">
                            @item.Text
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-1">
                <input name="Parties[@Model.Index].IsPrimaryRole"
                       value="@Model.IsPrimaryRole"
                       type="checkbox"
                       class="form-check"/>
            </div>
            <div class="col-md-2">
                <input name="Parties[@Model.Index].ContactName"
                       value="@Model.ContactName"
                       class="form-control form-control-sm"
                       placeholder="Contact Name" />
            </div>
            <div class="col-md-2">
                <input name="Parties[@Model.Index].ContactEmail"
                       value="@Model.ContactEmail"
                       class="form-control form-control-sm"
                       placeholder="Contact Email" />
            </div>
            <div class="col-md-2">
                <input name="Parties[@Model.Index].ContactPhone"
                       value="@Model.ContactPhone"
                       class="form-control form-control-sm"
                       placeholder="Contact Phone" />
            </div>

            <div class="col-md-1">
                <button type="button"
                        class="btn-close position-absolute top-3 end-5 m-2"
                        onclick="this.closest('.party-row').remove()">
                </button>
            </div>
        </div>
    </div>
</div>
