@using ShipRate.Application.JobsViewModels
@model JobPackageCreateVm

<div class="card mb-2 package-row">
    <div class="card-body py-2">
        <input type="hidden" name="Packages.Index" value="@Model.Index" />

        @*         <div class="d-flex justify-content-between align-items-center mb-2">
            <strong>Package @(Model.Index + 1)</strong>
            <button type="button"
                    class="btn btn-sm btn-outline-danger"
                    onclick="this.closest('.package-row').remove()">
                Remove
            </button>
        </div>
 *@
        <div class="row g-2">
            <div class="col-md-2">
                <select name="Packages[@Model.Index].PackageTypeId" class="form-select form-select-sm">
                    <option value="">Package Type</option>
                    @foreach (var item in Model.PackageTypes)
                    {
                        <option value="@item.Value" selected="@(item.Value == Model.PackageTypeId.ToString() ? "selected" : null)">
                            @item.Text
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <input name="Packages[@Model.Index].UnitCounts"
                       value="@Model.UnitCounts"
                       class="form-control form-control-sm"
                       placeholder="Counts" />
            </div>

            <div class="col-md-2">
                <input name="Packages[@Model.Index].UnitLength"
                       value="@Model.UnitLength"
                       class="form-control form-control-sm"
                       placeholder="Unit Length" />
            </div>

            <div class="col-md-2">
                <input name="Packages[@Model.Index].UnitWidth"
                       value="@Model.UnitWidth"
                       class="form-control form-control-sm"
                       placeholder="Unit Width" />
            </div>

            <div class="col-md-2">
                <input name="Packages[@Model.Index].UnitHeight"
                       value="@Model.UnitHeight"
                       class="form-control form-control-sm"
                       placeholder="Unit Height" />
            </div>
            <div class="col-md-2">
                <input name="Packages[@Model.Index].TotalLength"
                       value="@Model.TotalLength"
                       class="form-control form-control-sm"
                       placeholder="Total Length" />
            </div>

            <div class="col-md-2">
                <input name="Packages[@Model.Index].TotalWidth"
                       value="@Model.TotalWidth"
                       class="form-control form-control-sm"
                       placeholder="Total Width" />
            </div>

            <div class="col-md-2">
                <input name="Packages[@Model.Index].TotalHeight"
                       value="@Model.TotalHeight"
                       class="form-control form-control-sm"
                       placeholder="Total Height" />
            </div>

            <div class="col-md-2">
                <select name="Packages[@Model.Index].DimensionMeasurementUnitId" class="form-select form-select-sm">
                    <option value="">Dimension Unit</option>
                    @foreach (var item in Model.DimensionMeasurementUnits)
                    {
                        <option value="@item.Value" selected="@(item.Value == Model.DimensionMeasurementUnitId.ToString() ? "selected" : null)">
                            @item.Text
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <input name="Packages[@Model.Index].UnitVolume"
                       value="@Model.UnitVolume"
                       class="form-control form-control-sm"
                       placeholder="Unit Volume" />
            </div>
            <div class="col-md-2">
                <input name="Packages[@Model.Index].TotalVolume"
                       value="@Model.TotalVolume"
                       class="form-control form-control-sm"
                       placeholder="Total Volume" />
            </div>

            <div class="col-md-2">
                <select name="Packages[@Model.Index].VolumeMeasurementUnitId" class="form-select form-select-sm">
                    <option value="">Volume Meas.</option>
                    @foreach (var item in Model.VolumeMeasurementUnits)
                    {
                        <option value="@item.Value" selected="@(item.Value == Model.VolumeMeasurementUnitId.ToString() ? "selected" : null)">
                            @item.Text
                        </option>
                    }
                </select>
            </div>


            <div class="col-md-2">
                <input name="Packages[@Model.Index].UnitGrossWeight"
                       value="@Model.UnitGrossWeight"
                       class="form-control form-control-sm"
                       placeholder="Unit G.Weigth" />
            </div>
            <div class="col-md-2">
                <input name="Packages[@Model.Index].UnitNetWeight"
                       value="@Model.UnitNetWeight"
                       class="form-control form-control-sm"
                       placeholder="Unit N.Weight" />
            </div>
            <div class="col-md-2">
                <input name="Packages[@Model.Index].TotalGrossWeight"
                       value="@Model.TotalGrossWeight"
                       class="form-control form-control-sm"
                       placeholder="Total G.Weight" />
            </div>
            <div class="col-md-2">
                <input name="Packages[@Model.Index].TotalNetWeight"
                       value="@Model.TotalNetWeight"
                       class="form-control form-control-sm"
                       placeholder="Total N.Weight" />
            </div>
            <div class="col-md-2">
                <select name="Packages[@Model.Index].WeightMeasurementUnitId" class="form-select form-select-sm">
                    <option value="">Weight Meas.</option>
                    @foreach (var item in Model.WeightMeasurementUnits)
                    {
                        <option value="@item.Value" selected="@(item.Value == Model.WeightMeasurementUnitId.ToString() ? "selected" : null)">
                            @item.Text
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-10">
                <input name="Packages[@Model.Index].Remarks"
                       value="@Model.Remarks"
                       class="form-control form-control-sm"
                       placeholder="Remarks" />
            </div>
            <div class="col-md-1">
                <button type="button"
                        class="btn-close position-absolute top-3 end-5 m-2"
                        onclick="this.closest('.package-row').remove()">
                </button>
            </div>
        </div>
    </div>
</div>
