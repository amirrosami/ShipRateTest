@using ShipRate.Application.ViewModels
@model List<RateRequestContainerListItemVm>

<div class="table-responsive" dir="ltr">
    <table class="table table-sm table-bordered table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Size Type</th>
                <th>Own Type</th>
                <th>Counts</th>
                <th>Remarks</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ShortName</td>
                        <td>@item.CntOwnTypeName</td>
                        <td>@item.Counts</td>
                        <td>@item.Remarks</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-3">No containers found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
