@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const jobId = "@Model.Id";
            const tabLinks = document.querySelectorAll(".job-tab-link");

            tabLinks.forEach(tab => {
                tab.addEventListener("shown.bs.tab", function () {
                    const tabName = this.getAttribute("data-tab");
                    const targetSelector = this.getAttribute("data-bs-target");
                    const target = document.querySelector(targetSelector);

                    if (!target) return;

                    if (target.getAttribute("data-loaded") === "true") return;

                    target.innerHTML = `
                        <div class="d-flex align-items-center gap-2 text-muted py-3">
                            <div class="spinner-border spinner-border-sm" role="status"></div>
                            <span>Loading...</span>
                        </div>
                    `;

                    htmx.ajax("GET",
                        `/Jobs/DetailsTab?id=${jobId}&tab=${tabName}`,
                        {
                            target: target,
                            swap: "innerHTML"
                        }
                    );

                    target.setAttribute("data-loaded", "true");
                });
            });
        });
    </script>






