    <script>
        function initShipmentLegTransportMode() {
            const select = document.getElementById('transportTypeSelect');
            if (!select) return;

            const airBlock = document.querySelector('.air-block');
            const seaBlock = document.querySelector('.sea-block');
            const roadBlock = document.querySelector('.road-block');
            const emptyBlock = document.querySelector('.transport-empty');

            const airInputs = document.querySelectorAll('.air-input');
            const seaInputs = document.querySelectorAll('.sea-input');
            const roadInputs = document.querySelectorAll('.road-input');

            function setBlock(block, inputs, active) {
                if (block) {
                    block.classList.toggle('active', active);
                }

                inputs.forEach(x => {
                    x.disabled = !active;

                    if (!active) {
                        x.value = '';
                    }
                });
            }

            function apply() {
                const text = select.options[select.selectedIndex]?.text?.toLowerCase() || '';

                const isAir = text.includes('air');
                const isSea = text.includes('sea') || text.includes('ocean');
                const isRoad = text.includes('road') || text.includes('truck') || text.includes('land');

                setBlock(airBlock, airInputs, isAir);
                setBlock(seaBlock, seaInputs, isSea);
                setBlock(roadBlock, roadInputs, isRoad);

                if (emptyBlock) {
                    emptyBlock.style.display = isAir || isSea || isRoad ? 'none' : 'block';
                }
            }

            select.removeEventListener('change', apply);
            select.addEventListener('change', apply);

            apply();
        }

        document.body.addEventListener('htmx:afterSwap', function (e) {
            if (e.detail.target && e.detail.target.id === 'modalContainer') {
                initShipmentLegTransportMode();
            }
        });

        document.addEventListener('DOMContentLoaded', function () {
            initShipmentLegTransportMode();
        });

        window.openInvoiceModal = function () {
                const modalEl = document.getElementById('invoiceModal');
                if (!modalEl) return;
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
        window.openSettleModal = function () {
                const modalEl = document.getElementById('settModal');
                if (!modalEl) return;
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
    </script>


