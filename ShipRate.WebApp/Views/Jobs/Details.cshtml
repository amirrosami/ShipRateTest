<script>

            document.addEventListener('DOMContentLoaded', function () {

            // مدیریت باز کردن مدال‌ها به محض کامل شدن Swap در HTMX
            document.body.addEventListener('htmx:afterSwap', function (evt) {

                // ۱. باز کردن مدال اصلی (لیست رویدادها)
                if (evt.target.id === 'activityLogModalContainer') {
                    const mainModalEl = document.getElementById('activityLogModal');
                    if (mainModalEl) {
                        // اطمینان از پاکسازی نمونه‌های قبلی در حافظه مرورگر
                        const existingInstance = bootstrap.Modal.getInstance(mainModalEl);
                        if (existingInstance) {
                            existingInstance.dispose();
                        }
                        const mainModal = new bootstrap.Modal(mainModalEl);
                        mainModal.show();
                    }
                }

                // ۲. باز کردن مدال ثانویه (ثبت و ویرایش رویداد)
                if (evt.target.id === 'activityLogEditorContainer') {
                    const editorModalEl = document.getElementById('activityLogEditorModal');
                    if (editorModalEl) {
                        const existingInstance = bootstrap.Modal.getInstance(editorModalEl);
                        if (existingInstance) {
                            existingInstance.dispose();
                        }
                        const editorModal = new bootstrap.Modal(editorModalEl);
                        editorModal.show();
                    }
                }
            });

            // مدیریت بستن مدال ادیتور پس از ثبت موفقیت‌آمیز فرم (دریافت پاسخ Status 200)
            document.body.addEventListener('htmx:beforeSwap', function (evt) {
                if (evt.detail.xhr.status === 200) {
                    const editorModalEl = document.getElementById('activityLogEditorModal');
                    if (editorModalEl) {
                        const modalInstance = bootstrap.Modal.getInstance(editorModalEl);
                        if (modalInstance) {
                            modalInstance.hide();

                            // پاکسازی نهایی پس‌زمینه تیره (backdrop) در صورت باقی ماندن احتمالی
                            document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
                        }
                    }
                }
            });
        });



</script>

