<script>
    // ۱. باز کردن خودکار مودال به محض اتمام لود محتوا توسط HTMX
    document.body.addEventListener('htmx:afterSwap', function (evt) {
        if (evt.detail.target.id === 'rtsModalContainer') {
            const modalEl = document.getElementById('rtsModal');
            if (modalEl) {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
        }
    });

    // ۲. آنتی‌فریز و پاکسازی لایه سیاه (Backdrop) به هنگام بسته شدن
    document.addEventListener('hidden.bs.modal', function (evt) {
        if (evt.target.id === 'rtsModal') {
            document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
            document.body.classList.remove('modal-open');
            document.body.style.removeProperty('overflow');
            document.body.style.removeProperty('padding-right');

            // خالی کردن محتوا تا در فراخوانی بعدی محتوای قدیمی دیده نشود
            const container = document.getElementById('rtsModalContainer');
            if (container) container.innerHTML = '';
        }
    });

    // ۳. بستن خودکار مودال وقتی ثبت با موفقیت انجام شد (Trigger از سمت سرور)
    document.body.addEventListener('rtsSaved', function () {
        const modalEl = document.getElementById('rtsModal');
        if (modalEl) {
            const modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) {
                modal.hide();
            }
        }
    });
</script>







