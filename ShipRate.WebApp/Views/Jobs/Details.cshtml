<div class="container-fluid py-3">
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <div class="text-muted small mb-1">Job Details</div>
            <div class="d-flex gap-3 ">
                <h2 class="fw-bold mb-1">@Model.JobNumber</h2>
                @{
                    var statusBadgeClass = Model.StatusId switch
                    {
                        1 => "grad-draft",
                        2 => "grad-confirmed",
                        3 => "grad-progress",
                        4 => "grad-completed",
                        5 => "grad-closed",
                        6 => "grad-canceld",
                        7 => "grad-hold",
                        _ => "bg-light text-dark"
                    };
                }
                <span class="badge  rounded-pill text-bg-primary px-3 py-2 d-inline-flex align-items-center justify-content-center @statusBadgeClass  ">
                    @Model.Status
                </span>

                @if (Model.StatusId == 1)
                {
                    <form>
                        <button type="button"
                                class="btn btn-sm btn-primary"
                                hx-post="/Jobs/OperationConfirm"
                                hx-confirm="Are you sure you want to confirm this job file ?"
                                hx-swap="innerHTML">
                            Operation Confirm
                        </button>
                        <input type="hidden" name="myJobId" asp-for="Id" />
                    </form>
                }


            </div>
            <div class="text-muted">
                Created: @Model.JobDate?.ToString("yyyy-MM-dd")
            </div>
        </div>
        <div class="d-flex gap-2 flex-wrap">

            <button type="button"
                    class="btn btn-sm btn-primary"
                    hx-get="/AppTasks/Create?EntityTypeId=1&relatedEntityId=@Model.Id"
                    hx-target="#modal-content"
                    hx-swap="innerHTML">
                Create Task
            </button>
            <div id="appTaskModalContent"></div>
            <a asp-action="Index"
               class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Jobs
            </a>


            @*             <button class="btn btn-outline-secondary">
                <i class="bi bi-printer me-1"></i> Print
            </button>
 *@
            @*             <button class="btn btn-dark">
