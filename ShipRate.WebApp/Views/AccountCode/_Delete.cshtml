@using ShipRate.Application.ViewModels
@model AccountCodeCreateEditVm

<form hx-post="@Url.Action("DeleteConfirmed", "AccountCode", new { id = Model.Id })"
      hx-target="#accountCodeModalBody"
      hx-swap="innerHTML"
      method="post"
      dir="ltr">

    @Html.AntiForgeryToken()

    <div class="alert alert-warning">
        Are you sure you want to delete this account code?
    </div>

    <dl class="row">
        <dt class="col-sm-4">Account Code</dt>
        <dd class="col-sm-8">@Model.AccCode</dd>
    </dl>

    <div class="mt-4 d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Delete</button>
    </div>
</form>
