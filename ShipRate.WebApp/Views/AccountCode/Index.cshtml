@using ShipRate.Application.ViewModels
@model AccountCodeSearchVm

@{
    ViewData["Title"] = "Account Codes";
}

<div class="container-fluid mt-3" dir="ltr">
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Account Codes</h5>

            <button class="btn btn-primary"
                    hx-get="@Url.Action("Create", "AccountCode")"
                    hx-target="#accountCodeModalBody"
                    hx-swap="innerHTML"
                    data-bs-toggle="modal"
                    data-bs-target="#accountCodeModal">
                <i class="bi bi-plus-lg"></i> New Account Code
            </button>
        </div>

        <div class="card-body">
            <form id="searchForm"
                  class="row g-2 mb-3"
                  hx-get="@Url.Action("List", "AccountCode")"
                  hx-target="#accountCodeListContainer"
                  hx-swap="innerHTML">
                <div class="col-md-4">
                    <label class="form-label">Search</label>
                    <input asp-for="Search" class="form-control" placeholder="Code / Company / Person / Charge Type" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Page Size</label>
                    <select asp-for="PageSize" class="form-select">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <input type="hidden" asp-for="Page" value="1" />
                    <button type="submit" class="btn btn-secondary w-100">
                        <i class="bi bi-search"></i> Search
                    </button>
                </div>
            </form>

            <div id="accountCodeListContainer"
                 hx-get="@Url.Action("List", "AccountCode", new { page = 1, pageSize = Model.PageSize })"
                 hx-trigger="load, accountCodeChanged from:body"
                 hx-target="this"
                 hx-swap="innerHTML">
                <div class="text-center py-4">
                    <span class="spinner-border spinner-border-sm"></span> Loading...
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="accountCodeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content" dir="ltr">
            <div class="modal-header">
                <h5 class="modal-title">Account Code</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="accountCodeModalBody">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.body.addEventListener('accountCodeChanged', function () {
            const modalEl = document.getElementById('accountCodeModal');
            const modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) {
                modal.hide();
            }

            htmx.ajax('GET',
                '@Url.Action("List", "AccountCode")?' + new URLSearchParams(new FormData(document.getElementById('searchForm'))).toString(),
                '#accountCodeListContainer');
        });
    </script>
}
