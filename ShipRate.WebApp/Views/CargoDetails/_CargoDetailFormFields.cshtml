                   hx-get="@Url.Action("SearchPackageTypes", "PackageTypes")"
                   hx-trigger="keyup changed delay:400ms"
                   hx-target="#innerpackagetypeSearchResults"
                   hx-swap="innerHTML"
                   hx-vals='js:{
