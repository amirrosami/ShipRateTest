            <span asp-validation-for="InnerPackageTypeId" class="text-danger small"></span>
        </div>

        <div class="col-md-2">
            <label asp-for="InnerPackageCount" class="form-label">Inner Count</label>
            <input asp-for="InnerPackageCount" class="form-control form-control-sm" />
        </div>

        <div class="col-md-2">
            <label asp-for="GrossWeight" class="form-label">Gross W.</label>
