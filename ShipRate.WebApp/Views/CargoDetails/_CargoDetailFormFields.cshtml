                    </div>
                </div>
            </div>
        </div>

        <!-- Temperature -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingTemp">
                <button class="accordion-button collapsed" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapseTemp"
                        aria-expanded="false"
                        aria-controls="collapseTemp">
                    Temperature
                </button>
            </h2>

            <div id="collapseTemp"
                 class="accordion-collapse collapse"
                 aria-labelledby="headingTemp"
                 data-bs-parent="#cargoDetailAccordion">

                <div class="accordion-body" id="tempSection">
                    <div class="row g-2">

                        <div class="col-md-3 d-flex align-items-end">
                            <div class="form-check">
                                <input asp-for="IsTemperatureControlled" class="form-check-input" id="IsTemperatureControlled" />
                                <label asp-for="IsTemperatureControlled" class="form-check-label">Temperature Controlled</label>
                            </div>
                        </div>

                        <div class="col-md-2">
                            <label asp-for="MinTemp" class="form-label">Min</label>
                            <input asp-for="MinTemp" class="form-control form-control-sm temp-field" />
                        </div>

                        <div class="col-md-2">
                            <label asp-for="NormalTemp" class="form-label">Normal</label>
                            <input asp-for="NormalTemp" class="form-control form-control-sm temp-field" />
                        </div>

                        <div class="col-md-2">
                            <label asp-for="MaxTemp" class="form-label">Max</label>
                            <input asp-for="MaxTemp" class="form-control form-control-sm temp-field" />
                        </div>

                        <div class="col-md-3">
                            <label asp-for="TempUnitId" class="form-label">Temp Unit</label>
                            <select asp-for="TempUnitId" asp-items="Model.TempUnits" class="form-select form-select-sm temp-field">
                                <option value="">-- Select --</option>
                            </select>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- Flags -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingFlags">
                <button class="accordion-button collapsed" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapseFlags"
                        aria-expanded="false"
                        aria-controls="collapseFlags">
                    Flags
                </button>
            </h2>

            <div id="collapseFlags"
                 class="accordion-collapse collapse"
                 aria-labelledby="headingFlags"
                 data-bs-parent="#cargoDetailAccordion">

                <div class="accordion-body">
                    <div class="row g-2">

                        <div class="col-md-2">
                            <div class="form-check">
                                <input asp-for="IsFragile" class="form-check-input" />
                                <label asp-for="IsFragile" class="form-check-label">Fragile</label>
                            </div>
                        </div>

                        <div class="col-md-2">
                            <div class="form-check">
                                <input asp-for="IsPerishable" class="form-check-input" />
                                <label asp-for="IsPerishable" class="form-check-label">Perishable</label>
                            </div>
                        </div>

                        <div class="col-md-2">
                            <div class="form-check">
                                <input asp-for="IsRotateable" class="form-check-input" />
                                <label asp-for="IsRotateable" class="form-check-label">Rotateable</label>
                            </div>
                        </div>

                        <div class="col-md-2">
                            <div class="form-check">
                                <input asp-for="IsStackable" class="form-check-input" />
                                <label asp-for="IsStackable" class="form-check-label">Stackable</label>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
<script>
    (function () {
        function toggleSectionByCheckbox(checkboxId, fieldClass) {
            const checkbox = document.getElementById(checkboxId);
            if (!checkbox) return;

            const fields = document.querySelectorAll('.' + fieldClass);

            function applyState() {
                const enabled = checkbox.checked;
                fields.forEach(field => {
                    field.disabled = !enabled;

                    if (!enabled) {
                        if (field.tagName === 'SELECT') {
                            field.selectedIndex = 0;
                        } else if (field.type === 'checkbox') {
                            field.checked = false;
                        } else {
                            field.value = '';
                        }
                    }
                });
            }

            applyState();
            checkbox.addEventListener('change', applyState);
        }

        function initCargoDetailToggles() {
            toggleSectionByCheckbox('IsDG', 'dg-field');
            toggleSectionByCheckbox('IsTemperatureControlled', 'temp-field');
        }

        document.addEventListener('DOMContentLoaded', initCargoDetailToggles);
        document.body.addEventListener('htmx:afterSwap', function () {
            initCargoDetailToggles();
        });
    })();
</script>
