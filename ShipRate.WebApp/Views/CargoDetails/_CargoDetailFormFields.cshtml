    <!-- Main Info -->
    <div class="row g-2 mb-2">

        <div class="col-md-1">
            <label asp-for="Sequence" class="form-label">Seq</label>
            <input asp-for="Sequence" class="form-control form-control-sm" required />
            <span asp-validation-for="Sequence" class="text-danger small"></span>
        </div>

        @*         <div class="col-md-3">
            <label asp-for="PackageTypeId" class="form-label">Package Type</label>
            <select asp-for="PackageTypeId" asp-items="Model.PackageTypes" class="form-select form-select-sm">
                <option value="">-- Select --</option>
            </select>
        </div>
 *@

        <div class="col-md-3">
            <label asp-for="PackageTypeId">Package Type</label>
            <input type="hidden" asp-for="PackageTypeId" id="PackageTypeId" required />
            <input type="text"
                   id="PackageTypeSearchText"
                   name="PackageType"
                   value="@Model.PackageTypeName"
                   class="form-control"
                   placeholder="Search Package Type..."
