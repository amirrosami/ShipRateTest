@using ShipRate.Application.ViewModels
@model CargoDetailFormVm

<style>
    .cargo-form-compact .form-label {
        font-size: .78rem;
        margin-bottom: .15rem;
        font-weight: 500;
    }

    .cargo-form-compact .form-control,
    .cargo-form-compact .form-select {
        font-size: .82rem;
    }

    .cargo-form-compact .form-check-label {
        font-size: .8rem;
    }

    .cargo-form-compact .accordion-button {
        padding: .45rem .75rem;
        font-size: .85rem;
        font-weight: 600;
    }

    .cargo-form-compact .accordion-body {
        padding: .75rem;
    }

    .cargo-form-compact textarea {
        resize: vertical;
    }
</style>

<div class="modal-header py-2">
    <h6 class="modal-title mb-0">Cargo Detail</h6>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body text-start cargo-form-compact" dir="ltr">

    <input type="hidden" asp-for="JobId" />
