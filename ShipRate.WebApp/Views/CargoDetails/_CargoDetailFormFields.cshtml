            <span asp-validation-for="PackageTypeId" class="text-danger small"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="PackageCount" class="form-label">Pkg Count</label>
            <input asp-for="PackageCount" class="form-control form-control-sm" required />
        </div>

        <div class="col-md-3">
