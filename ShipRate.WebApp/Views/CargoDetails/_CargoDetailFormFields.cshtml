        </div>

        <div class="col-md-2">
            <label asp-for="ChargeableWeight" class="form-label">Chargeable W.</label>
            <input asp-for="ChargeableWeight" class="form-control form-control-sm" />
        </div>


        <div class="col-md-2">
            <label asp-for="WeightUnitId" class="form-label">W. Unit</label>
            <select asp-for="WeightUnitId" asp-items="Model.WeightUnits" class="form-select form-select-sm">
                <option value="">-- Select --</option>
            </select>
        </div>

        <div class="col-md-2">
            <label asp-for="Volume" class="form-label">Volume</label>
            <input asp-for="Volume" class="form-control form-control-sm" />
        </div>

        <div class="col-md-2">
            <label asp-for="VolumeUnitId" class="form-label">Vol. Unit</label>
            <select asp-for="VolumeUnitId" asp-items="Model.VolumeUnits" class="form-select form-select-sm">
                <option value="">-- Select --</option>
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="CargoCommodityId" class="form-label">Cargo Commodity</label>
            <select asp-for="CargoCommodityId" asp-items="Model.CargoCommodities" class="form-select form-select-sm">
