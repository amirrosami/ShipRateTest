    <input type="hidden" asp-for="BookingLegId" />
    <input type="hidden" asp-for="BLId" />
    <input type="hidden" asp-for="BLContainerId" />
    <input type="hidden" asp-for="RateRequestId" />
    <input type="hidden" asp-for="TransitShipmentAssignmentId" />

