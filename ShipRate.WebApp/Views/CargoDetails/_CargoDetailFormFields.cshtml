        @*<div class="col-md-3">
            <label asp-for="HSCodeToSave" class="form-label">HS Code</label>
            <input asp-for="HSCodeToSave" class="form-control form-control-sm" />
        </div> 
        *@
        <div class="col-md-3">
            <label asp-for="HSCodeToSave" class="form-label">HS Code</label>
            <input type="text"
                   id="HSCodeToSave"
                   name="HSCodeToSave"
                   value="@Model.HSCodeToSave"
                   class="form-control"
                   placeholder="Search HS Code..."
                   autocomplete="off"
                   hx-get="@Url.Action("SearchHSCodes", "HSCodes")"
                   hx-trigger="keyup changed delay:400ms"
                   hx-target="#hsCodeSearchResults"
                   hx-swap="innerHTML"
                   required
                   hx-vals='js:{
                            term: document.getElementById("HSCodeToSave").value,
                            targetTextInputId: "HSCodeToSave"
                       }' />

            <div id="hsCodeSearchResults"
                 class="position-relative">
            </div>
            <span asp-validation-for="HSCodeToSave" class="text-danger small"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="MarinePolutant" class="form-label">MarinePolutant</label>
            <input asp-for="MarinePolutant" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3">
            <label asp-for="MSDSPageNumber" class="form-label">MSDSPageNumber</label>
            <input asp-for="MSDSPageNumber" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3">
            <label asp-for="PSN" class="form-label">PSN</label>
            <input asp-for="PSN" class="form-control form-control-sm" />
        </div>

        @*         <div class="col-md-6">
            <label asp-for="CountryHSCodeId" class="form-label">Country HS Code</label>
            <select asp-for="CountryHSCodeId" asp-items="Model.CountryHSCodes" class="form-select form-select-sm">
                <option value="">-- Select --</option>
            </select>
        </div>
 *@
        <div class="col-md-4">
            <label asp-for="CargoDescription" class="form-label">Cargo Description</label>
            <textarea asp-for="CargoDescription" class="form-control form-control-sm" rows="2" required></textarea>
            <span asp-validation-for="CargoDescription" class="text-danger small"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="MarksAndNumbers" class="form-label">Marks And Numbers</label>
            <textarea asp-for="MarksAndNumbers" class="form-control form-control-sm" rows="1"></textarea>
        </div>

        <div class="col-md-4">
            <label asp-for="Remarks" class="form-label">Remarks</label>
            <textarea asp-for="Remarks" class="form-control form-control-sm" rows="1"></textarea>
        </div>

    </div>

    <!-- Compact Sections -->
    <div class="accordion" id="cargoDetailAccordion">

        <!-- Dimensions -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingDimensions">
                <button class="accordion-button collapsed" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapseDimensions"
                        aria-expanded="false"
                        aria-controls="collapseDimensions">
                    Dimensions
                </button>
            </h2>

            <div id="collapseDimensions"
                 class="accordion-collapse collapse"
                 aria-labelledby="headingDimensions"
                 data-bs-parent="#cargoDetailAccordion">

                <div class="accordion-body">
                    <div class="row g-2">

                        <div class="col-md-2">
                            <label asp-for="Length" class="form-label">Length</label>
                            <input asp-for="Length" class="form-control form-control-sm" />
                        </div>

                        <div class="col-md-2">
                            <label asp-for="Width" class="form-label">Width</label>
                            <input asp-for="Width" class="form-control form-control-sm" />
                        </div>

                        <div class="col-md-2">
                            <label asp-for="Height" class="form-label">Height</label>
                            <input asp-for="Height" class="form-control form-control-sm" />
                        </div>

                        <div class="col-md-3">
                            <label asp-for="DimensionUnitId" class="form-label">Dimension Unit</label>
                            <select asp-for="DimensionUnitId" asp-items="Model.DimensionUnits" class="form-select form-select-sm">
                                <option value="">-- Select --</option>
                            </select>
                        </div>

                        <div class="col-md-3 d-flex align-items-end">
                            <div class="form-check">
                                <input asp-for="IsOverSized" class="form-check-input" />
                                <label asp-for="IsOverSized" class="form-check-label">Over Sized</label>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- Dangerous Goods -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingDG">
                <button class="accordion-button collapsed" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapseDG"
                        aria-expanded="false"
                        aria-controls="collapseDG">
                    Dangerous Goods
                </button>
            </h2>

            <div id="collapseDG"
                 class="accordion-collapse collapse"
                 aria-labelledby="headingDG"
                 data-bs-parent="#cargoDetailAccordion">

                <div class="accordion-body" id="dgSection">
                    <div class="row g-2">

                        <div class="col-md-2 d-flex align-items-end">
                            <div class="form-check">
                                <input asp-for="IsDG" class="form-check-input" id="IsDG" />
                                <label asp-for="IsDG" class="form-check-label">Is DG</label>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="DGClassId" class="form-label">DG Class</label>
                            <select asp-for="DGClassId" asp-items="Model.DGClasses" class="form-select form-select-sm dg-field">
                                <option value="">-- Select --</option>
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label asp-for="UNNumber" class="form-label">UN No.</label>
                            <input asp-for="UNNumber" class="form-control form-control-sm dg-field" />
                        </div>

                        <div class="col-md-2">
                            <label asp-for="DGFlashPoint" class="form-label">Flash Point</label>
                            <input asp-for="DGFlashPoint" class="form-control form-control-sm dg-field" />
                        </div>

                        <div class="col-md-2">
                            <label asp-for="DGPackingGroupId" class="form-label">Packing Group</label>
                            <select asp-for="DGPackingGroupId" asp-items="Model.DGPackingGroups" class="form-select form-select-sm dg-field">
                                <option value="">-- Select --</option>
                            </select>
