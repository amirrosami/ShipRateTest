@using ShipRate.Application.ViewModels
@model CargoDetailDeleteVm

<div class="modal fade" id="cargoDetailModal" tabindex="-1" aria-hidden="true" dir="ltr">
    <div class="modal-dialog">
        <div class="modal-content">

            <form asp-action="DeleteConfirmed"
                  asp-controller="CargoDetails"
                  method="post"
                  hx-post="@Url.Action("DeleteConfirmed", "CargoDetails", new { id = Model.Id })"
                  hx-target="#cargoDetailsPanel"
                  hx-swap="outerHTML">

                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">Delete Cargo Detail</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body text-start">
                    <input type="hidden" name="id" value="@Model.Id" />

                    <p class="mb-2">
                        Are you sure you want to delete this cargo detail?
                    </p>

                    <div class="alert alert-warning mb-0">
                        <strong>Seq:</strong> @Model.Sequence
                        <br />
                        <strong>Description:</strong> @Model.CargoDescription
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" class="btn btn-danger">
                        Delete
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>
