@using ShipRate.Application.DTOs
@model DeliverProductRequestVm

<form hx-post="@Url.Action("Deliver")"
      hx-target="#modal-content"
      hx-swap="innerHTML"
      method="post">

    @Html.AntiForgeryToken()
    <input asp-for="Input.ProductRequestId" type="hidden" />

    <div class="modal-header">
        <h5 class="modal-title">Deliver Request From Inventory</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <div class="mb-3">
            <label class="form-label">Inventory</label>
            <select asp-for="Input.InventoryId" asp-items="Model.Inventories" class="form-select">
                <option value="">Select ...</option>
            </select>
        </div>
    </div>

    <div class="modal-footer justify-content-start">
        <button type="submit" class="btn btn-primary">Deliver</button>
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
    </div>
</form>
