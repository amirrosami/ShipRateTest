@model PagedResultDto<ProductStockTransactionListDto>
@{
    var totalPages = (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize);
    var startPage = Math.Max(1, Model.PageNumber - 2);
    var endPage = Math.Min(totalPages, Model.PageNumber + 2);
}

<div class="card" dir="ltr">
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th>Inventory</th>
                    <th>Product Code</th>
                    <th>Product</th>
                    <th>Type</th>
                    <th class="text-end">Quantity</th>
                    <th>Reference</th>
                    <th>Date</th>
                    <th>Remarks</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Items.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">No records found.</td>
                </tr>
            }
            else
            {
                foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.InventoryName</td>
                        <td>@item.ProductCode</td>
                        <td>@item.ProductName</td>
                        <td>@item.TransactionTypeName</td>
                        <td class="text-end">@item.Quantity.ToString("N2")</td>
                        <td>@item.Reference</td>
                        <td>@item.TransactionDate.ToString("yyyy-MM-dd")</td>
                        <td>@item.Remarks</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm">
            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                <a class="page-link"
                   hx-get="@Url.Action("Index", new { page = Model.PageNumber - 1, pageSize = Model.PageSize })"
                   hx-target="#transactionList">Previous</a>
            </li>

            @for (var pageno = startPage; pageno <= endPage; pageno++)
            {
                <li class="page-item @(pageno == Model.PageNumber ? "active" : "")">
                    <a class="page-link"
                       hx-get="@Url.Action("Index", new { pageno, pageSize = Model.PageSize })"
                       hx-target="#transactionList">@pageno</a>
@using ShipRate.Application.DTOs
                </li>
            }

            <li class="page-item @(Model.PageNumber >= totalPages ? "disabled" : "")">
                <a class="page-link"
                   hx-get="@Url.Action("Index", new { page = Model.PageNumber + 1, pageSize = Model.PageSize })"
                   hx-target="#transactionList">Next</a>
            </li>
        </ul>
    </nav>
}
