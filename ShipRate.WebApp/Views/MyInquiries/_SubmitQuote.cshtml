@using ShipRate.Application.ViewModels
@model SubmitQuoteVm
<form asp-action="SubmitQuote"
      method="post"
      hx-post="@Url.Action("SubmitQuote", "MyInquiries")"
      hx-target="#quoteModalContent"
      hx-swap="innerHTML">

    @Html.AntiForgeryToken()
    <input asp-for="RateRequestInquiryId" type="hidden" />
    <input asp-for="Id" type="hidden" />
    <input asp-for="VendorId" type="hidden" />

    <div class="modal-header">
        <h5 class="modal-title">Submit Quote</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body" style="max-height: 75vh; overflow-y: auto;">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="QuotationNo" class="form-label">Quotation No</label>
                <input asp-for="QuotationNo" class="form-control" />
                <span asp-validation-for="QuotationNo" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="QuotationDate" class="form-label">Quotation Date</label>
                <input asp-for="QuotationDate" type="date" class="form-control" />
                <span asp-validation-for="QuotationDate" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="CarrierId" class="form-label">Carrier</label>
                <select asp-for="CarrierId" asp-items="Model.CarrierOptions" class="form-select">
                    <option value="">Select carrier...</option>
                </select>
            </div>

            <div class="col-md-6">
                <label asp-for="CarrierName" class="form-label">Carrier Name</label>
                <input asp-for="CarrierName" class="form-control" />
                <span asp-validation-for="CarrierName" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="VendorId" class="form-label">Vendor</label>
                <select asp-for="VendorId" asp-items="Model.VendorOptions" class="form-select">
                    <option value="">Select Vendor...</option>
                </select>
            </div>

            <div class="col-md-6">
                <label asp-for="VendorName" class="form-label">Vendor Name</label>
                <input asp-for="VendorName" class="form-control" />
                <span asp-validation-for="VendorName" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="ValidUntil" class="form-label"></label>
                <input asp-for="ValidUntil" type="date" class="form-control" />
            </div>

            <div class="col-md-6">
                <label asp-for="ETD" class="form-label"></label>
                <input asp-for="ETD" type="date" class="form-control" onchange="calculateTransitDays()" oninput="calculateTransitDays()" />
            </div>

            <div class="col-md-6">
                <label asp-for="ETA" class="form-label"></label>
                <input asp-for="ETA" type="date" class="form-control" onchange="calculateTransitDays()" oninput="calculateTransitDays()" />
            </div>

            <div class="col-md-6">
                <label asp-for="TransitDays" class="form-label"></label>
                <input asp-for="TransitDays" class="form-control" readonly />
            </div>

            <div class="col-md-6 d-flex align-items-center pt-4">
                <div class="form-check">
                    <input asp-for="IsDirect" class="form-check-input" />
                    <label asp-for="IsDirect" class="form-check-label"></label>
                </div>
            </div>

            <div class="col-12">
                <label asp-for="OptionsServiceName" class="form-label">Service Name</label>
                <input asp-for="OptionsServiceName" class="form-control" />
            </div>

            <div class="col-md-6">
                <label asp-for="VehicleName" class="form-label">Vehicle Name</label>
                <input asp-for="VehicleName" class="form-control" />
            </div>

            <div class="col-md-6">
                <label asp-for="TransportMovementNo" class="form-label">Transport Movement No</label>
                <input asp-for="TransportMovementNo" class="form-control" />
            </div>

            <div class="col-12">
                <hr class="my-4" />
            </div>

            <div class="col-12" id="quote-items-editor">
                <partial name="_QuoteItemsEditor" model="Model" />
            </div>

            <div class="col-12">
                <label asp-for="Remarks" class="form-label">Remarks</label>
                <textarea asp-for="Remarks" class="form-control" rows="5"></textarea>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check2-circle"></i>   @(Model.Id == Guid.Empty ? "Submit Quote" : "Update")
        </button>
    </div>
</form>
<script>
    function calculateTransitDays() {
        const etd = document.getElementById("ETD");
        const eta = document.getElementById("ETA");
        const transitDays = document.getElementById("TransitDays");

        if (!etd || !eta || !transitDays) return;

        if (!etd.value || !eta.value) {
            transitDays.value = "";
            return;
        }

        const etdDate = new Date(`${etd.value}T00:00:00`);
        const etaDate = new Date(`${eta.value}T00:00:00`);

        const millisecondsPerDay = 1000 * 60 * 60 * 24;
        const days = Math.round((etaDate - etdDate) / millisecondsPerDay)+1;

        transitDays.value = days >= 0 ? days : "";
    }
    calculateTransitDays();
</script>