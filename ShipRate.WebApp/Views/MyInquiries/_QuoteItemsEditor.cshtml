@using ShipRate.Application.ViewModels
@model SubmitQuoteVm

<div id="quote-items-editor">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="mb-0">Quote Items</h6>

        <button type="button"
                class="btn btn-sm btn-outline-primary"
                hx-post="@Url.Action("AddQuoteItem", "MyInquiries")"
                hx-include="closest form"
                hx-target="#quote-items-editor"
                hx-swap="outerHTML">
            <i class="bi bi-plus-lg"></i>
            Add Item
        </button>
    </div>

    @if (Model.Items == null || !Model.Items.Any())
    {
        <div class="alert alert-secondary mb-0">
            No quote items added yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Charge Type</th>
                        <th>Container</th>
                        <th style="width:90px;">Qty</th>
                        <th style="width:130px;">Unit Rate</th>
                        <th style="width:140px;">Currency</th>
                        <th>Remarks</th>
                        <th style="width:130px;">Total</th>
                        <th style="width:60px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Items.Count; i++)
                    {
                        <partial name="_QuoteItemRow" model="new QuoteItemRowVm { Parent = Model, Index = i }" />
                    }
                </tbody>
            </table>
        </div>
    }
</div>
<script>
    document.addEventListener('input', function (event) {
        if (!event.target.classList.contains('quote-qty') &&
            !event.target.classList.contains('quote-rate')) {
            return;
        }

        const row = event.target.closest('tr');
        if (!row) return;

        const qtyInput = row.querySelector('.quote-qty');
        const rateInput = row.querySelector('.quote-rate');
        const totalInput = row.querySelector('.quote-total');

        if (!qtyInput || !rateInput || !totalInput) return;

        const qty = parseFloat(qtyInput.value) || 0;
        const rate = parseFloat(rateInput.value) || 0;
        const total = qty * rate;

        totalInput.value = total.toFixed(2);
    });
</script>
