@using ShipRate.WebApp.ViewModels.MyInquiriesIndexVMs.cs
@model MyInquiryDetailsVM
@{
    ViewData["Title"] = "Inquiry Details";
}

<div class="container mt-4" dir="ltr">

    <h2>Inquiry Details</h2>

    <div class="card mb-4">
        <div class="card-body">

            <h5>General Information</h5>
            <hr />

            <div class="row mb-3">
                <div class="col-md-4"><strong>Origin:</strong> @Model.Origin</div>
                <div class="col-md-4"><strong>Destination:</strong> @Model.Destination</div>
                <div class="col-md-4"><strong>Cargo:</strong> @Model.CargoType</div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4"><strong>Weight:</strong> @Model.Weight</div>
                <div class="col-md-4"><strong>Status:</strong> @Model.Status</div>
                <div class="col-md-4"><strong>Sent:</strong> @Model.SentDate.ToString("yyyy-MM-dd")</div>
            </div>

            <h5 class="mt-4">Transport Types</h5>
            <ul>
                @foreach (var t in Model.TransportTypes)
                {
                    <li>@t.Type</li>
                }
            </ul>

            <h5 class="mt-4">Packages</h5>
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Qty</th>
                        <th>L</th>
                        <th>W</th>
                        <th>H</th>
                        <th>Weight</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Packages)
                    {
                        <tr>
                            <td>@p.Type</td>
                            <td>@p.Quantity</td>
                            <td>@p.Length</td>
                            <td>@p.Width</td>
                            <td>@p.Height</td>
                            <td>@p.Weight</td>
                        </tr>
                    }
                </tbody>
            </table>

            <h5 class="mt-4">Containers</h5>
            <ul>
                @foreach (var c in Model.Containers)
                {
                    <li>@c.Type - Qty: @c.Quantity</li>
                }
            </ul>

        </div>
    </div>


    <!-- Existing Quote -->
    @if (Model.ExistingQuote != null)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h4>Submitted Quote</h4>
                <hr />

                <p><strong>Service:</strong> @Model.ExistingQuote.ServiceName</p>
                <p><strong>Vessel:</strong> @Model.ExistingQuote.VesselName</p>
                <p><strong>Voyage:</strong> @Model.ExistingQuote.VoyageNumber</p>

                <h5 class="mt-3">Quote Items</h5>
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Charge</th>
                            <th>Currency</th>
                            <th>Container</th>
                            <th>Unit Rate</th>
                            <th>Total</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ExistingQuote.Items)
                        {
                            <tr>
                                <td>@item.ChargeType</td>
                                <td>@item.Currency</td>
                                <td>@item.ContainerType</td>
                                <td>@item.UnitRate</td>
                                <td>@item.TotalAmount</td>
                                <td>@item.Remarks</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }


    <!-- Submit New Quote -->
    @if (Model.ExistingQuote == null)
    {
        <div class="card" id="respond">
            <div class="card-body">
                <h4>Submit Quote</h4>
                <hr />

                <form method="post" action="/MyInquiries/SubmitQuote">
                    <input type="hidden" name="InquiryId" value="@Model.InquiryId" />

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label>Service Name</label>
                            <input class="form-control" name="ServiceName" required />
                        </div>

                        <div class="col-md-4">
                            <label>Vessel Name</label>
                            <input class="form-control" name="VesselName" />
                        </div>

                        <div class="col-md-4">
                            <label>Voyage Number</label>
                            <input class="form-control" name="VoyageNumber" />
                        </div>
                    </div>

                    <h5 class="mt-3">Quote Items</h5>
                    <div id="items"></div>

                    <button type="button" onclick="addItem()" class="btn btn-secondary mt-2">
                        Add Item
                    </button>

                    <div class="mt-4">
                        <button class="btn btn-success">Submit Quote</button>
                    </div>

                </form>
            </div>
        </div>
    }
</div>

<script>
    function addItem() {
        let html = `
            <div class="border p-3 mt-3">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label>Charge Type</label>
                        <input name="Items[0].ChargeTypeId" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label>Currency</label>
                        <input name="Items[0].CurrencyId" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label>Container</label>
                        <input name="Items[0].RateRequestContainerId" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label>Unit Rate</label>
                        <input name="Items[0].UnitRate" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label>Total</label>
                        <input name="Items[0].TotalAmount" class="form-control" />
                    </div>
                </div>
            </div>
        `;

        document.getElementById("items").insertAdjacentHTML("beforeend", html);
    }
</script>
