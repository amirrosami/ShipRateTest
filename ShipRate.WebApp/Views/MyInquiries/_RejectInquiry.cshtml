@using ShipRate.Application.ViewModels
@model RejectInquiryVm

<form asp-action="RejectInquiry"
      method="post"
      hx-post="@Url.Action("RejectInquiry")"
      hx-target="#vendorQuoteResponseGrid"
      hx-swap="innerHTML">

    @Html.AntiForgeryToken()
    <input asp-for="RateRequestInquiryId" type="hidden" />

    <div class="modal-header">
        <h5 class="modal-title text-danger">Reject Inquiry</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="alert alert-warning">
            Are you sure you want to reject this inquiry?
        </div>

        <div class="mb-3">
            <label asp-for="Reason" class="form-label"></label>
            <textarea asp-for="Reason" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Reason" class="text-danger"></span>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">
            <i class="bi bi-x-circle"></i> Reject Inquiry
        </button>
    </div>
</form>
