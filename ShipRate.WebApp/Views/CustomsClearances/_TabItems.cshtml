@using ShipRate.Application.ViewModels
@model CustomsClearanceItemsTabVm

<div id="items-tab"
     hx-get="@Url.Action("GetItemsTab", "CustomsClearance", new { id = Model.CustomsClearanceId })"
     hx-trigger="customsClearanceItemsChanged from:body"
     hx-swap="outerHTML">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h5 class="mb-1">Items / Cargo</h5>
            <p class="text-muted mb-0">Manage customs declaration item lines.</p>
        </div>

        <button type="button"
                class="btn btn-primary"
                hx-get="@Url.Action("CreateItemModal", "CustomsClearance", new { customsClearanceId = Model.CustomsClearanceId })"
                hx-target="#modal-container"
                hx-swap="innerHTML">
            <i class="bi bi-plus-lg me-1"></i>
            Add Item
        </button>
    </div>

    @if (Model.Items.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 80px;">Seq</th>
                                <th style="width: 160px;">HS Code</th>
                                <th>Description</th>
                                <th style="width: 120px;" class="text-end">Qty</th>
                                <th style="width: 140px;">Unit</th>
                                <th style="width: 140px;" class="text-end">Unit Price</th>
                                <th style="width: 120px;">Currency</th>
                                <th style="width: 160px;" class="text-end">Total Value</th>
                                <th style="width: 160px;" class="text-end">Duties</th>
                                <th style="width: 140px;" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.ItemSequence</td>
                                    <td>@item.HSCodeToSave</td>
                                    <td>
                                        <div class="fw-semibold">@item.GoodsDescriptionEN</div>
                                        @if (!string.IsNullOrWhiteSpace(item.GoodsDescriptionLocal))
                                        {
                                            <div class="text-muted small">@item.GoodsDescriptionLocal</div>
                                        }
                                    </td>
                                    <td class="text-end">@item.Quantity?.ToString("N2")</td>
                                    <td>@item.MeasurementUnitName</td>
                                    <td class="text-end">@item.UnitPrice?.ToString("N2")</td>
                                    <td>@item.CurrencyCode</td>
                                    <td class="text-end">@item.TotalValue?.ToString("N2")</td>
                                    <td class="text-end">@item.TotalDutiesItem.ToString("N2")</td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button"
                                                    class="btn btn-outline-secondary"
                                                    title="Edit"
                                                    hx-get="@Url.Action("EditItemModal", "CustomsClearance", new { id = item.Id })"
                                                    hx-target="#modal-container"
                                                    hx-swap="innerHTML">
                                                <i class="bi bi-pencil"></i>
                                            </button>

                                            <form method="post"
                                                  action="@Url.Action("DeleteItem", "CustomsClearance", new { id = item.Id })"
                                                  class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn btn-outline-danger"
                                                        title="Delete"
                                                        hx-post="@Url.Action("DeleteItem", "CustomsClearance", new { id = item.Id })"
                                                        hx-confirm="Are you sure you want to delete this item?"
                                                        hx-swap="none">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <th colspan="3" class="text-end">Totals</th>
                                <th class="text-end">@Model.Items.Sum(x => x.Quantity ?? 0).ToString("N2")</th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th class="text-end">@Model.Items.Sum(x => x.TotalValue ?? 0).ToString("N2")</th>
                                <th class="text-end">@Model.Items.Sum(x => x.TotalDutiesItem).ToString("N2")</th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="border rounded-3 p-5 text-center bg-light">
            <i class="bi bi-box-seam fs-1 text-muted"></i>
            <h6 class="mt-3 mb-1">No items added yet</h6>
            <p class="text-muted mb-3">Start by adding the first goods/item line for this declaration.</p>

            <button type="button"
                    class="btn btn-primary"
                    hx-get="@Url.Action("CreateItemModal", "CustomsClearance", new { customsClearanceId = Model.CustomsClearanceId })"
                    hx-target="#modal-container"
                    hx-swap="innerHTML">
                <i class="bi bi-plus-lg me-1"></i>
                Add First Item
            </button>
        </div>
    }
</div>
