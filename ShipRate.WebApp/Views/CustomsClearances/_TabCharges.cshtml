@using ShipRate.Application.ViewModels
@model CustomsClearanceChargesTabVm


<div id="charges-tab"
     hx-get="@Url.Action("GetChargesTab", "CustomsClearance", new { id = Model.CustomsClearanceId })"
     hx-trigger="customsClearanceChargesChanged from:body"
     hx-swap="outerHTML">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h5 class="mb-1">Charges</h5>
            <p class="text-muted mb-0">Manage file-level and item-level charges.</p>
        </div>

        <button type="button"
                class="btn btn-primary"
                hx-get="@Url.Action("CreateChargeModal", "CustomsClearance", new { customsClearanceId = Model.CustomsClearanceId })"
                hx-target="#modal-container"
                hx-swap="innerHTML">
            <i class="bi bi-plus-lg me-1"></i>
            Add Charge
        </button>
    </div>

    @if (Model.Charges.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Type</th>
                                <th>Description</th>
                                <th>Related Item</th>
                                <th class="text-end">Amount</th>
                                <th>Currency</th>
                                <th class="text-end">Rate</th>
                                <th class="text-end">Local Amount</th>
                                <th>Flags</th>
                                <th>Payment</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Charges)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.ChargeTypeName</td>
                                    <td>@item.ChargeDescription</td>
                                    <td>@item.ItemReference</td>
                                    <td class="text-end">@item.Amount.ToString("N2")</td>
                                    <td>@item.CurrencyName</td>
                                    <td class="text-end">@item.ExchangeRate.ToString("N4")</td>
                                    <td class="text-end">@item.LocalAmount.ToString("N2")</td>
                                    <td>
                                        @if (item.IsTax)
                                        {
                                            <span class="badge bg-warning text-dark me-1">Tax</span>
                                        }
                                        @if (item.IsSystemCalculated)
                                        {
                                            <span class="badge bg-secondary me-1">System</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.IsPaid)
                                        {
                                            <span class="badge bg-success">Paid</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark">Unpaid</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button"
                                                    class="btn btn-outline-secondary"
                                                    title="Edit"
                                                    @(item.IsSystemCalculated ? "disabled" : null)
                                                    hx-get="@Url.Action("EditChargeModal", "CustomsClearance", new { id = item.Id })"
                                                    hx-target="#modal-container"
                                                    hx-swap="innerHTML">
                                                <i class="bi bi-pencil"></i>
                                            </button>

                                            <form method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn btn-outline-danger"
                                                        title="Delete"
                                                        @(item.IsSystemCalculated ? "disabled" : null)
                                                        hx-post="@Url.Action("DeleteCharge", "CustomsClearance", new { id = item.Id })"
                                                        hx-confirm="Are you sure you want to delete this charge?"
                                                        hx-swap="none">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <th colspan="6" class="text-end">Total Local Amount</th>
                                <th class="text-end">@Model.Charges.Sum(x => x.LocalAmount).ToString("N2")</th>
                                <th colspan="3"></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="border rounded-3 p-5 text-center bg-light">
            <i class="bi bi-cash-stack fs-1 text-muted"></i>
            <h6 class="mt-3 mb-1">No charges added yet</h6>
            <p class="text-muted mb-3">Add the first file-level or item-level charge.</p>

            <button type="button"
                    class="btn btn-primary"
                    hx-get="@Url.Action("CreateChargeModal", "CustomsClearance", new { customsClearanceId = Model.CustomsClearanceId })"
                    hx-target="#modal-container"
                    hx-swap="innerHTML">
                <i class="bi bi-plus-lg me-1"></i>
                Add First Charge
            </button>
        </div>
    }
</div>
