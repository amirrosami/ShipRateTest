@using ShipRate.Application.ViewModels
@model CustomsClearanceLicensesTabVm

<div id="licenses-tab"
     hx-get="@Url.Action("GetLicensesTab", "CustomsClearance", new { id = Model.CustomsClearanceId })"
     hx-trigger="customsClearanceLicensesChanged from:body"
     hx-swap="outerHTML">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h5 class="mb-1">Licenses / Permits</h5>
            <p class="text-muted mb-0">Manage permits, approvals, and license validity for this customs clearance.</p>
        </div>

        @if (Model.CanEdit)
        {
            <button type="button"
                    class="btn btn-primary"
                    hx-get="@Url.Action("CreateLicenseModal", "CustomsClearance", new { customsClearanceId = Model.CustomsClearanceId })"
                    hx-target="#modal-container"
                    hx-swap="innerHTML">
                <i class="bi bi-plus-lg me-1"></i>
                Add License
            </button>
        }
    </div>

    @if (Model.Licenses.Any())
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Type</th>
                        <th>License No</th>
                        <th>Issuing Organization</th>
                        <th>Issue Date</th>
                        <th>Expiry Date</th>
                        <th>Status</th>
                        <th>Validity</th>
                        <th>Remarks</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Licenses)
                    {
                        string validityBadgeClass;
                        string validityText;

                        if (item.IsExpired)
                        {
                            validityBadgeClass = "bg-danger";
                            validityText = "Expired";
                        }
                        else if (item.IsExpiringSoon)
                        {
                            validityBadgeClass = "bg-warning text-dark";
                            validityText = $"Expiring in {item.DaysToExpiry} day(s)";
                        }
                        else
                        {
                            validityBadgeClass = "bg-success";
                            validityText = $"Valid ({item.DaysToExpiry} day(s))";
                        }

                        <tr>
                            <td class="fw-semibold">@item.LicenseTypeName</td>
                            <td>@(string.IsNullOrWhiteSpace(item.LicenseNumber) ? "-" : item.LicenseNumber)</td>
                            <td>@(string.IsNullOrWhiteSpace(item.IssuingOrganization) ? "-" : item.IssuingOrganization)</td>
                            <td>@item.IssueDate.ToString("yyyy-MM-dd")</td>
                            <td>@item.ExpiryDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <span class="badge bg-light text-dark">@item.LicenseStatusName</span>
                            </td>
                            <td>
                                <span class="badge @validityBadgeClass">@validityText</span>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(item.Remarks) ? "-" : item.Remarks)</td>
                            <td class="text-end">
                                @if (item.CanEdit)
                                {
                                    <div class="btn-group btn-group-sm">
                                        <button type="button"
                                                class="btn btn-outline-primary"
                                                hx-get="@Url.Action("EditLicenseModal", "CustomsClearance", new { id = item.Id })"
                                                hx-target="#modal-container"
                                                hx-swap="innerHTML">
                                            <i class="bi bi-pencil"></i>
                                        </button>

                                        <form hx-post="@Url.Action("DeleteLicense", "CustomsClearance", new { id = item.Id })"
                                              hx-confirm="Are you sure you want to delete this license?"
                                              hx-target="#licenses-tab"
                                              hx-swap="outerHTML"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">Locked</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="border rounded-3 p-5 text-center bg-light">
            <i class="bi bi-shield-check fs-1 text-muted"></i>
            <h6 class="mt-3 mb-1">No licenses added</h6>
            <p class="text-muted mb-0">Add permits and licenses required for customs clearance processing.</p>
        </div>
    }
</div>
