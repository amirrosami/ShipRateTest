@using ShipRate.Application.ViewModels
@model CustomsClearanceContainersTabVm

<div id="containers-tab"
     hx-get="@Url.Action("GetContainersTab", "CustomsClearance", new { id = Model.CustomsClearanceId })"
     hx-trigger="customsClearanceContainersChanged from:body"
     hx-swap="outerHTML">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h5 class="mb-1">Containers</h5>
            <p class="text-muted mb-0">Manage container lines for this customs clearance.</p>
        </div>

        <button type="button"
                class="btn btn-primary"
                hx-get="@Url.Action("CreateContainerModal", "CustomsClearance", new { customsClearanceId = Model.CustomsClearanceId })"
                hx-target="#modal-container"
                hx-swap="innerHTML">
            <i class="bi bi-plus-lg me-1"></i>
            Add Container
        </button>
    </div>

    @if (Model.Containers.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 180px;">Container No</th>
                                <th style="width: 140px;">Size / Type</th>
                                <th style="width: 140px;">Seal No</th>
                                <th style="width: 160px;">Package Type</th>
                                <th style="width: 140px;" class="text-end">Gross Wt. (Kg)</th>
                                <th style="width: 140px;" class="text-end">Net Wt. (Kg)</th>
                                <th>Remarks</th>
                                <th style="width: 140px;" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Containers)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.ContainerNo</td>
                                    <td>@item.ContainerSizeTypeName</td>
                                    <td>@item.SealNo</td>
                                    <td>@item.PackageTypeName</td>
                                    <td class="text-end">@item.GrossWeightKg.ToString("N2")</td>
                                    <td class="text-end">@item.NetWeightKg.ToString("N2")</td>
                                    <td>@item.Remarks</td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button"
                                                    class="btn btn-outline-secondary"
                                                    title="Edit"
                                                    hx-get="@Url.Action("EditContainerModal", "CustomsClearance", new { id = item.Id })"
                                                    hx-target="#modal-container"
                                                    hx-swap="innerHTML">
                                                <i class="bi bi-pencil"></i>
                                            </button>

                                            <form method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn btn-outline-danger"
                                                        title="Delete"
                                                        hx-post="@Url.Action("DeleteContainer", "CustomsClearance", new { id = item.Id })"
                                                        hx-confirm="Are you sure you want to delete this container?"
                                                        hx-swap="none">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <th colspan="4" class="text-end">Totals</th>
                                <th class="text-end">@Model.Containers.Sum(x => x.GrossWeightKg).ToString("N2")</th>
                                <th class="text-end">@Model.Containers.Sum(x => x.NetWeightKg).ToString("N2")</th>
                                <th colspan="2"></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="border rounded-3 p-5 text-center bg-light">
            <i class="bi bi-box2 fs-1 text-muted"></i>
            <h6 class="mt-3 mb-1">No containers added yet</h6>
            <p class="text-muted mb-3">Add the first container linked to this customs clearance.</p>

            <button type="button"
                    class="btn btn-primary"
                    hx-get="@Url.Action("CreateContainerModal", "CustomsClearance", new { customsClearanceId = Model.CustomsClearanceId })"
                    hx-target="#modal-container"
                    hx-swap="innerHTML">
                <i class="bi bi-plus-lg me-1"></i>
                Add First Container
            </button>
        </div>
    }
</div>
