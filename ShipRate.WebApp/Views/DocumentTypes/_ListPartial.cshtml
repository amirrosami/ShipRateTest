@using ShipRate.Application.DTOs
@using ShipRate.Application.DTOs.Documents
@model PagedResultDto<DocumentTypeListDto>

<div class="table-responsive w-100 document-type-grid-wrapper">
    <table class="table table-hover table-striped align-middle mb-0 document-type-grid">
        <thead class="table-primary">
            <tr>
                <th class="ps-4">Document Type Name</th>
                <th>Document Type Local Name</th>
                <th>Category</th>
                <th>System Defined</th>
                <th>Has Expiry Date</th>
                <th>Alarm Days B.Exp.</th>
                <th>Create User</th>
                <th>Created At</th>
                <th>Update User</th>
                <th>Updated At</th>
                <th class="text-end pe-4">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items != null && Model.Items.Any())
            {
                foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="ps-4 fw-semibold text-secondary">
                            @item.DocumentTypeName
                        </td>

                        <td class="fw-semibold text-secondary">
                            @(string.IsNullOrWhiteSpace(item.DocumentTypeLocalName) ? "-" : item.DocumentTypeLocalName)
                        </td>

                        <td>
                            <span class="badge bg-secondary opacity-75">
                                @item.CategoryName
                            </span>
                        </td>

                        <td>
                            @if (item.SystemDefined)
                            {
                                <span class="text-success">
                                    <i class="bi bi-check-circle-fill"></i> System
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    <i class="bi bi-person-fill"></i> User
                                </span>
                            }
                        </td>

                        <td>
                            @if (item.HasExpiryDate)
                            {
                                <span class="text-primary">
                                    <i class="bi bi-calendar-check"></i> Yes
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">No</span>
                            }
                        </td>

                        <td>
                            @(item.HasExpiryDate ? $"{item.AlarmDaysBeforeExpire} Days" : "-")
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(item.CreateUserName) ? "-" : item.CreateUserName)
                        </td>

                        <td>
                            @(item.CreatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(item.UpdateUserName) ? "-" : item.UpdateUserName)
                        </td>

                        <td>
                            @(item.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")
                        </td>

                        <td class="text-end pe-4">
                            @if (!item.SystemDefined)
                            {
                                <div class="d-flex justify-content-end gap-1">
                                    <button type="button"
                                            class="btn btn-outline-secondary btn-sm"
                                            hx-get="@Url.Action("Edit", new { id = item.Id })"
                                            hx-target="#modal-container"
                                            data-bs-toggle="modal"
                                            data-bs-target="#actionModal">
                                        <i class="bi bi-pencil"></i> Edit
                                    </button>

                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm"
                                            hx-get="@Url.Action("Delete", new { id = item.Id })"
                                            hx-target="#modal-container"
                                            data-bs-toggle="modal"
                                            data-bs-target="#actionModal">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted small">
                                    <i class="bi bi-lock-fill"></i> Locked
                                </span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="11" class="text-center py-5 text-muted">
                        No records found matching current criteria.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3 border-top-0">
        <span class="text-muted small">
            Showing Page <strong>@Model.PageNumber</strong> of <strong>@Model.TotalPages</strong>
        </span>

        <nav aria-label="Page navigation">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                    <button type="button"
                            class="page-link"
                            hx-get="@Url.Action("Index", new { searchTerm = ViewData["SearchTerm"], pageNumber = Model.PageNumber - 1 })"
                            hx-target="#list-container"
                            @(Model.PageNumber == 1 ? "disabled" : null)>
                        Previous
                    </button>
                </li>

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                        <button type="button"
                                class="page-link"
                                hx-get="@Url.Action("Index", new { searchTerm = ViewData["SearchTerm"], pageNumber = i })"
                                hx-target="#list-container">
                            @i
                        </button>
                    </li>
                }

                <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                    <button type="button"
                            class="page-link"
                            hx-get="@Url.Action("Index", new { searchTerm = ViewData["SearchTerm"], pageNumber = Model.PageNumber + 1 })"
                            hx-target="#list-container"
                            @(Model.PageNumber == Model.TotalPages ? "disabled" : null)>
                        Next
                    </button>
                </li>
            </ul>
        </nav>
    </div>
}


<style>
    .document-type-grid-wrapper {
        width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
    }

    .document-type-grid {
        min-width: 1400px; /* با توجه به تعداد ستون‌ها */
        white-space: nowrap;
    }

    .document-type-grid th,
    .document-type-grid td {
        vertical-align: middle;
        white-space: nowrap;
    }
</style>
