@using ShipRate.WebApp.ViewModels.CustomersVms
@model LostReasonCategoryListViewModel

<link href="~/css/lost-reasons.css" rel="stylesheet" />

<div class="lr-page container-fluid">
    <!-- Page Header -->
    <div class="lr-page-header">
        <div class="lr-page-title">
            <i class="bi bi-x-octagon"></i>
            <div>
                <h1>Customer Loss Reasons</h1>
                <p>Manage categories and reasons for losing customers</p>
            </div>
        </div>
    </div>

    <!-- Cascading Grid Layout -->
    <div class="lr-cascade">
        <!-- LEFT: Categories -->
        <div class="lr-panel lr-panel-categories">
            <div class="lr-panel-header">
                <h3><i class="fas fa-folder-open"></i>Categories</h3>
                <button class="btn btn-primary"
                        hx-get="/LostReasons/CreateCategory"
                        hx-target="#modal-body"
                        hx-swap="innerHTML"
                        onclick="document.getElementById('lr-modal').classList.add('active')">
                    <i class="fas fa-plus"></i> New
                </button>
            </div>
            <div id="category-grid"
                 hx-get="/LostReasons/CategoryGrid"
                 hx-trigger="load, categoryChanged from:body"
                 hx-swap="innerHTML">
                <div class="lr-loading"><i class="fas fa-spinner fa-spin"></i> Loading...</div>
            </div>
        </div>

        <!-- RIGHT: Reasons -->
        <div class="lr-panel lr-panel-reasons">
            <div class="lr-panel-header">
                <h3><i class="fas fa-list-ul"></i> <span id="reason-panel-title">Reasons</span></h3>
                <button id="btn-add-reason"
                        class="btn btn-primary"
                        style="display:none"
                        hx-target="#modal-body"
                        hx-swap="innerHTML"
                        onclick="document.getElementById('lr-modal').classList.add('active')">
                    <i class="fas fa-plus"></i> New
                </button>
            </div>
            <div id="reason-grid">
                <div class="lr-empty-state">
                    <i class="fas fa-arrow-left"></i>
                    <p>Select a category to view its reasons</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div id="lr-modal" class="lr-modal">
    <div class="lr-modal-backdrop"
         onclick="document.getElementById('lr-modal').classList.remove('active')"></div>
    <div class="lr-modal-content">
        <div class="lr-modal-header">
            <h2 id="modal-title">Form</h2>
            <button class="lr-modal-close"
                    onclick="document.getElementById('lr-modal').classList.remove('active')">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div id="modal-body" class="lr-modal-body">
        </div>
    </div>
</div>
