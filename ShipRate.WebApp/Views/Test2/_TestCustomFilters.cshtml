@using ShipRate.WebApp.ViewModels
@model dynamic

<div class="col-auto">

    <input type="text"
           name="Name"
           value="@Model.Name"
           class="form-control"
           placeholder="Name..."
           hx-post="@Url.Action("List","Test2")"
           hx-trigger="keyup changed delay:400ms"
           hx-target="#table-container"
           hx-swap="innerHTML"
           hx-include="#grid-filters, #table-sort-info" />
</div>
