@using ShipRate.Application.DTOs.ApiIr
@model CompanyInfoLookupVm

<div class="modal-header">
    <h5 class="modal-title">استعلام اطلاعات شرکت از API.ir</h5>

    <button type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"></button>
</div>

<div class="modal-body">
    <form hx-post="@Url.Action("CompanyInfo", "ApiIr")"
          hx-target="#apiIrModalBody"
          hx-swap="innerHTML"
          hx-indicator="#apiIrLoading"
          class="row g-3">

        @Html.AntiForgeryToken()

        <div class="col-12">
            <label asp-for="NationalId" class="form-label">شناسه ملی شرکت</label>

            <input asp-for="NationalId"
                   class="form-control ltr text-start"
                   inputmode="numeric"
                   autocomplete="off"
                   maxlength="11"
                   placeholder="" />

            <span asp-validation-for="NationalId"
                  class="text-danger small"></span>
        </div>

        <div class="col-12 d-flex gap-2 align-items-center">
            <button type="submit" class="btn btn-primary">
                <span id="apiIrLoading"
                      class="htmx-indicator spinner-border spinner-border-sm me-2"
                      role="status"
                      aria-hidden="true"></span>
                استعلام
            </button>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger mt-3 mb-0">
            @Model.ErrorMessage
        </div>
    }

    @if (Model.Result?.Data is not null)
    {
        var company = Model.Result.Data;

        <div class="card mt-3 border-0 shadow-sm">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <strong>نتیجه استعلام شرکت</strong>

                @if (company.Active == true)
                {
                    <span class="badge text-bg-success">فعال</span>
                }
                else
                {
                    <span class="badge text-bg-secondary">غیرفعال</span>
                }
            </div>

            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="text-muted small">نام شرکت</div>
                        <div class="fw-semibold">@company.Name</div>
                    </div>

                    <div class="col-md-6">
                        <div class="text-muted small">نوع شرکت</div>
                        <div class="fw-semibold">@company.CompanyType</div>
                    </div>

                    <div class="col-md-6">
                        <div class="text-muted small">شناسه ملی</div>
                        <div class="fw-semibold ltr text-start">
                            @company.NationalId
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="text-muted small">شماره ثبت</div>
                        <div class="fw-semibold ltr text-start">
                            @company.RegisterNumber
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="text-muted small">تاریخ ثبت</div>
                        <div class="fw-semibold ltr text-start">
                            @company.RegisterDate
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="text-muted small">کد پستی</div>
                        <div class="fw-semibold ltr text-start">
                            @company.PostalCode
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="text-muted small">استان</div>
                        <div class="fw-semibold">@company.Province</div>
                    </div>

                    <div class="col-md-6">
                        <div class="text-muted small">شهر</div>
                        <div class="fw-semibold">@company.City</div>
                    </div>

                    <div class="col-12">
                        <div class="text-muted small">آدرس</div>
                        <div class="fw-semibold">@company.Address</div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(company.EndDate))
                    {
                        <div class="col-md-6">
                            <div class="text-muted small">تاریخ پایان</div>
                            <div class="fw-semibold ltr text-start">
                                @company.EndDate
                            </div>
                        </div>
                    }
                </div>

                <hr />

                <div class="small text-muted">
                    <div>Success: @Model.Result.Success</div>
                    <div>Code: @Model.Result.Code</div>

                    @if (!string.IsNullOrWhiteSpace(Model.Result.Message))
                    {
                        <div>Message: @Model.Result.Message</div>
                    }
                </div>
            </div>
        </div>
    }
</div>
