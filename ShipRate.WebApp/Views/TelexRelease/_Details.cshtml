@using ShipRate.Application.ViewModels
@model TelexReleaseDetailsViewModel

<div class="row g-3">
    <div class="col-md-6"><strong>BL No:</strong> @Model.BLNo</div>
    <div class="col-md-6"><strong>Status:</strong> @Model.StatusName</div>
    <div class="col-md-6"><strong>Company:</strong> @Model.CompanyName</div>
    <div class="col-md-6"><strong>Customer:</strong> @Model.CustomerName</div>
    <div class="col-md-6"><strong>Shipping Line:</strong> @Model.CarrierName</div>
    <div class="col-md-6"><strong>Line/Forwarder Type:</strong> @Model.LineForwarderTypeName</div>
    <div class="col-md-6"><strong>Request Date:</strong> @Model.RequestDate.ToString("yyyy-MM-dd HH:mm")</div>
    <div class="col-md-6"><strong>Approval Date:</strong> @(Model.ApprovalDate?.ToString("yyyy-MM-dd HH:mm"))</div>
    <div class="col-md-6"><strong>Completed At:</strong> @(Model.CompletedAt?.ToString("yyyy-MM-dd HH:mm"))</div>
    <div class="col-md-12"><strong>Remarks:</strong> @Model.Remarks</div>
    <div class="col-md-6"><strong>Active:</strong> @(Model.IsActive ? "Yes" : "No")</div>
    <div class="col-md-6"><strong>Created At:</strong> @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
</div>
<div class="mt-4 text-end">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
</div>
