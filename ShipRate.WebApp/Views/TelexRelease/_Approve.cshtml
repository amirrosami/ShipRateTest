@using ShipRate.Application.ViewModels
@model TelexReleaseCreateEditViewModel

<form hx-post="@Url.Action("ApproveConfirmed", "TelexRelease", new { id = Model.Id })"
      hx-target="#modalBody"
      hx-swap="innerHTML">
    @Html.AntiForgeryToken()

    <div class="alert alert-success">
        Are you sure you want to Approve this request?
    </div>

    <div class="mb-3">
        <strong>BL No:</strong> @Model.BLNo
    </div>
    <div class="mb-3">
        <strong>Request No:</strong> @Model.RequestNo
    </div>
    <div class="mb-3">
        <strong>Request Date:</strong> @Model.RequestDate.ToString("yyyy-MM-dd HH:mm")
    </div>

    <div class="mt-4 text-end">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-success">Approve</button>
    </div>
</form>
