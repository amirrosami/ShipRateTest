@using ShipRate.Application.JobsViewModels
@model ChargeDeleteVm

<div class="modal fade" id="chargeDetailModal" tabindex="-1" aria-hidden="true" dir="ltr">
    <div class="modal-dialog">
        <div class="modal-content">

            <form asp-action="DeleteChargeConfirmed"
                  asp-controller="Jobs"
                  method="post"
                  hx-post="@Url.Action("DeleteChargeConfirmed", "Jobs", new { chargeid = Model.Id,jobId=Model.JobId }   )"
                  hx-target="body"
                  hx-swap="beforeend">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">Delete Charge</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body text-start">
                    <input type="hidden" name="id" value="@Model.Id" />

                    <p class="mb-2">
                        Are you sure you want to delete this Charge?
                    </p>

                    <div class="alert alert-warning mb-0">
                        <strong>Description:</strong> @Model.ChargeDescription
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" class="btn btn-danger">
                        Delete
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>
