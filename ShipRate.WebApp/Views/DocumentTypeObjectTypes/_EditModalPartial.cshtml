@using ShipRate.Application.DTOs.Documents
@model DocumentTypeObjectTypeInputDto

<div class="modal-content text-start" dir="ltr">
    <div class="modal-header">
        <h5 class="modal-title fw-bold">Edit Mapping for [@ViewData["SelectedObjectName"]]</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <form hx-post="@Url.Action("Edit")" hx-target="#modal-container" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ObjectTypeId" />
        <div class="modal-body">
            <div class="mb-3">
                <label asp-for="DocumentTypeId" class="form-label fw-semibold">Select Document Type</label>
                <select asp-for="DocumentTypeId" asp-items="@ViewBag.DocumentTypes" class="form-select"></select>
                <span asp-validation-for="DocumentTypeId" class="text-danger small"></span>
            </div>
        </div>
        <div class="modal-footer bg-light">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary btn-sm">Update Mapping</button>
        </div>
    </form>
</div>
