@using ShipRate.WebApp.ViewModels.FinanceVms
@model List<CostCenterVM>

@{
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int totalCount = ViewBag.TotalCount;
    string? search = ViewBag.Search;
}

<!-- amamamamam Record Count amamamamam -->
<div class="d-flex justify-content-between align-items-center mb-2">
    <small class="text-muted">
        Total: <strong>@totalCount</strong> record(s)
        @if (!string.IsNullOrWhiteSpace(search))
        {
            <span> — filtered by "<em>@search</em>"</span>
        }
    </small>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-warning text-center py-4">
        <i class="bi bi-info-circle me-1"></i> No records found.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-hover table-striped align-middle mb-0">
            <thead class="table-primary">
                <tr>
                    <th style="width:50px;">#</th>
                    <th>Code</th>
                    <th>Title</th>
                    <th>Company</th>
                    <th style="width:90px;" class="text-center">Active</th>
                    <th style="width:130px;" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rowNum = (currentPage - 1) * 10;
                }
                @foreach (var item in Model)
                {
                    rowNum++;
                    <tr>
                        <td class="text-muted">@rowNum</td>
                        <td><code>@item.Code</code></td>
                        <td>@item.Title</td>
                        <td>@item.CompanyName</td>
                        <td class="text-center">
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        </td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-primary me-1"
                                    title="Edit"
                                    hx-get="/CostCenter/Edit/@item.Id"
                                    hx-target="#modalBody"
                                    hx-swap="innerHTML"
                                    onclick="document.getElementById('crudModalLabel').textContent='Edit Cost Center'; new bootstrap.Modal(document.getElementById('crudModal')).show();">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger btn-delete"
                                    title="Delete"
                                    hx-delete="/CostCenter/Delete/@item.Id"
                                    hx-target="#gridContainer"
                                    hx-swap="innerHTML">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- amamamamam Pagination amamamamam -->
    @if (totalPages > 1)
    {
        <nav class="mt-3 d-flex justify-content-center">
            <ul class="pagination pagination-sm mb-0">

                <!-- Previous -->
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link"
                       href="#"
                       hx-get="/CostCenter/Grid?search=@(Uri.EscapeDataString(search ?? ""))&page=@(currentPage - 1)"
                       hx-target="#gridContainer"
                       hx-swap="innerHTML">
                        &laquo;
                    </a>
                </li>

                <!-- Page Numbers -->
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link"
                           href="#"
                           hx-get="/CostCenter/Grid?search=@(Uri.EscapeDataString(search ?? ""))&page=@i"
                           hx-target="#gridContainer"
                           hx-swap="innerHTML">
                            @i
                        </a>
                    </li>
                }

                <!-- Next -->
                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link"
                       href="#"
                       hx-get="/CostCenter/Grid?search=@(Uri.EscapeDataString(search ?? ""))&page=@(currentPage + 1)"
                       hx-target="#gridContainer"
                       hx-swap="innerHTML">
                        &raquo;
                    </a>
                </li>
            </ul>
        </nav>
    }
}
