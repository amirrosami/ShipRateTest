<!-- ===================== KPI CARDS ===================== -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 d-flex align-items-center justify-content-center"
                     style="width:48px;height:48px;background:var(--bs-primary);color:#fff;font-size:1.3rem;">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <div class="text-muted small">Active Shipments</div>
                    <div class="fw-bold fs-5 lh-1 mt-1">2,847</div>
                    <small class="text-success"><i class="bi bi-arrow-up"></i> 12.5%</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 d-flex align-items-center justify-content-center"
                     style="width:48px;height:48px;background:#198754;color:#fff;font-size:1.3rem;">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div>
                    <div class="text-muted small">Delivered</div>
                    <div class="fw-bold fs-5 lh-1 mt-1">18,429</div>
                    <small class="text-success"><i class="bi bi-arrow-up"></i> 8.2%</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 d-flex align-items-center justify-content-center"
                     style="width:48px;height:48px;background:#ffc107;color:#000;font-size:1.3rem;">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div>
                    <div class="text-muted small">In Transit</div>
                    <div class="fw-bold fs-5 lh-1 mt-1">1,156</div>
                    <small class="text-warning"><i class="bi bi-dash"></i> 0.4%</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 d-flex align-items-center justify-content-center"
                     style="width:48px;height:48px;background:#dc3545;color:#fff;font-size:1.3rem;">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <div>
                    <div class="text-muted small">Delayed</div>
                    <div class="fw-bold fs-5 lh-1 mt-1">43</div>
                    <small class="text-danger"><i class="bi bi-arrow-up"></i> 2.1%</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===================== MAIN CHARTS ROW ===================== -->
<div class="row g-3 mb-4">
    <!-- Shipment Volume (Line Chart) -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-semibold">Shipment Volume</h6>
                <div class="btn-group btn-group-sm">
                    <button class="btn btn-outline-secondary active" data-range="weekly">Week</button>
                    <button class="btn btn-outline-secondary" data-range="monthly">Month</button>
                    <button class="btn btn-outline-secondary" data-range="yearly">Year</button>
                </div>
            </div>
            <div class="card-body pt-0">
                <div style="position:relative; height:300px;">
                    <canvas id="chartVolume"></canvas>
                </div>
            </div>
        </div>
    </div>
    <!-- Transport Distribution (Doughnut) -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0">
                <h6 class="mb-0 fw-semibold">Transport Mode</h6>
            </div>
            <div class="card-body pt-0 d-flex flex-column align-items-center justify-content-center">
                <div style="position:relative; height:220px; width:220px;">
                    <canvas id="chartDoughnut"></canvas>
                </div>
                <div class="d-flex flex-wrap gap-3 mt-3 small justify-content-center">
                    <span><i class="bi bi-circle-fill text-primary me-1"></i>Sea 45%</span>
                    <span><i class="bi bi-circle-fill me-1" style="color:#36b9cc"></i>Air 25%</span>
                    <span><i class="bi bi-circle-fill me-1" style="color:#f6c23e"></i>Road 20%</span>
                    <span><i class="bi bi-circle-fill me-1" style="color:#1cc88a"></i>Rail 10%</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===================== SECOND CHARTS ROW ===================== -->
<div class="row g-3 mb-4">
    <!-- Revenue Chart (Bar) -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0">
                <h6 class="mb-0 fw-semibold">Monthly Revenue ($K)</h6>
            </div>
            <div class="card-body pt-0">
                <div style="position:relative; height:280px;">
                    <canvas id="chartRevenue"></canvas>
                </div>
            </div>
        </div>
    </div>
    <!-- On-Time Performance (Bar Horizontal) -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0">
                <h6 class="mb-0 fw-semibold">On-Time Delivery by Region</h6>
            </div>
            <div class="card-body pt-0">
                <div style="position:relative; height:280px;">
                    <canvas id="chartOnTime"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===================== TABLE + ACTIVITY ===================== -->
