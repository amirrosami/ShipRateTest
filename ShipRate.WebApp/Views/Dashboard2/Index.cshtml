                <a href="#" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Route</th>
                                <th class="text-center">Shipments</th>
                                <th class="text-center">Avg Days</th>
                                <th class="text-center">On-Time</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <div class="fw-semibold">Shanghai → Rotterdam</div>
                                    <small class="text-muted">Via Suez Canal</small>
                                </td>
                                <td class="text-center">1,247</td>
                                <td class="text-center">28</td>
                                <td class="text-center">
                                    <div class="progress" style="height:6px;width:80px;margin:auto;">
                                        <div class="progress-bar bg-success" style="width:94%"></div>
                                    </div>
                                    <small>94%</small>
                                </td>
                                <td><span class="badge bg-success-subtle text-success">Active</span></td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="fw-semibold">Dubai → Hamburg</div>
                                    <small class="text-muted">Direct Service</small>
                                </td>
                                <td class="text-center">893</td>
                                <td class="text-center">18</td>
                                <td class="text-center">
                                    <div class="progress" style="height:6px;width:80px;margin:auto;">
                                        <div class="progress-bar bg-success" style="width:91%"></div>
                                    </div>
                                    <small>91%</small>
                                </td>
                                <td><span class="badge bg-success-subtle text-success">Active</span></td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="fw-semibold">Los Angeles → Tokyo</div>
                                    <small class="text-muted">Trans-Pacific</small>
                                </td>
                                <td class="text-center">756</td>
                                <td class="text-center">14</td>
                                <td class="text-center">
                                    <div class="progress" style="height:6px;width:80px;margin:auto;">
                                        <div class="progress-bar bg-warning" style="width:87%"></div>
                                    </div>
                                    <small>87%</small>
                                </td>
                                <td><span class="badge bg-warning-subtle text-warning">Moderate</span></td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="fw-semibold">Singapore → Sydney</div>
                                    <small class="text-muted">Coastal Route</small>
                                </td>
                                <td class="text-center">612</td>
                                <td class="text-center">10</td>
                                <td class="text-center">
                                    <div class="progress" style="height:6px;width:80px;margin:auto;">
                                        <div class="progress-bar bg-success" style="width:96%"></div>
                                    </div>
                                    <small>96%</small>
                                </td>
                                <td><span class="badge bg-success-subtle text-success">Active</span></td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="fw-semibold">Mumbai → Durban</div>
                                    <small class="text-muted">Indian Ocean</small>
                                </td>
                                <td class="text-center">489</td>
                                <td class="text-center">22</td>
                                <td class="text-center">
                                    <div class="progress" style="height:6px;width:80px;margin:auto;">
                                        <div class="progress-bar bg-danger" style="width:78%"></div>
                                    </div>
                                    <small>78%</small>
                                </td>
                                <td><span class="badge bg-danger-subtle text-danger">Delayed</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <!-- Live Activity Feed -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-semibold">Live Activity</h6>
                <span class="badge bg-success"><i class="bi bi-broadcast me-1"></i>Live</span>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    <div class="list-group-item border-0 py-3">
