</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // ===== COLOR PALETTE =====
            const colors = {
                primary: '#4e73df',
                success: '#1cc88a',
                info: '#36b9cc',
                warning: '#f6c23e',
                danger: '#e74a3b',
                secondary: '#858796',
                light: '#f8f9fc'
            };

            // ===== HELPER: get CSS var or fallback =====
            function textColor() {
                return getComputedStyle(document.documentElement)
                    .getPropertyValue('--bs-body-color').trim() || '#333';
            }
            function gridColor() {
                return 'rgba(128,128,128,0.15)';
            }

            // ===== 1. SHIPMENT VOLUME (Line / Area) =====
            new Chart(document.getElementById('chartVolume'), {
                type: 'line',
                data: {
                    labels: ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'],
                    datasets: [
                        {
                            label: 'This Week',
                            data: [420,380,510,470,540,390,480],
                            borderColor: colors.primary,
                            backgroundColor: 'rgba(78,115,223,0.12)',
                            fill: true,
                            tension: 0.4,
                            pointRadius: 4,
                            pointBackgroundColor: '#fff',
                            pointBorderWidth: 2
                        },
                        {
                            label: 'Last Week',
                            data: [350,310,430,400,460,350,410],
                            borderColor: colors.secondary,
                            backgroundColor: 'transparent',
                            borderDash: [5,5],
                            fill: false,
                            tension: 0.4,
                            pointRadius: 3,
                            pointBackgroundColor: '#fff',
                            pointBorderWidth: 2
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top', labels: { usePointStyle: true, padding: 20, color: textColor() } }
                    },
                    scales: {
                        x: { grid: { display: false }, ticks: { color: textColor() } },
                        y: { grid: { color: gridColor() }, ticks: { color: textColor() }, beginAtZero: true }
                    }
                }
            });

            // ===== 2. TRANSPORT MODE (Doughnut) =====
            new Chart(document.getElementById('chartDoughnut'), {
                type: 'doughnut',
                data: {
                    labels: ['Sea','Air','Road','Rail'],
                    datasets: [{
                        data: [45,25,20,10],
                        backgroundColor: [colors.primary, colors.info, colors.warning, colors.success],
                        borderWidth: 0,
                        hoverOffset: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '68%',
                    plugins: {
                        legend: { display: false }
                    }
                }
            });

            // ===== 3. MONTHLY REVENUE (Bar) =====
            new Chart(document.getElementById('chartRevenue'), {
                type: 'bar',
                data: {
                    labels: ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'],
                    datasets: [{
                        label: 'Revenue',
                        data: [120,135,128,142,155,148,162,158,170,165,178,190],
                        backgroundColor: colors.primary,
                        borderRadius: 4,
                        barPercentage: 0.6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        x: { grid: { display: false }, ticks: { color: textColor() } },
                        y: { grid: { color: gridColor() }, ticks: { color: textColor(), callback: v => '$' + v + 'K' }, beginAtZero: true }
                    }
                }
            });

            // ===== 4. ON-TIME DELIVERY BY REGION (Horizontal Bar) =====
            new Chart(document.getElementById('chartOnTime'), {
                type: 'bar',
                data: {
                    labels: ['Asia Pacific','Europe','North America','Middle East','Africa','South America'],
                    datasets: [{
                        label: 'On-Time %',
                        data: [94,91,89,87,78,82],
                        backgroundColor: function(ctx) {
                            const v = ctx.parsed.x;
                            if (v >= 90) return colors.success;
                            if (v >= 85) return colors.info;
                            if (v >= 80) return colors.warning;
                            return colors.danger;
                        },
                        borderRadius: 4,
                        barPercentage: 0.55
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: { callbacks: { label: ctx => ctx.parsed.x + '%' } }
                    },
                    scales: {
                        x: { grid: { color: gridColor() }, ticks: { color: textColor(), callback: v => v + '%' }, min: 60, max: 100 },
                        y: { grid: { display: false }, ticks: { color: textColor() } }
                    }
                }
            });

            // Fix bar colors (scriptable doesn't work in all versions, apply manually)
            const onTimeChart = Chart.getChart('chartOnTime');
            if (onTimeChart) {
                const vals = onTimeChart.data.datasets[0].data;
                onTimeChart.data.datasets[0].backgroundColor = vals.map(v => {
                    if (v >= 90) return colors.success;
                    if (v >= 85) return colors.info;
                    if (v >= 80) return colors.warning;
                    return colors.danger;
                });
                onTimeChart.update();
            }

        });
    </script>
}
