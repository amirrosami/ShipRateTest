<style>
    /* ============ MARKETING DASHBOARD STYLES ============ */
    .mk-card {
        border: 1px solid rgba(78,115,223,0.12);
        border-radius: 16px;
        position: relative;
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .mk-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.08) !important;
        }

        .mk-card .mk-stripe {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
        }

    .mk-stripe.blue {
        background: linear-gradient(90deg, #4e73df, #224abe);
    }

    .mk-stripe.green {
        background: linear-gradient(90deg, #1cc88a, #13855c);
    }

    .mk-stripe.orange {
        background: linear-gradient(90deg, #f6c23e, #dda020);
    }

    .mk-stripe.red {
        background: linear-gradient(90deg, #e74a3b, #be2617);
    }

    .mk-stripe.purple {
        background: linear-gradient(90deg, #8b5cf6, #6d28d9);
    }

    .mk-stripe.cyan {
        background: linear-gradient(90deg, #36b9cc, #1a8a9a);
    }

    .mk-stripe.pink {
        background: linear-gradient(90deg, #e83e8c, #c21868);
    }

    /* KPI number */
    .mk-kpi {
        font-size: 2rem;
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -0.5px;
    }

    .mk-kpi-sm {
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1.1;
    }

    .mk-label {
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        font-weight: 600;
    }

    /* Trend badge */
    .mk-trend {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        padding: 2px 8px;
        border-radius: 20px;
        font-size: 0.72rem;
        font-weight: 600;
    }

        .mk-trend.up {
            background: rgba(28,200,138,0.12);
            color: #1cc88a;
        }

        .mk-trend.down {
            background: rgba(231,74,59,0.12);
            color: #e74a3b;
        }

        .mk-trend.flat {
            background: rgba(133,135,150,0.12);
            color: #858796;
        }

    /* Funnel visualization */
    .funnel-step {
        position: relative;
        text-align: center;
        padding: 12px 0;
    }

    .funnel-bar {
        margin: 0 auto;
        height: 40px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: 700;
        font-size: 0.9rem;
        transition: all 0.3s;
    }

        .funnel-bar:hover {
            filter: brightness(1.1);
            transform: scaleX(1.03);
        }

    .funnel-arrow {
        color: rgba(128,128,128,0.3);
        font-size: 1rem;
    }

    .funnel-rate {
        position: absolute;
        right: 8px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 0.7rem;
        font-weight: 600;
        color: #1cc88a;
    }

    /* Campaign row */
    .campaign-row {
        border-radius: 10px;
        padding: 12px 16px;
        margin-bottom: 8px;
        transition: background 0.2s;
    }

        .campaign-row:hover {
            background: rgba(78,115,223,0.04);
        }

    .campaign-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        color: #fff;
        flex-shrink: 0;
    }

    /* Channel pill */
    .channel-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.72rem;
        font-weight: 600;
        border: 1px solid transparent;
    }

        .channel-pill.google {
            background: rgba(66,133,244,0.1);
            color: #4285f4;
            border-color: rgba(66,133,244,0.2);
        }

        .channel-pill.linkedin {
            background: rgba(10,102,194,0.1);
            color: #0a66c2;
            border-color: rgba(10,102,194,0.2);
        }

        .channel-pill.email {
            background: rgba(28,200,138,0.1);
            color: #1cc88a;
            border-color: rgba(28,200,138,0.2);
        }

        .channel-pill.trade {
            background: rgba(246,194,62,0.1);
            color: #c99a1e;
            border-color: rgba(246,194,62,0.2);
        }

        .channel-pill.referral {
            background: rgba(139,92,246,0.1);
            color: #8b5cf6;
            border-color: rgba(139,92,246,0.2);
        }

        .channel-pill.social {
            background: rgba(232,62,140,0.1);
            color: #e83e8c;
            border-color: rgba(232,62,140,0.2);
        }

    /* Progress ring */
    .progress-ring {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .progress-ring svg {
            transform: rotate(-90deg);
        }

        .progress-ring .ring-text {
            position: absolute;
            font-weight: 800;
            font-size: 1.1rem;
        }

    /* Sparkline placeholder */
    .mk-spark {
        display: flex;
        align-items: flex-end;
        gap: 2px;
        height: 32px;
    }

    .mk-spark-bar {
        width: 6px;
        border-radius: 3px 3px 0 0;
        transition: height 0.3s;
        opacity: 0.7;
    }

        .mk-spark-bar:hover {
            opacity: 1;
        }

    /* Scrollbar terminal */
    .mk-scroll::-webkit-scrollbar {
        width: 4px;
    }

    .mk-scroll::-webkit-scrollbar-thumb {
        background: rgba(128,128,128,0.2);
        border-radius: 4px;
    }

    /* Animated gradient for header card */
    .mk-hero-gradient {
        background: linear-gradient(135deg, #4e73df 0%, #8b5cf6 50%, #e83e8c 100%);
        background-size: 200% 200%;
        animation: heroShift 6s ease infinite;
    }

    @@keyframes heroShift {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* Heatmap cell */
    .heatmap-cell {
        width: 100%;
        aspect-ratio: 1;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        font-weight: 600;
        color: #fff;
        transition: transform 0.2s;
    }

        .heatmap-cell:hover {
            transform: scale(1.15);
            z-index: 1;
        }
</style>

<!-- ==================== HERO BANNER ==================== -->
