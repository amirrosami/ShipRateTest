                            backgroundColor: 'rgba(28,200,138,0.5)',
                            borderRadius: 6, barPercentage: 0.55, yAxisID: 'y', order: 2
                        }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top', labels: { usePointStyle: true, padding: 14, color: txtClr(), font: { size: 11 } } }
                    },
                    scales: {
                        x: { grid: { display: false }, ticks: { color: txtClr() }, stacked: true },
                        y: { grid: { color: grdClr() }, ticks: { color: txtClr() }, stacked: true, beginAtZero: true }
                    }
                }
            });

            // ===== 2. CHANNEL MIX (Doughnut) =====
            new Chart(document.getElementById('chartChannelMix'), {
                type: 'doughnut',
                data: {
                    labels: ['Google Ads','LinkedIn','Email','Trade Shows','Referral'],
                    datasets: [{
                        data: [34,22,18,14,12],
                        backgroundColor: [C.google, C.linkedin, C.success, C.warning, C.purple],
                        borderWidth: 0, hoverOffset: 8
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    cutout: '68%',
                    plugins: {
                        legend: { display: false },
                        tooltip: { callbacks: { label: ctx => ctx.label + ': ' + ctx.parsed + '%' } }
                    }
                }
            });

            // ===== 3. CHANNEL ROI (Grouped bar with line) =====
            new Chart(document.getElementById('chartChannelROI'), {
                type: 'bar',
                data: {
                    labels: ['Google Ads','LinkedIn','Email','Trade Shows','Referral','SEO','Social Media'],
                    datasets: [
                        {
                            label: 'Spend ($K)',
                            data: [12.5, 8.2, 2.1, 22.0, 3.5, 5.4, 4.8],
                            backgroundColor: 'rgba(231,74,59,0.7)',
                            borderRadius: 4, barPercentage: 0.4, categoryPercentage: 0.8
                        },
                        {
                            label: 'Revenue ($K)',
                            data: [65.0, 39.4, 17.0, 138.6, 39.2, 40.0, 10.1],
                            backgroundColor: 'rgba(28,200,138,0.7)',
                            borderRadius: 4, barPercentage: 0.4, categoryPercentage: 0.8
                        },
                        {
                            type: 'line',
                            label: 'ROI (x)',
                            data: [5.2, 4.8, 8.1, 6.3, 11.2, 7.4, 2.1],
                            borderColor: C.purple,
                            backgroundColor: 'transparent',
                            tension: 0.4, pointRadius: 5, pointBackgroundColor: '#fff',
                            pointBorderWidth: 2.5, borderWidth: 2.5, yAxisID: 'y1'
                        }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top', labels: { usePointStyle: true, padding: 14, color: txtClr(), font: { size: 11 } } }
                    },
                    scales: {
                        x: { grid: { display: false }, ticks: { color: txtClr(), font: { size: 10 } } },
                        y: { grid: { color: grdClr() }, ticks: { color: txtClr(), callback: v => '$' + v + 'K' }, beginAtZero: true, position: 'left' },
                        y1: { grid: { display: false }, ticks: { color: C.purple, callback: v => v + 'x' }, beginAtZero: true, position: 'right' }
                    }
                }
            });

            // ===== 4. CONVERSION BY SERVICE LINE (Horizontal bar) =====
            new Chart(document.getElementById('chartServiceConversion'), {
                type: 'bar',
                data: {
                    labels: ['Ocean Freight','Air Freight','Road Transport','Warehousing','Customs Brokerage','Last Mile'],
                    datasets: [
                        {
                            label: 'Conversion Rate %',
                            data: [28.5, 22.1, 31.4, 18.7, 35.2, 24.8],
                            backgroundColor: [
                                'rgba(78,115,223,0.75)', 'rgba(54,185,204,0.75)', 'rgba(28,200,138,0.75)',
                                'rgba(246,194,62,0.75)', 'rgba(139,92,246,0.75)', 'rgba(232,62,140,0.75)'
                            ],
                            borderRadius: 6, barPercentage: 0.6
                        }
                    ]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true, maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: { callbacks: { label: ctx => ctx.parsed.x + '% conversion' } }
                    },
                    scales: {
                        x: { grid: { color: grdClr() }, ticks: { color: txtClr(), callback: v => v + '%' }, max: 40, beginAtZero: true },
                        y: { grid: { display: false }, ticks: { color: txtClr(), font: { size: 11 } } }
                    }
                }
            });

            // ===== 5. MARKETING-SOURCED REVENUE (Stacked area) =====
            new Chart(document.getElementById('chartRevenue'), {
                type: 'line',
                data: {
                    labels: ['Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec','Jan','Feb'],
                    datasets: [
                        {
                            label: 'Paid Channels',
                            data: [120,135,142,130,165,190,185,210,225,240,255,270],
                            borderColor: C.primary, backgroundColor: 'rgba(78,115,223,0.15)',
                            fill: true, tension: 0.4, pointRadius: 0, borderWidth: 2
                        },
                        {
                            label: 'Organic / SEO',
                            data: [80,88,95,92,110,125,120,138,148,155,168,180],
                            borderColor: C.success, backgroundColor: 'rgba(28,200,138,0.12)',
                            fill: true, tension: 0.4, pointRadius: 0, borderWidth: 2
                        },
                        {
                            label: 'Referral',
                            data: [40,45,50,48,58,65,62,72,78,82,90,95],
                            borderColor: C.purple, backgroundColor: 'rgba(139,92,246,0.1)',
                            fill: true, tension: 0.4, pointRadius: 0, borderWidth: 2
                        },
                        {
                            label: 'Events',
                            data: [0,0,0,65,0,0,0,0,85,0,0,0],
                            borderColor: C.warning, backgroundColor: 'rgba(246,194,62,0.15)',
                            fill: true, tension: 0.1, pointRadius: 3, pointBackgroundColor: C.warning,
                            borderWidth: 1.5, borderDash: [4,4]
                        }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top', labels: { usePointStyle: true, padding: 14, color: txtClr(), font: { size: 11 } } },
                        tooltip: { callbacks: { label: ctx => ctx.dataset.label + ': $' + ctx.parsed.y + 'K' } }
                    },
                    scales: {
                        x: { grid: { display: false }, ticks: { color: txtClr() } },
                        y: { stacked: true, grid: { color: grdClr() }, ticks: { color: txtClr(), callback: v => '$' + v + 'K' }, beginAtZero: true }
                    }
                }
            });

            // ===== 6. HEATMAP GENERATOR =====
            const days = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
            const hours = [6,9,12,15,18,21];
            const heatmapData = [
                [12,35,58,72,45,18], // Mon
                [15,42,65,78,52,22], // Tue
                [10,38,70,85,60,20], // Wed
                [18,45,62,80,48,15], // Thu
                [14,40,55,68,38,12], // Fri
                [5,12,20,15,8,3],    // Sat
                [3,8,14,10,6,2]      // Sun
            ];
            const gridEl = document.getElementById('heatmapGrid');
            days.forEach((day, di) => {
                const row = document.createElement('div');
                row.className = 'd-flex gap-1 mb-1 align-items-center';
                row.innerHTML = '<small class="text-muted fw-semibold" style="width:50px;font-size:0.72rem;">' + day + '</small>';
                const cellsWrap = document.createElement('div');
                cellsWrap.className = 'flex-grow-1 d-flex gap-1';
                hours.forEach((h, hi) => {
                    const val = heatmapData[di][hi];
                    const maxVal = 85;
                    const intensity = Math.max(0.08, val / maxVal);
                    const cell = document.createElement('div');
                    cell.className = 'heatmap-cell flex-fill';
                    cell.style.background = 'rgba(78,115,223,' + intensity + ')';
                    cell.title = day + ' ' + h + ':00 — ' + val + ' leads';
                    if (intensity > 0.5) cell.textContent = val;
                    else { cell.style.color = 'transparent'; cell.textContent = val; }
                    cell.addEventListener('mouseenter', function() { this.style.color = '#fff'; });
                    cell.addEventListener('mouseleave', function() { if (intensity <= 0.5) this.style.color = 'transparent'; });
                    cellsWrap.appendChild(cell);
                });
                row.appendChild(cellsWrap);
                gridEl.appendChild(row);
            });

            // ===== COUNTER ANIMATIONS =====
            function animateVal(el, start, end, dur, prefix, suffix) {
                prefix = prefix || ''; suffix = suffix || '';
                let startTime = null;
                const step = (ts) => {
                    if (!startTime) startTime = ts;
                    const p = Math.min((ts - startTime) / dur, 1);
                    const eased = 1 - Math.pow(1 - p, 3);
                    const val = Math.floor(eased * (end - start) + start);
                    el.textContent = prefix + val.toLocaleString() + suffix;
                    if (p < 1) requestAnimationFrame(step);
                };
                requestAnimationFrame(step);
            }
            animateVal(document.getElementById('kpiLeads'), 0, 3847, 2000, '', '');

        });
    </script>
