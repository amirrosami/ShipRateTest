@using ShipRate.WebApp.ViewModels
@model ChangePasswordVm

<style>
    /* حذف لبه‌های گرد برای هماهنگی با بقیه فرم‌های شما */
    .form-control, .btn { border-radius: 0 !important; }
</style>

<h5>
    <i class="bi bi-key me-2"></i>Change Password
</h5>

@* محدود کردن عرض فرم برای جلوگیری از کشیدگی بیش از حد *@
<div class="container-fluid py-2">
    <form hx-post="@Url.Action("ChangePassword", "Account")"
          hx-target="#modal-content"
          hx-swap="innerHTML">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

        <!-- Current Password -->
        <div class="row mb-3 align-items-center">
            <label asp-for="OldPassword" class="col-sm-4 col-form-label small fw-semibold text-secondary">Current Password:</label>
            <div class="col-sm-8">
                <input asp-for="OldPassword" type="password" class="form-control form-control-sm" placeholder="••••••••" />
                <span asp-validation-for="OldPassword" class="text-danger extra-small"></span>
            </div>
        </div>

        <hr class="text-muted opacity-25" />

        <!-- New Password -->
        <div class="row mb-3 align-items-center">
            <label asp-for="NewPassword" class="col-sm-4 col-form-label small fw-semibold text-secondary">New Password:</label>
            <div class="col-sm-8">
                <input asp-for="NewPassword" type="password" class="form-control form-control-sm" placeholder="Min 6 characters" />
                <span asp-validation-for="NewPassword" class="text-danger extra-small"></span>
            </div>
        </div>

        <!-- Confirm Password -->
        <div class="row mb-4 align-items-center">
            <label asp-for="ConfirmPassword" class="col-sm-4 col-form-label small fw-semibold text-secondary">Confirm New:</label>
            <div class="col-sm-8">
                <input asp-for="ConfirmPassword" type="password" class="form-control form-control-sm" placeholder="Repeat new password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger extra-small"></span>
            </div>
        </div>

        <!-- Footer Buttons -->
        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
            <button type="submit" class="btn btn-primary btn-sm px-4">
                <i class="bi bi-check2-circle me-1"></i> Update Password
            </button>
            <button type="button"
                    class="btn btn-outline-secondary btn-sm px-4"
                    onclick="closeBootstrapModal('appModal')" >
                Cancel
            </button>
        </div>
    </form>
</div>

<style>
    .extra-small { font-size: 0.75rem; }
    /* اگر مودال XL است، اینجا عرض داخلی را محدود می‌کنیم */
    #modal-content { max-width: 500px; margin: 0 auto; }
</style>



