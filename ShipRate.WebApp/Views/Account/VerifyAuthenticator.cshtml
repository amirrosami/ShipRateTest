@model VerifyAuthenticatorVm

@{
    ViewData["Title"] = "Two-Factor Authentication";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ShipRate</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/lib/bootstrap-icons/font/bootstrap-icons.css"
          asp-append-version="true" />

    <style>
        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            min-height: 100%;
        }

        body {
            min-height: 100vh;
            padding: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #0f172a, #1e293b);
            font-family: "Segoe UI", Tahoma, Arial, sans-serif;
        }

        .auth-card {
            width: 100%;
            max-width: 420px;
            padding: 40px 32px 30px;
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.25);
        }

        .auth-icon-wrapper {
            width: 68px;
            height: 68px;
            margin: 0 auto 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            color: #2563eb;
            background-color: #eff6ff;
            font-size: 30px;
        }

        .auth-title {
            margin-bottom: 8px;
            color: #0f172a;
            text-align: center;
            font-size: 24px;
            font-weight: 700;
        }

        .auth-subtitle {
            margin-bottom: 28px;
            color: #64748b;
            text-align: center;
            font-size: 14px;
            line-height: 1.7;
        }

        .otp-input {
            height: 54px;
            border-radius: 10px;
            text-align: center;
            letter-spacing: 8px;
            font-size: 24px;
            font-weight: 600;
            direction: ltr;
        }

            .otp-input:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.15);
            }

        .btn-verify {
            width: 100%;
            height: 48px;
            border: 0;
            border-radius: 10px;
            color: #ffffff;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            font-weight: 600;
        }

            .btn-verify:hover {
                color: #ffffff;
                background: linear-gradient(135deg, #1d4ed8, #1e40af);
            }

        .back-link {
            display: block;
            margin-top: 22px;
            color: #64748b;
            text-align: center;
            text-decoration: none;
            font-size: 14px;
        }

            .back-link:hover {
                color: #1e293b;
            }

        .validation-summary-valid {
            display: none;
        }
    </style>
</head>

<body>
    <main class="auth-card">
        <div class="auth-icon-wrapper">
            <i class="bi bi-shield-lock-fill"></i>
        </div>

        <h1 class="auth-title">Two-Factor Authentication</h1>

        <p class="auth-subtitle">
            Enter the 6-digit code from your authenticator app.
        </p>

        <form asp-controller="Account"
              asp-action="VerifyAuthenticator"
              method="post"
              autocomplete="off">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="RememberMe" />
            <input type="hidden" asp-for="ReturnUrl" />

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger py-2 small">
            </div>

            <div class="mb-4">
                <label asp-for="Code"
                       class="form-label fw-semibold">
                    Authenticator Code
                </label>

                <input asp-for="Code"
                       class="form-control otp-input"
                       placeholder="000000"
                       maxlength="6"
                       inputmode="numeric"
                       autocomplete="one-time-code"
                       autofocus />

                <span asp-validation-for="Code"
                      class="text-danger small">
                </span>
            </div>

            <button type="submit" class="btn btn-verify">
                <i class="bi bi-check-circle me-1"></i>
                Verify &amp; Sign In
            </button>

            <a asp-controller="Account"
               asp-action="Login"
               class="back-link">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Login
            </a>
        </form>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>

    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
