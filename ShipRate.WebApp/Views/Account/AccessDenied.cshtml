@{
    ViewData["Title"] = "Access Denied";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Access Denied</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #f9fafb;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .box {
            background: white;
            padding: 40px;
            border-radius: 20px; /* گوشه‌های گردتر */
            text-align: center;
            width: 320px; /* عرض محدود برای مربع‌تر شدن */
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            border: 1px solid #e5e7eb;
        }

        .icon {
            font-size: 50px;
            margin-bottom: 20px;
            display: block;
        }

        h2 {
            margin: 0 0 10px 0;
            color: #111827;
            font-size: 20px;
        }

        p {
            color: #6b7280;
            font-size: 14px;
            margin-bottom: 25px;
            line-height: 1.5;
        }

        .btn {
            display: block; /* دکمه تمام عرض در کادر */
            padding: 12px;
            background: #111827;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 500;
            font-size: 14px;
            transition: background 0.2s;
        }

            .btn:hover {
                background: #374151;
            }
    </style>
</head>
<body>

    <div class="box">
        <span class="icon">🔒</span>
        <h2>Access Denied</h2>
        <p>You don't have permission to view this page.</p>
        <a href="/" class="btn">Back to Dashboard</a>
    </div>

</body>
</html>
