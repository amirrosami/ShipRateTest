@using ShipRate.Application.DTOs
@using ShipRate.WebApp.ViewModels.FlightVms
@model ProductCategoryDto
@{
    string CreateEdit = ViewBag.CreateEdit;
    bool isCreateMode = false;
    if (CreateEdit == "Create") isCreateMode = true;
}

<form hx-post="@Url.Action(isCreateMode ? "Create" : "Edit", "ProductCategory")"
      hx-target="#app-modal-content"
      hx-swap="innerHTML">

    <div class="modal-header form-caption-bg text-white">
        @if (isCreateMode)
        {
            <h5 class="modal-title">
                <i class="bi bi-plus-circle me-2"></i>Add Category
            </h5>
        }
        else
        {
            <h5 class="modal-title">
                <i class="bi bi-pencil-square me-2"></i>Edit Category
            </h5>
            <input type="hidden" asp-for="Id" />
        }

        <button type="button"
                class="btn-close"
                onclick="AppModal.close()">
        </button>
    </div>

    <div class="modal-body row">
        @Html.AntiForgeryToken()

        @await Html.PartialAsync("_ModelStateError")

        <div class="mb-3 col-md-5">
            <label class="form-label fw-medium">
                Title <span class="text-danger">*</span>
            </label>
            <input type="text"
                   name="ProductCategoryName"
                   value="@Model.ProductCategoryName"
                   class="form-control @(ViewData.ModelState.ContainsKey("ProductCategoryName") && ViewData.ModelState["ProductCategoryName"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                   maxlength="100" required />
        </div>



        <!-- IsActive -->
       
            <div class="form-check form-switch">
                <input type="checkbox"
                       class="form-check-input"
                       name="IsActive"
                       value="true"
                       id="createIsActive"
                       @(Model.IsActive ? "checked" : "") />
                <label class="form-check-label" for="createIsActive">Active</label>
            </div>
    </div>

    <div class="modal-footer">
        <button type="button"
                class="btn btn-secondary"
                onclick="AppModal.close()">
            Cancel
        </button>

        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>

            @if (isCreateMode)
            {
                <span>Save</span>
            }
            else
            {
                <span>Update</span>
            }
        </button>
    </div>
</form>



