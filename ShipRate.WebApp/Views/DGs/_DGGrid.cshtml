@using ShipRate.Application.DTOs
@using ShipRate.WebApp.ViewModels
@using ShipRate.WebApp.ViewModels.Location
@model GridViewModel
@if (!Model.Data.Items.Any())
{
    <tr>
        <td colspan="6" class="text-center py-5 text-muted">
            <i class="bi bi-inbox display-4 d-block mb-2"></i>
            No Records found.
        </td>
    </tr>
}
else
{
    int counter = (Model.Data.Page - 1) * Model.Data.PageSize;
    @foreach (var item in Model.Data.Items)
    {
        var vm = (DGListItem)item;
        counter++;
        <tr>
            <td>@counter</td>
            <td>
                <span class="un-badge">UN @vm.DGUnNumber</span>
            </td>
            <td>
                <span class="class-tag">@vm.DGClassNo</span>
                <small class="text-muted">@vm.DGClassName</small>
            </td>
            <td>@vm.DGSubClassNo</td>
            <td><strong>@vm.DGName</strong></td>
            <td>@vm.DGLocalName</td>
            <td>
                <span class="pg-badge">@vm.DGPackingGroupCode</span>
            </td>
            <td>@vm.DGRegulationSetName</td>
            <td>
                <span class="badge @(vm.IsActive ? "badge-success" : "badge-inactive")">
                    @(vm.IsActive ? "Active" : "Inactive")
                </span>
            </td>
            <td class="text-center">
                <div class="btn-group btn-group-sm">

                    <button type="button"
                            class="btn btn-outline-info"
                            title="Details"
                            hx-get="@Url.Action("Details", "DGs", new { id = vm.Id })"
                            hx-target="#app-modal-content"
                            hx-swap="innerHTML">
                        <i class="bi bi-card-list"></i>
                    </button>

                    <button type="button"
                            class="btn btn-outline-primary"
                            title="Edit"
                            hx-get="@Url.Action("Edit", "DGs", new { id = vm.Id })"
                            hx-target="#app-modal-content"
                            hx-swap="innerHTML">
                        <i class="bi bi-pencil"></i>

                    </button>
                    <button type="button"
                            class="btn btn-outline-danger"
                            title="Delete"
                            hx-get="@Url.Action("Delete", "DGs", new { id = vm.Id})"
                            hx-target="#app-modal-content"
                            hx-swap="innerHTML">
                        <i class="bi bi-trash"></i>
                    </button>

                </div>
            </td>
        </tr>
    }
}









@* @using ShipRate.WebApp.ViewModels
@model DGListViewModel

<div class="grid-wrapper">

    <!-- Toolbar -->
    <div class="grid-toolbar">
        <div class="toolbar-left">
            <span class="record-count">
                <i class="bi bi-radioactive"></i>
                <strong>@Model.TotalCount</strong> record(s) found
            </span>
        </div>
        
    </div>

    <!-- Table -->
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>UN No.</th>
                    <th>Class</th>
                    <th>Sub-Class</th>
                    <th>Name</th>
                    <th>Local Name</th>
                    <th>Packing Group</th>
                    <th>Regulation</th>
                    <th>Status</th>
                    <th class="actions-column">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <span class="un-badge">UN @item.DGUnNumber</span>
                            </td>
                            <td>
                                <span class="class-tag">@item.DGClassNo</span>
                                <small class="text-muted">@item.DGClassName</small>
                            </td>
                            <td>@item.DGSubClassNo</td>
                            <td><strong>@item.DGName</strong></td>
                            <td>@item.DGLocalName</td>
                            <td>
                                <span class="pg-badge">@item.DGPackingGroupCode</span>
                            </td>
                            <td>@item.DGRegulationSetName</td>
                            <td>
                                <span class="badge @(item.IsActive ? "badge-success" : "badge-inactive")">
                                    @(item.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="actions-cell">
                                <button class="action-btn edit"
                                        hx-get="/DGs/Edit/@item.Id"
                                        hx-target="#dg-modal-body"
                                        hx-swap="innerHTML"
                                        title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="action-btn delete"
                                        hx-delete="/DGs/Delete/@item.Id"
                                        hx-confirm="Are you sure you want to delete this DG item?"
                                        title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="no-data">
                            <i class="bi bi-inbox"></i>
                            <p>No dangerous goods found</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        int maxVisible = 5;
        int half = maxVisible / 2;
        int startPage = Math.Max(1, Model.Page - half);
        int endPage = Math.Min(Model.TotalPages, startPage + maxVisible - 1);

        if (endPage - startPage + 1 < maxVisible)
        {
            startPage = Math.Max(1, endPage - maxVisible + 1);
        }

        <div class="card-footer d-flex justify-content-between align-items-center">
            <small class="text-muted">
                Showing @((Model.Page - 1) * Model.PageSize + 1)–@Math.Min(Model.Page * Model.PageSize, Model.TotalCount) of @Model.TotalCount
            </small>
            <nav>
                <ul class="pagination pagination-sm mb-0">

                    <li class="page-item @(Model.Page > 1 ? "" : "disabled")">
                        <a class="page-link"
                           hx-get="@Url.Action("List", "Persons")"
                           hx-target="#table-container"
                           hx-swap="innerHTML"
                           hx-vals='{"page":"@(Model.Page - 1)","pageSize":"@Model.PageSize","searchterm":"@Model.SearchTerm"}'
                           href="#">&laquo;</a>
                    </li>

                    @if (startPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               hx-get="@Url.Action("List", "Persons")"
                               hx-target="#table-container"
                               hx-swap="innerHTML"
                               hx-vals='{"page":"1","pageSize":"@Model.PageSize","searchterm":"@Model.SearchTerm"}'
                               href="#">1</a>
                        </li>
                        if (startPage > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link"
                               hx-get="@Url.Action("List", "Persons")"
                               hx-target="#table-container"
                               hx-swap="innerHTML"
                               hx-vals='{"page":"@i","pageSize":"@Model.PageSize","searchterm":"@Model.SearchTerm"}'
                               href="#">@i</a>
                        </li>
                    }

                    @if (endPage < Model.TotalPages)
                    {
                        if (endPage < Model.TotalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                        <li class="page-item">
                            <a class="page-link"
                               hx-get="@Url.Action("List", "Persons")"
                               hx-target="#table-container"
                               hx-swap="innerHTML"
                               hx-vals='{"page":"@Model.TotalPages","pageSize":"@Model.PageSize","searchterm":"@Model.SearchTerm"}'
                               href="#">@Model.TotalPages</a>
                        </li>
                    }

                    <li class="page-item @(Model.TotalPages > Model.Page ? "" : "disabled")">
                        <a class="page-link"
                           hx-get="@Url.Action("List", "Persons")"
                           hx-target="#table-container"
                           hx-swap="innerHTML"
                           hx-vals='{"page":"@(Model.Page + 1)","pageSize":"@Model.PageSize","searchterm":"@Model.SearchTerm"}'
                           href="#">&raquo;</a>
                    </li>
                </ul>
            </nav>
        </div>
    }

   
</div> *@
