@using ShipRate.Application.DTOs
@model dynamic

@{
    var request = ViewBag.SearchRequest as VoyageSearchRequestDto ?? new VoyageSearchRequestDto();
    var pageSize = request.PageSize <= 0 ? 20 : request.PageSize;
    var pageNumber = request.PageNumber <= 0 ? 1 : request.PageNumber;
    var totalCount = (int)Model.TotalCount;
    var totalPages = (int)Math.Ceiling(totalCount / (double)pageSize);
}

@if (totalPages > 1)
{
    var startPage = Math.Max(1, pageNumber - 2);
    var endPage = Math.Min(totalPages, pageNumber + 2);

    <nav aria-label="Page navigation">
        <ul class="pagination pagination-sm mt-3">

            @* دکمه رفتن به اولین صفحه *@
            @if (pageNumber > 3)
            {
                <li class="page-item">
                    <a class="page-link" href="#"
                       hx-get="@Url.Action("Search", "VoyageManagement", new { PageNumber = 1 })"
                       hx-include="#voyage-search-form" hx-target="#voyage-grid-container">1</a>
                </li>
                @if (pageNumber > 4)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
            }

            @* صفحات محدوده جاری *@
            @for (int i = startPage; i <= endPage; i++)
            {
                var activeClass = i == pageNumber ? "active" : string.Empty;
                <li class="page-item @activeClass">
                    <a class="page-link" href="#"
                       hx-get="@Url.Action("Search", "VoyageManagement", new { PageNumber = i })"
                       hx-include="#voyage-search-form"
                       hx-target="#voyage-grid-container"
                       hx-swap="innerHTML">
                        @i
                    </a>
                </li>
            }

            @* دکمه رفتن به آخرین صفحه *@
            @if (pageNumber < totalPages - 2)
            {
                @if (pageNumber < totalPages - 3)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
                <li class="page-item">
                    <a class="page-link" href="#"
                       hx-get="@Url.Action("Search", "VoyageManagement", new { PageNumber = totalPages })"
                       hx-include="#voyage-search-form" hx-target="#voyage-grid-container">@totalPages</a>
                </li>
            }
        </ul>
    </nav>
}
