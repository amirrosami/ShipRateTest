@model ShipRate.Application.ViewModels.JobPartyDeleteVm

<div class="modal fade" id="jobPartyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="DeleteConfirmed"
                  asp-controller="JobParty"
                  method="post"
                  hx-post="@Url.Action("DeleteConfirmed", "JobParty", new { id = Model.Id })"
                  hx-target="#modalContainer"
                  hx-swap="innerHTML">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">Delete Job Party</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body text-start" dir="ltr">
                    <p class="mb-2">Are you sure you want to delete this record?</p>

                    <ul class="mb-0">
                        <li><strong>Sequence No:</strong> @Model.SequenceNo</li>
                        <li><strong>Party:</strong> @Model.PartyName</li>
                        <li><strong>Role Type:</strong> @Model.RoleTypeName</li>
                    </ul>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>
