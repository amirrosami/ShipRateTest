@model ShipRate.Application.ViewModels.JobPartyFormVm

<div class="modal fade" id="jobPartyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form asp-action="Create"
                  asp-controller="JobParty"
                  method="post"
                  hx-post="@Url.Action("Create", "JobParty")"
                  hx-target="#modalContainer"
                  hx-swap="innerHTML">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">Add Job Party</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                @await Html.PartialAsync("~/Views/JobParty/_JobPartyFormFields.cshtml", Model)

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
