@using ShipRate.Application.DTOs.Finance
@model PettyCashUpsertDto

@{
    var lookups = (PettyCashLookupDto)ViewBag.Lookups;
}

<form hx-post="@Url.Action("SavePettyCash", "PettyCash")"
      hx-target="#pettyModalBody"
      hx-swap="innerHTML"
      dir="ltr">
    @Html.AntiForgeryToken()

    <div class="modal-header">
        <h5 class="modal-title">@(Model.Id == null ? "Add Petty Cash" : "Edit Petty Cash")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row g-2">
            <div class="col-md-4">
                <label asp-for="CompanyId" class="form-label">Company</label>
                <select asp-for="CompanyId" asp-items="lookups.Companies" class="form-select"></select>
                <span asp-validation-for="CompanyId" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Code" class="form-label">Code</label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>

            <div class="col-md-12">
                <label asp-for="Title" class="form-label">Title</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="InitialAmount" class="form-label">Initial Amount</label>

                <input asp-for="InitialAmount"
                       type="text"
                       class="form-control money-input"
                       autocomplete="off"
                       inputmode="decimal" />

                <span asp-validation-for="InitialAmount" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="CurrentBalance" class="form-label">Current Balance</label>
                <input asp-for="CurrentBalance" class="form-control" readonly />
            </div>

            <div class="col-md-4">
                <label asp-for="IsActive" class="form-label">Active</label>
                <select asp-for="IsActive" class="form-select">
                    <option value="true">Yes</option>
                    <option value="false">No</option>
                </select>
            </div>

            <div class="col-md-6">
                <label asp-for="PersonId" class="form-label">Owner Person</label>
                <select asp-for="PersonId" asp-items="lookups.Persons" class="form-select">
                    <option value="">Select...</option>
                </select>
                <span asp-validation-for="PersonId" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="CustodianUserId" class="form-label">Custodian User</label>
                <select asp-for="CustodianUserId" asp-items="lookups.Users" class="form-select">
                    <option value="">Select...</option>
                </select>
                <span asp-validation-for="CustodianUserId" class="text-danger"></span>
            </div>
        </div>

        <div class="alert alert-info mt-3 mb-0">
            At least one of Owner Person or Custodian User is required.
        </div>
    </div>

    <div class="modal-footer">
        <button class="btn btn-primary" type="submit">Save</button>
        <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Close</button>
    </div>
</form>
