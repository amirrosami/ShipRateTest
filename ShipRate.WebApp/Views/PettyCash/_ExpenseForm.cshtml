@using ShipRate.Application.DTOs.Finance
@model PettyCashExpenseUpsertDto

@{
    var lookups = (PettyCashLookupDto)ViewBag.Lookups;
}

<form hx-post="@Url.Action("SaveExpense", "PettyCash")"
      hx-target="#pettyModalBody"
      hx-swap="innerHTML"
      dir="ltr">
    @Html.AntiForgeryToken()

    <div class="modal-header">
        <h5 class="modal-title">@(Model.Id == null ? "Add Expense" : "Edit Expense")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CompanyId" />
        <input type="hidden" asp-for="PettyCashId" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="alert alert-info">
            Current Balance: <strong>@Model.CurrentBalance.ToString("N2")</strong>
        </div>

        @if (Model.CategoryMaxAllowedAmount.HasValue && Model.CategoryMaxAllowedAmount.Value > 0 && Model.Amount > Model.CategoryMaxAllowedAmount.Value)
        {
            <div class="alert alert-warning">
                Amount is greater than category max allowed amount: @Model.CategoryMaxAllowedAmount.Value.ToString("N2")
            </div>
        }

        <div class="row g-2">
            <div class="col-md-4">
                <label asp-for="ExpenseDate" class="form-label">Expense Date</label>
                <input asp-for="ExpenseDate" type="date" class="form-control" />
                <span asp-validation-for="ExpenseDate" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Amount" class="form-label">Amount</label>
                <input asp-for="Amount" class="form-control money-input" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="ExpenseCategoryId" class="form-label">Category</label>
                <select asp-for="ExpenseCategoryId" asp-items="lookups.ExpenseCategories" class="form-select"></select>
                <span asp-validation-for="ExpenseCategoryId" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="CostCenterId" class="form-label">Cost Center</label>
                <select asp-for="CostCenterId" asp-items="lookups.CostCenters" class="form-select"></select>
                <span asp-validation-for="CostCenterId" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button class="btn btn-primary" type="submit">Save</button>
        <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Close</button>
    </div>
</form>
