@using ShipRate.Application.DTOs.Finance
@model IReadOnlyList<PettyCashExpenseListItemDto>

@{
    var pettyCashId = (Guid)ViewBag.PettyCashId;
}

<div class="card mb-3" dir="ltr"
     hx-get="@Url.Action("Expenses", "PettyCash", new { pettyCashId })"
     hx-trigger="expenseChanged from:body"
     hx-swap="innerHTML">
    <div class="card-header d-flex justify-content-between">
        <span>Expenses</span>
        <div>
            <button class="btn btn-sm btn-success"
                    hx-get="@Url.Action("CreateExpense", "PettyCash", new { pettyCashId })"
                    hx-target="#pettyModalBody"
                    data-bs-toggle="modal"
                    data-bs-target="#pettyModal">
                Add
            </button>
            <button class="btn btn-sm btn-outline-secondary"
                    type="button"
                    onclick="this.closest('.card').remove()">
                Close
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-sm table-striped mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th class="text-end">Amount</th>
                    <th>Category</th>
                    <th>Cost Center</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th style="width:210px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {

                    <tr>
                        <td>@item.ExpenseDate.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">@item.Amount.ToString("N2")</td>
                        <td>@item.CategoryTitle</td>
                        <td>@item.CostCenterTitle</td>
                        <td>@item.Description</td>
                        <td>@item.StatusName</td>
                        <td>
                            @{
                                var isApproved = item.StatusId == 3;
                                var isRejected = item.StatusId == 9;
                            }

                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    title="Edit Expense"
                                    aria-label="Edit Expense"
                                    hx-get="@Url.Action("EditExpense", "PettyCash", new { id = item.Id })"
                                    hx-target="#pettyModalBody"
                                    hx-swap="innerHTML"
                                    data-bs-toggle="modal"
                                    data-bs-target="#pettyModal">
                                <i class="bi bi-pencil-square"></i>
                            </button>

                            <form class="d-inline"
                                  hx-post="@Url.Action("DeleteExpense", "PettyCash", new { id = item.Id, pettyCashId = item.PettyCashId })"
                                  hx-confirm="Are you sure you want to delete this expense?"
                                  hx-swap="none">
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger"
                                        title="@(isApproved ? "Cannot delete: Already Approved" : "Delete Expense")"
                                        aria-label="Delete Expense"
                                        @(isApproved ? "disabled" : "")>
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>

                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    hx-get="/DocumentManager/Index?objectId=@item.Id&objectTypeId=251"
                                    hx-target="#document-manager-content"
                                    hx-swap="innerHTML"
                                    data-bs-toggle="modal"
                                    title="Documents"
                                    data-bs-target="#documentManagerModal">
                                <i class="bi bi-paperclip"></i>
                            </button>



                            <form class="d-inline"
                                  hx-post="@Url.Action("ApproveExpense", "PettyCash", new { id = item.Id, pettyCashId = item.PettyCashId })"
                                  hx-confirm="Approve this expense?"
                                  hx-swap="none">
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-outline-success"
                                        title="Approve Expense"
                                        aria-label="Approve Expense"
                                        @(isApproved || isRejected ? "disabled" : "")>
                                    <i class="bi bi-check-circle"></i>
                                </button>
                            </form>

                            <form class="d-inline"
                                  hx-post="@Url.Action("RejectExpense", "PettyCash", new { id = item.Id, pettyCashId = item.PettyCashId })"
                                  hx-confirm="Reject this expense?"
                                  hx-swap="none">
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-outline-warning"
                                        title="Reject Expense"
                                        aria-label="Reject Expense"
                                        @(isApproved || isRejected ? "disabled" : "")>
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            </form>








                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
