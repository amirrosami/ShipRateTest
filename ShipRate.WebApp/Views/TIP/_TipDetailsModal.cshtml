@using ShipRate.Application.DTOs
@model TipEditDto

<div class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">TIP Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <dl class="row">
                    <dt class="col-sm-3">TIP No</dt>
                    <dd class="col-sm-9">@Model.TIPNo</dd>

                    <dt class="col-sm-3">TIP Date</dt>
                    <dd class="col-sm-9">@Model.TIPDate.ToString("yyyy-MM-dd")</dd>

                    <dt class="col-sm-3">Expiry Date</dt>
                    <dd class="col-sm-9">@Model.TIPExpiryDate.ToString("yyyy-MM-dd")</dd>

                    <dt class="col-sm-3">Voyage / Vessel / Port</dt>
                    <dd class="col-sm-9">@Model.VoyageDisplayText</dd>

                    <dt class="col-sm-3">Remarks</dt>
                    <dd class="col-sm-9">@Model.Remarks</dd>

                    <dt class="col-sm-3">Active</dt>
                    <dd class="col-sm-9">@Model.IsActive</dd>
                </dl>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>
