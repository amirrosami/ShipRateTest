@using ShipRate.Application.DTOs
@model TipEditDto

<div class="modal fade" id="tipFormModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">

            <form method="post"
                  hx-post="@Url.Action("DeleteConfirmed", "TIP", new { id = Model.Id })"
                  hx-target="#tip-grid"
                  hx-swap="innerHTML">

                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">Delete TIP</h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <p>
                        Are you sure you want to delete TIP
                        <strong>@Model.TIPNo</strong> ?
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger">
                        Delete
                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>
