@using ShipRate.Domain.Entities.Contract
<!-- Views/FACContracts/_Form.cshtml -->
@model FACContract


<form hx-post="@Url.Action(Model.Id == Guid.Empty ? "Create" : "Edit")"
      hx-target="#modalBody"
      hx-swap="outerHTML">

<input type="hidden" asp-for="Id"/>

<div class="row g-3">

<div class="col-md-6">
<label class="form-label">Title</label>
<input asp-for="FacContractTitle" class="form-control"/>
</div>

<div class="col-md-6">

<label class="form-label">Carrier</label>

<div id="carrierBox">

<input type="hidden" name="CarrierId" value="@Model.CarrierId"/>

<input type="text"
       class="form-control"
       value="@Model.Carrier?.Person.PersonName"
       placeholder="Search carrier..."
       hx-get="/FACContracts/SearchCarrier"
       hx-trigger="keyup changed delay:300ms"
       hx-target="#carrierResults"
       name="term"/>

<div id="carrierResults"></div>

</div>

</div>

<div class="col-md-6">

<label class="form-label">Forwarder</label>

<div id="forwarderBox">

<input type="hidden" name="ForwarderId" value="@Model.ForwarderId"/>

<input type="text"
       class="form-control"
       value="@Model.Customer?.Person.PersonName"
       placeholder="Search forwarder..."
       hx-get="/FACContracts/SearchForwarder"
       hx-trigger="keyup changed delay:300ms"
       hx-target="#forwarderResults"
       name="term"/>

<div id="forwarderResults"></div>

</div>

</div>

<div class="col-md-6">

<label class="form-label">Currency</label>

<div id="currencyBox">

<input type="hidden" name="CurrencyId" value="@Model.CurrencyId"/>

<input type="text"
       class="form-control"
       value="@Model.Currency?.CurrencyCode"
       placeholder="Search currency..."
       hx-get="/FACContracts/SearchCurrency"
       hx-trigger="keyup changed delay:300ms"
       hx-target="#currencyResults"
       name="term"/>

<div id="currencyResults"></div>

</div>

</div>

<div class="col-md-4">
<label class="form-label">FAC Percent</label>
<input asp-for="FACPercent" class="form-control"/>
</div>

<div class="col-md-4">
<label class="form-label">FAC Per TEU</label>
<input asp-for="FACPerTEU" class="form-control"/>
</div>

<div class="col-md-4">
<label class="form-label">FAC Per CBM</label>
<input asp-for="FACPerCBM" class="form-control"/>
</div>

<div class="col-md-6">
<label class="form-label">Start Date</label>
<input asp-for="StartDate" type="date" class="form-control"/>
</div>

<div class="col-md-6">
<label class="form-label">End Date</label>
<input asp-for="EndDate" type="date" class="form-control"/>
</div>

<div class="col-12">
<label class="form-label">Remarks</label>
<input asp-for="FacContractRemarks" class="form-control"/>
</div>

<div class="col-12 text-end">
<button class="btn btn-primary">Save</button>
</div>

</div>

</form>
