@using ShipRate.Application.DTOs.Notif
@model NotificationRuleDeleteDto

<div class="modal-header">
    <h5 class="modal-title">Delete Notification Rule</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<form asp-action="DeleteConfirmed" method="post" onsubmit="return submitModalForm(this);" dir="ltr">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />

    <div class="modal-body">
        <p>Are you sure you want to delete this notification rule?</p>

        <ul>
            <li><strong>Activity Type:</strong> @Model.ActivityType</li>
            <li><strong>Entity Type:</strong> @Model.EntityTypeName</li>
            <li><strong>Recipient Mode:</strong> @Model.RecipientModeName</li>
        </ul>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Delete</button>
    </div>
</form>
