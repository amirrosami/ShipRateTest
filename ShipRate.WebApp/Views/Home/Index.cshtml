@using System.Text.Json
@using ShipRate.Application.ViewModels.Dashboard
@model DashboardVm
@{
    ViewData["Title"] = "Dashboard";
}


<style>
    .customer-growth-chart-wrapper {
        position: relative;
        width: 100%;
        height: 105px;
        margin-top: .75rem;
    }

        .customer-growth-chart-wrapper canvas {
            width: 100% !important;
            height: 105px !important;
        }

    .customer-total-value {
        color: #435971 !important;
        font-size: 1.5rem;
        font-weight: 700;
    }

    .customer-growth-summary .small {
        font-size: .72rem;
    }

    .shipping-route {
        color: #435971 !important;
        font-weight: 600;
    }

    .shipment-count {
        display: inline-block;
        min-width: 70px;
        padding: .35rem .65rem;
        border-radius: .375rem;
        background-color: rgba(105, 108, 255, .12);
        color: #696cff !important;
        font-size: .875rem;
        font-weight: 700;
        text-align: center;
    }


    .monthly-revenue-list {
        display: flex;
        flex-direction: column;
        gap: .45rem;
    }

    .monthly-revenue-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        min-height: 38px;
        padding: .45rem .65rem;
        border-radius: .375rem;
        background-color: rgba(67, 89, 113, .06);
    }

        .monthly-revenue-row .revenue-amount {
            color: #2f3a4a !important;
            font-size: 1.05rem;
            font-weight: 700;
            line-height: 1;
        }

        .monthly-revenue-row .revenue-currency {
            color: #697a8d !important;
            font-size: .82rem;
            font-weight: 600;
        }

        .monthly-revenue-row .stat-change {
            margin: 0;
            font-size: .78rem;
            font-weight: 700;
        }

            .monthly-revenue-row .stat-change i {
                font-size: 1.1rem;
                vertical-align: -0.12rem;
            }


    .monthly-finance-list {
        display: flex;
        flex-direction: column;
        gap: .4rem;
    }

    .monthly-finance-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .5rem;
        min-height: 38px;
        padding: .45rem .55rem;
        border-radius: .375rem;
        background-color: rgba(67, 89, 113, .06);
    }

    .monthly-finance-currency {
        min-width: 36px;
        color: #566a7f;
        font-size: .75rem;
        font-weight: 700;
    }

    .monthly-finance-values {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: .65rem;
        font-size: .78rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .finance-revenue {
        color: #28a745 !important;
    }

    .finance-expense {
        color: #dc3545 !important;
    }

    .finance-net {
        color: #566a7f;
        border-left: 1px solid rgba(67, 89, 113, .18);
        padding-left: .65rem;
    }

        .finance-net.text-success {
            color: #28a745 !important;
        }

        .finance-net.text-danger {
            color: #dc3545 !important;
        }

    .monthly-finance-values i {
        font-size: .85rem;
    }

    .monthly-finance-legend {
        display: flex;
        flex-wrap: wrap;
        gap: .55rem;
        font-size: .67rem;
        font-weight: 600;
    }

</style>




