        <div class="col-lg-4" id="dashboard-tasks-container"
             hx-get="@Url.Action("DashboardWidget", "AppTasks")"
             hx-trigger="load"
             hx-target="#dashboard-tasks-container"
             hx-swap="innerHTML">
        </div>

    </div>



    <div class="row g-3 mb-4">
        <!-- Top Shipping Routes -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-transparent border-0">
                    <h6 class="mb-0 fw-semibold">
                        Top Shipping Routes
                    </h6>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Route</th>
                                    <th class="text-center">Shipments</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (Model.TopShippingRoutes?.Any() == true)
                                {
                                    foreach (var route in Model.TopShippingRoutes)
                                    {
                                        <tr>
                                            <td>
                                                <div class="shipping-route">
                                                    @route.Route
                                                </div>
                                            </td>

                                            <td class="text-center">
                                                <span lass="shipment-count">
                                                    @route.ShipmentCount.ToString("N0")
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="2"
                                            class="text-center text-muted py-4">
                                            No shipping routes found.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>



        <div class="col-lg-4" id="dashboard-activity-container"
             hx-get="@Url.Action("ActivityFeedWidget", "Home")"
             hx-trigger="load, every 60s"
             hx-target="#dashboard-activity-container"
             hx-swap="innerHTML">
        </div>
    </div>

    <div class="offcanvas offcanvas-end" tabindex="-1" id="appTaskDrawer" style="width: 720px;">
        <div class="offcanvas-body p-0" id="appTaskDrawerContent"></div>
    </div>






