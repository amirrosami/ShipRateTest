        <!-- Customer Growth - Last 6 Months -->
        <div class="col-xl-3 col-md-6 fade-in fade-in-delay-4">
            <div class="stat-card h-100">

                <div class="d-flex justify-content-between align-items-start">
                    <div class="stat-icon"
                         style="background: rgba(3,195,236,0.1); color: var(--sneat-info);">
                        <i class="bi bi-people"></i>
                    </div>

                    <span class="badge bg-label-info">
                        Last 6 Months
                    </span>
                </div>

                <div class="stat-label mt-3">
                    Customer Growth
                </div>

                <div class="customer-growth-summary">
                    <div class="stat-value customer-total-value">
                        @Model.CustomerGrowth.TotalCustomers.ToString("N0")
                    </div>

                    <div class="small text-muted">
                        New Customers
                    </div>
                </div>

                <div class="customer-growth-chart-wrapper">
                    <canvas id="customerGrowthChart"></canvas>
                </div>

                @{
                    var customerChangeClass =
                    Model.CustomerGrowth.IsIncrease
                    ? "text-success"
                    : "text-danger";

                    var customerChangeIcon =
                    Model.CustomerGrowth.IsIncrease
                    ? "bi-arrow-up-short"
                    : "bi-arrow-down-short";
                }

                <div class="stat-change @customerChangeClass mt-2">
                    <i class="bi @customerChangeIcon"></i>

                    @if (Model.CustomerGrowth.PreviousMonthCount == 0)
                    {
                        <span>
                            @Model.CustomerGrowth.CurrentMonthCount.ToString("N0")
                            new this month
                        </span>
                    }
                    else
                    {
                        <span>
                            @Math.Abs(Model.CustomerGrowth.ChangePercent).ToString("N1")%
                            vs last month
                        </span>
                    }
                </div>
            </div>
        </div>





        <div class="col-xl-3 col-md-6 fade-in fade-in-delay-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body pt-0 d-flex flex-column align-items-center justify-content-center">

                    <div class="stat-label align-self-start mt-3 mb-2">
                        Transportation Mode
                    </div>

                    @if (Model.TransportationModes?.Any() == true)
                    {
                        <div style="position: relative; height: 220px; width: 220px;">
                            <canvas id="chartDoughnut"></canvas>
                        </div>

                        <div class="d-flex flex-wrap gap-3 mt-3 small justify-content-center">
                            @foreach (var item in Model.TransportationModes)
                            {
                                <span class="text-nowrap">
                                    <i class="bi bi-circle-fill me-1"
                                       style="color: @item.Color"></i>
                                    @item.Title @item.Percentage.ToString("N0")%
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small py-5">
                            No jobs found for this month.
                        </div>
                    }
                </div>
            </div>
        </div>










