    @section Styles {
        @* Page-specific styles can go here *@
    }

    @section Scripts {
        <script>
                        document.addEventListener('DOMContentLoaded', function () {
                            const transportationModes = @Html.Raw(
                                                                                                                                        JsonSerializer.Serialize(Model.TransportationModes ?? [])
                                                                                                        );

    const chartCanvas = document.getElementById('chartDoughnut');

                            if (!chartCanvas || !transportationModes.length) {
                                return;
                            }

                            new Chart(chartCanvas, {
                                type: 'doughnut',
                                data: {
                                    labels: transportationModes.map(x => x.Title),
                                    datasets: [{
                                        data: transportationModes.map(x => x.Count),
                                        backgroundColor: transportationModes.map(x => x.Color),
                                        borderWidth: 0,
                                        hoverOffset: 8
                                    }]
                                },
                                options: {
                                    responsive: true,
                                    maintainAspectRatio: false,
                                    cutout: '68%',
                                    plugins: {
                                        legend: {
                                            display: false
                                        },
                                        tooltip: {
                                            callbacks: {
                                                label: function (context) {
                                                    const item = transportationModes[context.dataIndex];

                                                    return `${item.Title}: ${item.Count.toLocaleString()} Jobs (${item.Percentage}%)`;
                                                }
                                            }
                                        }
                                    }
                                }
                            });
                        });
        </script>






        <script>

                            const colors = {
                            primary: '#4e73df',
                            success: '#1cc88a',
                            info: '#36b9cc',
                            warning: '#f6c23e',
                            danger: '#e74a3b',
                            secondary: '#858796',
                            light: '#f8f9fc'
                            };

                            // ===== HELPER: get CSS var or fallback =====
                            function textColor() {
                            return getComputedStyle(document.documentElement)
                            .getPropertyValue('--bs-body-color').trim() || '#333';
                            }
                            function gridColor() {
                            return 'rgba(128,128,128,0.15)';
                            }

                        document.addEventListener('DOMContentLoaded', function () {
                            const initialChartData = @Html.Raw(
                                                                                JsonSerializer.Serialize(
                                                                                                                Model.ShipmentVolume,
                                                                                                                new JsonSerializerOptions
                                                                                                                {
                                                                                                                                PropertyNamingPolicy = JsonNamingPolicy.CamelCase
                                                                                                                })
                                                );

    const chartCanvas = document.getElementById('chartVolume');

                            if (!chartCanvas) {
                                return;
                            }

                            const volumeChart = new Chart(chartCanvas, {
                                type: 'line',
                                data: {
                                    labels: initialChartData.labels,
                                    datasets: [
                                        {
                                            label: initialChartData.currentPeriodLabel,
                                            data: initialChartData.currentPeriodData,
                                            borderColor: colors.primary,
                                            backgroundColor: 'rgba(78,115,223,0.12)',
                                            fill: true,
                                            tension: 0.4,
                                            pointRadius: 4,
                                            pointBackgroundColor: '#fff',
                                            pointBorderWidth: 2
                                        },
                                        {
                                            label: initialChartData.previousPeriodLabel,
                                            data: initialChartData.previousPeriodData,
                                            borderColor: colors.secondary,
                                            backgroundColor: 'transparent',
                                            borderDash: [5, 5],
                                            fill: false,
                                            tension: 0.4,
                                            pointRadius: 3,
                                            pointBackgroundColor: '#fff',
                                            pointBorderWidth: 2
                                        }
                                    ]
                                },
                                options: {
                                    responsive: true,
                                    maintainAspectRatio: false,
                                    plugins: {
                                        legend: {
                                            position: 'top',
                                            labels: {
                                                usePointStyle: true,
                                                padding: 20,
                                                color: textColor()
                                            }
                                        },
                                        tooltip: {
                                            callbacks: {
                                                label: function (context) {
                                                    return `${context.dataset.label}: ${context.raw.toLocaleString()} Jobs`;
                                                }
                                            }
                                        }
                                    },
                                    scales: {
                                        x: {
                                            grid: {
                                                display: false
                                            },
                                            ticks: {
                                                color: textColor()
                                            }
                                        },
                                        y: {
                                            beginAtZero: true,
                                            ticks: {
                                                precision: 0,
                                                color: textColor(),
                                                callback: function (value) {
                                                    return value.toLocaleString();
                                                }
                                            },
                                            grid: {
                                                color: gridColor()
                                            }
                                        }
                                    }
                                }
                            });

                            function updateShipmentVolumeChart(chartData) {
                                volumeChart.data.labels = chartData.labels;

                                volumeChart.data.datasets[0].label = chartData.currentPeriodLabel;
                                volumeChart.data.datasets[0].data = chartData.currentPeriodData;

                                volumeChart.data.datasets[1].label = chartData.previousPeriodLabel;
                                volumeChart.data.datasets[1].data = chartData.previousPeriodData;

                                volumeChart.update();
                            }

                            document.querySelectorAll('#shipmentVolumeRangeButtons button')
                                .forEach(function (button) {
                                    button.addEventListener('click', async function () {
                                        const range = this.dataset.range;

                                        if (!range || this.classList.contains('active')) {
                                            return;
                                        }

                                        const buttons = document.querySelectorAll(
                                            '#shipmentVolumeRangeButtons button'
                                        );

                                        buttons.forEach(btn => btn.disabled = true);

                                        try {
                                            const response = await fetch(
                                                `@Url.Action("ShipmentVolumeData", "Home")?range=${encodeURIComponent(range)}`,
                                                {
                                                    headers: {
                                                        'X-Requested-With': 'XMLHttpRequest'
                                                    }
                                                }
                                            );

                                            if (!response.ok) {
                                                throw new Error('Unable to load shipment volume data.');
                                            }

                                            const chartData = await response.json();

                                            updateShipmentVolumeChart(chartData);

                                            buttons.forEach(btn => btn.classList.remove('active'));
                                            this.classList.add('active');
                                        }
                                        catch (error) {
                                            console.error(error);
                                        }
                                        finally {
                                            buttons.forEach(btn => btn.disabled = false);
                                        }
                                    });
                                });
                        });
        </script>


        <script>
                document.addEventListener('DOMContentLoaded', function () {
                    const customerGrowthData = @Html.Raw(
                                        JsonSerializer.Serialize(
                                                        Model.CustomerGrowth,
                                                        new JsonSerializerOptions
                                                        {
                                                                    PropertyNamingPolicy = JsonNamingPolicy.CamelCase
                                                        })
                        );

    const chartCanvas =
        document.getElementById('customerGrowthChart');

                    if (!chartCanvas) {
                        return;
                    }

                    const chartContext = chartCanvas.getContext('2d');

                    const gradient = chartContext.createLinearGradient(
                        0,
                        0,
                        0,
                        120
                    );

                    gradient.addColorStop(
                        0,
                        'rgba(3, 195, 236, 0.30)'
                    );

                    gradient.addColorStop(
                        1,
                        'rgba(3, 195, 236, 0.02)'
                    );

                    new Chart(chartCanvas, {
                        type: 'line',
                        data: {
                            labels: customerGrowthData.labels,
                            datasets: [
                                {
                                    label: 'New Customers',
                                    data: customerGrowthData.counts,
                                    borderColor: '#03c3ec',
                                    backgroundColor: gradient,
                                    fill: true,
                                    tension: 0.4,
                                    pointRadius: 3,
                                    pointHoverRadius: 5,
                                    pointBackgroundColor: '#ffffff',
                                    pointBorderColor: '#03c3ec',
                                    pointBorderWidth: 2
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,

                            plugins: {
                                legend: {
                                    display: false
                                },

                                tooltip: {
                                    callbacks: {
                                        label: function (context) {
                                            return `${context.raw.toLocaleString()} new customers`;
                                        }
                                    }
                                }
                            },

                            scales: {
                                x: {
                                    grid: {
                                        display: false
                                    },
                                    ticks: {
                                        color: '#697a8d',
                                        maxRotation: 45,
                                        minRotation: 0,
                                        font: {
                                            size: 9
                                        }
                                    }
                                },

                                y: {
                                    beginAtZero: true,
                                    suggestedMax: 5,
                                    grid: {
                                        color: 'rgba(67, 89, 113, 0.10)'
                                    },
                                    ticks: {
                                        precision: 0,
                                        color: '#697a8d',
                                        font: {
                                            size: 9
                                        }
                                    }
                                }
                            }
                        }
                    });
                });
        </script>




    }
