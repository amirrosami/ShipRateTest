@{
    ViewData["Title"] = "Dashboard";
}

<div style="margin-bottom: 1.5rem;">
    <h1 style="font-family: 'Outfit', sans-serif; font-size: 2rem; font-weight: 700; color: var(--gray-900); margin-bottom: 0.5rem;">Dashboard Overview</h1>
    <p style="color: var(--gray-500); font-size: 0.95rem;">Welcome back! Here's what's happening with your system today.</p>
</div>

<!-- STATS CARDS -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon blue">
            <i class="fas fa-users"></i>
        </div>
        <div class="stat-value">1,842</div>
        <div class="stat-label">Total Users</div>
        <div class="stat-change up">
            <i class="fas fa-arrow-up"></i>
            <span>12% from last month</span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon success">
            <i class="fas fa-user-check"></i>
        </div>
        <div class="stat-value">1,654</div>
        <div class="stat-label">Active Users</div>
        <div class="stat-change up">
            <i class="fas fa-arrow-up"></i>
            <span>8% increase</span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon warning">
            <i class="fas fa-user-tag"></i>
        </div>
        <div class="stat-value">24</div>
        <div class="stat-label">User Roles</div>
        <div class="stat-change">
            <i class="fas fa-minus"></i>
            <span>No change</span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon danger">
            <i class="fas fa-key"></i>
        </div>
        <div class="stat-value">156</div>
        <div class="stat-label">Permissions</div>
        <div class="stat-change down">
            <i class="fas fa-arrow-down"></i>
            <span>3 removed</span>
        </div>
    </div>
</div>

<!-- RECENT USERS TABLE -->
<div class="data-table-wrapper">
    <div class="table-header">
        <h2 class="table-title">Recent Users</h2>
        <div class="table-actions">
            <button class="btn-secondary">
                <i class="fas fa-download" style="margin-right: 0.5rem;"></i>
                Export
            </button>
            <button class="btn-primary">
                <i class="fas fa-plus" style="margin-right: 0.5rem;"></i>
                Add User
            </button>
        </div>
    </div>

    <table class="data-table">
