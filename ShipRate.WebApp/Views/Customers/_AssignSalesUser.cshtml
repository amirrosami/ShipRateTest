@model ShipRate.WebApp.ViewModels.CustomersVms.AssignSalesUserViewModel

<div class="modal-header bg-info text-white">
    <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i>Assign Sales User</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
</div>

<form hx-post="/Customers/AssignSalesUser"
      hx-target="#modal-content2"
      hx-swap="innerHTML">
    @Html.AntiForgeryToken()
    <input type="hidden" name="CustomerId" value="@Model.CustomerId" />

    <div class="modal-body">
        <div class="mb-3">
            <label class="form-label">Sales User</label>

            <select asp-for="SelectedSalesUserId"
                    class="form-select">

                <option value="">-- Select --</option>
                @foreach (var user in @ViewBag.SalesUsers)
                {
                    <option value="@user.Id"
                            selected="@(user.Id == Model.CurrentSalesUserId)">@user.FullName</option>
                }

            </select>
            <span asp-validation-for="SelectedSalesUserId" class="text-danger"></span>




@*             <select asp-for="@Model.SelectedSalesUserId" name="SelectedSalesUserId" class="form-select" required>
                <option value="" >-- Select --</option>
                @foreach (var user in @ViewBag.SalesUsers)
                {
                    <option value="@user.Id"
                            selected="@(user.Id == Model.CurrentSalesUserId)">@user.FullName</option>
                }
            </select>
 *@

</div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-info text-white">
            <i class="bi bi-check-lg me-1"></i>Assign
        </button>
    </div>
</form>
