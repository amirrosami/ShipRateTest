                            <div hx-get="@Url.Action("BLSummary", "DeliveryOrders", new { blId = Model.BLId.Value })"
                                 hx-trigger="load"
                                 hx-swap="innerHTML">
                                <div class="text-center py-2">
                                    <span class="spinner-border spinner-border-sm text-secondary"></span> Loading BL details...
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="card shadow-sm">
                                <div class="card-header">BL Summary</div>
                                <div class="card-body text-muted">
