@using ShipRate.Application.ViewModels
@model CreateDeliveryOrderPageVm
@{
    var isEditMode = Model.DeliveryOrderId.HasValue && Model.DeliveryOrderId.Value != Guid.Empty;
    ViewData["Title"] = isEditMode ? "Edit Delivery Order" : "Create Delivery Order";

    var isFinalized = Model.StatusText == "Finalized" || Model.StatusText == "Cancelled";
}
<div class="container-fluid py-1" dir="ltr">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <h4 class="mb-0">@ViewData["Title"]</h4>
        <div class="d-flex gap-2">
            @if (!isFinalized)
            {
                <button type="button"
                        class="btn btn-outline-secondary"
                        hx-post="@Url.Action("SaveDraft", "DeliveryOrders")"
                        hx-include="#deliveryOrderCreateForm"
                        hx-target="#saveDraftResult">
                    <i class="bi bi-save"></i> Save Draft
                </button>
                <button type="button"
                        id="btnFinalize"
                        class="btn btn-success"
                        @(isEditMode ? "" : "disabled")
                        hx-post="@Url.Action("Finalize", "DeliveryOrders")"
                        hx-include="#deliveryOrderCreateForm"
                        hx-target="#finalizeResult"
                        hx-swap="innerHTML">
                    Finalize DO
                </button>
            }

            <a id="detailsButton"
               class="btn btn-outline-secondary @(isEditMode ? "" : "d-none")"
               href="@(isEditMode? Url.Action("Details", "DeliveryOrders", new { id = Model.DeliveryOrderId }) : "#")">
                Details
            </a>

            <a id="printButton"
               class="btn btn-outline-dark @(isFinalized ? "" : "d-none")"
               href="@(isEditMode? Url.Action("Print", "DeliveryOrders", new { id = Model.DeliveryOrderId }) : "#")"
               target="_blank">
                Print
            </a>
        </div>
    </div>

    <form id="deliveryOrderCreateForm" autocomplete="off">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="DeliveryOrderId" id="DeliveryOrderId" />
        <input type="hidden" asp-for="BLId" id="BLId" />

        <fieldset @(isFinalized ? "disabled" : "")>
            <div class="row g-3">
                <div class="col-12">

                    @if (false)
                        {
                            <div class="row g-3 align-items-end">
                                @* تراز کردن ستون‌ها از کف *@
                                <div class="col-md-3">
                                    <label asp-for="BLNo" class="form-label">Transport Doc (BL) No</label>
                                    <div class="input-group">
                                        <input asp-for="BLNo" id="BLNo" class="form-control" readonly />
                                        @if (!isFinalized && !isEditMode)
                                        {
                                            <button type="button"
                                            class="btn btn-outline-primary"
                                            hx-get="@Url.Action("BLSearchModal", "DeliveryOrders")"
                                            hx-target="#globalModalContent"
                                            hx-swap="innerHTML"
                                            data-bs-toggle="modal"
                                            data-bs-target="#globalModal">
                                                Select BL
                                            </button>
                                        }
                                    </div>
                                    @* حذف فاصله اضافی زیر Validation *@
                                    <span asp-validation-for="BLId" class="text-danger small d-block" style="height:0;"></span>
                                </div>

                                @* تغییر col-md-3 به col-auto برای چسبیدن به فیلد قبلی و حذف مارجین اضافی *@
                                <div class="col-auto mb-0" id="saveDraftResult">
                                    @* اینجا محل قرارگیری Alert است *@
                                </div>
                            </div>
                        }

                    <!-- کانتینر لود خودکار اطلاعات بارنامه -->
