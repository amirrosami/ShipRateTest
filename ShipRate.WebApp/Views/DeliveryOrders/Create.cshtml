                    <div class="card shadow-sm">
                        <div class="card-header">
                            Delivery Order Information
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label asp-for="DOOperationalModeId" class="form-label">Operational Mode</label>
                                    <select asp-for="DOOperationalModeId" asp-items="Model.DOOperationalModes" class="form-select">
                                        <option value="">Select...</option>
                                    </select>
                                    <span asp-validation-for="DOOperationalModeId" class="text-danger small"></span>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="DONo" class="form-label">DO No</label>
                                    <input asp-for="DONo" class="form-control" />
                                    <span asp-validation-for="DONo" class="text-danger small"></span>
                                </div>

                                <div class="col-md-3">
                                    <label asp-for="DoDate" class="form-label">DO Date</label>
                                    <input asp-for="DoDate" type="date" class="form-control" value="@Model.DoDate.ToString("yyyy-MM-dd")" />
                                    <span asp-validation-for="DoDate" class="text-danger small"></span>
                                </div>

                                <div class="col-md-3">
                                    <label asp-for="ArrivalDate" class="form-label">Arrival Date</label>
                                    <input asp-for="ArrivalDate" type="date" class="form-control" value="@Model.ArrivalDate?.ToString("yyyy-MM-dd")" />
                                    <span asp-validation-for="ArrivalDate" class="text-danger small"></span>
                                </div>


                                <div class="col-md-3">
                                    <label asp-for="CarrierId" class="form-label">Carrier</label>
                                    <select asp-for="CarrierId" asp-items="Model.Carriers" class="form-select">
                                        <option value="">Select...</option>
                                    </select>
                                    <span asp-validation-for="CarrierId" class="text-danger small"></span>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="CarrierAgentId" class="form-label">Carrier Agent</label>
                                    <select asp-for="CarrierAgentId" asp-items="Model.Agents" class="form-select">
                                        <option value="">Select...</option>
                                    </select>
                                    <span asp-validation-for="CarrierAgentId" class="text-danger small"></span>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="ExternalIssuerId" class="form-label">External Issuer</label>
                                    <select asp-for="ExternalIssuerId" asp-items="Model.ExternalIssuers" class="form-select">
                                        <option value="">Select...</option>
                                    </select>
                                    <span asp-validation-for="ExternalIssuerId" class="text-danger small"></span>
                                </div>

                                <div class="col-md-3">
                                    <label asp-for="ExternalIssuerText" class="form-label">External Issuer Text</label>
                                    <input asp-for="ExternalIssuerText" class="form-control" />
                                    <span asp-validation-for="ExternalIssuerText" class="text-danger small"></span>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="ReceivedAtDateTime" class="form-label">Received Date Time </label>
                                    <input asp-for="ReceivedAtDateTime" type="date" class="form-control" value="@Model.ExpiryDate" />
                                    <span asp-validation-for="ReceivedAtDateTime" class="text-danger small"></span>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="ReceivedByUserId" class="form-label">Received By User</label>
                                    <select asp-for="ReceivedByUserId" asp-items="Model.Users" class="form-select">
                                        <option value="">Select...</option>
                                    </select>
                                    <span asp-validation-for="ReceivedByUserId" class="text-danger small"></span>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="ReceiveMethodId" class="form-label">Receive Method</label>
                                    <select asp-for="ReceiveMethodId" asp-items="Model.ReceiveMethods" class="form-select">
                                        <option value="">Select...</option>
                                    </select>
                                    <span asp-validation-for="ReceiveMethodId" class="text-danger small"></span>
                                </div>


                                <div class="col-md-3">
                                    <label asp-for="ExpiryDate" class="form-label">Expiry Date</label>
                                    <input asp-for="ExpiryDate" type="date" class="form-control" value="@Model.ExpiryDate?.ToString("yyyy-MM-dd")" />
                                    <span asp-validation-for="ExpiryDate" class="text-danger small"></span>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="ClearanceTypeId" class="form-label">Clearance Type</label>
                                    <select asp-for="ClearanceTypeId" asp-items="Model.ClearanceTypes" class="form-select">
                                        <option value="">Select...</option>
                                    </select>
                                    <span asp-validation-for="ClearanceTypeId" class="text-danger small"></span>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="TIPId" class="form-label">TIP</label>
                                    <select asp-for="TIPId" asp-items="Model.TIPs" class="form-select">
                                        <option value="">Select...</option>
                                    </select>
                                    <span asp-validation-for="TIPId" class="text-danger small"></span>
                                </div>


                                <div class="col-md-3">
                                    <label asp-for="BLReleaseTypeId" class="form-label">Release Type</label>
                                    <select asp-for="BLReleaseTypeId" asp-items="Model.BLReleaseTypes" class="form-select">
                                        <option value="">Select...</option>
                                    </select>
                                    <span asp-validation-for="BLReleaseTypeId" class="text-danger small"></span>
                                </div>

                                <div class="col-md-3">
                                    <label asp-for="OriginalBLCount" class="form-label">Original BL Count</label>
                                    <input asp-for="OriginalBLCount" type="number" min="0" class="form-control" />
                                    <span asp-validation-for="OriginalBLCount" class="text-danger small"></span>
                                </div>

                                <div class="col-12">
                                    <label asp-for="Remarks" class="form-label">Remarks</label>
                                    <textarea asp-for="Remarks" rows="4" class="form-control"></textarea>
                                    <span asp-validation-for="Remarks" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </fieldset>
    </form>
</div>

<div id="finalizeResult" class="mt-2"></div>
<div class="modal fade" id="globalModal" tabindex="-1" aria-hidden="true" data-bs-bacldrop="static" data-bs-keyborad="false">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content" id="globalModalContent">
        </div>
    </div>
</div>





<!-- کانتینر پنل مستندات -->
<div id="documentPanelContainer" class="mt-3">
    @if (Model.DeliveryOrderId.HasValue && Model.DeliveryOrderId.Value != Guid.Empty)
    {
        <!-- بارگذاری خودکار پنل مستندات پس از ذخیره اولیه یا در صفحه ویرایش -->
        <div hx-get="@Url.Action("DocumentPanel", "DeliveryOrders", new { deliveryOrderId = Model.DeliveryOrderId.Value })"
             hx-trigger="load"
             hx-swap="outerHTML">
            <div class="text-center py-3">
                <span class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></span>
                <span class="ms-2 text-muted">Loading documents...</span>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function selectBL(blId, blNo) {
            document.getElementById('BLId').value = blId;
            document.getElementById('BLNo').value = blNo;

            htmx.ajax('GET', '@Url.Action("BLSummary", "DeliveryOrders")?blId=' + blId, {
                target: '#blSummaryContainer',
                swap: 'innerHTML'
            });

        htmx.ajax('GET', '@Url.Action("GetBlCharges", "DeliveryOrders")?blId=' + blId, {
                       target: '#bl-charges-container',
                       swap: 'innerHTML'
                   });

            htmx.ajax('GET', '@Url.Action("GetBlInvoices", "DeliveryOrders")?blId=' + blId, {
                target: '#bl-invoices-container',
                swap: 'innerHTML'
            });
            bootstrap.Modal.getInstance(document.getElementById('globalModal')).hide();
        }

        document.body.addEventListener('fillBLDetails', function(evt) {
            const data = evt.detail.value;
            if(data.arrivalDate) {
                document.getElementById('ArrivalDate').value = data.arrivalDate;
            }
        });

        document.body.addEventListener('htmx:afterSwap', function (evt) {
            if (evt.target.id !== 'saveDraftResult') {
                return;
            }

            const successNode = evt.target.querySelector('[data-save-success="true"]');
            if (!successNode) {
                return;
            }

            const deliveryOrderId = successNode.getAttribute('data-delivery-order-id');
            if (!deliveryOrderId) {
                return;
            }

            document.getElementById('DeliveryOrderId').value = deliveryOrderId;

            const finalizeButton = document.getElementById('btnFinalize');
            if (finalizeButton) {
                finalizeButton.disabled = false;
            }

            const detailsButton = document.getElementById('detailsButton');
            if (detailsButton) {
                detailsButton.href = '/DeliveryOrders/Details/' + deliveryOrderId;
                detailsButton.classList.remove('d-none');
            }

            // لود مجدد پنل مستندات پس از اولین ذخیره موقت موفق
            htmx.ajax('GET', '@Url.Action("DocumentPanel", "DeliveryOrders")?deliveryOrderId=' + deliveryOrderId, {
                target: '#documentPanelContainer',
                swap: 'innerHTML'
            });
        });

        document.body.addEventListener('htmx:afterSwap', function (evt) {
            if (evt.target.id !== 'finalizeResult') {
                return;
            }

            const successNode = evt.target.querySelector('[data-finalize-success="true"]');
            if (!successNode) {
                return;
            }

            document.querySelectorAll('#deliveryOrderCreateForm input, #deliveryOrderCreateForm select, #deliveryOrderCreateForm textarea, #deliveryOrderCreateForm button')
                .forEach(function (el) {
                    if (el.id !== 'btnNewDo') {
                        el.disabled = true;
                    }
                });

            const detailsButton = document.getElementById('detailsButton');
            if (detailsButton) {
                detailsButton.href = '/DeliveryOrders/Details/' + deliveryOrderId;
                detailsButton.classList.remove('d-none');
            }

            const printButton = document.getElementById('printButton');
            if (printButton) {
                printButton.href = '/DeliveryOrders/Print/' + deliveryOrderId;
                printButton.classList.remove('d-none');
            }

            const detailsUrl = successNode.getAttribute('data-details-url');
            if (detailsUrl) {
                window.location.href = detailsUrl;
            }
        });
    </script>
}
