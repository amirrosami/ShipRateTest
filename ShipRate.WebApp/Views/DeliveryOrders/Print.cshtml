@model DeliveryOrderDetailsVm
@{
    Layout = null;
    var title = string.IsNullOrWhiteSpace(Model.DONo)
        ? "Delivery Order"
        : $"Delivery Order - {Model.DONo}";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
        body {
            font-size: 12px;
            color: #212529;
            background: #fff;
        }

        .print-page {
            max-width: 1100px;
            margin: 0 auto;
            padding: 24px;
        }

        .doc-title {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .doc-subtitle {
            font-size: 13px;
            color: #6c757d;
            margin-bottom: 16px;
        }

        .section-title {
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .kv-table td {
            padding: 6px 8px;
            vertical-align: top;
        }

        .kv-label {
            width: 220px;
            font-weight: 600;
            white-space: nowrap;
        }

        .table {
            margin-bottom: 0;
        }

            .table th {
                white-space: nowrap;
                font-size: 12px;
            }

            .table td {
                font-size: 12px;
            }

        .card {
            border: 1px solid #dee2e6;
            border-radius: 0;
        }

        .card-header {
            background: #f8f9fa;
            font-weight: 700;
        }

        .print-toolbar {
            margin-bottom: 16px;
        }

        .status-badge {
            display: inline-block;
            padding: 4px 10px;
            border: 1px solid #198754;
            color: #198754;
            font-weight: 700;
            font-size: 11px;
        }

        .small-muted {
            color: #6c757d;
            font-size: 11px;
        }

        @@media print {
            .no-print {
                display: none !important;
            }

            .print-page {
                max-width: none;
                margin: 0;
                padding: 0;
            }

            .card {
                break-inside: avoid;
            }

            table {
                break-inside: auto;
            }

            tr, td, th {
                break-inside: avoid;
            }

            @@page {
                @using ShipRate.Application.ViewModels
                size: A4 portrait;
                margin: 12mm;
            }
        }
    </style>
</head>
<body>
    <div class="print-page">
        <div class="print-toolbar no-print d-flex justify-content-between align-items-center">
            <div>
                <a href="@Url.Action("Details", "DeliveryOrders", new { id = Model.DeliveryOrderId })"
                   class="btn btn-outline-secondary btn-sm">
                    Back to Details
                </a>
            </div>
            <div>
                <button type="button" class="btn btn-primary btn-sm" onclick="window.print()">
                    Print
                </button>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <div class="doc-title">Delivery Order</div>
                <div class="doc-subtitle">
                    DO No:
                    <strong>@(string.IsNullOrWhiteSpace(Model.DONo) ? "-" : Model.DONo)</strong>
                </div>
            </div>

            <div class="text-end">
                @if (Model.IsFinalized)
                {
                    <div class="status-badge">FINALIZED</div>
                }
                else
                {
                    <div class="status-badge border-secondary text-secondary">DRAFT</div>
                }

                @if (Model.FinalizedAt.HasValue)
                {
                    <div class="small-muted mt-2">
                        Finalized At: @Model.FinalizedAt.Value.ToString("yyyy-MM-dd HH:mm")
                    </div>
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">Basic Information</div>
            <div class="card-body">
                <table class="table table-borderless kv-table">
                    <tbody>
                        <tr>
                            <td class="kv-label">Delivery Order No</td>
                            <td>@(string.IsNullOrWhiteSpace(Model.DONo) ? "-" : Model.DONo)</td>
                            <td class="kv-label">DO Date</td>
                            <td>@(Model.DoDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                        </tr>
                        <tr>
                            <td class="kv-label">Expiry Date</td>
                            <td>@(Model.ExpiryDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td class="kv-label">Arrival Date</td>
                            <td>@(Model.ArrivalDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                        </tr>
                        <tr>
                            <td class="kv-label">Clearance Type</td>
                            <td>@(string.IsNullOrWhiteSpace(Model.ClearanceTypeName) ? "-" : Model.ClearanceTypeName)</td>
                            <td class="kv-label">BL Release Type</td>
                            <td>@(string.IsNullOrWhiteSpace(Model.BLReleaseTypeName) ? "-" : Model.BLReleaseTypeName)</td>
                        </tr>
                        <tr>
                            <td class="kv-label">Original BL Count</td>
                            <td>@(Model.OriginalBLCount?.ToString() ?? "-")</td>
                            <td class="kv-label">Status</td>
                            <td>@(Model.IsFinalized ? "Finalized" : "Draft")</td>
                        </tr>
                        <tr>
                            <td class="kv-label">Remarks</td>
                            <td colspan="3">@(string.IsNullOrWhiteSpace(Model.Remarks) ? "-" : Model.Remarks)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.BLSummary != null)
        {
            <div class="card mb-3">
                <div class="card-header">Bill of Lading Summary</div>
                <div class="card-body">
                    <table class="table table-borderless kv-table">
                        <tbody>
                            <tr>
                                <td class="kv-label">BL No</td>
                                <td>@(string.IsNullOrWhiteSpace(Model.BLSummary.BLNo) ? "-" : Model.BLSummary.BLNo)</td>
                                <td class="kv-label">BL Date</td>
                                @*                                 <td>@(Model.BLSummary.BLDate?.ToString("yyyy-MM-dd") ?? "-")</td>
 *@                            </tr>
                            <tr>
                                <td class="kv-label">Consignee</td>
                                @*                                 <td>@(string.IsNullOrWhiteSpace(Model.BLSummary.ConsigneeName) ? "-" : Model.BLSummary.ConsigneeName)</td>
 *@                                <td class="kv-label">Shipper</td>
                                @*                                 <td>@(string.IsNullOrWhiteSpace(Model.BLSummary.ShipperName) ? "-" : Model.BLSummary.ShipperName)</td>
 *@                            </tr>
                            <tr>
                                <td class="kv-label">Vessel / Voyage</td>
                                @*                              <td>@(string.IsNullOrWhiteSpace(Model.BLSummary.VesselVoyage) ? "-" : Model.BLSummary.VesselVoyage)</td>
    *@                             <td class="kv-label">Port of Discharge</td>
                                @*                                 <td>@(string.IsNullOrWhiteSpace(Model.BLSummary.PortOfDischargeName) ? "-" : Model.BLSummary.PortOfDischargeName)</td>
 *@                            </tr>
                            <tr>
                                <td class="kv-label">Place of Delivery</td>
                                @*                              <td>@(string.IsNullOrWhiteSpace(Model.BLSummary.PlaceOfDeliveryName) ? "-" : Model.BLSummary.PlaceOfDeliveryName)</td>
    *@                             <td class="kv-label">Container Count</td>
                                <td>@Model.Containers.Count</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div class="card mb-3">
            <div class="card-header">Containers</div>
            <div class="card-body">
                @if (Model.Containers == null || Model.Containers.Count == 0)
                {
                    <div class="text-muted">No container snapshot found.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Container No</th>
                                    <th>Size/Type</th>
                                    <th>Seal No</th>
                                    <th>Package Count</th>
                                    <th>Gross Weight</th>
                                    <th>Net Weight</th>
                                    <th>Measurement</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.Containers.Count; i++)
                                {
                                    var item = Model.Containers[i];
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td>@(item.ContainerNo ?? "-")</td>
                                        <td>@(item.ContainerSize + '-' + item.ContainerType ?? "-")</td>
                                        <td>@(item.SealNo ?? "-")</td>
                                        @*                                         <td>@(item.PackageCount?.ToString() ?? "-")</td>
                                        <td>@(item.GrossWeight?.ToString() ?? "-")</td>
                                        <td>@(item.NetWeight?.ToString() ?? "-")</td>
                                        <td>@(item.Measurement?.ToString() ?? "-")</td>
 *@
                                        <td>-</td>
                                        <td>-</td>
                                        <td>-</td>
                                        <td>-</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">Cargo / Packages</div>
            <div class="card-body">
                @if (Model.CargoItems == null || Model.CargoItems.Count == 0)
                {
                    <div class="text-muted">No cargo/package snapshot found.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Package Type</th>
                                    <th>Count</th>
                                    <th>Gross Weight</th>
                                    <th>Net Weight</th>
                                    <th>Measurement</th>
                                    <th>Marks & Numbers</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.CargoItems.Count; i++)
                                {
                                    var item = Model.CargoItems[i];
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td>@(item.PackageTypeName ?? "-")</td>
                                        <td>@(item.PackageCount?.ToString() ?? "-")</td>
                                        <td>@(item.GrossWeight?.ToString() ?? "-")</td>
                                        <td>@(item.NetWeight?.ToString() ?? "-")</td>
                                        <td>@(item.Measurement?.ToString() ?? "-")</td>
                                        <td>@(item.MarksAndNumbers ?? "-")</td>
                                        <td>@(item.DescriptionOfGoods ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</body>
</html>
