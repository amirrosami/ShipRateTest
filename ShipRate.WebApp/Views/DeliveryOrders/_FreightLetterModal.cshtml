@using ShipRate.Application.ViewModels
@model FreightLetterUpsertVm
<div class="modal fade" id="freightLetterModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" dir="ltr">

            <div class="modal-header">
                <h5 class="modal-title">Freight Letter</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form hx-post="@Url.Action("SaveFreightLetter","DeliveryOrders")"
                      hx-target="#freightLetterModalHost"
                      hx-swap="innerHTML"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="DOId" />
                    <input type="hidden" asp-for="BLId" />

                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label">Letter No</label>
                            <input class="form-control" asp-for="LetterNo" />
                            <span class="text-danger small" asp-validation-for="LetterNo"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Letter Date</label>
                            <input class="form-control" asp-for="LetterDate" type="date" />
                            <span class="text-danger small" asp-validation-for="LetterDate"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Currency</label>
                            <select class="form-select" asp-for="CurrencyId" asp-items="Model.Currencies"></select>
                            <span class="text-danger small" asp-validation-for="CurrencyId"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">From</label>
                            <input class="form-control" asp-for="FromLocationName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">To</label>
                            <input class="form-control" asp-for="ToLocationName" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Customer</label>
                            <input class="form-control" asp-for="CustomerName" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Customs Office</label>
                            <select class="form-select" asp-for="CustomsOfficeId" asp-items="Model.CustomsOffices"></select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">MBL No</label>
                            <input class="form-control" asp-for="MBLNo" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">HBL No</label>
                            <input class="form-control" asp-for="HBLNo" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Freight Value</label>
                            <input class="form-control" asp-for="FreightValue" />
                            <span class="text-danger small" asp-validation-for="FreightValue"></span>
                        </div>
                    </div>

                    <hr class="my-3" />

                    <div class="d-flex gap-2 justify-content-end">
                        <button type="submit" class="btn btn-primary">
                            Save
                        </button>
                        <a href="@Url.Action("PrintFreightLetter", "DeliveryOrders", new { doId = Model.DOId })"
                           target="_blank"
                           class="btn btn-outline-secondary @(Model.IsSaved ? "" : "disabled")">
                            Print
                        </a>
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                            Close
                        </button>
                    </div>
                    @if (Model.IsSaved)
                    {
                        <div class="alert alert-success mt-3 mb-0">
                            Saved successfully. You can print now.
                        </div>
                    }
                </form>
            </div>

        </div>
    </div>
</div>

<script>
    // بعد از اینکه HTMX partial مودال را جایگزین کرد، مودال را نمایش بده
    (function () {
      var el = document.getElementById('freightLetterModal');
      if (!el) return;
      bootstrap.Modal.getOrCreateInstance(el).show();
    })();
</script>
