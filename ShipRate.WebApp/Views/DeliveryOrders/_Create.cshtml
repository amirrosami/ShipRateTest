                        <div class="row g-3 align-items-end">
                            <div class="col-md-3">
                                <label asp-for="BLNo" class="form-label">Transport Doc (BL) No</label>
                                <div class="input-group">
                                    <input asp-for="BLNo" id="BLNo" class="form-control" readonly />
