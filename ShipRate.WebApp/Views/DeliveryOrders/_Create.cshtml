                                    <option value="">Select...</option>
                                </select>
                                <span asp-validation-for="DOOperationalModeId" class="excel-validation-msg"></span>
                            </div>
                        </div>

                        <!-- فیلد 2 -->
                        <div class="excel-field">
                            <label asp-for="DONo" title="DO No">DO No</label>
                            <div class="excel-field-control">
                                <input asp-for="DONo" />
                                <span asp-validation-for="DONo" class="excel-validation-msg"></span>
                            </div>
                        </div>

                        <!-- فیلد 3 -->
                        <div class="excel-field">
                            <label asp-for="DoDate" title="DO Date">DO Date</label>
                            <div class="excel-field-control">
                                <input asp-for="DoDate" type="date" value="@Model.DoDate.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="DoDate" class="excel-validation-msg"></span>
                            </div>
                        </div>

                        <!-- فیلد 4 -->
                        <div class="excel-field">
                            <label asp-for="ArrivalDate" title="Arrival Date">Arrival Date</label>
                            <div class="excel-field-control">
                                <input asp-for="ArrivalDate" type="date" value="@Model.ArrivalDate?.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="ArrivalDate" class="excel-validation-msg"></span>
                            </div>
                        </div>

                        <!-- فیلد 5 -->
                        <div class="excel-field">
                            <label asp-for="CarrierId" title="Carrier">Carrier</label>
                            <div class="excel-field-control">
                                <select asp-for="CarrierId" asp-items="Model.Carriers">
                                    <option value="">Select...</option>
                                </select>
                                <span asp-validation-for="CarrierId" class="excel-validation-msg"></span>
                            </div>
                        </div>

                        <!-- فیلد 6 -->
                        <div class="excel-field">
                            <label asp-for="CarrierAgentId" title="Carrier Agent">Carrier Agent</label>
                            <div class="excel-field-control">
                                <select asp-for="CarrierAgentId" asp-items="Model.Agents">
                                    <option value="">Select...</option>
                                </select>
                                <span asp-validation-for="CarrierAgentId" class="excel-validation-msg"></span>
                            </div>
                        </div>

                        <!-- فیلد 7 -->
                        <div class="excel-field">
                            <label asp-for="ExternalIssuerId" title="External Issuer">External Issuer</label>
                            <div class="excel-field-control">
                                <select asp-for="ExternalIssuerId" asp-items="Model.ExternalIssuers">
                                    <option value="">Select...</option>
                                </select>
                                <span asp-validation-for="ExternalIssuerId" class="excel-validation-msg"></span>
                            </div>
                        </div>

                        <!-- فیلد 8 -->
                        <div class="excel-field">
                            <label asp-for="ExternalIssuerText" title="External Issuer Text">External Issuer Text</label>
                            <div class="excel-field-control">
                                <input asp-for="ExternalIssuerText" />
                                <span asp-validation-for="ExternalIssuerText" class="excel-validation-msg"></span>
                            </div>
                        </div>

                        <!-- فیلد 9 -->
                        <div class="excel-field">
