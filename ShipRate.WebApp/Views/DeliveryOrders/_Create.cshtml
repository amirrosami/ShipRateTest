    <form id="deliveryOrderCreateForm" autocomplete="off">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="DeliveryOrderId" id="DeliveryOrderId" />
        <input type="hidden" asp-for="BLId" id="BLId" />

        <fieldset @(isFinalized ? "disabled" : "")>
            <div class="row g-2">
                <div class="col-12">
