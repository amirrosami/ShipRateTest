@using ShipRate.Application.ViewModels
@model CreateDeliveryOrderPageVm
@{
    var isEditMode = Model.DeliveryOrderId.HasValue && Model.DeliveryOrderId.Value != Guid.Empty;
    ViewData["Title"] = isEditMode ? "Edit Delivery Order" : "Create Delivery Order";
    var isFinalized = Model.StatusText == "Approved" || Model.StatusText == "Cancelled";
}

<style>
    body {
        background: #f5f7fb;
    }

    /* استایل گرید اکسل */
    .excel-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0; /* حذف گپ بین سلول‌ها برای چسبیده شدن */
        border: 1px solid #d1d9e0; /* حاشیه دور کل گرید */
        background-color: #fff;
    }

    .excel-field {
        display: flex; /* لیبل و اینپوت کنار هم */
        border: 0.5px solid #d1d9e0; /* مرز بین سلول‌ها */
        background-color: #fff;
        align-items: stretch; /* ارتفاع یکسان */
        min-height: 46px; /* ارتفاع افزایش یافته سلول‌ها */
    }

        /* استایل لیبل (سمت چپ - آبی روشن) */
        .excel-field label {
            background-color: #eef6ff; /* آبی بسیار ملایم */
            color: #4a5568;
            padding: 8px 12px;
            font-size: 15px; /* فونت بزرگتر */
            font-weight: 600;
            min-width: 155px; /* عرض هماهنگ با فونت */
            max-width: 155px;
            border-right: 1px solid #d1d9e0;
            display: flex;
            align-items: center;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin: 0;
            user-select: none;
        }

    .excel-field-control {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-width: 0;
        position: relative;
    }

    /* استایل ورودی‌ها (سمت راست - سفید) */
    .excel-field input,
    .excel-field select,
    .excel-field textarea {
        flex: 1;
        border: none !important;
        border-radius: 0 !important;
        background-color: #ffffff;
        padding: 8px 12px; /* فضای تنفس و پدینگ بیشتر */
        font-size: 14px; /* فونت بزرگتر */
        outline: none !important;
        box-shadow: none !important;
        width: 100%;
        color: #111827;
    }

        /* استایل فوکوس (زرد ملایم) */
        .excel-field input:focus,
        .excel-field select:focus,
        .excel-field textarea:focus {
            background-color: #fff9c4 !important; /* زرد ملایم هنگام فوکوس */
        }

    /* سلکتور Select2 داخل excel-field */
    .excel-field .select2-container--bootstrap-5.select2-container--focus .select2-selection,
    .excel-field .select2-container--bootstrap-5.select2-container--open .select2-selection,
    .excel-field .select2-container--default.select2-container--focus .select2-selection,
    .excel-field .select2-container--default.select2-container--open .select2-selection {
        background-color: #fff9c4 !important;
        border-color: #ffe082 !important;
    }

    .select2-dropdown .select2-search__field:focus {
        background-color: #fff9c4 !important;
        border-color: #ffe082 !important;
    }

    /* فیلد تمام‌عرض */
    .span-3 {
        grid-column: span 3;
    }

    /* پیام‌های خطای ولیدیشن */
    .excel-validation-msg {
        font-size: 12px;
        color: #dc2626;
        padding: 0 10px 3px 10px;
        line-height: 1.1;
    }

    @@media (max-width: 992px) {
        .excel-grid {
            grid-template-columns: 1fr;
        }

        .span-3 {
            grid-column: span 1;
        }
    }
</style>

<div class="container-fluid py-2" dir="ltr">
    <div class="card-header  d-flex justify-content-between align-items-center mb-2">
        <h4 class="mb-0">@ViewData["Title"]</h4>
