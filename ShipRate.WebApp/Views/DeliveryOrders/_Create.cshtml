@*         <a id="detailsButton"
           class="btn btn-outline-secondary btn-sm @(isEditMode ? "" : "d-none")"
           href="@(isEditMode? Url.Action("Details", "DeliveryOrders", new { id = Model.DeliveryOrderId }) : "#")">
            Details
        </a>

        <a id="printButton"
           class="btn btn-outline-dark btn-sm @(isFinalized ? "" : "d-none")"
           href="@(isEditMode? Url.Action("Print", "DeliveryOrders", new { id = Model.DeliveryOrderId }) : "#")"
           target="_blank">
            Print
        </a>
 *@    </div>




</div>

<div id="finalizeResult" class="mt-2"></div>
<div class="modal fade" id="globalModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content" id="globalModalContent">
        </div>
    </div>
</div>

<!-- کانتینر پنل مستندات -->
<div id="documentPanelContainer" class="mt-3">
    @if (Model.DeliveryOrderId.HasValue && Model.DeliveryOrderId.Value != Guid.Empty)
    {
        <!-- بارگذاری خودکار پنل مستندات پس از ذخیره اولیه یا در صفحه ویرایش -->
        <div hx-get="@Url.Action("DocumentPanel", "DeliveryOrders", new { deliveryOrderId = Model.DeliveryOrderId.Value })"
             hx-trigger="load"
             hx-swap="outerHTML">
            <div class="text-center py-3">
                <span class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></span>
                <span class="ms-2 text-muted">Loading documents...</span>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function selectBL(blId, blNo) {
            document.getElementById('BLId').value = blId;
            document.getElementById('BLNo').value = blNo;

            htmx.ajax('GET', '@Url.Action("BLSummary", "DeliveryOrders")?blId=' + blId, {
                target: '#blSummaryContainer',
                swap: 'innerHTML'
            });

            htmx.ajax('GET', '@Url.Action("GetBlCharges", "DeliveryOrders")?blId=' + blId, {
                target: '#bl-charges-container',
                swap: 'innerHTML'
            });

            htmx.ajax('GET', '@Url.Action("GetBlInvoices", "DeliveryOrders")?blId=' + blId, {
                target: '#bl-invoices-container',
                swap: 'innerHTML'
            });
            bootstrap.Modal.getInstance(document.getElementById('globalModal')).hide();
        }

        document.body.addEventListener('fillBLDetails', function(evt) {
            const data = evt.detail.value;
            if(data.arrivalDate) {
                document.getElementById('ArrivalDate').value = data.arrivalDate;
            }
        });

        document.body.addEventListener('htmx:afterSwap', function (evt) {
            if (evt.target.id !== 'saveDraftResult') {
                return;
            }

            const successNode = evt.target.querySelector('[data-save-success="true"]');
            if (!successNode) {
                return;
            }

            const deliveryOrderId = successNode.getAttribute('data-delivery-order-id');
            if (!deliveryOrderId) {
                return;
            }

            document.getElementById('DeliveryOrderId').value = deliveryOrderId;

            const finalizeButton = document.getElementById('btnFinalize');
            if (finalizeButton) {
                finalizeButton.disabled = false;
            }

            const detailsButton = document.getElementById('detailsButton');
            if (detailsButton) {
                detailsButton.href = '/DeliveryOrders/Details/' + deliveryOrderId;
                detailsButton.classList.remove('d-none');
            }

            // لود مجدد پنل مستندات پس از اولین ذخیره موقت موفق
            htmx.ajax('GET', '@Url.Action("DocumentPanel", "DeliveryOrders")?deliveryOrderId=' + deliveryOrderId, {
                target: '#documentPanelContainer',
                swap: 'innerHTML'
            });
        });

        document.body.addEventListener('htmx:afterSwap', function (evt) {
            if (evt.target.id !== 'finalizeResult') {
                return;
            }

            const successNode = evt.target.querySelector('[data-finalize-success="true"]');
            if (!successNode) {
                return;
            }

            const deliveryOrderId = document.getElementById('DeliveryOrderId').value;

            document.querySelectorAll('#deliveryOrderCreateForm input, #deliveryOrderCreateForm select, #deliveryOrderCreateForm textarea, #deliveryOrderCreateForm button')
                .forEach(function (el) {
                    if (el.id !== 'btnNewDo') {
                        el.disabled = true;
                    }
                });

            const detailsButton = document.getElementById('detailsButton');
            if (detailsButton) {
                detailsButton.href = '/DeliveryOrders/Details/' + deliveryOrderId;
                detailsButton.classList.remove('d-none');
            }

            const printButton = document.getElementById('printButton');
            if (printButton) {
                printButton.href = '/DeliveryOrders/Print/' + deliveryOrderId;
                printButton.classList.remove('d-none');
            }

            const detailsUrl = successNode.getAttribute('data-details-url');
            if (detailsUrl) {
                window.location.href = detailsUrl;
            }
        });
    </script>
}
