                            <div class="excel-field-control">
                                <input asp-for="ReceivedAtDateTime" type="date" value="@Model.ExpiryDate" />
                                <span asp-validation-for="ReceivedAtDateTime" class="excel-validation-msg"></span>
                            </div>
                        </div>

                        <!-- فیلد 10 -->
                        <div class="excel-field">
                            <label asp-for="ReceivedByUserId" title="Received By User">Received By User</label>
                            <div class="excel-field-control">
                                <select asp-for="ReceivedByUserId" asp-items="Model.Users">
                                    <option value="">Select...</option>
                                </select>
                                <span asp-validation-for="ReceivedByUserId" class="excel-validation-msg"></span>
                            </div>
                        </div>

                        <!-- فیلد 11 -->
                        <div class="excel-field">
                            <label asp-for="ReceiveMethodId" title="Receive Method">Receive Method</label>
                            <div class="excel-field-control">
                                <select asp-for="ReceiveMethodId" asp-items="Model.ReceiveMethods">
                                    <option value="">Select...</option>
                                </select>
                                <span asp-validation-for="ReceiveMethodId" class="excel-validation-msg"></span>
                            </div>
                        </div>

                        <!-- فیلد 12 -->
                        <div class="excel-field">
                            <label asp-for="ExpiryDate" title="Expiry Date">Expiry Date</label>
                            <div class="excel-field-control">
                                <input asp-for="ExpiryDate" type="date" value="@Model.ExpiryDate?.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="ExpiryDate" class="excel-validation-msg"></span>
                            </div>
                        </div>

                        <!-- فیلد 13 -->
                        <div class="excel-field">
                            <label asp-for="ClearanceTypeId" title="Clearance Type">
                                Clearance Type <span class="text-danger ms-1">*</span>
                            </label>
                            <div class="excel-field-control">
                                <select asp-for="ClearanceTypeId" asp-items="Model.ClearanceTypes" required>
                                    <option value="">Select...</option>
                                </select>
                                <span asp-validation-for="ClearanceTypeId" class="excel-validation-msg"></span>
                            </div>
                        </div>

                        <!-- فیلد 14 -->
                        <div class="excel-field">
                            <label asp-for="TIPId" title="TIP">TIP</label>
                            <div class="excel-field-control">
                                <select asp-for="TIPId" asp-items="Model.TIPs">
                                    <option value="">Select...</option>
                                </select>
                                <span asp-validation-for="TIPId" class="excel-validation-msg"></span>
                            </div>
                        </div>

                        <!-- فیلد 15 -->
                        <div class="excel-field">
                            <label asp-for="BLReleaseTypeId" title="BL Release Type">BL Release Type</label>
                            <div class="excel-field-control">
                                <select asp-for="BLReleaseTypeId" asp-items="Model.BLReleaseTypes">
                                    <option value="">Select...</option>
                                </select>
                                <span asp-validation-for="BLReleaseTypeId" class="excel-validation-msg"></span>
                            </div>
                        </div>

                        <!-- فیلد 16 -->
                        <div class="excel-field">
                            <label asp-for="OriginalBLCount" title="Original BL Count">Original BL Count</label>
                            <div class="excel-field-control">
                                <input asp-for="OriginalBLCount" type="number" min="0" />
                                <span asp-validation-for="OriginalBLCount" class="excel-validation-msg"></span>
                            </div>
                        </div>

                        <!-- پر کردن دو سلول باقیمانده ردیف جهت تقارن گرید ۳ ستونه -->
                        <div class="excel-field" style="background-color: #fafbfc;"></div>
                        <div class="excel-field" style="background-color: #fafbfc;"></div>

                        <!-- فیلد 17 (سرتاسری) Remarks -->
                        <div class="excel-field span-3">
                            <label asp-for="Remarks" title="Remarks">Remarks</label>
                            <div class="excel-field-control">
                                <textarea asp-for="Remarks" rows="2"></textarea>
                                <span asp-validation-for="Remarks" class="excel-validation-msg"></span>
                            </div>
                        </div>

                    </div>
                    <!-- پایان Excel Grid -->

                </div>
            </div>
        </fieldset>
    </form>
    <div class="d-flex gap-2">
        @if (!isFinalized)
        {
