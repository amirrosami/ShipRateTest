        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label text-muted">BL No</label>
                    <div>@(string.IsNullOrWhiteSpace(Model.BLSummary.BLNo) ? "-" : Model.BLSummary.BLNo)</div>
                </div>

                <div class="col-md-3">
                    <label class="form-label text-muted">BL Date</label>
                    @*                     <div>@(Model.BLSummary.BLDate?.ToString("yyyy-MM-dd") ?? "-")</div>
 *@                </div>

                <div class="col-md-6">
                    <label class="form-label text-muted">Consignee</label>
                    @*                     <div>@(string.IsNullOrWhiteSpace(Model.BLSummary.ConsigneeName) ? "-" : Model.BLSummary.ConsigneeName)</div>
 *@                </div>

                <div class="col-md-6">
                    <label class="form-label text-muted">Shipper</label>
                    @*                     <div>@(string.IsNullOrWhiteSpace(Model.BLSummary.ShipperName) ? "-" : Model.BLSummary.ShipperName)</div>
 *@                </div>

                <div class="col-md-3">
                    <label class="form-label text-muted">Vessel / Voyage</label>
                    @*                  <div>@(string.IsNullOrWhiteSpace(Model.BLSummary.VesselVoyage) ? "-" : Model.BLSummary.VesselVoyage)</div>
*@              </div>

                <div class="col-md-3">
                    <label class="form-label text-muted">Port of Discharge</label>
                    @*                     <div>@(string.IsNullOrWhiteSpace(Model.BLSummary.PortOfDischargeName) ? "-" : Model.BLSummary.PortOfDischargeName)</div>
 *@                </div>

                <div class="col-md-3">
                    <label class="form-label text-muted">Place of Delivery</label>
@*                     <div>@(string.IsNullOrWhiteSpace(Model.BLSummary.PlaceOfDeliveryName) ? "-" : Model.BLSummary.PlaceOfDeliveryName)</div>
 *@                </div>

                <div class="col-md-3">
                    <label class="form-label text-muted">Container Count</label>
                    <div>@Model.Containers.Count</div>
                </div>
