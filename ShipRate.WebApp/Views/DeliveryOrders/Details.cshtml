}

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Containers</strong>
        <span class="badge bg-light text-dark">@Model.Containers.Count</span>
    </div>
    <div class="card-body">
        @if (Model.Containers == null || Model.Containers.Count == 0)
        {
            <div class="text-muted">No container snapshot found.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-sm align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Container No</th>
                            <th>Size/Type</th>
                            <th>Seal No</th>
                            <th>Package Count</th>
                            <th>Gross Weight</th>
                            <th>Net Weight</th>
                            <th>Measurement</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Containers.Count; i++)
                        {
                            var item = Model.Containers[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@(item.ContainerNo ?? "-")</td>
                                <td>@(item.ContainerSize + ' ' + item.ContainerType ?? "-")</td>
                                <td>@(item.SealNo ?? "-")</td>
                                @*<td>@(item.PackageCount?.ToString() ?? "-")</td>
                                <td>@(item.GrossWeight?.ToString() ?? "-")</td>
                                <td>@(item.NetWeight?.ToString() ?? "-")</td>
                                <td>@(item.Measurement?.ToString() ?? "-")</td> *@
                                <td>-</td>
                                <td>-</td>
                                <td>-</td>
                                <td>-</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Cargo / Packages</strong>
        <span class="badge bg-light text-dark">@Model.CargoItems.Count</span>
    </div>
    <div class="card-body">
        @if (Model.CargoItems == null || Model.CargoItems.Count == 0)
        {
            <div class="text-muted">No cargo/package snapshot found.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-sm align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Package Type</th>
                            <th>Count</th>
                            <th>Gross Weight</th>
                            <th>Net Weight</th>
                            <th>Measurement</th>
                            <th>Marks & Numbers</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.CargoItems.Count; i++)
                        {
                            var item = Model.CargoItems[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@(item.PackageTypeName ?? "-")</td>
                                <td>@(item.PackageCount?.ToString() ?? "-")</td>
                                <td>@(item.GrossWeight?.ToString() ?? "-")</td>
                                <td>@(item.NetWeight?.ToString() ?? "-")</td>
                                <td>@(item.Measurement?.ToString() ?? "-")</td>
                                <td>@(item.MarksAndNumbers ?? "-")</td>
                                <td>@(item.DescriptionOfGoods ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
<div class="modal fade" id="documentManagerModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content" id="document-manager-content">
        </div>
    </div>
</div>

