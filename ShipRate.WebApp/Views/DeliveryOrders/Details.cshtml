@using ShipRate.Application.ViewModels
@model DeliveryOrderDetailsVm
@{
    ViewData["Title"] = "Delivery Order Details";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">Delivery Order Details</h3>
        <div class="text-muted">
            DO No:
            <strong>@(string.IsNullOrWhiteSpace(Model.DONo) ? "-" : Model.DONo)</strong>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="button"
                id="btnFinalize"
                class="btn btn-primary"
                hx-post="@Url.Action("Approve", "DeliveryOrders")"
                hx-include="#deliveryOrderCreateForm"
                hx-target="#finalizeResult"
                hx-swap="innerHTML">
            Approve DO
        </button>
        <button type="button"
                id="btnFinalize"
                class="btn btn-primary"
                hx-post="@Url.Action("Release", "DeliveryOrders")"
                hx-include="#deliveryOrderCreateForm"
                hx-target="#finalizeResult"
                hx-swap="innerHTML">
            Release DO
        </button>
        <button type="button"
                id="btnFinalize"
                class="btn btn-primary"
                hx-post="@Url.Action("Collect", "DeliveryOrders")"
                hx-include="#deliveryOrderCreateForm"
                hx-target="#finalizeResult"
                hx-swap="innerHTML">
            Collect DO
        </button>
        <a class="btn btn-primary"
           target="_blank"
           href="@Url.Action("Print", "DeliveryOrders", new { id = Model.DeliveryOrderId })">
            Print
        </a>
        <button type="button"
                class="btn btn-primary"
                hx-get="/DocumentManager/Index?objectId=@Model.DeliveryOrderId&objectTypeId=15"
                hx-target="#document-manager-content"
                hx-swap="innerHTML"
                data-bs-toggle="modal"
                data-bs-target="#documentManagerModal">
            <i class="bi bi-folder2-open me-2"></i> Attachments
        </button>
    </div>
</div>
<div class="card mb-3">
    <div class="card-body d-flex justify-content-between align-items-start">
        <div>
            <div class="fw-semibold mb-1">Status</div>
            @if (Model.IsFinalized)
            {
                <span class="badge bg-success">Finalized</span>
            }
            else
            {
                <span class="badge bg-secondary">Draft</span>
            }
        </div>

        <div class="text-end">
            <div class="small text-muted">Delivery Order ID</div>
            <div>@Model.DeliveryOrderId</div>

            @if (Model.FinalizedAt.HasValue)
            {
                <div class="small text-muted mt-2">Finalized At</div>
                <div>@Model.FinalizedAt.Value.ToString("yyyy-MM-dd HH:mm")</div>
            }
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">
        <strong>Basic Information</strong>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label text-muted">Delivery Order No</label>
                <div>@(string.IsNullOrWhiteSpace(Model.DONo) ? "-" : Model.DONo)</div>
            </div>

            <div class="col-md-3">
                <label class="form-label text-muted">DO Date</label>
                <div>@(Model.DoDate?.ToString("yyyy-MM-dd") ?? "-")</div>
            </div>

            <div class="col-md-3">
                <label class="form-label text-muted">Expiry Date</label>
                <div>@(Model.ExpiryDate?.ToString("yyyy-MM-dd") ?? "-")</div>
            </div>

            <div class="col-md-3">
                <label class="form-label text-muted">Arrival Date</label>
                <div>@(Model.ArrivalDate?.ToString("yyyy-MM-dd") ?? "-")</div>
            </div>

            <div class="col-md-3">
                <label class="form-label text-muted">Clearance Type</label>
                <div>@(string.IsNullOrWhiteSpace(Model.ClearanceTypeName) ? "-" : Model.ClearanceTypeName)</div>
            </div>

            <div class="col-md-3">
                <label class="form-label text-muted">BL Release Type</label>
                <div>@(string.IsNullOrWhiteSpace(Model.BLReleaseTypeName) ? "-" : Model.BLReleaseTypeName)</div>
            </div>

            <div class="col-md-3">
                <label class="form-label text-muted">Original BL Count</label>
                <div>@(Model.OriginalBLCount?.ToString() ?? "-")</div>
            </div>

            <div class="col-12">
                <label class="form-label text-muted">Remarks</label>
                <div>@(string.IsNullOrWhiteSpace(Model.Remarks) ? "-" : Model.Remarks)</div>
            </div>
        </div>
    </div>
</div>

