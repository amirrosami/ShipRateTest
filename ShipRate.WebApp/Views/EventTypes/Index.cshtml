@using ShipRate.Application.DTOs.Base_Info
@model EventTypeManagementViewModel

@{
    ViewData["Title"] = "Event Type Management";
}

<div class="container-fluid" dir="ltr">
    <div class="row">
        <div class="col-12">
            <h3 class="mb-3">Event Types Management</h3>
        </div>
    </div>

    <div class="row">
        <div class="col-12 mb-4">
            <div class="card">
                <div class="card-header">
                    <strong>Event Type Categories</strong>
                </div>
                <div class="card-body p-0">
                    <table class="table table-bordered table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 80px;">Id</th>
                                <th>Category Name</th>
                                <th>Local Name</th>
                                <th style="width: 120px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Categories)
                            {
                                var rowClass = Model.SelectedCategoryId == item.Id ? "table-primary" : "";
                                <tr class="@rowClass">
                                    <td>@item.Id</td>
                                    <td>@item.EventTypeCategoryName</td>
                                    <td>@item.EventTypeCategoryLocalName</td>
                                    <td>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                title="View Event Types"
                                                hx-get="@Url.Action("List", "EventTypes", new { categoryId = item.Id })"
                                                hx-target="#eventTypesContainer"
                                                hx-swap="innerHTML"
                                                >
                                            <i class="bi bi-list-ul"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div id="eventTypesContainer"
                 hx-get="@Url.Action("List", "EventTypes", new { categoryId = Model.SelectedCategoryId })"
                 hx-trigger="load, eventTypeChanged from:body"
                 hx-target="this"
                 hx-swap="innerHTML">
                <div class="text-center p-4">
                    <div class="spinner-border"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="mainModal" tabindex="-1" aria-hidden="true" dir="ltr">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="modalContent">
        </div>
    </div>
</div>




<script>
    document.body.addEventListener('htmx:afterRequest', function (evt) {
        var xhr = evt.detail.xhr;
        if (xhr.getResponseHeader('HX-Trigger') === 'eventTypeChanged') {
            var modalEl = document.getElementById('mainModal');
            var modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) {
                modal.hide();
            }
            document.getElementById('modalContent').innerHTML = '';
        }
    });
</script>