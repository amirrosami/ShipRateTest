@{
    ViewData["Title"] = "Mission Control";
    ViewData["PageHeader"] = "Mission Control";
    ViewData["PageDescription"] = "Real-Time Logistics Command Center";
}



<style>
    /* ============ MISSION CONTROL STYLES ============ */
    .mc-glow-card {
        border: 1px solid rgba(78,115,223,0.2);
        border-radius: 16px;
        backdrop-filter: blur(10px);
        position: relative;
        overflow: hidden;
    }

        .mc-glow-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--mc-accent, #4e73df), transparent);
        }

        .mc-glow-card.green::before {
            --mc-accent: #1cc88a;
        }

        .mc-glow-card.orange::before {
            --mc-accent: #f6c23e;
        }

        .mc-glow-card.red::before {
            --mc-accent: #e74a3b;
        }

        .mc-glow-card.cyan::before {
            --mc-accent: #36b9cc;
        }

        .mc-glow-card.purple::before {
            --mc-accent: #8b5cf6;
        }

    /* Pulsing dot */
    .pulse-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
        animation: pulseDot 1.5s ease-in-out infinite;
    }

        .pulse-dot.green {
            background: #1cc88a;
            box-shadow: 0 0 8px #1cc88a;
        }

        .pulse-dot.red {
            background: #e74a3b;
            box-shadow: 0 0 8px #e74a3b;
        }

        .pulse-dot.yellow {
            background: #f6c23e;
            box-shadow: 0 0 8px #f6c23e;
        }

        .pulse-dot.blue {
            background: #4e73df;
            box-shadow: 0 0 8px #4e73df;
        }

    @@keyframes pulseDot {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: 0.5;
            transform: scale(1.3);
        }
    }

    /* Ticker */
    .mc-ticker {
        overflow: hidden;
        white-space: nowrap;
        border-radius: 8px;
        padding: 0.5rem 1rem;
        font-family: 'Courier New', monospace;
        font-size: 0.8rem;
        background: rgba(78,115,223,0.08);
        border: 1px solid rgba(78,115,223,0.15);
    }

    .mc-ticker-content {
        display: inline-block;
        animation: tickerScroll 30s linear infinite;
    }

    @@keyframes tickerScroll {
        0% {
            transform: translateX(100%);
        }

        100% {
            transform: translateX(-100%);
        }
    }

    /* Big number counter */
    .mc-big-num {
        font-family: 'Inter', monospace;
        font-size: 2.2rem;
        font-weight: 800;
        letter-spacing: -1px;
        line-height: 1;
        background: linear-gradient(135deg, var(--mc-accent, #4e73df), #36b9cc);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

        .mc-big-num.green {
            background: linear-gradient(135deg, #1cc88a, #17a673);
            -webkit-background-clip: text;
            background-clip: text;
        }

        .mc-big-num.orange {
            background: linear-gradient(135deg, #f6c23e, #dda520);
            -webkit-background-clip: text;
            background-clip: text;
        }

        .mc-big-num.red {
            background: linear-gradient(135deg, #e74a3b, #c0392b);
            -webkit-background-clip: text;
            background-clip: text;
        }

        .mc-big-num.purple {
            background: linear-gradient(135deg, #8b5cf6, #6d28d9);
            -webkit-background-clip: text;
            background-clip: text;
        }

    /* Radar ring background */
    .radar-ring {
        position: relative;
    }

        .radar-ring::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 180px;
            height: 180px;
            transform: translate(-50%, -50%);
            border: 1px dashed rgba(78,115,223,0.2);
            border-radius: 50%;
            animation: radarSpin 8s linear infinite;
            pointer-events: none;
        }

    @@keyframes radarSpin {
        0% {
            transform: translate(-50%, -50%) rotate(0deg);
        }

        100% {
            transform: translate(-50%, -50%) rotate(360deg);
        }
    }

    /* Ship tracker line */
    .route-line {
        height: 4px;
        border-radius: 2px;
        background: linear-gradient(90deg, #1cc88a var(--progress), rgba(128,128,128,0.2) var(--progress));
        position: relative;
    }

        .route-line .ship-icon {
            position: absolute;
            top: 50%;
            left: var(--progress);
            transform: translate(-50%, -50%);
            font-size: 1rem;
            transition: left 1s ease;
        }

    /* Hexagon badge */
    .hex-badge {
        width: 56px;
        height: 56px;
        clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        color: #fff;
        font-weight: 700;
        flex-shrink: 0;
    }

    /* Status bar */
    .status-segment {
        height: 8px;
        border-radius: 4px;
        flex: 1;
        transition: all 0.3s;
    }

        .status-segment:hover {
            transform: scaleY(2);
        }

    /* Matrix grid animation for section bg */
    .mc-grid-bg {
        background-image: linear-gradient(rgba(78,115,223,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(78,115,223,0.03) 1px, transparent 1px);
        background-size: 40px 40px;
    }

    /* Flip counter */
    .flip-unit {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 48px;
        border-radius: 8px;
        font-size: 1.4rem;
        font-weight: 800;
        font-family: 'Inter', monospace;
        margin: 0 1px;
    }

    .flip-separator {
        font-size: 1.4rem;
        font-weight: 800;
        opacity: 0.4;
        animation: blinkSep 1s step-end infinite;
    }

    @@keyframes blinkSep {
        0%, 100% {
            opacity: 0.4;
        }

        50% {
            opacity: 0;
        }
    }

    /* Wave bars (mini equalizer) */
    .wave-bar {
        width: 3px;
        border-radius: 2px;
        background: #1cc88a;
        display: inline-block;
        animation: waveBar 0.8s ease-in-out infinite alternate;
    }

        .wave-bar:nth-child(2) {
            animation-delay: 0.1s;
            height: 16px;
        }

        .wave-bar:nth-child(3) {
            animation-delay: 0.2s;
            height: 22px;
        }

        .wave-bar:nth-child(4) {
            animation-delay: 0.3s;
            height: 12px;
        }

        .wave-bar:nth-child(5) {
            animation-delay: 0.4s;
            height: 18px;
        }

    @@keyframes waveBar {
        0% {
            height: 6px;
        }

        100% {
            height: 24px;
        }
    }
</style>

