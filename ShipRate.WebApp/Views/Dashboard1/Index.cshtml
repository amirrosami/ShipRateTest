@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const C = {
                primary: '#4e73df', success: '#1cc88a', info: '#36b9cc',
                warning: '#f6c23e', danger: '#e74a3b', purple: '#8b5cf6', secondary: '#858796'
            };
            function txtClr() { return getComputedStyle(document.documentElement).getPropertyValue('--bs-body-color').trim() || '#555'; }
            function grdClr() { return 'rgba(128,128,128,0.12)'; }

            // ===== 1. System Heartbeat (Streaming Line) =====
            const heartbeatData = [];
            const heartbeatLabels = [];
            for (let i = 60; i >= 0; i--) {
                heartbeatLabels.push(i + 's');
                heartbeatData.push(95 + Math.random() * 5);
            }
            const heartbeatChart = new Chart(document.getElementById('chartHeartbeat'), {
                type: 'line',
                data: {
                    labels: heartbeatLabels,
                    datasets: [{
                        label: 'System Load %',
                        data: heartbeatData,
                        borderColor: C.success,
                        backgroundColor: 'rgba(28,200,138,0.1)',
                        fill: true,
                        tension: 0.3,
                        pointRadius: 0,
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    animation: { duration: 0 },
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { display: false },
                        y: { min: 80, max: 100, grid: { color: grdClr() }, ticks: { color: txtClr(), callback: v => v + '%' } }
                    }
                }
            });
            // Live update heartbeat
            setInterval(() => {
                heartbeatChart.data.datasets[0].data.shift();
                heartbeatChart.data.datasets[0].data.push(94 + Math.random() * 6);
                heartbeatChart.data.labels.shift();
                heartbeatChart.data.labels.push('0s');
                heartbeatChart.update('none');
            }, 1000);

            // ===== 2. Global Throughput (Multi-dataset area) =====
            new Chart(document.getElementById('chartThroughput'), {
                type: 'line',
                data: {
                    labels: ['00:00','02:00','04:00','06:00','08:00','10:00','12:00','14:00','16:00','18:00','20:00','22:00'],
                    datasets: [
                        {
                            label: 'Inbound TEU',
                            data: [320,280,240,310,520,680,750,820,790,680,540,420],
                            borderColor: C.primary,
                            backgroundColor: 'rgba(78,115,223,0.1)',
                            fill: true, tension: 0.4, pointRadius: 3, pointBackgroundColor: '#fff', pointBorderWidth: 2, borderWidth: 2
                        },
                        {
                            label: 'Outbound TEU',
                            data: [280,240,200,260,460,610,690,760,730,620,490,380],
                            borderColor: C.success,
                            backgroundColor: 'rgba(28,200,138,0.08)',
                            fill: true, tension: 0.4, pointRadius: 3, pointBackgroundColor: '#fff', pointBorderWidth: 2, borderWidth: 2
                        },
                        {
                            label: 'Transit TEU',
                            data: [150,120,100,140,250,320,350,390,370,310,260,200],
                            borderColor: C.warning,
                            backgroundColor: 'transparent',
                            fill: false, tension: 0.4, pointRadius: 2, borderDash: [5,5], borderWidth: 1.5
                        }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { position: 'top', labels: { usePointStyle: true, padding: 16, color: txtClr(), font: { size: 11 } } } },
                    scales: {
                        x: { grid: { display: false }, ticks: { color: txtClr() } },
                        y: { grid: { color: grdClr() }, ticks: { color: txtClr() }, beginAtZero: true }
                    }
                }
            });

            // ===== 3. Capability Radar =====
            new Chart(document.getElementById('chartRadar'), {
                type: 'radar',
                data: {
                    labels: ['Speed','Capacity','Safety','Cost Efficiency','Reliability','Coverage'],
                    datasets: [
                        {
                            label: 'Current',
                            data: [88,75,92,70,85,78],
                            borderColor: C.primary,
                            backgroundColor: 'rgba(78,115,223,0.15)',
                            pointBackgroundColor: C.primary,
                            pointRadius: 4, borderWidth: 2
                        },
                        {
                            label: 'Target',
                            data: [90,85,95,80,90,85],
                            borderColor: C.danger,
                            backgroundColor: 'rgba(231,74,59,0.08)',
                            pointBackgroundColor: C.danger,
                            pointRadius: 3, borderWidth: 1.5, borderDash: [4,4]
                        }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, padding: 12, color: txtClr(), font: { size: 11 } } } },
                    scales: {
                        r: {
                            beginAtZero: true, max: 100,
                            grid: { color: grdClr() },
                            angleLines: { color: grdClr() },
                            pointLabels: { color: txtClr(), font: { size: 11 } },
                            ticks: { display: false }
                        }
                    }
                }
            });

            // ===== 4. Port Congestion (Horizontal grouped bar) =====
            new Chart(document.getElementById('chartCongestion'), {
                type: 'bar',
                data: {
                    labels: ['Shanghai','Rotterdam','Singapore','Dubai','Hamburg','LA/LB'],
                    datasets: [
                        {
                            label: 'Waiting (hrs)',
                            data: [18,12,8,14,10,22],
                            backgroundColor: C.danger,
                            borderRadius: 4, barPercentage: 0.5
                        },
                        {
                            label: 'Processing (hrs)',
                            data: [6,4,3,5,4,8],
                            backgroundColor: C.warning,
                            borderRadius: 4, barPercentage: 0.5
                        }
                    ]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true, maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { usePointStyle: true, padding: 14, color: txtClr(), font: { size: 11 } } }
                    },
                    scales: {
                        x: { stacked: true, grid: { color: grdClr() }, ticks: { color: txtClr(), callback: v => v + 'h' } },
                        y: { stacked: true, grid: { display: false }, ticks: { color: txtClr() } }
                    }
                }
            });

            // ===== LIVE COUNTER ANIMATION =====
            function animateValue(el, start, end, dur) {
                let startTime = null;
                const step = (ts) => {
                    if (!startTime) startTime = ts;
                    const progress = Math.min((ts - startTime) / dur, 1);
                    const val = Math.floor(progress * (end - start) + start);
                    el.textContent = val.toLocaleString();
                    if (progress < 1) requestAnimationFrame(step);
                };
                requestAnimationFrame(step);
            }
            animateValue(document.getElementById('counterFleet'), 0, 247, 1500);
            animateValue(document.getElementById('counterContainers'), 0, 1842, 2000);
            animateValue(document.getElementById('counterAlerts'), 0, 7, 800);

            // ===== UPTIME CLOCK =====
            let sec = 33;
            setInterval(() => {
                sec = (sec + 1) % 60;
                const el = document.getElementById('uptimeSec');
                if (el) el.textContent = sec < 10 ? '0'.charAt(1) : String(sec).charAt(1);
                // update full display would need more logic, keeping simple
                if (el) el.textContent = sec % 10;
            }, 1000);

        });
    </script>
}
