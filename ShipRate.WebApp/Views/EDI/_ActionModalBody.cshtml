@using ShipRate.Application.DTOs.EDI
@model EDIActionModalViewModel

<div dir="ltr">
    <div class="mb-3">
        <label class="form-label">Action</label>
        <input type="text" class="form-control" value="@Model.ActionName" readonly />
    </div>

    <div class="mb-3">
        <label class="form-label">Message Type ID</label>
        <input type="text" class="form-control" value="@Model.MessageTypeId" readonly />
    </div>

    <div class="mb-3">
        <label class="form-label">Message Type Code</label>
        <input type="text" class="form-control" value="@Model.MessageTypeCode" readonly />
    </div>

    <div class="mb-3">
        <label class="form-label">Message Type Name</label>
        <input type="text" class="form-control" value="@Model.MessageTypeName" readonly />
    </div>

    <div class="alert alert-info mb-0">
        Future implementation for <strong>@Model.ActionName</strong> will be added here.
    </div>
</div>
