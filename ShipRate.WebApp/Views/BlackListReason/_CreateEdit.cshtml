@using ShipRate.WebApp.ViewModels.Location
@model BlackListReasonCreateDto
@{
    string CreateEdit = ViewBag.CreateEdit;
    bool isCreateMode = false;
    if (CreateEdit == "Create") isCreateMode = true;
}

<form hx-post="@Url.Action(isCreateMode?"Create":"Edit", "BlackListReason")"
      hx-target="#app-modal-content"
      hx-swap="innerHTML">

    <div class="modal-header form-caption-bg  text-white">
        @if (isCreateMode)
        {
            <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Add BlackListReason</h5>
        }
        else
        {
            <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Edit BlackListReason</h5>
            <input type="hidden" asp-for="Id" />
        }


        <button type="button"
                class="btn-close"
                onclick="AppModal.close()">
        </button>
    </div>


    <div class="modal-body row">

        @Html.AntiForgeryToken()
        @if (!ViewData.ModelState.IsValid)
        {
            var allErrors = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).ToList();
            if (allErrors.Any())
            {
                <div class="alert alert-danger py-2 mb-1">
                    <ul class="mb-0 small">
                        @foreach (var err in allErrors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }
        }


        <div class="mb-1 col-md-4">
            <label class="form-label fw-medium">
                Title <span class="text-danger">*</span>
            </label>
            <input type="text"
                   name="BlackListReasonName"
                   value="@Model.BlackListReasonName"
                   class="form-control @(ViewData.ModelState.ContainsKey("BlackListReasonName") && ViewData.ModelState["BlackListReasonName"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                   maxlength="100" />
        </div>

        <div class="mb-1 col-md-2">
            <div class="form-check form-switch">
                <input type="checkbox"
                       class="form-check-input"
                       name="IsActive"
                       value="true"
                       id="createIsActive"
                       @(Model.IsActive ? "checked=\"checked\"" : "") />
                <!-- این خط مشکل را حل می‌کند: -->
                <input type="hidden" name="IsActive" value="false" />

                <label class="form-check-label" for="createIsActive">Active</label>
            </div>
        </div>
    </div>


    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="AppModal.close()">Cancel</button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>

            @if (isCreateMode)
            {
                <span>Save</span>
            }
            else
            {
                <span>Update</span>
            }
        </button>
    </div>
</form>




