@using ShipRate.Application.DTOs.Finance
@model TreasuryDocumentFormVm

@{
    var form = Model.Form;
    var isEdit = form.Id.HasValue;
    var actionName = isEdit ? "Edit" : "Create";
}

<form hx-post="@Url.Action(actionName, "TreasuryDocuments")"
      hx-target="#modalBody"
      hx-swap="innerHTML"
      dir="ltr">

    @Html.AntiForgeryToken()

    @if (isEdit)
    {
        <input type="hidden" name="Id" value="@form.Id" id="TreasuryDocumentId" />
    }
    else
    {
        <input type="hidden" id="TreasuryDocumentId" value="" />
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(x => x.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Company</label>
            <select name="CompanyId" class="form-select">
                <option value="">Select</option>
                @foreach (var item in Model.Companies)
                {
                    <option value="@item.Value" selected="@(item.Value == form.CompanyId.ToString() ? "selected" : null)">
                        @item.Text
                    </option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <label class="form-label">Receipt No</label>
            <input type="text" name="DocumentNo" value="@form.DocumentNo" class="form-control" />
        </div>

        <div class="col-md-4">
            <label class="form-label">Date</label>
            <input type="date" name="DocumentDate" value="@form.DocumentDate.ToString("yyyy-MM-dd")" class="form-control" />
        </div>

        <div class="col-md-4">
            <label class="form-label">Type</label>
            <select name="TreasuryDocumentTypeId" class="form-select">
                <option value="">Select</option>
                @foreach (var item in Model.Types)
                {
                    <option value="@item.Value" selected="@(item.Value == form.TreasuryDocumentTypeId.ToString() ? "selected" : null)">
                        @item.Text
                    </option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <label class="form-label">Status</label>
            <select name="TreasuryDocumentStatusId" class="form-select">
                <option value="">Select</option>
                @foreach (var item in Model.Statuses)
                {
                    <option value="@item.Value" selected="@(item.Value == form.TreasuryDocumentStatusId.ToString() ? "selected" : null)">
                        @item.Text
                    </option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <label class="form-label">Currency</label>
            <select name="CurrencyId" class="form-select">
                <option value="">Select</option>
                @foreach (var item in Model.Currencies)
                {
                    <option value="@item.Value" selected="@(item.Value == form.CurrencyId.ToString() ? "selected" : null)">
                        @item.Text
                    </option>
                }
            </select>
        </div>

        <div class="col-md-12">
            <label class="form-label">Party</label>

            <input type="hidden" name="PartyId" id="PartyId" value="@form.PartyId" />

            <input type="text"
                   id="PartySearch"
                   name="partySearch"
                   value="@form.PartyName"
                   autocomplete="off"
                   class="form-control"
                   placeholder="Type party name..."
                   hx-get="@Url.Action("PersonLookup", "TreasuryDocuments")"
                   hx-trigger="keyup changed delay:400ms"
                   hx-target="#partyLookupContainer"
                   hx-swap="innerHTML" />

            <div id="partyLookupContainer" class="mt-1"></div>
        </div>

        <div class="col-md-12">
            <label class="form-label">Description</label>
            <textarea name="Description" class="form-control" rows="2">@form.Description</textarea>
        </div>
    </div>

    <hr />

    <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="mb-0">Payment Documents</h6>

        <button type="button"
                class="btn btn-outline-primary btn-sm"
                hx-get="@Url.Action("AvailablePayments", "TreasuryDocuments")"
                hx-vals='js:{ partyId: document.getElementById("PartyId").value, treasuryDocumentId: document.getElementById("TreasuryDocumentId").value }'
                hx-target="#paymentDocumentsContainer"
                hx-swap="innerHTML">
            Load Payments
        </button>
    </div>

    <div id="paymentDocumentsContainer">
        @await Html.PartialAsync("_PaymentDocumentsSelector", form.PaymentItems)
    </div>

    <div class="d-flex justify-content-end gap-2 mt-3">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-success">Save</button>
    </div>
</form>
