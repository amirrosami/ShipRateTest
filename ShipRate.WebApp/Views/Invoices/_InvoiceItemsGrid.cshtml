@using ShipRate.Application.DTOs.Finance
@model List<InvoiceItemRowVm>

<style>
    .invoice-items-scroll {
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
        width: 100%;
    }

        .invoice-items-scroll table {
            min-width: 1100px;
            white-space: nowrap;
        }

        .invoice-items-scroll .actions-cell {
            white-space: nowrap;
        }
</style>

<div class="invoice-items-scroll">
    <table class="table table-bordered table-sm align-middle mb-0">
        <thead>
            <tr>
                <th style="width:70px;">Seq</th>
                <th>Charge Type</th>
                <th>Description</th>
                <th class="text-end">QTY</th>
                <th class="text-end">Unit Price</th>
                <th class="text-end">Discount</th>
                <th class="text-end">Tax %</th>
                <th class="text-end">Tax</th>
                <th class="text-end">Total</th>
                <th style="width:150px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.SequenceNumber</td>
                        <td>@item.ChargeTypeName</td>
                        <td>@item.Description</td>
                        <td class="text-end">@item.QTY.ToString("N2")</td>
                        <td class="text-end">@item.UnitPrice.ToString("N2")</td>
                        <td class="text-end">@item.Discount.ToString("N2")</td>
                        <td class="text-end">@item.TaxPercent.ToString("N2")</td>
                        <td class="text-end">@item.TaxAmount.ToString("N2")</td>
                        <td class="text-end fw-bold">@item.TotalAmount.ToString("N2")</td>
                        <td class="actions-cell">
                            <div class="d-flex gap-1 flex-nowrap align-items-center">
                                <!-- دکمه Edit با آیکن -->
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary py-0 px-1"
                                        title="Edit"
                                        data-bs-toggle="tooltip"
                                        hx-get="@Url.Action("EditItemForm", "Invoices", new { id = item.Id })"
                                        hx-target="#invoice-item-form-container"
                                        hx-swap="innerHTML">
                                    <i class="bi bi-pencil-square"></i>
                                </button>

                                <!-- دکمه Delete با آیکن -->
                                <form hx-post="@Url.Action("DeleteItem", "Invoices", new { id = item.Id, invoiceId = item.InvoiceId })"
                                      hx-target="this"
                                      hx-swap="none"
                                      hx-confirm="Are you sure you want to delete this item?"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger py-0 px-1"
                                            title="Delete"
                                            data-bs-toggle="tooltip">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="10" class="text-center text-muted">No items found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
