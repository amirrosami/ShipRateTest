@using ShipRate.Application.DTOs.Finance
@model InvoiceListPageVm

<style>
    /* محفظه اسکرول افقی دائم */
    .invoice-grid-scroll {
        overflow-x: auto !important;
        overflow-y: hidden;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        margin-bottom: 0.5rem;
    }

    /* حداقل عرض جدول برای فعال‌شدن اسکرول در تمام رزولوشن‌ها */
    #invoicesGridTable {
        min-width: 1950px;
        margin-bottom: 0;
    }

        #invoicesGridTable th,
        #invoicesGridTable td {
            white-space: nowrap !important;
            vertical-align: middle;
            padding: 0.45rem 0.6rem;
        }

            /* ستون Actions به صورت Sticky در انتهای سمت راست */
            #invoicesGridTable th:last-child,
            #invoicesGridTable td:last-child {
                position: sticky;
                right: 0;
                background-color: #fff;
                z-index: 2;
                box-shadow: -2px 0 5px rgba(0,0,0,0.06);
                min-width: 170px;
                width: 170px;
            }

        /* حفظ رنگ هدر و سطرهای راه‌راه در ستون Sticky */
        #invoicesGridTable thead th:last-child {
            background-color: #f8f9fa;
            z-index: 3;
        }

        #invoicesGridTable tbody tr:nth-of-type(odd) td:last-child {
            background-color: #f9f9f9;
        }

        #invoicesGridTable tbody tr:hover td:last-child {
            background-color: #f2f5f8;
        }

    /* استایل شکیل اسکرول‌بار */
    .invoice-grid-scroll::-webkit-scrollbar {
        height: 8px;
    }

    .invoice-grid-scroll::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 4px;
    }

    .invoice-grid-scroll::-webkit-scrollbar-thumb {
        background: #b0bec5;
        border-radius: 4px;
    }

        .invoice-grid-scroll::-webkit-scrollbar-thumb:hover {
            background: #90a4ae;
        }
</style>

<div class="table-responsive invoice-grid-scroll">
    <table class="table table-bordered table-striped align-middle text-nowrap mb-0" id="invoicesGridTable">
        <thead class="table-light">
            <tr>
                <!-- ستون چک‌باکس انتخاب سطرها -->
                <th style="width: 32px;" class="text-center">
                    <input class="form-check-input m-0" type="checkbox" id="chkSelectAllInvoices" title="Select All" />
                </th>
                <th style="width:40px;" class="text-center">#</th>
                <th>Company</th>
                <th>Serial</th>
                <th>Date</th>
                <th>File No</th>
                <th>BL No</th>
                <th>Buy/Sell</th>
                <th>Party</th>
                <th>Subject</th>
                <th>F/NF</th>
                <th>Type</th>
                <th>Curr</th>
                <th class="text-end">Total</th>
                <th class="text-end">Settled</th>
                <th class="text-end">Remain</th>
                <th>Create Date</th>
                <th>Edit Date</th>
                <th>Status</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Result.Items.Any())
            {
                var rowNumber = (Model.Filter.PageNumber - 1) * Model.Filter.PageSize + 1;
                foreach (var item in Model.Result.Items)
                {
                    <tr>
                        <!-- چک‌باکس انتخاب فاکتور با ذخیره ID و PartyId -->
                        <td class="text-center">
                            <input class="form-check-input chk-invoice-item m-0"
                                   type="checkbox"
                                   value="@item.Id"
                                   data-party-id="@item.PartyId"
                                   data-party-name="@item.PartyName" />
                        </td>

                        <!-- شماره ردیف -->
                        <td class="text-center text-muted">@rowNumber</td>
                        <td>@item.CompanyName</td>
                        <td class="fw-bold">@item.SerialDisplay</td>

                        <td class="datetime-cell"
                            title="@(item.InvoiceDate?.ToString("yyyy-MM-dd HH:mm:ss"))">
                            @(item.InvoiceDate?.ToString("yyyy-MM-dd"))
                        </td>
                        <td>@item.JobFileNo</td>
                        <td>@item.BLNo</td>
                        <td>
                            <span class="badge @(item.FinanceDirectionName == "Buy" ? "bg-warning text-dark" : "bg-success")">
                                @item.FinanceDirectionName
                            </span>
                        </td>
                        <td>@item.PartyName</td>
                        <td>@item.InvoiceSubjectName</td>
                        <td>@item.FNFName</td>
                        <td>@item.InvoiceTypeName</td>
                        <td><span class="badge bg-secondary">@item.CurrencyCode</span></td>
                        <td class="text-end fw-semibold">@item.TotalAmount.ToString("N2")</td>
                        <td class="text-end text-success">@item.SettledAmount.ToString("N2")</td>
                        <td class="text-end fw-bold @(item.RemainingAmount > 0 ? "text-danger" : "text-muted")">
                            @item.RemainingAmount.ToString("N2")
                        </td>

                        <td class="datetime-cell"
                            title="@(item.CreateDateTime.ToString("yyyy-MM-dd HH:mm:ss") + " // " + item.CreateUserName)">
                            @(item.CreateDateTime.ToString("yyyy-MM-dd"))
                        </td>
                        <td class="datetime-cell"
                            title="@(item.UpdateDateTime?.ToString("yyyy-MM-dd HH:mm:ss") + " // " + item.UpdateUserName)">
                            @(item.UpdateDateTime?.ToString("yyyy-MM-dd"))
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@item.InvoiceStatusName</span>
                        </td>
                        <td>
                            <div class="d-flex gap-1 justify-content-center align-items-center">
                                <!-- Items -->
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary py-0 px-2"
                                        title="Items"
                                        hx-get="@Url.Action("ItemsGrid2", "Invoices", new { invoiceId = item.Id })"
                                        hx-target="#invoiceitems-list-container"
                                        hx-swap="innerHTML">
                                    <i class="bi bi-list-ul"></i>
                                </button>

                                <!-- Attachments -->
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2"
                                        title="Attachments"
                                        hx-get="/DocumentManager/Index?objectId=@item.Id&objectTypeId=200"
                                        hx-target="#document-manager-content"
                                        hx-swap="innerHTML"
                                        data-bs-toggle="modal"
                                        data-bs-target="#documentManagerModal">
                                    <i class="bi bi-folder2-open"></i>
                                </button>

                                <!-- Print Invoice -->
@*                                 <a asp-action="PrintOfficialTaxInvoice" asp-controller="Invoices" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger py-0 px-2" target="_blank" title="Print Invoice" >
                                    <i class="bi bi-file-pdf"></i>
                                </a> *@

                                @if (item.DirectionId == 2)
                                {
                                    <a class="btn btn-sm btn-outline-danger py-0 px-2 disabled"
                                       tabindex="-1"
                                       aria-disabled="true"
                                       title="Buy Invoice">
                                        <i class="bi bi-file-pdf"></i>
                                    </a>
                                }
                                else
                                {
                                    <a asp-action="PrintOfficialTaxInvoice"
                                       asp-controller="Invoices"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-danger py-0 px-2"
                                       target="_blank"
                                       title="Print Invoice">
                                        <i class="bi bi-file-pdf"></i>
                                    </a>
                                }
                                <!-- Edit -->
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary py-0 px-2"
                                        title="Edit"
                                        hx-get="@Url.Action("EditModal", "Invoices", new { id = item.Id })"
                                        hx-target="#invoice-modal-content"
                                        hx-swap="innerHTML"
                                        onclick="openInvoiceModal()">
                                    <i class="bi bi-pencil-square"></i>
                                </button>

                                <!-- Delete -->
                                <form hx-post="@Url.Action("Delete", "Invoices", new { id = item.Id })"
                                      hx-target="#invoice-list-container"
                                      hx-swap="innerHTML"
                                      hx-confirm="Are you sure you want to delete this invoice?"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="InvoiceNo" value="@Model.Filter.InvoiceNo" />
                                    <input type="hidden" name="InvoicePNo" value="@Model.Filter.InvoicePNo" />
                                    <input type="hidden" name="PartyName" value="@Model.Filter.PartyName" />
                                    <input type="hidden" name="InvoiceTypeId" value="@Model.Filter.InvoiceTypeId" />
                                    <input type="hidden" name="InvoiceStatusId" value="@Model.Filter.InvoiceStatusId" />
                                    <input type="hidden" name="FinanceDirectionId" value="@Model.Filter.FinanceDirectionId" />
                                    <input type="hidden" name="CurrencyId" value="@Model.Filter.CurrencyId" />
                                    <input type="hidden" name="InvoiceDateFrom" value="@(Model.Filter.InvoiceDateFrom?.ToString("yyyy-MM-dd"))" />
                                    <input type="hidden" name="InvoiceDateTo" value="@(Model.Filter.InvoiceDateTo?.ToString("yyyy-MM-dd"))" />
                                    <input type="hidden" name="PageNumber" value="@Model.Filter.PageNumber" />
                                    <input type="hidden" name="PageSize" value="@Model.Filter.PageSize" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>

                                <!-- Activity Log -->
                                <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                                        title="View Event Logs"
                                        hx-get="@Url.Action("IndexModal", "ActivityLog", new { entityTypeId = 11, entityId = item.Id, externalReferenceNo = item.InvoiceNo })"
                                        hx-target="#activityLogModalContainer"
                                        hx-swap="innerHTML">
                                    <i class="bi bi-clock-history"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    rowNumber++;
                }
            }
            else
            {
                <tr>
                    <td colspan="19" class="text-center text-muted py-4">No data found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("~/Views/Invoices/_InvoicePager.cshtml", Model)
