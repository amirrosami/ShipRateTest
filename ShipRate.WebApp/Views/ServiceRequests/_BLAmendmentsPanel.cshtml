@using ShipRate.Application.DTOs
@model BLAmendmentsPanelDto

<div class="card border-warning">
    <div class="card-header d-flex justify-content-between align-items-center py-2">
        <div>
            <strong>B/L Amendment Requests</strong>
            <span class="text-muted small">- Service Request #@Model.ServiceRequestNo</span>
        </div>

        <div class="d-flex gap-2">
            <button type="button"
                    class="btn btn-sm btn-warning"
                    hx-get="@Url.Action("CreateBLAmendmentRequest", "ServiceRequests", new { serviceRequestId = Model.ServiceRequestId })"
                    hx-target="#modal-container"
                    hx-swap="innerHTML">
                <i class="bi bi-plus-lg"></i>
                Add Request
            </button>

            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    onclick="document.getElementById('bl-amendments-panel').innerHTML = '';">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </div>

    <div class="card-body p-2">

        @if (Model.Requests == null || !Model.Requests.Any())
        {
            <div class="alert alert-info mb-0 py-2">
                No B/L amendment requests found for this service request.
            </div>
        }
        else
        {
            <div class="accordion" id="blAmendmentAccordion">

                @foreach (var request in Model.Requests)
                {
                    var collapseId = $"collapse-{request.Id}";
                    var headingId = $"heading-{request.Id}";

                    <div class="accordion-item mb-2 border">
                        <h2 class="accordion-header" id="@headingId">
                            <button class="accordion-button collapsed py-2"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#@collapseId"
                                    aria-expanded="false"
                                    aria-controls="@collapseId">
                                <div class="w-100 d-flex justify-content-between align-items-center me-3">
                                    <div>
                                        <strong>B/L:</strong> @request.BLNumber
                                        <span class="text-muted ms-2">
                                            @request.Reason
                                        </span>
                                    </div>

                                    <div class="small">
                                        <span class="badge bg-secondary">
                                            Lines: @(request.Lines?.Count ?? 0)
                                        </span>

                                        @if (request.RequiresCarrierApproval)
                                        {
                                            <span class="badge bg-warning text-dark">Carrier Approval</span>
                                        }

                                        @if (request.RequiresCustomerApproval)
                                        {
                                            <span class="badge bg-info text-dark">Customer Approval</span>
                                        }
                                    </div>
                                </div>
                            </button>
                        </h2>

                        <div id="@collapseId"
                             class="accordion-collapse collapse"
                             aria-labelledby="@headingId"
                             data-bs-parent="#blAmendmentAccordion">

                            <div class="accordion-body p-2">

                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="small text-muted">
                                        BL Number: @request.BLNumber
                                    </div>

                                    <div class="btn-group btn-group-sm">
                                        <button type="button"
                                                class="btn btn-outline-primary"
                                                title="Edit Request"
                                                hx-get="@Url.Action("EditBLAmendmentRequest", "ServiceRequests", new { id = request.Id })"
                                                hx-target="#modal-container"
                                                hx-swap="innerHTML">
                                            <i class="bi bi-pencil-square"></i>
                                            Edit
                                        </button>

                                        <button type="button"
                                                class="btn btn-outline-danger"
                                                title="Delete Request"
                                                hx-delete="@Url.Action("DeleteBLAmendmentRequest", "ServiceRequests", new { id = request.Id, serviceRequestId = Model.ServiceRequestId })"
                                                hx-target="#bl-amendments-panel"
                                                hx-swap="innerHTML"
                                                hx-confirm="Are you sure you want to delete this B/L amendment request?">
                                            <i class="bi bi-trash"></i>
                                            Delete
                                        </button>

                                        <button type="button"
                                                class="btn btn-outline-success"
                                                title="Add Line"
                                                hx-get="@Url.Action("CreateBLAmendmentRequestLine", "ServiceRequests", new { blAmendmentRequestId = request.Id })"
                                                hx-target="#modal-container"
                                                hx-swap="innerHTML">
                                            <i class="bi bi-plus-lg"></i>
                                            Add Line
                                        </button>
                                    </div>
                                </div>

                                @if (request.Lines == null || !request.Lines.Any())
                                {
                                    <div class="alert alert-light border mb-0 py-2">
                                        No amendment lines found.
                                    </div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered table-hover align-middle mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th style="width: 180px;">Field Type</th>
                                                    <th>Current Value</th>
                                                    <th>Requested Value</th>
                                                    <th>Remarks</th>
                                                    <th style="width: 110px;" class="text-center">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var line in request.Lines)
                                                {
                                                    <tr>
                                                        <td>@line.FieldTypeName</td>
                                                        <td>@line.CurrentValue</td>
                                                        <td>@line.RequestedValue</td>
                                                        <td>@line.Remarks</td>
                                                        <td class="text-center">
                                                            <button type="button"
                                                                    class="btn btn-sm btn-outline-primary"
                                                                    title="Edit Line"
                                                                    hx-get="@Url.Action("EditBLAmendmentRequestLine", "ServiceRequests", new { id = line.Id })"
                                                                    hx-target="#modal-container"
                                                                    hx-swap="innerHTML">
                                                                <i class="bi bi-pencil-square"></i>
                                                            </button>

                                                            <button type="button"
                                                                    class="btn btn-sm btn-outline-danger"
                                                                    title="Delete Line"
                                                                    hx-delete="@Url.Action("DeleteBLAmendmentRequestLine", "ServiceRequests", new { id = line.Id, serviceRequestId = Model.ServiceRequestId })"
                                                                    hx-target="#bl-amendments-panel"
                                                                    hx-swap="innerHTML"
                                                                    hx-confirm="Are you sure you want to delete this amendment line?">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }

                            </div>
                        </div>
                    </div>
                }

            </div>
        }
    </div>
</div>
