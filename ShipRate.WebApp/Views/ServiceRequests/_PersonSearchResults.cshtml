@using ShipRate.Application.DTOs
@model List<SPersonLookupDto>

@{
    var target = ViewBag.Target?.ToString() ?? "";
}

@if (Model.Any())
{
    <div class="list-group mt-1 border rounded">
        @foreach (var item in Model)
        {
            <button type="button"
                    class="list-group-item list-group-item-action text-start"
                    onclick="selectPerson('@target', '@item.Id', '@item.Name')">
                @item.Name
            </button>
        }
    </div>
}
