@using ShipRate.Application.DTOs
@model ServiceRequestIndexDto

@{
    ViewData["Title"] = "Service Requests";
}

<div class="container-fluid" dir="ltr">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Service Requests</h3>

        <button type="button"
                class="btn btn-primary"
                hx-get="@Url.Action("Create", "ServiceRequests")"
                hx-target="#modalBody"
                hx-swap="innerHTML"
                data-bs-toggle="modal"
                data-bs-target="#mainModal">
            + New Request
        </button>
        <button type="button"
                class="btn btn-primary"
                hx-get="@Url.Action("CreateBLAmendmentFullRequest", "ServiceRequests")"
                hx-target="#modalBody"
                hx-swap="innerHTML"
                data-bs-toggle="modal"
                data-bs-target="#mainModal">
            + New BL Ammendment Request
        </button>
    </div>

    @await Html.PartialAsync("_SearchPanel", Model)

    <div id="serviceRequestGrid">
        @await Html.PartialAsync("_Grid", Model)
    </div>

    <div id="approvals-panel" class="mt-3">
        @* @await Html.PartialAsync("_ApprovalsPanelPlaceholder") *@
    </div>
    <div id="bl-amendments-panel" class="mt-3"></div>
    <div id="split-requests-panel" class="mt-3"></div>
    <div id="charges-panel" class="mt-3"></div>

    <div id="modal-container"></div>
</div>

<div class="modal fade" id="mainModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                @*                 <h5 class="modal-title">Service Request</h5> *@
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalBody">
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="documentManagerModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content" id="document-manager-content">
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.body.addEventListener("serviceRequestChanged", function () {
            htmx.ajax('GET', '@Url.Action("Index", "ServiceRequests")', '#serviceRequestGrid');

            var modalEl = document.getElementById('mainModal');
            var modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) {
                modal.hide();
            }
        });

        function selectPerson(targetPrefix, id, name) {
            var hiddenId = document.getElementById(targetPrefix + "_PartyId");
            var displayInput = document.getElementById(targetPrefix + "_PartyDisplay");
            var resultBox = document.getElementById(targetPrefix + "_SearchResults");

            if (hiddenId) hiddenId.value = id;
            if (displayInput) displayInput.value = name;
            if (resultBox) resultBox.innerHTML = "";
        }
    </script>

    <script>
        const panelTargetIds = [
            'approvals-panel',
            'charges-panel',
            'bl-amendments-panel',
            'split-requests-panel'
        ];

        function cleanupBootstrapModal() {
            document.querySelectorAll('.modal-backdrop').forEach(function (el) {
                el.remove();
            });

            document.body.classList.remove('modal-open');
            document.body.style.removeProperty('overflow');
            document.body.style.removeProperty('padding-right');
        }

        document.body.addEventListener('htmx:afterSwap', function (e) {
            if (e.detail.target && e.detail.target.id === 'modal-container') {
                const modalEl = e.detail.target.querySelector('.modal');

                if (modalEl) {
                    cleanupBootstrapModal();

                    const modal = new bootstrap.Modal(modalEl, {
                        backdrop: true,
                        keyboard: true,
                        focus: true
                    });

                    modal.show();

                    modalEl.addEventListener('hidden.bs.modal', function () {
                        modal.dispose();

                        const container = document.getElementById('modal-container');
                        if (container) {
                            container.innerHTML = '';
                        }

                        cleanupBootstrapModal();
                    }, { once: true });
                }
            }
        });

        document.body.addEventListener('htmx:beforeSwap', function (e) {
            const targetId = e.detail.target ? e.detail.target.id : null;

            if (panelTargetIds.includes(targetId)) {
                const modalEl = document.querySelector('#modal-container .modal');

                if (modalEl) {
                    const modal = bootstrap.Modal.getInstance(modalEl);

                    if (modal) {
                        modal.hide();
                    } else {
                        modalEl.remove();
                        cleanupBootstrapModal();
                    }
                }
            }
        });

        document.body.addEventListener('htmx:afterSwap', function (e) {
            const targetId = e.detail.target ? e.detail.target.id : null;

            if (panelTargetIds.includes(targetId)) {
                const container = document.getElementById('modal-container');

                if (container) {
                    container.innerHTML = '';
                }

                cleanupBootstrapModal();
            }
        });
    </script>
}
