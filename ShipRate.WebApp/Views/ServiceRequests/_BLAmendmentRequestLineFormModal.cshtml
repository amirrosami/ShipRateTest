@using ShipRate.Application.DTOs
@model BLAmendmentRequestLineFormDto

<div class="modal fade"
     id="blAmendmentRequestLineModal"
     tabindex="-1"
     aria-labelledby="blAmendmentRequestLineModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <form method="post"
                  hx-post="@Url.Action("SaveBLAmendmentRequestLine", "ServiceRequests")"
                  hx-target="#bl-amendments-panel"
                  hx-swap="innerHTML">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="BLAmendmentRequestId" />
                <input type="hidden" asp-for="ServiceRequestId" />

                <div class="modal-header">
                    <h5 class="modal-title" id="blAmendmentRequestLineModalLabel">
                        @(Model.Id.HasValue ? "Edit Amendment Line" : "Add Amendment Line")
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    <div class="row g-3">

                        <div class="col-md-12">
                            <label asp-for="FieldTypeId" class="form-label"></label>
                            <select asp-for="FieldTypeId" asp-items="Model.FieldTypes" class="form-select">
                                <option value="">-- Select Field Type --</option>
                            </select>
                            <span asp-validation-for="FieldTypeId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CurrentValue" class="form-label"></label>
                            <textarea asp-for="CurrentValue" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="CurrentValue" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="RequestedValue" class="form-label"></label>
                            <textarea asp-for="RequestedValue" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="RequestedValue" class="text-danger"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Remarks" class="form-label"></label>
                            <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Remarks" class="text-danger"></span>
                        </div>

                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Save
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>
