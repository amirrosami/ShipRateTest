@using ShipRate.Application.DTOs
@model ServiceRequestFormDto
@{
    var isEdit = Model.Model.Id.HasValue;
    var actionName = isEdit ? "Edit" : "Create";
}
<form method="post"
      hx-post="@Url.Action(actionName, "ServiceRequests")"
      hx-target="#modalBody"
      hx-swap="innerHTML"
      dir="ltr">

    @Html.AntiForgeryToken()

    @if (isEdit)
    {
        <input type="hidden" asp-for="Model.Id" />
    }

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">

        <div class="col-md-4">
            <label asp-for="Model.CompanyId" class="form-label">Company</label>
            <select asp-for="Model.CompanyId" class="form-select"
                    asp-items="@(new SelectList(Model.Companies, "Id", "Name"))">
                <option value="">Select...</option>
            </select>
            <span asp-validation-for="Model.CompanyId" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Model.InOutId" class="form-label">In/Out</label>
            <select asp-for="Model.InOutId" class="form-select"
                    asp-items="@(new SelectList(Model.InOuts, "Id", "Name"))">
                <option value="">Select...</option>
            </select>
            <span asp-validation-for="Model.InOutId" class="text-danger"></span>
        </div>
        <div class="col-md-8">
            <label asp-for="Model.PartyId" class="form-label">Party</label>

            <input type="hidden"
                   asp-for="Model.PartyId"
                   id="CPartyId" />

            <input type="text"
                   id="CPartySearchText"
                   name="CParty"
                   value="@Model.PartyDisplayName"
                   class="form-control"
                   placeholder="Search Party..."
                   autocomplete="off"
                   hx-get="@Url.Action("SearchParties", "JobParty")"
                   hx-trigger="keyup changed delay:400ms"
                   hx-target="#partySearchResults"
                   hx-swap="innerHTML"
                   hx-vals='js:{
                            term: document.getElementById("CPartySearchText").value,
                            targetHiddenInputId: "CPartyId",
                            targetTextInputId: "CPartySearchText"
                       }' />
            <div id="partySearchResults"
                 class="position-relative">
            </div>
            <span asp-validation-for="Model.PartyId" class="text-danger small"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="Model.PartyDetailName" class="form-label">Party Detail Name</label>
            <input asp-for="Model.PartyDetailName" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Model.RequestNo" class="form-label">Request No</label>
            <input asp-for="Model.RequestNo" class="form-control" />
            <span asp-validation-for="Model.RequestNo" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Model.RequestTypeId" class="form-label">Request Type</label>
            <select asp-for="Model.RequestTypeId" class="form-select"
                    asp-items="@(new SelectList(Model.RequestTypes, "Id", "Name"))">
                <option value="">Select...</option>
            </select>
            <span asp-validation-for="Model.RequestTypeId" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="Model.PriorityId" class="form-label">Priority</label>
            <select asp-for="Model.PriorityId" class="form-select"
                    asp-items="@(new SelectList(Model.Priorities, "Id", "Name"))">
                <option value="">Select...</option>
            </select>
            <span asp-validation-for="Model.PriorityId" class="text-danger"></span>
        </div>

        <div class="col-md-8">
            <label asp-for="Model.Subject" class="form-label">Subject</label>
            <input asp-for="Model.Subject" class="form-control" />
            <span asp-validation-for="Model.Subject" class="text-danger"></span>
        </div>

        <div class="col-md-12">
            <label asp-for="Model.Description" class="form-label">Description</label>
            <textarea asp-for="Model.Description" class="form-control" rows="3"></textarea>
        </div>

        <div class="col-md-4">
            <label asp-for="Model.RequestDate" class="form-label">Request Date</label>
            <input asp-for="Model.RequestDate" type="datetime-local" class="form-control" />
            <span asp-validation-for="Model.RequestDate" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="Model.DueDate" class="form-label">Due Date</label>
            <input asp-for="Model.DueDate" type="datetime-local" class="form-control" />
        </div>


        <div class="col-md-3">
            <label asp-for="Model.IsChargeable" class="form-label">Is Chargeable</label>
            <div class="form-check">
                <input asp-for="Model.IsChargeable" class="form-check-input" />
            </div>
        </div>
       <div class="col-md-6">
            <label asp-for="Model.ExternalReferenceNo" class="form-label">External Reference No</label>
            <input asp-for="Model.ExternalReferenceNo" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Model.Remarks" class="form-label">Remarks</label>
            <input asp-for="Model.Remarks" class="form-control" />
        </div>
    </div>

    <div class="mt-4 d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-success">Save</button>
    </div>
</form>
