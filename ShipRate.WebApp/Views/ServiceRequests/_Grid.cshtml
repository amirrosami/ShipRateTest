@using ShipRate.Application.DTOs
@model ServiceRequestIndexDto
<style>

    .service-request-table-wrapper {
        display: block;
        width: 100%;
        max-width: 100%;
        overflow-x: auto !important;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
    }

    .service-request-table {
        width: max-content;
        min-width: 1500px;
        margin-bottom: 0;
    }

        .service-request-table th,
        .service-request-table td {
            white-space: nowrap;
        }

            .service-request-table td:nth-child(7) {
                white-space: normal;
                min-width: 180px;
                max-width: 300px;
            }

            .service-request-table td:last-child,
            .service-request-table th:last-child {
                min-width: 230px;
            }

</style>
<div class="card service-request-card">
    <div class="card-body py-2">
        <div class="mb-2 small">
            <strong>Total Records:</strong> @Model.Result.TotalCount
        </div>

        <div class="table-responsive service-request-table-wrapper">
            <table class="table table-sm table-bordered table-striped table-hover align-middle mb-0 service-request-table">
                <thead class="table-light">
                    <tr>
                        <th class="py-1 px-2">Company</th>
                        <th class="py-1 px-2">In/Out</th>
                        <th class="py-1 px-2">Party</th>
                        <th class="py-1 px-2">Request No</th>
                        <th class="py-1 px-2">Request Date</th>
                        <th class="py-1 px-2">Request Type</th>
                        <th class="py-1 px-2">Subject</th>
                        <th class="py-1 px-2">Created by</th>
                        <th class="py-1 px-2">Create Date</th>
                        <th class="py-1 px-2">Updated by</th>
                        <th class="py-1 px-2">Update Date</th>
                        <th class="py-1 px-2">Status</th>
                        <th class="py-1 px-2 text-center">Actions</th>
                    </tr>
                </thead>

                <tbody class="small">
                    @if (Model.Result.Items.Any())
                    {
                        foreach (var item in Model.Result.Items)
                        {
                            <tr>
                                <td class="py-1 px-2">@item.CompanyName</td>
                                <td class="py-1 px-2">@item.InOutName</td>
                                <td class="py-1 px-2">@item.PartyName</td>
                                <td class="py-1 px-2">@item.RequestNo</td>
                                <td class="py-1 px-2">
                                    @item.RequestDate.ToString("yyyy-MM-dd")
                                </td>
                                <td class="py-1 px-2">@item.RequestTypeName</td>
                                <td class="py-1 px-2">@item.Subject</td>
                                <td class="py-1 px-2">@item.CreateUserName</td>
                                <td class="py-1 px-2">@item.CreatedAt</td>
                                <td class="py-1 px-2">@item.UpdateUserName</td>
                                <td class="py-1 px-2">@item.UpdatedAt</td>
                                <td class="py-1 px-2">@item.StatusName</td>

                                <td class="py-1 px-2">
                                    <div class="d-flex flex-nowrap justify-content-center gap-1">
                                        @if (item.RequestTypeId == 1)
                                        {
                                            <button type="button"
                                            class="btn btn-sm btn-outline-warning"
                                            title="Details"
                                            hx-get="@Url.Action("ShowSpecificPanel", "ServiceRequests", new { serviceRequestId = item.Id, requestTypeId = item.RequestTypeId })"
                                            hx-target="#bl-amendments-panel"
                                            hx-swap="innerHTML">
                                                <i class="bi bi-file-earmark-text"></i>
                                            </button>
                                        }

                                        @if (item.RequestTypeId == 3)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-info"
                                                    title="Split Request"
                                                    hx-get="@Url.Action("SplitRequestsPanel", "ServiceRequests", new { serviceRequestId = item.Id })"
                                                    hx-target="#split-requests-panel"
                                                    hx-swap="innerHTML">
                                                <i class="bi bi-diagram-3"></i>
                                            </button>
                                        }
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                hx-get="/DocumentManager/Index?objectId=@item.Id&objectTypeId=12"
                                                hx-target="#document-manager-content"
                                                hx-swap="innerHTML"
                                                title="Attachments"
                                                data-bs-toggle="modal"
                                                data-bs-target="#documentManagerModal">
                                            <i class="bi bi-folder2-open me-1"></i>
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-success"
                                                title="Charges"
                                                hx-get="@Url.Action("ChargesPanel", "ServiceRequests", new { serviceRequestId = item.Id })"
                                                hx-target="#charges-panel"
                                                hx-swap="innerHTML">
                                            <i class="bi bi-cash-stack"></i>
                                        </button>

                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                hx-get="@Url.Action("ApprovalsPanel", "ServiceRequests", new { serviceRequestId = item.Id })"
                                                hx-target="#approvals-panel"
                                                hx-swap="innerHTML"
                                                title="Approvals">
                                            <i class="bi bi-check"></i>
                                        </button>



                                        <button type="button"
                                                class="btn btn-sm btn-outline-warning"
                                                title="Edit"
                                                hx-get="@Url.Action("Edit", "ServiceRequests", new { id = item.Id })"
                                                hx-target="#modalBody"
                                                hx-swap="innerHTML"
                                                data-bs-toggle="modal"
                                                data-bs-target="#mainModal">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>

                                        <form method="post"
                                              hx-post="@Url.Action("Delete", "ServiceRequests", new { id = item.Id })"
                                              hx-confirm="Are you sure you want to delete this record?"
                                              class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="13" class="text-center py-2">
                                No records found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>
