@using ShipRate.Application.DTOs
@model BLAmendmentFullRequestFormDto

<div class="d-flex justify-content-between align-items-center mb-3">
    <h6 class="mb-0">Amendment Lines</h6>

    <button type="button"
            class="btn btn-sm btn-outline-primary"
            hx-get="@Url.Action("AddBLAmendmentFullRequestLine", "ServiceRequests")"
            hx-target="#blAmendmentLinesContainer"
            hx-swap="beforeend"
            hx-vals='js:{ index: document.querySelectorAll(".bl-amendment-line").length }'>
        + Add Line
    </button>
</div>
<div id="blAmendmentLinesContainer">
    @for (var i = 0; i < Model.Lines.Count; i++)
    {
        <div class="border rounded p-3 mb-3 bl-amendment-line">
            <div class="row g-3">
                <div class="col-md-1">
                    <strong>Line @(i + 1) :</strong>
                </div>
                <div class="col-md-3">
                    <label asp-for="Lines[i].FieldTypeId" class="form-label">Field Type</label>
                    <select asp-for="Lines[i].FieldTypeId"
                            asp-items="Model.Lines[i].FieldTypes"
                            class="form-select">
                        <option value="">-- Select Field Type --</option>
                    </select>
                    <span asp-validation-for="Lines[i].FieldTypeId" class="text-danger"></span>
                </div>
                <div class="col-md-7">
                    <label asp-for="Lines[i].Remarks" class="form-label">Remarks</label>
                    <textarea asp-for="Lines[i].Remarks" class="form-control" rows="1"></textarea>
                    <span asp-validation-for="Lines[i].Remarks" class="text-danger"></span>
                </div>
                <div class="col-md-1">
                    <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            onclick="removeBLAmendmentLine(this)">
                        Remove
                    </button>
                </div>


                <div class="col-md-6">
                    <label asp-for="Lines[i].CurrentValue" class="form-label">Current Value</label>
                    <textarea asp-for="Lines[i].CurrentValue" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Lines[i].CurrentValue" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Lines[i].RequestedValue" class="form-label">Requested Value</label>
                    <textarea asp-for="Lines[i].RequestedValue" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Lines[i].RequestedValue" class="text-danger"></span>
                </div>
            </div>
        </div>
    }
</div>
