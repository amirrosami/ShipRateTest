@using ShipRate.Application.DTOs.Finance
@model List<PaymentAllocationDto>

<table class="table table-sm table-bordered align-middle">
    <thead class="table-light">
        <tr>
            <th>Payment Document</th>
            <th>Date</th>
            <th class="text-end">Document Amount</th>
            <th class="text-end">Allocated Amount</th>
            <th class="text-end">Settled Amount</th>
            <th class="text-end">Exchange Rate</th>
            <th>Remarks</th>
            <th style="width:80px;"></th>
        </tr>
    </thead>

    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="8" class="text-center text-muted py-3">
                    No payment allocations.
                </td>
            </tr>
        }
        else
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.PaymentDocumentNo</td>
                    <td>@item.PaymentDocumentDate.ToString("yyyy-MM-dd")</td>
                    <td class="text-end">@item.PaymentDocumentAmount.ToString("N2")</td>
                    <td class="text-end">@item.AllocatedAmount.ToString("N2")</td>
                    <td class="text-end">@item.SettledAmountInItemCurrency.ToString("N2")</td>
                    <td class="text-end">@item.ExchangeRateValue.ToString("N4")</td>
                    <td>@item.Remarks</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-danger"
                                hx-post="@Url.Action("DeletePaymentAllocation", "Settlements", new { id = item.Id, settlementId = item.SettlementId })"
                                hx-target="#paymentsPanel"
                                hx-confirm="Delete this payment allocation?">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
