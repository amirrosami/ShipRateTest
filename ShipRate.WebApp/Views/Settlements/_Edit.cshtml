@using ShipRate.Application.DTOs.Finance
@model SettlementDetailsDto

<div class="modal-header">
    <h5 class="modal-title">
        Settlement #@Model.Header.SettlementNo
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">

    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabHeader" type="button">
                Header
            </button>
        </li>

        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabItems" type="button">
                Settlement Items
            </button>
        </li>

        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabPayments" type="button">
                Payment Allocations
            </button>
        </li>
    </ul>

    <div class="tab-content">

        <div class="tab-pane fade show active" id="tabHeader">
            <div id="headerPanel">
                @await Html.PartialAsync("_EditHeader", Model.Header)
            </div>
        </div>

        <div class="tab-pane fade" id="tabItems">
            <div class="d-flex justify-content-between mb-2">
                <h6>Settlement Items</h6>

                <button type="button"
                        class="btn btn-sm btn-primary"
                        hx-get="@Url.Action("AddItem", "Settlements", new { settlementId = Model.Header.Id })"
                        hx-target="#childModalBody"
                        hx-swap="innerHTML">
                    Add Item
                </button>
            </div>

            <div id="itemsPanel">
                @await Html.PartialAsync("_Items", Model.Items)
            </div>
        </div>

        <div class="tab-pane fade" id="tabPayments">
            <div class="d-flex justify-content-between mb-2">
                <h6>Payment Allocations</h6>

                <button type="button"
                        class="btn btn-sm btn-primary"
                        hx-get="@Url.Action("AddPaymentAllocation", "Settlements", new { settlementId = Model.Header.Id })"
                        hx-target="#childModalBody"
                        hx-swap="innerHTML">
                    Add Item
                </button>

            </div>

            <div id="paymentsPanel">
                @await Html.PartialAsync("_PaymentAllocations", Model.PaymentAllocations)
            </div>
        </div>

    </div>

</div>

<div class="modal-footer">
    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
</div>

<div class="modal fade" id="childModal" tabindex="-1" dir="ltr">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div id="childModalBody"></div>
        </div>
    </div>
</div>
<script>
    document.body.addEventListener('htmx:afterSwap', function (evt) {

        if (evt.detail.target.id === 'childModalBody') {

            var modal = new bootstrap.Modal(document.getElementById('childModal'));
            modal.show();

        }

    });

    // document.body.addEventListener('settlementSaved', function () {

