@using ShipRate.Application.DTOs
@using ShipRate.Application.DTOs.Finance
@model PagedResultDto<SettlementListItemDto>

@{
    var totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
    var currentPage = Model.PageNumber;

    var startPage = Math.Max(1, currentPage - 2);
    var endPage = Math.Min(totalPages, currentPage + 2);

    if (currentPage <= 3)
    {
        endPage = Math.Min(5, totalPages);
    }

    if (currentPage >= totalPages - 2)
    {
        startPage = Math.Max(1, totalPages - 4);
    }
}

@if (totalPages > 1)
{
    <div class="d-flex justify-content-between align-items-center">

        <div class="text-muted small">
            Total: @Model.TotalCount records
        </div>

        <nav>
            <ul class="pagination pagination-sm mb-0">

                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <button class="page-link"
                            hx-get="@Url.Action("List", "Settlements")"
                            hx-include="#settlementSearchForm"
                            hx-vals='{"Page":"@(currentPage - 1)"}'
                            hx-target="#settlementGrid">
                        Previous
                    </button>
                </li>

                @if (startPage > 1)
                {
                    <li class="page-item">
                        <button class="page-link"
                                hx-get="@Url.Action("List", "Settlements")"
                                hx-include="#settlementSearchForm"
                                hx-vals='{"Page":"1"}'
                                hx-target="#settlementGrid">
                            1
                        </button>
                    </li>

                    @if (startPage > 2)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }
                }

                @for (var i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <button class="page-link"
                                hx-get="@Url.Action("List", "Settlements")"
                                hx-include="#settlementSearchForm"
                                hx-vals='{"Page":"@i"}'
                                hx-target="#settlementGrid">
                            @i
                        </button>
                    </li>
                }

                @if (endPage < totalPages)
                {
                    @if (endPage < totalPages - 1)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }

                    <li class="page-item">
                        <button class="page-link"
                                hx-get="@Url.Action("List", "Settlements")"
                                hx-include="#settlementSearchForm"
                                hx-vals='{"Page":"@totalPages"}'
                                hx-target="#settlementGrid">
                            @totalPages
                        </button>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <button class="page-link"
                            hx-get="@Url.Action("List", "Settlements")"
                            hx-include="#settlementSearchForm"
                            hx-vals='{"Page":"@(currentPage + 1)"}'
                            hx-target="#settlementGrid">
                        Next
                    </button>
                </li>

            </ul>
        </nav>
    </div>
}
