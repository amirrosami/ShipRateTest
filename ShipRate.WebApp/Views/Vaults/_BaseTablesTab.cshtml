@using ShipRate.Application.DTOs
@model List<LookupItemDto>
@{
    var currentType = ViewBag.EntityType as string ?? "category";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
        <div class="btn-group btn-group-sm">
            <button class="btn @(currentType == "category" ? "btn-primary" : "btn-outline-secondary")" hx-get="/Vaults/GetBaseTablesTab?entityType=category" hx-target="#basePane">Categories</button>
            <button class="btn @(currentType == "sourcetype" ? "btn-primary" : "btn-outline-secondary")" hx-get="/Vaults/GetBaseTablesTab?entityType=sourcetype" hx-target="#basePane">Movement Sources</button>
            <button class="btn @(currentType == "status" ? "btn-primary" : "btn-outline-secondary")" hx-get="/Vaults/GetBaseTablesTab?entityType=status" hx-target="#basePane">Item Statuses</button>
        </div>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0 vault-table">
            <thead>
                <tr>
                    <th style="width: 80px;">ID</th>
                    <th>Code / Name (Latin)</th>
                    <th>Local Title</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    <tr>
                        <td class="fw-bold">@row.Id</td>
                        <td>@row.Name</td>
                        <td>@row.LocalName</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
