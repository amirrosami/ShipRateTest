@using ShipRate.Application.DTOs
@model List<VaultDto>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
        <span class="fw-bold text-muted"><i class="bi bi-shield-check me-1"></i>Registered Company Vaults</span>
        <button class="btn btn-sm btn-primary" hx-get="/Vaults/UpsertVaultModal" hx-target="#modalContainer" data-bs-toggle="modal" data-bs-target="#appModal">
            <i class="bi bi-plus-circle me-1"></i>New Vault
        </button>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0 vault-table">
            <thead>
                <tr>
                    <th>Vault Name</th>
                    <th>Branch</th>
                    <th>Vault Keeper</th>
                    <th>Status</th>
                    <th>Liquidity Summary</th>
                    <th>Remarks</th>
                    <th class="text-end" style="width: 140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-3 text-muted">No vaults registered yet.</td>
                    </tr>
                }
                else
                {
                    @foreach (var vault in Model)
                    {
                        <tr>
                            <td class="fw-bold text-primary">@vault.VaultName</td>
                            <td>@(vault.BranchName ?? "-")</td>
                            <td>@(vault.KeeperUserName ?? "-")</td>
                            <td>
                                @if (vault.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td>
                                @if (vault.Assets.Any())
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var asset in vault.Assets)
                                        {
                                            <span class="badge bg-light text-dark border">
                                                @asset.CurrencyCode: <strong>@asset.Amount.ToString("N0")</strong>
                                            </span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted" style="font-size: 0.75rem;">No Balances</span>
                                }
                            </td>
                            <td class="text-truncate" style="max-width: 200px;">@vault.Remarks</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" hx-get="/Vaults/UpsertVaultModal?id=@vault.Id" hx-target="#modalContainer" data-bs-toggle="modal" data-bs-target="#appModal">
                                        <i class="bi bi-pencil"></i> Edit
                                    </button>
                                    <button class="btn @(vault.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                            hx-post="/Vaults/ToggleVaultStatus?id=@vault.Id"
                                            hx-confirm="Change active status for this vault?">
                                        <i class="bi @(vault.IsActive ? "bi-slash-circle" : "bi-check-circle")"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
