@using ShipRate.Application.DTOs
@model VaultItemUpsertDto

<div class="modal-content vault-modal">
    <div class="modal-header py-2">
        <h6 class="modal-title fw-bold">@(Model.Id.HasValue ? "Edit Custody Item" : "Deposit Non-Fungible Item")</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <form hx-post="/Vaults/UpsertItem" hx-swap="none">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="VaultId" />
        <div class="modal-body p-3">
            <div class="excel-grid">
                <div class="excel-field">
                    <label>Category</label>
                    <select asp-for="VaultItemCategoryId" class="form-select">
                        <option value="1">Title Deed</option>
                        <option value="2">Vessel Document</option>
                        <option value="3">Original B/L (OBL)</option>
                        <option value="4">Bank Guarantee</option>
                        <option value="5">Promissory Note</option>
                        <option value="6">Guarantee Cheque</option>
                        <option value="8">Hardware Device / Token</option>
                    </select>
                </div>
                <div class="excel-field">
                    <label>Document Title</label>
                    <input asp-for="Title" class="form-control" required />
                </div>
                <div class="excel-field">
                    <label>Identifier/No</label>
                    <input asp-for="IdentifierNo" class="form-control" placeholder="Plaque / Cheque / Serial" />
                </div>
                <div class="excel-field">
                    <label>Beneficiary</label>
                    <input asp-for="OwnerOrBeneficiary" class="form-control" />
                </div>
                <div class="excel-field">
                    <label>Nominal Value</label>
                    <input asp-for="NominalValue" type="number" step="0.01" class="form-control" />
                </div>
                <div class="excel-field">
                    <label>Shelf Location</label>
                    <input asp-for="ShelfLocation" class="form-control" placeholder="Box 3, Folder B" />
                </div>
                <div class="excel-field">
                    <label>Issue Date</label>
                    <input asp-for="IssueDate" type="date" class="form-control" />
                </div>
                <div class="excel-field">
                    <label>Expiry Date</label>
                    <input asp-for="ExpiryDate" type="date" class="form-control" />
                </div>
            </div>
            <div class="excel-field mt-2 w-100">
                <label>Description</label>
                <input asp-for="Description" class="form-control" />
            </div>
        </div>
        <div class="modal-footer py-2">
            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-sm btn-primary">Save Document</button>
        </div>
    </form>
</div>
