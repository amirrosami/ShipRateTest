@using ShipRate.Application.DTOs
@using ShipRate.Domain.Entities.Finance
@model PagedResultDto<CashPaymentRequestDto>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0 vault-table">
            <thead>
                <tr>
                    <th>Req No</th>
                    <th>Payee</th>
                    <th>Reason</th>
                    <th>Currency</th>
                    <th class="text-end">Amount</th>
                    <th>Status</th>
                    <th>Approvals</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Items)
                {
                    <tr>
                        <td class="fw-bold">@r.RequestNo</td>
                        <td>@r.PayeeName</td>
                        <td>@r.Reason</td>
                        <td>@r.CurrencyCode</td>
                        <td class="text-end fw-bold">@r.Amount.ToString("N2")</td>
                        <td>
                            @switch (r.StatusId)
                            {
                                case 1:
                                    <span class="badge bg-warning text-dark">Pending</span>
                                    ; break;
                                case 2:

                                    <span class="badge bg-success">Paid</span>
                                    ; break;
                                case 3:

                                    <span class="badge bg-danger">Rejected</span>
                                    ; break;
                                default:

                                    <span class="badge bg-secondary">Draft</span>
                                    ; break;
                            }
                        </td>
                        <td>
                            <small class="d-block">Init: @(r.InitialConfirmedByName ?? "Pending")</small>
                            <small class="d-block">Final: @(r.FinalConfirmedByName ?? "Pending")</small>
                        </td>
                        <td class="text-center align-middle" style="white-space: nowrap;">
                            @if (r.StatusId == (int)EnumCashPaymentRequestStatus.Pending)
                            {
                                <div class="btn-group btn-group-sm" role="group">
                                    @* اگر تایید اولیه نشده *@
                                    @if (string.IsNullOrEmpty(r.InitialConfirmedByName))
                                    {
                                        <button type="button" class="btn btn-outline-info btn-sm px-2 py-0"
                                                title="Initial Approve"
                                                hx-post="@Url.Action("ApproveInitialPaymentRequest", "Vaults", new { id = r.Id })"
                                                hx-target="#requestsPane"
                                                hx-confirm="Are you sure you want to provide initial approval for @r.RequestNo?">
                                            <i class="bi bi-check-circle"></i> Init
                                        </button>
                                    }
                                    else if (string.IsNullOrEmpty(r.FinalConfirmedByName))
                                    {
                                        @* تایید نهایی *@
                                        <button type="button" class="btn btn-outline-success btn-sm px-2 py-0"
                                                title="Final Approve"
                                                hx-post="@Url.Action("ApproveFinalPaymentRequest", "Vaults", new { id = r.Id })"
                                                hx-target="#requestsPane"
                                                hx-confirm="Are you sure you want to provide final approval for @r.RequestNo?">
                                            <i class="bi bi-check-all"></i> Final
                                        </button>
                                    }

                                    @* پرداخت نهایی (در صورت تایید نهایی یا مستقیم بر اساس رول شما) *@
                                    @if (!string.IsNullOrEmpty(r.FinalConfirmedByName))
                                    {
                                        <button type="button" class="btn btn-success btn-sm px-2 py-0"
                                                title="Execute & Pay"
                                                hx-post="@Url.Action("ExecutePaymentRequest", "Vaults", new { id = r.Id })"
                                                hx-target="#requestsPane"
                                                hx-confirm="Confirm payment execution of @r.Amount.ToString("N2") @r.CurrencyCode from vault?">
                                            <i class="bi bi-cash-stack"></i> Pay
                                        </button>
                                    }

                                    @* دکمه رد درخواست *@
                                    <button type="button" class="btn btn-outline-danger btn-sm px-2 py-0"
                                            title="Reject Request"
                                            onclick="openRejectModal('@r.Id', '@r.RequestNo')">
                                        <i class="bi bi-x-circle"></i> Reject
                                    </button>
                                </div>
                            }
                            else if (r.StatusId == (int)EnumCashPaymentRequestStatus.Paid)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    <i class="bi bi-check2-circle me-1"></i> Paid by @r.PaidByName
                                </span>
                            }
                            else if (r.StatusId == (int)EnumCashPaymentRequestStatus.Rejected)
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle"
                                      data-bs-toggle="tooltip"
                                      title="Reason: @r.RejectReason">
                                    <i class="bi bi-x-octagon me-1"></i> Rejected
                                </span>
                            }

                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    hx-get="/DocumentManager/Index?objectId=@r.Id&objectTypeId=490"
                                    hx-target="#document-manager-content"
                                    hx-swap="innerHTML"
                                    data-bs-toggle="modal"
                                    title="مستندات"
                                    data-bs-target="#documentManagerModal">
                                <i class="bi bi-folder2-open me-1"></i>
                            </button>



                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


<!-- Reject Reason Modal -->
<div class="modal fade" id="rejectPaymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content" style="font-size: 0.85rem;">
            <form hx-post="@Url.Action("RejectPaymentRequest", "Vaults")"
                  hx-target="#tab-content"
                  hx-on::after-request="bootstrap.Modal.getInstance(document.getElementById('rejectPaymentModal')).hide()">
                @Html.AntiForgeryToken()
                <input type="hidden" id="rejectRequestId" name="id" />

                <div class="modal-header py-2 bg-light">
                    <h6 class="modal-title fs-7 fw-bold text-danger">
                        <i class="bi bi-x-circle me-1"></i> Reject Request <span id="rejectRequestNo"></span>
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="excel-grid">
                        <div class="excel-field">
                            <label class="form-label text-muted fw-semibold mb-1">Rejection Reason <span class="text-danger">*</span></label>
                            <textarea name="reason" class="form-control form-control-sm" rows="3" required placeholder="Specify reason for rejection..."></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer py-1 bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger btn-sm">Confirm Reject</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openRejectModal(id, requestNo) {
        document.getElementById('rejectRequestId').value = id;
        document.getElementById('rejectRequestNo').innerText = requestNo;
        var modal = new bootstrap.Modal(document.getElementById('rejectPaymentModal'));
        modal.show();
    }
</script>


