@using ShipRate.Application.DTOs
@model CreateCashPaymentRequestDto

<div class="modal-content vault-modal">
    <div class="modal-header py-2">
        <h6 class="modal-title fw-bold">
            <i class="bi bi-cash-stack me-1"></i>New Cash Payment Request
        </h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <form hx-post="/Vaults/CreatePaymentRequest" hx-swap="none">
        @Html.AntiForgeryToken()

        <div class="modal-body p-3">
            <div class="excel-grid">
                <!-- Vault Selector -->
                <div class="excel-field">
                    <label>Vault</label>
                    <select asp-for="VaultId" class="form-select" required>
                        <option value="">-- Select Vault --</option>
                        @if (ViewBag.Vaults != null)
                        {
                            foreach (var vault in (IEnumerable<dynamic>)ViewBag.Vaults)
                            {
                                <option value="@vault.Id">@vault.Name</option>
                            }
                        }
                    </select>
                </div>

                <!-- Currency Selector -->
                <div class="excel-field">
                    <label>Currency</label>
                    <select asp-for="CurrencyId" class="form-select" required>
                        <option value="">-- Select Currency --</option>
                        @if (ViewBag.Currencies != null)
                        {
                            foreach (var cur in (IEnumerable<dynamic>)ViewBag.Currencies)
                            {
                                <option value="@cur.Id">@cur.Name</option>
                            }
                        }
                    </select>
                </div>

                <!-- Amount -->
                <div class="excel-field">
                    <label>Amount</label>
                    <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00" required />
                </div>

            </div>

            <!-- Reason / Remarks (Full Width) -->
            <div class="excel-field mt-2 w-100">
                <label>Reason / Purpose</label>
                <input asp-for="Reason" class="form-control" placeholder="Explain the purpose of this cash withdrawal..." required />
            </div>
        </div>

        <div class="modal-footer py-2">
            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-sm btn-primary">
                <i class="bi bi-check2 me-1"></i>Submit Request
            </button>
        </div>
    </form>
</div>
