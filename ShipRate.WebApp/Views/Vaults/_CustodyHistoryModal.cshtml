@using ShipRate.Application.DTOs
@model VaultItemCustodyHistoryViewModel

<div class="modal-content vault-modal" style="font-size: 0.85rem;">
    <!-- Modal Header -->
    <div class="modal-header py-2 bg-light">
        <h6 class="modal-title fw-bold">
            <i class="bi bi-clock-history text-info me-1"></i> Custody Audit Trail / History Logs
        </h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <!-- Modal Body -->
    <div class="modal-body p-3">
        <!-- Item Info Bar -->
        <div class="bg-light-subtle border rounded p-2 mb-3 d-flex justify-content-between align-items-center">
            <div>
                <span class="text-muted small">Item:</span>
                <span class="fw-bold text-primary ms-1">@Model.ItemTitle</span>
                @if (!string.IsNullOrEmpty(Model.TrackingNo))
                {
                    <span class="badge bg-secondary-subtle text-dark ms-2">No: @Model.TrackingNo</span>
                }
            </div>
            <div>
                <span class="text-muted small">Current Custodian:</span>
                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle ms-1">
                    <i class="bi bi-person-check me-1"></i>@Model.CurrentCustodianName
                </span>
            </div>
        </div>

        @if (Model.Logs == null || !Model.Logs.Any())
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-folder-x fs-3 d-block mb-1 text-secondary"></i>
                <em>No custody movements or actions recorded for this item yet.</em>
            </div>
        }
        else
        {
            <div class="table-responsive" style="max-height: 380px; overflow-y: auto;">
                <table class="table table-sm table-hover table-bordered mb-0 align-middle" style="font-size: 0.8rem;">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th style="width: 125px;">Date & Time</th>
                            <th style="width: 120px;">Action</th>
                            <th>Operator (From)</th>
                            <th>Receiver (To)</th>
                            <th>Reason / Remarks</th>
                            <th style="width: 105px;">Exp. Return</th>
                            <th style="width: 55px;" class="text-center">Doc</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.Logs)
                        {
                            <tr>
                                <td class="text-nowrap text-muted">
                                    <i class="bi bi-calendar3 me-1"></i>@log.ActionDate.ToString("yyyy-MM-dd HH:mm")
                                </td>
                                <td>
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                        @log.ActionTypeName
                                    </span>
                                </td>
                                <td class="fw-semibold text-dark">
                                    <i class="bi bi-person-badge me-1 text-muted"></i>@log.ExecutedByName
                                </td>
                                <td>
                                    <span class="text-primary fw-medium">
                                        <i class="bi bi-arrow-right-short text-muted"></i>@log.ReceiverName
                                    </span>
                                </td>
                                <td class="text-break">@log.Reason</td>
                                <td class="text-nowrap">
                                    @if (log.ExpectedReturnDate.HasValue)
                                    {
                                        <span class="text-warning-emphasis fw-semibold">
                                            @log.ExpectedReturnDate.Value.ToString("yyyy-MM-dd")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (!string.IsNullOrEmpty(log.HandoverReceiptScanPath))
                                    {
                                        <a href="@log.HandoverReceiptScanPath" target="_blank" class="btn btn-xs btn-outline-primary" title="View Handover Receipt">
                                            <i class="bi bi-paperclip"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                            hx-get="/DocumentManager/Index?objectId=@log.Id&objectTypeId=493"
                                            hx-target="#document-manager-content"
                                            hx-swap="innerHTML"
                                            data-bs-toggle="modal"
                                            title="مستندات"
                                            data-bs-target="#documentManagerModal">
                                        <i class="bi bi-folder2-open me-1"></i>
                                    </button>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Modal Footer -->
    <div class="modal-footer py-2 bg-light">
        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
    </div>
</div>
