@using ShipRate.Application.DTOs
@model VaultCustodyActionDto

<div class="modal-content vault-modal">
    <div class="modal-header py-2">
        <h6 class="modal-title fw-bold">Custody Action Operation</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <form hx-post="/Vaults/ExecuteCustodyAction" hx-swap="none">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="VaultItemId" />
        <input type="hidden" asp-for="ActionTypeId" />
        <div class="modal-body p-3">
            <div class="excel-grid">
                <div class="excel-field">
                    <label>Holder Name</label>
                    <input asp-for="HandedToExternalName" class="form-control" placeholder="Recipient / Lawyer / Staff" />
                </div>
                <div class="excel-field">
                    <label>Expected Return</label>
                    <input asp-for="ExpectedReturnDate" type="date" class="form-control" />
                </div>
            </div>
            <div class="excel-field mt-2 w-100">
                <label>Reason / Note</label>
                <input asp-for="Reason" class="form-control" required placeholder="Mandatory release reason" />
            </div>
        </div>
        <div class="modal-footer py-2">
            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-sm btn-warning">Confirm Custody Action</button>
        </div>
    </form>
</div>
