@using ShipRate.Application.DTOs
@model PagedResultDto<VaultMovementDto>
@{
    var filter = ViewBag.Filter as VaultMovementFilterDto ?? new();
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-2">
        <form class="excel-grid" hx-get="/Vaults/GetMovementsTab" hx-target="#movementsPane">
            <input type="hidden" name="VaultId" value="@filter.VaultId" />
            <div class="excel-field">
                <label>Search</label>
                <input type="text" name="SearchTerm" class="form-control" value="@filter.SearchTerm" placeholder="Ref No / Person / Remarks" />
            </div>
            <div class="excel-field">
                <label>Direction</label>
                <select name="InOutId" class="form-select">
                    <option value="">All</option>
                    <!option value="1" @(filter.InOutId == 1 ? "selected" : "")>Incoming (+)</!option>
                    <!option value="2" @(filter.InOutId == 2 ? "selected" : "")>Outgoing (-)</!option>
                </select>
            </div>
            <div class="d-flex align-items-center">
                <button type="submit" class="btn btn-sm btn-secondary"><i class="bi bi-search me-1"></i>Filter</button>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0 vault-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Source</th>
                    <th>Reference</th>
                    <th>Party/Depositor</th>
                    <th>Currency</th>
                    <th class="text-end">Amount</th>
                    <th>Operator</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.Items)
                {
                    <tr>
                        <td>@m.MovementDate?.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @if (m.InOutId == 1)
                            {
                                <span class="badge bg-success">Incoming</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Outgoing</span>
                            }
                        </td>
                        <td>@m.SourceTypeName</td>
                        <td>@m.ReferenceNo</td>
                        <td>@m.DepositorOrReceiver</td>
                        <td>@m.CurrencyCode</td>
                        <td class="text-end fw-bold">@m.Amount.ToString("N2")</td>
                        <td>@m.ExecutedByUserName</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    hx-get="/DocumentManager/Index?objectId=@m.Id&objectTypeId=492"
                                    hx-target="#document-manager-content"
                                    hx-swap="innerHTML"
                                    data-bs-toggle="modal"
                                    title="مستندات"
                                    data-bs-target="#documentManagerModal">
                                <i class="bi bi-folder2-open me-1"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <!-- Pagination Footer -->
    <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2">
        <span>Page @Model.PageNumber of @Model.TotalPages (Total: @Model.TotalCount)</span>
        <ul class="pagination pagination-sm m-0">
            @if (Model.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" hx-get="/Vaults/GetMovementsTab?VaultId=@filter.VaultId&PageNumber=@(Model.PageNumber - 1)&SearchTerm=@filter.SearchTerm" hx-target="#movementsPane">Prev</a>
                </li>
            }
            @if (Model.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link" hx-get="/Vaults/GetMovementsTab?VaultId=@filter.VaultId&PageNumber=@(Model.PageNumber + 1)&SearchTerm=@filter.SearchTerm" hx-target="#movementsPane">Next</a>
                </li>
            }
        </ul>
    </div>
</div>
