@using ShipRate.WebApp.ViewModels.ShippingRouteVms
@model LoopListViewModel

<div class="table-responsive">
    <table class="table table-sm table-hover table-bordered mb-0">
        <thead class="table-light">
            <tr>
                <th style="width:50px">#</th>
                <th>Loop Name</th>
                <th>Loop Code</th>
                <th>Company</th>
                <th style="width:90px" class="text-center">Status</th>
                <th style="width:200px" class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Loops.Any())
            {
                var idx = (Model.Page - 1) * Model.PageSize;
                @foreach (var l in Model.Loops)
                {
                    idx++;
                    <tr id="loop-row-@l.LoopId">
                        <td>@idx</td>
                        <td>@l.LoopName</td>
                        <td>@(l.LoopCode ?? "-")</td>
                        <td>@(l.CompanyName ?? "-")</td>
                        <td class="text-center">
                            @if (l.IsActive)
                            {
                                <span class="badge badge-active">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-inactive">Inactive</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm">

                                <button class="btn btn-outline-primary btn-sm"
                                        data-id="@l.LoopId"
                                        data-name="@l.LoopName"
                                        onclick="selectLoop(this.dataset.id, this.dataset.name)">
                                    <i class="bi bi-check2-circle"></i> Select
                                </button>

                                <button class="btn btn-outline-warning"
                                        hx-get="/ShippingRoute/LoopEdit?id=@l.LoopId"
                                        hx-target="#modalBody">
                                    <i class="bi bi-pencil"></i>
                                </button>

                                <button class="btn btn-outline-danger"
                                        hx-delete="/ShippingRoute/LoopDelete?id=@l.LoopId"
                                        hx-confirm="Are you sure you want to delete this loop?"
                                        hx-swap="none">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">
                        <i class="bi bi-inbox" style="font-size:1.5rem"></i><br />
                        No loops found for this service.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* ==================== PAGINATION ==================== *@
@if (Model.TotalPages > 1)
{
    <nav class="mt-3 d-flex justify-content-between align-items-center">
        <small class="text-muted">
            Page @Model.Page of @Model.TotalPages
            &nbsp;|&nbsp; Total: @Model.TotalCount records
        </small>

        <ul class="pagination pagination-sm mb-0">
            @* Previous *@
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link"
                   href="#"
                   hx-get="/ShippingRoute/LoopGrid?serviceId=@Model.ShippingLineServiceId&page=@(Model.Page - 1)"
                   hx-target="#loopGrid">
                    &laquo;
                </a>
            </li>

            @* Page Numbers *@
            @{
                int startPage = Math.Max(1, Model.Page - 2);
                int endPage = Math.Min(Model.TotalPages, Model.Page + 2);
            }

            @if (startPage > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                       href="#"
                       hx-get="/ShippingRoute/LoopGrid?serviceId=@Model.ShippingLineServiceId&page=1"
                       hx-target="#loopGrid">1</a>
                </li>
                @if (startPage > 2)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
            }

            @for (int p = startPage; p <= endPage; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link"
                       href="#"
                       hx-get="/ShippingRoute/LoopGrid?serviceId=@Model.ShippingLineServiceId&page=@p"
                       hx-target="#loopGrid">@p</a>
                </li>
            }

            @if (endPage < Model.TotalPages)
            {
                @if (endPage < Model.TotalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
                <li class="page-item">
                    <a class="page-link"
                       href="#"
                       hx-get="/ShippingRoute/LoopGrid?serviceId=@Model.ShippingLineServiceId&page=@Model.TotalPages"
                       hx-target="#loopGrid">@Model.TotalPages</a>
                </li>
            }

            @* Next *@
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   href="#"
                   hx-get="/ShippingRoute/LoopGrid?serviceId=@Model.ShippingLineServiceId&page=@(Model.Page + 1)"
                   hx-target="#loopGrid">
                    &raquo;
                </a>
            </li>
        </ul>
    </nav>
}
