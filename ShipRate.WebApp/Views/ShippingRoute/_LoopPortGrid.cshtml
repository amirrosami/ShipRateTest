@using ShipRate.WebApp.ViewModels.ShippingRouteVms
@model LoopPortListViewModel

<div class="table-responsive">
    <table class="table table-sm table-bordered mb-0">
        <thead class="table-light">
            <tr>
                <th style="width:50px">#</th>
                <th style="width:100px">Seq No</th>
                <th>Port (Location)</th>
                <th style="width:180px" class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Ports.Any())
            {
                var idx = 0;
                @foreach (var p in Model.Ports)
                {
                    idx++;
                    @if (Model.EditingPortId == p.LoopPortId)
                    {
                        @* === INLINE EDIT ROW === *@
                        <tr class="table-warning">
                            <td>@idx</td>
                            <td colspan="2">
                                <form id="editPortForm"
                                      hx-post="/ShippingRoute/LoopPortEdit"
                                      hx-target="#loopPortGrid"
                                      hx-swap="none">

                                    <input type="hidden" name="LoopPortId" value="@p.LoopPortId" />
                                    <input type="hidden" name="LoopId" value="@p.LoopId" />

                                    <div class="row g-2">
                                        <div class="col-4">
                                            <input type="number"
                                                   class="form-control form-control-sm"
                                                   name="SequenceNo"
                                                   value="@p.SequenceNo"
                                                   min="1"
                                                   max="9999"
                                                   required />
                                        </div>
                                        <div class="col-8">
                                            <select class="form-select form-select-sm"
                                                    name="LocationId"
                                                    required>
                                                <option value="">-- Select Port --</option>
                                                @foreach (var loc in Model.AvailableLocations)
                                                {
                                                    <!option value="@loc.LocationId"
                                                            @(p.LocationId == loc.LocationId ? "selected" : "")>
                                                        @loc.Display
                                                    </!option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </form>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <button type="submit"
                                            form="editPortForm"
                                            class="btn btn-success btn-sm">
                                        <i class="bi bi-check-lg"></i> Save
                                    </button>
                                    <button class="btn btn-secondary btn-sm"
                                            hx-get="/ShippingRoute/LoopPortGrid?loopId=@Model.LoopId"
                                            hx-target="#loopPortGrid">
                                        <i class="bi bi-x-lg"></i> Cancel
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @* === NORMAL DISPLAY ROW === *@
                        <tr>
                            <td>@idx</td>
                            <td>
                                <span class="badge bg-secondary">@p.SequenceNo</span>
                            </td>
                            <td>
                                @p.LocationName
                                @if (!string.IsNullOrEmpty(p.LocationCode))
                                {
                                    <small class="text-muted">(@p.LocationCode)</small>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-warning"
                                            hx-get="/ShippingRoute/LoopPortGrid?loopId=@Model.LoopId&editingPortId=@p.LoopPortId"
                                            hx-target="#loopPortGrid">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <button class="btn btn-outline-danger"
                                            hx-delete="/ShippingRoute/LoopPortDelete?id=@p.LoopPortId"
                                            hx-confirm="Are you sure you want to remove this port?"
                                            hx-swap="none">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">
                        <i class="bi bi-geo-alt" style="font-size:1.5rem"></i><br/>
                        No ports defined for this loop.
                    </td>
                </tr>
            }

            @* ==================== ADD NEW ROW ==================== *@
            <tr class="table-success" id="addPortRow">
                <td class="text-center">
                    <i class="bi bi-plus-circle text-success"></i>
                </td>
                <td colspan="2">
                    <form id="addPortForm"
                          hx-post="/ShippingRoute/LoopPortCreate"
                          hx-target="#loopPortGrid"
                          hx-swap="none">

                        <input type="hidden" name="LoopId" value="@Model.LoopId" />

                        <div class="row g-2">
                            <div class="col-4">
                                <input type="number"
                                       class="form-control form-control-sm"
                                       name="SequenceNo"
                                       placeholder="Seq #"
                                       min="1"
                                       max="9999"
                                       value="@(Model.Ports.Any() ? Model.Ports.Max(x => x.SequenceNo) + 1 : 1)"
                                       required />
                            </div>
                            <div class="col-8">
                                <select class="form-select form-select-sm"
                                        name="LocationId"
                                        required>
                                    <option value="">-- Select Port --</option>
                                    @foreach (var loc in Model.AvailableLocations)
                                    {
                                        <option value="@loc.LocationId">@loc.Display</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </form>
                </td>
                <td class="text-center">
                    <button type="submit"
                            form="addPortForm"
                            class="btn btn-success btn-sm">
                        <i class="bi bi-plus-lg"></i> Add
                    </button>
                </td>
            </tr>
        </tbody>
    </table>
</div>
