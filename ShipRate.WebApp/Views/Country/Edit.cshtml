@model ShipRate.Application.DTOs.CountryDto

@{
    ViewData["Title"] = "ویرایش کشور";
}

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-edit"></i> ویرایش کشور: @Model.Name</h5>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedDate" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label asp-for="Name" class="form-label">نام کشور <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="Code" class="form-label">کد کشور <span class="text-danger">*</span></label>
                            <input asp-for="Code" class="form-control" maxlength="10" />
                            <span asp-validation-for="Code" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Capital" class="form-label">پایتخت</label>
                        <input asp-for="Capital" class="form-control" />
                        <span asp-validation-for="Capital" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Population" class="form-label">جمعیت</label>
                            <input asp-for="Population" class="form-control" type="number" />
                            <span asp-validation-for="Population" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Area" class="form-label">مساحت (کیلومتر مربع)</label>
                            <input asp-for="Area" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="Area" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label">وضعیت فعال</label>
                        </div>
                    </div>

                    <div class="alert alert-info">
                        <small>
                            <i class="fas fa-info-circle"></i>
                            تاریخ ایجاد: @Model.CreatedDate.ToString("yyyy/MM/dd HH:mm")
                            @if (Model.ModifiedDate.HasValue)
                            {
                                <span> | آخرین ویرایش: @Model.ModifiedDate.Value.ToString("yyyy/MM/dd HH:mm")</span>
                            }
                        </small>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save"></i> ذخیره تغییرات
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-times"></i> انصراف
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
