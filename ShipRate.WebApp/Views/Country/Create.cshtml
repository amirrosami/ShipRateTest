@model ShipRate.Application.DTOs.CountryDto

@{
    ViewData["Title"] = "افزودن کشور جدید";
}

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-plus"></i> افزودن کشور جدید</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label asp-for="Name" class="form-label">نام کشور <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="مثال: ایران" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="Code" class="form-label">کد کشور <span class="text-danger">*</span></label>
                            <input asp-for="Code" class="form-control" placeholder="مثال: IR" maxlength="10" />
                            <span asp-validation-for="Code" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Capital" class="form-label">پایتخت</label>
                        <input asp-for="Capital" class="form-control" placeholder="مثال: تهران" />
                        <span asp-validation-for="Capital" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Population" class="form-label">جمعیت</label>
                            <input asp-for="Population" class="form-control" type="number" placeholder="مثال: 85000000" />
                            <span asp-validation-for="Population" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Area" class="form-label">مساحت (کیلومتر مربع)</label>
                            <input asp-for="Area" class="form-control" type="number" step="0.01" placeholder="مثال: 1648195" />
                            <span asp-validation-for="Area" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                            <label asp-for="IsActive" class="form-check-label">وضعیت فعال</label>
                        </div>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save"></i> ذخیره
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-times"></i> انصراف
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
