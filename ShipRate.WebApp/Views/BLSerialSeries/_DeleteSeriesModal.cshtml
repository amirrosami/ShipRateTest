@{
    var id = (Guid)ViewBag.Id;
}

<div class="modal fade show" style="display:block;" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="ConfirmDeleteSeries"
                  method="post"
                  hx-post="@Url.Action("ConfirmDeleteSeries")"
                  hx-target="body"
                  hx-swap="none">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@id" />
                <div class="modal-header">
                    <h5 class="modal-title">Delete Series</h5>
                    <button type="button" class="btn-close" onclick="this.closest('.modal').remove();"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete this series?
                </div>
                <div class="modal-footer">
                    <button type="submit"
                            class="btn btn-danger"
                            hx-on::after-request="htmx.ajax('POST', '@Url.Action("SeriesGrid")', '#seriesGridContainer', { target:'#seriesGridContainer', swap:'innerHTML', values: htmx.values(document.querySelector('#searchForm'))}); this.closest('.modal').remove();">
                        Delete
                    </button>
                    <button type="button" class="btn btn-secondary" onclick="this.closest('.modal').remove();">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>
