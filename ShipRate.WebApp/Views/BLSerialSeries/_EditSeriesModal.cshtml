@using ShipRate.Application.DTOs
@model BLSerialSeriesEditDto
@{
    var carrierTypes = (IEnumerable<SelectListItem>)ViewBag.CarrierBLTypes;
}

<div class="modal fade show" style="display:block;" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="EditSeries"
                  asp-controller="BLSerialSeries"
                  method="post"
                  hx-post="@Url.Action("EditSeries")"
                  hx-target="body"
                  hx-swap="none">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">@((Model.Id.HasValue ? "Edit Series" : "New Series"))</h5>
                    <button type="button" class="btn-close" onclick="this.closest('.modal').remove();"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="Id" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CarrierBLTypeId" class="form-label"></label>
                            <select asp-for="CarrierBLTypeId" class="form-select" asp-items="carrierTypes"></select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SeriesCode" class="form-label"></label>
                            <input asp-for="SeriesCode" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SeriesName" class="form-label"></label>
                            <input asp-for="SeriesName" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Prefix" class="form-label"></label>
                            <input asp-for="Prefix" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="IssueDate" class="form-label"></label>
                            <input asp-for="IssueDate" class="form-control" type="date" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="FromNumber" class="form-label"></label>
                            <input asp-for="FromNumber" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="ToNumber" class="form-label"></label>
                            <input asp-for="ToNumber" class="form-control" />
                        </div>
                        <div class="col-md-3 form-check mt-3">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>
                        <div class="col-12">
                            <label asp-for="Remarks" class="form-label"></label>
                            <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit"
                            class="btn btn-primary"
                            hx-on::after-request="htmx.ajax('POST', '@Url.Action("SeriesGrid")', '#seriesGridContainer', { target:'#seriesGridContainer', swap:'innerHTML', values: htmx.values(document.querySelector('#searchForm'))}); this.closest('.modal').remove();">
                        Save
                    </button>
                    <button type="button" class="btn btn-secondary" onclick="this.closest('.modal').remove();">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>
