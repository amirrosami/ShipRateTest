@using ShipRate.Application.DTOs
@model List<BLSerialBatchAssignListItemDto>
@{
    var seriesId = (Guid)ViewBag.SeriesId;
}

<div class="d-flex justify-content-between mb-2">
    <h5 class="mb-0">Batch Assignments</h5>
    <button class="btn btn-sm btn-success"
            hx-get="@Url.Action("EditBatchAssign", new { seriesId = seriesId })"
            hx-target="#modalContainer"
            hx-swap="innerHTML">
        <i class="bi bi-plus-circle"></i> New Batch
    </button>
</div>

<table class="table table-sm table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>From</th>
            <th>To</th>
            <th>Assign Date</th>
            <th>Agent</th>
            <th>Active</th>
            <th>Remarks</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.FromNumber</td>
                    <td>@item.ToNumber</td>
                    <td>@item.AssignDate.ToString("yyyy-MM-dd")</td>
                    <td>@item.AgentName</td>
                    <td>@(item.IsActive ? "Yes" : "No")</td>
                    <td>@item.Remarks</td>
                    <td style="white-space:nowrap;">
                        <button class="btn btn-sm btn-outline-primary"
                                hx-get="@Url.Action("EditBatchAssign", new { id = item.Id, seriesId = item.BLSerialSeriesId })"
                                hx-target="#modalContainer"
                                hx-swap="innerHTML"
                                title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger"
                                hx-get="@Url.Action("DeleteBatchAssign", new { id = item.Id, seriesId = item.BLSerialSeriesId })"
                                hx-target="#modalContainer"
                                hx-swap="innerHTML"
                                title="Delete">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center">No batch assignments</td>
            </tr>
        }
    </tbody>
</table>
