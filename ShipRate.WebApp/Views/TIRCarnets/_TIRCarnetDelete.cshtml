@using ShipRate.Application.ViewModels
@model TIRCarnetDeleteVm

<div class="modal-header">
    <h5 class="modal-title">Delete TIR Carnet</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form hx-post="@Url.Action("DeleteConfirmed", "TIRCarnets", new { id = Model.Id })"
      hx-target="#mainModalContent"
      hx-swap="innerHTML">
    @Html.AntiForgeryToken()

    <div class="modal-body">
        <div class="alert alert-warning mb-3">
            Are you sure you want to delete this TIR Carnet?
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-4">TIR Carnet Number</dt>
            <dd class="col-sm-8">@Model.TIRCarnetNumber</dd>
        </dl>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            Cancel
        </button>
        <button type="submit" class="btn btn-danger">
            Confirm Delete
        </button>
    </div>
</form>
