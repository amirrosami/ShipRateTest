@using ShipRate.Application.ViewModels
@model TIRAssignmentCreateEditVm

@{
    var isEdit = Model.Id.HasValue;
    var actionName = isEdit ? "EditAssignment" : "CreateAssignment";
    var modalTitle = isEdit ? "Edit Assignment" : "Create Assignment";
}

<div class="modal-header">
    <h5 class="modal-title">@modalTitle</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form hx-post="@Url.Action(actionName, "TIRCarnets")"
      hx-target="#mainModalContent"
      hx-swap="innerHTML">
    @Html.AntiForgeryToken()

    <div class="modal-body">
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger"></div>
        }

        @if (isEdit)
        {
            <input type="hidden" asp-for="Id" />
        }

        <input type="hidden" asp-for="TIRCarnetId" />

        <div class="mb-3">
            <label class="form-label">TIR Carnet</label>
            <input type="text" class="form-control" value="@Model.TIRCarnetNumber" readonly />
        </div>

        <div class="row g-3">

            <div class="col-md-6">
                <label asp-for="TruckId" class="form-label"></label>
                <select asp-for="TruckId" asp-items="Model.Trucks" class="form-select">
                    <option value="">Select...</option>
                </select>
                <span asp-validation-for="TruckId" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="TIRAssignmentAssignDate" class="form-label"></label>
                <input asp-for="TIRAssignmentAssignDate" type="date" class="form-control" />
                <span asp-validation-for="TIRAssignmentAssignDate" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="TIRAssignmentReleaseDate" class="form-label"></label>
                <input asp-for="TIRAssignmentReleaseDate" type="date" class="form-control" />
                <span asp-validation-for="TIRAssignmentReleaseDate" class="text-danger"></span>
            </div>

            <div class="col-md-12">
                <label asp-for="Remarks" class="form-label"></label>
                <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Remarks" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <div class="form-check mt-4">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>

        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            Cancel
        </button>
        <button type="submit" class="btn btn-primary">
            Save
        </button>
    </div>
</form>
