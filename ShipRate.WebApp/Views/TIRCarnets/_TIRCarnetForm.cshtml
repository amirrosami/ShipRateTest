@using ShipRate.Application.ViewModels
@model TIRCarnetCreateEditVm

@{
    var isEdit = Model.Id.HasValue;
    var actionName = isEdit ? "Edit" : "Create";
    var modalTitle = isEdit ? "Edit TIR Carnet" : "Create TIR Carnet";
}

<div class="modal-header">
    <h5 class="modal-title">@modalTitle</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form hx-post="@Url.Action(actionName, "TIRCarnets")"
      hx-target="#mainModalContent"
      hx-swap="innerHTML">
    @Html.AntiForgeryToken()

    <div class="modal-body">
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger"></div>
        }

        @if (isEdit)
        {
            <input type="hidden" asp-for="Id" />
        }

        <div class="row g-3">

            <div class="col-md-6">
                <label asp-for="TIRCarnetNumber" class="form-label"></label>
                <input asp-for="TIRCarnetNumber" class="form-control" autocomplete="off" />
                <span asp-validation-for="TIRCarnetNumber" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="IssueDate" class="form-label"></label>
                <input asp-for="IssueDate" type="date" class="form-control" />
                <span asp-validation-for="IssueDate" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="ExpiryDate" class="form-label"></label>
                <input asp-for="ExpiryDate" type="date" class="form-control" />
                <span asp-validation-for="ExpiryDate" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="IssuingCountryId" class="form-label"></label>
                <select asp-for="IssuingCountryId" asp-items="Model.Countries" class="form-select">
                    <option value="">Select...</option>
                </select>
                <span asp-validation-for="IssuingCountryId" class="text-danger"></span>
            </div>


            <div class="col-md-6">
                <label asp-for="VoletsCount" class="form-label"></label>
                <input asp-for="VoletsCount" class="form-control" autocomplete="off" />
                <span asp-validation-for="VoletsCount" class="text-danger"></span>
            </div>





            <div class="col-md-4">
                <label asp-for="IssuingAssociationId" class="form-label"></label>
                <select asp-for="IssuingAssociationId" asp-items="Model.Associations" class="form-select">
                    <option value="">Select...</option>
                </select>
                <span asp-validation-for="IssuingAssociationId" class="text-danger"></span>
            </div>






            <div class="col-md-4">
                <label asp-for="StatusId" class="form-label"></label>
                <select asp-for="StatusId" asp-items="Model.Statuses" class="form-select">
                    <option value="">Select...</option>
                </select>
                <span asp-validation-for="StatusId" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="CurrencyId" class="form-label"></label>
                <select asp-for="CurrencyId" asp-items="Model.Currencies" class="form-select">
                    <option value="">Select...</option>
                </select>
                <span asp-validation-for="CurrencyId" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="GuaranteeAmount" class="form-label"></label>
                <input asp-for="GuaranteeAmount" class="form-control" />
                <span asp-validation-for="GuaranteeAmount" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="ClosedDate" class="form-label"></label>
                <input asp-for="ClosedDate" type="date" class="form-control" />
                <span asp-validation-for="ClosedDate" class="text-danger"></span>
            </div>

            <div class="col-md-12">
                <label asp-for="Remarks" class="form-label"></label>
                <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Remarks" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <div class="form-check mt-4">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>

        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            Cancel
        </button>
        <button type="submit" class="btn btn-primary">
            Save
        </button>
    </div>
</form>
