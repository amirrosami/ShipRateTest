@using ShipRate.Application.ViewModels
@model AssignmentsPanelVm

<div class="card border-secondary">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <div>
            <strong>Items</strong>
            <span class="text-muted ms-2">Carnet: @Model.TIRCarnetNumber</span>
        </div>

        <div class="d-flex gap-2">
            <button type="button"
                    class="btn btn-sm btn-primary"
                    hx-get="@Url.Action("CreateAssignment", "TIRCarnets", new { tirCarnetId = Model.TIRCarnetId })"
                    hx-target="#mainModalContent"
                    hx-swap="innerHTML">
                New Assignment
            </button>

            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    onclick="document.getElementById('ItemsPanelContainer').innerHTML='';">
                Close
            </button>
        </div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Truck</th>
                        <th>Assigned Date</th>
                        <th>Release Date</th>
                        <th>Active</th>
                        <th>Remarks</th>
                        <th style="width: 260px;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Items == null || !Model.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                No Items found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        var rowNo = 1;
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@rowNo</td>
                                <td>@item.TruckDisplay</td>
                                <td>@item.TIRAssignmentAssignDate.ToString("yyyy-MM-dd")</td>
                                <td>@(item.TIRAssignmentReleaseDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </td>
                                <td>@item.Remarks</td>
                                <td class="text-nowrap">
                                    <div class="btn-group btn-group-sm" role="group" aria-label="TIR Assignment Actions">

                                        <button type="button"
                                                class="btn btn-outline-primary"
                                                title="Edit Assignment"
                                                aria-label="Edit Assignment"
                                                hx-get="@Url.Action("EditAssignment", "TIRCarnets", new { id = item.Id })"
                                                hx-target="#mainModalContent"
                                                hx-swap="innerHTML">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>

                                        <button type="button"
                                                class="btn btn-outline-danger"
                                                title="Delete Assignment"
                                                aria-label="Delete Assignment"
                                                hx-get="@Url.Action("DeleteAssignment", "TIRCarnets", new { id = item.Id })"
                                                hx-target="#mainModalContent"
                                                hx-swap="innerHTML">
                                            <i class="bi bi-trash"></i>
                                        </button>

                                        <button type="button"
                                                class="btn btn-outline-dark"
                                                title="Usages"
                                                aria-label="Usages"
                                                hx-get="@Url.Action("Usages", "TIRCarnets", new { tirAssignmentId = item.Id })"
                                                hx-target="#usagesPanelContainer"
                                                hx-swap="innerHTML">
                                            <i class="bi bi-list-ul"></i>
                                        </button>

                                    </div>
                                </td>
                            </tr>

                            rowNo++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div id="usagesPanelContainer" class="border-top"></div>
</div>
