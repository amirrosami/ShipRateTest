@{
    var id = (Guid)ViewBag.Id;
    var jobId = ViewBag.JobId;
    var bookingId = ViewBag.BookingId;
    var shipmentId = ViewBag.ShipmentId;
    var shipmentLegId = ViewBag.ShipmentLegId;
}

<div class="p-2">
    <div class="alert alert-warning">
        Are you sure you want to delete this BL?
    </div>

    <form hx-post="@Url.Action("Delete", "BL")"
          hx-target="#blList"
          hx-swap="innerHTML">
        @Html.AntiForgeryToken()

        <input type="hidden" name="id" value="@id" />
        <input type="hidden" name="jobId" value="@jobId" />
        <input type="hidden" name="bookingId" value="@bookingId" />
        <input type="hidden" name="shipmentId" value="@shipmentId" />
        <input type="hidden" name="shipmentLegId" value="@shipmentLegId" />

        <div class="d-flex justify-content-end">
            <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-danger">Delete</button>
        </div>
    </form>
</div>
