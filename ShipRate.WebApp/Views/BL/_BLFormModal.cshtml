@using ShipRate.Application.DTOs.BillOfLadings
@model BLUpsertDto

@{
    var lookups = ViewBag.Lookups as BLLookupDto;
    var isEdit = Model.Id.HasValue && Model.Id.Value != Guid.Empty;

    var listTargetId = string.IsNullOrWhiteSpace(Model.ListTargetId)
        ? "blList"
        : Model.ListTargetId;
}

<form hx-post="@Url.Action("Save", "BL")"
      hx-target="#@listTargetId"
      hx-swap="innerHTML">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="JobId" />
    <input type="hidden" asp-for="BookingId" />
    <input type="hidden" asp-for="ShipmentId" />
    <input type="hidden" asp-for="ShipmentLegId" />
    <input type="hidden" asp-for="ListTargetId" />
    <input type="hidden" asp-for="ModalId" />

    <div class="modal-header">
        <h5 class="modal-title">
            @(isEdit ? "Edit BL" : "New BL")
        </h5>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="Close">
        </button>
    </div>

    <div class="modal-body">

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active"
                        type="button"
                        data-bs-toggle="tab"
                        data-bs-target="#bl-main-tab"
                        role="tab">
                    Main
                </button>
            </li>

            <li class="nav-item" role="presentation">
                <button class="nav-link"
                        type="button"
                        data-bs-toggle="tab"
                        data-bs-target="#bl-route-tab"
                        role="tab">
                    Route
                </button>
            </li>

            <li class="nav-item" role="presentation">
                <button class="nav-link"
                        type="button"
                        data-bs-toggle="tab"
                        data-bs-target="#bl-parties-tab"
                        role="tab">
                    Parties
                </button>
            </li>

            <li class="nav-item" role="presentation">
                <button class="nav-link"
                        type="button"
                        data-bs-toggle="tab"
                        data-bs-target="#bl-cargo-tab"
                        role="tab">
                    Cargo
                </button>
            </li>

            <li class="nav-item" role="presentation">
                <button class="nav-link"
                        type="button"
                        data-bs-toggle="tab"
                        data-bs-target="#bl-transport-tab"
                        role="tab">
                    Transport
                </button>
            </li>
        </ul>

        <div class="tab-content pt-3">

            <div class="tab-pane fade show active"
                 id="bl-main-tab"
                 role="tabpanel">
                @await Html.PartialAsync("FormPartials/_BLMainFields", Model)
            </div>

            <div class="tab-pane fade"
                 id="bl-route-tab"
                 role="tabpanel">
                @await Html.PartialAsync("FormPartials/_BLRouteFields", Model)
            </div>

            <div class="tab-pane fade"
                 id="bl-parties-tab"
                 role="tabpanel">
                @await Html.PartialAsync("FormPartials/_BLPartyFields", Model)
            </div>

            <div class="tab-pane fade"
                 id="bl-cargo-tab"
                 role="tabpanel">
                @await Html.PartialAsync("FormPartials/_BLCargoFields", Model)

                @if (Model.IsContainerized)
                {
                    @await Html.PartialAsync("FormPartials/_BLContainerFields", Model)
                }
            </div>

            <div class="tab-pane fade"
                 id="bl-transport-tab"
                 role="tabpanel">
                @await Html.PartialAsync("FormPartials/_BLTransportFields", Model)
            </div>

        </div>
    </div>

    <div class="modal-footer">
        <button type="button"
                class="btn btn-light"
                data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit" class="btn btn-primary">
            Save
        </button>
    </div>
</form>
