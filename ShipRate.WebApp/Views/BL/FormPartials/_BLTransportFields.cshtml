@using Microsoft.AspNetCore.Mvc.Rendering
@using ShipRate.Application.DTOs.BillOfLadings
@model BLUpsertDto

@{
    var lookups = ViewBag.Lookups as BLLookupDto;
}

<h6>Sea Voyages</h6>

<div class="table-responsive mb-3">
    <table class="table table-sm table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>Voyage Type</th>
                <th>Voyage</th>
                <th>POL</th>
                <th>POD</th>
                <th>ETD</th>
                <th>ETA</th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < Model.Voyages.Count; i++)
            {
                <tr>
                    <td>
                        <input type="hidden" asp-for="Voyages[i].Id" />

                        <select asp-for="Voyages[i].VoyageTypeId"
                                class="form-select form-select-sm"
                                asp-items="@(new SelectList(lookups?.VoyageTypes ?? Enumerable.Empty<object>(), "Id", "Name", Model.Voyages[i].VoyageTypeId))">
                            <option value="">Select Type</option>
                        </select>
                    </td>

                    <td>
                        <select asp-for="Voyages[i].VoyageId"
                                class="form-select form-select-sm"
                                asp-items="@(new SelectList(lookups?.Voyages ?? Enumerable.Empty<object>(), "Id", "Name", Model.Voyages[i].VoyageId))">
                            <option value="">Select Voyage</option>
                        </select>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

