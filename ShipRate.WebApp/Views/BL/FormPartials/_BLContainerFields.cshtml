@using Microsoft.AspNetCore.Mvc.Rendering
@using ShipRate.Application.DTOs.BillOfLadings
@model BLUpsertDto

@{
    var lookups = ViewBag.Lookups as BLLookupDto;
}

@if (Model.IsContainerized)
{
    <h6 class="mb-2">Containers</h6>

    <div class="table-responsive">
        <table class="table table-sm table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Container No</th>
                    <th>Use</th>
                    <th>Size/Type</th>
                    <th>Seal No</th>
                    <th>Gross Weight</th>
                    <th>CBM</th>
                </tr>
            </thead>

            <tbody>
                @for (var i = 0; i < Model.Containers.Count; i++)
                {
                    <tr>
                        <td>
                            <input type="hidden" asp-for="Containers[i].Id" />

                            <input asp-for="Containers[i].ContainerNumber"
                                   class="form-control form-control-sm" />
                        </td>

                        <td>
                            <select asp-for="Containers[i].ContainerUseId"
                                    class="form-select form-select-sm"
                                    asp-items="@(new SelectList(lookups?.ContainerUses ?? Enumerable.Empty<object>(), "Id", "Name", Model.Containers[i].ContainerUseId))">
                                <option value="">Select Use</option>
                            </select>
                        </td>

                        <td>
                            <select asp-for="Containers[i].ContainerSizeTypeId"
                                    class="form-select form-select-sm"
                                    asp-items="@(new SelectList(lookups?.ContainerSizeTypes ?? Enumerable.Empty<object>(), "Id", "Name", Model.Containers[i].ContainerSizeTypeId))">
                                <option value="">Select Size/Type</option>
                            </select>
                        </td>

                        <td>
                            <input asp-for="Containers[i].SealNumber"
                                   class="form-control form-control-sm" />
                        </td>

                        <td>
                            <input asp-for="Containers[i].TotalGrossWeight"
                                   class="form-control form-control-sm" />
                        </td>

                        <td>
                            <input asp-for="Containers[i].TotalVolumeCBM"
                                   class="form-control form-control-sm" />
                        </td>
                    </tr>

                    <tr>
                        <td colspan="6">
                            <div class="ps-3 border-start">
                                <strong>Container Cargo</strong>

                                <table class="table table-sm mt-2">
                                    <thead>
                                        <tr>
                                            <th>Commodity</th>
                                            <th>Package Type</th>
                                            <th>Packages</th>
                                            <th>Gross Weight</th>
                                            <th>CBM</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @for (var j = 0; j < Model.Containers[i].CargoDetails.Count; j++)
                                        {
                                            <tr>
@*                                                 <td>
                                                    <input type="hidden" asp-for="Containers[i].CargoDetails[j].Id" />

                                                    <select asp-for="Containers[i].CargoDetails[j].CommodityId"
                                                            class="form-select form-select-sm"
                                                            asp-items="@(new SelectList(lookups?.Commodities ?? Enumerable.Empty<object>(), "Id", "Name", Model.Containers[i].CargoDetails[j].CommodityId))">
                                                        <option value="">Select Commodity</option>
                                                    </select>
                                                </td>
 *@
                                                <td>
                                                    <select asp-for="Containers[i].CargoDetails[j].PackageTypeId"
                                                            class="form-select form-select-sm"
                                                            asp-items="@(new SelectList(lookups?.PackageTypes ?? Enumerable.Empty<object>(), "Id", "Name", Model.Containers[i].CargoDetails[j].PackageTypeId))">
                                                        <option value="">Select Package</option>
                                                    </select>
                                                </td>

                                                <td>
                                                    <input asp-for="Containers[i].CargoDetails[j].PackageCount"
                                                           class="form-control form-control-sm" />
                                                </td>

                                                <td>
                                                    <input asp-for="Containers[i].CargoDetails[j].GrossWeight"
                                                           class="form-control form-control-sm" />
                                                </td>

                                                <td>
                                                    <input asp-for="Containers[i].CargoDetails[j].Volume"
                                                           class="form-control form-control-sm" />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
