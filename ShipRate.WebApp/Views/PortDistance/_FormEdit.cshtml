@using ShipRate.Application.DTOs.Base_Info
@using static ShipRate.Application.DTOs.PortDistanceDto
@model PortDistanceUpdateDto



<form hx-post="@Url.Action("Edit", "PortDistance")"
      hx-target="#modal-content"
      hx-swap="innerHTML">

    <div class="modal-header bg-primary">
        <h5 class="modal-title text-white"><i class="bi bi-pencil-square me-2"></i>Edit Distance</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />

        @if (!ViewData.ModelState.IsValid)
        {
            var allErrors = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).ToList();
            if (allErrors.Any())
            {
                <div class="alert alert-danger py-2 mb-3">
                    <ul class="mb-0 small">
                        @foreach (var err in allErrors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }
        }

        <!-- Transport Type -->
        <div class="mb-3">
            <label class="form-label fw-medium">
                Transport Type <span class="text-danger">*</span>
            </label>
            <div class="d-flex align-items-center gap-2">
                <select asp-for="TransPortTypeId"
                        asp-items="@ViewBag.TransportTypes"
                        class="form-select">
                    <option value="">-- Select --</option>
                </select>
                <span asp-validation-for="TransPortTypeId" class="text-danger"></span>
            </div>
        </div>

        <!-- From Location -->
        <div class="lookup-container ">
            <label class="form-label fw-medium">From Location</label>
            <input type="text"
                   class="form-control form-control-sm"
                   placeholder="Search Location..."
                   hx-get="/portdistance/searchfromlocation"
                   hx-trigger="keyup changed delay:300ms"
                   hx-target="#fromport-results"
                   name="q"
                   value="@Model.FromPortName"
                   autocomplete="off">

            <input type="hidden" name="FromPortId" id="fromport-id" value="@Model.FromPortId">

            <div id="fromport-results" class="lookup-results"></div>
        </div>

        <!-- To Location -->
        <div class="lookup-container ">
            <label class="form-label fw-medium">To Location</label>
            <input type="text"
                   class="form-control form-control-sm"
                   placeholder="Search Location..."
                   hx-get="/portdistance/searchtolocation"
                   hx-trigger="keyup changed delay:300ms"
                   hx-target="#toport-results"
                   value="@Model.ToPortName"
                   name="q"
                   autocomplete="off">

            <input type="hidden" name="ToPortId" id="toport-id" value="@Model.ToPortId">

            <div id="toport-results" class="lookup-results"></div>
        </div>




        <!-- DistanceKM -->
        <div class="mb-3">
            <label class="form-label fw-medium">Distance-KM</label>
            <input type="text"
                   name="DistanceKM"
                   value="@Model.DistanceKM"
                   class="form-control @(ViewData.ModelState.ContainsKey("DistanceKM") && ViewData.ModelState["DistanceKM"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                   required />
        </div>


        <!-- DistanceNM -->
        <div class="mb-3">
            <label class="form-label fw-medium">Distance-NM</label>
            <input type="text"
                   name="DistanceNM"
                   value="@Model.DistanceNM"
                   class="form-control @(ViewData.ModelState.ContainsKey("DistanceNM") && ViewData.ModelState["DistanceNM"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                   required />
        </div>


        <!-- Days -->
        <div class="mb-3">
            <label class="form-label fw-medium">Transit Days</label>
            <input type="text"
                   name="AvgDays"
                   value="@Model.AvgDays"
                   class="form-control @(ViewData.ModelState.ContainsKey("AvgDays") && ViewData.ModelState["AvgDays"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                   required />
        </div>

        <!-- Days -->
        <div class="mb-3">
            <label class="form-label fw-medium">Transit Hours</label>
            <input type="text"
                   name="AvgHours"
                   value="@Model.AvgHours"
                   class="form-control @(ViewData.ModelState.ContainsKey("AvgHours") && ViewData.ModelState["AvgHours"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                   required />
        </div>

        <!-- Days -->
        <div class="mb-3">
            <label class="form-label fw-medium">Source</label>
            <input type="text"
                   name="Source"
                   value="@Model.Source"
                   class="form-control @(ViewData.ModelState.ContainsKey("Source") && ViewData.ModelState["Source"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                   required />
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-warning">
            <i class="bi bi-check-lg me-1"></i> Update
        </button>
    </div>
</form>
