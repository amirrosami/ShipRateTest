@using ShipRate.WebApp.Controllers
@model TestCreateEditVM

<form hx-post="@Url.Action(Model.Id == null ? "Create" : "Edit", "Test")"
      hx-target="#app-modal-content"
      hx-swap="innerHTML">

    @Html.AntiForgeryToken()

    <div class="modal-header">

        <h5 class="modal-title">
            @(Model.Id == null ? "Create Test" : "Edit Test")
        </h5>

        <button type="button"
                class="btn-close"
                onclick="AppModal.close()">
        </button>

    </div>

    <div class="modal-body">

        <div class="mb-3">

            <label class="form-label">Name</label>

            <input asp-for="Name" class="form-control" />

            <span asp-validation-for="Name"></span>

        </div>

        <div class="mb-3">
            <label class="form-label">Name</label>
            <input type="number" name="Age" class="form-control" />
        </div>

        <select name="Type" class="form-select">

            <option value="5">5</option>
            <option value="10">10</option>
            <option value="20">20</option>

        </select>

        <div class="mb-3" data-show-if="Type = 10">

            <label class="form-label">Dscp</label>

            <input asp-for="Description" class="form-control" />

            <span asp-validation-for="Description"></span>

        </div>

    </div>

    <div class="modal-footer">

        <button type="button"
                class="btn btn-secondary"
                onclick="AppModal.close()">

            Cancel

        </button>

        <button class="btn btn-primary">

            Save

        </button>

    </div>

</form>
