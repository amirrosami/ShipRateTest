@model PagedResult<TestCreateEditVM>
@using ShipRate.WebApp.Controllers
@using ShipRate.WebApp.ViewModels
<button class="btn btn-primary"
        hx-get="@Url.Action("Create", "Test")"
        hx-target="#app-modal-content"
        hx-swap="innerHTML">

    Create

</button>


@await Html.PartialAsync(
"_GridFilters",
    new GridFilterViewModel
    {
        Page = Model.Page,
        PageSize = Model.PageSize,
        SearchTerm = Model.SearchTerm,
        SortColumn = Model.SortColumn,
        SortDirection = Model.SortDirection,
        ListUrl = Url.Action("List", "Test"),
        CustomFilterPartial = "_TestCustomFilters",
        CustomFilterValues = Model.CustomFilterValues,
    }
)

<div id="table-container"
     hx-post="@Url.Action("List", "Test")"
     hx-trigger="load, GridChanged from:body"
     hx-swap="innerHTML"
     hx-include="#grid-filters, #table-sort-info">
</div>





