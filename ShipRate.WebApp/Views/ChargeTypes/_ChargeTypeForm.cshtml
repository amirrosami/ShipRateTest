@using ShipRate.WebApp.ViewModels.ChargeTypeVms
@model ChargeTypeFormViewModel

<div class="modal fade show" style="display:block;" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <form hx-post="/ChargeTypes/Save" hx-target="#dialog">

                <div class="modal-header">
                    <h5 class="modal-title">@(Model.Id.HasValue ? "Edit" : "Add") Charge Type</h5>
                    <button type="button" class="btn-close" onclick="document.getElementById('dialog').innerHTML=''"></button>
                </div>

                <div class="modal-body">

                    <input type="hidden" asp-for="Id" />

                    <div class="row">

                        <div class="col-6">
                            <div class="mb-3">
                                <label asp-for="ChargeTypeCode" class="form-label">Code</label>
                                <input asp-for="ChargeTypeCode" class="form-control" />
                                <span asp-validation-for="ChargeTypeCode" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="mb-3">
                                <label asp-for="ChargeTypeName" class="form-label">Name</label>
                                <input asp-for="ChargeTypeName" class="form-control" />
                                <span asp-validation-for="ChargeTypeName" class="text-danger"></span>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-6">
                            <div class="mb-3">
                                <label asp-for="ChargeTypeLocalName" class="form-label">Local Name</label>
                                <input asp-for="ChargeTypeLocalName" class="form-control" />
                                <span asp-validation-for="ChargeTypeLocalName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="mb-3">
                                <label asp-for="ChargeTypeCategoryId" class="form-label">Category</label>
                                <select asp-for="ChargeTypeCategoryId" asp-items="Model.Categories" class="form-select">
                                    <option value="">Select...</option>
                                </select>
                                <span asp-validation-for="ChargeTypeCategoryId" class="text-danger"></span>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-6">
                            <div class="mb-3">
                                <label asp-for="CurrencyId" class="form-label">Currency</label>
                                <select asp-for="CurrencyId" asp-items="Model.Currencies" class="form-select">
                                    <option value="">Select...</option>
                                </select>
                                <span asp-validation-for="CurrencyId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="mb-3">
                                <label asp-for="CalculationById" class="form-label">Calculation By</label>
                                <select asp-for="CalculationById" asp-items="Model.CalculationByList" class="form-select">
                                    <option value="">Select...</option>
                                </select>
                                <span asp-validation-for="CalculationById" class="text-danger"></span>
                            </div>
                        </div>

                    </div>
                    <div class="row">
                        <div class="col-6">
                            <div class="mb-3">
                                <label asp-for="DependsOnChargeTypeId" class="form-label">Depends On</label>
                                <select asp-for="DependsOnChargeTypeId" asp-items="Model.ChargeTypesList" class="form-select">
                                    <option value="">None</option>
                                </select>
                            </div>
                        </div>

                    </div>

                    <div class="row">
@*                         <div class="col-6">
                            <div class="mb-3">
                                <label asp-for="MultiplierRate" class="form-label">Multiplier Rate</label>
                                <input asp-for="MultiplierRate" type="number" step="0.01" class="form-control" />
                            </div>
                        </div>
 *@
                        <div class="col-12">
                            <div class="mb-3">
                                <label asp-for="Remarks" class="form-label">Remarks</label>
                                <input asp-for="Remarks" class="form-control" />
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-3">
                            <div class="form-check">
                                <input asp-for="IsTaxable" class="form-check-input" type="checkbox" />
                                <label asp-for="IsTaxable" class="form-check-label">Taxable</label>
                            </div>
                        </div>

                        <div class="col-3">
                            <div class="form-check">
                                <input asp-for="AllowManualAmount" class="form-check-input" type="checkbox" />
                                <label asp-for="AllowManualAmount" class="form-check-label">Manual Amount</label>
                            </div>
                        </div>

@*                         <div class="col-3">
                            <div class="form-check">
                                <input asp-for="AllowRateBased" class="form-check-input" type="checkbox" />
                                <label asp-for="AllowRateBased" class="form-check-label">Rate Based</label>
                            </div>
                        </div>
 *@
                        <div class="col-3">
                            <div class="form-check">
                                <input asp-for="AffectProfit" class="form-check-input" type="checkbox" />
                                <label asp-for="AffectProfit" class="form-check-label">Affect Profit</label>
                            </div>
                        </div>

                        <div class="col-3">
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                <label asp-for="IsActive" class="form-check-label">Active</label>
                            </div>
                        </div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="submit" class="btn btn-primary">
                        Save
                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            onclick="document.getElementById('dialog').innerHTML=''">
                        Cancel
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>
