@using ShipRate.Web.ViewModels.PermissionGroupsManagement
@model PermissionGroupDetailViewModel

@{
    ViewData["Title"] = "Permission Group Details";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@ViewData["Title"]</h2>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="bi bi-pencil"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-secondary">Return</a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Group Name:</dt>
                <dd class="col-sm-9"><strong>@Model.Name</strong></dd>

                <dt class="col-sm-3">Remarks:</dt>
                <dd class="col-sm-9">@(Model.Description ?? "-")</dd>

                <dt class="col-sm-3">Status:</dt>
                <dd class="col-sm-9">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">InActive</span>
                    }
                </dd>

                <dt class="col-sm-3">Permissions Count:</dt>
                <dd class="col-sm-9">@Model.Permissions.Count</dd>
            </dl>
        </div>
    </div>

    @if (Model.Permissions.Any())
    {
        <div class="mt-4">
            <h4>Permissions List</h4>

            @{
                var categories = Model.Permissions
                .GroupBy(p => p.Category)
                .OrderBy(g => g.Key);
            }

            @foreach (var category in categories)
            {
                <div class="card mb-3">
                    <div class="card-header bg-primary text-white">
                        <strong>@category.Key</strong>
                    </div>
                    <ul class="list-group list-group-flush">
                        @foreach (var permission in category)
                        {
                            <li class="list-group-item">
                                <i class="bi bi-check-circle text-success"></i>
                                @permission.DisplayName
                                <small class="text-muted">(@permission.Name)</small>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning mt-4">
            This group has not any permission.
        </div>
    }
</div>
