@using ShipRate.WebApp.ViewModels.CustomersVms
@model List<AttorneyIndexViewModel>

@{
    int currentPage = (int)ViewBag.CurrentPage;
    int totalPages = (int)ViewBag.TotalPages;
    var search = (AttorneySearchViewModel)ViewBag.Search;
}

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-inbox" style="font-size:2rem;"></i>
        <p class="mt-2">No attorneys found.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-striped mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width:50px;">#</th>
                    <th>Doc No</th>
                    <th>Doc Date</th>
                    <th>Client</th>
                    <th>Company</th>
                    <th class="text-center">Expiry</th>
                    <th class="text-center">Lawyers</th>
                    <th class="text-center">Status</th>
                    <th class="text-center" style="width:200px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{ int row = (currentPage - 1) * 10; }
                @foreach (var item in Model)
                {
                    row++;
                    <tr data-attorney-id="@item.Id"
                        class="@(ViewBag.SelectedAttorneyId != null && (Guid)ViewBag.SelectedAttorneyId == item.Id ? "table-active" : "")">
                        <td class="text-muted">@row</td>
                        <td class="fw-semibold">@item.DocNo</td>
                        <td>@item.DocDate.ToString("yyyy-MM-dd")</td>
                        <td>@item.ClientName</td>
                        <td>@item.CompanyName</td>
                        <td class="text-center">
                            @if (item.HasExpiryDate && item.ExpiryDate.HasValue)
                            {
                                <span class="badge bg-warning text-dark">
                                    @item.ExpiryDate.Value.ToString("yyyy-MM-dd")
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Unlimited</span>
                            }
                        </td>
                        <td class="text-center">
                            <span class="badge bg-info">@item.LawyerCount</span>
                        </td>
                        <td class="text-center">
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-primary btn-select-attorney"
                                        data-id="@item.Id"
                                        data-docno="@item.DocNo"
                                        title="Select">
                                    <i class="bi bi-check2-square"></i> Select
                                </button>
                                <button class="btn btn-outline-warning"
                                        hx-get="@Url.Action("EditAttorney", new { id = item.Id })"
                                        hx-target="#appModal .modal-content"
                                        hx-swap="innerHTML"
                                        data-bs-toggle="modal"
                                        data-bs-target="#appModal"
                                        title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-outline-danger"
                                        hx-delete="@Url.Action("DeleteAttorney", new { id = item.Id })"
                                        hx-confirm="Are you sure you want to delete this attorney?"
                                        title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="card-footer bg-light d-flex justify-content-between align-items-center">
            <small class="text-muted">Page @currentPage of @totalPages</small>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           hx-get="@Url.Action("AttorneyList", new { Page = currentPage - 1, search?.ClientName, search?.LawyerName, search?.DocNo })"
                           hx-target="#attorney-list-container"
                           hx-swap="innerHTML"
                           href="#">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link"
                               hx-get="@Url.Action("AttorneyList", new { Page = i, search?.ClientName, search?.LawyerName, search?.DocNo })"
                               hx-target="#attorney-list-container"
                               hx-swap="innerHTML"
                               href="#">@i</a>
                        </li>
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link"
                           hx-get="@Url.Action("AttorneyList", new { Page = currentPage + 1, search?.ClientName, search?.LawyerName, search?.DocNo })"
                           hx-target="#attorney-list-container"
                           hx-swap="innerHTML"
                           href="#">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
}
