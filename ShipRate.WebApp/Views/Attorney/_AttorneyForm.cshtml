@using ShipRate.WebApp.ViewModels.CustomersVms
@model AttorneyEditViewModel

@{
    bool isEdit = Model.Id.HasValue && Model.Id != Guid.Empty;
    string title = isEdit ? "Edit Attorney" : "New Attorney";
    string action = isEdit
        ? Url.Action("EditAttorney")!
        : Url.Action("CreateAttorney")!;
}

<form hx-post="@action"
      hx-target="#appModal .modal-content"
      hx-swap="innerHTML">

    @Html.AntiForgeryToken()

    @if (isEdit)
    {
        <input type="hidden" name="Id" value="@Model.Id" />
    }

    <!-- Modal Header -->
    <div class="modal-header bg-primary bg-gradient text-white">
        <h5 class="modal-title">
            <i class="bi @(isEdit ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
            @title
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
    </div>

    <!-- Modal Body -->
    <div class="modal-body">

        <!-- Client Selection -->
        <div class="mb-3">
            <label class="form-label fw-semibold">
                <i class="bi bi-person text-primary me-1"></i> Client
            </label>
            <div class="position-relative">
                <input type="text"
                       id="clientSearch"
                       class="form-control"
                       placeholder="Type to search client…"
                       value="@Model.ClientName"
                       autocomplete="off" />
                <input type="hidden" name="ClientId" id="clientId" value="@Model.ClientId" />
                <div id="clientResults"
                     class="list-group position-absolute w-100 shadow"
                     style="z-index:9999; max-height:200px; overflow-y:auto; display:none;">
                </div>
            </div>
            <span asp-validation-for="ClientId" class="text-danger small"></span>
        </div>

        <div class="row g-3">
            <!-- Doc No -->
            <div class="col-md-6">
                <label class="form-label fw-semibold">
                    <i class="bi bi-hash text-primary me-1"></i> Doc No
                </label>
                <input type="text" name="DocNo" class="form-control"
                       value="@Model.DocNo" placeholder="Enter document number" />
                <span asp-validation-for="DocNo" class="text-danger small"></span>
            </div>

            <!-- Doc Date -->
            <div class="col-md-6">
                <label class="form-label fw-semibold">
                    <i class="bi bi-calendar-event text-primary me-1"></i> Doc Date
                </label>
                <input type="date" name="DocDate" class="form-control"
                       value="@Model.DocDate.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="DocDate" class="text-danger small"></span>
            </div>
        </div>

        <!-- Has Expiry Date -->
        <div class="mt-3 mb-2">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox"
                       name="HasExpiryDate" id="hasExpiryDate"
                       value="true"
                       @(Model.HasExpiryDate ? "checked" : "")
                       onchange="toggleExpiry(this)" />
                <label class="form-check-label fw-semibold" for="hasExpiryDate">
                    <i class="bi bi-clock-history text-warning me-1"></i> Has Expiry Date
                </label>
            </div>
        </div>

        <!-- Expiry Date -->
        <div class="mb-3" id="expiryDateGroup" style="display:@(Model.HasExpiryDate ? "block" : "none");">
            <label class="form-label fw-semibold">
                <i class="bi bi-calendar-x text-danger me-1"></i> Expiry Date
            </label>
            <input type="date" name="ExpiryDate" class="form-control"
                   value="@(Model.ExpiryDate?.ToString("yyyy-MM-dd"))" />
        </div>

        <!-- Remarks -->
        <div class="mb-3">
            <label class="form-label fw-semibold">
                <i class="bi bi-chat-left-text text-primary me-1"></i> Remarks
            </label>
            <textarea name="Remarks" class="form-control" rows="3"
                      placeholder="Optional notes…">@Model.Remarks</textarea>
        </div>

        <!-- Is Active -->
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox"
                   name="IsActive" id="isActive"
                   value="true"
                   @(Model.IsActive ? "checked" : "") />
            <label class="form-check-label fw-semibold" for="isActive">
                <i class="bi bi-toggle-on text-success me-1"></i> Active
            </label>
        </div>

    </div>

    <!-- Modal Footer -->
    <div class="modal-footer bg-light">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-lg me-1"></i> Cancel
        </button>
        <button type="submit" class="btn btn-primary">
            <i class="bi @(isEdit ? "bi-check-lg" : "bi-plus-lg") me-1"></i>
            @(isEdit ? "Save Changes" : "Create")
        </button>
    </div>
</form>

<script>
    // ── Toggle Expiry Date ──
    function toggleExpiry(cb) {
        document.getElementById('expiryDateGroup').style.display = cb.checked ? 'block' : 'none';
    }

    // ── Client Autocomplete ──
    (function () {
        const input = document.getElementById('clientSearch');
        const hidden = document.getElementById('clientId');
        const results = document.getElementById('clientResults');
        let debounce;

        input.addEventListener('input', function () {
            clearTimeout(debounce);
            const term = this.value.trim();
            if (term.length < 2) {
                results.style.display = 'none';
                return;
            }
            debounce = setTimeout(() => {
                fetch('/Attorney/SearchPersons?term=' + encodeURIComponent(term))
                    .then(r => r.json())
                    .then(data => {
                        results.innerHTML = '';
                        if (data.length === 0) {
                            results.style.display = 'none';
                            return;
                        }
                        data.forEach(p => {
                            const a = document.createElement('a');
                            a.href = '#';
                            a.className = 'list-group-item list-group-item-action';
                            a.textContent = p.personName;
                            a.addEventListener('click', function (e) {
                                e.preventDefault();
                                input.value = p.personName;
                                hidden.value = p.id;
                                results.style.display = 'none';
                            });
                            results.appendChild(a);
                        });
                        results.style.display = 'block';
                    });
            }, 300);
        });

        document.addEventListener('click', function (e) {
            if (!results.contains(e.target) && e.target !== input) {
                results.style.display = 'none';
            }
        });
    })();
</script>
