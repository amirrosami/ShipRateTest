@if (Model.TotalPages > 1)
{
    <nav aria-label="Flight pagination">
        <ul class="pagination justify-content-center mb-0">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link"
                   hx-get="@Url.Action("LoadFlightGrid", new { page = Model.CurrentPage - 1, searchFlightNumber = Model.SearchFlightNumber, searchAirLineId = Model.SearchAirLineId })"
                   hx-target="#flight-grid-container">
                    Previous
                </a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       hx-get="@Url.Action("LoadFlightGrid", new { page = i, searchFlightNumber = Model.SearchFlightNumber, searchAirLineId = Model.SearchAirLineId })"
                       hx-target="#flight-grid-container">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   hx-get="@Url.Action("LoadFlightGrid", new { page = Model.CurrentPage + 1, searchFlightNumber = Model.SearchFlightNumber, searchAirLineId = Model.SearchAirLineId })"
                   hx-target="#flight-grid-container">
                    Next
                </a>
            </li>
        </ul>
    </nav>
} *@
