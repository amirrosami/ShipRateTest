@model PagedResult<FlightListItem>
@using ShipRate.Application.DTOs
@using ShipRate.WebApp.ViewModels
@using ShipRate.WebApp.ViewModels.FlightVms

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0"><i class="bi bi-box-seam me-2"></i>Locations</h2>
        <small class="text-muted"></small>
    </div>
    <button type="button"
            class="btn btn-primary"
            hx-get="@Url.Action("Create", "Flight")"
            hx-target="#app-modal-content"
            hx-swap="innerHTML">
        <i class="bi bi-plus-lg me-1"></i>New
    </button>
</div>

@await Html.PartialAsync(
"_GridFilters",
    new GridFilterViewModel
    {
        Page = Model.Page,
        PageSize = Model.PageSize,
        SearchTerm = Model.SearchTerm,
        SortColumn = Model.SortColumn,
        SortDirection = Model.SortDirection,
        ListUrl = Url.Action("List", "Flight"),
        CustomFilterPartial = "",
        CustomFilterValues = Model.CustomFilterValues,
    }
)




<div id="table-container"
     hx-post="@Url.Action("List", "Flight")"
     hx-trigger="load, GridChanged from:body"
     hx-swap="innerHTML"
     hx-include="#grid-filters, #table-sort-info">
</div>

<div class="card shadow-sm" id="flight-dates-section" style="display:none;">
    <div class="card-header bg-success text-white d-flex justify-content-between align-items-center py-2">
        <h6 class="mb-0 fw-semibold">
            <i class="bi bi-calendar-event me-2"></i>Flight Dates
        </h6>
        <button class="btn btn-light btn-sm" id="btn-new-flight-date" style="display:none;">
            <i class="bi bi-plus-lg me-1"></i>New Flight Date
        </button>
    </div>

    <div class="card-body">
        <div id="flight-date-grid-container">
            <p class="text-muted text-center py-4 mb-0">Select a flight to view dates</p>
        </div>
    </div>
</div>

<div id="modal-container"></div>

@section Scripts {
    <script src="~/js/flight.js"></script>
}

