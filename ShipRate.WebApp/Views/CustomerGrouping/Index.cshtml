@using ShipRate.WebApp.ViewModels.CustomersVms
@model List<CustomerGroupingBaseVM>
@{
    ViewData["Title"] = "Customer Grouping Management";
}

<div class="container-fluid">
    <h4 class="mb-4"><i class="bi bi-diagram-3"></i> Customer Grouping Management</h4>

    <!-- ======================== GRID 1: Grouping Bases ======================== -->
    <div class="card mb-3">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2">
            <span><i class="bi bi-collection"></i> Grouping Bases</span>
            <button class="btn btn-sm btn-light"
                    hx-get="@Url.Action("CreateBase")"
                    hx-target="#modalBody"
                    hx-swap="innerHTML"
                    data-bs-toggle="modal"
                    data-bs-target="#crudModal">
                <i class="bi bi-plus-lg"></i> New Base
            </button>
        </div>
        <div class="card-body p-0" id="basesGridContainer">
            @await Html.PartialAsync("_BasesGrid", Model)
        </div>
    </div>

    <!-- ======================== GRID 2: Customer Groups ======================== -->
    <div class="card mb-3" id="groupsCard" style="display:none;">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center py-2">
            <span><i class="bi bi-people"></i> Customer Groups — <span id="baseNameHeader"></span></span>
            <button class="btn btn-sm btn-light" id="btnNewGroup" style="display:none;"
                    hx-target="#modalBody"
                    hx-swap="innerHTML"
                    data-bs-toggle="modal"
                    data-bs-target="#crudModal">
                <i class="bi bi-plus-lg"></i> New Group
            </button>
        </div>
        <div class="card-body p-0" id="groupsGridContainer">
        </div>
    </div>

    <!-- ======================== GRID 3: Members ======================== -->
    <div class="card mb-3" id="membersCard" style="display:none;">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center py-2">
            <span><i class="bi bi-person-check"></i> Group Members — <span id="groupNameHeader"></span></span>
            <button class="btn btn-sm btn-light" id="btnNewMember" style="display:none;"
                    hx-target="#modalBody"
                    hx-swap="innerHTML"
                    data-bs-toggle="modal"
                    data-bs-target="#crudModal">
                <i class="bi bi-plus-lg"></i> Add Member
            </button>
        </div>
        <div class="card-body p-0" id="membersGridContainer">
        </div>
    </div>
</div>

<!-- ======================== MODAL ======================== -->
<div class="modal fade" id="crudModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Form</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalBody">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ---- Current selections ----
        let selectedBaseId = null;
        let selectedGroupId = null;

        // ---- Select a Grouping Base → load Groups ----
        function selectBase(id, name) {
            selectedBaseId = id;
            selectedGroupId = null;

            // highlight row
            document.querySelectorAll('#basesGridContainer tr').forEach(r => r.classList.remove('table-active'));
            document.getElementById('baseRow-' + id)?.classList.add('table-active');

            // show groups card
            document.getElementById('groupsCard').style.display = '';
            document.getElementById('baseNameHeader').textContent = name;

            // hide members card
            document.getElementById('membersCard').style.display = 'none';
            document.getElementById('membersGridContainer').innerHTML = '';

            // update New Group button
            var btnNew = document.getElementById('btnNewGroup');
            btnNew.style.display = '';
            btnNew.setAttribute('hx-get', '/CustomerGrouping/CreateGroup?baseId=' + id);
            htmx.process(btnNew);

            // load groups grid
            htmx.ajax('GET', '/CustomerGrouping/GroupsGrid?baseId=' + id, '#groupsGridContainer');
        }

        // ---- Select a Group → load Members ----
        function selectGroup(id, name) {
            selectedGroupId = id;

            // highlight row
            document.querySelectorAll('#groupsGridContainer tr').forEach(r => r.classList.remove('table-active'));
            document.getElementById('groupRow-' + id)?.classList.add('table-active');

            // show members card
            document.getElementById('membersCard').style.display = '';
            document.getElementById('groupNameHeader').textContent = name;

            // update New Member button
            var btnNew = document.getElementById('btnNewMember');
            btnNew.style.display = '';
            btnNew.setAttribute('hx-get', '/CustomerGrouping/CreateMember?groupId=' + id);
            htmx.process(btnNew);

            // load members grid
            htmx.ajax('GET', '/CustomerGrouping/MembersGrid?groupId=' + id, '#membersGridContainer');
        }

        // ---- After save: close modal & refresh relevant grid ----
        document.addEventListener('htmx:afterRequest', function (evt) {
            if (evt.detail.xhr.responseText === 'OK') {
                bootstrap.Modal.getInstance(document.getElementById('crudModal'))?.hide();

                // refresh all visible grids
                htmx.ajax('GET', '/CustomerGrouping/BasesGrid', '#basesGridContainer');

                if (selectedBaseId) {
                    htmx.ajax('GET', '/CustomerGrouping/GroupsGrid?baseId=' + selectedBaseId, '#groupsGridContainer');
                }
                if (selectedGroupId) {
                    htmx.ajax('GET', '/CustomerGrouping/MembersGrid?groupId=' + selectedGroupId, '#membersGridContainer');
                }
            }
        });
    </script>
}
