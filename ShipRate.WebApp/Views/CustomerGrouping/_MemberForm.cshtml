@using ShipRate.WebApp.ViewModels.CustomersVms
@model CustomerBelongsToGroupFormVM
@{
    bool isEdit = Model.Id != null && Model.Id != Guid.Empty;
    string customerName = ViewBag.CustomerName ?? "";
}

<form hx-post="@Url.Action("SaveMember")"
      hx-target="#modalBody"
      hx-swap="innerHTML"
      id="memberForm">

    <input type="hidden" name="Id" value="@Model.Id" />
    <input type="hidden" name="CustomerGroupId" value="@Model.CustomerGroupId" />
    <input type="hidden" name="CustomerId" id="hiddenCustomerId" value="@Model.CustomerId" />

    <!-- ============ Customer Search (only for CREATE) ============ -->
    @if (!isEdit)
    {
        <div class="mb-3">
            <label class="form-label fw-semibold">Customer <span class="text-danger">*</span></label>
            <div class="position-relative" id="customerSearchWrapper">
                <input type="text"
                       class="form-control"
                       id="customerSearchInput"
                       placeholder="Type to search customer..."
                       autocomplete="off"
                       required />

                <!-- Selected customer display -->
                <div id="selectedCustomerBadge" class="mt-1" style="display:none;">
                    <span class="badge bg-primary fs-6 d-inline-flex align-items-center gap-1">
                        <i class="bi bi-person-check"></i>
                        <span id="selectedCustomerName"></span>
                        <button type="button" class="btn-close btn-close-white ms-1" style="font-size:0.6rem;"
                                onclick="clearCustomerSelection()"></button>
                    </span>
                </div>

                <!-- Search results dropdown -->
                <div id="customerSearchResults"
                     class="list-group position-absolute w-100 shadow-lg"
                     style="z-index:1055; max-height:220px; overflow-y:auto; display:none;">
                </div>

                <!-- Spinner -->
                <div id="searchSpinner" class="position-absolute" style="right:10px; top:8px; display:none;">
                    <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- In edit mode, show customer name read-only -->
        <div class="mb-3">
            <label class="form-label fw-semibold">Customer</label>
            <input type="text" class="form-control" value="@customerName" readonly disabled />
        </div>
    }

    <!-- ============ Enter Date ============ -->
    <div class="mb-3">
        <label class="form-label fw-semibold">Enter Date <span class="text-danger">*</span></label>
        <input type="date"
               name="EnterDate"
               value="@Model.EnterDate.ToString("yyyy-MM-dd")"
               class="form-control"
               required />
    </div>

    <!-- ============ Exit Date ============ -->
    <div class="mb-3">
        <label class="form-label fw-semibold">Exit Date</label>
        <input type="date"
               name="ExitDate"
               value="@(Model.ExitDate.HasValue && Model.ExitDate.Value.Year < 9000 ? Model.ExitDate.Value.ToString("yyyy-MM-dd") : "")"
               class="form-control" />
    </div>

    <!-- ============ Enter Remarks ============ -->
    <div class="mb-3">
        <label class="form-label fw-semibold">Enter Remarks</label>
        <textarea name="EnterRemarks" class="form-control" rows="2"
                  placeholder="Remarks for entering...">@Model.EnterRemarks</textarea>
    </div>

    <!-- ============ Exit Remarks ============ -->
    <div class="mb-3">
        <label class="form-label fw-semibold">Exit Remarks</label>
        <textarea name="ExitRemarks" class="form-control" rows="2"
                  placeholder="Remarks for exiting...">@Model.ExitRemarks</textarea>
    </div>

    <!-- ============ Active ============ -->
    <div class="mb-3 form-check form-switch">
        <input type="checkbox"
               class="form-check-input"
               name="IsActive"
               value="true"
               id="chkMemberActive"
               @(Model.IsActive ? "checked" : "") />
        <label class="form-check-label" for="chkMemberActive">Active</label>
    </div>

    <!-- ============ Buttons ============ -->
    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary text-white" id="btnSaveMember">
            <i class="bi bi-check-lg"></i>
            @(isEdit ? "Update" : "Add Member")
        </button>
    </div>
</form>

<!-- ============ LIVE SEARCH SCRIPT ============ -->
<script>
    document.getElementById('modalTitle').textContent =
        '@(isEdit ? "Edit Member" : "Add Member to Group")';

    (function () {
        const searchInput = document.getElementById('customerSearchInput');
        if (!searchInput) return; // edit mode — no search field

        const resultsDiv = document.getElementById('customerSearchResults');
        const spinner = document.getElementById('searchSpinner');
        const hiddenId = document.getElementById('hiddenCustomerId');
        const badge = document.getElementById('selectedCustomerBadge');
        const badgeName = document.getElementById('selectedCustomerName');
        const groupId = '@Model.CustomerGroupId';

        let debounceTimer = null;

        // ---- Input event with debounce ----
        searchInput.addEventListener('input', function () {
            const term = this.value.trim();

            clearTimeout(debounceTimer);

            if (term.length < 2) {
                resultsDiv.style.display = 'none';
                resultsDiv.innerHTML = '';
                return;
            }

            spinner.style.display = '';

            debounceTimer = setTimeout(function () {
                fetch('/CustomerGrouping/SearchCustomers?groupId=' + groupId + '&term=' + encodeURIComponent(term))
                    .then(r => r.json())
                    .then(data => {
                        spinner.style.display = 'none';
                        resultsDiv.innerHTML = '';

                        if (data.length === 0) {
                            resultsDiv.innerHTML =
                                '<div class="list-group-item text-muted py-2">' +
                                '<i class="bi bi-exclamation-circle"></i> No matching customers found.' +
                                '</div>';
                            resultsDiv.style.display = '';
                            return;
                        }

                        data.forEach(function (c) {
                            const item = document.createElement('a');
                            item.href = '#';
                            item.className = 'list-group-item list-group-item-action d-flex align-items-center gap-2 py-2';
                            item.innerHTML =
                                '<i class="bi bi-person text-primary"></i>' +
                                '<span>' + escapeHtml(c.fullName) + '</span>';

                            item.addEventListener('click', function (e) {
                                e.preventDefault();
                                selectCustomer(c.id, c.fullName);
                            });

                            resultsDiv.appendChild(item);
                        });

                        resultsDiv.style.display = '';
                    })
                    .catch(function () {
                        spinner.style.display = 'none';
                    });
            }, 300); // 300ms debounce
        });

        // ---- Select a customer from dropdown ----
        function selectCustomer(id, name) {
            hiddenId.value = id;

            // Show badge, hide search
            badge.style.display = '';
            badgeName.textContent = name;
            searchInput.style.display = 'none';
            searchInput.removeAttribute('required');

            // Hide dropdown
            resultsDiv.style.display = 'none';
            resultsDiv.innerHTML = '';
        }

        // ---- Close dropdown on outside click ----
        document.addEventListener('click', function (e) {
            if (!document.getElementById('customerSearchWrapper').contains(e.target)) {
                resultsDiv.style.display = 'none';
            }
        });

        // ---- Escape HTML helper ----
        function escapeHtml(text) {
            var div = document.createElement('div');
            div.appendChild(document.createTextNode(text));
            return div.innerHTML;
        }

        // ---- Make clearCustomerSelection global ----
        window.clearCustomerSelection = function () {
            hiddenId.value = '';
            badge.style.display = 'none';
            badgeName.textContent = '';
            searchInput.style.display = '';
            searchInput.value = '';
            searchInput.setAttribute('required', 'required');
            searchInput.focus();
        };

        // ---- Form validation: ensure customer selected ----
        document.getElementById('memberForm').addEventListener('htmx:configRequest', function (evt) {
            if (!hiddenId.value || hiddenId.value === '00000000-0000-0000-0000-000000000000') {
                evt.preventDefault();
                searchInput.classList.add('is-invalid');

                // Remove existing feedback
                let fb = document.getElementById('customerValidationFeedback');
                if (!fb) {
                    fb = document.createElement('div');
                    fb.id = 'customerValidationFeedback';
                    fb.className = 'invalid-feedback';
                    fb.textContent = 'Please select a customer.';
                    searchInput.parentNode.appendChild(fb);
                }
                fb.style.display = 'block';
            }
        });
    })();
</script>
