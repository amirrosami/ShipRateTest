@using ShipRate.WebApp.ViewModels.CustomersVms
@model CustomerGroupFormVM

<form hx-post="@Url.Action("SaveGroup")"
      hx-target="#modalBody"
      hx-swap="innerHTML">

    <input type="hidden" name="Id" value="@Model.Id" />
    <input type="hidden" name="CustomerGroupingBaseId" value="@Model.CustomerGroupingBaseId" />

    <div class="mb-3">
        <label class="form-label fw-semibold">Group Name <span class="text-danger">*</span></label>
        <input type="text"
               name="CustomerGroupName"
               value="@Model.CustomerGroupName"
               class="form-control"
               placeholder="Enter group name..."
               required
               autofocus />
    </div>

    <div class="mb-3 form-check form-switch">
        <input type="checkbox"
               class="form-check-input"
               name="IsActive"
               value="true"
               id="chkGroupActive"
               @(Model.IsActive ? "checked" : "") />
        <label class="form-check-label" for="chkGroupActive">Active</label>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg"></i>
            @(Model.Id == null || Model.Id == Guid.Empty ? "Create" : "Update")
        </button>
    </div>
</form>

<script>
    document.getElementById('modalTitle').textContent =
        '@(Model.Id == null || Model.Id == Guid.Empty ? "New Customer Group" : "Edit Customer Group")';
</script>
