@using ShipRate.WebApp.ViewModels.CustomersVms
@model List<CustomerBelongsToGroupVM>
@{
    int currentPage = (int)(ViewBag.CurrentPage ?? 1);
    int totalPages = (int)(ViewBag.TotalPages ?? 1);
    string groupId = ViewBag.SelectedGroupId?.ToString() ?? "";
}

<table class="table table-sm table-hover table-striped mb-0">
    <thead class="table-light">
        <tr>
            <th style="width:50px">#</th>
            <th>Customer Name</th>
            <th>Enter Date</th>
            <th>Exit Date</th>
            <th>Enter Remarks</th>
            <th style="width:80px" class="text-center">Active</th>
            <th style="width:140px" class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="7" class="text-center text-muted py-3">No members found in this group.</td></tr>
        }
        @{
            int idx = (currentPage - 1) * 10;
        }
        @foreach (var item in Model)
        {
            idx++;
            <tr>
                <td>@idx</td>
                <td>@item.CustomerName</td>
                <td>@item.EnterDate.ToString("yyyy/MM/dd")</td>
                <td>
                    @if (item.ExitDate.HasValue && item.ExitDate.Value.Year < 9000)
                    {
                        @item.ExitDate.Value.ToString("yyyy/MM/dd")
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
                <td>@item.EnterRemarks</td>
                <td class="text-center">
                    @if (item.IsActive)
                    {
                        <span class="badge bg-success">Yes</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">No</span>
                    }
                </td>
                <td class="text-center">
                    <button class="btn btn-sm btn-outline-warning"
                            hx-get="@Url.Action("EditMember", new { id = item.Id })"
                            hx-target="#modalBody"
                            hx-swap="innerHTML"
                            data-bs-toggle="modal"
                            data-bs-target="#crudModal">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-danger"
                            hx-delete="@Url.Action("DeleteMember", new { id = item.Id })"
                            hx-confirm="Are you sure you want to remove this member?"
                            hx-target="#membersGridContainer"
                            hx-swap="innerHTML">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- ======================== PAGINATION ======================== -->
@if (totalPages > 1)
{
    <nav class="d-flex justify-content-center py-2">
        <ul class="pagination pagination-sm mb-0">
            <!-- Previous -->
            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                <a class="page-link" href="#"
                   hx-get="@Url.Action("MembersGrid", new { groupId = groupId, page = currentPage - 1 })"
                   hx-target="#membersGridContainer"
                   hx-swap="innerHTML">
                    &laquo;
                </a>
            </li>

            <!-- Page Numbers -->
            @for (int p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == currentPage ? "active" : "")">
                    <a class="page-link" href="#"
                       hx-get="@Url.Action("MembersGrid", new { groupId = groupId, page = p })"
                       hx-target="#membersGridContainer"
                       hx-swap="innerHTML">
                        @p
                    </a>
                </li>
            }

            <!-- Next -->
            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                <a class="page-link" href="#"
                   hx-get="@Url.Action("MembersGrid", new { groupId = groupId, page = currentPage + 1 })"
                   hx-target="#membersGridContainer"
                   hx-swap="innerHTML">
                    &raquo;
                </a>
            </li>
        </ul>
    </nav>
}
