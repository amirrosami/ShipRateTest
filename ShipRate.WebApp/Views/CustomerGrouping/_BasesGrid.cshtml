@using ShipRate.WebApp.ViewModels.CustomersVms
@model List<CustomerGroupingBaseVM>

<table class="table table-sm table-hover table-striped mb-0">
    <thead class="table-light">
        <tr>
            <th style="width:50px">#</th>
            <th>Grouping Base Name</th>
            <th style="width:80px" class="text-center">Groups</th>
            <th style="width:80px" class="text-center">Active</th>
            <th style="width:160px" class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="5" class="text-center text-muted py-3">No records found.</td></tr>
        }
        @{
            int idx = 0;
        }
        @foreach (var item in Model)
        {
            idx++;
            <tr id="baseRow-@item.Id">
                <td>@idx</td>
                <td>@item.CustomerGroupingBaseName</td>
                <td class="text-center">
                    <span class="badge bg-secondary">@item.GroupCount</span>
                </td>
                <td class="text-center">
                    @if (item.IsActive)
                    {
                        <span class="badge bg-success">Yes</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">No</span>
                    }
                </td>
                <td class="text-center">
                    <button class="btn btn-sm btn-outline-primary"
                            onclick="selectBase('@item.Id', '@item.CustomerGroupingBaseName')">
                        <i class="bi bi-arrow-right-circle"></i> Select
                    </button>
                    <button class="btn btn-sm btn-outline-warning"
                            hx-get="@Url.Action("EditBase", new { id = item.Id })"
                            hx-target="#modalBody"
                            hx-swap="innerHTML"
                            data-bs-toggle="modal"
                            data-bs-target="#crudModal">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-danger"
                            hx-delete="@Url.Action("DeleteBase", new { id = item.Id })"
                            hx-confirm="Are you sure you want to delete this base?"
                            hx-target="#basesGridContainer"
                            hx-swap="innerHTML">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>
