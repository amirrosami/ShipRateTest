@using ShipRate.WebApp.ViewModels.CompaniesViewModels
@model CompanySelectorViewModel

@if (Model.Companies != null && Model.Companies.Any())
{
    <form asp-controller="CompanyContext"
          asp-action="Change"
          method="post"
          class="d-flex align-items-center gap-2">

        @Html.AntiForgeryToken()

        <label class="text-muted small mb-0">
            
        </label>

        <select name="companyId"
                class="form-select form-select-sm"
                style="min-width: 220px;"
                onchange="this.form.submit()">

            @foreach (var company in Model.Companies)
            {
                <option value="@company.Id"
                        selected="@(company.Id == Model.CurrentCompanyId)">
                    @company.Name
                </option>
            }
        </select>
    </form>
}
