@using ShipRate.WebApp.ViewModels
@model SelectFieldVm

<div class="mb-2 col-md-6">

    <label class="form-label">
        @Model.Label
    </label>

    <select name="@Model.Name"
            class="form-select @(ViewData.ModelState.ContainsKey(Model.Name) ? "is-invalid" : "")">

        <option value="">Select...</option>

        @foreach (var item in Model.Options)
        {
            <option value="@item.Value"
                    selected="@(item.Value == Model.Selected)">
                @item.Text
            </option>
        }

    </select>

</div>
