@* ============================================
   MAIN LAYOUT - ShipRate TMS
   ============================================ *@
<!DOCTYPE html>
<html lang="en" dir="ltr" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShipRate TMS</title>


    <link href="/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />

    <link href="~/css/select2.min.css" rel="stylesheet" />
    <link href="~/css/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/siteold.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/siteg.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/flight.css" />
    <link href="~/css/persian-datepicker.min.css" rel="stylesheet" />
    <link href="~/css/flatpickr.min.css" rel="stylesheet" />
    <link href="~/css/all.min.css" rel="stylesheet" />





    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- ========== SIDEBAR ========== -->
    @await Html.PartialAsync("_Sidebar")

    <!-- ========== MAIN CONTENT ========== -->
    <main class="sneat-main d-flex flex-column min-vh-100" id="mainContent">

        @await Html.PartialAsync("_Navbar")

        <div class="content-wrapper flex-grow-1" id="renderBodyContect">
            @RenderBody()

            <div id="global-modal-container">
                @await Html.PartialAsync("~/Views/Shared/_GlobalModal.cshtml")
            </div>
        </div>

        <div class="mt-auto">
            @await Html.PartialAsync("_Footer")
        </div>

    </main>

    <!-- IMPORTANT: Modal must be outside container and always present in DOM -->
    <div class="modal fade" id="appModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content" id="modal-content">
                <!-- HTMX loads content here -->
            </div>
        </div>
    </div>
    <div class="modal fade" id="secondModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered ">
            <div class="modal-content" id="modal-content2">
            </div>
        </div>
    </div>




    <!-- Toast Container -->
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11000">
        <div id="appToast" class="toast align-items-center text-bg-success border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body" id="toastMessage">
                    <i class="bi bi-check-circle me-2"></i>Operation completed successfully!
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>




    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>

    <!-- Custom Layout JS -->
    <script src="~/js/chart.umd.min.js"></script>
    <script src="~/js/layout.js" asp-append-version="true"></script>


    <script src="~/js/htmx.min.js" asp-append-version="true"></script>
    <script src="~/js/morphdom-swap.js" asp-append-version="true"></script>
    <script src="~/js/morphdom-umd.min.js" asp-append-version="true"></script>
    <script src="~/js/modal-manager.js" asp-append-version="true"></script>



    <!-- 3️⃣ ★★★ کانفیگ Anti-Forgery برای HTMX ★★★ -->
    <script>
        document.body.addEventListener('htmx:configRequest', function(evt) {
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
                evt.detail.headers['RequestVerificationToken'] = token.value;
            }
        });

    </script>



    @* //Notifications Hub *@
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            startNotificationHub();
            startMessagingHub();
        });

        function startNotificationHub() {
            if (!window.signalR) {
                console.warn("SignalR is not loaded.");
                return;
            }

            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/notificationHub")
                .withAutomaticReconnect()
                .build();
            connection.on("ReceiveNotification", function (notification) {
                document.body.dispatchEvent(new CustomEvent("showToast", {
                    detail: {
                        message: notification.message || "Notif جدید رسید.",
                        type: "info"
                    }
                }));
                htmx.trigger(document.body, "notificationChanged");
            });

            connection.start()
                .then(function () {
                    console.log("NotificationHub connected.");
                })
                .catch(function (error) {
                    console.error("NotificationHub connection error:", error);
                });
        }




        function startMessagingHub() {
            if (!window.signalR) {
                console.warn("SignalR is not loaded.");
                return;
            }

            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/messagingHub")
                .withAutomaticReconnect()
                .build();


        connection.on('messagingChanged', function () {
                htmx.trigger(document.body, 'messagingChanged');
            });

            connection.start()
                .then(function () {
                    console.log("Messagin Hub connected.");
                })
                .catch(function (error) {
                    console.error("Messaging Hub connection error:", error);
                });
        }








    </script>
    <script src="~/js/siteg.js"></script>
    <script src="~/js/select2.min.js" asp-append-version="true"></script>
    <script src="~/js/persian-date.min.js"></script>
    <script src="~/js/persian-datepicker.min.js"></script>
    <script src="~/js/flatpickr.js"></script>
    <script src="~/js/autocomplete-input.js"></script>
    <script src="~/js/signalr.min.js"></script>
    
    @* Additional page-specific scripts *@
    @* <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script> *@
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        document.addEventListener("DOMContentLoaded", function () {
               @if (TempData["SuccessMessage"] != null)
               {
                       <text>
                       showToast('@TempData["SuccessMessage"]', 'success');
                       </text>
               }
               @if (TempData["ErrorMessage"] != null)
               {
                       <text>
                       showToast('@TempData["ErrorMessage"]', 'danger');
                       </text>
               }
           });


        function showToast(message, type = 'success') {
                var toastEl = document.getElementById('appToast');
                var toastBody = document.getElementById('toastMessage');
                // var toastIcon = document.getElementById('toastIcon');

                toastEl.className = 'toast align-items-center text-white border-0 shadow bg-' + (type === 'success' ? 'success' : 'danger');
                // toastIcon.className = type === 'success' ? 'bi bi-check-circle-fill fs-5' : 'bi bi-exclamation-triangle-fill fs-5';
                toastBody.textContent = message;

                var toast = new bootstrap.Toast(toastEl, { delay: 4000 });
                toast.show();
            }



    </script>
</body>
</html>