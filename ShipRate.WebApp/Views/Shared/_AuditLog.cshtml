@using ShipRate.Web.ViewModels
@using ShipRate.WebApp.Controllers
@using ShipRate.WebApp.ViewModels
@model List<AuditLogViewModel>


<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="form-caption-bg shadow-sm">
                <tr class="form-caption-bg pt-4 h-25">
                    <td class="form-caption-bg shadow-sm text-white">#</td>
                    <th class="form-caption-bg text-white shadow-sm"> Date Time</th>
                    <th class="form-caption-bg text-white shadow-sm">Action</th>
                    <th class="form-caption-bg text-white shadow-sm">User Name</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CreatedAt</td>
                        <td>@item.Action</td>
                        <td>@item.UserName</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
