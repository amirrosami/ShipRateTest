@using ShipRate.WebApp.Controllers
@using ShipRate.WebApp.ViewModels
@using ShipRate.WebApp.ViewModels.TerritoryVms
@using ShipRate.WebApp.ViewModels.VoyageVms
@model DetailGridViewModel

<input type="hidden" name="voyagePortId" value="@Model.MasterId" id="selected-detail-id" />
@{
    int counter = 0;
}
@if (!Model.Data.Any())
{
    <tr>
        <td colspan="6" class="text-center py-5 text-muted">
            <i class="bi bi-inbox display-4 d-block mb-2"></i>
            No Records found.
        </td>
    </tr>
}

else
{

    @foreach (var item in Model.Data)
    {
        counter++;
        var vm = (VoyagePortEventListItem)item;
        <tr>
            <td>@counter</td>
            <td>@vm.EventTypeName</td>
            <td>@vm.VoyagePortEventDateTime</td>
            <td>@vm.VoyagePortEventRemarks</td>
@*             <td>
                @if (vm.IsActive)
                {
                    <span class="badge text-bg-success">
                        Active
                    </span>
                }
                else
                {
                    <span class="badge text-bg-danger">
                        Inactive
                    </span>
                }
            </td>
 *@            <td>@vm.CreateUserName</td>
            <td>@vm.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
            <td>@vm.UpdateUserName</td>
            <td>@vm.UpdatedAt?.ToString("yyyy-MM-dd HH:mm")</td>
            <td class="text-center">
                <div class="btn-group btn-group-sm">

                    <button type="button"
                            class="btn btn-outline-primary"
                            title="Edit"
                            hx-get="@Url.Action("EditVoyagePortEvent", "Voyage", new { id = vm.Id })"
                            hx-target="#app-modal-content"
                            hx-swap="innerHTML">
                        <i class="bi bi-pencil"></i>
                    </button>


                    <button type="button"
                            class="btn btn-outline-danger"
                            title="Delete"
                            hx-get="@Url.Action("DeleteVoyagePortEvent", "Voyage", new { id = vm.Id })"
                            hx-target="#app-modal-content"
                            hx-swap="innerHTML">
                        <i class="bi bi-trash"></i>
                    </button>


                </div>
            </td>
        </tr>
    }

}





