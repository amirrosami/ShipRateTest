@using ShipRate.WebApp.Controllers
@using ShipRate.WebApp.ViewModels
@using ShipRate.WebApp.ViewModels.TerritoryVms
@using ShipRate.WebApp.ViewModels.VoyageVms
@model DetailGridViewModel

<input type="hidden" name="voyageId" value="@Model.MasterId" id="selected-master-id" />
@{
    int counter = 0;
}
@if (!Model.Data.Any())
{
    <tr>
        <td colspan="6" class="text-center py-5 text-muted">
            <i class="bi bi-inbox display-4 d-block mb-2"></i>
            No Records found.
        </td>
    </tr>
}

else
{

    @foreach (var item in Model.Data)
    {
        counter++;
        var vm = (VoyagePortListItem)item;
        <tr>
            <td>@counter</td>
            <td>@vm.VoyagePortSequence</td>
            <td>@vm.PortName</td>
            <td>@vm.TerminalName</td>
            <td>@vm.ETA</td>
            <td>@vm.ETD</td>
            <td>@vm.ATA</td>
            <td>@vm.ATD</td>
            <td>@vm.OutboundVoyageNo</td>
            <td class="text-center">
                <div class="btn-group btn-group-sm">
                    <button type="button"
                            class="btn btn-outline-warning"
                            title="VoyagePortEvents"
                            hx-get="@Url.Action("LoadVoyagePortEvents", "Voyage")"
                            hx-target="#detail-detail-container"
                            hx-swap="innerHTML"
                            hx-vals='js:{ voyagePortId: "@vm.Id"}'
                            hx-on:htmx:before-request="
                                                                   console.log('beforeRequest');
                                                                   document.getElementById('selected-detail-id').value='@vm.Id'
                                                                                ">
                        <i class="bi bi-card-list"></i>
                    </button>
                    <button type="button"
                            class="btn btn-outline-primary"
                            title="Edit"
                            hx-get="@Url.Action("EditVoyagePort", "Voyage", new { id = vm.Id })"
                            hx-target="#app-modal-content"
                            hx-swap="innerHTML">
                        <i class="bi bi-pencil"></i>
                    </button>


                    <button type="button"
                            class="btn btn-outline-danger"
                            title="Delete"
                            hx-get="@Url.Action("DeleteVoyagePort", "Voyage", new { id = vm.Id })"
                            hx-target="#app-modal-content"
                            hx-swap="innerHTML">
                        <i class="bi bi-trash"></i>
                    </button>


                </div>
            </td>
        </tr>
    }

}






