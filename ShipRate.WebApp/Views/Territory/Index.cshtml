@section Scripts {
    <script>
        // ═══════════ State ═══════════
        let currentTerritoryId = null;
        let currentTerritoryName = null;

        // ═══════════ Select Territory ═══════════
        function selectTerritory(id, name) {
            currentTerritoryId = id;
            currentTerritoryName = name;

            // هایلایت ردیف انتخابی
            document.querySelectorAll('#territoryGridContainer tr').forEach(tr => {
                tr.classList.remove('table-primary');
            });
            const row = document.getElementById('territory-row-' + id);
            if (row) row.classList.add('table-primary');

            // به‌روزرسانی عنوان و دکمه Add City
            document.getElementById('selectedTerritoryLabel').textContent = name;
            const btnAdd = document.getElementById('btnAddCity');
            btnAdd.style.display = '';
            btnAdd.setAttribute('hx-get',
                '@Url.Action("AddCity", "Territory")?territoryId=' + id + '&territoryName=' + encodeURIComponent(name));
            htmx.process(btnAdd);

            // بارگذاری شهرها
            loadCities(1);
        }

        // ═══════════ Load Cities ═══════════
        function loadCities(page) {
            if (!currentTerritoryId) return;
            const url = '@Url.Action("CitiesGrid", "Territory")'
                + '?territoryId=' + currentTerritoryId
                + '&cityPage=' + page
                + '&cityPageSize=10';

            htmx.ajax('GET', url, { target: '#citiesGridContainer', swap: 'innerHTML' });
        }

        // ═══════════ Territory Pagination ═══════════
        function goToTerritoryPage(page) {
            document.getElementById('territoryPage').value = page;
            htmx.trigger('#searchForm', 'submit');
        }

        // ═══════════ City Pagination ═══════════
        function goToCityPage(page) {
            loadCities(page);
        }

        // ═══════════ Clear Search ═══════════
        function clearSearch() {
            document.getElementById('searchTerritoryName').value = '';
            document.getElementById('searchCityName').value = '';
            document.getElementById('territoryPage').value = '1';
            htmx.trigger('#searchForm', 'submit');
        }

        // ═══════════ HTMX Events ═══════════

        // باز کردن Modal وقتی محتوا لود شد
        document.body.addEventListener('htmx:afterSwap', function (e) {
            if (e.detail.target.closest('#appModal')) {
                var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('appModal'));
                modal.show();
            }
        });

        // بستن Modal از سرور
        document.body.addEventListener('closeModal', function () {
            var modal = bootstrap.Modal.getInstance(document.getElementById('appModal'));
            if (modal) modal.hide();
        });

        // Toast موفقیت
        document.body.addEventListener('showToast', function () {
            showAppToast('Operation completed successfully.', 'success');
        });

        // Toast خطا
        document.body.addEventListener('showToastError', function (e) {
            showAppToast(e.detail.value || 'An error occurred.', 'danger');
        });

        // وقتی شهرها تغییر کرد، دوباره لود کن
        document.body.addEventListener('citiesChanged', function () {
            if (currentTerritoryId) {
                loadCities(1);
            }
        });

        // ═══════════ Toast Function ═══════════
        function showAppToast(message, type) {
            const toast = document.getElementById('appToast');
            toast.className = 'toast align-items-center text-bg-' + type + ' border-0';
            toast.querySelector('.toast-body').textContent = message;
            var bsToast = bootstrap.Toast.getOrCreateInstance(toast, { delay: 3000 });
            bsToast.show();
        }
    </script>
} *@
