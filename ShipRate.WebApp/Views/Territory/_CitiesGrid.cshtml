@using ShipRate.WebApp.Controllers
@using ShipRate.WebApp.ViewModels
@using ShipRate.WebApp.ViewModels.TerritoryVms
@model DetailGridViewModel

<input type="hidden" name="territoryId" value="@Model.MasterId" id="selected-master-id" />
@{
    int counter = 0;
}
@if (!Model.Data.Any())
{
    <tr>
        <td colspan="6" class="text-center py-5 text-muted">
            <i class="bi bi-inbox display-4 d-block mb-2"></i>
            No Records found.
        </td>
    </tr>
}

else
{

@foreach (var item in Model.Data)
{
    counter++;
    var vm = (TerritoryCityRowViewModel)item;
    <tr>
        <td>@counter</td>
        <td>@vm.LocationName</td>
       
        <td class="text-center">
            <div class="btn-group btn-group-sm">

                    <button type="button"
                            class="btn btn-outline-danger"
                            title="Delete"
                            hx-get="@Url.Action("DeleteCity", "Territory", new { id = vm.Id })"
                            hx-target="#app-modal-content"
                            hx-swap="innerHTML">
                        <i class="bi bi-trash"></i>
                    </button>

                
            </div>
        </td>
    </tr>
}

}

