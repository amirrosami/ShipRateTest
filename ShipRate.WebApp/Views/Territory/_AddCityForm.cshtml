                       id="clientSearch"
                       name="CityName"
                       class="form-control"
                       placeholder="Type to search…"
                       value="@Model.CityName"
                       autocomplete="off" />
                <input type="hidden" name="CityId" id="clientId" value="@Model.CityId" />
                <div id="clientResults"
                     class="list-group position-absolute w-100 shadow"
                     style="z-index:9999; max-height:200px; overflow-y:auto; display:none;">
                </div>
            </div>
        </div>
        *@

    </div>


    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="AppModal.close()">Cancel</button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>

            @if (isCreateMode)
            {
                <span>Save</span>
            }
            else
            {
                <span>Update</span>
            }
        </button>
    </div>
</form>

