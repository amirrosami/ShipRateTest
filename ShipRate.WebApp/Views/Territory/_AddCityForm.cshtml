@using ShipRate.WebApp.ViewModels.Location
@using ShipRate.WebApp.ViewModels.TerritoryVms
@model TerritoryCityCreateEditDto
@{
    string CreateEdit = ViewBag.CreateEdit;
    bool isCreateMode = false;
    if (CreateEdit == "Create") isCreateMode = true;
}

<form hx-post="@Url.Action(isCreateMode?"AddCity":"EditCity", "Territory")"
      hx-target="#app-modal-content"
      hx-swap="innerHTML">

    <div class="modal-header form-caption-bg  text-white">
        <input type="hidden" asp-for="TerritoryId" />

        @if (isCreateMode)
        {
            <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Add City for Territory Name : @ViewBag.TerritoryName</h5>
            
        }
        else
        {
            <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Edit City</h5>
            <input type="hidden" asp-for="Id" />
        }


        <button type="button"
                class="btn-close"
                onclick="AppModal.close()">
        </button>
    </div>


    <div class="modal-body row">

        @await Html.PartialAsync("_ModelStateError")


        <!-- Example: City Search -->
        <autocomplete-search label="City"
                             name="CityName"
                             hidden-name="CityId"
                             value="@Model.CityName"
                             hidden-value="@Model.CityId"
                             api-url="/Territory/SearchLocations">
        </autocomplete-search>

        <!-- Example: Customer Search (Same page, works automatically!) -->
        @*
        <autocomplete-search label="Customer"
                             name="CustomerName"
                             hidden-name="CustomerId"
                             value="@Model.CustomerName"
                             hidden-value="@Model.CustomerId"
                             api-url="/Customers/SearchCustomers">
        </autocomplete-search>
        *@

        @*
        <div class="mb-1 col-md-6">
            <label class="form-label">
                City  <span class="text-danger">*</span>
            </label>
            <div class="position-relative">
