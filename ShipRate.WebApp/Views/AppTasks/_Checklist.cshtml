@using ShipRate.Application.DTOs.AppTasks
@model AppTaskDetailsDto

@if (Model.CheckLists == null || !Model.CheckLists.Any())
{
    <div class="text-muted">No checklist item.</div>
}
else
{
    <div class="list-group">
        @foreach (var item in Model.CheckLists)
        {
            <div class="list-group-item">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="fw-semibold">
                            @item.CheckListItemTitle
                            @if (item.IsMandatory)
                            {
                                <span class="badge bg-danger ms-1">Mandatory</span>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <div class="small text-muted">@item.Description</div>
                        }

                        @if (item.IsChecked && item.CheckedDate.HasValue)
                        {
                            <div class="small text-success mt-1">
                                Checked by @(item.CheckedByUserName ?? "-")
                                at @item.CheckedDate.Value.ToString("yyyy/MM/dd HH:mm")
                            </div>
                        }
                    </div>

                    <div>
                        @if (!Model.CompletedDate.HasValue)
                        {
                            <form hx-post="@Url.Action("ToggleChecklist", "AppTasks")"
                                  hx-target="#appTaskDrawerContent"
                                  hx-swap="innerHTML" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="AppTaskId" value="@Model.Id" />
                                <input type="hidden" name="CheckListId" value="@item.Id" />
                                <input type="hidden" name="IsChecked" value="@((!item.IsChecked).ToString().ToLower())" />

                                @if (item.IsChecked)
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-warning">Uncheck</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-success">Check</button>
                                }
                            </form>
                        }
                        else
                        {
                            @if (item.IsChecked)
                            {
                                <span class="badge bg-success">Done</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Open</span>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
