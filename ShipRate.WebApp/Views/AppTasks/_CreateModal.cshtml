@using ShipRate.Application.DTOs.AppTasks
@model CreateAppTaskViewModel

<form hx-post="@Url.Action("Create", "AppTasks")"
      hx-target="#appTaskModalContent"
      hx-swap="innerHTML">

    @Html.AntiForgeryToken()

    <div class="modal-header">
        <h5 class="modal-title">Create Task</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">

@*         <input type="hidden" asp-for="Input.TaskId" /> *@
        <input type="hidden" asp-for="Input.EntityTypeId" />
        <input type="hidden" asp-for="Input.RelatedEntityId" />
        <input type="hidden" asp-for="Input.OwnerUserId" />


        <div class="mb-3">
            <label asp-for="Input.TaskId" class="form-label">Task Template</label>
            <select asp-for="Input.TaskId"
                    asp-items="Model.Tasks"
                    class="form-select"
                    id="baseTaskSelect">
                <option value="">Custom task...</option>
            </select>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Title" class="form-label">Title</label>
            <input asp-for="Input.Title" class="form-control"  id="taskTitleInput" />
            <span asp-validation-for="Input.Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.TaskDesciption" class="form-label">Description</label>
            <textarea asp-for="Input.TaskDesciption" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Input.TaskDesciption" class="text-danger"></span>
        </div>

        <div class="row g-2">
            <div class="col-md-4">
                <label asp-for="Input.DueDate" class="form-label">Due Date</label>
                <input asp-for="Input.DueDate" type="date" class="form-control" />
                <span asp-validation-for="Input.DueDate" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Input.PriorityId" class="form-label">Priority</label>
                <select asp-for="Input.PriorityId"
                        asp-items="Model.Priorities"
                        class="form-select">
                    <option value="">Select...</option>
                </select>
            </div>

            <div class="col-md-4">
                <label asp-for="Input.SourceTypeId" class="form-label">Source</label>
                <select asp-for="Input.SourceTypeId"
                        asp-items="Model.SourceTypes"
                        class="form-select">
                    <option value="">Select...</option>
                </select>
            </div>
        </div>

        <hr />

        <div class="mb-3">
            <label class="form-label">Assign To</label>
            <select asp-for="Input.AssignedToUserIds"
                    asp-items="Model.Users"
                    class="form-select"
                    multiple>
            </select>
            <small class="text-muted">First selected user will be current assignee.</small>
        </div>

    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            Cancel
        </button>
        <button type="submit" class="btn btn-primary">
            Save
        </button>
    </div>


    <script>
        (function () {
            const taskSelect = document.getElementById('baseTaskSelect');
            const titleInput = document.getElementById('taskTitleInput');

            if (!taskSelect || !titleInput) {
                return;
            }

            taskSelect.addEventListener('change', function () {
                const selectedOption = taskSelect.options[taskSelect.selectedIndex];

                if (!taskSelect.value) {
                    return;
                }
                titleInput.value = selectedOption.text;
            });
        })();
    </script>
</form>
