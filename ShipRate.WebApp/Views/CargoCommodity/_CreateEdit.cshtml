@using ShipRate.Application.DTOs.Cargo
@model CargoCommodityDto
@{
    string CreateEdit = ViewBag.CreateEdit;
    bool isCreateMode = false;
    if (CreateEdit == "Create") isCreateMode = true;
}

<form hx-post="@Url.Action(isCreateMode?"Create":"Edit", "CargoCommodity")"
      hx-target="#app-modal-content"
      hx-swap="innerHTML">

    <div class="modal-header form-caption-bg  text-white">
        @if (isCreateMode)
        {
            <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Add Cargo Commodity</h5>
        }
        else
        {
            <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Edit Cargo Commodity</h5>
            <input type="hidden" asp-for="Id" />
        }


        <button type="button"
                class="btn-close"
                onclick="AppModal.close()">
        </button>
    </div>

    
    <div class="modal-body row">
       
    @Html.AntiForgeryToken()
        @if (!ViewData.ModelState.IsValid)
        {
            var allErrors = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).ToList();
            if (allErrors.Any())
            {
                <div class="alert alert-danger py-2 mb-1">
                    <ul class="mb-0 small">
                        @foreach (var err in allErrors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }
        }
        

        <div class="mb-1 col-md-6">
            <label class="form-label fw-medium">
                Cargo Commodity Name  <span class="text-danger">*</span>
            </label>
            <input type="text"
                   name="CargoCommodityName"
                   value="@Model.CargoCommodityName"
                   class="form-control @(ViewData.ModelState.ContainsKey("CargoCommodityName") && ViewData.ModelState["CargoCommodityName"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                     />
        </div>

       
        <div class="mb-1 col-md-6">
            <label class="form-label fw-medium">Cargo Commodity Local Name</label>
            <input type="text"
                   name="CargoCommodityLocalName"
                   value="@Model.CargoCommodityLocalName"
                   class="form-control @(ViewData.ModelState.ContainsKey("CargoCommodityLocalName") && ViewData.ModelState["CargoCommodityLocalName"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                    />
        </div>

     </div>
    

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="AppModal.close()" >Cancel</button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>

            @if (isCreateMode)
            {
                <span>Save</span>
            }
            else
            {
                <span>Update</span>
            }
        </button>
    </div>
</form>
