@using ShipRate.Application.DTOs.Base_Info
@model CarrierDto

<form hx-post="@Url.Action("SetCarrierInfo", "Persons")"
      hx-target="#modal-content2"
      hx-swap="innerHTML">

    <div class="modal-header bg-primary text-white">
        <input type="hidden" asp-for="PersonId" />
        <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Define Carrier Info</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
    </div>




    <div class="modal-body row">
        @Html.AntiForgeryToken()
        @if (!ViewData.ModelState.IsValid)
        {
            var allErrors = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).ToList();
            if (allErrors.Any())
            {
                <div class="alert alert-danger py-2 mb-3">
                    <ul class="mb-0 small">
                        @foreach (var err in allErrors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }
        }

        <!-- Carrier Type -->
        <div class="mb-3 col-md-6">
            <label class="form-label fw-medium">
                Carrier Type <span class="text-danger">*</span>
            </label>
            <div class="d-flex align-items-center gap-2">
                <select asp-for="CarrierTypeId"
                        asp-items="@ViewBag.CarrierTypes"
                        class="form-select">
                    <option value="">-- Select --</option>
                </select>
                <span asp-validation-for="CarrierTypeId" class="text-danger"></span>
            </div>
        </div>





        <!-- Full Name -->
        <div class="mb-3 col-md-6">
            <label class="form-label fw-medium">
                Carrier Code <span class="text-danger">*</span>
            </label>
            <input type="text"
                   name="CarrierCode"
                   value="@Model.CarrierCode"
                   class="form-control @(ViewData.ModelState.ContainsKey("CarrierCode") && ViewData.ModelState["CarrierCode"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                   maxlength="20" required />
        </div>
        <div class="mb-3 col-md-6">
            <label class="form-label fw-medium">
                AWB Prefix 
            </label>
            <input type="text"
                   name="AWBPrefix"
                   value="@Model.AWBPrefix"
                   class="form-control @(ViewData.ModelState.ContainsKey("AWBPrefix") && ViewData.ModelState["AWBPrefix"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                   maxlength="20" required />
        </div>

        <div class="mb-3 col-md-6">
            <label class="form-label fw-medium">
                Booking Email <span class="text-danger">*</span>
            </label>
            <input type="text"
                   name="BookingEmail"
                   value="@Model.BookingEmail"
                   class="form-control @(ViewData.ModelState.ContainsKey("BookingEmail") && ViewData.ModelState["BookingEmail"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                   maxlength="50" required />
        </div>

        <div class="mb-3 col-md-6">
            <label class="form-label fw-medium">
                Operating Region <span class="text-danger">*</span>
            </label>
            <input type="text"
                   name="OperatingRegion"
                   value="@Model.OperatingRegion"
                   class="form-control @(ViewData.ModelState.ContainsKey("OperatingRegion") && ViewData.ModelState["OperatingRegion"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                   maxlength="50" required />
        </div>

        <div class="mb-3 col-md-6">
            <label class="form-label fw-medium">
                Tracking Url <span class="text-danger">*</span>
            </label>
            <input type="text"
                   name="TrackingUrl"
                   value="@Model.TrackingUrl"
                   class="form-control @(ViewData.ModelState.ContainsKey("TrackingUrl") && ViewData.ModelState["TrackingUrl"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                   maxlength="100" required />
        </div>



    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>
                <span>Save</span>
        </button>
    </div>
</form>
