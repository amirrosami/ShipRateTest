@using ShipRate.Application.DTOs.Base_Info
@model CustomerDto

<form hx-post="@Url.Action("SetCarrierInfo", "Persons")"
      hx-target="#modal-content2"
      hx-swap="innerHTML">

    <div class="modal-header bg-primary text-white">
        <input type="hidden" asp-for="PersonId" />
        <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Define Customer Info</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
    </div>




    <div class="modal-body row">
        @Html.AntiForgeryToken()
        @if (!ViewData.ModelState.IsValid)
        {
            var allErrors = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).ToList();
            if (allErrors.Any())
            {
                <div class="alert alert-danger py-2 mb-3">
                    <ul class="mb-0 small">
                        @foreach (var err in allErrors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }
        }

        <!-- Industry Id -->
        <div class="mb-3 col-md-6">
            <label class="form-label fw-medium">
                Carrier Type <span class="text-danger">*</span>
            </label>
            <div class="d-flex align-items-center gap-2">
                <select asp-for="IndustryId"
                        asp-items="@ViewBag.Industries"
                        class="form-select">
                    <option value="">-- Select --</option>
                </select>
                <span asp-validation-for="IndustryId" class="text-danger"></span>
            </div>
        </div>

        <!-- Sales Person Id -->
        <div class="mb-3 col-md-6">
            <label class="form-label fw-medium">
                Sales Person <span class="text-danger">*</span>
            </label>
            <div class="d-flex align-items-center gap-2">
                <select asp-for="SalePersonId"
                        asp-items="@ViewBag.SalesPersons"
                        class="form-select">
                    <option value="">-- Select --</option>
                </select>
                <span asp-validation-for="SalePersonId" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>
                <span>Save</span>
        </button>
    </div>
</form>