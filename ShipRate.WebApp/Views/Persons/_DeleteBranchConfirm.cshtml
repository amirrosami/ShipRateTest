@using ShipRate.Application.DTOs.Base_Info
@model BranchDto


<div>
    <div class="modal-header bg-danger text-white">
        <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i>Delete Branch</h5>
        <button type="button" class="btn-close btn-close-white" onclick="AppModalSecond.close()"></button>
    </div>

    <div class="modal-body">
        <p class="mb-3">Are you sure you want to delete this Record?</p>
        <div class="card bg-light">
            <div class="card-body py-2">
                <div class="row mt-1">
                    <div class="col-8"> Name : @Model.BranchName</div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-footer">
        @Html.AntiForgeryToken()
        <button type="button" class="btn btn-secondary" onclick="AppModalSecond.close()">Cancel</button>
        <button type="button"
                class="btn btn-danger"
                hx-post="@Url.Action("DeleteBranchConfirmed", "Persons", new { id = Model.Id })"
                hx-swap="none"
                hx-include="[name='__RequestVerificationToken']">
            <i class="bi bi-trash me-1"></i> Yes, Delete
        </button>
    </div>
</div>
