@using ShipRate.Application.DTOs.Base_Info
@using ShipRate.WebApp.ViewModels
@using ShipRate.WebApp.ViewModels.Location
@model PersonDto
@{
    ViewData["Title"] = $"Person — {Model.PersonName}";

    // ─── تعریف متمرکز نقش‌ها ───
    var roles = new[]
    {
        new { Name = "Carrier",        IsActive = Model.IsCarrier,         InfoAction = "SetCarrierInfo",   SetAction = "SetCarrierInfo",   Icon = "bi-truck"         },
        new { Name = "Customer",       IsActive = Model.IsCustomer,        InfoAction = "CustomerInfo",     SetAction = "SetCustomerInfo",  Icon = "bi-person-badge"  },
        new { Name = "Agent",          IsActive = Model.IsAgent,           InfoAction = "SetAgentInfo",        SetAction = "SetAgentInfo",     Icon = "bi-briefcase"     },
        new { Name = "Courier Company",IsActive = Model.IsCourierCompany,  InfoAction = "CourierInfo",      SetAction = "SetCourierInfo",   Icon = "bi-box-seam"      },
        new { Name = "Driver",         IsActive = Model.IsDriver,          InfoAction = "SetDriverInfo",       SetAction = "SetDriverInfo",    Icon = "bi-car-front"     },
        new { Name = "GPS Provider",   IsActive = Model.IsGPSProvider,     InfoAction = "GPSProviderInfo",  SetAction = "SetGPSProviderInfo", Icon = "bi-geo-alt"    },
    };
}

@await Html.PartialAsync("_LocationStyles")

<style>
    /* ─── Role Chips ─── */
    .roles-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .role-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.6rem 0.4rem 0.75rem;
        border-radius: 50px;
        font-size: 0.82rem;
        font-weight: 500;
        transition: all 0.2s ease;
        border: 1.5px solid transparent;
    }

        .role-chip:hover {
            transform: translateY(-1px);
            box-shadow: 0 3px 8px rgba(0, 0, 0, 0.1);
        }

        .role-chip.role-active {
            background: linear-gradient(135deg, #e8f5e9, #f1f8e9);
            border-color: #66bb6a;
            color: #2e7d32;
        }

        .role-chip.role-inactive {
            background: linear-gradient(135deg, #fafafa, #f5f5f5);
            border-color: #e0e0e0;
            color: #9e9e9e;
        }

    .role-chip-icon {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
    }

    .role-active .role-chip-icon {
        background: #66bb6a;
        color: #fff;
    }

    .role-inactive .role-chip-icon {
        background: #e0e0e0;
        color: #999;
    }

    .role-chip-name {
        font-weight: 600;
        white-space: nowrap;
    }

    .role-chip-btn {
        padding: 0.15rem 0.5rem;
        border-radius: 50px;
        font-size: 0.72rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: all 0.15s ease;
        text-decoration: none;
        line-height: 1.4;
    }

    .role-chip-btn-info {
        background: #e3f2fd;
        color: #1565c0;
    }

        .role-chip-btn-info:hover {
            background: #1565c0;
            color: #fff;
        }

    .role-chip-btn-set {
        background: #fff3e0;
        color: #e65100;
    }

        .role-chip-btn-set:hover {
            background: #e65100;
            color: #fff;
        }

    /* ─── Contact Button Position ─── */
    .contact-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    /* ─── Detail value empty state ─── */
    .loc-detail-value.empty {
        color: var(--loc-gray-400, #bbb);
        font-style: italic;
    }
</style>

<div class="loc-page">

    <!-- ═══════════════════════════════════════════════ -->
    <!-- ═══ Header                                 ═══ -->
    <!-- ═══════════════════════════════════════════════ -->
    <div class="loc-header">
        <div class="loc-header-left">
            <div class="loc-header-icon">👁</div>
            <div>
                <h1>Person Details</h1>
                <p>Viewing <strong>@Model.PersonName</strong> (@Model.PersonPersianName)</p>
            </div>
        </div>
        <div class="loc-header-actions">
            @* <button type="button"
                    class="btn btn-outline-primary"
                    title="Edit"
                    hx-get="@Url.Action("Edit", "Persons", new { id = Model.Id })"
                    hx-target="#modal-content"
                    hx-swap="innerHTML"
                    onclick="showModal()">
                <i class="bi bi-pencil me-1"></i>Edit
            </button> *@
            <button type="button"
                    class="btn btn-outline-primary"
                    title="Edit"
                    hx-get="@Url.Action("Edit", "Persons", new { id = Model.Id })"
                    hx-target="#app-modal-content"
                    hx-swap="innerHTML">
                <i class="bi bi-pencil"></i>

            </button>
            <button type="button"
                    class="btn btn-outline-danger"
                    title="Delete"
                    hx-get="@Url.Action("Delete", "Persons", new { id = Model.Id })"
                    hx-target="#app-modal-content"
                    hx-swap="innerHTML">
                <i class="bi bi-trash"></i>
            </button>
            @* <button type="button"
                    class="btn btn-outline-danger"
                    title="Delete"
                    hx-get="@Url.Action("Delete", "Persons", new { id = Model.Id })"
                    hx-target="#modal-content"
                    hx-swap="innerHTML"
                    onclick="showModal()">
                <i class="bi bi-trash me-1"></i>Delete
            </button> *@

            <button type="button"
                    class="btn btn-secondary"
                    onclick="AppModal.close()">
                ←
            </button>
        </div>
    </div>

    <!-- ═══ Status Banner ═══ -->
    @if (!Model.IsActive)
    {
        <div class="loc-alert loc-alert-warning">
            ⚠️ This person is currently <strong>inactive</strong>.
        </div>
    }

    <!-- ═══════════════════════════════════════════════ -->
    <!-- ═══ Person Images (English & Persian)       ═══ -->
    <!-- ═══════════════════════════════════════════════ -->
    <div class="card mb-3">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-images me-2"></i>Person Logos</h5>
        </div>

        <div class="card-body">
            <div class="row g-3">
                <div class="col-12 col-lg-6" id="latinPictureSection">
                    <h6 class="mb-2">English / Latin Logo</h6>
                    @await Html.PartialAsync("_PersonPicture", new PersonPictureViewModel
                    {
                        PersonId = Model.Id,
                        PictureType = PersonPictureType.Latin,
                        HasPicture = Model.HasLatinLogo
                    })
                </div>

                <div class="col-12 col-lg-6" id="localPictureSection">
                    <h6 class="mb-2">Persian / Local Logo</h6>
                    @await Html.PartialAsync("_PersonPicture", new PersonPictureViewModel
                    {
                        PersonId = Model.Id,
                        PictureType = PersonPictureType.Local,
                        HasPicture = Model.HasLocalLogo
                    })
                </div>
            </div>
        </div>
    </div>


    <!-- ═══════════════════════════════════════════════ -->
    <!-- ═══ Basic Information                      ═══ -->
    <!-- ═══════════════════════════════════════════════ -->
    <div class="loc-card mb-3">
        <div class="loc-card-header">
            <h2>🏷 Basic Information</h2>
            @if (Model.IsActive)
            {
                <span class="loc-badge loc-badge-success">
                    <span class="loc-badge-dot"></span> Active
                </span>
            }
            else
            {
                <span class="loc-badge loc-badge-danger">
                    <span class="loc-badge-dot"></span> Inactive
                </span>
            }
        </div>
        <div class="loc-card-body">
            <div class="loc-detail-grid">


                <div class="loc-detail-item">
                    <span class="loc-detail-label">Person Name</span>
                    <span class="loc-detail-value">@Model.PersonName</span>
                </div>

                <div class="loc-detail-item">
                    <span class="loc-detail-label">Person Local Name</span>
                    <span class="loc-detail-value @(string.IsNullOrEmpty(Model.PersonPersianName) ? "empty" : "")">
                        @(Model.PersonPersianName ?? "Not set")
                    </span>
                </div>

                <div class="loc-detail-item">
                    <span class="loc-detail-label">First Name</span>
                    <span class="loc-detail-value">@Model.FirstName</span>
                </div>

                <div class="loc-detail-item">
                    <span class="loc-detail-label">Last Name</span>
                    <span class="loc-detail-value">@Model.LastName</span>
                </div>

                <div class="loc-detail-item">
                    <span class="loc-detail-label">Personality Type</span>
                    <span class="loc-detail-value">
                        <span class="loc-badge loc-badge-primary">
                            @(Model.PersonalityTypeName ?? "—")
                        </span>
                    </span>
                </div>

                <div class="loc-detail-item">
                    <span class="loc-detail-label">Country</span>
                    <span class="loc-detail-value @(string.IsNullOrEmpty(Model.CountryName) ? "empty" : "")">
                        @(Model.CountryName ?? "Not set")
                    </span>
                </div>

            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- ═══ Contact Information                    ═══ -->
    <!-- ═══════════════════════════════════════════════ -->
    <div class="loc-card mb-3">
        <div class="loc-card-header contact-header">
            <h2>📞 Contact Information</h2>
            <button type="button"
                    class="btn btn-sm btn-outline-success"
                    title="Add New Contact"
                    hx-get="@Url.Action("CreateContact", "Persons", new { personId = Model.Id })"
                    hx-target="#app-modal-content-second"
                    hx-swap="innerHTML">
                <i class="bi bi-plus-circle me-1"></i>Add Contact
            </button>
        </div>
        <div class="loc-card-body">
            <div class="loc-detail-grid">

                <div class="loc-detail-item">
                    <span class="loc-detail-label">Email Address</span>
                    <span class="loc-detail-value @(Model.EmailAddress == null ? "empty" : "")">
                        @(Model.EmailAddress ?? "Not set")
                    </span>
                </div>

                <div class="loc-detail-item">
                    <span class="loc-detail-label">Mobile</span>
                    <span class="loc-detail-value @(Model.Mobile == null ? "empty" : "")">
                        @(Model.Mobile ?? "Not set")
                    </span>
                </div>

                <div class="loc-detail-item">
                    <span class="loc-detail-label">Telephone</span>
                    <span class="loc-detail-value @(Model.Phone == null ? "empty" : "")">
                        @(Model.Phone ?? "Not set")
                    </span>
                </div>

                <div class="loc-detail-item">
                    <span class="loc-detail-label">Address</span>
                    <span class="loc-detail-value @(Model.Address == null ? "empty" : "")">
                        @(Model.Address ?? "Not set")
                    </span>
                </div>

            </div>

            <!-- Contacts List -->
            <div class="mt-3"
                 hx-get="@Url.Action("ContactList", "Persons", new { personId = Model.Id })"
                 hx-trigger="load, GridChangedOnAppModal from:body"
                 hx-swap="innerHTML">
            </div>

        </div>
    </div>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- ═══ Extra Information                       ═══ -->
    <!-- ═══════════════════════════════════════════════ -->
    <div class="loc-card mb-3">
        <div class="loc-card-header contact-header">
            <h2>📞 Extra Information</h2>
            <button type="button"
                    class="btn btn-sm btn-outline-success"
                    title="Add New Information"
                    hx-get="@Url.Action("CreateExtraInfo", "Persons", new { personId = Model.Id })"
                    hx-target="#app-modal-content-second"
                    hx-swap="innerHTML">
                <i class="bi bi-plus-circle me-1"></i>Add Information
            </button>
        </div>
        <div class="loc-card-body">
            <div class="mt-3"
                 hx-get="@Url.Action("ExtraInfoList", "Persons", new { personId = Model.Id })"
                 hx-trigger="load, GridChangedOnAppModal from:body"
                 hx-swap="innerHTML">
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- ═══ Bank Accounts                           ═══ -->
    <!-- ═══════════════════════════════════════════════ -->
    <div class="loc-card mb-3">
        <div class="loc-card-header contact-header">
            <h2>$ Bank Accounts</h2>
            <button type="button"
                    class="btn btn-sm btn-outline-success"
                    title="Add New Bank Account"
                    hx-get="@Url.Action("CreateBankAccount", "Persons", new { personId = Model.Id })"
                    hx-target="#app-modal-content-second"
                    hx-swap="innerHTML">
                <i class="bi bi-plus-circle me-1"></i>Add Bank Account
            </button>
        </div>
        <div class="loc-card-body">

            <div class="mt-3"
                 hx-get="@Url.Action("BankAccountList", "Persons", new { personId = Model.Id })"
                 hx-trigger="load, GridChangedOnAppModal from:body"
                 hx-swap="innerHTML">
            </div>

        </div>
    </div>



    <!-- ═══════════════════════════════════════════════ -->
    <!-- ═══ Branches                                ═══ -->
    <!-- ═══════════════════════════════════════════════ -->
    <div class="loc-card mb-3">
        <div class="loc-card-header contact-header">
            <h2>Branches</h2>
            <button type="button"
                    class="btn btn-sm btn-outline-success"
                    title="Add New Branch"
                    hx-get="@Url.Action("CreateBranch", "Persons", new { personId = Model.Id })"
                    hx-target="#app-modal-content-second"
                    hx-swap="innerHTML">
                <i class="bi bi-plus-circle me-1"></i>Add Branch
            </button>
        </div>
        <div class="loc-card-body">
            <div class="mt-3"
                 hx-get="@Url.Action("BranchList", "Persons", new { personId = Model.Id })"
                 hx-trigger="load, GridChangedOnAppModal from:body"
                 hx-swap="innerHTML">
            </div>

        </div>
    </div>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- ═══ Roles (Chip/Tag Compact)               ═══ -->
    <!-- ═══════════════════════════════════════════════ -->
    <div class="loc-card mb-3" id="rolesSection">
        <div class="loc-card-header">
            <h2>🎭 Roles & Services</h2>

        </div>
        <div class="loc-card-body">
            <div class="roles-grid">
                @{
                    var specialRoles = new List<string>();
                    if (Model.Agent != null)
                    {
                        specialRoles.Add("Agent");
                    }
                    if (Model.Carrier != null)
                    {
                        specialRoles.Add("Carrier");
                    }
                    if (Model.CourierCompany != null)
                    {
                        specialRoles.Add("CourierCompany");
                    }
                    if (Model.GPSProviderDto != null)
                    {
                        specialRoles.Add("GPSProvider");
                    }
                    if (Model.Driver != null)
                    {
                        specialRoles.Add("Driver");
                    }
                }
                @foreach (var item in specialRoles)
                {
                    <div class="role-chip role-active">
                        <!-- Icon -->
                        <span class="role-chip-icon">
                            <i class="bi bi-person-badge"></i>
                        </span>

                        <!-- Name -->
                        <span class="role-chip-name">@item</span>

                        <i class="bi bi-check-circle-fill text-success"></i>
                    </div>
                }
                @foreach (var role in Model.RoleTypes)
                {
                    <div class="role-chip role-active">
                        <!-- Icon -->
                        <span class="role-chip-icon">
                            <i class="bi bi-person-badge"></i>
                        </span>

                        <!-- Name -->
                        <span class="role-chip-name">@role.RoleTypeName</span>

                        <i class="bi bi-check-circle-fill text-success"></i>
                    </div>
                }
            </div>

            <div id="roleInfoContainer" class="mt-3"></div>
        </div>
    </div>

    <div class="loc-card">
        <div class="loc-card-header">
            <h2>🕐 Audit Information</h2>
        </div>
        <div class="loc-card-body">
            <div class="loc-detail-grid">

                <div class="loc-detail-item">
                    <span class="loc-detail-label">Created Date</span>
                    <span class="loc-detail-value">
                        @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")
                    </span>
                </div>

                <div class="loc-detail-item">
                    <span class="loc-detail-label">Last Modified Date</span>
                    <span class="loc-detail-value @(Model.UpdatedAt == null ? "empty" : "")">
                        @(Model.UpdatedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "Never modified")
                    </span>
                </div>

            </div>
        </div>
    </div>

</div>

@* <!-- ═══════════════════════════════════════════════════ -->
<!-- ═══ Scripts                                    ═══ -->
<!-- ═══════════════════════════════════════════════════ -->
<script>
    (function () {
        // ─── Picture Upload Handler ───
        function setupPictureUpload() {
            const container = document.getElementById('pictureContainer');
            const fileInput = document.getElementById('fileInput');
            if (!container || !fileInput) return;

            container.onclick = () => fileInput.click();

            fileInput.onchange = async (e) => {
                const file = e.target.files[0];
                if (!file) return;

                const personId = fileInput.dataset.personId;
                const formData = new FormData();
                formData.append('file', file);

                try {
                    const response = await fetch(
                        `/Persons/UploadPicture?personId=${personId}`,
                        { method: 'POST', body: formData }
                    );

                    if (response.ok) {
                        htmx.ajax('GET',
                            `/Persons/GetPicturePartial?personId=${personId}`,
                            { target: '#pictureSection', swap: 'innerHTML' }
                        );
                    }
                } catch (err) {
                    console.error('Upload failed:', err);
                }
            };
        }

        // Initial setup
        document.addEventListener('DOMContentLoaded', setupPictureUpload);

        // Re-setup after HTMX swaps picture section
        document.body.addEventListener('htmx:afterSwap', function (evt) {
            if (evt.detail.target.id === 'pictureSection') {
                setupPictureUpload();
            }
        });
    })();
</script>
 *@