@using ShipRate.Application.DTOs.Base_Info
@model BranchDto
@{
    string CreateEditBranch = ViewBag.CreateEditBranch;
    bool isCreateMode = false;
    if (CreateEditBranch == "Create") isCreateMode = true;
}
<form hx-post="@Url.Action(isCreateMode?"CreateBranch":"EditBranch", "Persons")"
      hx-target="#app-modal-content-second"
      hx-swap="innerHTML">

    <div class="modal-header bg-primary text-white">
        <input type="hidden" asp-for="PersonId" />
        @if (isCreateMode)
        {
            <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Add Branch</h5>
        }
        else
        {
            <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Edit Branch</h5>
            <input type="hidden" asp-for="Id" />
        }
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
    </div>




    <div class="modal-body row">
        @Html.AntiForgeryToken()
        @if (!ViewData.ModelState.IsValid)
        {
            var allErrors = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).ToList();
            if (allErrors.Any())
            {
                <div class="alert alert-danger py-2 mb-3">
                    <ul class="mb-0 small">
                        @foreach (var err in allErrors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }
        }

        <div class="mb-3 col-md-6">
            <label class="form-label fw-medium">
                Branch Code<span class="text-danger">*</span>
            </label>
            <input type="text"
                   name="BranchCode"
                   value="@Model.BranchCode"
                   class="form-control @(ViewData.ModelState.ContainsKey("BranchCode") && ViewData.ModelState["BranchCode"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                   maxlength="100" required />
        </div>

        <div class="mb-3 col-md-6">
            <label class="form-label fw-medium">
                Branch Name<span class="text-danger">*</span>
            </label>
            <input type="text"
                   name="BranchName"
                   value="@Model.BranchName"
                   class="form-control @(ViewData.ModelState.ContainsKey("BranchName") && ViewData.ModelState["BranchName"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                   maxlength="50" required />
        </div>
        <div class="mb-3 col-md-6">
            <label class="form-label fw-medium">
                Branch Type<span class="text-danger">*</span>
            </label>
            <div class="d-flex align-items-center gap-2">
                <select asp-for="BranchTypeId"
                        asp-items="@ViewBag.BranchTypes"
                        class="form-select">
                    <option value="">-- Select --</option>
                </select>
                <span asp-validation-for="BranchTypeId" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3 col-md-6">
            <label class="form-label fw-medium">
                Manager Name<span class="text-danger">*</span>
            </label>
            <input type="text"
                   name="ManagerName"
                   value="@Model.ManagerName"
                   class="form-control @(ViewData.ModelState.ContainsKey("ManagerName") && ViewData.ModelState["ManagerName"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                   maxlength="50" required />
        </div>
        <div class="mb-3 col-md-6">
            <label class="form-label fw-medium">
                Country <span class="text-danger">*</span>
            </label>
            <div class="d-flex flex-column gap-1">
                <select asp-for="CountryId"
                        asp-items="@ViewBag.Countries"
                        class="form-select"
                        hx-get="@Url.Action("GetLocationsByCountry", "Persons")"
                        hx-target="#locationDropdown"
                        hx-trigger="change"
                        hx-include="this">
                    <option value="">-- Select Country --</option>
                </select>
                <span asp-validation-for="CountryId" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3 col-md-6">
            <label class="form-label fw-medium">
                Location <span class="text-danger">*</span>
            </label>
            <div class="d-flex flex-column gap-1">
                <select asp-for="LocationId"
                        id="locationDropdown"
                        class="form-select"
                        asp-items="@ViewBag.Locations">
                    <option value="">-- Select Location --</option>
                </select>
                <span asp-validation-for="LocationId" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3 col-md-6">
            <label class="form-label fw-medium">
                Address<span class="text-danger">*</span>
            </label>
            <input type="text"
                   name="Address"
                   value="@Model.Address"
                   class="form-control @(ViewData.ModelState.ContainsKey("Address") && ViewData.ModelState["Address"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                   maxlength="100" required />
        </div>


        <div class="mb-3 col-md-6">
            <label class="form-label fw-medium">
                Telephone<span class="text-danger">*</span>
            </label>
            <input type="text"
                   name="Phone"
                   value="@Model.Phone"
                   class="form-control @(ViewData.ModelState.ContainsKey("Phone") && ViewData.ModelState["Phone"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                   maxlength="100" required />
        </div>


        <div class="mb-3 col-md-6">
            <label class="form-label fw-medium">
                Email Address<span class="text-danger">*</span>
            </label>
            <input type="text"
                   name="Email"
                   value="@Model.Email"
                   class="form-control @(ViewData.ModelState.ContainsKey("Email") && ViewData.ModelState["Email"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                   maxlength="100" required />
        </div>





    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>

            @if (isCreateMode)
            {
                <span>Save</span>
            }
            else
            {
                <span>Update</span>
            }
        </button>
    </div>
</form>
