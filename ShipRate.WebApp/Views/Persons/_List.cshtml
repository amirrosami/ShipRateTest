@using ShipRate.Application.DTOs
@using ShipRate.Application.DTOs.Base_Info
@using ShipRate.WebApp.ViewModels
@using ShipRate.WebApp.ViewModels.Location
@model GridViewModel


@if (!Model.Data.Items.Any())
{
    <tr>
        <td colspan="6" class="text-center py-5 text-muted">
            <i class="bi bi-inbox display-4 d-block mb-2"></i>
            No Records found.
        </td>
    </tr>
}
else
{
    int counter = (Model.Data.Page - 1) * Model.Data.PageSize;
    @foreach (var item in Model.Data.Items)
    {
        var vm = (PersonDto)item;
        counter++;
        <tr>
            <td class="@(vm.UpdatedAt.HasValue ? "bg-success-subtle" : "")">
                @counter
            </td>
            <td class="fw-medium">@vm.PersonName</td>
            <td class="fw-medium">@vm.PersonPersianName</td>
            <td class="fw-medium">@vm.PersonalityTypeName</td>
            <td class="fw-medium">@vm.CountryName</td>
            <td class="fw-medium">@vm.NationalID</td>
            <td class="fw-medium">@vm.EmailAddress</td>
            <td class="fw-medium">@vm.Phone</td>
            <td class="fw-medium">@vm.Mobile</td>
            <td class="text-center">
                <div class="btn-group btn-group-sm">

                    <button type="button"
                            class="btn btn-outline-info"
                            title="Details"
                            hx-get="@Url.Action("Details", "Persons", new { id = vm.Id })"
                            hx-target="#app-modal-content"
                            hx-swap="innerHTML">
                        <i class="bi bi-card-list"></i>
                    </button>

                    <button type="button"
                            class="btn btn-outline-primary"
                            title="Edit"
                            hx-get="@Url.Action("Edit", "Persons", new { id = vm.Id })"
                            hx-target="#app-modal-content"
                            hx-swap="innerHTML">
                        <i class="bi bi-pencil"></i>

                    </button>
                    <button type="button"
                            class="btn btn-outline-danger"
                            title="Delete"
                            hx-get="@Url.Action("Delete", "Persons", new { id = vm.Id })"
                            hx-target="#app-modal-content"
                            hx-swap="innerHTML">
                        <i class="bi bi-trash"></i>
                    </button>

                </div>
            </td>
        </tr>
    }
}
