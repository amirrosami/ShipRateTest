@using ShipRate.Application.DTOs.Base_Info
@model PersonExtraInfoDto
@{
    string CreateEditExtraInfo = ViewBag.CreateEditExtraInfo;
    bool isCreateMode = false;
    if (CreateEditExtraInfo == "Create") isCreateMode = true;
}
<form hx-post="@Url.Action(isCreateMode?"CreateExtraInfo":"EditExtraInfo", "Persons")"
      hx-target="#app-modal-content-second"
      hx-swap="innerHTML">

    <div class="modal-header bg-primary text-white">
        <input type="hidden" asp-for="PersonId" />
        @if (isCreateMode)
        {
            <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Add Information</h5>
        }
        else
        {
            <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Edit Information</h5>
            <input type="hidden" asp-for="Id" />
        }
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
    </div>




    <div class="modal-body row">
        @Html.AntiForgeryToken()
        @if (!ViewData.ModelState.IsValid)
        {
            var allErrors = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).ToList();
            if (allErrors.Any())
            {
                <div class="alert alert-danger py-2 mb-3">
                    <ul class="mb-0 small">
                        @foreach (var err in allErrors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }
        }



        <!-- Info Type -->
        <div class="mb-3 col-md-6">
            <label class="form-label fw-medium">
                Information Type <span class="text-danger">*</span>
            </label>
            <div class="d-flex align-items-center gap-2">
                <select asp-for="ExtraInfoTypeId"
                        asp-items="@ViewBag.InfoTypes"
                        class="form-select">
                    <option value="">-- Select --</option>
                </select>
                <span asp-validation-for="ExtraInfoTypeId" class="text-danger"></span>
            </div>
        </div>

        <!-- Info Value  -->
        <div class="mb-3 col-md-6">
            <label class="form-label fw-medium">
                Info Value <span class="text-danger">*</span>
            </label>
            <input type="text"
                   name="PersonExtraInfoValue"
                   value="@Model.PersonExtraInfoValue"
                   class="form-control @(ViewData.ModelState.ContainsKey("PersonExtraInfoValue") && ViewData.ModelState["PersonExtraInfoValue"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                   maxlength="100" required />
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>

            @if (isCreateMode)
            {
                <span>Save</span>
            }
            else
            {
                <span>Update</span>
            }
        </button>
    </div>
</form>
