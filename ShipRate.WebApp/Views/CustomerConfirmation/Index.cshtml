@{
    ViewData["Title"] = "Customer Confirmations";
}

<div class="container-fluid mt-3" dir="ltr">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">
            <i class="bi bi-person-check"></i> Customer Confirmations
        </h4>
        <button class="btn btn-primary " onclick="openCreateForm()">
            <i class="bi bi-plus-circle"></i> New Request
        </button>

    </div>

    <div class="card mb-3">
        <div class="card-body py-2">
            <form id="searchForm" class="row g-2 align-items-end"
                  hx-get="/CustomerConfirmation/List"
                  hx-target="#listContainer"
                  hx-trigger="submit">

                <div class="col-md-4">
                    <label class="form-label form-label-sm mb-1">Person Name</label>
                    <input type="text" name="searchName" class="form-control form-control-sm"
                           placeholder="Search by name..." />
                </div>

                <div class="col-md-3">
                    <label class="form-label form-label-sm mb-1">Status</label>
                    <select name="searchStatus" class="form-select form-select-sm">
                        <option value="All">All</option>
                        <option value="In Progress">In Progress</option>
                        <option value="Confirmed">Confirmed</option>
                        <option value="Rejected">Rejected</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary btn-sm w-100">
                        <i class="bi bi-search"></i> Search
                    </button>
                </div>

                <div class="col-md-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm w-100"
                            onclick="clearSearch()">
                        <i class="bi bi-x-circle"></i> Clear
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- amamam List Container -->
    <div id="listContainer"
         hx-get="/CustomerConfirmation/List"
         hx-trigger="load"
         hx-swap="innerHTML">
        <div class="text-center py-4">
            <div class="spinner-border spinner-border-sm text-primary"></div> Loading...
        </div>
    </div>
</div>





