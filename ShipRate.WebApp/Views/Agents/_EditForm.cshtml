@using ShipRate.WebApp.ViewModels.AgentVms
@model AgentEditViewModel

<div class="modal-header bg-primary text-white">
    <h5 class="modal-title"><i class="bi bi-pencil me-2"></i>Edit Agent</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
</div>

<form hx-post="/Agents/Edit"
      hx-target="#modal-content"
      hx-swap="innerHTML">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="modal-body">

@*         <div class="form-check mb-3">
            <input type="checkbox" name="IsActive" value="true"
                   class="form-check-input" @(Model.IsActive ? "checked" : "") />
            <label class="form-check-label">Active</label>
        </div>
 *@
        <div class="mb-3">
            <label class="form-label fw-bold">Scopes</label>
            <div class="row">
                @foreach (var tt in Model.Scopes)
                {
                    <div class="col-md-4">
                        <div class="form-check">
                            <input type="checkbox" name="SelectedScopeIds"
                                   value="@tt.Id" class="form-check-input"
                                   @(Model.SelectedScopeIds.Contains((tt.Id)) ? "checked" : "") />
                            <label class="form-check-label">@tt.Name</label>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>Save
        </button>
    </div>
</form>
