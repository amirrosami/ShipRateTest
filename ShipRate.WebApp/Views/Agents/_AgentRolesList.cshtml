@using ShipRate.WebApp.ViewModels.AgentVms
@model AgentRolesListViewModel

<div class="card mt-4">

    <div class="card-header d-flex justify-content-between align-items-center">
        <span>
            Roles for Agent: <strong>@Model.AgentName</strong>
        </span>

        <button class="btn btn-success btn-sm"
                hx-get="/Agents/CreateRole?agentId=@Model.AgentId"
                hx-target="#modal-content"
                hx-swap="innerHTML"
                data-bs-toggle="modal"
                data-bs-target="#modal-content">
            <i class="bi bi-plus-circle"></i> New Role
        </button>
    </div>

    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Carrier</th>
                    <th>Role Type</th>
                    <th>Commission %</th>
                    <th>Status</th>
                    <th style="width:150px;">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var role in Model.Items)
                {
                    <tr>
                        <td>@role.CarrierName</td>
                        <td>@role.AgentRoleTypeName</td>
                        <td>@role.CommissionRatePercent</td>

                        <td>
                            <span class="badge @(role.IsActive ? "bg-success" : "bg-secondary")">
                                @(role.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>

                        <td>

                            <button class="btn btn-sm btn-warning"
                                    hx-get="/Agents/EditRole?id=@role.Id"
                                    hx-target="#modal-content"
                                    hx-swap="innerHTML"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modal-content">
                                <i class="bi bi-pencil"></i>
                            </button>

                            <button class="btn btn-sm btn-danger"
                                    hx-delete="/Agents/DeleteRole/@role.Id"
                                    hx-confirm="Are you sure?"
                                    hx-target="#agentRolesContainer"
                                    hx-swap="innerHTML">
                                <i class="bi bi-trash"></i>
                            </button>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
