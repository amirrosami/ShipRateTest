@using ShipRate.WebApp.ViewModels.AgentVms
@model AgentSearchViewModel
@{
    ViewData["Title"] = "Agent Management";
}


<div class="container-fluid mt-3">
@*     <h4><i class="bi bi-people me-2"></i>Agents</h4>
    <button type="button"
            class="btn btn-primary"
            hx-get="@Url.Action("Create", "Persons")"
            hx-target="#app-modal-content"
            hx-swap="innerHTML">
        <i class="bi bi-plus-lg me-1"></i>New
    </button>
 *@
 <div class="card-header d-flex justify-content-between align-items-center">
        <span>Agents</span>
        <button type="button"
                class="btn btn-primary"
                hx-get="@Url.Action("CreateAgent", "Persons")"
                hx-target="#app-modal-content"
                hx-swap="innerHTML">
            + Add Agent
        </button>
    </div>





    <!-- Search Panel -->
    <div class="card mb-3">
        <div class="card-body">
            <form id="agentSearchForm"
                  hx-get="/Agents/List"
                  hx-target="#agentListContainer"
                  hx-trigger="submit , change from:select"
                  hx-include="this">

                <input type="hidden" id="PageNumber" name="Page" value="1" />

                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label">Person Name</label>
                        <input type="text" name="PersonName" class="form-control"
                               value="@Model.PersonName" placeholder="Search..." />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Status</label>
                        <select name="Status" class="form-select">
                            <option value="">All</option>
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search me-1"></i>Search
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- List Container -->
    <div id="agentListContainer"
         hx-get="/Agents/List"
         hx-trigger="load, refreshAgentsList from:body"
         hx-include="#agentSearchForm"
         hx-target="this"
         hx-swap="innerHTML">
        <div class="text-center p-5">
            <div class="spinner-border text-primary"></div>
        </div>
    </div>
    <!-- AgentRoles Grid Container (NEW) -->
    <div id="agentRolesContainer" class="mt-3">
    </div>

    <!-- AgentTerritories Grid Container (NEW) -->
    <div id="agentTerritoriesContainer" class="mt-3">
    </div>


</div>
