@using ShipRate.Application.ViewModels
@model DetentionStartBaseViewModel

<div class="modal fade show" id="detentionStartBaseModal" tabindex="-1" style="display: block; background: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form hx-post="@Url.Action("SaveDetentionStartBase", "Detentions")"
                  hx-target="#modal-body-content"
                  hx-swap="innerHTML">

                <div class="modal-header">
                    <h5 class="modal-title">Register Detention Start Dates</h5>
                    <button type="button" class="btn-close" onclick="closeModal()"></button>
                </div>

                <div class="modal-body" id="modal-body-content">
                    <input type="hidden" asp-for="BLId" />
                    <input type="hidden" asp-for="BookingId" />
                    <input type="hidden" asp-for="CompanyId" />

                    <div class="mb-3">
                        <label asp-for="DetentionStartBaseDateForBuy" class="form-label"></label>
                        <input asp-for="DetentionStartBaseDateForBuy" class="form-control" />
                        <span asp-validation-for="DetentionStartBaseDateForBuy" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DetentionStartBaseDateForSell" class="form-label"></label>
                        <input asp-for="DetentionStartBaseDateForSell" class="form-control" />
                        <span asp-validation-for="DetentionStartBaseDateForSell" class="text-danger"></span>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" onclick="closeModal()">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
