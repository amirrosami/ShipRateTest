@using ShipRate.Application.ViewModels
@model DetentionCalculationResultVm

<div class="card border-success shadow-sm">
    <div class="card-header bg-success-subtle d-flex justify-content-between align-items-center py-2">
        <strong class="text-success-emphasis">
            <i class="bi bi-check2-circle me-1"></i> Calculation Result
        </strong>

        <span class="badge bg-light text-secondary border">
            Detention ID: @Model.DetentionId
        </span>
    </div>

    <div class="card-body p-3">

        <!-- Top KPI Summary Cards -->
        <div class="row g-2 mb-3">
            <div class="col-6 col-md-3">
                <div class="p-2 border rounded bg-light">
                    <div class="text-muted" style="font-size: 0.75rem;">Gross Amount</div>
                    <strong class="text-dark" style="font-size: 0.95rem;">@Model.GrossAmount.ToString("N2") <span class="small text-muted">@Model.MainCurrencyCode</span></strong>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="p-2 border rounded bg-light">
                    <div class="text-muted" style="font-size: 0.75rem;">VAT Amount</div>
                    <strong class="text-dark" style="font-size: 0.95rem;">@Model.VATAmount.ToString("N2") <span class="small text-muted">@Model.MainCurrencyCode</span></strong>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="p-2 border border-success-subtle rounded bg-success-subtle">
                    <div class="text-success-emphasis" style="font-size: 0.75rem;">Total Amount</div>
                    <strong class="text-success" style="font-size: 1.05rem;">@Model.Amount.ToString("N2") <span class="small">@Model.MainCurrencyCode</span></strong>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="p-2 border border-success-subtle rounded bg-success-subtle">
                    <div class="text-success-emphasis" style="font-size: 0.75rem;">Payable Amount</div>
                    <strong class="text-success" style="font-size: 1.05rem;">@Model.PayableAmount.ToString("N2") <span class="small">@Model.PaymentCurrencyCode</span></strong>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="p-2 border rounded bg-light">
                    <div class="text-muted" style="font-size: 0.75rem;">Detention To Date</div>
                    <strong class="text-dark" style="font-size: 0.95rem;">@Model.DetentionToDate.ToString("yyyy-MM-dd")</strong>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="mb-0 text-secondary fw-bold" style="font-size: 0.85rem;">
                Detention Items (@Model.Items.Count() containers)
            </h6>
        </div>

        <!-- Scrollable Table Container (Horizontal & Vertical with Sticky Header) -->
        <div class="table-responsive border rounded" style="max-height: 420px; overflow-y: auto; overflow-x: auto;">
            <table class="table table-sm table-hover table-bordered mb-0 align-middle text-nowrap" style="font-size: 0.82rem; min-width: 760px;">
                <thead class="table-light position-sticky top-0 shadow-sm" style="z-index: 2;">
                    <tr class="align-middle">
                        <th class="text-center" style="width: 140px;">Container No</th>
                        <th class="text-center" style="width: 100px;">Start Date</th>
                        <th class="text-center" style="width: 100px;">End Date</th>
                        <th class="text-center" style="width: 70px;">Total</th>
                        <th class="text-center text-success" style="width: 70px;">Free</th>
                        <th class="text-center text-danger" style="width: 70px;">Late</th>
                        <th class="text-end" style="width: 130px;">Amount</th>
                        <th class="text-center" style="width: 80px;">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                <em>No calculated items exist yet.</em>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="text-center fw-bold text-primary">@item.ContainerNo</td>
                                <td class="text-center">@item.StartDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-center">@item.EndDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-center">@item.TotalDays</td>
                                <td class="text-center text-success fw-bold">@item.FreeDays</td>
                                <td class="text-center text-danger fw-bold">@item.LateDays</td>
                                <td class="text-end fw-bold text-dark">@item.Amount.ToString("N2")</td>
                                <td class="text-center">
                                    <button type="button"
                                            class="btn btn-outline-secondary btn-xs py-0 px-2"
                                            style="font-size: 0.75rem;"
                                            hx-get="@Url.Action("GetItemDetails", "Detentions", new { id = item.Id })"
                                            hx-target="#modal-item-details-@item.Id"
                                            hx-swap="innerHTML">
                                        <i class="bi bi-list-ul"></i> Details
                                    </button>
                                </td>
                            </tr>

                            <tr>
                                <td colspan="8"
                                    id="modal-item-details-@item.Id"
                                    class="p-0 border-0">
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>
