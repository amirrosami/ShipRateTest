@using ShipRate.Application.JobsViewModels
@model CreateBLVm
<div dir="ltr" class="container">
    <div>
        <h2 class="mb-1">Create Transport Document(BL-CMR,...)</h2>
        <input type="hidden" value="@Model.JobId" name="JobId" />
        <input type="hidden" value="@Model.BookingId" name="BookingId" />
    </div>

    <form hx-post="@Url.Action("SaveBL", "Jobs")"
          hx-target="#modal-content"
          hx-swap="innerHTML"
          novalidate>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

        <div class="mb-3">
            <div class="card-header py-2 bg-primary-subtle text-primary-emphasis fw-semibold mb-1">General</div>
            <div class="row g-2">
                <div class="col-md-4">
                    <select asp-for="CompanyId" asp-items="Model.Companies" class="form-select form-select-sm">
                        <option value="">Company...</option>
                    </select>
                    <span asp-validation-for="CompanyId" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <input asp-for="BookingNo" class="form-control form-control-sm" placeholder="Booking Number" />
                    <span asp-validation-for="BookingNo" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <input asp-for="LineBookingNo" class="form-control form-control-sm" placeholder="Line Booking No" />
                    <span asp-validation-for="LineBookingNo" class="text-danger small"></span>
                </div>


                <div class="col-md-4">
                    <select asp-for="TransportTypeId" asp-items="Model.TransportTypes" class="form-select form-select-sm"
                            hx-get="@Url.Action("GetLoadTypes", "Jobs")"
                            hx-trigger="change"
                            hx-target="#load-type-wrapper"
                            hx-swap="outerHTML"
                            hx-include="[name='TransportTypeId']">
                        <option value="">Transport Type...</option>
                    </select>
                    <span asp-validation-for="TransportTypeId" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <select asp-for="TradeTypeId" asp-items="Model.TradeTypes" class="form-select form-select-sm">
                        <option value="">Trade Type...</option>
                    </select>
                    <span asp-validation-for="TradeTypeId" class="text-danger small"></span>
                </div>

                <div class="col-md-4" id="load-type-wrapper">
                    <select asp-for="LoadTypeId" asp-items="Model.LoadTypes" class="form-select form-select-sm">
                        <option value="">Load Type...</option>
                    </select>
                    <span asp-validation-for="LoadTypeId" class="text-danger small"></span>
                </div>
                @*                 <div class="col-md-4">
                    <select asp-for="JobStatusId" asp-items="Model.JobStatuses" class="form-select form-select-sm">
                        <option value="">Job Status...</option>
                    </select>
                    <span asp-validation-for="JobStatusId" class="text-danger small"></span>
                </div>
 *@
                <div class="col-md-3">
                    <label asp-for="CargoReadyDate" class="form-label small fw-semibold">Cargo Ready Date</label>
                    <input asp-for="CargoReadyDate" type="date" class="form-control form-control-sm" />
                    <span asp-validation-for="CargoReadyDate" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <div class="card-header py-2 bg-primary-subtle text-primary-emphasis fw-semibold mb-1 d-flex justify-content-between align-items-center">
                <span>Parties</span>
                <button type="button"
                        class="btn btn-sm btn-light py-0 px-2"
                        hx-get="@Url.Action("AddPartyRow", "Jobs")"
                        hx-target="#parties-wrapper"
                        hx-swap="beforeend"
                        hx-vals='js:{ index: window.partyIndex++ }'>
                    + Add
                </button>
            </div>
            @*         <div id="parties-wrapper" class="mb-3">
            @for (int i = 0; i < Model.JobParties.Count; i++)
            {
                @await Html.PartialAsync("_JobPartyRow", Model.JobParties[i])
            }
        </div>
 *@ 
</div>


