        <div class="mb-3">
            <div class="card-header py-2 bg-primary-subtle text-primary-emphasis fw-semibold mb-1">Routing</div>
            <div class="row g-2">
                <div class="col-md-4">
                    <select asp-for="OriginLocationId" asp-items="Model.Locations" class="form-select form-select-sm">
                        <option value="">Origin...</option>
                    </select>
                    <span asp-validation-for="OriginLocationId" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <select asp-for="DestinationLocationId" asp-items="Model.Locations" class="form-select form-select-sm">
                        <option value="">Destination...</option>
                    </select>
                    <span asp-validation-for="DestinationLocationId" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <select asp-for="MovementTypeId" asp-items="Model.MovementTypes" class="form-select form-select-sm">
                        <option value="">Movement Type...</option>
                    </select>
                    <span asp-validation-for="MovementTypeId" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <input asp-for="ETD" type="datetime-local" class="form-control form-control-sm" />
                    <span asp-validation-for="ETD" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <input asp-for="ETA" type="datetime-local" class="form-control form-control-sm" />
                    <span asp-validation-for="ETA" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <div class="card-header py-2 bg-primary-subtle text-primary-emphasis fw-semibold mb-1 d-flex justify-content-between align-items-center">
                <span>Containers</span>

                <button type="button"
                        class="btn btn-sm btn-light py-0 px-2"
                        hx-get="@Url.Action("AddContainerRow", "Jobs")"
                        hx-target="#containers-wrapper"
                        hx-swap="beforeend"
                        hx-vals='js:{ index: window.containerIndex++ }'>
                    + Add
                </button>
            </div>
