        <script>
            let activeFlightRow = null;
            let activeFlightDateRow = null;

            document.addEventListener('click', function (e) {
            const selectFlightButton = e.target.closest('.btn-select-flight');
            if (selectFlightButton) {
                activeFlightRow = selectFlightButton.closest('tr');

                const searchInput = document.querySelector('#flightLookupSearch');
                const results = document.querySelector('#flightLookupResults');

                if (searchInput) {
                    searchInput.value = '';
                    setTimeout(() => searchInput.focus(), 250);
                }

                if (results) {
                    results.innerHTML = `
                        <div class="text-muted small">
                            Type at least 2 characters to search.
                        </div>`;
                }
                return;
            }

            const selectFlightDateButton = e.target.closest('.btn-select-flight-date');

            if (selectFlightDateButton) {
                activeFlightDateRow = selectFlightDateButton.closest('tr');

                if (!activeFlightDateRow) {
                    return;
                }

                const flightId = activeFlightDateRow
                    .querySelector('.flight-id-input')
                    ?.value;

                const results = document.querySelector('#flightDateLookupResults');

                if (!flightId) {
                    if (results) {
                        results.innerHTML = `
                            <div class="alert alert-warning mb-0">
                                Please select a flight first.
                            </div>`;
                    }

                    return;
                }

                const lookupFlightId = document.querySelector('#flightDateLookupFlightId');

                if (lookupFlightId) {
                    lookupFlightId.value = flightId;
                }

                htmx.ajax(
                    'GET',
                    '@Url.Action("SearchFlightDates", "TransportDocuments")',
                    {
                        target: '#flightDateLookupResults',
                        values: { flightId: flightId }
                    });

                return;
            }
            const chooseFlightButton = e.target.closest('.btn-choose-flight');
            if (chooseFlightButton) {
                if (!activeFlightRow) {
                    console.warn('No active flight row was found.');
                    return;
                }
                const flightId = chooseFlightButton.dataset.flightId ?? '';
                const airlineId = chooseFlightButton.dataset.airlineId ?? '';
                const airlineName = chooseFlightButton.dataset.airlineName ?? '';
                const flightNo = chooseFlightButton.dataset.flightNo ?? '';
                const displayText = chooseFlightButton.dataset.displayText
                    ?? `${airlineName} - ${flightNo}`;

                const flightIdInput =
                    activeFlightRow.querySelector('.flight-id-input');

                const airlineIdInput =
                    activeFlightRow.querySelector('.airline-id-input');

                const airlineNameInput =
                    activeFlightRow.querySelector('.airline-name-input');

                const flightNoInput =
                    activeFlightRow.querySelector('.flight-no-input');

                const flightSearchInput =
                    activeFlightRow.querySelector('.flight-search-input');

                const flightDateIdInput =
                    activeFlightRow.querySelector('.flight-date-id-input');

                const flightDateSearchInput =
                    activeFlightRow.querySelector('.flight-date-search-input');

                const flightDateDateInput =
                    activeFlightRow.querySelector('.flight-date-date-input');

                const flightDateLocalInput =
                    activeFlightRow.querySelector('.flight-date-local-input');

                if (flightIdInput) flightIdInput.value = flightId;
                if (airlineIdInput) airlineIdInput.value = airlineId;
                if (airlineNameInput) airlineNameInput.value = airlineName;
                if (flightNoInput) flightNoInput.value = flightNo;
                if (flightSearchInput) flightSearchInput.value = displayText;

                // تغییر Flight، FlightDate قبلی را نامعتبر می‌کند.
                if (flightDateIdInput) flightDateIdInput.value = '';
                if (flightDateSearchInput) flightDateSearchInput.value = '';
                if (flightDateDateInput) flightDateDateInput.value = '';
                if (flightDateLocalInput) flightDateLocalInput.value = '';

                const modalElement = chooseFlightButton.closest('.modal');

                if (modalElement) {
                    bootstrap.Modal.getOrCreateInstance(modalElement).hide();
                }

                return;
            }


            const chooseFlightDateButton = e.target.closest('.btn-choose-flight-date');

            if (chooseFlightDateButton) {
                if (!activeFlightDateRow) {
                    console.warn('No active flight date row was found.');
                    return;
                }

                const flightDateId = chooseFlightDateButton.dataset.flightDateId ?? '';
                const etd = chooseFlightDateButton.dataset.etd ?? '';
                const localDate = chooseFlightDateButton.dataset.localDate ?? '';
                const displayText = chooseFlightDateButton.dataset.displayText ?? etd;

                const flightDateIdInput =
                    activeFlightDateRow.querySelector('.flight-date-id-input');

                const flightDateSearchInput =
                    activeFlightDateRow.querySelector('.flight-date-search-input');

                const flightDateDateInput =
                    activeFlightDateRow.querySelector('.flight-date-date-input');

                const flightDateLocalInput =
                    activeFlightDateRow.querySelector('.flight-date-local-input');

                if (flightDateIdInput) flightDateIdInput.value = flightDateId;
                if (flightDateSearchInput) flightDateSearchInput.value = displayText;

                // باید تاریخ ISO باشد: yyyy-MM-ddTHH:mm:ss
                if (flightDateDateInput) flightDateDateInput.value = etd;
                if (flightDateLocalInput) flightDateLocalInput.value = localDate;

                const modalElement = chooseFlightDateButton.closest('.modal');

                if (modalElement) {
                    bootstrap.Modal.getOrCreateInstance(modalElement).hide();
                }

                return;
            }
            const clearFlightButton = e.target.closest('.btn-clear-flight');

            if (clearFlightButton) {
                const row = clearFlightButton.closest('tr');

                if (!row) return;

                const fields = [
                    '.flight-id-input',
                    '.flight-search-input',
                    '.airline-id-input',
                    '.airline-name-input',
                    '.flight-no-input',
                    '.flight-date-id-input',
                    '.flight-date-search-input',
                    '.flight-date-date-input',
                    '.flight-date-local-input'
                ];

                fields.forEach(selector => {
                    const input = row.querySelector(selector);

                    if (input) {
                        input.value = '';
                    }
                });

                return;
            }
            const clearFlightDateButton = e.target.closest('.btn-clear-flight-date');
            if (clearFlightDateButton) {
                const row = clearFlightDateButton.closest('tr');

                if (!row) return;

                const fields = [
                    '.flight-date-id-input',
                    '.flight-date-search-input',
                    '.flight-date-date-input',
                    '.flight-date-local-input'
                ];

                fields.forEach(selector => {
                    const input = row.querySelector(selector);

                    if (input) {
                        input.value = '';
                    }
                });

                return;
            }
            });
        </script>
        <script>
            $(document).ready(function () {
                // 🌟 تابع همه‌منظوره برای ساخت انواع Select2 ایجکسی
                function initDynamicSelect2(options) {
                    var $select = $(options.selectId);
                    var $targetInput = options.targetTextId ? $(options.targetTextId) : null;

                    $select.select2({
                        theme: 'bootstrap-5',
                        placeholder: options.placeholder || 'Select...',
                        allowClear: true,
                        minimumInputLength: options.minInput || 1,
                        ajax: {
                            url: options.url,
                            dataType: 'json',
                            delay: 250,
                            data: function (params) {
                                return { q: params.term };
                            },
                            processResults: function (data) {
                                return {
                                    results: data.results || $.map(data, function (item) {
                                        return { id: item.id, text: item.text };
                                    })
                                };
                            }
                        }
                    });

                    // اگر فیلد متنی هدف داشت، مقداردهی خودکار انجام شود
                    if ($targetInput && $targetInput.length) {
                        $select.on('select2:select', function (e) {
                            var fullText = (e.params.data.text || '').trim();

                            // اگر تابع تبدیل متن (مثل حذف ۸ کاراکتر) پاس داده شده بود، اجرا شود؛ در غیر این صورت کل متن
                            var finalText = options.textTransform ? options.textTransform(fullText) : fullText;

                            if (!$targetInput.val().trim()) {
                                $targetInput.val(finalText).trigger('change');
                            }
                        });
                    }
                }

                // -------------------------------------------------------------
                // ۱. استفاده برای پورت‌ها (با حذف ۸ کاراکتر اول)
                // -------------------------------------------------------------
                var stripPortCode = function(t) { return t.length > 8 ? t.substring(8).trim() : t; };


                initDynamicSelect2({
                    selectId: '#PORSelect2',
                    targetTextId: '#porText',
                    placeholder: 'Search POR...',
                    url: '/Locations/GetPortsJson',
                    textTransform: stripPortCode
                });


                initDynamicSelect2({
                    selectId: '#POLSelect2',
                    targetTextId: '#polText',
                    placeholder: 'Search POL...',
                    url: '/Locations/GetPortsJson',
                    textTransform: stripPortCode
                });

                initDynamicSelect2({
                    selectId: '#PODSelect2',
                    targetTextId: '#podText',
                    placeholder: 'Search POD...',
                    url: '/Locations/GetPortsJson',
                    textTransform: stripPortCode
                });

                initDynamicSelect2({
                    selectId: '#PODelSelect2',
                    targetTextId: '#podelText',
                    placeholder: 'Search PODel...',
                    url: '/Locations/GetPortsJson',
                    textTransform: stripPortCode
                });

                initDynamicSelect2({
                    selectId: '#TranshipmentPortSelect2',
                    targetTextId: '#transhipmentportText',
                    placeholder: 'Search Tranship...',
                    url: '/Locations/GetPortsJson',
                    textTransform: stripPortCode
                });

                initDynamicSelect2({
                    selectId: '#ShipperSelect2',
                    targetTextId: '#ShipperTextInBL',
                    placeholder: 'Search Shipper...',
                    url: '/Persons/GetPersonsJson'
                });

                initDynamicSelect2({
                    selectId: '#ConsigneeSelect2',
                    targetTextId: '#ConsigneeTextInBL',
                    placeholder: 'Search Consignee...',
                    url: '/Persons/GetPersonsJson'
                });
                initDynamicSelect2({
                    selectId: '#NotifySelect2',
                    targetTextId: '#NotifyPartyTextInBL',
                    placeholder: 'Search Notify...',
                    url: '/Persons/GetPersonsJson'
                });
                initDynamicSelect2({
                    selectId: '#IssuerPartySelect2',
                    placeholder: 'Search Issuer...',
                    url: '/Persons/GetPersonsJson'
                });

                initDynamicSelect2({
                    selectId: '#PackageTypeSelect2',
                    targetTextId: '#PackageTypeText',
                    placeholder: 'Search Package Type...',
                    url: '/PackageTypes/GetPackageTypesJson'
                });
            });
        </script>

