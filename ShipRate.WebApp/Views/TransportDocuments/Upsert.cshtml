              }

              // کاربر Voyage انتخاب‌شده را پاک می‌کند.
              const clearVoyageButton = e.target.closest('.btn-clear-voyage');

              if (clearVoyageButton) {
                  const row = clearVoyageButton.closest('tr');

                  row.querySelector('.voyage-id-input').value = '';
                  row.querySelector('.voyage-search-input').value = '';

                  // اختیاری:
                  // اگر می‌خواهید با Clear شدن Voyage،
                  // نام کشتی و شماره سفر هم پاک شوند، این‌ها را فعال کنید:
                  //
                  // row.querySelector('.vessel-name-input').value = '';
                  // row.querySelector('.voyage-no-input').value = '';

                  return;
              }

              // دکمه Select داخل Modal نتایج جست‌وجوی Voyage
              const chooseVoyageButton = e.target.closest('.btn-choose-voyage');

              if (chooseVoyageButton) {
                  if (!activeVoyageRow) {
                      console.warn('No active voyage row was found.');
                      return;
                  }

                  const voyageId = chooseVoyageButton.dataset.voyageId;
                  const vesselName = chooseVoyageButton.dataset.vesselName;
                  const voyageNo = chooseVoyageButton.dataset.voyageNo;
                  const displayText = chooseVoyageButton.dataset.displayText;

                  activeVoyageRow.querySelector('.voyage-id-input').value = voyageId ?? '';
                  activeVoyageRow.querySelector('.voyage-search-input').value =
                      displayText ?? `${vesselName ?? ''} - ${voyageNo ?? ''}`;

                  // این دو input readonly نیستند؛
                  // پس پس از مقداردهی، کاربر همچنان می‌تواند اصلاحشان کند.
                  activeVoyageRow.querySelector('.vessel-name-input').value = vesselName ?? '';
                  activeVoyageRow.querySelector('.voyage-no-input').value = voyageNo ?? '';

                  const modalElement = chooseVoyageButton.closest('.modal');

                  if (modalElement) {
                      bootstrap.Modal
                          .getOrCreateInstance(modalElement)
                          .hide();
                  }

                  return;
              }







                    const addButton = e.target.closest('[data-add-row]');
                    if (addButton) {
                        const type = addButton.dataset.addRow;

                        if (type === 'voyages') addVoyageRow();
                        if (type === 'flights') addFlightRow();
                        if (type === 'trips') addTripRow();
                        if (type === 'rail') addRailRow();

                        syncTransportPanels();
                        return;
                    }

                    const removeButton = e.target.closest('[data-remove-row]');
                    if (removeButton) {
