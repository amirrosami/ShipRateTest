            });
        </script>

        <script>
            document.body.addEventListener('htmx:beforeRequest', function (event) {
                const elt = event.detail.elt;
                if (!elt) return;

                const targetSelector = elt.getAttribute('hx-target');
                if (!targetSelector) return;

                const target = document.querySelector(targetSelector);
                if (!target || target.tagName !== 'TEXTAREA') return;

                const forceReplace =
                    elt.hasAttribute('hx-vals') &&
                    elt.getAttribute('hx-vals').includes('forceReplace: true');

                if (forceReplace) {
                    target.dataset.forceReplace = 'true';
                } else {
                    delete target.dataset.forceReplace;
                }
            });

            document.body.addEventListener('htmx:beforeSwap', function (event) {
                const target = event.detail.target;
                if (!target || target.tagName !== 'TEXTAREA') return;

                const newText = event.detail.xhr.responseText || '';
                const currentText = (target.value || '').trim();
                const forceReplace = target.dataset.forceReplace === 'true';
                const fillIfEmpty = target.dataset.fillIfEmpty === 'true';

                event.detail.shouldSwap = false;

                if (forceReplace) {
                    target.value = newText;
                    delete target.dataset.forceReplace;
                    return;
                }

                if (fillIfEmpty && currentText.length === 0 && newText.trim().length > 0) {
                    target.value = newText;
                }
            });
        </script>

