@using ShipRate.Application.ViewModels
@model TransportDocumentUpsertVm
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Edit BL" : "Create BL";

    var documentNo = !string.IsNullOrWhiteSpace(Model.BLNo) ? Model.BLNo : "Draft";
    var statusName = !string.IsNullOrWhiteSpace(Model.StatusName) ? Model.StatusName : "Draft";
}

<style>
    body {
        background: #f5f7fb;
    }

    .containers-scroll-area { /* نام کلاس wrapper جدول */
        overflow-y: auto;
        scrollbar-gutter: stable;
    }

    /* ۲. حذف هر transition پیشفرض در hover که پرش ایجاد می‌کند */
    .container-row, .container-row td {
        transition: none !important;
    }

    /* استایل پیش فرض برای جدول */
    .bl-table th,
    .bl-table td {
        font-size: 0.85rem; /* کوچکتر کردن فونت (مقدار پیشفرض معمولا 1rem یا 16px است) */
        padding: 6px 8px; /* کم کردن فاصله داخلی سلولها برای فشرده تر شدن */
        vertical-align: middle; /* اطمینان از اینکه متن در وسط سلول قرار میگیرد */
    }

    /* اگر لازم بود، برای سرتیترها فونت کمی بزرگتر */
    .bl-table thead th {
        font-size: 0.88rem;
        font-weight: 500; /* یا 600، بسته به فونت */
    }

    /* برای اطمینان از اینکه همه چیز درست مرتب شود */
    .bl-table .bl-section-actions button {
        font-size: 0.8rem;
        padding: 3px 6px;
    }

    .bl-table #addContainerLine {
        font-size: 0.8rem;
        padding: 4px 8px;
    }









    .aligned-excel-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr)); /* 3 equal columns */
        gap: 0; /* Excel-like touching cells */
        border: 1px solid #dee2e6; /* outer border like Excel */
    }



    /* استایل کلی فیلدها */

    .excel-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0; /* حذف گپ بین سلول‌ها برای چسبیده شدن */
        border: 1px solid #d1d9e0; /* حاشیه دور کل گرید */
    }

    .excel-field {
        display: flex; /* لیبل و اینپوت کنار هم */
        border: 0.5px solid #d1d9e0; /* مرز بین سلول‌ها */
        background-color: #fff;
        align-items: stretch; /* ارتفاع یکسان */
    }

        /* استایل لیبل (سمت چپ - آبی روشن) */
        .excel-field label {
            background-color: #eef6ff; /* آبی بسیار ملایم */
            color: #4a5568;
            padding: 6px 10px;
            font-size: 14px;
            font-weight: 600;
            min-width: 150px; /* عرض ستون لیبل */
            border-right: 1px solid #d1d9e0;
            display: flex;
            align-items: center;
            white-space: nowrap;
            margin: 0;
        }

        /* استایل ورودی‌ها (سمت راست - سفید) */
        .excel-field input,
        .excel-field select,
        .excel-field textarea {
            flex: 1; /* پر کردن فضای باقی‌مانده */
            border: none;
            background-color: #ffffff;
            padding: 5px 8px;
            font-size: 14px;
            outline: none;
            width: 100%;
        }

    /* استایل فوکوس (زرد) */
    input:focus,
    select:focus,
    textarea:focus {
        background-color: #fff9c4 !important; /* زرد ملایم */
    }


    /* ۲. استایل فوکوس روی سلکتور Select2 داخل excel-field */
    .excel-field .select2-container--bootstrap-5.select2-container--focus .select2-selection,
    .excel-field .select2-container--bootstrap-5.select2-container--open .select2-selection,
    .excel-field .select2-container--default.select2-container--focus .select2-selection,
    .excel-field .select2-container--default.select2-container--open .select2-selection {
        background-color: #fff9c4 !important; /* زرد ملایم هنگام فوکوس روی فیلد */
        border-color: #ffe082 !important; /* کادر زرد هماهنگ */
    }

    /* ۳. استایل اینپوت جستجوی باز شده در دراپ‌داون Select2 */
    .select2-dropdown .select2-search__field:focus {
        background-color: #fff9c4 !important; /* زرد ملایم داخل کادر تایپ سرچ */
        border-color: #ffe082 !important;
    }









    /* برای چک‌باکس‌ها که استایل متفاوتی دارند */
    .excel-checkbox {
        width: auto !important;
        margin: auto 10px;
    }

    /* استایل فیلدهای span-3 (تمام عرض) */
    .span-3 {
        grid-column: span 3;
    }




    .refresh-text-btn i {
        transition: opacity .15s ease-in-out;
    }

    .refresh-text-btn:hover i {
        opacity: .9 !important;
    }


    .bl-topbar {
        position: sticky;
        top: 0;
        z-index: 100;
        background: #fff;
        border-bottom: 1px solid #e5e7eb;
        padding: 12px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
    }

    .bl-topbar-left {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
    }

    .bl-topbar-title h1 {
        font-size: 18px;
        margin: 0;
        font-weight: 700;
        color: #111827;
    }

    .bl-topbar-title span {
        font-size: 13px;
        color: #6b7280;
    }

    .bl-topbar-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .bl-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 600;
        background: #eef2ff;
        color: #3730a3;
    }

    .bl-summary-strip {
        background: #fff;
        border-bottom: 1px solid #e5e7eb;
        padding: 14px 20px;
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 12px;
    }

    .summary-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: #6b7280;
        margin-bottom: 4px;
    }

    .summary-value {
        font-size: 13px;
        font-weight: 600;
        color: #111827;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .bl-page {
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 20px;
        padding: 20px;
    }

    .bl-main,
    .bl-sidebar {
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-width: 0;
    }

    .bl-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 5px;
        overflow: hidden;
        box-shadow: 0 1px 2px rgba(15, 23, 42, .04);
    }

        .bl-card + .bl-card {
            margin-top: 2px; /* یا -1px برای چسبیدن کامل */
        }


    .bl-card-header {
        padding: 14px 18px;
        border-bottom: 1px solid #e5e7eb;
        background: #fbfdff;
    }

        .bl-card-header h2 {
            font-size: 15px;
            font-weight: 700;
            margin: 0;
            color: #111827;
        }

    .bl-card-body {
        padding: 18px;
    }

    .grid-2 {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
    }

    .grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
    }

    .grid-4 {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 0;
    }

        .field label {
            font-size: 12px;
            font-weight: 600;
            color: #374151;
        }

        .field input,
        .field select,
        .field textarea {
            width: 100%;
            border: 1px solid #d1d5db;
            border-radius: 9px;
            padding: 9px 10px;
            font-size: 13px;
            color: #111827;
            background: #fff;
        }

        .field textarea {
            min-height: 90px;
            resize: vertical;
        }

    .section-gap {
        margin-top: 5px;
    }

    .validation-message {
        font-size: 12px;
        color: #dc2626;
    }

    @@media (max-width: 1200px) {
        .bl-page {
            grid-template-columns: 1fr;
        }

        .bl-sidebar {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 900px) {
        .bl-topbar {
            flex-direction: column;
            align-items: flex-start;
        }

        .bl-summary-strip {
            grid-template-columns: repeat(2, 1fr);
        }

        .grid-2,
        .grid-3,
        .grid-4 {
            grid-template-columns: 1fr;
        }

        .bl-sidebar {
            display: flex;
        }
    }


    .bl-card-accordion-button {
        width: 100%;
        border: 0;
        background: transparent;
        padding: 0;
        margin: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        text-align: left;
        color: inherit;
    }

        .bl-card-accordion-button h2 {
            font-size: inherit;
            font-weight: inherit;
        }

        .bl-card-accordion-button:focus {
            outline: none;
            box-shadow: none;
        }

        .bl-card-accordion-button .accordion-icon {
            transition: transform 0.2s ease;
        }

        .bl-card-accordion-button[aria-expanded="true"] .accordion-icon {
            transform: rotate(180deg);
        }

    /* جلوگیری از بیرون زدن و سرریز فوکوس اینپوت‌های جدول */
    .table-responsive .form-control:focus,
    .table-responsive .form-select:focus,
    .table-responsive .input-group:focus-within {
        box-shadow: inset 0 0 0 1px #0d6efd !important; /* به جای shadow بیرونی از inset استفاده می‌شود */
        outline: none !important;
    }

    /* در صورت لزوم، کاهش جزئی عرض حداقل ستون‌ها برای ایجاد حاشیه امن */
    .table-responsive table {
        table-layout: auto;
    }

    /* سلول اکسلی برای چک‌باکس */
    td.excel-checkbox-cell {
        padding: 0 !important;
        text-align: center;
        vertical-align: middle;
        width: 60px; /* یا عرض مناسب بر اساس ستون */
    }

    /* کلیک روی کل سلول عمل کند */
    .excel-checkbox-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        min-height: 31px; /* هماهنگ با ارتفاع ردیف‌های جدول اکسلی شما */
        margin: 0;
        cursor: pointer;
        user-select: none;
    }

    /* مخفی کردن اینپوت بومی */
    .excel-checkbox-input {
        position: absolute;
        opacity: 0;
        width: 0;
        height: 0;
    }

    /* استایل مربع چک‌باکس */
    .excel-checkbox-custom {
        position: relative;
        width: 18px;
        height: 18px;
        background-color: #ffffff;
        border: 2px solid #adb5bd;
        border-radius: 4px;
        transition: all 0.15s ease-in-out;
    }

    /* حالت هاور سلول */
    .excel-checkbox-wrapper:hover .excel-checkbox-custom {
        border-color: #0d6efd;
        background-color: #f8f9fa;
    }

    /* فوکوس کیبورد شبیه اکسل */
    .excel-checkbox-input:focus + .excel-checkbox-custom {
        box-shadow: 0 0 0 2px rgba(13, 110, 253, 0.35);
        border-color: #0d6efd;
    }

    /* حالت تیک‌خورده: رنگ پررنگ و کامپکت */
    .excel-checkbox-input:checked + .excel-checkbox-custom {
        background-color: #0d6efd; /* یا رنگ تم سازمانی شما: #198754 سبز */
        border-color: #0d6efd;
    }

        /* علامت تیک سفید و درشت */
        .excel-checkbox-input:checked + .excel-checkbox-custom::after {
            content: "";
            position: absolute;
            left: 5px;
            top: 2px;
            width: 5px;
            height: 9px;
            border: solid #ffffff;
            border-width: 0 2px 2px 0;
            transform: rotate(45deg);
        }

    /* هایلایت کل سلول موقع تیک خوردن (اختیاری ولی فوق‌العاده در اکسل) */
    td.excel-checkbox-cell:has(.excel-checkbox-input:checked) {
        background-color: #e7f1ff !important; /* رنگ ملایم پشت ردیف تیک‌خورده */
    }




</style>
<form asp-action="@(isEdit ? "Edit" : "Create")"
      asp-route-id="@Model.Id"
      method="post">

    @Html.AntiForgeryToken()

    <input asp-for="Id" type="hidden" />
    <input asp-for="JobId" type="hidden" />
    <input asp-for="BookingId" type="hidden" />
    <input asp-for="ShipmentId" type="hidden" />
    <input asp-for="ShipmentLegId" type="hidden" />
    <input asp-for="CompanyId" type="hidden" />
    <div class="bl-page">
        <main class="bl-main">

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>


            <section class="bl-card">
                <div id="documentInformationCollapse">
                    <div class="bl-card-body">
                        <h6>1)BL Information:</h6>
                        <div class="excel-grid">

                            <!-- ===== Document Type ===== -->
                            <div class="excel-field">
                                <label asp-for="TransportTypeId"></label>
                                <select asp-for="TransportTypeId"
                                        asp-items="Model.TransportTypes"
                                        hx-get="@Url.Action("GetBLTypeOptions", "TransportDocuments")"
                                        hx-trigger="change"
                                        hx-target="#blTypeField"
                                        hx-include="this"
                                        hx-swap="outerHTML">
                                    <option value="">Select...</option>
                                </select>
                            </div>

                            <div id="blTypeField" class="excel-field">
                                <label asp-for="BLTypeId"></label>
                                <select asp-for="BLTypeId" asp-items="Model.BLTypes">
                                    <option value="">Select...</option>
                                </select>
                            </div>

                            <div class="excel-field">
                                <label asp-for="BLLevelId"></label>
                                <select asp-for="BLLevelId" asp-items="Model.BLLevels">
                                    <option value="">Select...</option>
                                </select>
                            </div>

                            <div class="excel-field">
                                <label asp-for="TradeTypeId">Trade Type</label>
                                <select asp-for="TradeTypeId" asp-items="Model.TradeTypes">
                                    <option value="">Select...</option>
                                </select>
                            </div>

                            <div class="excel-field">
                                <label asp-for="LoadTypeId">Load Type</label>
                                <select asp-for="LoadTypeId" asp-items="Model.LoadTypes">
                                    <option value="">Select...</option>
                                </select>
                            </div>

                            <div class="excel-field">
                                <label asp-for="MovementTypeId">Movement Type</label>
                                <select asp-for="MovementTypeId" asp-items="Model.MovementTypes">
                                    <option value="">Select...</option>
                                </select>
                            </div>

                            <!-- ===== BL Numbers & Issue ===== -->
                            <div class="excel-field">
                                <label asp-for="BLNo">BL No</label>
                                <input asp-for="BLNo" />
                            </div>

                            <div class="excel-field">
                                <label asp-for="MasterBLNo">Master BL No</label>
                                <input asp-for="MasterBLNo" />
                            </div>

                            <div class="excel-field">
                                <label asp-for="SerialNo"></label>
                                <input asp-for="SerialNo" />
                            </div>

                            <div class="excel-field">
                                <label asp-for="BLIssueDate"></label>
                                <input asp-for="BLIssueDate" type="date" />
                            </div>

                            <div class="excel-field">
                                <label asp-for="PlaceOfIssue"></label>
                                <input asp-for="PlaceOfIssue" />
                            </div>

                            <div class="excel-field">
                                <label asp-for="BLReleaseTypeId">Release Type</label>
                                <select asp-for="BLReleaseTypeId" asp-items="Model.BLReleaseTypes">
                                    <option value="">Select...</option>
                                </select>
                            </div>

                            <div class="excel-field">
                                <label asp-for="ReleaseDate"></label>
                                <input asp-for="ReleaseDate" type="date" />
                            </div>

                            <!-- ===== Parties & Payment ===== -->
                            <div class="excel-field">
                                <label asp-for="CarrierId">Carrier</label>
                                <select asp-for="CarrierId" asp-items="Model.Carriers">
                                    <option value="">Select...</option>
                                </select>
                            </div>
                            <div class="excel-field">
                                <label class="form-label">Issuer Party</label>
                                <select id="IssuerPartySelect2" name="IssuerPartyId" class="form-select form-select-sm">
                                    @if (Model.IssuerPartyId != Guid.Empty)
                                    {
                                        <option value="@Model.IssuerPartyId" selected>@Model.IssuerPartyName</option>
                                    }
                                </select>
                            </div>
                            <div class="excel-field">
                                <label asp-for="PaymentTypeId">Payment Type</label>
                                <select asp-for="PaymentTypeId" asp-items="Model.PaymentTypes">
                                    <option value="">Select...</option>
                                </select>
                            </div>

                            <!-- ===== Copies / Incoterm ===== -->
                            <div class="excel-field">
                                <label asp-for="OriginalCount">Original Count</label>
                                <input asp-for="OriginalCount" type="number" />
                            </div>

                            <div class="excel-field">
                                <label asp-for="CopyCount">Copy Count</label>
                                <input asp-for="CopyCount" type="number" />
                            </div>

                            <div class="excel-field">
                                <label asp-for="IncotermId">Incoterm</label>
                                <select asp-for="IncotermId" asp-items="Model.Incoterms">
                                    <option value="">Select...</option>
                                </select>
                            </div>

                            <!-- ===== Checkboxes (به‌صورت سلول اکسلی، یکسان با بقیه) ===== -->
                            <div class="excel-field">
                                <label asp-for="IssuedByUs"></label>
                                <input asp-for="IssuedByUs" type="checkbox" class="excel-checkbox" />
                            </div>

                            <div class="excel-field">
                                <label asp-for="IsSwitched"></label>
                                <input asp-for="IsSwitched" type="checkbox" class="excel-checkbox" />
                            </div>

                            @* فیلدهای کامنت‌شده (BLStatusId و FreightTerms) عمداً منتقل نشدند *@
                        </div>
                    </div>
                </div>
            </section>
            <section class="bl-card">
                <div id="partiesCollapse">
                    <div class="bl-card-body">
                        <h6>2)Parties:</h6>
                        <div class="aligned-excel-grid">
                            <div class="excel-field">
                                <label class="form-label">Shipper</label>
                                <select id="ShipperSelect2" name="ShipperId" class="form-select form-select-sm">
                                    @if (Model.ShipperPartyId != Guid.Empty)
                                    {
                                        <option value="@Model.ShipperPartyId" selected>@Model.ShipperPartyName</option>
                                    }
                                </select>
                            </div>

                            <div class="excel-field">
                                <label class="form-label">Consignee</label>
                                <select id="ConsigneeSelect2" name="ConsigneeId" class="form-select form-select-sm">
                                    @if (Model.ConsigneePartyId != Guid.Empty)
                                    {
                                        <option value="@Model.ConsigneePartyId" selected>@Model.ConsigneePartyName</option>
                                    }
                                </select>
                            </div>

                            <div class="excel-field">
                                <label class="form-label">Notify</label>
                                <select id="NotifySelect2" name="NotifyId" class="form-select form-select-sm">
                                    @if (Model.NotifyPartyId != Guid.Empty)
                                    {
                                        <option value="@Model.NotifyPartyId" selected>@Model.NotifyPartyName</option>
                                    }
                                </select>
                            </div>

                            <!-- ==================== ROW 2: Addresses ==================== -->
                            <div class="excel-field">
                                <label asp-for="ShipperTextInBL">Shipper (Text)</label>
                                <textarea asp-for="ShipperTextInBL" id="ShipperTextInBL" data-fill-if-empty="true" rows="4"></textarea>
                            </div>

                            <div class="excel-field">
                                <label asp-for="ConsigneeTextInBL">Consignee (Text)</label>
                                <textarea asp-for="ConsigneeTextInBL" id="ConsigneeTextInBL" data-fill-if-empty="true" rows="4"></textarea>
                            </div>

                            <div class="excel-field">
                                <label asp-for="NotifyPartyTextInBL">Notify (Text)</label>
                                <textarea asp-for="NotifyPartyTextInBL" id="NotifyPartyTextInBL" data-fill-if-empty="true" rows="4"></textarea>
                            </div>

                        </div>
                    </div>
                </div>
            </section>
            <section class="bl-card">
                <div id="routingCollapse">
                    <div class="bl-card-body">
                        <h6>3)Routing Information:</h6>
                        <div class="excel-grid">

                            <div class="excel-field">
                                <label class="form-label">Place Of Receipt</label>
                                <select id="PORSelect2" name="PORId" class="form-select form-select-sm">
                                    @if (Model.PORId != Guid.Empty)
                                    {
                                        <option value="@Model.PORId" selected>@Model.PORName</option>
                                    }
                                </select>
                                <input asp-for="PORText" id="porText" placeholder="P.O.Receipt Text" />
                            </div>

                            <div class="excel-field">
                                <label class="form-label">POL</label>
                                <select id="POLSelect2" name="POLId" class="form-select form-select-sm">
                                    @if (Model.POLId != Guid.Empty)
                                    {
                                        <option value="@Model.POLId" selected>@Model.POLName</option>
                                    }
                                </select>
                                <input asp-for="POLText" id="polText" placeholder="POL Text in BL" />
                            </div>

                            <!-- POD: label + search + its text -->
                            <div class="excel-field">
                                <label class="form-label">POD</label>
                                <select id="PODSelect2" name="PODId" class="form-select form-select-sm">
                                    @if (Model.PODId != Guid.Empty)
                                    {
                                        <option value="@Model.PODId" selected>@Model.PODName</option>
                                    }
                                </select>
                                <input asp-for="PODText" id="podText" placeholder="POD Text in BL" />
                            </div>


                            <!-- Place Of Delivery -->
                            <div class="excel-field">
