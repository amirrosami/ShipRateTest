            function syncTransportPanels() {
                const selected = transportSelect?.value;

                // نگاشت انواع حمل به پنل‌هایی که باید فعال و نمایش داده شوند
                // مقادیر آرایه‌ها همان مقادیر data-transport-panel در HTML هستند (مثلاً "1" برای دریایی، "2" برای جاده‌ای و ...)
                const transportModesMap = {
                    "1": ["1"],               // Sea
                    "2": ["2"],               // Road
                    "3": ["3"],               // Rail
                    "4": ["4"],               // Air
                    "5": ["1", "2", "3","4"]      // MultiModal -> فعال‌سازی همزمان
                };

                // لیست پنل‌هایی که برای مد انتخاب‌شده باید فعال باشند
                const activePanels = transportModesMap[selected] || [];

                document.querySelectorAll('[data-transport-panel]').forEach(panel => {
                    const panelType = panel.dataset.transportPanel;
                    const isActive = activePanels.includes(panelType);

                    // ۱. نمایش یا مخفی کردن پنل
                    panel.hidden = !isActive;

                    // ۲. فعال یا غیرفعال کردن اینپوت‌ها و دکمه‌ها
                    // (این کار مانع از ارسال مقادیر فرم پنل‌های مخفی به سرور می‌شود)
                    panel.querySelectorAll('input, select, textarea, button').forEach(el => {
                        // اگر ردیف جدید ذخیره‌نشده است، دکمه allocate باید همچنان غیرفعال بماند
                        if (el.classList.contains('disabled') && el.hasAttribute('disabled') && !isActive) {
                            el.disabled = true;
                            return;
                        }

                        el.disabled = !isActive;
                    });
                });
            }







