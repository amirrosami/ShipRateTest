@using ShipRate.Application.ViewModels
@model ContainerAllocationModalVm

<style>
    /* استایل جهت وضوح کامل چک‌باکس در حالت Focus و Checked */
    .container-allocation-table .form-check-input {
        cursor: pointer;
        width: 1.15rem;
        height: 1.15rem;
        border: 2px solid #6c757d;
    }

        .container-allocation-table .form-check-input:checked {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }

        .container-allocation-table .form-check-input:focus {
            border-color: #0a58ca !important;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.4) !important;
        }

        .container-allocation-table .form-check-input:disabled {
            cursor: not-allowed;
            background-color: #e9ecef;
            border-color: #ced4da;
        }

    .container-allocation-table tr.cursor-pointer:hover {
        background-color: rgba(13, 110, 253, 0.05);
    }
</style>

<form hx-post="@Url.Action("SaveContainerAllocation", "TransportDocuments")"
      hx-target="#containerAllocationModalContent"
      hx-swap="innerHTML">
    @Html.AntiForgeryToken()
    <input type="hidden" name="BLId" value="@Model.BLId" />
    <input type="hidden" name="RoadTripId" value="@Model.RoadTripId" />

    <div class="modal-header">
        <h5 class="modal-title fs-6">
            <i class="bi bi-truck me-1"></i> Allocate Containers to Truck:
            <strong class="text-primary">@(Model.TruckNo ?? "N/A")</strong>
            @if (!string.IsNullOrEmpty(Model.DriverName))
            {
                <span class="text-muted fw-normal fs-7">(@Model.DriverName)</span>
            }
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body p-3">
        @if (!Model.AvailableContainers.Any())
        {
            <div class="alert alert-warning mb-0 py-2 fs-7">
                <i class="bi bi-exclamation-triangle me-1"></i> No containers found in this B/L to allocate.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0 fs-7 container-allocation-table">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 45px;" class="text-center">#</th>
                            <th>Container No</th>
                            <th>Type</th>
                            <th>Gross Weight</th>
                            <th>Packages</th>
                            <th>Current Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.AvailableContainers.Count; i++)
                        {
                            var c = Model.AvailableContainers[i];
                            var isAllocatedOther = !string.IsNullOrEmpty(c.AllocatedToOtherTruck);

                            <tr class="@(c.IsAllocatedToThisTrip ? "table-primary" : "") @(!isAllocatedOther ? "cursor-pointer" : "")"
                                onclick="toggleContainerRow(event, '@c.ContainerId', @(isAllocatedOther ? "true" : "false"))">
                                <td class="text-center">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="SelectedContainerIds"
                                           value="@c.ContainerId"
                                           id="chk_@c.ContainerId"
                                           @(c.IsAllocatedToThisTrip ? "checked" : "")
                                           @(isAllocatedOther ? "disabled" : "")
                                           onchange="updateRowHighlight(this)" />
                                </td>
                                <td>
                                    <label class="form-check-label fw-bold @(!isAllocatedOther ? "cursor-pointer" : "text-muted")" for="chk_@c.ContainerId">
                                        @c.ContainerNo
                                    </label>
                                </td>
                                <td>@(c.ContainerTypeName ?? "-")</td>
                                <td>@c.GrossWeight.ToString("N2") kg</td>
                                <td>@c.PackageCount</td>
                                <td>
                                    @if (c.IsAllocatedToThisTrip)
                                    {
                                        <span class="badge bg-success">Allocated here</span>
                                    }
                                    else if (isAllocatedOther)
                                    {
                                        <span class="badge bg-secondary">On Truck: @c.AllocatedToOtherTruck</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">Available</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="modal-footer py-2">
        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-sm btn-primary" @(!Model.AvailableContainers.Any() ? "disabled" : "")>
            <i class="bi bi-check-lg me-1"></i> Save Allocation
        </button>
    </div>
</form>

<script>
    // تغییر رنگ و هایلایت سطر در لحظه تیک خوردن
    function updateRowHighlight(checkbox) {
        const row = checkbox.closest('tr');
        if (checkbox.checked) {
            row.classList.add('table-primary');
        } else {
            row.classList.remove('table-primary');
        }
    }

    // امکان تیک زدن با کلیک روی هر جای سطر به جز خود چک‌باکس و لیبل
    function toggleContainerRow(event, containerId, isDisabled) {
        if (isDisabled) return;
        if (event.target.tagName === 'INPUT' || event.target.tagName === 'LABEL') return;

        const chk = document.getElementById('chk_' + containerId);
        if (chk && !chk.disabled) {
            chk.checked = !chk.checked;
            updateRowHighlight(chk);
        }
    }
</script>
