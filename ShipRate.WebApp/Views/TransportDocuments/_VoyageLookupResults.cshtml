@using ShipRate.Application.ViewModels
@model IReadOnlyList<VoyageLookupItemVm>

@if (Model.Count == 0)
{
    <div class="text-muted small">
        No voyages found.
    </div>
}
else
{
    <div class="list-group">
        @foreach (var voyage in Model)
        {
            <button type="button"
                    class="list-group-item list-group-item-action btn-choose-voyage"
                    data-voyage-id="@voyage.Id"
                    data-vessel-name="@voyage.VesselName"
                    data-voyage-no="@voyage.VoyageNo"
                    data-display-text="@($"{voyage.VesselName} - {voyage.VoyageNo}")">

                <div class="fw-semibold">@voyage.VesselName</div>
                <div class="small text-muted">@voyage.VoyageNo</div>
            </button>
        }
    </div>
}
