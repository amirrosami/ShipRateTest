@using ShipRate.Application.ViewModels
@model BLManagePageVm



<style>
    /* اطمینان از قرارگیری منو بالای تمامی لایه‌ها */
    .dropdown-menu {
        z-index: 1060 !important;
    }
    
    /* حداقل ارتفاع برای کانتینر جدول تا حتی اگر 1 ردیف باشد منو بیرون نزند */
    #blList {
        min-height: 500px;
    }
</style>


<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Transport Documents(Including BL-CMR-AWBL-MTD-FWB-INLAND)</span>
         <a class="btn btn-primary"
           href="@Url.Action("Create", "TransportDocuments", new {
               jobId = Model.Context.JobId
           })">
            + New Transport Document
        </a>
    </div>

    <div id="blList"
         hx-get="@Url.Action("List", "TransportDocuments", new {
             jobId = Model.Context.JobId,
             bookingId = Model.Context.BookingId,
             shipmentId = Model.Context.ShipmentId,
             shipmentLegId = Model.Context.ShipmentLegId
         })"
         hx-trigger="blSaved from:body, blDeleted from:body"
         hx-swap="innerHTML">
        @await Html.PartialAsync("~/Views/TransportDocuments/_BLList.cshtml", Model)
    </div>
</div>



<div class="modal fade" id="documentManagerModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content" id="document-manager-content">
        </div>
    </div>
</div>








