@using ShipRate.Application.DTOs
@model CorrespondenceCreateDto

<style>
    .modal-header-custom {
        background: linear-gradient(135deg, #10b981, #059669);
        color: #fff;
    }
    .success-banner {
        background: #dcfce7;
        border: 1px solid #86efac;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        margin-bottom: 1rem;
        color: #166534;
        font-weight: 600;display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }
    .form-grid-full {
        grid-column: 1 / -1;
    }
    @@media (max-width: 768px) {
        .form-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="modal-header modal-header-custom">
    <h5 class="modal-title">
        <i class="bi bi-plus-circle me-2"></i>ایجاد مکاتبه جدید
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">
    @if (ViewBag.SuccessMessage != null)
    {
        <div class="success-banner">
            <i class="bi bi-check-circle-fill"></i>
            @ViewBag.SuccessMessage
        </div>
        <div class="mb-3">
            <button type="button" 
                    class="btn btn-success w-100"
                    onclick="alert('قابلیت الحاق مستندات به زودی...')">
                <i class="bi bi-paperclip me-2"></i>الحاق مستندات
            </button>
        </div>
        <hr>
    }

    <form hx-post="@Url.Action("Create")" 
          hx-target="#modal-content"
          hx-swap="innerHTML">
        
        <div class="form-grid">
            <div class="form-group">
                <label>شرکت <span class="text-danger">*</span></label>
                <select asp-for="CompanyId" class="form-select" required>
                    <option value="">انتخاب کنید</option>
                    @foreach (var item in ViewBag.Companies)
                    {
                        <option value="@item.Id">@item.PersonName</option>
                    }
                </select>
                <span asp-validation-for="CompanyId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>ورودی/خروجی <span class="text-danger">*</span></label>
                <select asp-for="InOutId" class="form-select" required>
                    <option value="">انتخاب کنید</option>
                    @foreach (var item in ViewBag.InOuts)
                    {
                        <option value="@item.Id">@item.InOutName</option>
                    }
                </select>
                <span asp-validation-for="InOutId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>فرستنده/گیرنده</label>
                <select asp-for="SenderReceiverId" class="form-select">
                    <option value="">انتخاب کنید</option>
                    @foreach (var item in ViewBag.Persons)
                    {
                        <option value="@item.Id">@item.PersonName</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>عنوان فرستنده/گیرنده</label>
                <input asp-for="SenderReceiverTitle" class="form-control" placeholder="در صورت عدم انتخاب از لیست"></div>

            <div class="form-group">
                <label>شماره مکاتبه <span class="text-danger">*</span></label>
                <input asp-for="CorrespondenceNo" class="form-control" required>
                <span asp-validation-for="CorrespondenceNo" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>تاریخ مکاتبه <span class="text-danger">*</span></label>
                <input asp-for="CorrespondenceDate" type="date" class="form-control" required>
                <span asp-validation-for="CorrespondenceDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>موضوع</label>
                <select asp-for="SubjectId" class="form-select">
                    <option value="">انتخاب کنید</option>
                    @foreach (var item in ViewBag.Subjects)
                    {
                        <option value="@item.Id">@item.SubjectTitle</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>متن آزاد موضوع <span class="text-danger">*</span></label>
                <input asp-for="SubjectFreeText" class="form-control" required>
                <span asp-validation-for="SubjectFreeText" class="text-danger"></span>
            </div>

            <div class="form-group form-grid-full">
                <label>کلمات کلیدی</label>
                <input asp-for="Keywords" class="form-control" placeholder="با کاما جدا کنید">
            </div>
        </div>

        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
            <button type="submit" class="btn btn-success">
                <i class="bi bi-check-circle me-1"></i>ذخیره
            </button>
        </div>
    </form>
</div>