@using ShipRate.Application.ViewModels
@model TariffIndexVm
@{
    ViewData["Title"] = "Tariff Management";
}
<div class="container-fluid py-3" dir="ltr">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0">Tariff Management</h4>
            <div class="text-muted small">
                Manage tariff books, tariff rules and coverages
            </div>
        </div>
    </div>
    <div class="card border-0 shadow-sm mb-2">
        <div class="card-body py-2 px-3">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-5 col-lg-4 col-xl-3">
                    <label for="TariffTypeSelector" class="form-label small text-muted mb-1">
                        Tariff Type
                    </label>

                    <select id="TariffTypeSelector"
                            class="form-select form-select-sm"
                            name="TariffTypeId"
                            hx-get="@Url.Action("Grid", "TariffBooks")"
                            hx-target="#tariffBooksGrid"
                            hx-swap="innerHTML"
                            hx-trigger="change"
                            hx-vals='{"Page":"1","PageSize":"@Model.Search.PageSize"}'
                            onchange="
                                        var selectedOption = this.options[this.selectedIndex];

                                        document.getElementById('SelectedTariffTypeId').value = this.value;

                                        document.getElementById('selectedTariffTypeTitle').innerText =
                                            selectedOption && selectedOption.value ? selectedOption.text : 'None';

                                        document.getElementById('tariffRulesGrid').innerHTML = '';
                                        document.getElementById('tariffRuleCoveragesGrid').innerHTML = '';
                                    ">
                        <option value="">Select tariff type...</option>

                        @if (Model.Search.TariffTypes != null && Model.Search.TariffTypes.Any())
                        {
                            foreach (var item in Model.Search.TariffTypes)
                            {
                                <option value="@item.Value"
                                        selected="@(Model.Search.TariffTypeId.ToString() == item.Value)">
                                    @item.Text
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-12 col-md-auto">
                    <div class="small text-muted mb-1">Selected Tariff Type</div>
                    <div class="fw-semibold small" id="selectedTariffTypeTitle">
                        @{
                            var selectedTariffType = Model.Search.TariffTypes?
                            .FirstOrDefault(x => x.Value == Model.Search.TariffTypeId.ToString());
                        }
                        @(selectedTariffType?.Text ?? "None")
                    </div>
                </div>
            </div>
        </div>
    </div>
    <input type="hidden"
           id="SelectedTariffTypeId"
           name="SelectedTariffTypeId"
           value="@Model.Search.TariffTypeId" />

    <div id="tariffBooksGrid" class="mt-3">
    </div>

    <div id="tariffRulesGrid" class="mt-3"></div>
    <div id="tariffRuleCoveragesGrid" class="mt-3"></div>
</div>
<div class="modal fade" id="documentManagerModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content" id="document-manager-content">
        </div>
    </div>
</div>
@await Html.PartialAsync("_ModalContainer")



