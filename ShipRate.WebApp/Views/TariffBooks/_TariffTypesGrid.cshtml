@using ShipRate.Application.DTOs
@using ShipRate.Application.ViewModels
@model List<TariffTypeVm>

<div class="card border-0 shadow-sm" dir="ltr">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <div>
            <strong>Tariff Types</strong>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Local Name</th>
                        <th style="width: 160px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                        @foreach (var item in Model)
                        {
                            <tr id="tarifftype-row-@item.Id">
                            <td>@item.TariffTypeName</td>
                            <td>@item.TariffTypeLocalName</td>
                            <td>
                                    <div class="btn-group btn-group-sm">
                                        <button type="button"
                                                class="btn btn-outline-primary"
                                                hx-get="@Url.Action("TariffTypes", "TariffBooks", new { tariffBookId = item.Id })"
                                                hx-target="#tariffTypesGrid"
                                                hx-swap="innerHTML">
                                            Select
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                </tbody>
            </table>
        </div>
    </div>
</div>
