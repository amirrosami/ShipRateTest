@using ShipRate.Application.ViewModels
@model TariffBookFormVm

@{
    var isEdit = Model.Id.HasValue && Model.Id.Value != Guid.Empty;
    var actionName = isEdit ? "Edit" : "Create";
    var modalTitle = isEdit ? "Edit Tariff Book" : "Create Tariff Book";
}

<form method="post"
      hx-post="@Url.Action(actionName, "TariffBooks")"
      hx-target="#mainModalContent"
      hx-swap="innerHTML"
      dir="ltr">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="TariffTypeId" />

    @if (isEdit)
    {
        <input type="hidden" asp-for="Id" />
    }

    <div class="modal-header">
        <h5 class="modal-title">
            @modalTitle
        </h5>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="Close">
        </button>
    </div>

    <div class="modal-body">

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"
             role="alert">
        </div>

        <div class="row g-3">

            <div class="col-md-4">
                <label asp-for="Code" class="form-label">Code</label>
                <input asp-for="Code"
                       class="form-control"
                       autocomplete="off" />
                <span asp-validation-for="Code" class="text-danger small"></span>
            </div>

            <div class="col-md-8">
                <label asp-for="Name" class="form-label">Name</label>
                <input asp-for="Name"
                       class="form-control"
                       autocomplete="off" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="PartyId" class="form-label">Party</label>

                <input type="hidden"
                       asp-for="PartyId"
                       id="TariffBookPartyId" />

                <input type="text"
                       id="TariffBookPartySearchText"
                       name="PartyName"
                       value="@Model.PartyDisplayName"
                       class="form-control"
                       placeholder="Search party..."
                       autocomplete="off"
                       hx-get="@Url.Action("SearchParties", "TariffBooks")"
                       hx-trigger="keyup changed delay:400ms"
                       hx-target="#tariffBookPartySearchResults"
                       hx-swap="innerHTML"
                       hx-vals='js:{
                            term: document.getElementById("TariffBookPartySearchText").value,
                            targetHiddenInputId: "TariffBookPartyId",
                            targetTextInputId: "TariffBookPartySearchText"
                       }' />

                <div id="tariffBookPartySearchResults"
                     class="position-relative">
                </div>

                <span asp-validation-for="PartyId" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="CurrencyId" class="form-label">Currency</label>
                <select asp-for="CurrencyId"
                        asp-items="Model.Currencies"
                        class="form-select">
                    <option value="">Select...</option>
                </select>
                <span asp-validation-for="CurrencyId" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="ValidFrom" class="form-label">Valid From</label>
                <input asp-for="ValidFrom"
                       type="date"
                       class="form-control" />
                <span asp-validation-for="ValidFrom" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="ValidTo" class="form-label">Valid To</label>
                <input asp-for="ValidTo"
                       type="date"
                       class="form-control" />
                <span asp-validation-for="ValidTo" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="3">
                </textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
            @*<div class="col-12">
                        <div class="form-check">
                            <input asp-for="IsActive"
                                   class="form-check-input"
                                   type="checkbox" />

                            <label asp-for="IsActive"
                                   class="form-check-label">
                                Active
                            </label>
                        </div>
            </div>*@
        </div>
    </div>

    <div class="modal-footer">
        <button type="button"
                class="btn btn-outline-secondary"
                data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit"
                class="btn btn-primary">
            Save
        </button>
    </div>
</form>
