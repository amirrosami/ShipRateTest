@model ShipRate.Application.ViewModels.TariffThcRuleBatchFormVm

<div class="modal-header">
    <h5 class="modal-title">Batch THC Rates Setup - @Model.TariffBookTitle</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form hx-post="@Url.Action("SaveThcRules", "TariffBooks")"
      hx-target="#mainModalContent"
      hx-swap="innerHTML"
      autocomplete="off">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="TariffBookId" />

    <div class="modal-body">
        <!-- Header Filters: Location & Currency -->
        <div class="row g-3 mb-3">
            <div class="col-md-7">
                <label class="form-label small fw-semibold">Location / Terminal</label>
                <input type="hidden" asp-for="LocationId" id="ThcLocationId" value="@Model.LocationId" />
                <input type="text"
                       class="form-control form-control-sm"
                       placeholder="Search Port / Terminal..."
                       id="thcLocationSearchInput"
                       value="@Model.LocationName"
                       name="term"
                       hx-get="@Url.Action("SearchLocations", "TariffBooks")"
                       hx-trigger="keyup changed delay:300ms"
                       hx-target="#thcLocationSearchResults"
                       autocomplete="off" />
                <div id="thcLocationSearchResults" class="position-relative"></div>
                <span asp-validation-for="LocationId" class="text-danger small"></span>
            </div>

            <div class="col-md-5">
                <label asp-for="CurrencyId" class="form-label small fw-semibold">Currency</label>
                <select asp-for="CurrencyId" asp-items="Model.Currencies" class="form-select form-select-sm"></select>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="mb-0 text-muted fw-semibold">Rates Matrix</h6>
            <div class="btn-group">
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        hx-post="@Url.Action("AddThcRuleRow", "TariffBooks")"
                        hx-include="closest form"
                        hx-target="#thcRateRowsContainer">
                    <i class="bi bi-plus-lg"></i> Add Row
                </button>
            </div>
        </div>

        <!-- Validation Summary -->
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-1 px-2 small mb-2"></div>

        <!-- Rows Grid Container با قابلیت اسکرول عمودی -->
        <div id="thcRateRowsContainer"
             class="border rounded overflow-y-auto"
             style="max-height: 52vh; min-height: 220px;">
            @await Html.PartialAsync("_ThcRateRowsGrid", Model)
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-sm btn-primary">
            <span class="spinner-border spinner-border-sm htmx-indicator me-1"></span> Save THC Rates
        </button>
    </div>
</form>
