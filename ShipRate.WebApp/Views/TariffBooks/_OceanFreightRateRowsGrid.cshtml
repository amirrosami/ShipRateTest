@using ShipRate.Application.ViewModels
@model OceanFreightRuleBatchFormVm

<div class="table-responsive">
    <table class="table table-sm table-bordered align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th style="width: 26%;">Container Type</th>
                <th style="width: 26%;">Charge Type</th>
                <th style="width: 18%;">Amount</th>
                <th style="width: 22%;">Extra</th>
                <th class="text-center" style="width: 8%;">Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Rows != null && Model.Rows.Any())
            {
                for (var i = 0; i < Model.Rows.Count; i++)
                {
                    <tr data-rate-row="true">
                        <td>
                            <select name="Rows[@i].ContainerSizeTypeId"
                                    class="form-select form-select-sm">
                                <option value="">Select...</option>

                                @foreach (var item in Model.ContainerSizeTypes)
                                {
                                    var selected = item.Value == Model.Rows[i].ContainerSizeTypeId?.ToString();

                                    <option value="@item.Value" selected="@selected">
                                        @item.Text
                                    </option>
                                }
                            </select>
                        </td>

                        <td>
                            <select name="Rows[@i].ChargeTypeId"
                                    class="form-select form-select-sm">
                                <option value="">Select...</option>

                                @foreach (var item in Model.ChargeTypes)
                                {
                                    var selected = item.Value == Model.Rows[i].ChargeTypeId?.ToString();

                                    <option value="@item.Value" selected="@selected">
                                        @item.Text
                                    </option>
                                }
                            </select>
                        </td>

                        <td>
                            <input name="Rows[@i].Amount"
                                   value="@Model.Rows[i].Amount"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control form-control-sm text-end" />
                        </td>

                        <td>
                            <input name="Rows[@i].ExtraAttributes"
                                   value="@Model.Rows[i].ExtraAttributes"
                                   class="form-control form-control-sm" />
                        </td>

                        <td class="text-center">
                            <button type="button"
                                    class="btn btn-outline-danger btn-sm"
                                    hx-post="@Url.Action("RemoveOceanFreightRuleRow", "TariffBooks", new { rowIndex = i })"
                                    hx-target="#oceanFreightRowsGrid"
                                    hx-include="#oceanFreightRuleBatchForm">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-3">
                        No rate rows.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
