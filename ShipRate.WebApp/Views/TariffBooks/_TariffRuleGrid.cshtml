            <table class="table table-sm table-hover table-striped mb-0 align-middle">
                <thead class="table-light">
                    @if (tariffTypeId == 1)
                    {
                        <tr>
                            <th class="py-2">Charge Type</th>
                            <th class="py-2">Origin</th>
                            <th class="py-2">Destination</th>
                            <th class="py-2">Calculation By</th>
                            <th class="py-2">Calculation Type</th>
                            <th class="py-2">Container Size Type</th>
                            <th class="py-2">Currency</th>
                            <th class="py-2">Amount</th>
                            <th class="py-2" style="width: 130px;">Actions</th>
                        </tr>
                    }
                    else if (tariffTypeId == 3)
                    {
                        <tr>
                            <th class="py-2">Container Size Type</th>
                            <th class="py-2">From</th>
                            <th class="py-2">To</th>
                            <th class="py-2">Amount</th>
                            <th class="py-2">Currency</th>
                        </tr>
                    }
                    else if (tariffTypeId == 4)
                    {
                        <tr>
                            <th class="py-2">Location / Terminal</th>
                            <th class="py-2">Shipment Type</th>
                            <th class="py-2">Container Size Type</th>
                            <th class="py-2">Full/MT</th>
                            <th class="py-2 text-center">Flags (DG / OOG / OW)</th>
                            <th class="py-2">Currency</th>
                            <th class="py-2 text-end">Amount</th>
                            <th class="py-2 text-center" style="width: 90px;">Actions</th>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <th class="py-2">Charge Type</th>
                            <th class="py-2">Calculation By</th>
                            <th class="py-2">Calculation Type</th>
                            <th class="py-2">Container Size Type</th>
                            <th class="py-2">Currency</th>
                            <th class="py-2">Min</th>
                            <th class="py-2">Max</th>
                            <th class="py-2">Amount</th>
                            <th class="py-2" style="width: 130px;">Actions</th>
                        </tr>
                    }
                </thead>

                <tbody>
                    @if (Model == null || !Model.Items.Any())
                    {
                        <tr>
                            <td colspan="@emptyColspan" class="text-center text-muted py-3">
                                No tariff rules found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr id="tariff-rule-row-@item.Id">
                                @if (tariffTypeId == 1)
                                {
                                    <td class="py-2">
                                        @item.ChargeTypeName
                                        @if (item.ChargeTypeId == 555)
                                        {
                                            <span class="badge bg-info text-dark ms-1">Coverage</span>
                                        }
                                    </td>
                                    <td class="py-2">@item.OriginName</td>
                                    <td class="py-2">@item.DestinationName</td>
                                    <td class="py-2">@item.CalculationByName</td>
                                    <td class="py-2">@item.CalculationTypeName</td>
                                    <td class="py-2">@item.ContainerSizeTypeName</td>
                                    <td class="py-2">@item.CurrencyCode</td>
                                    <td class="py-2">@item.Amount.ToString("N2")</td>
                                    <td class="py-2">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button"
                                                    class="btn btn-outline-primary py-0 px-2"
                                                    hx-get="@Url.Action("CoveragesGrid", "TariffBooks", new { tariffRuleId = item.Id })"
                                                    hx-target="#tariffRuleCoveragesGrid"
                                                    hx-swap="innerHTML">
                                                Select
                                            </button>

                                            <button type="button"
                                                    class="btn btn-outline-secondary py-0 px-2"
                                                    hx-get="@Url.Action("EditRule", "TariffBooks", new { id = item.Id })"
                                                    hx-target="#mainModalContent"
                                                    hx-swap="innerHTML"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#mainModal">
                                                Edit
                                            </button>

                                            <button type="button"
                                                    class="btn btn-outline-danger py-0 px-2"
                                                    hx-get="@Url.Action("DeleteRule", "TariffBooks", new { id = item.Id, tariffBookId = item.TariffBookId })"
                                                    hx-target="#mainModalContent"
                                                    hx-swap="innerHTML"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#mainModal">
                                                Delete
                                            </button>
                                        </div>
                                    </td>
                                }
                                else if (tariffTypeId == 3)
                                {
                                    <td class="py-2">@item.ContainerSizeTypeName</td>
                                    <td class="py-2">@(item.FromValue.HasValue? item.FromValue.Value.ToString("N0") : "-")</td>
                                    <td class="py-2">@(item.ToValue.HasValue? item.ToValue.Value.ToString("N0") : "-")</td>
                                    <td class="py-2">@item.Amount.ToString("N0")</td>
                                    <td class="py-2">@item.CurrencyCode</td>
                                }
                                else if (tariffTypeId == 4)
                                {
                                    <td class="py-2">@(item.OriginName ?? item.DestinationName ?? "-")</td>
                                    <td class="py-2">@item.TradeTypeName</td>
                                    <td class="py-2 fw-semibold">@item.ContainerSizeTypeName</td>
                                    <td class="py-2 fw-semibold">@item.FullMTName</td>
                                    <td class="py-2 text-center">
                                        @if (item.IsDG == true)
                                        {
                                            <span class="badge bg-danger" title="Dangerous Goods">DG</span>
                                        }
                                        @if (item.IsOverSized == true)
                                        {
                                            <span class="badge bg-warning text-dark" title="Out of Gauge">OOG</span>
                                        }
                                        @if (item.IsOverWeight == true)
                                        {
                                            <span class="badge bg-secondary" title="Overweight">OW</span>
                                        }
                                        @if (item.IsDG != true && item.IsOverSized != true && item.IsOverWeight != true)
                                        {
                                            <span class="text-muted small">Standard</span>
                                        }
                                    </td>
                                    <td class="py-2">@item.CurrencyCode</td>
                                    <td class="py-2 text-end fw-bold">@item.Amount.ToString("N2")</td>
                                    <td class="py-2 text-center">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button"
                                                    class="btn btn-outline-danger py-0 px-2"
                                                    hx-get="@Url.Action("DeleteRule", "TariffBooks", new { id = item.Id, tariffBookId = item.TariffBookId })"
                                                    hx-target="#mainModalContent"
                                                    hx-swap="innerHTML"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#mainModal">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                }
                                else
                                {
                                    <td class="py-2">
                                        @item.ChargeTypeName
                                        @if (item.ChargeTypeId == 555)
                                        {
                                            <span class="badge bg-info text-dark ms-1">Coverage</span>
                                        }
                                    </td>
                                    <td class="py-2">@item.CalculationByName</td>
                                    <td class="py-2">@item.CalculationTypeName</td>
                                    <td class="py-2">@item.ContainerSizeTypeName</td>
                                    <td class="py-2">@item.CurrencyCode</td>
                                    <td class="py-2">@(item.FromValue.HasValue? item.FromValue.Value.ToString("N2") : "-")</td>
                                    <td class="py-2">@(item.ToValue.HasValue? item.ToValue.Value.ToString("N2") : "-")</td>
                                    <td class="py-2">@item.Amount.ToString("N2")</td>
                                    <td class="py-2">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button"
                                                    class="btn btn-outline-primary py-0 px-2"
                                                    hx-get="@Url.Action("CoveragesGrid", "TariffBooks", new { tariffRuleId = item.Id })"
                                                    hx-target="#tariffRuleCoveragesGrid"
                                                    hx-swap="innerHTML">
                                                Select
                                            </button>

                                            <button type="button"
                                                    class="btn btn-outline-secondary py-0 px-2"
                                                    hx-get="@Url.Action("EditRule", "TariffBooks", new { id = item.Id })"
                                                    hx-target="#mainModalContent"
                                                    hx-swap="innerHTML"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#mainModal">
                                                Edit
                                            </button>

                                            <button type="button"
                                                    class="btn btn-outline-danger py-0 px-2"
                                                    hx-get="@Url.Action("DeleteRule", "TariffBooks", new { id = item.Id, tariffBookId = item.TariffBookId })"
                                                    hx-target="#mainModalContent"
                                                    hx-swap="innerHTML"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#mainModal">
                                                Delete
                                            </button>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model != null && Model.TotalPages > 1 && tariffBookId.HasValue)
    {
        <div class="card-footer bg-white py-2 px-3">
            @await Html.PartialAsync("_Pager", new PagerVm
            {
                Page = Model.PageNumber,
                PageSize = Model.PageSize,
                TotalPages = Model.TotalPages,
                Target = "#tariffRulesGrid",
                Url = Url.Action("RulesGrid", "TariffBooks", new { tariffBookId = tariffBookId.Value })!,
                IncludeFormSelector = null
                })
    </div>
        }
</div>
 *@