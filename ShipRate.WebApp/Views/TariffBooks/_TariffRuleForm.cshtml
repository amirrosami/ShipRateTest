@using ShipRate.Application.ViewModels
@model TariffRuleFormVm

@{
    var isEdit = Model.Id.HasValue && Model.Id.Value != Guid.Empty;
    var actionName = isEdit ? "EditRule" : "CreateRule";
    var modalTitle = isEdit ? "Edit Tariff Rule" : "Create Tariff Rule";
}

<form method="post"
      hx-post="@Url.Action(actionName, "TariffBooks")"
      hx-target="#mainModalContent"
      hx-swap="innerHTML"
      dir="ltr">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="TariffBookId" />

    @if (isEdit)
    {
        <input type="hidden" asp-for="Id" />
    }

    <div class="modal-header">
        <h5 class="modal-title">
            @modalTitle
        </h5>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="Close">
        </button>
    </div>

    <div class="modal-body">

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"
             role="alert">
        </div>

        <div class="row g-3">

            <div class="col-md-12">
                <label asp-for="ChargeTypeId" class="form-label">Charge Type</label>
                <select asp-for="ChargeTypeId"
                        asp-items="Model.ChargeTypes"
                        class="form-select">
                    <option value="">Select...</option>
                </select>
                <span asp-validation-for="ChargeTypeId" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="CalculationById" class="form-label">Calculation By</label>
                <select asp-for="CalculationById"
                        id="CalculationById"
                        asp-items="Model.CalculationByItems"
                        class="form-select">
                    <option value="">Select...</option>
                </select>
                <span asp-validation-for="CalculationById" class="text-danger small"></span>
            </div>


            <div class="col-md-4 tariff-container-size-field d-none">
                <label asp-for="ContainerSizeId" class="form-label">Container Size</label>
                <select asp-for="ContainerSizeId"
                        asp-items="Model.ContainerSizes"
                        class="form-select" id="ContainerSizeId">
                    <option value="">Select...</option>
                </select>
                <span asp-validation-for="ContainerSizeId" class="text-danger small"></span>
            </div>

            <div class="col-md-4 tariff-container-type-field d-none">
                <label asp-for="ContainerSizeTypeId" class="form-label">Container Size Type</label>
                <select asp-for="ContainerSizeTypeId"
                        asp-items="Model.ContainerSizeTypes"
                        class="form-select" id="ContainerSizeTypeId">
                    <option value="">Select...</option>
                </select>
                <span asp-validation-for="ContainerSizeTypeId" class="text-danger small"></span>
            </div>



            <div class="col-md-4">
                <label asp-for="CalculationTypeId" class="form-label">Calculation Type</label>
                <select asp-for="CalculationTypeId"
                        asp-items="Model.CalculationTypes"
                        class="form-select">
                    <option value="">Select...</option>
                </select>
                <span asp-validation-for="CalculationTypeId" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="CurrencyId" class="form-label">Currency</label>
                <select asp-for="CurrencyId"
                        asp-items="Model.Currencies"
                        class="form-select">
                    <option value="">Select...</option>
                </select>
                <span asp-validation-for="CurrencyId" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="FromValue" class="form-label">Min Value</label>
                <input asp-for="FromValue"
                       type="number"
                       step="0.01"
                       class="form-control" />
                <span asp-validation-for="FromValue" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="ToValue" class="form-label">Max Value</label>
                <input asp-for="ToValue"
                       type="number"
                       step="0.01"
                       class="form-control" />
                <span asp-validation-for="ToValue" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Amount" class="form-label">Amount</label>
                <input asp-for="Amount"
                       class="form-control money-input" />
                <span asp-validation-for="Amount" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="EffectiveFrom" class="form-label">Effective From</label>
                <input asp-for="EffectiveFrom"
                       type="date"
                       class="form-control" />
                <span asp-validation-for="EffectiveFrom" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="EffectiveTo" class="form-label">Effective To</label>
                <input asp-for="EffectiveTo"
                       type="date"
                       class="form-control" />
                <span asp-validation-for="EffectiveTo" class="text-danger small"></span>
            </div>

@*             <div class="col-md-4">
                <label asp-for="Priority" class="form-label">Priority</label>
                <input asp-for="Priority"
                       type="number"
                       class="form-control" />
                <span asp-validation-for="Priority" class="text-danger small"></span>
            </div>
 *@


@*             <div class="col-12">
                <label asp-for="Remarks" class="form-label">Remarks</label>
                <textarea asp-for="Remarks"
                          class="form-control"
                          rows="3">
                </textarea>
                <span asp-validation-for="Remarks" class="text-danger small"></span>
            </div>
 *@
            <div class="col-12">
                <div class="form-check">
                    <input asp-for="IsActive"
                           class="form-check-input"
                           type="checkbox" />

                    <label asp-for="IsActive"
                           class="form-check-label">
                        Active
                    </label>
                </div>
            </div>

        </div>
    </div>

    <div class="modal-footer">
        <button type="button"
                class="btn btn-outline-secondary"
                data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit"
                class="btn btn-primary">
            Save
        </button>
    </div>
</form>


<script>
    (function () {
        function updateContainerFields() {
            const calculationBySelect = document.getElementById('CalculationById');

            if (!calculationBySelect) {
                return;
            }

            const value = calculationBySelect.value;

            const sizeWrapper = document.querySelector('.tariff-container-size-field');
            const typeWrapper = document.querySelector('.tariff-container-type-field');

            const sizeSelect = document.getElementById('ContainerSizeId');
            const typeSelect = document.getElementById('ContainerSizeTypeId');

            if (!sizeWrapper || !typeWrapper) {
                return;
            }

            // Reset visibility
            sizeWrapper.classList.add('d-none');
            typeWrapper.classList.add('d-none');

            if (sizeSelect) {
                sizeSelect.disabled = true;
            }

            if (typeSelect) {
                typeSelect.disabled = true;
            }

            // CalculationById = 1 => Size + Type
            if (value === '1') {
                typeWrapper.classList.remove('d-none');
                if (typeSelect) {
                    typeSelect.disabled = false;
                }
            }

            // CalculationById = 2 => Only Size
            else if (value === '2') {
                sizeWrapper.classList.remove('d-none');
                if (sizeSelect) {
                    sizeSelect.disabled = false;
                }

                if (typeSelect) {
                    typeSelect.value = '';
                    typeSelect.disabled = true;
                }
            }

            // Other values => Hide both and clear values
            else {
                if (sizeSelect) {
                    sizeSelect.value = '';
                    sizeSelect.disabled = true;
                }

                if (typeSelect) {
                    typeSelect.value = '';
                    typeSelect.disabled = true;
                }
            }
        }

        const calculationBySelect = document.getElementById('CalculationById');

        if (calculationBySelect) {
            calculationBySelect.removeEventListener('change', updateContainerFields);
            calculationBySelect.addEventListener('change', updateContainerFields);

            // Initial state for Edit mode
            updateContainerFields();
        }
    })();
</script>


