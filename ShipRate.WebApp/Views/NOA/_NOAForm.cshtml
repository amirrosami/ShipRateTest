@using ShipRate.Application.DTOs
@model NOAFormViewModel
@{
    var f = Model.Form;
    bool isEdit = f.Id is not null && f.Id != Guid.Empty;
    bool canCreateCustomerNOA = isEdit && f.InOutId == 1;
}

<style>
    /* ───── گرید Excel-like ───── */
    .excel-grid {
        display: grid;
        gap: 0;
        border: 1px solid #d1d9e0;
    }

    .excel-grid-3 {
        grid-template-columns: repeat(3, 1fr);
    }

    .excel-grid-4 {
        grid-template-columns: repeat(4, 1fr);
    }

    /* ───── فیلد افقی: Label | Input ───── */
    .excel-field {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 6px;
        border: 0.5px solid #d1d9e0;
        background: #fff;
        padding: 3px 6px;
        position: relative;
        width: 100%;
    }

        .excel-field > label {
            width: 130px;
            min-width: 130px;
            font-size: 13px; /* فونت بزرگ‌تر برای Label */
            font-weight: 600;
            margin: 0;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            white-space: nowrap;
            background: #eef6ff;
            padding: 5px 8px;
            border-radius: 3px;
            text-align: start;
            flex-shrink: 0;
        }

    /* باکس دربرگیرنده کنترل جهت پر کردن کامل سلول */
    .excel-input-wrap {
        flex: 1 1 auto;
        width: 100%;
        display: flex;
        align-items: center;
        position: relative;
    }

    .excel-field input,
    .excel-field select,
    .excel-field textarea {
        width: 100% !important;
        font-size: 14px !important; /* فونت بزرگ‌تر برای ورودی‌ها */
        padding: 4px 8px;
    }

    .excel-field select {
        cursor: pointer;
    }

    /* ───── عرض ستون‌ها ───── */
    .excel-field.span-2 {
        grid-column: span 2;
    }

    .excel-field.span-3 {
        grid-column: span 3;
    }

    /* ───── فوکوس زرد فقط روی خود کنترل (Input/Select/Textarea) ───── */
    .excel-field input:focus,
    .excel-field select:focus,
    .excel-field textarea:focus,
    #PartyNameDisplay:focus {
        background-color: #fff9c4 !important; /* زرد کم‌رنگ برای ورودی */
        border-color: #ffc107 !important;
        box-shadow: 0 0 0 0.2rem rgba(255, 193, 7, 0.25) !important;
        outline: none;
    }

    /* ───── پیام‌های خطا ───── */
    .excel-field span.text-danger {
        position: absolute;
        bottom: -6px;
        right: 6px;
        font-size: 11px;
        background: #fff;
        padding: 0 4px;
        border-radius: 2px;
        white-space: nowrap;
        z-index: 2;
    }
</style>




<form hx-post="@Url.Action("Save", "NOA")"
      hx-target="#noa-prices-slot"
      hx-swap="innerHTML"
      hx-indicator="#noa-saving">

    <input type="hidden" asp-for="Form.Id" id="noa-form-id" />
    @Html.HiddenFor(m => m.Form.BLId)
    @Html.HiddenFor(m => m.Form.SequenceNumber)

    <div class="modal-header">
        <h5 class="modal-title">@(isEdit ? "Edit NOA" : "Issue NOA")</h5>
        <div class="ms-auto badge bg-primary">@f.NOANumber</div>
    </div>

    <div class="modal-body">
        <div class="excel-grid excel-grid-3">
            <!-- Row: Header Info -->
            <div class="excel-field span-3 bg-light">
                <div class="fw-bold p-1 text-truncate">BL: @f.BLNumber</div>
            </div>

            <!-- Row 1 -->
            <div class="excel-field">
                <label>Company</label>
                <div class="excel-input-wrap">
                    <select asp-for="Form.CompanyId" class="form-select form-select-sm" asp-items="@(new SelectList(Model.Ref?.Companies ?? new(), "Value", "Text"))"><option value="">--</option></select>
                </div>
            </div>
            <div class="excel-field">
                <label>NOA Type</label>
                <div class="excel-input-wrap">
                    <select asp-for="Form.InOutId" class="form-select form-select-sm" asp-items="@(new SelectList(Model.Ref?.InOuts ?? new(), "Value", "Text"))"><option value="">--</option></select>
                </div>
            </div>

            <div class="excel-field">
                <label>Vessel Name</label>
                <div class="excel-input-wrap"><input asp-for="Form.VesselName" class="form-control form-control-sm" /></div>
            </div>
            <div class="excel-field">
                <label>Voyage No</label>
                <div class="excel-input-wrap"><input asp-for="Form.VoyageNo" class="form-control form-control-sm" /></div>
            </div>

            <!-- Row 2 -->
            <div class="excel-field">
                <label>Arrival Port</label>
                <div class="excel-input-wrap">
                    <select asp-for="Form.ArrivalPortId" class="form-select form-select-sm" asp-items="@(new SelectList(Model.Ref?.ArrivalPorts ?? new(), "Value", "Text"))"><option value="">--</option></select>
                </div>
            </div>
            <div class="excel-field">
                <label>Arrival Date</label>
                <div class="excel-input-wrap"><input asp-for="Form.ArrivalDate" type="date" class="form-control form-control-sm" /></div>
            </div>
            <div class="excel-field">
                <label>Issue Date</label>
                <div class="excel-input-wrap"><input asp-for="Form.IssuedDate" type="date" class="form-control form-control-sm" /></div>
            </div>

            <!-- Row 3 -->
            <div class="excel-field">
                <label>Available Pickup</label>
                <div class="excel-input-wrap"><input asp-for="Form.AvailableForPickupDate" type="date" class="form-control form-control-sm" /></div>
            </div>
            <div class="excel-field">
                <label>Master NOA</label>
                <div class="excel-input-wrap ps-2">
                    <input asp-for="Form.HasMaster" type="checkbox" class="form-check-input" />
                </div>
            </div>
            <div class="excel-field">
                <label>Master No</label>
                <div class="excel-input-wrap"><input asp-for="Form.MasterNOANo" class="form-control form-control-sm" /></div>
            </div>

            <!-- Row 4 -->
            <div class="excel-field">
                <label>Master Recv Date</label>
                <div class="excel-input-wrap"><input asp-for="Form.MasterNOAReceiveDate" type="date" class="form-control form-control-sm" /></div>
            </div>
            <div class="excel-field">
                <label>Discharge Term.</label>
                <div class="excel-input-wrap">
                    <select asp-for="Form.DischargeTerminalId" class="form-select form-select-sm" asp-items="@(new SelectList(Model.Ref?.DischargeTerminals ?? new(), "Value", "Text"))"><option value="">--</option></select>
                </div>
            </div>

            <div class="excel-field">
                <label>THC Rate</label>
                <div class="excel-input-wrap">
                    <input type="text"
                           name="Form.CalcRate"
                           id="Form_CalcRate"
                           value="@(Model.Form?.CalcRate.ToString("N0") ?? "")"
                           class="form-control form-control-sm money-input"
                           autocomplete="off" />
                </div>
            </div>
            <div class="excel-field ">
                <label>Carrier</label>
                <div class="excel-input-wrap">
                    <select asp-for="Form.CarrierId" class="form-select form-select-sm" asp-items="@(new SelectList(Model.Ref?.Carriers ?? new(), "Value", "Text"))"><option value="">--</option></select>
                </div>
            </div>
            <div class="excel-field ">
                <label>Agent</label>
                <div class="excel-input-wrap">
                    <select asp-for="Form.AgentId" class="form-select form-select-sm" asp-items="@(new SelectList(Model.Ref?.Agents ?? new(), "Value", "Text"))"><option value="">--</option></select>
                </div>
            </div>
            <!-- Row 5 -->
            <div class="excel-field span-2">
                <label>Consignee</label>
                <div class="excel-input-wrap">
                    <select asp-for="Form.ConsigneeId" class="form-select form-select-sm" asp-items="@(new SelectList(Model.Ref?.Persons ?? new(), "Value", "Text"))"><option value="">--</option></select>
                </div>
            </div>
            <div class="excel-field span-2">
                <label>Notify Party</label>
                <div class="excel-input-wrap">
                    <select asp-for="Form.NotifyPartyId" class="form-select form-select-sm" asp-items="@(new SelectList(Model.Ref?.Persons ?? new(), "Value", "Text"))"><option value="">--</option></select>
                </div>
            </div>
            <!-- Row 6: TextAreas -->
            <div class="excel-field span-3">
                <label>Special Inst.</label>
                <div class="excel-input-wrap"><textarea asp-for="Form.SpecialInstructions" class="form-control form-control-sm" rows="1"></textarea></div>
            </div>
            <div class="excel-field span-3">
                <label>Remarks</label>
                <div class="excel-input-wrap"><textarea asp-for="Form.Remarks" class="form-control form-control-sm" rows="1"></textarea></div>
            </div>
        </div>
        <div class="modal-footer d-flex justify-content-between align-items-center">
            <div>
                @if (canCreateCustomerNOA)
                {
                    <button type="button"
                            class="btn btn-outline-success btn-sm"
                            hx-post="@Url.Action("CreateOutFromIn", "NOA", new { id = f.Id })"
                            hx-target="#bl-noas-container"
                            hx-swap="innerHTML"
                            hx-confirm="Are you sure you want to create a Customer NOA from this Line NOA?">
                        <i class="bi bi-file-earmark-plus me-1"></i> Create NOA For Customer
                    </button>
                }
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="spinner-border spinner-border-sm htmx-indicator" id="noa-saving"></div>
                <button type="submit" class="btn btn-primary btn-sm">Save & Calculate</button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>


        @*<div class="modal-footer">
            <div class="spinner-border spinner-border-sm htmx-indicator" id="noa-saving"></div>
            <button type="submit" class="btn btn-primary btn-sm">Save & Calculate</button>
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
        </div> *@ 
        <div class="mt-3" id="noa-prices-slot">
            @if (isEdit && Model.PriceGrid != null)
            {
                @await Html.PartialAsync("_PriceGrid", Model.PriceGrid)
            }
        </div>
    </div>

</form>



