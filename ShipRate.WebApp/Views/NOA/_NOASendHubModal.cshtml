@using ShipRate.Application.DTOs
@using ShipRate.Domain.Entities.Messaging
@model NOASendHubViewModel

<div class="p-1">
    <!-- 1. Send Dispatch Form -->
    <div class="card border border-secondary-subtle shadow-sm mb-3">
        <div class="card-header bg-light py-2 px-3 d-flex justify-content-between align-items-center border-bottom border-secondary-subtle">
            <span class="fw-bold small text-dark text-uppercase font-monospace">
                <i class="bi bi-send me-1 text-primary"></i> Send Notice of Arrival
            </span>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace">
                NOA: @Model.NOANumber
            </span>
        </div>
        <div class="card-body p-3 bg-white">
            <form hx-post="@Url.Action("SendDispatch", "NOA")"
                  hx-target="#sendModalBody"
                  hx-swap="innerHTML"
                  hx-indicator="#send-spinner">

                @Html.AntiForgeryToken()
                <input type="hidden" name="NOAId" value="@Model.NOAId" />

                <div class="row g-2 mb-2">
                    <!-- Channel Selector -->
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold font-monospace mb-1">Channel</label>
                        <select name="SendToolTypeId" class="form-select form-select-sm font-monospace" id="channelSelect" onchange="onChannelChange(this)">
                            <option value="1" >Email</option>
                            <option value="2" selected>SMS</option>
                            <option value="3">Portal</option>
                        </select>
                    </div>

                    <!-- Sender Info (Optional / Preset) -->
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold font-monospace mb-1">Sender</label>
                        <input type="text" name="Sender" class="form-control form-control-sm font-monospace bg-light"
                               value="@Model.DefaultSender" placeholder="System / Line Gateway" readonly />
                    </div>

                    <!-- Receiver Target (Mobile/Email) -->
                    <div class="col-md-5">
                        <label class="form-label small fw-semibold font-monospace mb-1" id="receiverLabel">Receiver Mobile</label>
                        <input type="text" name="Receiver" id="receiverInput" class="form-control form-control-sm font-monospace"
                               value="@Model.DefaultMobile" placeholder="" required />
                    </div>
                </div>

                <!-- Custom Note / Message Text -->
                <div class="row g-2 mb-2">
                    <div class="col-12">
                        <label class="form-label small fw-semibold font-monospace mb-1">Message / Notification Note</label>
                        <textarea name="MessageText" class="form-control form-control-sm" rows="2"
                                  placeholder="Notice of Arrival has been issued for B/L: @Model.BLNumber ...">مشتری گرامی : اعلامیه ورود بارنامه شماره  @Model.BLNumber صادر شد.</textarea>
                    </div>
                </div>

                <!-- Action Button -->
                <div class="d-flex justify-content-end align-items-center gap-2 mt-2">
                    <div id="send-spinner" class="htmx-indicator spinner-border spinner-border-sm text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <button type="submit" class="btn btn-sm btn-success font-monospace px-3">
                        <i class="bi bi-paperplane me-1"></i> Dispatch Now
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- 2. Dispatch History Table -->
    <div class="card border border-secondary-subtle shadow-sm">
        <div class="card-header bg-light py-2 px-3 d-flex justify-content-between align-items-center border-bottom border-secondary-subtle">
            <span class="fw-bold small text-dark text-uppercase font-monospace">
                <i class="bi bi-clock-history me-1 text-secondary"></i> Dispatch Log & History
            </span>
            <span class="badge bg-secondary-subtle text-dark border border-secondary-subtle font-monospace">
                Total Logs: @(Model.History?.Count ?? 0)
            </span>
        </div>

        <div class="table-responsive w-100" style="overflow-x: auto; max-height: 280px;">
            <table class="table table-sm table-bordered table-hover align-middle mb-0 text-nowrap small text-start border-secondary-subtle">
                <thead class="table-light text-uppercase font-monospace align-middle sticky-top border-bottom border-secondary-subtle">
                    <tr>
                        <th style="width: 35px;" class="text-center">#</th>
                        <th style="min-width: 90px;">Channel</th>
                        <th style="min-width: 130px;">Sender</th>
                        <th style="min-width: 130px;">Receiver</th>
                        <th style="min-width: 130px;">Send Date</th>
                        <th style="min-width: 130px;">Receive Date</th>
                        <th style="min-width: 100px;" class="text-center">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.History != null && Model.History.Any())
                    {
                        int rowNo = 1;
                        @foreach (var s in Model.History)
                        {
                            var toolLower = s.SendToolTypeName?.ToLower() ?? "";
                            <tr>
                                <td class="text-center text-muted fw-semibold font-monospace">@(rowNo++)</td>

                                <!-- Channel Badge -->
                                <td>
                                    @if (toolLower.Contains("sms"))
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-chat-dots me-1"></i> SMS
                                        </span>
                                    }
                                    else if (toolLower.Contains("email") || toolLower.Contains("mail"))
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                            <i class="bi bi-envelope me-1"></i> Email
                                        </span>
                                    }
                                    else if (toolLower.Contains("portal"))
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                                            <i class="bi bi-globe me-1"></i> Portal
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-dark border px-2 py-1">
                                            @s.SendToolTypeName
                                        </span>
                                    }
                                </td>

                                <!-- Sender -->
                                <td class="font-monospace text-muted">
                                    @(string.IsNullOrWhiteSpace(s.Sender) ? "-" : s.Sender)
                                </td>

                                <!-- Receiver -->
                                <td class="font-monospace fw-semibold text-dark">
                                    @(string.IsNullOrWhiteSpace(s.Receiver) ? "-" : s.Receiver)
                                </td>

                                <!-- Send Date -->
                                <td class="font-monospace text-muted">
                                    @(s.SendDateTime?.ToString("yyyy/MM/dd HH:mm") ?? "-")
                                </td>

                                <!-- Receive Date -->
                                <td class="font-monospace text-muted">
                                    @(s.ReceiveDateTime?.ToString("yyyy/MM/dd HH:mm") ?? "-")
                                </td>

                                <!-- Status Badge -->
                                <td class="text-center">
                                    @if (s.SendToolTypeId == 2 || toolLower.Contains("sms"))
                                    {
                                        @switch (s.SmsStatus)
                                        {
                                            case SmsDeliveryStatus.Queued:
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1 font-monospace" title="در صف ارسال سیستم">
                                                    <i class="bi bi-clock me-1"></i> Queued
                                                </span>
                                                break;

                                            case SmsDeliveryStatus.Sending:
                                            case SmsDeliveryStatus.PendingInQueue:
                                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-1 font-monospace" title="ارسال به اپراتور / در صف پردازش اپراتور">
                                                    <i class="bi bi-hourglass-split me-1"></i> Processing
                                                </span>
                                                break;

                                            case SmsDeliveryStatus.SentSuccessfully:
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 font-monospace" title="ارسال موفق به سمت اپراتور">
                                                    <i class="bi bi-check me-1"></i> Sent
                                                </span>
                                                break;

                                            case SmsDeliveryStatus.Delivered:
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 font-monospace" title="تحویل نهایی به گوشی مخاطب">
                                                    <i class="bi bi-check2-all me-1"></i> Delivered
                                                </span>
                                                break;

                                            case SmsDeliveryStatus.Failed:
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 font-monospace"
                                                      title="@(string.IsNullOrWhiteSpace(s.ErrorDescription) ? "خطا در ارسال" : s.ErrorDescription)">
                                                    <i class="bi bi-x-circle me-1"></i> Failed
                                                </span>
                                                break;

                                            default:
                                                <span class="badge bg-light text-muted border px-2 py-1 font-monospace">
                                                    <i class="bi bi-question-circle me-1"></i> Unknown
                                                </span>
                                                break;
                                        }
                                    }
                                    else
                                    {
                                        @* وضعیت پیش‌فرض برای Email یا Portal *@
                                        @if (s.ReceiveDateTime.HasValue)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 font-monospace">
                                                <i class="bi bi-check2-all me-1"></i> Delivered
                                            </span>
                                        }
                                        else if (s.SendDateTime.HasValue)
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 font-monospace">
                                                <i class="bi bi-send me-1"></i> Sent
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-muted border px-2 py-1 font-monospace">
                                                <i class="bi bi-hourglass-split me-1"></i> Pending
                                            </span>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted align-middle" style="height: 90px;">
                                <i class="bi bi-inbox d-block mb-1 fs-5 text-secondary"></i>
                                No dispatch history recorded for this Notice of Arrival.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    function onChannelChange(selectElem) {
        var val = selectElem.value;
        var label = document.getElementById('receiverLabel');
        var input = document.getElementById('receiverInput');

        if (val === "1") {      // Email
            label.innerText = "Receiver Email";
            input.placeholder = "";
            input.value = "@Model.DefaultEmail";
        }
         else if (val === "2") { // SMS
            label.innerText = "Receiver Mobile";
            input.placeholder = "";
            input.value = "@Model.DefaultMobile";

        } else if (val === "3") { // Portal
            label.innerText = "Portal Account / User";
            input.placeholder = "Portal User Account";
            input.value = "@Model.DefaultPortalUser";
        }
    }
</script>