        <span class="ticker-item">🛤 Rail Freight <span class="up">▲ 22%</span></span><span class="ticker-sep">●</span>
        <span class="ticker-item">📋 Customs Clearance Avg: 18hrs</span><span class="ticker-sep">●</span>
        <span class="ticker-item">🚛 TR-IR Corridor <span class="up">▲ 12%</span></span><span class="ticker-sep">●</span>
        <span class="ticker-item">📦 Active Shipments: 2,847</span><span class="ticker-sep">●</span>
        <span class="ticker-item">⏱ Avg Transit Time: 4.2 days</span><span class="ticker-sep">●</span>
        <span class="ticker-item">🏗 Bazargan BCP <span class="up">▲ 8% throughput</span></span><span class="ticker-sep">●</span>
        <span class="ticker-item">⚠ Astara BCP: 3hr delay</span><span class="ticker-sep">●</span>
        <span class="ticker-item">🚢 Bandar Abbas Port <span class="up">▲ 15% TEU</span></span><span class="ticker-sep">●</span>
        <span class="ticker-item">🛤 Rail Freight <span class="up">▲ 22%</span></span><span class="ticker-sep">●</span>
        <span class="ticker-item">📋 Customs Clearance Avg: 18hrs</span><span class="ticker-sep">●</span>
