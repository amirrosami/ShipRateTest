                <!-- Dwell Time Gauges -->
                <div style="margin-top:20px">
                    <h4 style="font-size:12px;color:var(--text-secondary);text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;text-align:center">
                        Avg Dwell Time at BCPs
                    </h4>
                    <div class="gauge-grid">
                        <div class="gauge-item">
                            <div class="gauge-ring">
                                <svg width="100" height="100" viewBox="0 0 100 100">
                                    <circle class="gauge-bg"/>
                                    <circle class="gauge-fill" id="gaugeBazargan" style="stroke:var(--accent-cyan);stroke-dasharray:264;stroke-dashoffset:264"/>
                                </svg>
                                <div class="gauge-val" style="color:var(--accent-cyan)" id="gaugeValBaz">0h</div>
                            </div>
                            <div class="gauge-label">Bazargan</div>
                            <div class="gauge-sub">Target: &lt; 12h</div>
                        </div>
                        <div class="gauge-item">
                            <div class="gauge-ring">
                                <svg width="100" height="100" viewBox="0 0 100 100">
                                    <circle class="gauge-bg"/>
                                    <circle class="gauge-fill" id="gaugeAstara" style="stroke:var(--accent-orange);stroke-dasharray:264;stroke-dashoffset:264"/>
                                </svg>
                                <div class="gauge-val" style="color:var(--accent-orange)" id="gaugeValAst">0h</div>
                            </div>
                            <div class="gauge-label">Astara</div>
                            <div class="gauge-sub">Target: &lt; 10h</div>
                        </div>
                        <div class="gauge-item">
                            <div class="gauge-ring">
                                <svg width="100" height="100" viewBox="0 0 100 100">
                                    <circle class="gauge-bg"/>
                                    <circle class="gauge-fill" id="gaugeDogharoun" style="stroke:var(--accent-green);stroke-dasharray:264;stroke-dashoffset:264"/>
                                </svg>
                                <div class="gauge-val" style="color:var(--accent-green)" id="gaugeValDog">0h</div>
                            </div>
                            <div class="gauge-label">Dogharoun</div>
                            <div class="gauge-sub">Target: &lt; 8h</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Row 3: Corridor Ranking + Mode Split + Alerts -->
    <div class="section-row row-3-col animate-in delay-4">
        <!-- Corridor Ranking -->
        <div class="panel">
            <div class="panel-header">
                <span class="panel-title"><span class="dot"></span>TOP TRANSIT CORRIDORS</span>
                <span class="panel-badge badge-info">By Volume</span>
            </div>
            <div class="panel-body">
                <div class="corridor-rank" id="corridorRank">
                    <!-- Filled by JS -->
                </div>
            </div>
        </div>

        <!-- Mode Split Donut + BCP Chart -->
        <div class="panel">
            <div class="panel-header">
                <span class="panel-title"><span class="dot" style="background:var(--accent-yellow);box-shadow:0 0 8px var(--accent-yellow)"></span>TRANSPORT MODE SPLIT</span>
            </div>
            <div class="panel-body">
                <div class="chart-container" style="margin-bottom:20px">
                    <canvas id="modeSplitChart" height="200"></canvas>
                </div>
                <div class="chart-container">
                    <canvas id="bcpChart" height="160"></canvas>
                </div>
            </div>
        </div>

        <!-- Alert Feed -->
        <div class="panel">
            <div class="panel-header">
                <span class="panel-title"><span class="dot" style="background:var(--accent-red);box-shadow:0 0 8px var(--accent-red)"></span>ALERT CENTER</span>
                <span class="panel-badge badge-live">● LIVE</span>
            </div>
            <div class="panel-body">
                <div class="alert-feed" id="alertFeed">
                    <!-- Filled by JS -->
                </div>
            </div>
        </div>
    </div>

    <!-- Row 4: Document Status + Corridor Performance -->
    <div class="section-row row-1-1 animate-in delay-5">
        <!-- Document Status -->
        <div class="panel">
            <div class="panel-header">
                <span class="panel-title"><span class="dot" style="background:var(--accent-yellow);box-shadow:0 0 8px var(--accent-yellow)"></span>DOCUMENT STATUS</span>
                <span class="panel-badge badge-info">Recent 8</span>
            </div>
            <div class="panel-body" style="padding:10px">
                <table class="doc-table">
                    <thead>
                        <tr>
                            <th>Shipment ID</th>
                            <th>Route</th>
                            <th>CMR</th>
                            <th>TIR</th>
                            <th>Invoice</th>
                            <th>Customs Dec.</th>
                        </tr>
                    </thead>
                    <tbody id="docTableBody">
                        <!-- Filled by JS -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Corridor Performance Chart -->
        <div class="panel">
            <div class="panel-header">
                <span class="panel-title"><span class="dot" style="background:var(--accent-blue);box-shadow:0 0 8px var(--accent-blue)"></span>CORRIDOR PERFORMANCE (DAYS)</span>
            </div>
            <div class="panel-body">
                <div class="chart-container">
                    <canvas id="corridorPerfChart" height="260"></canvas>
                </div>
            </div>
        </div>
    </div>

</main>

<!-- Footer -->
<footer class="footer">
    TRANSIT LOGISTICS COMMAND CENTER &bull; Real-time Cross-Border Intelligence &bull; Data refreshes every 30s &bull; &copy; 2026
</footer>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function(){

    // ====== CLOCK ======
    function updateClock(){
        const now=new Date();
        document.getElementById('liveClock').textContent=
            now.toLocaleTimeString('en-US',{hour12:false,hour:'2-digit',minute:'2-digit',second:'2-digit'});
    }
    setInterval(updateClock,1000);updateClock();

    // ====== COUNTER ANIMATION ======
    function animateCounter(el,target,suffix='',prefix='',duration=2000){
        const start=0;
        const startTime=performance.now();
        const isFloat=String(target).includes('.');
        function update(now){
            const elapsed=now-startTime;
            const progress=Math.min(elapsed/duration,1);
            const eased=1-Math.pow(1-progress,3);
            const current=start+(target-start)*eased;
            if(isFloat){
                el.textContent=prefix+current.toFixed(1)+suffix;
            } else {
                el.textContent=prefix+Math.floor(current).toLocaleString()+suffix;
            }
            if(progress<1)requestAnimationFrame(update);
        }
        requestAnimationFrame(update);
    }

    // KPI Animations
    setTimeout(()=>{
        animateCounter(document.getElementById('kpiShipments'),2847);
        animateCounter(document.getElementById('kpiTEU'),14520);
        animateCounter(document.getElementById('kpiOTD'),94.7,'%');
        animateCounter(document.getElementById('kpiCorridors'),14);
        animateCounter(document.getElementById('kpiHolds'),23);
        animateCounter(document.getElementById('kpiRevenue'),42.8,'M','$');
    },300);

    // Fleet Counters
    setTimeout(()=>{
        animateCounter(document.getElementById('fleetTruck'),1248);
        animateCounter(document.getElementById('fleetRail'),186);
        animateCounter(document.getElementById('fleetShip'),47);
        animateCounter(document.getElementById('fleetAir'),12);
    },600);

    // ====== GAUGE ANIMATION ======
    function animateGauge(el,valEl,hours,maxHours,unit='h'){
        const circumference=264;
        const pct=hours/maxHours;
        const offset=circumference-(pct*circumference);
        setTimeout(()=>{
            el.style.strokeDashoffset=offset;
            valEl.textContent=hours+unit;
        },800);
    }
    animateGauge(
        document.getElementById('gaugeBazargan'),
        document.getElementById('gaugeValBaz'),
        14,24
    );
    animateGauge(
        document.getElementById('gaugeAstara'),
        document.getElementById('gaugeValAst'),
        19,24
    );
    animateGauge(
        document.getElementById('gaugeDogharoun'),
        document.getElementById('gaugeValDog'),
        7,24
    );

    // ====== SHIPMENT LIST ======
    const shipments=[
        {id:'TRN-28471',status:'transit',icon:'🚛',cls:'st-transit',from:'Istanbul',to:'Kabul',via:'Bazargan→Dogharoun',eta:'14:30',progress:62,color:'var(--accent-cyan)'},
        {id:'TRN-28465',status:'customs',icon:'📋',cls:'st-customs',from:'Hamburg',to:'Karachi',via:'Bazargan→Mirjaveh',eta:'18:00',progress:41,color:'var(--accent-orange)'},
        {id:'TRN-28459',status:'transit',icon:'🚂',cls:'st-transit',from:'Moscow',to:'Bandar Abbas',via:'Astara→South',eta:'22:15',progress:78,color:'var(--accent-cyan)'},
        {id:'TRN-28452',status:'delivered',icon:'✅',cls:'st-delivered',from:'Ankara',to:'Herat',via:'Bazargan→Islam Qala',eta:'Done',progress:100,color:'var(--accent-green)'},
        {id:'TRN-28448',status:'delayed',icon:'⚠️',cls:'st-delayed',from:'Dubai',to:'Ashgabat',via:'BandarAbbas→Sarakhs',eta:'Delayed',progress:33,color:'var(--accent-red)'},
        {id:'TRN-28440',status:'transit',icon:'🚛',cls:'st-transit',from:'Trabzon',to:'Islamabad',via:'Bazargan→Taftan',eta:'06:45',progress:55,color:'var(--accent-cyan)'},
        {id:'TRN-28437',status:'customs',icon:'🔍',cls:'st-customs',from:'Baku',to:'Chabahar',via:'Astara→South',eta:'11:20',progress:28,color:'var(--accent-orange)'},
        {id:'TRN-28431',status:'transit',icon:'🚢',cls:'st-transit',from:'Mumbai',to:'Istanbul',via:'Chabahar→Bazargan',eta:'Tomorrow',progress:47,color:'var(--accent-cyan)'},
    ];
    const shipmentList=document.getElementById('shipmentList');
    shipments.forEach(s=>{
        shipmentList.innerHTML+=`
        <div class="shipment-item">
            <div class="shipment-status ${s.cls}">${s.icon}</div>
            <div class="shipment-info">
                <h4>${s.id}</h4>
                <p class="shipment-route">${s.from} → ${s.to}</p>
                <p style="font-size:10px;color:var(--text-muted);margin-top:2px">via ${s.via}</p>
                <div class="progress-bar" style="margin-top:6px"><div class="progress-fill" style="width:${s.progress}%;background:${s.color}"></div></div>
            </div>
            <div class="shipment-eta">
                <div class="time" style="color:${s.color}">${s.eta}</div>
                <div class="label">ETA</div>
            </div>
        </div>`;
    });

    // ====== CORRIDOR RANKING ======
    const corridors=[
        {name:'Turkey → Afghanistan',sub:'via Iran (Bazargan–Dogharoun)',vol:4280,pct:100},
        {name:'Europe → Central Asia',sub:'via Turkey–Iran–Turkmenistan',vol:3650,pct:85},
        {name:'Persian Gulf → CIS',sub:'via Bandar Abbas–North Corridor',vol:3120,pct:73},
        {name:'India → Central Asia',sub:'via Chabahar–Sarakhs',vol:2540,pct:59},
        {name:'Turkey → Pakistan',sub:'via Iran (Bazargan–Mirjaveh)',vol:2180,pct:51},
        {name:'Iraq → Afghanistan',sub:'via Iran (Khosravi–Dogharoun)',vol:1740,pct:41},
    ];
    const crEl=document.getElementById('corridorRank');
    corridors.forEach((c,i)=>{
        crEl.innerHTML+=`
        <div class="corridor-item">
            <div class="corridor-rank-num" style="color:${i<3?'var(--accent-cyan)':'var(--text-muted)'}">#${i+1}</div>
            <div class="corridor-name"><h4>${c.name}</h4><p>${c.sub}</p></div>
            <div class="corridor-bar-wrap">
                <div class="corridor-bar">
                    <div class="corridor-bar-fill" style="width:0%" data-target="${c.pct}"></div>
                </div>
            </div>
            <div class="corridor-vol">${c.vol.toLocaleString()}</div>
        </div>`;
    });
    // Animate bars
    setTimeout(()=>{
        document.querySelectorAll('.corridor-bar-fill').forEach(bar=>{
            bar.style.width=bar.dataset.target+'%';
        });
    },500);

    // ====== ALERTS ======
    const alerts=[
        {type:'critical',icon:'🚨',title:'Customs Hold: TRN-28448','text':'Shipment flagged at Sarakhs BCP — missing phytosanitary certificate',time:'2 min ago'},
        {type:'warning',icon:'⚠️',title:'Delay: Astara Border','text':'Queue length exceeded 180 trucks — estimated 3hr additional wait',time:'8 min ago'},
        {type:'info',icon:'📡',title:'GPS Signal Lost: TRN-28419','text':'Last known position: 35.2°N, 59.1°E (Mashhad corridor)',time:'15 min ago'},
        {type:'success',icon:'✅',title:'Cleared: Batch #B-4472','text':'42 shipments cleared at Bazargan — all documents verified',time:'22 min ago'},
        {type:'warning',icon:'🌡️',title:'Temperature Alert: TRN-28455','text':'Reefer unit temp 6.2°C — threshold is 4°C for pharma cargo',time:'31 min ago'},
        {type:'critical',icon:'🛑',title:'Route Closure: Mirjaveh','text':'Security checkpoint closure — estimated reopening in 4 hours',time:'45 min ago'},
        {type:'info',icon:'📊',title:'Volume Spike: Bazargan','text':'Throughput 18% above daily average — additional lanes activated',time:'1 hr ago'},
        {type:'success',icon:'🏆',title:'Record: Dogharoun BCP','text':'Fastest clearance time this quarter: avg 5.2h today',time:'1.5 hr ago'},
    ];
    const alertEl=document.getElementById('alertFeed');
    alerts.forEach(a=>{
        alertEl.innerHTML+=`
        <div class="alert-item alert-${a.type}">
            <span class="alert-icon">${a.icon}</span>
            <div class="alert-text"><h5>${a.title}</h5><p>${a.text}</p></div>
            <span class="alert-time">${a.time}</span>
        </div>`;
    });

    // ====== DOCUMENT TABLE ======
    const docs=[
        {id:'TRN-28471',route:'IST→KBL',cmr:'ok',tir:'ok',inv:'ok',cust:'ok'},
        {id:'TRN-28465',route:'HAM→KHI',cmr:'ok',tir:'pending',inv:'ok',cust:'pending'},
        {id:'TRN-28459',route:'MOW→BND',cmr:'ok',tir:'ok',inv:'ok',cust:'ok'},
        {id:'TRN-28452',route:'ANK→HEA',cmr:'ok',tir:'ok',inv:'ok',cust:'ok'},
        {id:'TRN-28448',route:'DXB→ASB',cmr:'ok',tir:'ok',inv:'issue',cust:'issue'},
        {id:'TRN-28440',route:'TRB→ISB',cmr:'ok',tir:'pending',inv:'ok',cust:'pending'},
        {id:'TRN-28437',route:'BAK→CHB',cmr:'pending',tir:'ok',inv:'ok',cust:'pending'},
        {id:'TRN-28431',route:'BOM→IST',cmr:'ok',tir:'ok',inv:'ok',cust:'ok'},
    ];
    function badge(st){
        const m={ok:['doc-ok','✓ OK'],pending:['doc-pending','⏳ Pending'],issue:['doc-issue','✕ Issue']};
        return `<span class="doc-badge ${m[st][0]}">${m[st][1]}</span>`;
    }
    const dtBody=document.getElementById('docTableBody');
    docs.forEach(d=>{
        dtBody.innerHTML+=`<tr>
            <td style="font-family:'Share Tech Mono',monospace;font-weight:600">${d.id}</td>
            <td>${d.route}</td>
            <td>${badge(d.cmr)}</td>
            <td>${badge(d.tir)}</td>
            <td>${badge(d.inv)}</td>
            <td>${badge(d.cust)}</td>
        </tr>`;
    });

    // ====== TRUCK ANIMATION ======
    const trucks=[
        {el:document.getElementById('truck1'),x1:160,y1:110,x2:340,y2:145,speed:.0003},
        {el:document.getElementById('truck2'),x1:390,y1:155,x2:565,y2:165,speed:.00025},
        {el:document.getElementById('truck3'),x1:375,y1:200,x2:380,y2:320,speed:.0002},
        {el:document.getElementById('truck4'),x1:340,y1:165,x2:200,y2:230,speed:.00035},
    ];
    let truckT=0;
    function animateTrucks(){
        truckT+=16;
        trucks.forEach(t=>{
            const p=(Math.sin(truckT*t.speed)+1)/2;
            const x=t.x1+(t.x2-t.x1)*p;
            const y=t.y1+(t.y2-t.y1)*p;
            t.el.style.left=x+'px';
            t.el.style.top=y+'px';
        });
        requestAnimationFrame(animateTrucks);
    }
    animateTrucks();

    // ====== CHARTS ======
    const chartFont={family:'Rajdhani',weight:500};
    const gridColor='rgba(255,255,255,.06)';
    const tickColor='#9aa0b8';

    Chart.defaults.font.family='Rajdhani';
    Chart.defaults.color=tickColor;

    // Volume Chart (Bar + Line combo)
    new Chart(document.getElementById('volumeChart'),{
        type:'bar',
        data:{
            labels:['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'],
            datasets:[
                {
                    label:'Road (TEU)',
                    data:[8200,7800,9100,9800,10400,11200,10800,11600,12100,12800,13200,14100],
                    backgroundColor:'rgba(0,229,255,.25)',
                    borderColor:'rgba(0,229,255,.8)',
                    borderWidth:1,borderRadius:4,
                    order:2,
                },
                {
                    label:'Rail (TEU)',
                    data:[1800,2100,2400,2800,3200,3600,3400,3900,4200,4500,4800,5100],
                    backgroundColor:'rgba(255,109,0,.25)',
                    borderColor:'rgba(255,109,0,.8)',
                    borderWidth:1,borderRadius:4,
                    order:2,
                },
                {
                    label:'Sea (TEU)',
                    data:[3200,3000,3500,3800,4100,4600,4400,4900,5200,5600,5900,6200],
                    backgroundColor:'rgba(41,121,255,.25)',
                    borderColor:'rgba(41,121,255,.8)',
                    borderWidth:1,borderRadius:4,
                    order:2,
                },
                {
                    label:'Total Trend',
                    data:[13200,12900,15000,16400,17700,19400,18600,20400,21500,22900,23900,25400],
                    type:'line',
                    borderColor:'var(--accent-green)',
                    borderWidth:2,
                    pointRadius:3,
                    pointBackgroundColor:'var(--accent-green)',
                    tension:.4,fill:false,
                    order:1,
                }
            ]
        },
        options:{
            responsive:true,
            interaction:{mode:'index',intersect:false},
            scales:{
                x:{grid:{color:gridColor},ticks:{font:chartFont}},
                y:{grid:{color:gridColor},ticks:{font:chartFont,callback:v=>(v/1000)+'K'}}
            },
            plugins:{
                legend:{position:'bottom',labels:{boxWidth:12,padding:12,font:{size:11}}},
            }
        }
    });

    // Mode Split Donut
    new Chart(document.getElementById('modeSplitChart'),{
        type:'doughnut',
        data:{
            labels:['Road Transport','Rail Freight','Maritime','Air Cargo'],
            datasets:[{
                data:[52,18,26,4],
                backgroundColor:[
                    'rgba(0,229,255,.7)',
                    'rgba(255,109,0,.7)',
                    'rgba(41,121,255,.7)',
                    'rgba(213,0,249,.7)',
                ],
                borderColor:'var(--bg-card)',
                borderWidth:3,
                hoverOffset:8,
            }]
        },
        options:{
            responsive:true,
            cutout:'65%',
            plugins:{
                legend:{position:'bottom',labels:{boxWidth:10,padding:10,font:{size:11}}},
            }
        }
    });

    // BCP Throughput Chart
    new Chart(document.getElementById('bcpChart'),{
        type:'bar',
        data:{
            labels:['Bazargan','Astara','Dogharoun','Mirjaveh','Sarakhs','Norduz','Lotfabad'],
            datasets:[{
                label:'Trucks/Day',
                data:[420,280,350,190,210,85,120],
                backgroundColor:[
                    'rgba(0,229,255,.6)',
                    'rgba(255,109,0,.6)',
                    'rgba(0,230,118,.6)',
                    'rgba(213,0,249,.6)',
                    'rgba(255,214,0,.6)',
                    'rgba(41,121,255,.6)',
                    'rgba(255,23,68,.6)',
                ],
                borderRadius:6,
                borderSkipped:false,
            }]
        },
        options:{
            indexAxis:'y',
            responsive:true,
            scales:{
                x:{grid:{color:gridColor},ticks:{font:{size:10}}},
                y:{grid:{display:false},ticks:{font:{size:10}}}
            },
            plugins:{legend:{display:false}}
        }
    });

    // Corridor Performance (Radar)
    new Chart(document.getElementById('corridorPerfChart'),{
        type:'radar',
        data:{
            labels:['Transit Time','Cost Efficiency','Reliability','Customs Speed','Safety Rating','Capacity'],
            datasets:[
                {
                    label:'North Corridor (Bazargan)',
                    data:[85,72,90,78,92,88],
                    borderColor:'rgba(0,229,255,.8)',
                    backgroundColor:'rgba(0,229,255,.1)',
                    pointBackgroundColor:'var(--accent-cyan)',
                    borderWidth:2,
                },
                {
                    label:'East Corridor (Dogharoun)',
                    data:[78,85,82,88,86,72],
                    borderColor:'rgba(0,230,118,.8)',
                    backgroundColor:'rgba(0,230,118,.1)',
                    pointBackgroundColor:'var(--accent-green)',
                    borderWidth:2,
                },
                {
                    label:'South Corridor (Bandar Abbas)',
                    data:[65,90,75,70,88,95],
                    borderColor:'rgba(255,109,0,.8)',
                    backgroundColor:'rgba(255,109,0,.1)',
                    pointBackgroundColor:'var(--accent-orange)',
                    borderWidth:2,
                }
            ]
        },
        options:{
            responsive:true,
            scales:{
                r:{
                    grid:{color:'rgba(255,255,255,.08)'},
                    ticks:{display:false},
                    pointLabels:{font:{size:11,family:'Rajdhani'},color:tickColor},
                    angleLines:{color:'rgba(255,255,255,.08)'},
                    suggestedMin:0,suggestedMax:100,
                }
            },
            plugins:{
                legend:{position:'bottom',labels:{boxWidth:10,padding:10,font:{size:11}}}
            }
        }
    });

    // ====== LIVE DATA SIMULATION ======
    setInterval(()=>{
        // Random KPI micro-updates
        const shipEl=document.getElementById('kpiShipments');
        const current=parseInt(shipEl.textContent.replace(/,/g,''))||2847;
        const delta=Math.floor(Math.random()*5)-2;
        shipEl.textContent=(current+delta).toLocaleString();
    },5000);

});
</script>

</body>
</html>
