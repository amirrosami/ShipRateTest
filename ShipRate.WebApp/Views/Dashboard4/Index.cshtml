                        <span class="node-volume">518 TEU/day</span>
                    </div>
                    <div class="country-node node-dest" style="left:555px;top:260px">
                        <div class="node-dot"></div>
                        <span class="node-label">PAKISTAN</span>
                        <span class="node-volume">672 TEU/day</span>
                    </div>
                    <div class="country-node node-transit" style="left:175px;top:220px">
                        <div class="node-dot"></div>
                        <span class="node-label">IRAQ</span>
                        <span class="node-volume">456 TEU/day</span>
                    </div>
                    <div class="country-node node-origin" style="left:5px;top:40px">
                        <div class="node-dot"></div>
                        <span class="node-label">EUROPE</span>
                        <span class="node-volume">1,250 TEU/day</span>
                    </div>
                    <div class="country-node node-dest" style="left:375px;top:310px">
                        <div class="node-dot"></div>
                        <span class="node-label">PERSIAN GULF</span>
                        <span class="node-volume">1,890 TEU/day</span>
                    </div>
                    <div class="country-node node-transit" style="left:415px;top:8px">
                        <div class="node-dot"></div>
                        <span class="node-label">CIS</span>
                        <span class="node-volume">780 TEU/day</span>
                    </div>
                    <div class="country-node node-dest" style="left:715px;top:20px">
                        <div class="node-dot"></div>
                        <span class="node-label">CENTRAL ASIA</span>
                        <span class="node-volume">290 TEU/day</span>
                    </div>

                    <!-- Moving Trucks -->
                    <div class="truck-icon" id="truck1" style="left:200px;top:115px">🚛</div>
                    <div class="truck-icon" id="truck2" style="left:450px;top:145px">🚛</div>
                    <div class="truck-icon" id="truck3" style="left:380px;top:250px">🚢</div>
                    <div class="truck-icon" id="truck4" style="left:280px;top:190px">🚛</div>

                    <!-- Legend -->
                    <div class="map-legend">
                        <div class="legend-item"><div class="legend-dot" style="background:var(--accent-cyan)"></div>Origin</div>
                        <div class="legend-item"><div class="legend-dot" style="background:var(--accent-purple)"></div>Hub</div>
