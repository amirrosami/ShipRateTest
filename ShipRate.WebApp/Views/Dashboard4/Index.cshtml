@{
    ViewData["Title"] = "Transit Logistics Command Center";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Transit Logistics Command Center</title>
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@300;400;500;600;700&family=Orbitron:wght@400;500;600;700;800;900&family=Share+Tech+Mono&display=swap');

        *{margin:0;padding:0;box-sizing:border-box}

        :root{
            --bg-primary:#0a0e1a;
            --bg-secondary:#111827;
            --bg-card:#1a1f35;
            --bg-card-hover:#222845;
            --accent-cyan:#00e5ff;
            --accent-orange:#ff6d00;
            --accent-green:#00e676;
            --accent-red:#ff1744;
            --accent-purple:#d500f9;
            --accent-yellow:#ffd600;
            --accent-blue:#2979ff;
            --text-primary:#e8eaed;
            --text-secondary:#9aa0b8;
            --text-muted:#5a6178;
            --border-color:#2a3050;
            --glow-cyan:0 0 20px rgba(0,229,255,.3);
            --glow-orange:0 0 20px rgba(255,109,0,.3);
            --glow-green:0 0 20px rgba(0,230,118,.3);
        }

        body{
            background:var(--bg-primary);
            color:var(--text-primary);
            font-family:'Rajdhani',sans-serif;
            min-height:100vh;
            overflow-x:hidden;
        }

        /* ====== ANIMATED BACKGROUND ====== */
        .bg-animation{
            position:fixed;top:0;left:0;width:100%;height:100%;z-index:0;
            background:
                radial-gradient(ellipse at 20% 50%, rgba(0,229,255,.04) 0%, transparent 50%),
                radial-gradient(ellipse at 80% 20%, rgba(255,109,0,.04) 0%, transparent 50%),
                radial-gradient(ellipse at 50% 80%, rgba(0,230,118,.03) 0%, transparent 50%);
        }
        .grid-overlay{
            position:fixed;top:0;left:0;width:100%;height:100%;z-index:0;
            background-image:
                linear-gradient(rgba(0,229,255,.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0,229,255,.03) 1px, transparent 1px);
            background-size:60px 60px;
            animation:gridMove 20s linear infinite;
        }
        @@keyframes gridMove{
            0%{transform:translate(0,0)}
            100%{transform:translate(60px,60px)}
        }

        /* ====== HEADER ====== */
        .header{
            position:relative;z-index:10;
            padding:16px 30px;
            background:linear-gradient(135deg, rgba(26,31,53,.95), rgba(17,24,39,.95));
            border-bottom:1px solid var(--border-color);
            display:flex;align-items:center;justify-content:space-between;
            backdrop-filter:blur(20px);
        }
        .header-left{display:flex;align-items:center;gap:20px}
        .logo-icon{
            width:52px;height:52px;
            background:linear-gradient(135deg, var(--accent-cyan), var(--accent-blue));
            border-radius:14px;
            display:flex;align-items:center;justify-content:center;
            font-size:26px;
            box-shadow:var(--glow-cyan);
            animation:logoPulse 3s ease-in-out infinite;
        }
        @@keyframes logoPulse{
            0%,100%{box-shadow:0 0 15px rgba(0,229,255,.3)}
            50%{box-shadow:0 0 30px rgba(0,229,255,.6)}
        }
        .header-title h1{
            font-family:'Orbitron',monospace;
            font-size:22px;font-weight:700;
            background:linear-gradient(90deg,var(--accent-cyan),#fff,var(--accent-orange));
            -webkit-background-clip:text;-webkit-text-fill-color:transparent;
            letter-spacing:2px;
        }
        .header-title p{
            font-size:12px;color:var(--text-secondary);
            font-family:'Share Tech Mono',monospace;letter-spacing:1px;
        }
        .header-right{display:flex;align-items:center;gap:24px}
        .live-clock{
            font-family:'Share Tech Mono',monospace;
            font-size:18px;color:var(--accent-cyan);
            padding:8px 16px;
            border:1px solid rgba(0,229,255,.3);
            border-radius:8px;
            background:rgba(0,229,255,.05);
        }
        .status-badge{
            display:flex;align-items:center;gap:8px;
            padding:8px 16px;border-radius:20px;
            background:rgba(0,230,118,.1);
            border:1px solid rgba(0,230,118,.3);
            font-size:13px;font-weight:600;color:var(--accent-green);
        }
        .status-dot{
            width:8px;height:8px;border-radius:50%;
            background:var(--accent-green);
            animation:blink 1.5s ease-in-out infinite;
        }
        @@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}

        /* ====== SCROLLING TICKER ====== */
        .ticker-bar{
            position:relative;z-index:10;
            background:linear-gradient(90deg,rgba(255,109,0,.1),rgba(0,229,255,.1),rgba(255,109,0,.1));
            border-bottom:1px solid var(--border-color);
            overflow:hidden;height:36px;
            display:flex;align-items:center;
        }
        .ticker-content{
            display:flex;align-items:center;gap:40px;
            white-space:nowrap;
            animation:tickerScroll 40s linear infinite;
            font-family:'Share Tech Mono',monospace;
            font-size:12px;color:var(--text-secondary);
        }
        @@keyframes tickerScroll{
            0%{transform:translateX(0)}
            100%{transform:translateX(-50%)}
        }
        .ticker-item{display:flex;align-items:center;gap:8px}
        .ticker-item .up{color:var(--accent-green)}
        .ticker-item .down{color:var(--accent-red)}
        .ticker-sep{color:var(--text-muted);font-size:8px}

        /* ====== MAIN LAYOUT ====== */
        .main-content{
            position:relative;z-index:5;
            padding:20px 24px;
            display:flex;flex-direction:column;gap:20px;
            max-width:1920px;margin:0 auto;
        }

        /* ====== TOP KPI STRIP ====== */
        .kpi-strip{
            display:grid;
            grid-template-columns:repeat(6, 1fr);
            gap:16px;
        }
        .kpi-card{
            background:var(--bg-card);
            border:1px solid var(--border-color);
            border-radius:14px;
            padding:18px 20px;
            position:relative;
            overflow:hidden;
            transition:all .3s ease;
            cursor:default;
        }
        .kpi-card:hover{
            transform:translateY(-3px);
            border-color:var(--accent-cyan);
            box-shadow:var(--glow-cyan);
        }
        .kpi-card::before{
            content:'';position:absolute;top:0;left:0;right:0;height:3px;
            border-radius:14px 14px 0 0;
        }
        .kpi-card:nth-child(1)::before{background:linear-gradient(90deg,var(--accent-cyan),var(--accent-blue))}
        .kpi-card:nth-child(2)::before{background:linear-gradient(90deg,var(--accent-orange),var(--accent-yellow))}
        .kpi-card:nth-child(3)::before{background:linear-gradient(90deg,var(--accent-green),#69f0ae)}
        .kpi-card:nth-child(4)::before{background:linear-gradient(90deg,var(--accent-purple),#e040fb)}
        .kpi-card:nth-child(5)::before{background:linear-gradient(90deg,var(--accent-red),#ff5252)}
        .kpi-card:nth-child(6)::before{background:linear-gradient(90deg,var(--accent-yellow),var(--accent-orange))}

        .kpi-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
        .kpi-label{font-size:12px;color:var(--text-secondary);text-transform:uppercase;letter-spacing:1px;font-weight:600}
        .kpi-icon{font-size:20px;opacity:.7}
        .kpi-value{
            font-family:'Orbitron',monospace;
            font-size:28px;font-weight:700;
            margin-bottom:8px;
        }
        .kpi-card:nth-child(1) .kpi-value{color:var(--accent-cyan)}
        .kpi-card:nth-child(2) .kpi-value{color:var(--accent-orange)}
        .kpi-card:nth-child(3) .kpi-value{color:var(--accent-green)}
        .kpi-card:nth-child(4) .kpi-value{color:var(--accent-purple)}
        .kpi-card:nth-child(5) .kpi-value{color:var(--accent-red)}
        .kpi-card:nth-child(6) .kpi-value{color:var(--accent-yellow)}

        .kpi-change{
            display:flex;align-items:center;gap:6px;
            font-size:12px;font-weight:600;
        }
        .kpi-change.positive{color:var(--accent-green)}
        .kpi-change.negative{color:var(--accent-red)}
        .kpi-spark{
            position:absolute;bottom:10px;right:14px;
            opacity:.2;
        }

        /* ====== SECTION GRID ====== */
        .section-row{
            display:grid;gap:20px;
        }
        .row-2-1{grid-template-columns:2fr 1fr}
        .row-1-1{grid-template-columns:1fr 1fr}
        .row-1-1-1{grid-template-columns:1fr 1fr 1fr}
        .row-3-col{grid-template-columns:1.2fr 1fr .8fr}

        /* ====== CARD PANELS ====== */
        .panel{
            background:var(--bg-card);
            border:1px solid var(--border-color);
            border-radius:16px;
            overflow:hidden;
            transition:all .3s;
        }
        .panel:hover{border-color:rgba(0,229,255,.2)}
        .panel-header{
            padding:16px 20px;
            border-bottom:1px solid var(--border-color);
            display:flex;align-items:center;justify-content:space-between;
            background:rgba(0,0,0,.2);
        }
        .panel-title{
            font-family:'Orbitron',monospace;
            font-size:13px;font-weight:600;
            text-transform:uppercase;letter-spacing:2px;
            color:var(--text-primary);
            display:flex;align-items:center;gap:10px;
        }
        .panel-title .dot{
            width:8px;height:8px;border-radius:50%;
            background:var(--accent-cyan);
            box-shadow:0 0 8px var(--accent-cyan);
        }
        .panel-badge{
            font-size:11px;padding:3px 10px;border-radius:12px;
            font-family:'Share Tech Mono',monospace;
        }
        .badge-live{background:rgba(255,23,68,.15);color:var(--accent-red);border:1px solid rgba(255,23,68,.3)}
        .badge-info{background:rgba(0,229,255,.1);color:var(--accent-cyan);border:1px solid rgba(0,229,255,.3)}
        .panel-body{padding:20px}

        /* ====== TRANSIT CORRIDOR MAP ====== */
        .corridor-map{
            position:relative;
            height:380px;
            background:
                radial-gradient(ellipse at center, rgba(0,229,255,.03) 0%, transparent 70%);
            border-radius:12px;
            overflow:hidden;
        }
        .map-grid{
            position:absolute;inset:0;
            background-image:
                linear-gradient(rgba(0,229,255,.05) 1px, transparent 1px),
                linear-gradient(90deg,rgba(0,229,255,.05) 1px, transparent 1px);
            background-size:40px 40px;
        }
        /* Country Nodes */
        .country-node{
            position:absolute;
            display:flex;flex-direction:column;align-items:center;gap:4px;
            z-index:5;
            cursor:pointer;
            transition:transform .3s;
        }
        .country-node:hover{transform:scale(1.15)}
        .node-dot{
            width:16px;height:16px;border-radius:50%;
            position:relative;
        }
        .node-dot::after{
            content:'';position:absolute;inset:-6px;
            border-radius:50%;
            border:2px solid;
            opacity:.4;
            animation:nodeRing 2s ease-out infinite;
        }
        @@keyframes nodeRing{
            0%{transform:scale(1);opacity:.4}
            100%{transform:scale(2);opacity:0}
        }
        .node-origin .node-dot{background:var(--accent-cyan);box-shadow:0 0 15px var(--accent-cyan)}
        .node-origin .node-dot::after{border-color:var(--accent-cyan)}
        .node-transit .node-dot{background:var(--accent-orange);box-shadow:0 0 15px var(--accent-orange)}
        .node-transit .node-dot::after{border-color:var(--accent-orange)}
        .node-dest .node-dot{background:var(--accent-green);box-shadow:0 0 15px var(--accent-green)}
        .node-dest .node-dot::after{border-color:var(--accent-green)}
        .node-hub .node-dot{background:var(--accent-purple);box-shadow:0 0 15px var(--accent-purple)}
        .node-hub .node-dot::after{border-color:var(--accent-purple)}

        .node-label{
            font-size:10px;font-weight:700;
            text-transform:uppercase;letter-spacing:1px;
            padding:2px 8px;border-radius:4px;
            background:rgba(0,0,0,.7);
            white-space:nowrap;
        }
        .node-volume{
            font-family:'Share Tech Mono',monospace;
            font-size:9px;color:var(--text-muted);
        }

        /* Route Lines (SVG) */
        .route-svg{
            position:absolute;inset:0;z-index:2;
        }
        .route-line{
            fill:none;stroke-width:2;
            stroke-dasharray:8 4;
            animation:routeFlow 3s linear infinite;
        }
        @@keyframes routeFlow{
            0%{stroke-dashoffset:0}
            100%{stroke-dashoffset:-24}
        }
        .route-active{stroke:var(--accent-cyan);stroke-width:2.5;opacity:.7}
        .route-secondary{stroke:var(--accent-orange);opacity:.4}
        .route-warning{stroke:var(--accent-red);opacity:.5;stroke-dasharray:4 4}

        /* Moving Trucks */
        .truck-icon{
            position:absolute;z-index:6;
            font-size:18px;
            filter:drop-shadow(0 0 6px rgba(0,229,255,.5));
            transition:all .1s linear;
        }

        /* Map Legend */
        .map-legend{
            position:absolute;bottom:12px;left:12px;z-index:8;
            display:flex;gap:16px;
            padding:8px 14px;border-radius:8px;
            background:rgba(0,0,0,.7);
            backdrop-filter:blur(6px);
            font-size:11px;
        }
        .legend-item{display:flex;align-items:center;gap:6px}
        .legend-dot{width:8px;height:8px;border-radius:50%}

        /* Map Stats overlay */
        .map-stats{
            position:absolute;top:12px;right:12px;z-index:8;
            display:flex;flex-direction:column;gap:6px;
        }
        .map-stat{
            padding:6px 12px;border-radius:8px;
            background:rgba(0,0,0,.7);backdrop-filter:blur(6px);
            font-family:'Share Tech Mono',monospace;
            font-size:12px;display:flex;align-items:center;gap:8px;
        }

        /* ====== LIVE SHIPMENT TRACKER ====== */
        .shipment-list{
            max-height:340px;
            overflow-y:auto;
            display:flex;flex-direction:column;gap:8px;
        }
        .shipment-list::-webkit-scrollbar{width:4px}
        .shipment-list::-webkit-scrollbar-track{background:transparent}
        .shipment-list::-webkit-scrollbar-thumb{background:var(--border-color);border-radius:4px}

        .shipment-item{
            display:grid;
            grid-template-columns:auto 1fr auto;
            gap:14px;align-items:center;
            padding:12px 14px;
            border-radius:10px;
            background:rgba(255,255,255,.02);
            border:1px solid rgba(255,255,255,.04);
            transition:all .3s;
            cursor:pointer;
        }
        .shipment-item:hover{
            background:rgba(0,229,255,.05);
            border-color:rgba(0,229,255,.15);
        }
        .shipment-status{
            width:36px;height:36px;border-radius:10px;
            display:flex;align-items:center;justify-content:center;
            font-size:16px;
        }
        .st-transit{background:rgba(0,229,255,.15)}
        .st-customs{background:rgba(255,109,0,.15)}
        .st-delivered{background:rgba(0,230,118,.15)}
        .st-delayed{background:rgba(255,23,68,.15)}
        .shipment-info h4{font-size:13px;font-weight:600;margin-bottom:3px}
        .shipment-info p{font-size:11px;color:var(--text-muted)}
        .shipment-route{
            font-family:'Share Tech Mono',monospace;
            font-size:11px;color:var(--text-secondary);
        }
        .shipment-eta{
            text-align:right;
        }
        .shipment-eta .time{
            font-family:'Orbitron',monospace;
            font-size:14px;font-weight:600;
        }
        .shipment-eta .label{font-size:10px;color:var(--text-muted)}

        /* ====== PROGRESS BAR ====== */
        .progress-bar{
            height:4px;border-radius:2px;
            background:rgba(255,255,255,.06);
            margin-top:8px;overflow:hidden;
        }
        .progress-fill{
            height:100%;border-radius:2px;
            transition:width 1s ease;
            position:relative;
        }
        .progress-fill::after{
            content:'';position:absolute;top:0;right:0;
            width:20px;height:100%;
            background:linear-gradient(90deg,transparent,rgba(255,255,255,.4));
            animation:progressShine 2s ease-in-out infinite;
        }
        @@keyframes progressShine{0%,100%{opacity:0}50%{opacity:1}}

        /* ====== CUSTOMS PIPELINE ====== */
        .customs-pipeline{
            display:flex;flex-direction:column;gap:12px;
        }
        .pipeline-stage{
            display:flex;align-items:center;gap:14px;
            padding:14px;border-radius:10px;
            background:rgba(255,255,255,.02);
            border-left:3px solid;
            transition:all .3s;
        }
        .pipeline-stage:hover{background:rgba(255,255,255,.04)}
        .stage-pre{border-left-color:var(--accent-blue)}
        .stage-inspect{border-left-color:var(--accent-orange)}
        .stage-clear{border-left-color:var(--accent-green)}
        .stage-hold{border-left-color:var(--accent-red)}

        .stage-icon{
            width:40px;height:40px;border-radius:10px;
            display:flex;align-items:center;justify-content:center;
            font-size:18px;flex-shrink:0;
        }
        .stage-pre .stage-icon{background:rgba(41,121,255,.15)}
        .stage-inspect .stage-icon{background:rgba(255,109,0,.15)}
        .stage-clear .stage-icon{background:rgba(0,230,118,.15)}
        .stage-hold .stage-icon{background:rgba(255,23,68,.15)}

        .stage-info{flex:1}
        .stage-info h4{font-size:13px;font-weight:600;margin-bottom:2px}
        .stage-info p{font-size:11px;color:var(--text-muted)}
        .stage-count{
            font-family:'Orbitron',monospace;
            font-size:22px;font-weight:700;
        }
        .stage-pre .stage-count{color:var(--accent-blue)}
        .stage-inspect .stage-count{color:var(--accent-orange)}
        .stage-clear .stage-count{color:var(--accent-green)}
        .stage-hold .stage-count{color:var(--accent-red)}

        /* ====== CHART CONTAINERS ====== */
        .chart-container{
            position:relative;
            width:100%;
        }
        .chart-container canvas{
            width:100%!important;
        }

        /* ====== CORRIDOR RANKING ====== */
        .corridor-rank{
            display:flex;flex-direction:column;gap:10px;
        }
        .corridor-item{
            display:flex;align-items:center;gap:12px;
            padding:10px 12px;border-radius:8px;
            background:rgba(255,255,255,.02);
            transition:all .3s;
        }
        .corridor-item:hover{background:rgba(255,255,255,.04)}
        .corridor-rank-num{
            font-family:'Orbitron',monospace;
            font-size:16px;font-weight:700;
            width:30px;text-align:center;
        }
        .corridor-name{flex:1}
        .corridor-name h4{font-size:13px;font-weight:600}
        .corridor-name p{font-size:10px;color:var(--text-muted)}
        .corridor-bar-wrap{
            flex:1.5;
        }
        .corridor-bar{
            height:8px;border-radius:4px;
            background:rgba(255,255,255,.05);
            overflow:hidden;
        }
        .corridor-bar-fill{
            height:100%;border-radius:4px;
            background:linear-gradient(90deg,var(--accent-cyan),var(--accent-blue));
            transition:width 1.5s ease;
        }
        .corridor-vol{
            font-family:'Share Tech Mono',monospace;
            font-size:13px;font-weight:600;
            width:60px;text-align:right;
        }

        /* ====== FLEET STATUS ====== */
        .fleet-grid{
            display:grid;
            grid-template-columns:repeat(4,1fr);
            gap:10px;
        }
        .fleet-box{
            text-align:center;
            padding:16px 10px;
            border-radius:12px;
            border:1px solid var(--border-color);
            transition:all .3s;
        }
        .fleet-box:hover{transform:translateY(-2px)}
        .fleet-emoji{font-size:28px;margin-bottom:8px;display:block}
        .fleet-num{
            font-family:'Orbitron',monospace;
            font-size:24px;font-weight:700;
            display:block;margin-bottom:4px;
        }
        .fleet-label{font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px}
        .fleet-box.fb-truck{background:rgba(0,229,255,.05);border-color:rgba(0,229,255,.2)}
        .fleet-box.fb-truck .fleet-num{color:var(--accent-cyan)}
        .fleet-box.fb-rail{background:rgba(255,109,0,.05);border-color:rgba(255,109,0,.2)}
        .fleet-box.fb-rail .fleet-num{color:var(--accent-orange)}
        .fleet-box.fb-ship{background:rgba(41,121,255,.05);border-color:rgba(41,121,255,.2)}
        .fleet-box.fb-ship .fleet-num{color:var(--accent-blue)}
        .fleet-box.fb-air{background:rgba(213,0,249,.05);border-color:rgba(213,0,249,.2)}
        .fleet-box.fb-air .fleet-num{color:var(--accent-purple)}

        /* ====== DWELL TIME GAUGE ====== */
        .gauge-grid{
            display:grid;grid-template-columns:repeat(3,1fr);gap:14px;
        }
        .gauge-item{text-align:center}
        .gauge-ring{
            width:100px;height:100px;
            margin:0 auto 10px;
            position:relative;
        }
        .gauge-ring svg{transform:rotate(-90deg)}
        .gauge-ring circle{
            fill:none;stroke-width:8;
            cx:50;cy:50;r:42;
        }
        .gauge-bg{stroke:rgba(255,255,255,.06)}
        .gauge-fill{
            stroke-linecap:round;
            transition:stroke-dashoffset 1.5s ease;
        }
        .gauge-val{
            position:absolute;inset:0;
            display:flex;align-items:center;justify-content:center;
            font-family:'Orbitron',monospace;
            font-size:18px;font-weight:700;
        }
        .gauge-label{font-size:11px;color:var(--text-secondary);font-weight:600}
        .gauge-sub{font-size:10px;color:var(--text-muted)}

        /* ====== DOCUMENT STATUS TABLE ====== */
        .doc-table{width:100%;border-collapse:collapse}
        .doc-table th{
            text-align:left;padding:8px 12px;
            font-size:11px;text-transform:uppercase;
            letter-spacing:1px;color:var(--text-muted);
            border-bottom:1px solid var(--border-color);
        }
        .doc-table td{
            padding:10px 12px;font-size:13px;
            border-bottom:1px solid rgba(255,255,255,.03);
        }
        .doc-table tr:hover td{background:rgba(0,229,255,.03)}
        .doc-badge{
            display:inline-flex;align-items:center;gap:4px;
            padding:3px 10px;border-radius:12px;
            font-size:11px;font-weight:600;
        }
        .doc-ok{background:rgba(0,230,118,.1);color:var(--accent-green)}
        .doc-pending{background:rgba(255,214,0,.1);color:var(--accent-yellow)}
        .doc-issue{background:rgba(255,23,68,.1);color:var(--accent-red)}

        /* ====== ALERT FEED ====== */
        .alert-feed{
            display:flex;flex-direction:column;gap:8px;
            max-height:260px;overflow-y:auto;
        }
        .alert-feed::-webkit-scrollbar{width:3px}
        .alert-feed::-webkit-scrollbar-thumb{background:var(--border-color);border-radius:3px}
        .alert-item{
            display:flex;gap:12px;
            padding:10px 12px;border-radius:8px;
            border-left:3px solid;
            animation:alertSlide .5s ease;
        }
        @@keyframes alertSlide{from{opacity:0;transform:translateX(-10px)}to{opacity:1;transform:translateX(0)}}
        .alert-critical{background:rgba(255,23,68,.05);border-left-color:var(--accent-red)}
        .alert-warning{background:rgba(255,109,0,.05);border-left-color:var(--accent-orange)}
        .alert-info{background:rgba(0,229,255,.05);border-left-color:var(--accent-cyan)}
        .alert-success{background:rgba(0,230,118,.05);border-left-color:var(--accent-green)}
        .alert-icon{font-size:18px;flex-shrink:0;margin-top:2px}
        .alert-text h5{font-size:12px;font-weight:600;margin-bottom:2px}
        .alert-text p{font-size:11px;color:var(--text-muted)}
        .alert-time{
            font-family:'Share Tech Mono',monospace;
            font-size:10px;color:var(--text-muted);
            margin-left:auto;white-space:nowrap;flex-shrink:0;
        }

        /* ====== FOOTER ====== */
        .footer{
            position:relative;z-index:10;
            text-align:center;padding:16px;
            border-top:1px solid var(--border-color);
            font-size:11px;color:var(--text-muted);
            font-family:'Share Tech Mono',monospace;
        }

        /* ====== ANIMATIONS ====== */
        @@keyframes fadeInUp{
            from{opacity:0;transform:translateY(20px)}
            to{opacity:1;transform:translateY(0)}
        }
        .animate-in{animation:fadeInUp .6s ease forwards;opacity:0}
        .delay-1{animation-delay:.1s}
        .delay-2{animation-delay:.2s}
        .delay-3{animation-delay:.3s}
        .delay-4{animation-delay:.4s}
        .delay-5{animation-delay:.5s}
        .delay-6{animation-delay:.6s}

        /* ====== RESPONSIVE ====== */
        @@media(max-width:1200px){
            .kpi-strip{grid-template-columns:repeat(3,1fr)}
            .row-2-1,.row-1-1,.row-1-1-1,.row-3-col{grid-template-columns:1fr}
            .fleet-grid{grid-template-columns:repeat(2,1fr)}
        }
        @@media(max-width:768px){
            .kpi-strip{grid-template-columns:repeat(2,1fr)}
            .header{flex-direction:column;gap:12px;text-align:center}
            .header-right{justify-content:center}
            .gauge-grid{grid-template-columns:repeat(2,1fr)}
        }
    </style>
</head>
<body>

<!-- Background -->
<div class="bg-animation"></div>
<div class="grid-overlay"></div>

<!-- Header -->
