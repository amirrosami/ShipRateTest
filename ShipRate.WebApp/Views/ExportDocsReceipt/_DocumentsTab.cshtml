@using ShipRate.Application.ViewModels
@model ExportDocsReceiptFormVm

<div dir="ltr">
    @if (!Model.Id.HasValue)
    {
        <div class="alert alert-warning mb-0">
            Save header first to manage documents.
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="mb-0">Documents</h6>

            <button type="button"
                    class="btn btn-sm btn-primary"
                    hx-get="@Url.Action("AddDocument", "ExportDocsReceipt", new { exportDocsReceiptId = Model.Id })"
                    hx-target="#documentsFormContainer"
                    hx-swap="innerHTML">
                Add Document
            </button>
        </div>

        <div id="documentsFormContainer" class="mb-3"></div>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead>
                    <tr>
                        <th style="width:60px;">#</th>
                        <th>Document</th>
                        <th style="width:140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Documents.Any())
                    {
                        var rowNo = 1;
                        foreach (var item in Model.Documents)
                        {
                            <tr>
                                <td>@rowNo</td>
                                <td>@item.DocumentName</td>
                                <td>
                                    <button type="button"
                                            class="btn btn-sm btn-danger"
                                            hx-post="@Url.Action("RemoveDocument", "ExportDocsReceipt", new { exportDocsReceiptId = Model.Id, exportDocsReceiptItemId = item.Id })"
                                            hx-target="#documents-pane"
                                            hx-swap="innerHTML"
                                            hx-confirm="Are you sure you want to remove this document?">
                                        Remove
                                    </button>
                                </td>
                            </tr>

                            rowNo++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center">No documents added.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
