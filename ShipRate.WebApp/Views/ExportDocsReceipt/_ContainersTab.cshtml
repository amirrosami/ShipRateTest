@using ShipRate.Application.ViewModels
@model ExportDocsReceiptFormVm

<div id="containersSection" dir="ltr">
    @if (!Model.Id.HasValue)
    {
        <div class="alert alert-warning mb-0">
            Save header first to manage containers.
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="mb-0">Containers</h6>

            <button type="button"
                    class="btn btn-sm btn-primary"
                    hx-get="@Url.Action("AddContainer", "ExportDocsReceipt", new { exportDocsReceiptId = Model.Id })"
                    hx-target="#containersFormContainer"
                    hx-swap="innerHTML">
                Add Container
            </button>
        </div>

        <div id="containersFormContainer" class="mb-3"></div>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead>
                    <tr>
                        <th style="width:60px;">#</th>
                        <th>Container</th>
                        <th>RBS Date</th>
                        <th style="width:140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Containers.Any())
                    {
                        var rowNo = 1;
                        foreach (var item in Model.Containers)
                        {
                            <tr>
                                <td>@rowNo</td>
                                <td>@item.ContainerNo</td>
                                <td>@(item.RBSDate?.ToString("yyyy-MM-dd") ?? "")</td>
                                <td>
                                    <button type="button"
                                            class="btn btn-sm btn-danger"
                                            hx-post="@Url.Action("RemoveContainer", "ExportDocsReceipt", new { exportDocsReceiptId = Model.Id, exportDocsReceiptContainerId = item.Id })"
                                            hx-target="#containersSection"
                                            hx-swap="outerHTML"
                                            hx-confirm="Are you sure you want to remove this container?">
                                        Remove
                                    </button>
                                </td>
                            </tr>

                            rowNo++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center">No containers added.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
