@using ShipRate.Application.ViewModels
@model ExportDocsReceiptFormVm

@{
    var postAction = Model.IsEditMode ? "Edit" : "Create";
}

<div dir="ltr" class="receipt-form-container d-flex flex-column gap-3">

    <!-- 1. General Section -->
    <div class="card border shadow-sm">
        <div class="card-header bg-light py-2 px-3 d-flex align-items-center justify-content-between">
            <h6 class="mb-0 fw-semibold text-primary">
                <i class="bi bi-info-circle me-1"></i> General Information
            </h6>
            @if (Model.HeaderSaved)
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle">
                    <i class="bi bi-check-circle me-1"></i> Saved
                </span>
            }
        </div>
        <div class="card-body p-3">
            @await Html.PartialAsync("_GeneralTab", Model)
        </div>
    </div>

    <div class="card border shadow-sm @(Model.HeaderSaved ? "" : "opacity-75")">
        <div class="card-header bg-light py-2 px-3 d-flex align-items-center justify-content-between">
            <h6 class="mb-0 fw-semibold text-secondary">
                <i class="bi bi-box-seam me-1"></i> Containers
            </h6>
            @if (!Model.HeaderSaved)
            {
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                    Save General first
                </span>
            }
        </div>
        <div class="card-body p-3">
            @if (Model.HeaderSaved)
            {
                @await Html.PartialAsync("_ContainersTab", Model)
            }
            else
            {
                <div class="text-muted small py-2 text-center">
                    <i class="bi bi-lock me-1"></i> Please save the General information to manage containers.
                </div>
            }
        </div>
    </div>

</div>




