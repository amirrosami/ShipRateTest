@using ShipRate.Application.DTOs
@using ShipRate.Application.ViewModels
@model PagedResultDto<ExportDocsReceiptListItemVm>

<div class="card shadow-sm" dir="ltr">
    <div class="card-body p-2 table-responsive">
        <table class="table table-bordered table-hover table-sm align-middle mb-0" style="font-size: 0.8125rem;">
            <thead class="table-light text-nowrap">
                <tr>
                    <th style="width: 45px;" class="text-center">#</th>
                    <th style="width: 110px;">Receipt No</th>
                    <th style="width: 100px;">Receipt Date</th>
                    <th>Party</th>
                    <th style="width: 120px;">Booking</th>
                    <th style="width: 90px;">Direction</th>
                    <th>Representative</th>
                    <th>Remarks</th>
                    <th style="width: 90px;" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items != null && Model.Items.Any())
                {
                    var pageIndex = Model.PageNumber > 0 ? Model.PageNumber : 1;
                    var pageSize = Model.PageSize > 0 ? Model.PageSize : Model.Items.Count();
                    var rowIndex = (pageIndex - 1) * pageSize + 1;

                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="text-center text-muted fw-semibold">@(rowIndex++)</td>
                            <td class="fw-semibold">@item.ReceiptNo</td>
                            <td class="text-nowrap">@item.ReceiptDate.ToString("yyyy-MM-dd")</td>
                            <td>@item.PartyName</td>
                            <td class="fw-semibold text-primary">@item.BookingNo</td>
                            <td>
                                <span class="badge @(item.ReceiptDirectionName?.ToLower().Contains("in") == true ? "bg-success-subtle text-success border border-success-subtle" : "bg-primary-subtle text-primary border border-primary-subtle")">
                                    @item.ReceiptDirectionName
                                </span>
                            </td>
                            <td>@item.PersonPersonName</td>
                            <td class="text-truncate" style="max-width: 180px;" title="@item.Remarks">@item.Remarks</td>
                            <td class="text-center">
                                <div class="d-inline-flex gap-1 justify-content-center">
                                    <!-- Edit Button -->
                                    <button type="button"
                                            class="btn btn-xs btn-outline-primary p-1 lh-1"
                                            title="Edit Receipt"
                                            hx-get="@Url.Action("Edit", "ExportDocsReceipt", new { id = item.Id })"
                                            hx-target="#receiptModalBody"
                                            hx-swap="innerHTML"
                                            data-bs-toggle="modal"
                                            data-bs-target="#receiptModal">
                                        <i class="bi bi-pencil-square fs-6"></i>
                                    </button>

                                    <button type="button" 
                                            class="btn btn-xs btn-outline-secondary p-1 lh-1"
                                            hx-get="/DocumentManager/Index?objectId=@item.Id&objectTypeId=20"
                                            hx-target="#document-manager-content"
                                            hx-swap="innerHTML"
                                            title="Attachments"
                                            data-bs-toggle="modal"
                                            data-bs-target="#documentManagerModal">
                                        <i class="bi bi-folder2-open me-1"></i>
                                    </button>
                                    <button type="button"
                                            class="btn btn-xs btn-outline-primary p-1 lh-1"
                                            title="Confirm Receipt"
                                            hx-post="@Url.Action("Confirm", "ExportDocsReceipt", new { id = item.Id })"
                                            hx-confirm="Are you sure you want to confirm this receipt?"
                                            hx-swap="none">
                                        <i class="bi bi-check2-circle me-1"></i>
                                    </button>
                                    <!-- Delete Button -->
                                    <button type="button"
                                            class="btn btn-xs btn-outline-danger p-1 lh-1"
                                            title="Delete Receipt"
                                            hx-post="@Url.Action("Delete", "ExportDocsReceipt", new { id = item.Id })"
                                            hx-confirm="Are you sure you want to delete this receipt?"
                                            hx-swap="none">
                                        <i class="bi bi-trash3 fs-6"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-3">No data found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
