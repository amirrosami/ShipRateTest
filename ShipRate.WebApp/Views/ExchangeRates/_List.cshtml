@using ShipRate.Application.DTOs
@using ShipRate.Application.DTOs.Base_Info
@using ShipRate.Application.DTOs.Finance
@model PagedResultDto<ExchangeRateDto>
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Row</th>
                    <th>Exchange Date </th>
                    <th>Persian Date </th>
                    <th>Exchange Base </th>
                    <th>From Currency</th>
                    <th>To Currency</th>
                    <th>Exchange Value</th>
                    <th>Source</th>
                    <th class="text-center" style="width:160px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox display-4 d-block mb-2"></i>
                            No Records found.
                        </td>
                    </tr>
                }
                else
                {
                    int counter = (Model.PageNumber - 1) * Model.PageSize;
                    @foreach (var item in Model.Items)
                    {
                        counter++;
                        <tr>
                            <td>@counter</td>
                            <td class="fw-medium">@item.ExchangeRateDate.ToString("yyyy-MM-dd") </td>
                            <td class="fw-medium">@item.ExchangeRatePersianDate</td>
                            <td class="fw-medium">@item.ExchangeRateBaseName</td>
                            <td class="fw-medium">@item.FromCurrencyName</td>
                            <td class="fw-medium">@item.ToCurrencyName</td>
                            <td class="fw-medium">@item.ExchangeRateValue.ToString("N0")</td>
                            <td class="fw-medium">@item.ExchangeRateSource</td>
@*                             <td class="text-center">
                                <div class="form-check form-switch d-inline-block"
                                     hx-post="@Url.Action("ToggleActive", "ExchangeRates", new { id = item.Id })"
                                     hx-swap="none"
                                     style="cursor:pointer;"
                                     title="Click to toggle">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           @(item.IsActive ? "checked" : "")
                                           style="pointer-events:none;" />
                                </div>
                            </td>
 *@                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <button type="button"
                                            class="btn btn-outline-primary"
                                            title="Edit"
                                            hx-get="@Url.Action("Edit", "ExchangeRates", new { id = item.Id })"
                                            hx-target="#modal-content"
                                            hx-swap="innerHTML"
                                            onclick="showModal()">
                                        <i class="bi bi-pencil"></i>

                                    </button>
                                    <button type="button"
                                            class="btn btn-outline-danger"
                                            title="Delete"
                                            hx-get="@Url.Action("Delete", "ExchangeRates", new { id = item.Id })"
                                            hx-target="#modal-content"
                                            hx-swap="innerHTML"
                                            onclick="showModal()">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @* ── Pagination Footer ── *@

    @if (Model.TotalPages > 1)
    {
        var currentPage = Model.PageNumber;
        var totalPages = Model.TotalPages;
        var windowSize = 2; // تعداد صفحات قبل و بعد از صفحه جاری

        var startPage = Math.Max(1, currentPage - windowSize);
        var endPage = Math.Min(totalPages, currentPage + windowSize);

        <div class="card-footer d-flex justify-content-between align-items-center">
            <small class="text-muted">
                Showing @((Model.PageNumber - 1) * Model.PageSize + 1)–@Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount) of @Model.TotalCount
            </small>

            <nav>
                <ul class="pagination pagination-sm mb-0">

                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link"
                           hx-get="@Url.Action("List", "ExchangeRates")"
                           hx-target="#table-container"
                           hx-swap="innerHTML"
                           hx-vals='{"pagenumber":"@(Model.PageNumber - 1)","pageSize":"@Model.PageSize","searchterm":"@Model.SearchTerm","sortColumn":"@Model.SortColumn","sortDirection":"@Model.SortDirection"}'
                           href="#">&laquo;</a>
                    </li>

                    @* صفحه اول *@
                    @if (startPage > 1)
                    {
                        <li class="page-item @(1 == currentPage ? "active" : "")">
                            <a class="page-link"
                               hx-get="@Url.Action("List", "ExchangeRates")"
                               hx-target="#table-container"
                               hx-swap="innerHTML"
                               hx-vals='{"pagenumber":"1","pageSize":"@Model.PageSize","searchterm":"@Model.SearchTerm","sortColumn":"@Model.SortColumn","sortDirection":"@Model.SortDirection"}'
                               href="#">1</a>
                        </li>

                        @if (startPage > 2)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        }
                    }

                    @* صفحات میانی *@
                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link"
                               hx-get="@Url.Action("List", "ExchangeRates")"
                               hx-target="#table-container"
                               hx-swap="innerHTML"
                               hx-vals='{"pagenumber":"@i","pageSize":"@Model.PageSize","searchterm":"@Model.SearchTerm","sortColumn":"@Model.SortColumn","sortDirection":"@Model.SortDirection"}'
                               href="#">@i</a>
                        </li>
                    }

                    @* صفحه آخر *@
                    @if (endPage < totalPages)
                    {
                        @if (endPage < totalPages - 1)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        }

                        <li class="page-item @(totalPages == currentPage ? "active" : "")">
                            <a class="page-link"
                               hx-get="@Url.Action("List", "ExchangeRates")"
                               hx-target="#table-container"
                               hx-swap="innerHTML"
                               hx-vals='{"pagenumber":"@totalPages","pageSize":"@Model.PageSize","searchterm":"@Model.SearchTerm","sortColumn":"@Model.SortColumn","sortDirection":"@Model.SortDirection"}'
                               href="#">@totalPages</a>
                        </li>
                    }

                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link"
                           hx-get="@Url.Action("List", "ExchangeRates")"
                           hx-target="#table-container"
                           hx-swap="innerHTML"
                           hx-vals='{"pagenumber":"@(Model.PageNumber + 1)","pageSize":"@Model.PageSize","searchterm":"@Model.SearchTerm","sortColumn":"@Model.SortColumn","sortDirection":"@Model.SortDirection"}'
                           href="#">&raquo;</a>
                    </li>

                </ul>
            </nav>
        </div>
    }
</div>
