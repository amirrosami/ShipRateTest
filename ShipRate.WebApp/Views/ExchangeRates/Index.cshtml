@using ShipRate.Application.DTOs
@using ShipRate.Application.DTOs.Base_Info
@using ShipRate.Application.DTOs.Finance
@* Views/PackageTypes/Index.cshtml *@
@model PagedResultDto<ExchangeRateDto>
@{
    ViewData["Title"] = "Exchange Rates";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0"><i class="bi bi-box-seam me-2"></i>Exchange Rates</h2>
        <small class="text-muted">Manage Exchange Rates </small>
    </div>
    <div>
        <button type="button"
                class="btn btn-warning text-primary"
                hx-get="@Url.Action("GetSaoiData", "ExchangeRates")"
                hx-target="#modal-content"
                hx-swap="innerHTML"
                hx-confirm="Are you sure you want to Get Exchange rates date?"
                onclick="showModal()">
            <i class="bi bi-folder me-1"></i> Get Saoi Data(نرخ انجمن)
        </button>
        <button type="button"
                class="btn btn-primary"
                hx-get="@Url.Action("Create", "ExchangeRates")"
                hx-target="#modal-content"
                hx-swap="innerHTML"
                onclick="showModal()">
            <i class="bi bi-plus-lg me-1"></i> Add Exchange Rate
        </button>

    </div>
</div>

<!-- Search Bar -->
<div class="card mb-3">
    <div class="card-body py-2">
        <div class="row align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="search"
                           class="form-control border-start-0"
                           placeholder="Search by code, title or description..."
                           name="searchterm"
                           hx-get="@Url.Action("List", "ExchangeRates")"
                           hx-target="#table-container"
                           hx-swap="innerHTML"
                           hx-trigger="keyup changed delay:400ms, search"
                           hx-include="[name='pageSize']"
                           id="searchInput" />
                </div>
            </div>
            <div class="col-md-3 offset-md-3 text-end">
                <select name="pageSize"
                        class="form-select form-select-sm d-inline-block w-auto"
                        hx-get="@Url.Action("List", "ExchangeRates")"
                        hx-target="#table-container"
                        hx-swap="innerHTML"
                        hx-include="[name='searchterm']">
                    <option value="5">5 per page</option>
                    <option value="10" selected>10 per page</option>
                    <option value="25">25 per page</option>
                    <option value="50">50 per page</option>
                </select>
            </div>
        </div>
    </div>
</div>

<!-- Table Container — HTMX refreshes this area -->
<div id="table-container">
    @await Html.PartialAsync("_List", Model)
</div>




