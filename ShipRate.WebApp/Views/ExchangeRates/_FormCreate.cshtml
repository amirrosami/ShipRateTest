@using ShipRate.Application.DTOs
@using ShipRate.Application.DTOs.Base_Info
@using ShipRate.Application.DTOs.Finance
@model ExchangeRateCreateDto

<form hx-post="@Url.Action("Create", "ExchangeRates")"
      hx-target="#modal-content"
      hx-swap="innerHTML">

    <div class="modal-header bg-primary text-white">
        <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Add Exchange Rate</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        @Html.AntiForgeryToken()
        @if (!ViewData.ModelState.IsValid)
        {
            var allErrors = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).ToList();
            if (allErrors.Any())
            {
                <div class="alert alert-danger py-2 mb-3">
                    <ul class="mb-0 small">
                        @foreach (var err in allErrors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }
        }

        <!-- Rate Base -->
        <div class="mb-3">
            <label class="form-label fw-medium">
                Exchange Rate Base <span class="text-danger">*</span>
            </label>
            <div class="d-flex align-items-center gap-2">
                <select asp-for="ExchangeRateBaseId"
                        asp-items="@ViewBag.ExchangeRateBases"
                        class="form-select">
                    <option value="">-- Select --</option>
                </select>
                <span asp-validation-for="ExchangeRateBaseId" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-medium">
                Exchange Date<span class="text-danger">*</span>
            </label>
            <input type="date"
                   name="ExchangeRateDate"
                   value="@Model.ExchangeRateDate"
                   class="form-control @(ViewData.ModelState.ContainsKey("ExchangeRateDate") && ViewData.ModelState["ExchangeRateDate"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                   required />
        </div>



        <!-- From Currency -->
        <div class="mb-3">
            <label class="form-label fw-medium">
                From Currency <span class="text-danger">*</span>
            </label>
            <div class="d-flex align-items-center gap-2">
                <select asp-for="FromCurrencyId"
                        asp-items="@ViewBag.Currencies"
                        class="form-select">
                    <option value="">-- Select --</option>
                </select>
                <span asp-validation-for="FromCurrencyId" class="text-danger"></span>
            </div>
        </div>

        <!-- To Currency -->
        <div class="mb-3">
            <label class="form-label fw-medium">
                To Currency <span class="text-danger">*</span>
            </label>
            <div class="d-flex align-items-center gap-2">
                <select asp-for="ToCurrencyId"
                        asp-items="@ViewBag.Currencies"
                        class="form-select">
                    <option value="">-- Select --</option>
                </select>
                <span asp-validation-for="ToCurrencyId" class="text-danger"></span>
            </div>
        </div>




        <!-- Value -->
        <div class="mb-3">
            <label class="form-label fw-medium">
                Rate Value <span class="text-danger">*</span>
            </label>

@*             <input type="number"
                   name="ExchangeRate"
                   value="@Model.ExchangeRateValue"
                   class="form-control @(ViewData.ModelState.ContainsKey("ExchangeRateValue") && ViewData.ModelState["ExchangeRateValue"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                   required />
 *@


            <input type="text"
                   id="exchangeRate"
                   class="form-control"
                   placeholder="0"
                   required />
            <input type="hidden" asp-for="ExchangeRateValue" id="exchangeRateHidden" />







        </div>

        <!-- Source -->
        <div class="mb-3">
            <label class="form-label fw-medium">Exchange Rate Source</label>
            <input type="text"
                   name="ExchangeRateSource"
                   value="@Model.ExchangeRateSource"
                   class="form-control @(ViewData.ModelState.ContainsKey("ExchangeRateSource") && ViewData.ModelState["ExchangeRateSource"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                   maxlength="50" required />
        </div>

    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i> Save
        </button>
    </div>
</form>






<script>
    const input = document.getElementById('exchangeRate');
    const hidden = document.getElementById('exchangeRateHidden');

    // فرمت با جداکننده
    function formatNumber(value) {
        return value.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    }

    // حذف جداکننده
    function unformatNumber(value) {
        return value.replace(/,/g, '');
    }

    // مقدار اولیه
    if (hidden.value) {
        input.value = formatNumber(hidden.value);
    }

    // هنگام تایپ
    input.addEventListener('input', function(e) {
        let value = unformatNumber(e.target.value);
        value = value.replace(/[^\d]/g, ''); // فقط عدد
        hidden.value = value;
        e.target.value = formatNumber(value);
    });
</script>
