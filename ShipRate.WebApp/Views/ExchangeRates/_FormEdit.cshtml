@using ShipRate.Application.DTOs.Finance
@model ExchangeRateUpdateDto



<form hx-post="@Url.Action("Edit", "ExchangeRates")"
      hx-target="#modal-content"
      hx-swap="innerHTML">

    <div class="modal-header bg-primary">
        <h5 class="modal-title text-white"><i class="bi bi-pencil-square me-2"></i>Edit ExchangeRate</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />

        @if (!ViewData.ModelState.IsValid)
        {
            var allErrors = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).ToList();
            if (allErrors.Any())
            {
                <div class="alert alert-danger py-2 mb-3">
                    <ul class="mb-0 small">
                        @foreach (var err in allErrors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }
        }

        <!-- Rate Base -->
        <div class="mb-3">
            <label class="form-label fw-medium">
                Exchange Rate Base <span class="text-danger">*</span>
            </label>
            <div class="d-flex align-items-center gap-2">
                <select asp-for="ExchangeRateBaseId"
                        asp-items="@ViewBag.ExchangeRateBases"
                        class="form-select">
                    <option value="">-- Select --</option>
                </select>
                <span asp-validation-for="ExchangeRateBaseId" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-medium">
                Exchange Date<span class="text-danger">*</span>
            </label>
            <input type="date"
                   name="ExchangeRateDate"
                   asp-format="{0:yyyy-MM-dd}"
                   value="@Model.ExchangeRateDate"
                   class="form-control @(ViewData.ModelState.ContainsKey("ExchangeRateDate") && ViewData.ModelState["ExchangeRateDate"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                   required />
        </div>



        <!-- From Currency -->
        <div class="mb-3">
            <label class="form-label fw-medium">
                From Currency <span class="text-danger">*</span>
            </label>
            <div class="d-flex align-items-center gap-2">
                <select asp-for="FromCurrencyId"
                        asp-items="@ViewBag.Currencies"
                        class="form-select">
                    <option value="">-- Select --</option>
                </select>
                <span asp-validation-for="FromCurrencyId" class="text-danger"></span>
            </div>
        </div>

        <!-- To Currency -->
        <div class="mb-3">
            <label class="form-label fw-medium">
                To Currency <span class="text-danger">*</span>
            </label>
            <div class="d-flex align-items-center gap-2">
                <select asp-for="ToCurrencyId"
                        asp-items="@ViewBag.Currencies"
                        class="form-select">
                    <option value="">-- Select --</option>
                </select>
                <span asp-validation-for="ToCurrencyId" class="text-danger"></span>
            </div>
        </div>




        <!-- Value -->
        <div class="mb-3">
            <label class="form-label fw-medium">
                Rate Value <span class="text-danger">*</span>
            </label>
            <input type="number"
                   name="ExchangeRateValue"
                   value="@Model.ExchangeRateValue"
                   class="form-control @(ViewData.ModelState.ContainsKey("ExchangeRateValue") && ViewData.ModelState["ExchangeRateValue"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                   required />
        </div>

        <!-- Source -->
        <div class="mb-3">
            <label class="form-label fw-medium">Exchange Rate Source</label>
            <input type="text"
                   name="ExchangeRateSource"
                   value="@Model.ExchangeRateSource"
                   class="form-control @(ViewData.ModelState.ContainsKey("ExchangeRateSource") && ViewData.ModelState["ExchangeRateSource"]!.Errors.Any() ? "is-invalid" : "")"
                   placeholder=""
                   maxlength="50" required />
        </div>


    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-warning">
            <i class="bi bi-check-lg me-1"></i> Update
        </button>
    </div>
</form>
