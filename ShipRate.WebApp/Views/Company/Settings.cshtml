@using ShipRate.WebApp.ViewModels
@model CompanySettingsViewModel

@{
    ViewData["Title"] = "Company Settings";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0">Company Settings</h4>
            <small class="text-muted">Company: @Model.CompanyName</small>
        </div>
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="Settings" method="post">
        <input type="hidden" asp-for="CompanyId" />
        <input type="hidden" asp-for="CompanyName" />

        <div class="card">
            <div class="card-header bg-light">
                <strong>Settings Configuration</strong>
            </div>
            <div class="card-body">

                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead class="table-secondary">
                            <tr>
                                <th style="width: 25%;">Setting Key</th>
                                <th style="width: 55%;">Setting Value</th>
                                <th style="width: 20%;">Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Settings.Count; i++)
                            {
                                <tr class="align-top">
                                    <td>
                                        <input type="hidden" asp-for="Settings[i].Id" />
                                        <input asp-for="Settings[i].SettingKey"
                                               class="form-control form-control-sm bg-light"
                                               readonly />
                                    </td>
                                    <td>
                                        <textarea asp-for="Settings[i].SettingValue"
                                                  class="form-control form-control-sm"
                                                  rows="3"
                                                  placeholder="Enter value..."></textarea>
                                    </td>
                                    <td>
                                        <textarea asp-for="Settings[i].Description"
                                                  class="form-control form-control-sm"
                                                  rows="3"
                                                  placeholder="Optional description"></textarea>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>




            </div>
            <div class="card-footer text-end">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg"></i> Save Settings
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancel
                </a>
            </div>
        </div>

    </form>

</div>
