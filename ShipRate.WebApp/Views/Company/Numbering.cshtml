@using ShipRate.WebApp.ViewModels
@model NumberingSystemViewModel

@{
    ViewData["Title"] = "Numbering Settings";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0">Numbering Settings</h4>
            <small class="text-muted">Company: @Model.CompanyName</small>
        </div>
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="Numbering" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CompanyId" />
        <input type="hidden" asp-for="CompanyName" />

        <div class="card">
            <div class="card-header bg-light">
                <strong>
                    @(Model.Id.HasValue ? "Edit Numbering Configuration" : "Create Numbering Configuration")
                </strong>
            </div>
            <div class="card-body">

                @* Row 1: EntityType + Prefix + Suffix *@
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label asp-for="EntityType" class="form-label">Entity Type</label>
                        <input asp-for="EntityType" class="form-control" placeholder="" />
                        <span asp-validation-for="EntityType" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Prefix" class="form-label">Prefix</label>
                        <input asp-for="Prefix" class="form-control" placeholder="" />
                        <span asp-validation-for="Prefix" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Suffix" class="form-label">Suffix</label>
                        <input asp-for="Suffix" class="form-control" placeholder="" />
                        <span asp-validation-for="Suffix" class="text-danger"></span>
                    </div>
                </div>

                @* Row 2: PadLength + CurrentSeq + CurrentYear *@
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label asp-for="PadLength" class="form-label">Pad Length</label>
                        <input asp-for="PadLength" type="number" class="form-control" min="1" max="20" />
                        <span asp-validation-for="PadLength" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CurrentSeq" class="form-label">Current Sequence</label>
                        <input asp-for="CurrentSeq" type="number" class="form-control" min="0" />
                        <span asp-validation-for="CurrentSeq" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CurrentYear" class="form-label">Current Year</label>
                        <input asp-for="CurrentYear" type="number" class="form-control" />
                        <span asp-validation-for="CurrentYear" class="text-danger"></span>
                    </div>
                </div>

                @* Row 3: ResetYearly + IsActive *@
                <div class="row mb-3">
                    <div class="col-md-4">
                        <div class="form-check form-switch mt-4">
                            <input asp-for="ResetYearly" class="form-check-input" type="checkbox" />
                            <label asp-for="ResetYearly" class="form-check-label">Reset Yearly</label>
                        </div>
                        <small class="text-muted">Reset sequence at the start of each year</small>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check form-switch mt-4">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label">Active</label>
                        </div>
                    </div>
                </div>

                @* Preview *@
                @if (Model.Id.HasValue)
                {
                    <div class="alert alert-light border mt-3">
                        <i class="bi bi-eye"></i>
                        <strong>Preview:</strong>
                        <span class="font-monospace ms-2">
                            @Model.Prefix@((Model.CurrentSeq + 1).ToString().PadLeft(Model.PadLength, '0'))@Model.Suffix
                        </span>
                        <small class="text-muted ms-2">(next number)</small>
                    </div>
                }

            </div>
            <div class="card-footer text-end">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg"></i>
                    @(Model.Id.HasValue ? "Update Settings" : "Create Settings")
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancel
                </a>
            </div>
        </div>

    </form>

</div>
