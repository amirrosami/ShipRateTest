@model ShipRate.Application.ViewModels.ShipmentLegFormVm

<div class="modal fade" id="shipmentLegModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <form method="post"
                  asp-antiforgery="true"
                  hx-post="@Url.Action("CreateShipmentLeg", "Shipments")"
                  hx-target="#modalContainer"
                  hx-swap="innerHTML">


                <div class="modal-header">
                    <h5 class="modal-title">Add Shipment Leg</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                @await Html.PartialAsync("~/Views/Shipments/ShipmentLegs/_ShipmentLegFormFields.cshtml", Model)

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
