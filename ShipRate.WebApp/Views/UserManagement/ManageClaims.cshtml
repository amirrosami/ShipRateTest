@model ShipRate.Web.Models.UserClaimsViewModel

@{
    ViewData["Title"] = "مدیریت دسترسی‌ها";
}

<div class="content-header">
    <h1>
        <i class="bi bi-shield-lock"></i> مدیریت دسترسی‌های: @Model.UserName
    </h1>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-right"></i> بازگشت
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-key"></i> دسترسی‌های سیستم (Claims)
                </h5>
            </div>
            <div class="card-body">
                <form asp-action="ManageClaims" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="UserName" />

                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i>
                        <strong>توضیح:</strong> با انتخاب هر دسترسی، کاربر قادر به انجام آن عملیات خواهد بود.
                    </div>

                    @foreach (var claim in Model.Claims)
                    {
                        <div class="form-check mb-3 p-3 border rounded">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="selectedClaims"
                                   value="@claim.Type"
                                   id="claim_@claim.Type"
                                   @(claim.IsSelected ? "checked" : "") />
                            <label class="form-check-label" for="claim_@claim.Type">
                                <strong>@claim.DisplayName</strong>
                                <br />
                                <small class="text-muted">Claim Type: @claim.Type</small>
                            </label>
                        </div>
                    }

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                        <a asp-action="Index" class="btn btn-secondary">
                            انصراف
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg"></i> ذخیره دسترسی‌ها
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
