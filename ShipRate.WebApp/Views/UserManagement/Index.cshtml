@using ShipRate.WebApp.ViewModels
@model PagedResult<ShipRate.Web.Models.UserViewModel>
@{
    ViewData["Title"] = "Users Management";
}
<style>
    .user-thumb-wrapper {
        width: 46px;
        height: 46px;
        padding: 2px;
        border-radius: 50%;
        background: linear-gradient(135deg, #0d6efd, #6f42c1);
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
    }

    .user-thumb {
        width: 42px;
        height: 42px;
        object-fit: cover;
        border-radius: 50%;
        border: 2px solid #fff;
        background-color: #f8f9fa;
        display: block;
    }
</style>


<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h2 class="mb-1">
            <i class="bi bi-people-fill text-primary me-2"></i>Users Management
        </h2>
        <p class="text-muted mb-0">Manage users, roles and permissions</p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus me-1"></i> New User
        </a>
        <a asp-action="Roles" class="btn btn-outline-secondary">
            <i class="bi bi-shield-check me-1"></i> Manage Roles
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}


<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <!-- اضافه کردن padding عمودی کنترل شده -->
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3" dir="ltr">
            <form method="get"
                  asp-action="Index"
                  class="d-flex align-items-center gap-2 flex-wrap">

                <!-- Search - تغییر lg به sm یا حذف آن برای ظرافت بیشتر -->
                <div class="input-group input-group-sm" style="width:400px;">
                    <!-- عرض را کمی کمتر کردم تا ظریف‌تر شود -->
                    <span class="input-group-text bg-light">
                        <i class="bi bi-search"></i>
                    </span>

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="Search..." />
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i> <!-- استفاده از آیکون به جای متن برای ظرافت بیشتر (اختیاری) -->
                        <span class="d-none d-md-inline">Search</span> <!-- متن فقط در دسکتاپ نشان داده شود -->
                    </button>
                </div>

                <!-- Selects -->
                <select name="userTypeId"
                        class="form-select form-select-sm"
                        style="width:110px; padding-top: 2px; padding-bottom: 2px; min-height: 31px; font-size: 0.85rem;"
                        onchange="this.form.submit()">
                    <option value="">User Type</option>
                    @foreach (var type in ViewBag.UserTypes as List<SelectListItem>)
                    {
                        <option value="@type.Value"
                                selected="@(ViewBag.SelectedUserType?.ToString() == type.Value ? "selected" : null)">
                            @type.Text
                        </option>
                    }
                </select>

                <select name="RoleId"
                        class="form-select form-select-sm"
                        style="width:110px; padding-top: 2px; padding-bottom: 2px; min-height: 31px; font-size: 0.85rem;"
                        onchange="this.form.submit()">
                    <option value="">Role</option>
                    @foreach (var type in ViewBag.Roles as List<SelectListItem>)
                    {
                        <option value="@type.Value"
                                selected="@(ViewBag.SelectedRole?.ToString() == type.Value ? "selected" : null)">
                            @type.Text
                        </option>
                    }
                </select>

                <select name="CompanyId"
                        class="form-select form-select-sm"
                        style="width:110px; padding-top: 2px; padding-bottom: 2px; min-height: 31px; font-size: 0.85rem;"
                        onchange="this.form.submit()">
                    <option value="">Company</option>
                    @foreach (var type in ViewBag.Companies as List<SelectListItem>)
                    {
                        <option value="@type.Value"
                                selected="@(ViewBag.SelectedCompany?.ToString() == type.Value ? "selected" : null)">
                            @type.Text
                        </option>
                    }
                </select>

                <select name="status"
                        class="form-select form-select-sm"
                        style="width:110px; padding-top: 2px; padding-bottom: 2px; min-height: 31px; font-size: 0.85rem;"
                        onchange="this.form.submit()">
                    <option value="">Status</option>
                    <option value="0" selected="@(ViewBag.SelectedStatus == 0 ? "selected" : null)">InActive</option>
                    <option value="1" selected="@(ViewBag.SelectedStatus == 1 ? "selected" : null)">Active</option>
                </select>

                <!-- Page Size -->
                <select name="pageSize"
                        class="form-select form-select-sm"
                        style="width:65px; padding-top: 2px; padding-bottom: 2px; min-height: 31px; font-size: 0.85rem;"
                        onchange="this.form.submit()">
                    <option value="5" selected="@(Model.PageSize == 5)">5</option>
                    <option value="10" selected="@(Model.PageSize == 10)">10</option>
                    <option value="25" selected="@(Model.PageSize == 25)">25</option>
                    <option value="50" selected="@(Model.PageSize == 50)">50</option>
                </select>
            </form>
        </div>
    </div>

    <div class="card-body p-0">
        @if (Model == null || !Model.Items.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-person-x fs-1 text-muted"></i>
                <h5 class="mt-3">No users found</h5>
                <p class="text-muted">There is no user registered yet.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-person-plus me-1"></i> Create User
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center">Photo</th>
                            <th>User Name</th>
                            <th>User Type</th>
                            <th>Party</th>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Job Title</th>
                            <th>Roles</th>
                            <th>Prefix</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Items)
                        {
                            <tr>

                                <td class="text-center">
                                    <div class="user-thumb-wrapper mx-auto">
                                        <img src="@Url.Action("UserPhoto", "UserManagement", new { id = user.Id })"
                                             alt="@user.UserName"
                                             class="user-thumb"
                                             loading="lazy" />
                                    </div>
                                </td>


                                <td>
                                    <div class="fw-semibold">@user.UserName</div>
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(user.UserTypeName))
                                    {
                                        <span class="badge bg-info-subtle text-dark border">
                                            @user.UserTypeName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(user.PersonName))
                                    {
                                        <span>@user.PersonName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(user.FullName) ? "-" : user.FullName)
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(user.Email))
                                    {
                                        <span>@user.Email</span>
                                        @if (user.EmailConfirmed)
                                        {
                                            <i class="bi bi-check-circle-fill text-success ms-1" title="Confirmed"></i>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@user.JobTitle</td>

                                <td>
                                    @if (user.Roles != null && user.Roles.Any())
                                    {
                                        foreach (var role in user.Roles)
                                        {
                                            <span class="badge @(role == "Admin" ? "bg-danger" : "bg-primary") me-1">
                                                @role
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">No Role</span>
                                    }
                                </td>
                                <td>@user.SalesFilePrefix</td>
                                <td>
                                    @if (user.LockoutEnd != null && user.LockoutEnd > DateTimeOffset.Now)
                                    {
                                        <span class="badge bg-danger">Locked</span>
                                    }
                                    else if (user.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>

                                <td class="text-center">
                                    <div class="d-flex justify-content-center flex-wrap gap-1">
                                        <a asp-action="Edit"
                                           asp-route-id="@user.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a asp-controller="PermissionManagement"
                                           asp-action="ManagePermissions"
                                           asp-route-id="@user.Id"
                                           class="btn btn-sm btn-outline-info"
                                           title="Permissions">
                                            <i class="bi bi-shield-lock"></i>
                                        </a>

                                        <a asp-action="ResetPassword"
                                           asp-route-id="@user.Id"
                                           class="btn btn-sm btn-outline-warning"
                                           title="Change Password">
                                            <i class="bi bi-key"></i>
                                        </a>

                                        <form asp-action="ToggleActive"
                                              asp-route-id="@user.Id"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-sm @(user.IsActive ? "btn-outline-secondary" : "btn-outline-success")"
                                                    title="@(user.IsActive ? "Make Inactive" : "Make Active")">
                                                <i class="bi bi-@(user.IsActive ? "toggle-off" : "toggle-on")"></i>
                                            </button>
                                        </form>

                                        <form asp-action="Delete"
                                              asp-route-id="@user.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (Model.TotalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center p-3 border-top">

                        <div class="text-muted small">
                            Showing page @Model.Page of @Model.TotalPages
                            (@Model.TotalCount users)
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">

                                <!-- Previous -->
                                <li class="page-item @(Model.Page > 1 ? "" : "disabled")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@(Model.Page - 1)"
                                       asp-route-pageSize="@Model.PageSize"
                                       asp-route-search="@ViewBag.Search"
                                       asp-route-companyId="@ViewBag.SelectedCompany"
                                       asp-route-RoleId="@ViewBag.SelectedRole"
                                       asp-route-status="@ViewBag.SelectedStatus"
                                       asp-route-UserTypeId="@ViewBag.SelectedUserType">
                                        Previous
                                    </a>
                                </li>

                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.Page ? "active" : "")">
                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-search="@ViewBag.Search"
                                           asp-route-companyId="@ViewBag.SelectedCompany"
                                           asp-route-RoleId="@ViewBag.SelectedRole"
                                           asp-route-status="@ViewBag.SelectedStatus"
                                           asp-route-UserTypeId="@ViewBag.SelectedUserType"
                                           asp-route-page="@i"
                                           asp-route-pageSize="@Model.PageSize">
                                            @i
                                        </a>
                                    </li>
                                }

                                <!-- Next -->
                                <li class="page-item @(Model.TotalPages > Model.Page ? "" : "disabled")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-search="@ViewBag.Search"
                                       asp-route-companyId="@ViewBag.SelectedCompany"
                                       asp-route-status="@ViewBag.SelectedStatus"
                                       asp-route-RoleId="@ViewBag.SelectedRole"
                                       asp-route-UserTypeId="@ViewBag.SelectedUserType"
                                       asp-route-page="@(Model.Page + 1)"
                                       asp-route-pageSize="@Model.PageSize">
                                        Next
                                    </a>
                                </li>

                            </ul>
                        </nav>
                    </div>
                }

            </div>
        }
    </div>
</div>
