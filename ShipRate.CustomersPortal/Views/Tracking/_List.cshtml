@using Microsoft.Extensions.Localization
@using ShipRate.Application.DTOs
@using ShipRate.Application.JobsViewModels
@using ShipRate.WebAppCustomers
@using ShipRate.WebAppCustomers.ViewModels
@using System.Globalization
@model PagedResultDto<JobListItemVm>
@inject IStringLocalizer<SharedResource> Localizer
@{
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isFa = culture == "fa";
    var lang = isFa ? "fa" : "en";
    var dir = isFa ? "rtl" : "ltr";
}
<style>
    .btn-xs {
        padding: 0.15rem 0.4rem;
        font-size: 1rem;
        line-height: 1;
    }

    .table-responsive {
        overflow-x: scroll !important;
        -webkit-overflow-scrolling: touch;
    }

        /* نمایش همیشگی scrollbar در مرورگرهای مختلف */
        .table-responsive::-webkit-scrollbar {
            height: 12px;
            -webkit-appearance: none;
        }

        .table-responsive::-webkit-scrollbar-track {
            background-color: #f1f1f1;
            border-radius: 10px;
        }

        .table-responsive::-webkit-scrollbar-thumb {
            background-color: #888;
            border-radius: 10px;
        }

            .table-responsive::-webkit-scrollbar-thumb:hover {
                background-color: #555;
            }

    /* برای Firefox */
    .table-responsive {
        scrollbar-width: thin;
        scrollbar-color: #888 #f1f1f1;
    }

</style>

<input type="hidden"
       name="PageNumber"
       value="@Model.PageNumber" />

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover table-striped mb-0   ">
            <thead class="table-primary">
                <tr>
                    <th>@(isFa ? "شماره محموله" : "Shipment No")</th>
                    <th>@(isFa ? "وضعیت" : "Status")</th>
                    <th>@(isFa ? "نوع" : "Movement Type")</th>
                    <th style="width:120px"></th>
                </tr>
            </thead>

            <tbody>

                @foreach (var r in Model.Items)
                {
                    <tr>
                        <td>@r.JobNumber</td>
                        <td>@r.JobStatus</td>
                        <td>@r.MovementType</td>
                        <td class="text-end text-nowrap">
                            <div class="btn-group btn-group-sm" role="group">
                                <button class="btn btn-outline-primary px-2"
                                        hx-swap="innerHTML"
                                        title="Detail"
                                        hx-get="/Tracking/Detail/@r.Id"
                                        hx-target="#app-modal-content">
                                    <i class="bi bi-pencil"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>


    <div class="card-footer d-flex justify-content-between align-items-center">

        <div>
            @Localizer["Total"]: @Model.TotalCount
        </div>

        <nav>
            <ul class="pagination pagination-sm mb-0">

                @{
                    var currentPage = Model.PageNumber;
                    var totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
                    var startPage = Math.Max(1, currentPage - 2);
                    var endPage = Math.Min(totalPages, currentPage + 2);
                }

                @if (currentPage > 1)
                {
                    <li class="page-item">
                        <button class="page-link"
                                hx-get="/Tracking/List?PageNumber=1"
                                hx-target="#tableContainer"
                                hx-push-url="true">
                            @Localizer["First"]
                        </button>
                    </li>
                    <li class="page-item">
                        <button class="page-link"
                                hx-get="/tracking/List?PageNumber=@(currentPage - 1)"
                                hx-target="#tableContainer"
                                hx-push-url="true">
                            @Localizer["Previous"]
                        </button>
                    </li>
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <button class="page-link"
                                hx-get="/Tracking/List?PageNumber=@i"
                                hx-target="#tableContainer"
                                hx-push-url="true">
                            @i
                        </button>
                    </li>
                }

                @if (currentPage < totalPages)
                {
                    <li class="page-item">
                        <button class="page-link"
                                hx-get="/Tracking/List?PageNumber=@(currentPage + 1)"
                                hx-target="#tableContainer"
                                hx-push-url="true">
                            @Localizer["Next"]
                        </button>
                    </li>
                    <li class="page-item">
                        <button class="page-link"
                                hx-get="/Tracking/List?PageNumber=@totalPages"
                                hx-target="#tableContainer"
                                hx-push-url="true">
                            @Localizer["Last"]
                        </button>
                    </li>
                }

            </ul>
        </nav>

    </div>

</div>
