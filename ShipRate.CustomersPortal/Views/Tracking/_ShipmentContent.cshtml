@using ShipRate.Application.JobsViewModels
@model JobDetailTrackingVM

<div class="container p-1">
    <div class="card mb-2" id="route">
        <div class="card-header">Route Info</div>
        <div class="route4">
            <div class="node"><div class="line"></div><div class="dot"></div><div class="tag">POR</div><div class="place">@Model.JobDetails.OriginName</div><div class="date">Received Aug 09</div></div>
            <div class="node"><div class="line"></div><div class="dot"></div><div class="tag">POL</div><div class="place">@Model.JobDetails.DestinationName</div><div class="date">On board Aug 12</div></div>
            @* <div class="node pending"><div class="line"></div><div class="dot"></div><div class="tag">POD</div><div class="place">@Model.PortOfDischarge</div><div class="date">ETA Sep 04</div></div>
            <div class="node pending"><div class="line"></div><div class="dot"></div><div class="tag">PODel</div><div class="place">@Model.FinalDestination</div><div class="date">Est. Sep 06</div></div> *@
        </div>
    </div>

    <div class="card mb-2" id="overview">
        <div class="card-header mb-1">Overview</div>
            @await Html.PartialAsync("_Overview", Model.JobDetails)
    </div>

    <div class="card mb-2" id="containers" style="max-height: 350px;overflow-y: auto">
        <div class="card-header mb-1">BL Info</div>
        @await Html.PartialAsync("_BillOfLading", Model.BlInfos)
    </div>
    <div class="card mb-2" style="max-height: 350px;overflow-y: auto" id="bls">
        <div class="card-header mb-1">Container</div>
        @await Html.PartialAsync("_Containers", Model.Containers)
    </div>
    @* <div class="card" id="invoices">
        @await Html.PartialAsync("_Invoices", Model)
    </div>
    <div class="card" id="milestones">
        @await Html.PartialAsync("_Milestones", Model)
    </div> *@
</div>


