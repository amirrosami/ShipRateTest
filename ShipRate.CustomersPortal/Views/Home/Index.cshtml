@using Microsoft.Extensions.Localization
@using ShipRate.WebAppCustomers
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["HomePageTitle"];
}

<!-- Hero Section -->
<section class="py-5 text-center container">
    <div class="row py-lg-5">
        <div class="col-lg-8 col-md-8 mx-auto">
            <h1 class="fw-light display-4">@Localizer["WelcomeTo"] <span class="text-primary fw-bold">ShipRate</span></h1>
            <p class="lead text-muted">@Localizer["WelcomeSubtitle"]</p>
            <p class="mt-4">
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg my-2 px-4">@Localizer["GetStarted"]</a>
                <a asp-controller="Tracking" asp-action="Index" class="btn btn-outline-secondary btn-lg my-2 px-4">@Localizer["TrackShipment"]</a>
            </p>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="py-5 bg-light">
    <div class="container">
        <h2 class="text-center mb-5">@Localizer["OurServices"]</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-3">
                    <div class="card-body">
                        <i class="fa-solid fa-calculator fa-2x text-primary mb-3"></i>
                        <h5 class="card-title">@Localizer["InstantRateTitle"]</h5>
                        <p class="card-text">@Localizer["InstantRateDesc"]</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-3">
                    <div class="card-body">
                        <i class="fa-solid fa-truck-fast fa-2x text-primary mb-3"></i>
                        <h5 class="card-title">@Localizer["OrderPlacementTitle"]</h5>
                        <p class="card-text">@Localizer["OrderPlacementDesc"]</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-3">
                    <div class="card-body">
                        <i class="fa-solid fa-file-invoice fa-2x text-primary mb-3"></i>
                        <h5 class="card-title">@Localizer["InvoiceMgmtTitle"]</h5>
                        <p class="card-text">@Localizer["InvoiceMgmtDesc"]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- About Section -->
<section class="py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h2 class="mb-4">@Localizer["WhyShipRateTitle"]</h2>
                <p>@Localizer["WhyShipRateDesc"]</p>
                <ul class="list-unstyled mt-3">
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> @Localizer["Feature1"]</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> @Localizer["Feature2"]</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> @Localizer["Feature3"]</li>
                </ul>
            </div>
            <div class="col-md-6 text-center">
                <img src="/images/logistics-hero.svg" alt="Logistics" class="img-fluid" style="max-height: 300px;">
            </div>
        </div>
    </div>
</section>
