@using ShipRate.Application.DTOs.Messaging
@model MessagingMessageDto

<div class="chat-item @(Model.IsMine ? "mine" : "theirs")" data-message-id="@Model.Id">
    <div class="chat-bubble">
        @if (!Model.IsMine && !string.IsNullOrWhiteSpace(Model.SenderDisplayName))
        {
            <div class="chat-sender">@Model.SenderDisplayName</div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Body))
        {
            <div class="chat-text">@Model.Body</div>
        }

        @if (Model.Attachments != null && Model.Attachments.Any())
        {
            <div class="chat-attachments">
                @foreach (var attachment in Model.Attachments)
                {
                    var ext = GetExtension(attachment.FileName);
                    var typeClass = GetFileTypeClass(ext);
                    var isImage = IsImageFile(ext);

                    <a href="@attachment.DownloadUrl"
                       class="chat-file-card @typeClass @(isImage ? "is-image" : "")"
                       rel="noopener noreferrer"
                       title="@attachment.FileName"
                       download>

                        @*                         @if (isImage)
                        {
                            <div class="chat-file-thumb">
                                <img src="@attachment.DownloadUrl"
                                     alt="@attachment.FileName"
                                     loading="lazy" />
                            </div>
                        }
                        else
                        {*@ 
                        <div class="chat-file-icon">
                            <div class="chat-file-icon-page">
                                <span>@GetFileBadge(ext)</span>
                            </div>
                        </div>
                        @*                         }
 *@
                        <div class="chat-file-info">
                            <div class="chat-file-name">@attachment.FileName</div>

                            <div class="chat-file-meta">
                                <span>@GetFileBadge(ext)</span>
                                <span class="chat-file-dot">•</span>
                                <span>@FormatFileSize(attachment.FileSize)</span>
                            </div>
                        </div>

                        <div class="chat-file-download" aria-label="Download">
                            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                                <path d="M12 3.75a.75.75 0 0 1 .75.75v8.19l2.72-2.72a.75.75 0 1 1 1.06 1.06l-4 4a.75.75 0 0 1-1.06 0l-4-4a.75.75 0 1 1 1.06-1.06l2.72 2.72V4.5a.75.75 0 0 1 .75-.75Z" />
                                <path d="M5.25 17.25a.75.75 0 0 1 .75.75v.75h12V18a.75.75 0 0 1 1.5 0v1.5a.75.75 0 0 1-.75.75H5.25a.75.75 0 0 1-.75-.75V18a.75.75 0 0 1 .75-.75Z" />
                            </svg>
                        </div>
                    </a>
                }
            </div>
        }

        <div class="chat-footer">
            <span class="chat-time">@Model.SentAt.ToString("HH:mm")</span>
        </div>
    </div>
</div>

@functions {
    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024)
            return $"{bytes} B";

        if (bytes < 1024 * 1024)
            return $"{bytes / 1024d:0.#} KB";

        return $"{bytes / 1024d / 1024d:0.#} MB";
    }

    private static string GetExtension(string fileName)
    {
        if (string.IsNullOrWhiteSpace(fileName))
            return "file";

        var ext = System.IO.Path.GetExtension(fileName);

        if (string.IsNullOrWhiteSpace(ext))
            return "file";

        return ext.TrimStart('.').ToLowerInvariant();
    }

    private static bool IsImageFile(string extension)
    {
        return extension.ToLowerInvariant() switch
        {
            "png" or "jpg" or "jpeg" or "gif" or "webp" or "bmp" => true,
            _ => false
        };
    }

    private static string GetFileBadge(string extension)
    {
        return extension.ToLowerInvariant() switch
        {
            "pdf" => "PDF",
            "doc" => "DOC",
            "docx" => "DOCX",
            "xls" => "XLS",
            "xlsx" => "XLSX",
            "ppt" => "PPT",
            "pptx" => "PPTX",
            "zip" => "ZIP",
            "rar" => "RAR",
            "7z" => "7Z",
            "txt" => "TXT",
            "csv" => "CSV",
            "png" => "PNG",
            "jpg" => "JPG",
            "jpeg" => "JPG",
            "gif" => "GIF",
            "webp" => "WEBP",
            _ => "FILE"
        };
    }

    private static string GetFileTypeClass(string extension)
    {
        return extension.ToLowerInvariant() switch
        {
            "pdf" => "file-type-pdf",
            "doc" or "docx" => "file-type-word",
            "xls" or "xlsx" or "csv" => "file-type-excel",
            "ppt" or "pptx" => "file-type-powerpoint",
            "zip" or "rar" or "7z" => "file-type-archive",
            "png" or "jpg" or "jpeg" or "gif" or "webp" or "bmp" => "file-type-image",
            "txt" => "file-type-text",
            _ => "file-type-default"
        };
    }
}
