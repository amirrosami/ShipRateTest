@model IReadOnlyList<ShipRate.Application.DTOs.Messaging.MessagingConversationListItemDto>

@if (Model.Count == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-chat-dots fs-1 d-block mb-3 text-secondary"></i>
            <div class="fw-semibold">No conversations yet.</div>
            <div class="small">Your messages will appear here.</div>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm inbox-card">
        <div class="card-header bg-white border-0 py-3">
            <div class="d-flex align-items-center justify-content-between gap-3">
                <div>
                    <div class="fw-semibold">Conversations</div>
                    <div class="text-muted small">Click a row to open the conversation.</div>
                </div>

                <div class="text-muted small">
                    @Model.Count item(s)
                </div>
            </div>
        </div>

        <div class="list-group list-group-flush conversation-list">
            @foreach (var item in Model.OrderByDescending(x => x.LastMessageAt))
            {
                var hasUnread = item.UnreadCount > 0;
                var isClosed = string.Equals(item.StatusTitle, "Closed", StringComparison.OrdinalIgnoreCase);
                var statusFilterValue = isClosed ? "closed" : "open";
                var conversationUrl = Url.Action("Conversation", "Messaging", new { id = item.Id });
                var searchText = $"{item.Subject} {item.ScopeTitle} {item.TypeTitle} {item.StatusTitle} {item.Id}";

                <div class="list-group-item conversation-item @(hasUnread ? "conversation-unread" : "")"
                     role="button"
                     tabindex="0"
                     data-conversation-row
                     data-conversation-url="@conversationUrl"
                     data-status="@statusFilterValue"
                     data-search="@searchText">

                    <div class="conversation-icon">
                        <i class="bi bi-chat-dots"></i>
                    </div>

                    <div class="conversation-content">
                        <div class="d-flex flex-column flex-xl-row justify-content-xl-between gap-2">
                            <div class="min-w-0">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="conversation-subject">@item.Subject</span>

                                    @if (hasUnread)
                                    {
                                        <span class="badge bg-danger rounded-pill">@item.UnreadCount unread</span>
                                    }

                                    <span class="badge rounded-pill @(isClosed ? "bg-secondary" : "bg-success")">
                                        @item.StatusTitle
                                    </span>
                                </div>

                                <div class="conversation-meta">
                                    <span>@item.ScopeTitle</span>
                                    <span class="separator">•</span>
                                    <span>@item.TypeTitle</span>

                                    @if (item.AssignedToUserId.HasValue)
                                    {
                                        <span class="separator">•</span>
                                        <span>Assigned</span>
                                    }
                                    else
                                    {
                                        <span class="separator">•</span>
                                        <span>Unassigned</span>
                                    }
                                </div>
                            </div>

                            <div class="conversation-time">
                                <div class="text-muted small">Last activity</div>
                                <div>@(item.LastMessageAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</div>
                            </div>
                        </div>
                    </div>

                    <div class="conversation-actions" data-conversation-action>
                        @if (!isClosed)
                        {
                            <form method="post"
                                  hx-post="@Url.Action("CloseConversation", "Messaging", new { conversationId = item.Id })"
                                  hx-target="#inboxList"
                                  hx-swap="innerHTML"
                                  hx-confirm="Close this conversation?">
                                @Html.AntiForgeryToken()

                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-x-circle me-1"></i>
                                    Close
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted small">Closed</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

<style>
    .inbox-card {
        overflow: hidden;
    }

    .conversation-item {
        display: grid;
        grid-template-columns: 44px minmax(0, 1fr) auto;
        gap: 14px;
        align-items: center;
        padding: 16px;
        border-left: 4px solid transparent;
        cursor: pointer;
        transition: background-color .15s ease, border-color .15s ease;
    }

        .conversation-item:hover {
            background: #f8fafc;
        }

    .conversation-unread {
        background: #f8fbff;
        border-left-color: #0d6efd;
    }

    .conversation-icon {
        width: 44px;
        height: 44px;
        min-width: 44px;
        border-radius: 50%;
        background: #eef2ff;
        color: #4f46e5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .conversation-content {
        min-width: 0;
    }

    .conversation-subject {
        font-weight: 700;
        color: #111827;
        max-width: 520px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .conversation-meta {
        margin-top: 6px;
        font-size: 13px;
        color: #6b7280;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .conversation-time {
        font-size: 12px;
        color: #111827;
        white-space: nowrap;
        text-align: right;
    }

    .conversation-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        min-width: 92px;
    }

    .separator {
        color: #cbd5e1;
        margin: 0 4px;
    }

    .min-w-0 {
        min-width: 0;
    }

    @@media (max-width: 768px) {
        .conversation-item {
            grid-template-columns: 44px minmax(0, 1fr);
        }

        .conversation-actions {
            grid-column: 2;
            justify-content: flex-start;
            margin-top: 8px;
        }

        .conversation-time {
            text-align: left;
        }
    }
</style>
