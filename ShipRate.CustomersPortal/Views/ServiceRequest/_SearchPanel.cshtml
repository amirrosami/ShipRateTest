@using Microsoft.AspNetCore.Mvc.Rendering
@using ShipRate.Application.DTOs
@model ServiceRequestIndexDto


<style>

    .filter-input-xs,
    .filter-select-xs {
        max-width: 80px;
    }

    .filter-input-sm,
    .filter-select-sm {
        max-width: 120px;
    }

    .filter-input-md,
    .filter-select-md {
        max-width: 170px;
    }

    @@media (max-width: 1199.98px) {
        .filter-input-xs,
        .filter-select-xs,
        .filter-input-sm,
        .filter-select-sm,
        .filter-input-md,
        .filter-select-md {
            max-width: 100%;
        }
    }

    @@media (max-width: 575.98px) {
        .card .form-label {
            font-size: 0.75rem;
        }

        .card .form-control-sm,
        .card .form-select-sm,
        .card .btn-sm {
            font-size: 0.75rem;
        }
    }

</style>
<div class="card mb-3">
    <div class="card-body p-2">
        <form hx-get="@Url.Action("Index", "ServiceRequests")"
              hx-target="#serviceRequestGrid"
              hx-swap="innerHTML">

            <div class="row g-2 align-items-end">

                <div class="col-6 col-sm-4 col-md-3 col-xl-auto">
                    <label class="form-label small mb-1">No</label>
                    <input name="RequestNo"
                           value="@Model.Search.RequestNo"
                           class="form-control form-control-sm filter-input-sm" />
                </div>

                <div class="col-6 col-sm-8 col-md-5 col-xl-auto">
                    <label class="form-label small mb-1">Subject</label>
                    <input name="Subject"
                           value="@Model.Search.Subject"
                           class="form-control form-control-sm filter-input-md" />
                </div>

                <div class="col-6 col-sm-6 col-md-4 col-xl-auto">
                    <label class="form-label small mb-1">Requester</label>
                    <input name="RequesterName"
                           value="@Model.Search.RequesterName"
                           class="form-control form-control-sm filter-input-md" />
                </div>

                <div class="col-6 col-sm-6 col-md-4 col-xl-auto">
                    <label class="form-label small mb-1">Type</label>
                    <select name="RequestTypeId"
                            class="form-select form-select-sm filter-select-md">
                        <option value="">All</option>
                        @foreach (var item in Model.RequestTypes)
                        {
                            <option value="@item.Id" selected="@(Model.Search.RequestTypeId == item.Id)">
                                @item.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="col-6 col-sm-4 col-md-3 col-xl-auto">
                    <label class="form-label small mb-1">Status</label>
                    <select name="StatusId"
                            class="form-select form-select-sm filter-select-sm">
                        <option value="">All</option>
                        @foreach (var item in Model.Statuses)
                        {
                            <option value="@item.Id" selected="@(Model.Search.StatusId == item.Id)">
                                @item.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="col-6 col-sm-4 col-md-3 col-xl-auto">
                    <label class="form-label small mb-1">Priority</label>
                    <select name="PriorityId"
                            class="form-select form-select-sm filter-select-sm">
                        <option value="">All</option>
                        @foreach (var item in Model.Priorities)
                        {
                            <option value="@item.Id" selected="@(Model.Search.PriorityId == item.Id)">
                                @item.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="col-6 col-sm-2 col-md-2 col-xl-auto">
                    <label class="form-label small mb-1">Size</label>
                    <select name="PageSize"
                            class="form-select form-select-sm filter-select-xs">
                        <option value="10" selected="@(Model.Search.PageSize == 10)">10</option>
                        <option value="20" selected="@(Model.Search.PageSize == 20)">20</option>
                        <option value="50" selected="@(Model.Search.PageSize == 50)">50</option>
                    </select>
                </div>

                <div class="col-6 col-sm-2 col-md-2 col-xl-auto">
                    <label class="form-label small mb-1">Page</label>
                    <input name="PageNumber"
                           value="@Model.Search.PageNumber"
                           class="form-control form-control-sm filter-input-xs" />
                </div>

                <div class="col-12 col-xl-auto">
                    <div class="d-flex gap-2 justify-content-end justify-content-xl-start">
                        <button type="submit"
                                class="btn btn-primary btn-sm px-3">
                            <i class="bi bi-search"></i>
                            Search
                        </button>

                        <a class="btn btn-secondary btn-sm px-3"
                           hx-get="@Url.Action("Index", "ServiceRequests")"
                           hx-target="#serviceRequestGrid"
                           hx-swap="innerHTML">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            Reset
                        </a>
                    </div>
                </div>

            </div>
        </form>
    </div>
</div>
