@using ShipRate.Application.DTOs
@model ServiceRequestApprovalsPanelDto

<div class="card border-info">
    <div class="card-header py-2 d-flex justify-content-between align-items-center">
        <div>
            <strong>Approvals</strong>
            <span class="text-muted ms-2">
                Service Request:
                <span class="fw-semibold">@Model.ServiceRequestNo</span>
            </span>
        </div>

        <div class="d-flex gap-2">
            <button type="button"
                    class="btn btn-sm btn-primary"
                    hx-get="@Url.Action("CreateApproval", "ServiceRequests", new { serviceRequestId = Model.ServiceRequestId })"
                    hx-target="#modal-container"
                    hx-swap="innerHTML">
                <i class="bi bi-plus-circle"></i>
                Add Approval
            </button>

@*             <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    onclick="document.getElementById('approvals-panel').innerHTML = '';">
                <i class="bi bi-x-lg"></i>
            </button>
 *@
            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    hx-get="@Url.Action("EmptyApprovalsPanel", "ServiceRequests")"
                    hx-target="#approvals-panel"
                    hx-swap="innerHTML">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </div>

    <div class="card-body p-0">
        @await Html.PartialAsync("_ApprovalsGrid", Model)
    </div>
</div>
