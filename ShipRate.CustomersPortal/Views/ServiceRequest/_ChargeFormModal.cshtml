@using ShipRate.Application.DTOs
@model ServiceRequestChargeFormDto

<div class="modal fade"
     id="chargeModal"
     tabindex="-1"
     aria-labelledby="chargeModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form method="post"
                  hx-post="@Url.Action("SaveCharge", "ServiceRequests")"
                  hx-target="#charges-panel"
                  hx-swap="innerHTML">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ServiceRequestId" />

                <div class="modal-header">
                    <h5 class="modal-title" id="chargeModalLabel">
                        @(Model.Id.HasValue ? "Edit Charge" : "Add Charge")
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="row g-3">

                        <div class="col-md-4">
                            <label asp-for="ChargeTypeId" class="form-label"></label>
                            <select asp-for="ChargeTypeId" asp-items="Model.ChargeTypes" class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                            <span asp-validation-for="ChargeTypeId" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Amount" class="form-label"></label>
                            <input asp-for="Amount" class="form-control" />
                            <span asp-validation-for="Amount" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CurrencyId" class="form-label"></label>
                            <select asp-for="CurrencyId" asp-items="Model.Currencies" class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                            <span asp-validation-for="CurrencyId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CostTitle" class="form-label"></label>
                            <input asp-for="CostTitle" class="form-control" />
                            <span asp-validation-for="CostTitle" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Remarks" class="form-label"></label>
                            <input asp-for="Remarks" class="form-control" />
                            <span asp-validation-for="Remarks" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <div class="form-check mt-4">
                                <input asp-for="IsPayable" class="form-check-input" />
                                <label asp-for="IsPayable" class="form-check-label"></label>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-check mt-4">
                                <input asp-for="IsReceivable" class="form-check-input" />
                                <label asp-for="IsReceivable" class="form-check-label"></label>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-check mt-4">
                                <input asp-for="IsApproved" class="form-check-input" />
                                <label asp-for="IsApproved" class="form-check-label"></label>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
