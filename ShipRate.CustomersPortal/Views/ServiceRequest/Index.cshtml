@using Microsoft.Extensions.Localization
@using ShipRate.Application.DTOs
@using ShipRate.Application.JobsViewModels
@using ShipRate.WebAppCustomers
@using ShipRate.WebAppCustomers.ViewModels
@using System.Globalization
@model ServiceRequestIndexDto
@inject IStringLocalizer<SharedResource> Localizer
@{
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isFa = culture == "fa";
    var lang = isFa ? "fa" : "en";
    var dir = isFa ? "rtl" : "ltr";
}

@{
    ViewData["Title"] = $"{Localizer["Jobs"]}";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0"><i class="bi bi-globe me-2"></i>@Localizer["Shipments"]</h2>
            <small class="text-muted"></small>
        </div>

        <button class="btn btn-outline-primary"
                hx-get="@Url.Action("NewRequestMenu", "ServiceRequest")"
                hx-target="#app-modal-content">
            New Request
        </button>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            @Localizer["Search"]
        </div>

        <div class="card-body">

            <form id="ServiceRequestSearchForm"
                  hx-get="/ServiceRequest/List"
                  hx-target="#tableContainer"
                  hx-push-url="true">

                <div class="row g-1">

                    <div class="col-md-2">
                        <label class="form-label">@(isFa ? "شماره درخواست" : "Request No")</label>
                        <input type="text" class="form-control" name="RequestNo" value="@Model.Search.RequestNo">
                    </div>
                    <div class="col-md-3" >

                    <label class="form-label small mb-1">Type</label>
                    <select name="RequestTypeId"
                            class="form-select form-select filter-select-md">
                        <option value="">All</option>
                        @foreach (var item in Model.RequestTypes)
                        {
                            <option value="@item.Id" selected="@(Model.Search.RequestTypeId == item.Id)">
                                @item.Name
                            </option>
                        }
                    </select>

                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button class="btn btn-outline-primary me-2" type="submit">@(isFa ? "جستجو" : "Search")</button>
                    </div>

                </div>
            </form>
        </div>
    </div>


    <div id="tableContainer"
         hx-get="@Url.Action("List","ServiceRequest")"
         hx-trigger="ServiceRequestChanged from:body"
         hx-swap="innerHTML"
         hx-include="#ServiceRequestSearchForm">
        @await Html.PartialAsync("_List", Model)
    </div>
</div>

























