@using Microsoft.Extensions.Localization
@using ShipRate.Application.DTOs
@using ShipRate.Application.JobsViewModels
@using ShipRate.WebAppCustomers
@using ShipRate.WebAppCustomers.ViewModels
@using System.Globalization
@model ServiceRequestIndexDto
@inject IStringLocalizer<SharedResource> Localizer

@functions {
    public (string BadgeClass, string IconClass) GetServiceRequestTypeBadge(int requestType)
    {
        return requestType switch
        {
            1 => (
                "badge-subtle-primary text-primary",
                "bi bi-pencil-square" // FontAwesome: fa-solid fa-file-pen
               
            ),
            2 => (
                "badge-subtle-info text-info",
                "bi bi-boxes" // FontAwesome: fa-solid fa-cubes-stacked
              
            ),
           3 => (
                "badge-subtle-warning text-warning",
                "bi bi-distribute-vertical" // FontAwesome: fa-solid fa-scissors یا fa-arrows-split-up-and-left
                
            ),
           4 => (
                "badge-subtle-secondary text-secondary",
                "bi bi-file-earmark-diff" // FontAwesome: fa-solid fa-file-lines
                
            ),
            5 => (
                "badge-subtle-danger text-danger",
                "bi bi-shield-check" // FontAwesome: fa-solid fa-passport یا fa-building-columns
                
            ),
           99 or _ => (
                "badge-subtle-dark text-muted",
                "bi bi-three-dots" // FontAwesome: fa-solid fa-ellipsis
               
            )
        };
    }
}

@functions {
    public (string BadgeClass, string IconClass) GetStatusBadge(int status)
    {
        return status switch
        {
            1 => ("badge-subtle-success text-warning", "bi bi-check-circle-fill"),
            2 => ("badge-subtle-warning text-success", "bi bi-clock-history"),
            3 => ("badge-subtle-danger text-danger", "bi bi-x-circle-fill"),
            4 => ("badge-subtle-secondary text-secondary", "bi bi-pencil-square"),
            _ => ("badge-subtle-light text-muted", "bi bi-question-circle")
        };
    }
}
@{
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isFa = culture == "fa";
    var lang = isFa ? "fa" : "en";
    var dir = isFa ? "rtl" : "ltr";
}
<style>
    .btn-xs {
        padding: 0.15rem 0.4rem;
        font-size: 1rem;
        line-height: 1;
    }

    .table-responsive {
        overflow-x: scroll !important;
        -webkit-overflow-scrolling: touch;
    }

        /* نمایش همیشگی scrollbar در مرورگرهای مختلف */
        .table-responsive::-webkit-scrollbar {
            height: 12px;
            -webkit-appearance: none;
        }

        .table-responsive::-webkit-scrollbar-track {
            background-color: #f1f1f1;
            border-radius: 10px;
        }

        .table-responsive::-webkit-scrollbar-thumb {
            background-color: #888;
            border-radius: 10px;
        }

            .table-responsive::-webkit-scrollbar-thumb:hover {
                background-color: #555;
            }

    /* برای Firefox */
    .table-responsive {
        scrollbar-width: thin;
        scrollbar-color: #888 #f1f1f1;
    }

</style>

<input type="hidden"
       name="PageNumber"
       value="@Model.Search.PageNumber" />

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover table-striped mb-0   ">
            <thead class="table-primary">
                <tr>
                    <th scope="col">Request NO</th>
                    <th scope="col">Type</th>
                    <th scope="col">Subject</th>
                    <th scope="col">Request Date</th>
                    <th scope="col">Created By</th>
                    <th scope="col">Status</th>
                    <th scope="col"></th>
                </tr>
            </thead>

            <tbody>

                @foreach (var r in Model.Result.Items)
                {
                    <tr>
                        <td class="sr-cell-num">@r.RequestNo</td>
                        <td>
                            @{
                                var (requestbadgeClass, requesticonClass) = GetServiceRequestTypeBadge(r.RequestTypeId);
                            }
                            <span class="badge @requestbadgeClass d-inline-flex align-items-center gap-1 py-1 px-2">
                                <i class="@requesticonClass"></i>
                                <span style="font-size: 1rem;">@r.RequestTypeName</span>
                            </span>
                        </td>
                        <td class="sr-cell-bl">@r.Subject</td>
                        <td class="sr-cell-date">@r.RequestDate.ToString("dd MMM yyyy")</td>
                        <td>@r.CreateUserName</td>
                        <td>
                            @{
                                var (badgeClass, iconClass) = GetStatusBadge(r.StatusId);
                            }
                            <span class="badge @badgeClass d-inline-flex align-items-center gap-1 py-1 px-2">
                                <i class="@iconClass"></i>
                                <span style="font-size: 1rem;">@r.StatusName</span>
                            </span>
                        </td>
                        <td class="text-end text-nowrap">
                            <div class="btn-group btn-group-sm" role="group">
                                <button class="btn btn-outline-primary px-2"
                                        hx-swap="innerHTML"
                                        title="Detail"
                                        hx-get="/ServiceRequest/EditRequest/@r.Id"
                                        hx-target="#app-modal-content">
                                    <i class="bi bi-pencil"></i>
                                </button>

                                @if (r.StatusId == 1 || r.StatusId == 4)
                                {
                                    <button class="btn btn-outline-primary px-2"
                                            hx-swap="innerHTML"
                                            title="Submit"
                                            hx-get="/ServiceRequest/SubmitRequest/@r.Id"
                                            hx-target="#app-modal-content">
                                        <i class="bi bi-check-circle"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>


    <div class="card-footer d-flex justify-content-between align-items-center">

        <div>
            @Localizer["Total"]: @Model.Result.TotalCount
        </div>

        <nav>
            <ul class="pagination pagination-sm mb-0">

                @{
                    var currentPage = Model.Result.PageNumber;
                    var totalPages = (int)Math.Ceiling((double)Model.Result.TotalCount / Model.Result.PageSize);
                    var startPage = Math.Max(1, currentPage - 2);
                    var endPage = Math.Min(totalPages, currentPage + 2);
                }

                @if (currentPage > 1)
                {
                    <li class="page-item">
                        <button class="page-link"
                                hx-get="/ServiceRequest/List?PageNumber=1"
                                hx-target="#tableContainer"
                                hx-push-url="true">
                            @Localizer["First"]
                        </button>
                    </li>
                    <li class="page-item">
                        <button class="page-link"
                                hx-get="/ServiceRequest/List?PageNumber=@(currentPage - 1)"
                                hx-target="#tableContainer"
                                hx-push-url="true">
                            @Localizer["Previous"]
                        </button>
                    </li>
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <button class="page-link"
                                hx-get="/ServiceRequest/List?PageNumber=@i"
                                hx-target="#tableContainer"
                                hx-push-url="true">
                            @i
                        </button>
                    </li>
                }

                @if (currentPage < totalPages)
                {
                    <li class="page-item">
                        <button class="page-link"
                                hx-get="/ServiceRequest/List?PageNumber=@(currentPage + 1)"
                                hx-target="#tableContainer"
                                hx-push-url="true">
                            @Localizer["Next"]
                        </button>
                    </li>
                    <li class="page-item">
                        <button class="page-link"
                                hx-get="/ServiceRequest/List?PageNumber=@totalPages"
                                hx-target="#tableContainer"
                                hx-push-url="true">
                            @Localizer["Last"]
                        </button>
                    </li>
                }

            </ul>
        </nav>

    </div>

</div>




