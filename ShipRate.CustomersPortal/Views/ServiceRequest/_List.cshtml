@functions {
    string FormatType(ShipRate.Application.ViewModels.ServiceRequestType t) => t switch
    {
        ShipRate.Application.ViewModels.ServiceRequestType.BLAmendment => "BL Amendment",
        ShipRate.Application.ViewModels.ServiceRequestType.Consolidation => "Consolidation",
        ShipRate.Application.ViewModels.ServiceRequestType.Split => "Split",
        _ => t.ToString()
    };

    string FormatStatus(ShipRate.Application.ViewModels.ServiceRequestStatus s) => s switch
    {
        ShipRate.Application.ViewModels.ServiceRequestStatus.Pending => "Pending",
        ShipRate.Application.ViewModels.ServiceRequestStatus.InReview => "In Review",
        ShipRate.Application.ViewModels.ServiceRequestStatus.Approved => "Approved",
        ShipRate.Application.ViewModels.ServiceRequestStatus.Rejected => "Rejected",
        _ => s.ToString()
    };
}

