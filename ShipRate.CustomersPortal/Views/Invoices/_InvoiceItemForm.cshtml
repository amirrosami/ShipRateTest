@using ShipRate.Application.DTOs.Finance
@model InvoiceItemEditVm

<div class="card mb-3">
    <div class="card-header">
        @(Model.Id.HasValue ? "Edit Item" : "New Item")
    </div>

    <div class="card-body">
        <form hx-post="@Url.Action("SaveItem", "Invoices")"
              hx-target="#invoice-item-form-container"
              hx-swap="innerHTML"
              class="row g-3">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="InvoiceId" />
            <input type="hidden" asp-for="SequenceNumber" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="col-md-3">
                <label asp-for="ChargeTypeId" class="form-label">Charge Type</label>
                <select asp-for="ChargeTypeId"
                        class="form-select item-charge-filter"
                        data-finance-direction-id="@ViewContext.ViewData["FinanceDirectionId"]"
                        data-selected-charge-id="@Model.ChargeId">
                    <option value="">Select...</option>
                    @foreach (var item in Model.ChargeTypes)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
                <span asp-validation-for="ChargeTypeId" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="CurrencyId" class="form-label">Currency</label>
                <select asp-for="CurrencyId"
                        class="form-select item-charge-filter"
                        data-finance-direction-id="@ViewContext.ViewData["FinanceDirectionId"]"
                        data-selected-charge-id="@Model.ChargeId">
                    <option value="">Select...</option>
                    @foreach (var item in Model.Currencies)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
                <span asp-validation-for="CurrencyId" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="ChargeId" class="form-label">Charge</label>
                <select asp-for="ChargeId" class="form-select" id="ChargeId">
                    <option value="">Select...</option>
                    @foreach (var item in Model.Charges)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
                <span asp-validation-for="ChargeId" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="QTY" class="form-label">QTY</label>
                <input asp-for="QTY" class="form-control item-calc" />
                <span asp-validation-for="QTY" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="UnitPrice" class="form-label">Unit Price</label>
                <input asp-for="UnitPrice" class="form-control item-calc" />
                <span asp-validation-for="UnitPrice" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Discount" class="form-label">Discount</label>
                <input asp-for="Discount" class="form-control item-calc" />
                <span asp-validation-for="Discount" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="TaxPercent" class="form-label">Tax Percent</label>
                <input asp-for="TaxPercent" class="form-control item-calc" />
                <span asp-validation-for="TaxPercent" class="text-danger"></span>
            </div>

            <div class="col-md-12">
                <label asp-for="Description" class="form-label">Description</label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="col-md-12">
                <label asp-for="ChargeTypeSupplementRemarks" class="form-label">Supplement Remarks</label>
                <input asp-for="ChargeTypeSupplementRemarks" class="form-control" />
                <span asp-validation-for="ChargeTypeSupplementRemarks" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label class="form-label">Amount Before Discount</label>
                <input id="amountBeforeDiscountPreview"
                       class="form-control text-end"
                       value="@Model.AmountBeforeDiscount.ToString("N2")"
                       readonly />
            </div>

            <div class="col-md-3">
                <label class="form-label">Amount After Discount</label>
                <input id="amountAfterDiscountPreview"
                       class="form-control text-end"
                       value="@Model.AmountAfterDiscount.ToString("N2")"
                       readonly />
            </div>

            <div class="col-md-3">
                <label class="form-label">Tax Amount</label>
                <input id="taxAmountPreview"
                       class="form-control text-end"
                       value="@Model.TaxAmount.ToString("N2")"
                       readonly />
            </div>

            <div class="col-md-3">
                <label class="form-label">Total Amount</label>
                <input id="totalAmountPreview"
                       class="form-control text-end"
                       value="@Model.TotalAmount.ToString("N2")"
                       readonly />
            </div>

            <div class="col-md-12 d-flex justify-content-end gap-2">
                <button type="button"
                        class="btn btn-secondary"
                        hx-get="@Url.Action("ItemForm", "Invoices", new { invoiceId = Model.InvoiceId })"
                        hx-target="#invoice-item-form-container"
                        hx-swap="innerHTML">
                    Clear
                </button>

                <button type="submit" class="btn btn-primary">
                    Save Item
                </button>
            </div>
        </form>
    </div>
</div>
