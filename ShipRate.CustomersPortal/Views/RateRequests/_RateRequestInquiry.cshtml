@using ShipRate.WebAppCustomers.ViewModels
@model RateRequestInquiryVM

<form hx-post="/RateRequests/SaveInquiry" hx-swap="none" class="p-2">
    <input type="hidden" name="RateRequestId" value="@Model.RateRequestId" />

    <!-- بخش اطلاعات هدر با استایل شیک‌تر -->
    <div class="card shadow-none border mb-4">
        <div class="card-header bg-light py-2">
            <h6 class="mb-0"><i class="bx bx-info-circle me-1"></i> Inquiry Details</h6>
        </div>
        <div class="card-body pt-3">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Origin</label>
                    <div class="input-group input-group-merge">
                        <span class="input-group-text"><i class="bx bx-map-pin"></i></span>
                        <select asp-for="OriginId" asp-items="Model.Locations" class="form-select select2"></select>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Destination</label>
                    <div class="input-group input-group-merge">
                        <span class="input-group-text"><i class="bx bx-flag"></i></span>
                        <select asp-for="DestinationId" asp-items="Model.Locations" class="form-select select2"></select>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Transport Type</label>
                    <select asp-for="TransportTypeId" asp-items="Model.TransportTypes" class="form-select"></select>
                </div>
                <div class="col-12">
                    <label class="form-label fw-bold">Remarks</label>
                    <textarea asp-for="Remarks" class="form-control" rows="2" placeholder="Enter any specific instructions for carriers..."></textarea>
                </div>
            </div>
        </div>
    </div>

    <!-- بخش انتخاب فروشندگان (Dual List Layout) -->
    <div class="row g-3">
        <!-- ستون سمت چپ: لیست موجود -->
        <div class="col-md-6">
            <label class="form-label fw-bold text-primary">Available Carriers</label>
            <div class="input-group input-group-merge mb-2">
                <span class="input-group-text"><i class="bx bx-search"></i></span>
                <input type="text" id="carrierSearch" class="form-control" placeholder="Quick search..." onkeyup="filterCarriers(this.value)">
            </div>
            <div class="border rounded shadow-sm bg-white" style="height: 300px; overflow-y: auto;" id="carrierList">
                <ul class="list-group list-group-flush">
                    @foreach (var carrier in Model.AvailableCarriers)
                    {
                        <li class="list-group-item list-group-item-action d-flex align-items-center py-2 carrier-row">
                            <input class="form-check-input me-2" type="checkbox" name="SelectedCarrierIds"
                                   value="@carrier.Id" id="c_@carrier.Id" onchange="updateSelectedCount()">
                            <label class="form-check-label w-100 cursor-pointer" for="c_@carrier.Id">
                                <span class="fw-medium">@carrier.Name</span>
                            </label>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <!-- ستون سمت راست: راهنما یا وضعیت انتخاب -->
        <div class="col-md-6">
            <label class="form-label fw-bold text-success">Selection Summary</label>
            <div class="card h-100 border shadow-none bg-light">
                <div class="card-body d-flex flex-column align-items-center justify-content-center text-center">
                    <div id="selection-empty-state">
                        <i class="bx bx-subdirectory-right display-4 text-muted"></i>
                        <p class="text-muted">Select carriers from the left list to include in this inquiry.</p>
                    </div>
                    <div id="selection-summary" class="d-none w-100">
                        <div class="display-5 fw-bold text-primary" id="selected-count">0</div>
                        <p class="mb-0">Carriers Selected</p>
                        <hr class="w-100">
                        <small class="text-muted">A separate inquiry record will be created for each selected carrier.</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-footer mt-4 pb-0">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-primary btn-lg px-4 shadow">
            <i class="bx bx-paper-plane me-1"></i> Create Inquiries
        </button>
    </div>
</form>

<style>
    .cursor-pointer {
        cursor: pointer;
    }

    .carrier-row:hover {
        background-color: #f8f9fa;
    }

    #carrierList::-webkit-scrollbar {
        width: 5px;
    }

    #carrierList::-webkit-scrollbar-thumb {
        background: #dcdcdc;
        border-radius: 10px;
    }

    .btn-label-secondary {
        background-color: #ebeef0;
        color: #8592a3;
    }
</style>

<script>
    function filterCarriers(val) {
        const rows = document.querySelectorAll('.carrier-row');
        val = val.toLowerCase();
        rows.forEach(row => {
            const text = row.querySelector('label').innerText.toLowerCase();
            row.style.setProperty('display', text.includes(val) ? 'flex' : 'none', 'important');
        });
    }

    function updateSelectedCount() {
        const count = document.querySelectorAll('input[name="SelectedCarrierIds"]:checked').length;
        const emptyState = document.getElementById('selection-empty-state');
        const summary = document.getElementById('selection-summary');
        const countDisplay = document.getElementById('selected-count');

        countDisplay.innerText = count;
        if (count > 0) {
            emptyState.classList.add('d-none');
            summary.classList.remove('d-none');
        } else {
            emptyState.classList.remove('d-none');
            summary.classList.add('d-none');
        }
    }
</script>
