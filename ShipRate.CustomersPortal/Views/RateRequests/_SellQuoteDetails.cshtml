@using ShipRate.Application.DTOs
@using Microsoft.Extensions.Localization
@using System.Globalization
@using ShipRate.WebAppCustomers
@inject IStringLocalizer<SharedResource> Localizer
@model SellQuoteListDto
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var direction = isRtl ? "rtl" : "ltr";
    var textAlign = isRtl ? "text-end" : "text-start";
    var textAlignOpposite = isRtl ? "text-start" : "text-end";

    var grandTotal = Model.Items?.Sum(x => x.Quantity * x.UnitRate) ?? 0;
    var mainCurrency = Model.Items?.FirstOrDefault()?.CurrencyCode ?? "USD";
}

<div class="container-fluid pb-5" dir="@direction">
    <!-- Header & Action Buttons -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="@textAlign">
            <h4 class="mb-0 text-primary fw-bold">@Localizer["SellQuoteDetails"]</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item small">@Localizer["SellQuotation"] #@Model.QuotationNo.ToString()</li>
                </ol>
            </nav>
        </div>

        <button type="button" class="btn btn-light border" data-bs-dismiss="modal">
            <i class="bi bi-arrow-left me-1"></i> @Localizer["BackToList"]
        </button>
    </div>

    <!-- Summary Info Card -->
    <div class="card border-0 mb-4">
        <div class="card-header bg-primary bg-gradient text-white py-3">
            <div class="row align-items-center">
                <div class="col">
                    <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>@Localizer["GeneralInformation"]</h6>
                </div>
                <div class="col-auto">
                    <span class="badge bg-white text-primary">@Localizer["Ref"]: @(Model.QuotationNo ?? "N/A")</span>
                </div>
            </div>
        </div>
        <div class="card-body bg-light-subtle @textAlign">
            <div class="row g-4">
                <div class="col-md-3 col-sm-6">
                    <label class="info-label">@Localizer["CarrierVendor"]</label>
                </div>
                <div class="col-md-3 col-sm-6">
                    <label class="info-label">@Localizer["ServiceVehicle"]</label>
                    <span class="info-value">@(Model.OptionsServiceName ?? "-") (@(Model.VehicleName ?? "-"))</span>
                </div>
                <div class="col-md-2 col-sm-4">
                    <label class="info-label">@Localizer["TransitTime"]</label>
                    <span class="info-value"><i class="bi bi-clock me-1 text-primary"></i> @Model.TransitDays @Localizer["Days"]</span>
                </div>
                <div class="col-md-2 col-sm-4">
                    <label class="info-label">@Localizer["RouteType"]</label>
                    @if (Model.IsDirect)
                    {
                        <span class="badge bg-success-subtle text-success status-badge">@Localizer["Direct"]</span>
                    }
                    else
                    {
                        <span class="badge bg-warning-subtle text-warning status-badge">@Localizer["Indirect"]</span>
                    }
                </div>
                <div class="col-md-2 col-sm-4 @(isRtl ? "text-start" : "text-end")">
                    <label class="info-label">@Localizer["Validity"]</label>
                    <span class="info-value text-danger"><i class="bi bi-calendar-check me-1"></i> @Model.ValidUntil?.ToString("yyyy-MM-dd")</span>
                </div>

                <div class="col-md-3 col-sm-6">
                    <label class="info-label">@Localizer["ETD"]</label>
                    <span class="info-value">@(Model.ETD?.ToString("yyyy-MM-dd") ?? "-")</span>
                </div>
                <div class="col-md-3 col-sm-6">
                    <label class="info-label">@Localizer["ETA"]</label>
                    <span class="info-value">@(Model.ETA?.ToString("yyyy-MM-dd") ?? "-")</span>
                </div>
                <div class="col-md-3 col-sm-6">
                    <label class="info-label">@Localizer["QuoteDate"]</label>
                    <span class="info-value">@(Model.QuotationDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")</span>
                </div>
                <div class="col-md-3 col-sm-6 @(isRtl ? "text-start" : "text-end")">
                    <label class="info-label text-primary fw-bold">@Localizer["GrandTotal"]</label>
                    <h4 class="mb-0 text-primary fw-bold">@mainCurrency @grandTotal.ToString("N2")</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Items Table Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="px-4 py-3">@Localizer["ChargeDescription"]</th>
                            <th class="py-3">@Localizer["ContainerType"]</th>
                            <th class="py-3 text-center">@Localizer["Qty"]</th>
                            <th class="py-3 @textAlignOpposite">@Localizer["UnitRate"]</th>
                            <th class="py-3 text-center">@Localizer["Currency"]</th>
                            <th class="py-3 @textAlignOpposite pe-4">@Localizer["TotalAmount"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="px-4">
                                        <div class="fw-bold text-dark">@item.ChargeTypeName</div>
                                        <small class="text-muted font-monospace">@item.ChargeTypeCode</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border fw-normal">@item.SizeTypeShortName</span>
                                    </td>
                                    <td class="text-center fw-medium">@item.Quantity.ToString("G29")</td>
                                    <td class="@textAlignOpposite font-monospace">@item.UnitRate.ToString("N2")</td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary-subtle text-secondary">@item.CurrencyCode</span>
                                    </td>
                                    <td class="@textAlignOpposite fw-bold pe-4 text-primary">@item.TotalAmount.ToString("N2")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">@Localizer["NoItemsAvailable"]</td>
                            </tr>
                        }
                    </tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="5" class="@textAlignOpposite fw-bold py-3 text-secondary">@Localizer["SummarySubTotal"]:</td>
                                <td class="@textAlignOpposite fw-bold py-3 pe-4 text-primary fs-5">@mainCurrency @grandTotal.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
    </div>

    <!-- Remarks Section -->
    <div class="row">
        <div class="col-md-8">
            <div class="card border-0 remarks-section p-3 @textAlign">
                <h6 class="fw-bold mb-2 text-dark"><i class="bi bi-chat-left-dots me-2"></i>@Localizer["AgentRemarks"]</h6>
                <p class="mb-0 text-muted small" style="white-space: pre-line;">
                    @(string.IsNullOrWhiteSpace(Model.Remarks) ? Localizer["NoRemarksProvided"] : Model.Remarks)
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 bg-light p-3">
                <div class="d-flex justify-content-between mb-2">
                    <span class="small text-muted">@Localizer["CreatedBy"]:</span>
                    <span class="small fw-bold">@Model.CreateUserName</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="small text-muted">@Localizer["LastUpdated"]:</span>
                    <span class="small fw-bold">@Model.UpdateUserName</span>
                </div>
            </div>
        </div>
    </div>
</div>
