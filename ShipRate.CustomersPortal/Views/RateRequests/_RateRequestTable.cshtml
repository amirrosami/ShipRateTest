    </div>


    <div class="card-footer d-flex justify-content-between align-items-center">

        <div>
            @Localizer["Total"]: @Model.Pagination.TotalCount
        </div>

        <nav>
            <ul class="pagination pagination-sm mb-0">

                @{
                    var currentPage = Model.Pagination.PageNumber;
                    var totalPages = (int)Math.Ceiling((double)Model.Pagination.TotalCount / Model.Pagination.PageSize);
                    var startPage = Math.Max(1, currentPage - 2);
                    var endPage = Math.Min(totalPages, currentPage + 2);
                }

                @if (currentPage > 1)
                {
                    <li class="page-item">
                        <button class="page-link"
                                hx-get="/RateRequests/Index?PageNumber=1"
                                hx-target="#tableContainer"
                                hx-push-url="true">
                            @Localizer["First"]
                        </button>
                    </li>
                    <li class="page-item">
                        <button class="page-link"
                                hx-get="/RateRequests/Index?PageNumber=@(currentPage - 1)"
                                hx-target="#tableContainer"
                                hx-push-url="true">
                            @Localizer["Previous"]
                        </button>
                    </li>
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <button class="page-link"
                                hx-get="/RateRequests/Index?PageNumber=@i"
                                hx-target="#tableContainer"
                                hx-push-url="true">
                            @i
                        </button>
                    </li>
                }

                @if (currentPage < totalPages)
                {
                    <li class="page-item">
                        <button class="page-link"
                                hx-get="/RateRequests/Index?PageNumber=@(currentPage + 1)"
                                hx-target="#tableContainer"
                                hx-push-url="true">
                            @Localizer["Next"]
                        </button>
                    </li>
                    <li class="page-item">
                        <button class="page-link"
                                hx-get="/RateRequests/Index?PageNumber=@totalPages"
                                hx-target="#tableContainer"
                                hx-push-url="true">
                            @Localizer["Last"]
                        </button>
                    </li>
                }

            </ul>
        </nav>

    </div>

</div>
<script>

    function sendAllDraftInquiryEmails(rateRequestId) {
        if (!confirm('آیا از ارسال همه Inquiry های Draft این Rate Request مطمئن هستید؟')) {
            return;
        }

        fetch('/RateRequests/SendAllDraftInquiryEmails', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': getAntiForgeryToken()
            },
            body: `rateRequestId=${rateRequestId}`
        })
        .then(response => response.json())
        .then(result => {
            alert(result.message);
            if (result.success) {
                location.reload();
            }
        })
        .catch(err => {
            alert('Error in sending emails');
            console.error(err);
        });
    }
</script>