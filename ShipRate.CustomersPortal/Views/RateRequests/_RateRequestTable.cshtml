                                    <i class="bi bi-pencil"></i>
                                </button>

@*                                 <button class="btn btn-outline-warning px-2"
                                        hx-target="#assign-modal-container"
                                        hx-swap="innerHTML"
                                        title="Assign Sales User">
                                    <i class="bi bi-person-plus"></i>
                                </button>
 *@


                              @*   <button class="btn btn-sm btn-outline-info"
                                        hx-get="/RateRequests/AssignSalesUser?id=@r.Id"
                                        hx-target="#modal-content2"
                                        hx-swap="innerHTML">
