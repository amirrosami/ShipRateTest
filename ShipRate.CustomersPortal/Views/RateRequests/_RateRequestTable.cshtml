                                        title="Documents"
                                        >
                                    <i class="bi bi-folder2-open "></i>
                                </button>
                                @* <button class="btn btn-outline-secondary px-2"
                                        hx-get="/RateRequests/GetResponds?rateRequestId=@r.Id"
                                        hx-target="#respondsListContainer"
                                        hx-swap="innerHTML"
                                        title="Responds">
                                    <i class="bi bi-list-ul "></i>
                                </button> *@

                                <button class="btn btn-outline-primary px-2"
                                        hx-get="/RateRequests/GetSellQuotes?rateRequestId=@r.Id"
