                                        hx-target="#inquiryListContainer"
                                        hx-swap="innerHTML">
                                    <i class="bi bi-list-ul"></i>
                                </button> *@

@*                                 <button class="btn btn-primary px-2"
                                        title="Inquiry"
                                        onclick="openInquiryModal('@r.Id')">
                                    <i class="bi bi-file-earmark-text"></i>
                                </button>
 *@
@*                                 <button class="btn btn-success px-2"
                                        onclick="sendAllDraftInquiryEmails('@r.Id')"
                                        title="Send Inquiry Email To All (Only Draft)">
                                    <i class="bi bi-send"></i>
                                </button>
 *@
                                <button class="btn btn-outline-danger px-2"
                                        hx-target="#app-modal-content"
                                        hx-get="/RateRequests/DeleteConfirm/@r.Id"
                                        hx-swap="innerHTML"
                                        title="Delete">
