@using Microsoft.Extensions.Localization
@using ShipRate.Application.DTOs
@using System.Globalization
@using ShipRate.WebAppCustomers
@model RateRequestFormDto
@inject IStringLocalizer<SharedResource> Localizer
@{
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isFa = culture == "fa";
    var lang = isFa ? "fa" : "en";
    var dir = isFa ? "rtl" : "ltr";
}

<style>
    .modal-content {
        height: 95vh;
        display: flex;
        flex-direction: column;
        direction: @(isFa ? "rtl" : "ltr");
    }

    .modal-header {
        flex-shrink: 0;
        border-bottom: 1px solid #e9ecef;
        padding: .75rem 1rem;
    }

    .modal-body {
        flex: 1;
        overflow-y: auto;
        padding: 1rem;
    }

    .modal-footer {
        flex-shrink: 0;
        border-top: 1px solid #dee2e6;
        padding: .75rem 1rem;
        background: #f8f9fa;
    }

    .card {
        border: 1px solid #eef1f4;
        box-shadow: 0 2px 6px rgba(0,0,0,.04);
        margin-bottom: .75rem;
    }

    .card-header {
        background: #f8f9fa;
        border-bottom: 1px solid #e9ecef;
        padding: .55rem .7rem;
    }

    .card-body {
        padding: .7rem;
    }

    .compact-row {
        --bs-gutter-x: .75rem;
        --bs-gutter-y: .6rem;
    }

    .form-label {
        margin-bottom: .2rem;
        font-size: .82rem;
        font-weight: 500;
        line-height: 1.2;
    }

    .form-control,
    .form-select {
        height: 34px;
        font-size: .875rem;
        padding-top: .25rem;
        padding-bottom: .25rem;
    }

    textarea.form-control {
        height: auto;
        min-height: 90px;
    }

    .table-sm th,
    .table-sm td {
        padding: .35rem;
        font-size: .84rem;
    }

    .table thead th {
        background: #f8f9fa;
        font-weight: 600;
        border-bottom: 1px solid #dee2e6;
    }

    #partySearchResults {
        margin-top: .25rem;
    }

    .modal-body::-webkit-scrollbar {
        width: 8px;
    }

    .modal-body::-webkit-scrollbar-thumb {
        background: #888;
        border-radius: 4px;
    }

        .modal-body::-webkit-scrollbar-thumb:hover {
            background: #555;
        }

    #Remarks {
        height: auto !important;
        min-height: 90px;
        resize: vertical;
    }

    @@media (max-width: 991.98px) {
        .modal-body {
            padding: .85rem;
        }

        .card {
            margin-bottom: .6rem;
        }
    }
</style>

<ul class="nav nav-tabs mb-3" id="rateRequestTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="general-tab" data-bs-toggle="tab" data-bs-target="#general-info" type="button" role="tab">
            @Localizer["GeneralInformation"]
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.Id == null ? "disabled" : "")"
                id="cargo-tab"
                data-bs-toggle="tab"
                data-bs-target="#cargo-details"
                type="button" role="tab">
            @Localizer["CargoDetails"] @(Model.Id == null ? $"{Localizer["SaveFirst"]}" : "")
        </button>
    </li>
</ul>

<div class="tab-content" id="rateRequestTabsContent">

    <div class="tab-pane fade show active" id="general-info" role="tabpanel">
        <form hx-post="@(Model.Id != null ? "/RateRequests/Edit" : "/RateRequests/SaveStep1")"
              hx-target="#app-modal-content"
              hx-swap="innerHTML">

            @Html.AntiForgeryToken()
            @if (!ViewData.ModelState.IsValid)
            {
                var allErrors = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).ToList();
                if (allErrors.Any())
                {
                    <div class="alert alert-danger py-2 mb-1">
                        <ul class="mb-0 small">
                            @foreach (var err in allErrors)
                            {
                                if (err.Contains("-"))
                                {
                                    foreach (var item in err.Split("-"))
                                    {
                                        if (!string.IsNullOrEmpty(item.Trim()))
                                        {
                                            <li>@item</li>
                                        }
                                    }
                                }
                                else
                                {
                                    <li>@err</li>
                                }
                            }
                        </ul>
                    </div>
                }
            }

            <input type="hidden" asp-for="Id" />

            <div class="row compact-row">
                <div class="col-12">
                    <div class="card">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-primary bg-opacity-10 border-0">
                                <h6 class="mb-0 text-primary fw-semibold">
                                    <i class="bi bi-person-circle me-2"></i>@Localizer["RequestInfo"]
                                </h6>
                            </div>

                            <div class="card-body">
                                <div class="row g-2">
                                    <div class="col-md-3">
                                        <label asp-for="CompanyId" class="form-label">@Localizer["Company"]</label>
                                        <select asp-for="CompanyId" class="form-select" asp-items="Model.Companies">
                                            <option value="">@Localizer["SelectCompany"]</option>
                                        </select>
                                    </div>

                                    <div class="col-md-3">
                                        <label asp-for="SourceId" class="form-label">@Localizer["RequestSource"]</label>
                                        <select asp-for="SourceId" class="form-select" asp-items="Model.Sources">
                                            <option value="">@Localizer["SelectSource"]</option>
                                        </select>
                                    </div>

                                    <div class="col-md-3">
                                        <label asp-for="RequestDate" class="form-label">@Localizer["RequestDate"]</label>
                                        <input asp-for="RequestDate" type="date" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-primary bg-opacity-10 border-0">
                                <h6 class="mb-0 text-primary fw-semibold">
                                    <i class="bi bi-person-circle me-2"></i>@Localizer["Customer"]
                                </h6>
                            </div>

                            <div class="card-body">
                                <div class="row compact-row">
                                    <div class="col-md-5">
                                        <label asp-for="CustomerName" class="form-label">@Localizer["CustomerName"]</label>
                                        <input type="hidden" asp-for="CustomerId" id="CustomerId" />
                                        <input type="text" name="CustomerName" value="@Model.CustomerName" class="form-control" readonly />
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="MobileNo" class="form-label">@Localizer["MobileNo"]</label>
                                        <input asp-for="MobileNo" class="form-control" id="_MobileNo" />
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="EmailAddress" class="form-label">@Localizer["EmailAddress"]</label>
                                        <input asp-for="EmailAddress" class="form-control" id="_EmailAddress" />
                                    </div>
                                    <div class="col-md-5">
                                        <label asp-for="ContactName" class="form-label">@Localizer["ContactName"]</label>
                                        <input asp-for="ContactName" class="form-control" id="_ContactName" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-success bg-opacity-10 border-0">
                                <h6 class="mb-0 text-success fw-semibold">
                                    <i class="bi bi-box-seam me-2"></i>@Localizer["Cargo"]
                                </h6>
                            </div>

                            <div class="card-body">
                                <div class="row compact-row">
                                    <div class="col-md-3">
                                        <label asp-for="OriginId" class="form-label">@Localizer["Origin"]</label>
                                        <select asp-for="OriginId" class="form-select" asp-items="Model.Origins">
                                            <option value="">@Localizer["Select"]</option>
                                        </select>
                                    </div>

                                    <div class="col-md-3">
                                        <label asp-for="DestinationId" class="form-label">@Localizer["Destination"]</label>
                                        <select asp-for="DestinationId" class="form-select" asp-items="Model.Destinations">
                                            <option value="">@Localizer["Select"]</option>
                                        </select>
                                    </div>

                                    <div class="col-md-3">
                                        <label asp-for="TradeTypeId" class="form-label">@Localizer["TradeType"]</label>
                                        <select asp-for="TradeTypeId" class="form-select" asp-items="Model.TradeTypes">
                                            <option value="">@Localizer["Select"]</option>
                                        </select>
                                    </div>

                                    <div class="col-md-3">
                                        <label asp-for="MovementTypeId" class="form-label">@Localizer["MovementType"]</label>
                                        <select asp-for="MovementTypeId" class="form-select" asp-items="Model.MovementTypes">
                                            <option value="">@Localizer["Select"]</option>
                                        </select>
                                    </div>

                                    <div class="col-md-3">
                                        <label asp-for="PaymentTypeId" class="form-label">@Localizer["PaymentType"]</label>
                                        <select asp-for="PaymentTypeId" class="form-select" asp-items="Model.PaymentTypes">
                                            <option value="">@Localizer["Select"]</option>
                                        </select>
                                    </div>

                                    <div class="col-md-3">
                                        <label asp-for="CargoCommodityId" class="form-label">@Localizer["CargoCommodity"]</label>
                                        <select asp-for="CargoCommodityId"
                                                asp-items="Model.CargoCommodities"
                                                class="form-select"
                                                id="_CargoCommodityId"
                                                onchange="if(this.value){ document.getElementById('_CargoCommodityDescription').value = this.options[this.selectedIndex].text.trim(); }">
                                            <option value="">@Localizer["Select"]</option>
                                        </select>
                                    </div>

                                    <div class="col-md-3">
                                        <label asp-for="CargoCommodityDescription" class="form-label">@Localizer["CommodityDescription"]</label>
                                        <input asp-for="CargoCommodityDescription" class="form-control" id="_CargoCommodityDescription" />
                                    </div>

                                    <div class="col-md-3">
                                        <label asp-for="CargoHandlingTypeId" class="form-label">@Localizer["CargoHandlingType"]</label>
                                        <select asp-for="CargoHandlingTypeId" class="form-select" asp-items="Model.CargoHandlingTypes">
                                            <option value="">@Localizer["Select"]</option>
                                        </select>
                                    </div>

                                    <div class="col-md-3">
                                        <label asp-for="CargoNatureId" class="form-label">@Localizer["CargoNature"]</label>
                                        <select asp-for="CargoNatureId" class="form-select" asp-items="Model.CargoNatures">
                                            <option value="">@Localizer["Select"]</option>
                                        </select>
                                    </div>

                                    <div class="col-md-3">
                                        <label asp-for="LoadTypeId" class="form-label">@Localizer["LoadType"]</label>
                                        <select asp-for="LoadTypeId" class="form-select" asp-items="Model.LoadTypes">
                                            <option value="">@Localizer["Select"]</option>
                                        </select>
                                    </div>

                                    <div class="col-md-3">
                                        <label asp-for="CargoReadinessDate" class="form-label">@Localizer["CargoReadinessDate"]</label>
                                        <input asp-for="CargoReadinessDate" type="date" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-success bg-opacity-10 border-0">
                                <h6 class="mb-0 text-success fw-semibold">
                                    <i class="bi bi-box-seam me-2"></i>@Localizer["RequiredServicesAndRelatedAddresses"]
                                </h6>
                            </div>

                            <div class="card-body">
                                <div class="row compact-row align-items-end mb-3">
                                    <div class="col-2">
                                        <div class="form-check mb-1">
                                            <input asp-for="PickupRequired" id="PickupRequired" class="form-check-input" />
                                            <label asp-for="PickupRequired" class="form-check-label">@Localizer["PickupRequired"]</label>
                                        </div>
                                    </div>
                                    <div class="col-8">
                                        <label asp-for="PickupAddress" class="form-label">@Localizer["PickupAddress"]</label>
                                        <input asp-for="PickupAddress" class="form-control PickupRequired-text-field" />
                                    </div>
                                    <div class="col-2">
                                        <label asp-for="OriginZipCode" class="form-label">@Localizer["ZipCode"]</label>
                                        <input asp-for="OriginZipCode" id="OriginZipCode" class="form-control PickupRequired-text-field" />
                                    </div>
                                </div>

                                <div class="row compact-row align-items-end mb-3">
                                    <div class="col-2">
                                        <div class="form-check mb-1">
                                            <input asp-for="DeliveryRequired" id="DeliveryRequired" class="form-check-input" />
                                            <label asp-for="DeliveryRequired" class="form-check-label">@Localizer["DeliveryRequired"]</label>
                                        </div>
                                    </div>
                                    <div class="col-8">
                                        <label asp-for="DeliveryAddress" class="form-label">@Localizer["DeliveryAddress"]</label>
                                        <input asp-for="DeliveryAddress" id="DeliveryAddress" class="form-control DeliveryRequired-text-field" />
                                    </div>
                                    <div class="col-2">
                                        <label asp-for="DestinationZipCode" class="form-label">@Localizer["ZipCode"]</label>
                                        <input asp-for="DestinationZipCode" id="DestinationZipCode" class="form-control DeliveryRequired-text-field" />
                                    </div>
                                </div>

                                <div class="row compact-row align-items-center mt-2">
                                    <div class="col-3">
                                        <div class="form-check">
                                            <input asp-for="CustomsClearanceRequired" class="form-check-input" />
                                            <label asp-for="CustomsClearanceRequired" class="form-check-label">@Localizer["CustomsClearance"]</label>
                                        </div>
                                    </div>
                                    <div class="col-3">
                                        <div class="form-check">
                                            <input asp-for="InsuranceRequired" class="form-check-input" />
                                            <label asp-for="InsuranceRequired" class="form-check-label">@Localizer["Insurance"]</label>
                                        </div>
                                    </div>
                                    <div class="col-3">
                                        <div class="form-check">
                                            <input asp-for="StuffingRequired" class="form-check-input" />
                                            <label asp-for="StuffingRequired" class="form-check-label">@Localizer["Stuffing"]</label>
                                        </div>
                                    </div>
                                    <div class="col-3">
                                        <div class="form-check">
                                            <input asp-for="WarehousingRequired" class="form-check-input" />
                                            <label asp-for="WarehousingRequired" class="form-check-label">@Localizer["Warehousing"]</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 mb-3">
                            <label asp-for="Remarks" class="form-label">@Localizer["Remarks"]</label>
                            <textarea asp-for="Remarks" rows="3" class="form-control"></textarea>
                        </div>

                        <div class="row compact-row pb-2">
                            <div class="col-md-6">
                                <div class="card border shadow-sm">
                                    <div class="card-header d-flex justify-content-between align-items-center py-2 px-3 bg-light">
                                        <span class="text-secondary fw-bold" style="font-size: 0.8rem; letter-spacing: 0.5px;">
                                            <i class="bi bi-truck me-2"></i>@Localizer["TransportMode"]
                                        </span>
                                        <button type="button" class="btn btn-sm btn-primary py-1 px-3" style="font-size: 0.75rem; border-radius: 4px;" onclick="addTransportType()">
                                            @Localizer["Add"]
                                        </button>
                                    </div>
                                    <div class="card-body p-3">
                                        <div class="table-responsive">
                                            <table class="table table-sm table-borderless mb-0 align-middle">
                                                <thead>
                                                    <tr class="text-muted" style="font-size: 0.75rem;">
                                                        <th class="ps-0 fw-semibold">@Localizer["TransportMode"]</th>
                                                        <th class="pe-0" style="width: 50px;"></th>
                                                    </tr>
                                                </thead>
                                                <tbody id="transportTypesContainer">
                                                    @if (Model.TransportTypes != null)
                                                    {
                                                        for (int i = 0; i < Model.TransportTypes.Count; i++)
                                                        {
                                                            <tr>
                                                                <td class="ps-0">
                                                                    <select name="TransportTypes[@i].TransportTypeId" class="form-select">
                                                                        <option value="">@Localizer["Select"]</option>
                                                                        @foreach (var item in Model.TransportTypesSelectList)
                                                                        {
                                                                            <option value="@item.Id"
                                                                                    selected="@(item.Id == Model.TransportTypes[i].TransportTypeId)">
                                                                                @item.TransportTypeName
                                                                            </option>
                                                                        }
                                                                    </select>
                                                                </td>
                                                                <td class="pe-0 text-end" style="width: 50px;">
                                                                    <button type="button" class="btn btn-outline-danger btn-sm" style="height: 34px; width: 34px; padding: 0;" onclick="this.closest('tr').remove()">
                                                                        ✕
                                                                    </button>
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="card border shadow-sm">
                                    <div class="card-header d-flex justify-content-between align-items-center py-2 px-3 bg-light">
                                        <span class="text-secondary fw-bold" style="font-size: 0.8rem; letter-spacing: 0.5px;">
                                            <i class="bi bi-hdd-rack me-2"></i>@Localizer["ContainerType"]
                                        </span>
                                        <button type="button" class="btn btn-sm btn-primary py-1 px-3" style="font-size: 0.75rem; border-radius: 4px;" onclick="addContainer()">
                                            @Localizer["Add"]
                                        </button>
                                    </div>
                                    <div class="card-body p-3">
                                        <div class="table-responsive">
                                            <table class="table table-sm table-borderless mb-0 align-middle">
                                                <thead>
                                                    <tr class="text-muted" style="font-size: 0.75rem;">
                                                        <th class="ps-0 fw-semibold">@Localizer["ContainerType"]</th>
                                                        <th class="fw-semibold" style="width: 100px;">@Localizer["Qty"]</th>
                                                        <th class="pe-0" style="width: 50px;"></th>
                                                    </tr>
                                                </thead>
                                                <tbody id="containersContainer">
                                                    @if (Model.Containers != null)
                                                    {
                                                        for (int i = 0; i < Model.Containers.Count; i++)
                                                        {
                                                            <tr>
                                                                <td class="ps-0">
                                                                    <select name="Containers[@i].ContainerSizeTypeId" class="form-select">
                                                                        <option value="">@Localizer["Select"]</option>
                                                                        @foreach (var item in Model.ContainerTypesSelectList)
                                                                        {
                                                                            <option value="@item.Id"
                                                                                    selected="@(item.Id == Model.Containers[i].ContainerSizeTypeId)">
                                                                                @item.ShortName
                                                                            </option>
                                                                        }
                                                                    </select>
                                                                </td>
                                                                <td>
                                                                    <input name="Containers[@i].Counts" value="@Model.Containers[i].Counts" type="number" class="form-control" />
                                                                </td>
                                                                <td class="pe-0 text-end">
                                                                    <button type="button" class="btn btn-outline-danger btn-sm" style="height: 34px; width: 34px; padding: 0;" onclick="this.closest('tr').remove()">
                                                                        ✕
                                                                    </button>
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div>
                            <button type="submit" class="btn btn-primary">
                                @(Model.Id != null && Model.Id != Guid.Empty ? Localizer["UpdateInformation"] : Localizer["SaveAndContinue"])
                            </button>
                            <button type="button" class="btn btn-light border" onclick="AppModal.close()">
                                @Localizer["Cancel"]
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <div class="tab-pane fade" id="cargo-details" role="tabpanel">
        @if (Model.Id != null && Model.Id != Guid.Empty)
        {
            <div hx-get="@Url.Action("Panel", "CargoDetails", new { RateRequestId = Model.Id })" hx-trigger="load, cargoDetailsChanged2 from:body">
                <div class="text-center p-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2">@Localizer["LoadingCargoDetails"]</p>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-danger border" onclick="AppModal.close()">
                    @Localizer["Close"]
                </button>
            </div>
        }
    </div>
</div>

<script>
    let transportIndex = @(Model.TransportTypes?.Count ?? 0);
    let containerIndex = @(Model.Containers?.Count ?? 0);

    function addTransportType() {
        const html = `
        <tr>
            <td>
                <select name="TransportTypes[\${transportIndex}].TransportTypeId" class="form-select">
                    <option value="">@Localizer["Select"]</option>
                    @if (Model.TransportTypesSelectList != null)
                    {
                            foreach (var item in Model.TransportTypesSelectList)
                            {
                                    <option value="@item.Id">@item.TransportTypeName</option>
                            }
                    }
                </select>
            </td>
            <td class="text-center">
                <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" onclick="this.closest('tr').remove()">✕</button>
            </td>
        </tr>`;
        document.getElementById("transportTypesContainer").insertAdjacentHTML("beforeend", html);
        transportIndex++;
    }

    function addContainer() {
        const html = `
        <tr>
            <td>
                <select name="Containers[\${containerIndex}].ContainerSizeTypeId" class="form-select">
                    <option value="">@Localizer["Select"]</option>
                    @if (Model.ContainerTypesSelectList != null)
                    {
                            foreach (var item in Model.ContainerTypesSelectList)
                            {
                                    <option value="@item.Id">@item.ShortName</option>
                            }
                    }
                </select>
            </td>
            <td>
                <input name="Containers[\${containerIndex}].Counts" type="number" class="form-control form-control-sm"/>
            </td>
            <td class="text-center">
                <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" onclick="this.closest('tr').remove()">✕</button>
            </td>
        </tr>`;
        document.getElementById("containersContainer").insertAdjacentHTML("beforeend", html);
        containerIndex++;
    }
</script>

<script>
    document.body.addEventListener("switchToCargoTab", function () {
        console.info("switchToCargoTab triggered");

        const tabEl = document.getElementById("cargo-tab");
        if (!tabEl) {
            console.warn("cargo-tab not found");
            return;
        }

        if (tabEl.classList.contains("disabled")) {
            console.warn("cargo-tab is disabled. enabling...");
            tabEl.classList.remove("disabled");
        }

        bootstrap.Tab.getOrCreateInstance(tabEl).show();
    });
</script>

<script>
    function toggleFields(checkbox, textFieldsPattern) {
        const textFields = document.querySelectorAll(textFieldsPattern);

        textFields.forEach(field => {
            field.disabled = !checkbox.checked;
            if (!checkbox.checked) {
                field.value = '';
            }
        });
    }

    function initPickupDeliveryToggle() {
        const pickupRequired = document.getElementById("PickupRequired");
        const deliveryRequired = document.getElementById("DeliveryRequired");

        if (pickupRequired) {
            toggleFields(pickupRequired, ".PickupRequired-text-field");
            pickupRequired.addEventListener("change", function () {
                toggleFields(pickupRequired, ".PickupRequired-text-field");
            });
        }

        if (deliveryRequired) {
            toggleFields(deliveryRequired, ".DeliveryRequired-text-field");
            deliveryRequired.addEventListener("change", function () {
                toggleFields(deliveryRequired, ".DeliveryRequired-text-field");
            });
        }
    }

    document.addEventListener("DOMContentLoaded", initPickupDeliveryToggle);

    document.body.addEventListener("htmx:afterSwap", function (evt) {
        if (evt.target.id === "app-modal-content") {
            initPickupDeliveryToggle();
        }
    });
</script>
