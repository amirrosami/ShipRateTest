@using Microsoft.Extensions.Localization
@using ShipRate.Application.DTOs
@using ShipRate.Application.ViewModels
@using ShipRate.WebAppCustomers
@using System.Globalization
@model PagedResultDto<PaymentDocumentListItemVm>
@inject IStringLocalizer<SharedResource> Localizer

@{
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isFa = culture == "fa";
    var lang = isFa ? "fa" : "en";
    var dir = isFa ? "rtl" : "ltr";
}
@{
    ViewData["Title"] = isFa ? "پرداختی ها" :"Payment Documents";
}

<div class="container-fluid" dir="@dir">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">@(isFa ? "پرداختی ها" :"Payment Documents")</h3>

        @* <button type="button"
                class="btn btn-primary"
                hx-get="@Url.Action("Create", "PaymentDocuments")"
                hx-target="#globalModalContent"
                hx-swap="innerHTML"
                data-bs-toggle="modal"
                data-bs-target="#globalModal">
            New Payment Document
        </button> *@
    </div>

    <div class="card mb-3">
        <div class="card-body">
            @await Html.PartialAsync("_SearchForm", ViewBag.Search as PaymentDocumentSearchVm)
        </div>
    </div>

    <div id="payment-document-list"
         hx-get="@Url.Action("List", "PaymentDocuments")"
         hx-trigger="load, paymentDocumentChanged from:body"
         hx-include="#paymentDocumentSearchForm"
         hx-target="#payment-document-list"
         hx-swap="innerHTML">
        <div class="text-center py-4">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="globalModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyborad="false">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content" id="globalModalContent">
        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.body.addEventListener('hidden.bs.modal', function (evt) {
            if (evt.target.id === 'globalModal') {
                document.getElementById('globalModalContent').innerHTML = '';
            }
        });
    </script>
}
