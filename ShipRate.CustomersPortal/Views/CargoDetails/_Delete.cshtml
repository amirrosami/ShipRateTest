@using Microsoft.Extensions.Localization
@using ShipRate.Application.ViewModels
@using System.Globalization
@using ShipRate.WebAppCustomers
@model CargoDetailDeleteVm
@inject IStringLocalizer<SharedResource> Localizer

@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var direction = isRtl ? "rtl" : "ltr";
    var textAlign = isRtl ? "text-end" : "text-start";
}
            <form asp-action="DeleteConfirmed"
                  asp-controller="CargoDetails"
                  dir="@direction"
                  method="post"
                  hx-post="@Url.Action("DeleteConfirmed", "CargoDetails", new { id = Model.Id })"
                  hx-target="#cargoDetailsPanel"
                  hx-swap="outerHTML">

                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">@(isRtl ? "Delete Cargo Detail" : "حذف محموله")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body text-start">
                    <input type="hidden" name="id" value="@Model.Id" />

                    <p class="mb-2">
            @(isRtl ? "آیا از حذف اطمینان دارید ؟" : "Are you sure you want to delete this cargo detail?")
                    </p>

                    <div class="alert alert-warning mb-0">
                        <strong>Seq:</strong> @Model.Sequence
                        <br />
                        <strong>@(isRtl ? "توضیحات" :"Description"):</strong> @Model.CargoDescription
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        @(isRtl ? "انصراف" : "Cancel")
                    </button>

                    <button type="submit" class="btn btn-danger">
                        @(isRtl ? "حذف" : "Delete")
                    </button>
                </div>

            </form>

