@using ShipRate.WebAppCustomers.ViewModels
@model DocumentManagerViewModel

<div class="modal-header py-2 bg-light">
    <h6 class="modal-title">
        <i class="bi bi-folder2-open me-1"></i>Document Manager
    </h6>
    <button type="button" class="btn-close " data-bs-dismiss="modal"></button>
</div>
<div class="modal-body p-2" style="font-size: 1rem;">

    <!-- Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="text-muted">Documents for this record</span>
        <button type="button" class="btn  btn-primary"
                hx-get="/DocumentManager/DocumentForm?objectId=@Model.ObjectId&objectTypeId=@Model.ObjectTypeId"
                hx-target="#doc-form-container"
                hx-swap="innerHTML">
            <i class="bi bi-plus-lg me-1"></i>New Document
        </button>
    </div>

    <!-- Document Form Container (hidden until needed) -->
    <div id="doc-form-container"></div>

    <!-- Master Grid: Documents -->
    <div class="table-responsive mb-2" style="max-height: 200px; overflow-y: auto;">
        <table class="table  table-hover table-bordered mb-0" style="font-size: 0.8rem;">
            <thead class="table-primary sticky-top">
                <tr>
                    <th style="width:30px;">#</th>
                    <th>Type</th>
                    <th>Title</th>
                    <th>Doc No</th>
                    <th>Date</th>
                    <th>Created By</th>
                    <th>Created At</th>
                    <th>Last Edit By</th>
                    <th>Updated At</th>
                    <th style="width:40px;">Att.</th>
                    <th style="width:40px;">Eml.</th>
                    <th style="width:90px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Documents.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-3">No documents found.</td></tr>
                }
                @{
                    var idx = 0;
                }
                @foreach (var doc in Model.Documents)
                {
                    idx++;
                    <tr class="doc-row" style="cursor:pointer;"
                        hx-get="/DocumentManager/Attachments?documentId=@doc.Id"
                        hx-target="#attachments-grid"
                        hx-swap="innerHTML"
                        hx-vals='{"documentId": "@doc.Id"}'
                        data-doc-id="@doc.Id"
                        hx-trigger="click">

                        <td>@idx</td>
                        <td>@doc.DocumentType</td>
                        <td>@doc.DocumentTitle</td>
                        <td>@doc.DocumentNo</td>
                        <td>@doc.DocumentDate.ToString("yyyy-MM-dd")</td>
                        <td>@doc.CreateUserName</td>
                        <td>@doc.CreateDateTime.Value.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@doc.LastEditUserName</td>
                        <td>@doc.LastEditDateTime</td>

                        <td class="text-center">
                            <span class="badge bg-secondary">@doc.AttachmentCount</span>
                        </td>
                        <td class="text-center">
                            <span class="badge bg-info">@doc.EmailCount</span>
                        </td>
                        <td>
                            <button class="btn btn-outline-warning  py-0 px-1"
                                    hx-get="/DocumentManager/DocumentForm?objectId=@Model.ObjectId&objectTypeId=@Model.ObjectTypeId&id=@doc.Id"
                                    hx-target="#doc-form-container"
                                    hx-swap="innerHTML"
                                    onclick="event.stopPropagation();">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-outline-danger  py-0 px-1"
                                    hx-post="/DocumentManager/DeleteDocument?id=@doc.Id&objectId=@Model.ObjectId&objectTypeId=@Model.ObjectTypeId"
                                    hx-target="#document-manager-content"
                                    hx-swap="innerHTML"
                                    hx-confirm="Delete this document?"
                                    onclick="event.stopPropagation();">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Detail Grids: Attachments (left) + Emails (right) -->
    <div class="row g-2">
        <!-- Attachments -->
        <div class="col-md-12">
            <div class="card border">
                <div class="card-header py-1 px-2 bg-light d-flex justify-content-between align-items-center">
                    <small class="fw-bold"><i class="bi bi-paperclip me-1"></i>Attachments</small>
                </div>
                <div class="card-body p-1" id="attachments-grid">
                    <div class="text-center text-muted py-3" style="font-size:0.78rem;">
                        Select a document to view attachments
                    </div>
                </div>
            </div>
        </div>
        <!-- Emails -->
        @*         <div class="col-md-6">
            <div class="card border">
                <div class="card-header py-1 px-2 bg-light d-flex justify-content-between align-items-center">
                    <small class="fw-bold"><i class="bi bi-envelope me-1"></i>Emails</small>
                </div>
                <div class="card-body p-1" id="emails-grid">
                    <div class="text-center text-muted py-3" style="font-size:0.78rem;">
                        Select a document to view emails
                    </div>
                </div>
            </div>
        </div>
 *@    </div>
</div>


<script>
    // وقتی Attachments لود شد، Emails هم خودکار لود بشه
    document.body.addEventListener('htmx:afterSwap', function(e) {
        if (e.detail.target.id === 'attachments-grid') {
            var url = e.detail.requestConfig.path;
            var params = new URLSearchParams(url.split('?')[1]);
            var docId = params.get('documentId');
            323

            if (docId) {
                htmx.ajax('GET',
                    '/DocumentManager/Emails?documentId=' + docId,
                    { target: '#emails-grid', swap: 'innerHTML' }
                );
            }
        }
    });

    // Highlight ردیف انتخاب شده
    document.body.addEventListener('click', function(e) {
        var row = e.target.closest('.doc-row');
        if (row) {
            document.querySelectorAll('.doc-row')
                .forEach(function(r) { r.classList.remove('table-active'); });
            row.classList.add('table-active');
        }
    });
</script>
