@using ShipRate.Application.DTOs.Notif
@model CreateNotificationDto

<div class="modal-header">
    <h5 class="modal-title">Create Notification</h5>

    <button type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close">
    </button>
</div>

<form method="post"
      hx-post="@Url.Action("Create", "Notifications")"
      hx-target="#notificationModalContent"
      hx-swap="innerHTML">

    @Html.AntiForgeryToken()

    <div class="modal-body">
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">
                @ViewBag.ErrorMessage
            </div>
        }

        <div class="row g-3">

            <div class="col-md-6">
                <label class="form-label">Title</label>
                <input type="text"
                       name="Title"
                       value="@Model.Title"
                       class="form-control"
                       maxlength="250"
                       required />
            </div>

            <div class="col-md-6">
                <label class="form-label">Notification Type</label>
                <select name="NotificationTypeId"
                        class="form-select"
                        required>
                    <option value="">Select...</option>

                    @foreach (var item in Model.NotificationTypes)
                    {
                        <option value="@item.Value"
                                selected="@(item.Value == Model.NotificationTypeId.ToString())">
                            @item.Text
                        </option>
                    }
                </select>
            </div>

            <div class="col-12">
                <label class="form-label">Message</label>
                <textarea name="Message"
                          class="form-control"
                          rows="4">@Model.Message</textarea>
            </div>

            <div class="col-md-4">
                <label class="form-label">Severity</label>
                <select name="SeverityId"
                        class="form-select"
                        required>
                    <option value="">Select...</option>

                    @foreach (var item in Model.Severities)
                    {
                        <option value="@item.Value"
                                selected="@(item.Value == Model.SeverityId.ToString())">
                            @item.Text
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Priority</label>
                <select name="PriorityId"
                        class="form-select"
                        required>
                    <option value="">Select...</option>

                    @foreach (var item in Model.Priorities)
                    {
                        <option value="@item.Value"
                                selected="@(item.Value == Model.PriorityId.ToString())">
                            @item.Text
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Reference No</label>
                <input type="text"
                       name="ReferenceNo"
                       value="@Model.ReferenceNo"
                       class="form-control" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Publish At</label>
                <input type="datetime-local"
                       name="PublishAt"
                       value="@Model.PublishAt.ToString("yyyy-MM-ddTHH:mm")"
                       class="form-control"
                       required />
            </div>

            <div class="col-md-6">
                <label class="form-label">Expire At</label>
                <input type="datetime-local"
                       name="ExpireAt"
                       value="@(Model.ExpireAt.HasValue? Model.ExpireAt.Value.ToString("yyyy-MM-ddTHH:mm") : "")"
                       class="form-control" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Target Url</label>
                <input type="text"
                       name="TargetUrl"
                       value="@Model.TargetUrl"
                       class="form-control"
                       placeholder="/ServiceRequests/Details/123" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Icon Css Class</label>
                <input type="text"
                       name="IconCssClass"
                       value="@Model.IconCssClass"
                       class="form-control"
                       placeholder="bx bx-bell" />
            </div>

            <div class="col-12">
                <input type="hidden"
                       name="RequiresAction"
                       value="false" />

                <div class="form-check">
                    <input type="checkbox"
                           name="RequiresAction"
                           value="true"
                           class="form-check-input"
                           id="RequiresAction"
                           @(Model.RequiresAction ? "checked" : "") />

                    <label class="form-check-label"
                           for="RequiresAction">
                        Requires Action
                    </label>
                </div>
            </div>

            <div class="col-md-6">
                <label class="form-label">User Type</label>
                <select name="SelectedUserTypeId"
                        class="form-select"
                        required
                        hx-get="@Url.Action("UsersByType", "Notifications")"
                        hx-target="#usersContainer"
                        hx-trigger="change"
                        hx-include="[name='SelectedUserTypeId']">

                    <option value="">Select...</option>

                    @foreach (var item in Model.UserTypes)
                    {
                        <option value="@item.Value"
                                selected="@(item.Value == Model.SelectedUserTypeId?.ToString())">
                            @item.Text
                        </option>
                    }
                </select>
            </div>

            <div class="col-12" id="usersContainer">
                @await Html.PartialAsync("_UserMultiSelect", Model.Users)
            </div>

        </div>
    </div>

    <div class="modal-footer">
        <button type="button"
                class="btn btn-label-secondary"
                data-bs-dismiss="modal">
            Close
        </button>

        <button type="submit"
                class="btn btn-primary">
            Save
        </button>
    </div>
</form>
