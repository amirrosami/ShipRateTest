@using ShipRate.Application.DTOs.Notif
@model NotificationDetailsDto

@{
    ViewData["Title"] = "Notification Details";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0">Notification Details</h4>
            <div class="text-muted small">View notification content and recipient status.</div>
        </div>

        <a href="@Url.Action("Manage", "Notifications")"
           class="btn btn-outline-secondary">
            Back
        </a>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header fw-semibold">
                    Message
                </div>

                <div class="card-body">
                    <h5>@Model.Title</h5>

                    <p class="mb-3">
                        @Model.Message
                    </p>

                    @if (!string.IsNullOrWhiteSpace(Model.TargetUrl))
                    {
                        <div>
                            <span class="text-muted">Target Url:</span>
                            <a href="@Model.TargetUrl" target="_blank">@Model.TargetUrl</a>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.IconCssClass))
                    {
                        <div class="mt-2">
                            <span class="text-muted">Icon:</span>
                            <i class="@Model.IconCssClass"></i>
                            <code>@Model.IconCssClass</code>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header fw-semibold">
                    Summary
                </div>

                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-5">Source</dt>
                        <dd class="col-7">@Model.SourceTypeTitle</dd>

                        <dt class="col-5">Created By</dt>
                        <dd class="col-7">@Model.CreatedByName</dd>

                        <dt class="col-5">Created At</dt>
                        <dd class="col-7">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

                        <dt class="col-5">Recipients</dt>
                        <dd class="col-7">@Model.TotalRecipients</dd>

                        <dt class="col-5">Read</dt>
                        <dd class="col-7">
                            <span class="badge bg-success">@Model.ReadCount</span>
                        </dd>

                        <dt class="col-5">Unread</dt>
                        <dd class="col-7">
                            <span class="badge bg-warning text-dark">@Model.UnreadCount</span>
                        </dd>

                        <dt class="col-5">Status</dt>
                        <dd class="col-7">
                            @if (Model.IsArchived)
                            {
                                <span class="badge bg-secondary">Archived</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">Active</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header fw-semibold">
            Recipients
        </div>

        <div class="card-body p-0">
            @await Html.PartialAsync("_Recipients", Model.Recipients)
        </div>
    </div>
</div>
