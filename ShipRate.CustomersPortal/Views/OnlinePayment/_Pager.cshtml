@using ShipRate.Application.DTOs.Finance
@model OnlinePaymentListPageVm

@{
    var totalPages = Model.Result.TotalPages;
    var pageNumber = Model.Result.PageNumber;

    var pageWindow = 2;

    var startPage = Math.Max(1, pageNumber - pageWindow);
    var endPage = Math.Min(totalPages, pageNumber + pageWindow);

    string BuildUrl(int page) =>
        Url.Action("List", "OnlinePayments", new
        {
            RequestNo = Model.Filter.RequestNo,
            FromDate = Model.Filter.FromDate,
            ToDate = Model.Filter.ToDate,
            PageNumber = page,
            PageSize = Model.Filter.PageSize
        }) ?? "";
}

@if (totalPages > 1)
{
    <nav aria-label="Invoice pagination">
        <ul class="pagination mb-0">

            <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
                <a class="page-link"
                   href="javascript:void(0)"
                   hx-get="@BuildUrl(Math.Max(1, pageNumber - 1))"
                   hx-target="#invoice-list-container"
                   hx-swap="innerHTML">Previous</a>
            </li>

            @if (startPage > 1)
            {
                <li class="page-item @(pageNumber == 1 ? "active" : "")">
                    <a class="page-link"
                       href="javascript:void(0)"
                       hx-get="@BuildUrl(1)"
                       hx-target="#invoice-list-container"
                       hx-swap="innerHTML">1</a>
                </li>

                @if (startPage > 2)
                {
                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>
                }
            }

            @for (int i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(i == pageNumber ? "active" : "")">
                    <a class="page-link"
                       href="javascript:void(0)"
                       hx-get="@BuildUrl(i)"
                       hx-target="#invoice-list-container"
                       hx-swap="innerHTML">@i</a>
                </li>
            }

            @if (endPage < totalPages)
            {
                @if (endPage < totalPages - 1)
                {
                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>
                }

                <li class="page-item @(pageNumber == totalPages ? "active" : "")">
                    <a class="page-link"
                       href="javascript:void(0)"
                       hx-get="@BuildUrl(totalPages)"
                       hx-target="#invoice-list-container"
                       hx-swap="innerHTML">@totalPages</a>
                </li>
            }

            <li class="page-item @(pageNumber >= totalPages ? "disabled" : "")">
                <a class="page-link"
                   href="javascript:void(0)"
                   hx-get="@BuildUrl(Math.Min(totalPages, pageNumber + 1))"
                   hx-target="#invoice-list-container"
                   hx-swap="innerHTML">Next</a>
            </li>

        </ul>
    </nav>
}
