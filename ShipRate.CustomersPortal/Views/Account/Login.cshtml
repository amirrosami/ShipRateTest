@using System.Globalization
@using ShipRate.WebAppCustomers.ViewModels
@model LoginViewModel

@{
    Layout = null;

    var culture = CultureInfo.CurrentUICulture?.Name ?? "en-US";
    var isFa = culture.StartsWith("fa", StringComparison.OrdinalIgnoreCase);
    var lang = isFa ? "fa" : "en";
    var dir = isFa ? "rtl" : "ltr";

    string T(string fa, string en) => isFa ? fa : en;

    var currentPath = Context?.Request?.Path.Value ?? "/";
    var currentQuery = Context?.Request?.QueryString.Value ?? "";
    var currentUrl = $"{currentPath}{currentQuery}";
}

<!DOCTYPE html>
<html lang="@lang" dir="@dir" data-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@T("ورود به پرتال مشتریان", "Customer Portal Login")</title>

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/customer-portal.css" rel="stylesheet" />
    <style>
        :root {
            --page-bg: #f3f7fc;
            --card-bg: #ffffff;
            --side-bg: #eef6ff;
            --primary: #0d6efd;
            --primary-dark: #084298;
            --primary-soft: rgba(13, 110, 253, 0.10);
            --text: #172033;
            --muted: #6b7280;
            --border: #dbe4f0;
            --input-bg: #f9fbfe;
            --danger: #dc3545;
            --shadow: 0 24px 70px rgba(15, 23, 42, 0.12);
        }

        [data-theme="dark"] {
            --page-bg: #0f172a;
            --card-bg: #111827;
            --side-bg: #0b2447;
            --primary: #4da3ff;
            --primary-dark: #93c5fd;
            --primary-soft: rgba(77, 163, 255, 0.14);
            --text: #f8fafc;
            --muted: #a7b0c0;
            --border: rgba(255, 255, 255, 0.12);
            --input-bg: #0f172a;
            --danger: #ff7b7b;
            --shadow: 0 24px 70px rgba(0, 0, 0, 0.38);
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Segoe UI", Tahoma, Arial, sans-serif;
            background: radial-gradient(circle at top left, rgba(13, 110, 253, 0.16), transparent 32%), linear-gradient(135deg, var(--page-bg), #ffffff);
            color: var(--text);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        [data-theme="dark"] body {
            background: radial-gradient(circle at top left, rgba(77, 163, 255, 0.18), transparent 34%), linear-gradient(135deg, #020617, var(--page-bg));
        }

        .login-shell {
            width: 100%;
            max-width: 1040px;
            min-height: 620px;
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 28px;
            box-shadow: var(--shadow);
            display: grid;
            grid-template-columns: 1.05fr 0.95fr;
            overflow: hidden;
        }

        .login-info {
            background: linear-gradient(145deg, rgba(13, 110, 253, 0.13), transparent 55%), var(--side-bg);
            padding: 46px 44px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
        }

            .login-info::after {
                content: "";
                position: absolute;
                width: 360px;
                height: 360px;
                border-radius: 50%;
                background: rgba(13, 110, 253, 0.10);
                bottom: -150px;
                @(isFa ? "left" : "right") : -120px;
            }

        .brand-row {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .brand-logo {
            width: 52px;
            height: 52px;
            border-radius: 16px;
            background: linear-gradient(145deg, #0d6efd, #0a58ca);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 23px;
            box-shadow: 0 12px 30px rgba(13, 110, 253, 0.28);
        }

        .brand-name {
            display: flex;
            flex-direction: column;
        }

            .brand-name strong {
                font-size: 23px;
                font-weight: 800;
                letter-spacing: -0.4px;
                color: var(--text);
            }

            .brand-name span {
                font-size: 13px;
                color: var(--muted);
                margin-top: 2px;
            }

        .info-content {
            position: relative;
            z-index: 1;
            max-width: 460px;
            margin-top: 50px;
        }

        .info-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 14px;
            border-radius: 999px;
            background: var(--primary-soft);
            color: var(--primary-dark);
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 22px;
        }

        .info-content h1 {
            margin: 0;
            font-size: 36px;
            line-height: 1.35;
            font-weight: 850;
            letter-spacing: -0.8px;
            color: var(--text);
        }

        .info-content p {
            margin: 18px 0 0;
            font-size: 15px;
            line-height: 2;
            color: var(--muted);
        }

        .info-grid {
            position: relative;
            z-index: 1;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
            margin-top: 40px;
        }

        .info-card {
            background: rgba(255, 255, 255, 0.62);
            border: 1px solid rgba(13, 110, 253, 0.12);
            border-radius: 18px;
            padding: 18px;
            backdrop-filter: blur(10px);
        }

        [data-theme="dark"] .info-card {
            background: rgba(15, 23, 42, 0.56);
            border-color: rgba(255, 255, 255, 0.10);
        }

        .info-card i {
            color: var(--primary);
            font-size: 22px;
            margin-bottom: 12px;
            display: inline-block;
        }

        .info-card strong {
            display: block;
            font-size: 14px;
            font-weight: 800;
            margin-bottom: 5px;
            color: var(--text);
        }

        .info-card span {
            display: block;
            font-size: 12px;
            line-height: 1.7;
            color: var(--muted);
        }

        .login-form-area {
            padding: 38px 42px;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .top-actions {
            position: absolute;
            top: 24px;
            @(isFa ? "left" : "right") : 24px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .icon-btn {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            border: 1px solid var(--border);
            background: var(--card-bg);
            color: var(--text);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.18s ease;
        }

            .icon-btn:hover {
                border-color: var(--primary);
                color: var(--primary);
                background: var(--primary-soft);
            }

        .lang-form {
            width: 42px;
            height: 42px;
            margin: 0;
        }

            .lang-form button {
                width: 100%;
                height: 100%;
                border-radius: 14px;
                border: 1px solid var(--border);
                background: var(--card-bg);
                color: var(--text);
                font-size: 13px;
                font-weight: 800;
                cursor: pointer;
                transition: all 0.18s ease;
            }

                .lang-form button:hover {
                    border-color: var(--primary);
                    color: var(--primary);
                    background: var(--primary-soft);
                }

        .form-box {
            width: 100%;
            max-width: 390px;
            margin-top: 22px;
        }

        .form-title {
            margin-bottom: 28px;
        }

            .form-title h2 {
                margin: 0;
                font-size: 29px;
                font-weight: 850;
                color: var(--text);
                letter-spacing: -0.5px;
            }

            .form-title p {
                margin: 10px 0 0;
                color: var(--muted);
                font-size: 14px;
                line-height: 1.8;
            }

        .error-summary {
            background: rgba(220, 53, 69, 0.08);
            color: var(--danger);
            border: 1px solid rgba(220, 53, 69, 0.20);
            border-radius: 14px;
            padding: 12px 14px;
            margin-bottom: 18px;
            font-size: 13px;
        }

            .error-summary ul {
                margin-bottom: 0;
            }

        .form-group {
            margin-bottom: 17px;
        }

            .form-group label {
                display: block;
                font-size: 13px;
                font-weight: 800;
                margin-bottom: 8px;
                color: var(--text);
            }

        .input-wrap {
            position: relative;
        }

            .input-wrap > i {
                position: absolute;
                top: 50%;
                transform: translateY(-50%);
                @(isFa ? "right" : "left") : 15px;
                color: var(--muted);
                font-size: 17px;
                pointer-events: none;
            }

            .input-wrap input {
                width: 100%;
                height: 50px;
                border-radius: 15px;
                border: 1px solid var(--border);
                background: var(--input-bg);
                color: var(--text);
                outline: none;
                font-size: 14px;
                transition: all 0.18s ease;
                @(isFa ? "padding: 0 46px 0 44px;" : "padding: 0 44px 0 46px;");
            }

                .input-wrap input::placeholder {
                    color: #9aa5b1;
                }

                .input-wrap input:focus {
                    border-color: var(--primary);
                    background: var(--card-bg);
                    box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.12);
                }

        .toggle-pw {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            @(isFa ? "left" : "right") : 12px;
            width: 30px;
            height: 30px;
            border: 0;
            background: transparent;
            color: var(--muted);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .field-validation-error {
            display: block;
            margin-top: 6px;
            color: var(--danger);
            font-size: 12px;
        }

        .captcha-row {
            display: grid;
            grid-template-columns: 1fr 50px;
            gap: 10px;
            margin-bottom: 10px;
        }

        .captcha-box {
            height: 50px;
            border-radius: 15px;
            overflow: hidden;
            border: 1px solid var(--border);
            background: #fff;
        }

            .captcha-box img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

        .refresh-btn {
            height: 50px;
            border-radius: 15px;
            border: 1px solid var(--border);
            background: var(--input-bg);
            color: var(--text);
            cursor: pointer;
            transition: all 0.18s ease;
        }

            .refresh-btn:hover {
                border-color: var(--primary);
                color: var(--primary);
                background: var(--primary-soft);
            }

        .options {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin: 3px 0 22px;
            color: var(--muted);
            font-size: 13px;
        }

        .remember-label {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            user-select: none;
        }

            .remember-label input {
                width: 16px;
                height: 16px;
                accent-color: var(--primary);
            }

        .btn-login {
            width: 100%;
            height: 52px;
            border: 0;
            border-radius: 16px;
            background: linear-gradient(145deg, #0d6efd, #0a58ca);
            color: #fff;
            font-size: 15px;
            font-weight: 850;
            cursor: pointer;
            box-shadow: 0 14px 28px rgba(13, 110, 253, 0.26);
            transition: all 0.18s ease;
        }

            .btn-login:hover {
                transform: translateY(-1px);
                box-shadow: 0 18px 34px rgba(13, 110, 253, 0.32);
            }

            .btn-login:active {
                transform: translateY(0);
            }

        .form-footer {
            margin-top: 22px;
            text-align: center;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.8;
        }

        .mobile-brand {
            display: none;
            text-align: center;
            margin-bottom: 24px;
        }

            .mobile-brand .brand-logo {
                margin: 0 auto 12px;
            }

            .mobile-brand strong {
                display: block;
                font-size: 24px;
                font-weight: 850;
            }

            .mobile-brand span {
                display: block;
                margin-top: 4px;
                font-size: 13px;
                color: var(--muted);
            }

        @@media (max-width: 920px) {
            body {
                padding: 18px;
            }

            .login-shell {
                grid-template-columns: 1fr;
                max-width: 500px;
                min-height: auto;
            }

            .login-info {
                display: none;
            }

            .login-form-area {
                padding: 74px 26px 34px;
            }

            .mobile-brand {
                display: block;
            }

            .form-box {
                margin-top: 0;
            }

            .form-title {
                text-align: center;
            }

                .form-title h2 {
                    font-size: 25px;
                }
        }

        @@media (max-width: 420px) {
            .login-form-area {
                padding-left: 18px;
                padding-right: 18px;
            }

            .captcha-row {
                grid-template-columns: 1fr 48px;
            }
        }
    </style>
</head>

<body>
    <main class="login-shell">

        <section class="login-info">
            <div class="brand-row">
                <div class="brand-logo">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div class="brand-name">
                    <strong>ShipRate</strong>
                    <span>@T("سامانه مدیریت حمل‌ونقل", "Transportation Management System")</span>
                </div>
            </div>

            <div class="info-content">
                <div class="info-badge">
                    <i class="bi bi-shield-check"></i>
                    <span>@T("پرتال رسمی مشتریان", "Official Customer Portal")</span>
                </div>

                <h1>
                    @T("دسترسی امن به خدمات و اطلاعات مشتریان",
                    "Secure access to customer services and information")
                </h1>

                <p>
                    @T("از طریق این پرتال می‌توانید به امکانات اختصاصی، اطلاعات عملیاتی و خدمات مرتبط با حساب مشتری خود دسترسی داشته باشید.",
                                        "Through this portal, you can access dedicated features, operational information, and services related to your customer account.")
                </p>
            </div>

            <div class="info-grid">
                <div class="info-card">
                    <i class="bi bi-lock"></i>
                    <strong>@T("امنیت", "Security")</strong>
                    <span>@T("ورود کنترل‌شده و محافظت از اطلاعات", "Controlled access and protected data")</span>
                </div>

                <div class="info-card">
                    <i class="bi bi-speedometer2"></i>
                    <strong>@T("سرعت", "Speed")</strong>
                    <span>@T("دسترسی سریع به امکانات اصلی", "Fast access to main features")</span>
                </div>

                <div class="info-card">
                    <i class="bi bi-globe2"></i>
                    <strong>@T("چندزبانه", "Multilingual")</strong>
                    <span>@T("پشتیبانی از فارسی و انگلیسی", "Persian and English support")</span>
                </div>

                <div class="info-card">
                    <i class="bi bi-window"></i>
                    <strong>@T("واکنش‌گرا", "Responsive")</strong>
                    <span>@T("مناسب موبایل، تبلت و دسکتاپ", "Optimized for mobile, tablet and desktop")</span>
                </div>
            </div>
        </section>

        <section class="login-form-area">

            <div class="top-actions">
                <form class="lang-form" asp-controller="Localization" asp-action="SetLanguage" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="culture" value="@(isFa ? "en-US" : "fa-IR")" />
                    <input type="hidden" name="returnUrl" value="@currentUrl" />
                    <button type="submit">@(isFa ? "EN" : "FA")</button>
                </form>

                <button class="icon-btn" type="button" onclick="toggleTheme()" title="@T("تغییر تم", "Change theme")">
                    <i id="themeIcon" class="bi bi-moon-stars"></i>
                </button>
            </div>

            <div class="form-box">

                <div class="mobile-brand">
                    <div class="brand-logo">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <strong>ShipRate</strong>
                    <span>@T("پرتال مشتریان", "Customer Portal")</span>
                </div>

                <div class="form-title">
                    <h2>@T("ورود به حساب کاربری", "Sign in to your account")</h2>
                    <p>
                        @T("برای ادامه، اطلاعات حساب خود را وارد کنید.",
                                                "Enter your account credentials to continue.")
                    </p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="error-summary">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <form asp-action="Login" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label asp-for="Username">@T("نام کاربری", "Username")</label>
                        <div class="input-wrap">
                            <i class="bi bi-person"></i>
                            <input asp-for="Username"
                                   type="text"
                                   placeholder="@T("نام کاربری خود را وارد کنید", "Enter your username")"
                                   autocomplete="username"
                                   autofocus />
                        </div>
                        <span asp-validation-for="Username"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password">@T("رمز عبور", "Password")</label>
                        <div class="input-wrap">
                            <i class="bi bi-lock"></i>
                            <input asp-for="Password"
                                   type="password"
                                   id="password"
                                   placeholder="@T("رمز عبور خود را وارد کنید", "Enter your password")"
                                   autocomplete="current-password" />

                            <button type="button" class="toggle-pw" onclick="togglePassword()" title="@T("نمایش رمز عبور", "Show password")">
                                <i id="passwordIcon" class="bi bi-eye-slash"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password"></span>
                    </div>

                    @if (ViewBag.ReturnUrl != null)
                    {
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    }

                    <div class="form-group">
                        <label asp-for="CaptchaCode">@T("کد امنیتی", "Security Code")</label>

                        <div class="captcha-row">
                            <div class="captcha-box">
                                <img id="captchaImage"
                                     src="@Url.Action("CaptchaImage", "Account")"
                                     alt="Captcha" />
                            </div>

                            <button type="button"
                                    class="refresh-btn"
                                    onclick="refreshCaptchaImage()"
                                    title="@T("تغییر کد امنیتی", "Refresh captcha")">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                        </div>

                        <div class="input-wrap">
                            <i class="bi bi-shield-lock"></i>
                            <input asp-for="CaptchaCode"
                                   type="text"
                                   maxlength="6"
                                   inputmode="numeric"
                                   pattern="\d{6}"
                                   autocomplete="off"
                                   placeholder="@T("کد ۶ رقمی را وارد کنید", "Enter 6-digit code")" />
                        </div>

                        <span asp-validation-for="CaptchaCode"></span>
                    </div>

                    <div class="options">
                        <label class="remember-label">
                            <input asp-for="RememberMe" type="checkbox" />
                            <span>@T("مرا به خاطر بسپار", "Remember me")</span>
                        </label>
                    </div>

                    <button type="submit" class="btn-login">
                        @T("ورود به پرتال", "Sign in to portal")
                    </button>
                </form>

                <div class="form-footer">
                    &copy; 2026 ShipRate TMS
                    <br />
                    @T("تمامی حقوق محفوظ است.", "All rights reserved.")
                </div>
            </div>
        </section>

    </main>

    <script>
        function togglePassword() {
            const input = document.getElementById('password');
            const icon = document.getElementById('passwordIcon');

            if (!input || !icon) return;

            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'bi bi-eye';
            } else {
                input.type = 'password';
                icon.className = 'bi bi-eye-slash';
            }
        }

        function applyTheme(theme) {
            document.documentElement.setAttribute('data-theme', theme);

            const icon = document.getElementById('themeIcon');
            if (icon) {
                icon.className = theme === 'dark'
                    ? 'bi bi-sun'
                    : 'bi bi-moon-stars';
            }
        }

        function toggleTheme() {
            const current = document.documentElement.getAttribute('data-theme') || 'light';
            const next = current === 'dark' ? 'light' : 'dark';

            applyTheme(next);
            localStorage.setItem('shiprate-theme', next);
        }

        function refreshCaptchaImage() {
            const img = document.getElementById('captchaImage');
            if (!img) return;

            img.src = '@Url.Action("CaptchaImage", "Account")' + '?_=' + new Date().getTime();
        }

        document.addEventListener('DOMContentLoaded', function () {
            const savedTheme = localStorage.getItem('shiprate-theme') || 'light';
            applyTheme(savedTheme);

            const captchaInput = document.querySelector('[name="CaptchaCode"]');
            if (captchaInput) {
                captchaInput.addEventListener('input', function () {
                    this.value = this.value.replace(/\D/g, '').slice(0, 6);
                });
            }
        });
    </script>

    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/jquery.validate.min.js"></script>
    <script src="~/js/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
